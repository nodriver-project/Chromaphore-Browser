+namespace {
+
+// The grid of device space the showing set is indexed by, in px, and the
+// most cells there are along each axis (a canvas is at most 32,767 px a side).
+constexpr float kCellWidth = 128;
+constexpr float kCellHeight = 32;
+constexpr int kMaxCols = 256;
+constexpr int kMaxRows = 1024;
+// How far a baseline's ends, or a fill's corners, may lie from a showing
+// one's and still be the same again, in device px.
+constexpr float kSame = 0.5f;
+// Slack for "wholly inside", in device px.
+constexpr float kSlack = 0.01f;
+// Dead items and index entries kept before a squeeze.
+constexpr wtf_size_t kDeadSlack = 1024;
+
+// The composite modes whose draw replaces the whole clip, as
+// Canvas2DRecorderContext::IsFullCanvasCompositeMode takes them.
+bool IsFullClipMode(SkBlendMode mode) {
+  return mode == SkBlendMode::kSrcIn || mode == SkBlendMode::kSrcOut ||
+         mode == SkBlendMode::kDstIn || mode == SkBlendMode::kDstATop;
+}
+
+// A transform that maps rects to rects: scales, flips, translations and
+// quarter turns.
+bool AxisAligned(const float m[6]) {
+  return (m[1] == 0 && m[2] == 0) || (m[0] == 0 && m[3] == 0);
+}
+
+gfx::RectF ClipRect(const SkIRect& clip) {
+  return gfx::RectF(clip.x(), clip.y(), clip.width(), clip.height());
+}
+
+bool Near(const gfx::PointF& a, const gfx::PointF& b) {
+  return (a - b).Length() <= kSame;
+}
+
+// Overlap along one axis: positive overlap, or a zero-size side lying
+// strictly inside the other.
+bool Overlaps(float a0, float a1, float b0, float b1) {
+  if (a0 == a1) {
+    return a0 > b0 && a0 < b1;
+  }
+  if (b0 == b1) {
+    return b0 > a0 && b0 < a1;
+  }
+  return a0 < b1 && b0 < a1;
+}
+
+// Whether `a` crosses `b`: they share area, or a box of no width or height
+// lies inside the other.
+bool Crosses(const gfx::RectF& a, const gfx::RectF& b) {
+  return Overlaps(a.x(), a.right(), b.x(), b.right()) &&
+         Overlaps(a.y(), a.bottom(), b.y(), b.bottom());
+}
+
+// `a` within `b`, edges included; boxes of no size allowed.
+bool Within(const gfx::RectF& a, const gfx::RectF& b) {
+  return a.x() >= b.x() && a.right() <= b.right() && a.y() >= b.y() &&
+         a.bottom() <= b.bottom();
+}
+
+// `a` cut to `b`, edges included; false when nothing of `a` is in `b`.
+bool CutTo(const gfx::RectF& a, const gfx::RectF& b, gfx::RectF& out) {
+  const float left = std::max(a.x(), b.x());
+  const float top = std::max(a.y(), b.y());
+  const float right = std::min(a.right(), b.right());
+  const float bottom = std::min(a.bottom(), b.bottom());
+  if (left > right || top > bottom) {
+    return false;
+  }
+  out = gfx::RectF(left, top, right - left, bottom - top);
+  return true;
+}
+
+bool QuadInside(const gfx::RectF& area, const gfx::QuadF& quad) {
+  gfx::RectF slack = area;
+  slack.Outset(kSlack);
+  return slack.InclusiveContains(quad.p1()) &&
+         slack.InclusiveContains(quad.p2()) &&
+         slack.InclusiveContains(quad.p3()) &&
+         slack.InclusiveContains(quad.p4());
+}
+
+// A run's central band from its box (left-top, right-top, right-bottom,
+// left-bottom): the middle half of its height, its full length.
+gfx::QuadF CentralBand(const gfx::QuadF& box) {
+  const auto at = [](const gfx::PointF& a, const gfx::PointF& b, float t) {
+    return gfx::PointF(a.x() + (b.x() - a.x()) * t,
+                       a.y() + (b.y() - a.y()) * t);
+  };
+  return gfx::QuadF(
+      at(box.p1(), box.p4(), 0.25f), at(box.p2(), box.p3(), 0.25f),
+      at(box.p2(), box.p3(), 0.75f), at(box.p1(), box.p4(), 0.75f));
+}
+
+// The font getter's serialization (BaseRenderingContext2D::font), from a
+// font's description.
+String FontCss(const FontDescription& description) {
+  StringBuilder css;
+  if (description.Style() == kItalicSlopeValue) {
+    css.Append("italic ");
+  }
+  if (description.Weight() == kBoldWeightValue) {
+    css.Append("bold ");
+  } else if (description.Weight() != kNormalWeightValue) {
+    css.AppendNumber(
+        static_cast<int>(static_cast<float>(description.Weight())));
+    css.Append(" ");
+  }
+  if (description.VariantCaps() == FontDescription::kSmallCaps) {
+    css.Append("small-caps ");
+  }
+  css.AppendNumber(description.ComputedSize());
+  css.Append("px ");
+  css.Append(
+      ComputedStyleUtils::ValueForFontFamily(description.Family())->CssText());
+  return css.ToString();
+}
+
+// Whether a filter is set, without resolving it (resolving allocates, and the
+// draw resolves it itself); one not yet resolved counts as a filter.
+bool HasFilter(const CanvasRenderingContext2DState& state) {
+  return state.IsFilterUnresolved() || state.IsFilterResolved();
+}
+
+// The cell along one axis holding `v`, clamped to the grid (what lies off the
+// canvas goes in its edge cells).
+int CellOf(float v, float size, int count) {
+  const float cell = std::floor(v / size);
+  if (!(cell >= 0)) {  // negative, or NaN
+    return 0;
+  }
+  return cell >= count - 1 ? count - 1 : static_cast<int>(cell);
+}
+
+template <typename EntryT, typename StyleT>
+void SetStyle(EntryT& entry, const CanvasStyle& style) {
+  if (style.GetCanvasGradient()) {
+    entry.style = StyleT::kGradient;
+  } else if (style.GetCanvasPattern()) {
+    entry.style = StyleT::kPattern;
+  } else {
+    entry.style = StyleT::kColor;
+    entry.color = style.ColorForTextRecord();
+  }
+}
+
+}  // namespace
+
+// static
+bool CanvasTextRecord::Enabled() {
+  static const bool enabled = base::CommandLine::ForCurrentProcess()->HasSwitch(
+      ::switches::kEnableCanvasTextRecord);
+  return enabled;
+}
+
+CanvasTextRecord::CanvasTextRecord() {
+  // The font table's store, once: a draw adds to it only past eight fonts
+  // in use at once.
+  fonts_.ReserveInitialCapacity(8);
+}
+
+CanvasTextRecord::~CanvasTextRecord() = default;
+
+void CanvasTextRecord::Trace(Visitor* visitor) const {
+  visitor->Trace(fonts_);
+  visitor->Trace(pending_font_);
+  FontSelectorClient::Trace(visitor);
+}
+
+// The slots whose font's list this invalidation may invalidate, chosen as
+// FontFallbackMap::FontsNeedUpdate chooses (it may already have run: a list
+// it invalidated reads invalid here). A valid list is its description's entry
+// in its selector's map, so Get() finds the font's own list and creates
+// nothing.
+void CanvasTextRecord::FontsNeedUpdate(FontSelector* selector,
+                                       FontInvalidationReason reason) {
+  for (wtf_size_t i = 0; i < fonts_.size(); ++i) {
+    const Font* font = fonts_[i].Get();
+    if (!font || font_stale_[i] || font->GetFontSelector() != selector) {
+      continue;
+    }
+    if (!selector || !font->IsFallbackValid()) {
+      font_stale_[i] = true;
+      continue;
+    }
+    const FontFallbackList& list =
+        *selector->GetFontFallbackMap().Get(font->GetFontDescription());
+    switch (reason) {
+      case FontInvalidationReason::kFontFaceLoaded:
+        font_stale_[i] = list.HasLoadingFallback();
+        break;
+      case FontInvalidationReason::kFontFaceDeleted:
+        font_stale_[i] = list.HasCustomFont();
+        break;
+      default:
+        font_stale_[i] = true;
+    }
+  }
+}
+
+// static
+gfx::PointF CanvasTextRecord::Map(const float m[6], float x, float y) {
+  return gfx::PointF(m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5]);
+}
+
+// static
+uint64_t CanvasTextRecord::SameKey(bool fill, float x, float y) {
+  const auto q = [](float v) -> uint64_t {
+    // NaN, which a transform too large for a float can give, is the lowest.
+    if (!(v >= -1048576.0f)) {
+      return 0;
+    }
+    const float f = std::min(std::floor(v), 1048575.0f);
+    return static_cast<uint64_t>(static_cast<int64_t>(f) + 1048576);
+  };
+  // Never 0 nor the largest value (the hash table's empty and deleted keys).
+  return ((q(x) << 21 | q(y)) << 1 | (fill ? 1 : 0)) + 1;
+}
+
+// ---- Draw time.
+
+void CanvasTextRecord::Begin(Canvas2DRecorderContext& context,
+                             Entry& entry,
+                             Kind kind) {
+  const CanvasRenderingContext2DState& state = context.GetState();
+  entry.kind = kind;
+  entry.composite = static_cast<uint8_t>(state.GlobalComposite());
+  entry.clip_exact = state.ClipIsDeviceRect();
+  const AffineTransform& t = state.GetTransform();
+  entry.m[0] = static_cast<float>(t.A());
+  entry.m[1] = static_cast<float>(t.B());
+  entry.m[2] = static_cast<float>(t.C());
+  entry.m[3] = static_cast<float>(t.D());
+  entry.m[4] = static_cast<float>(t.E());
+  entry.m[5] = static_cast<float>(t.F());
+}
+
+// Whether `entry` is the log's last entry again. Replayed, it would only
+// replace that one as the same again (a run or a fill) or repeat what it did
+// (a clear, an operation not followed), so it need not be logged.
+bool CanvasTextRecord::SameAsLast(const Entry& entry) const {
+  if (log_.empty()) {
+    return false;
+  }
+  const Entry& last = log_.back();
+  if (last.kind != entry.kind || last.composite != entry.composite ||
+      last.style != entry.style || last.clip_exact != entry.clip_exact ||
+      last.shadow_or_filter != entry.shadow_or_filter ||
+      last.stroke != entry.stroke || last.line != entry.line ||
+      last.clip != entry.clip || last.rect != entry.rect ||
+      last.alpha != entry.alpha ||
+      (entry.style == Style::kColor && last.color != entry.color)) {
+    return false;
+  }
+  for (int i = 0; i < 6; ++i) {
+    if (last.m[i] != entry.m[i]) {
+      return false;
+    }
+  }
+  if (entry.kind != Kind::kText) {
+    return true;
+  }
+  return last.font == entry.font && last.x == entry.x && last.y == entry.y &&
+         last.width == entry.width && last.font_width == entry.font_width &&
+         last.ascent == entry.ascent && last.descent == entry.descent &&
+         last.rtl == entry.rtl && last.bidi_override == entry.bidi_override &&
+         last.text == entry.text;
+}
+
+void CanvasTextRecord::Append(Canvas2DRecorderContext& context, Entry& entry) {
+  if (SameAsLast(entry)) {
+    return;
+  }
+  if (entry.kind == Kind::kText) {
+    ++font_uses_[entry.font];
+  }
+  // A clear of the whole canvas replays the log at once: what it empties
+  // (and the fonts only that used) goes now, not at the next compaction.
+  bool clears_all = false;
+  if (entry.kind == Kind::kClear && entry.clip_exact && AxisAligned(entry.m)) {
+    const gfx::RectF canvas(0, 0, context.Width(), context.Height());
+    const gfx::RectF clip = ClipRect(entry.clip);
+    const gfx::RectF area =
+        gfx::QuadF(Map(entry.m, entry.rect.x(), entry.rect.y()),
+                   Map(entry.m, entry.rect.right(), entry.rect.bottom()),
+                   Map(entry.m, entry.rect.right(), entry.rect.y()),
+                   Map(entry.m, entry.rect.x(), entry.rect.bottom()))
+            .BoundingBox();
+    clears_all = clip.Contains(canvas) && area.Contains(canvas);
+  }
+  log_.push_back(std::move(entry));
+  if (log_.size() >= kCompactAt || clears_all) {
+    Compact(gfx::Size(context.Width(), context.Height()));
+  }
+}
+
+uint32_t CanvasTextRecord::FontIndex(const Font& font) {
+  if (last_font_.Get() == &font) {
+    return last_font_index_;
+  }
+  uint32_t index = std::numeric_limits<uint32_t>::max();
+  for (wtf_size_t i = 0; i < fonts_.size(); ++i) {
+    if (fonts_[i].Get() == &font) {
+      index = i;
+      break;
+    }
+  }
+  if (index == std::numeric_limits<uint32_t>::max()) {
+    if (!free_fonts_.empty()) {
+      index = free_fonts_.back();
+      free_fonts_.pop_back();
+      fonts_[index] = &font;
+      font_uses_[index] = 0;
+      font_css_[index] = String();
+    } else {
+      index = fonts_.size();
+      fonts_.push_back(&font);
+      font_uses_.push_back(0);
+      font_css_.push_back(String());
+      font_stale_.push_back(true);
+    }
+    // Told of every invalidation of this font's lists from now on (a set:
+    // registering again changes nothing; held weakly).
+    if (FontSelector* selector = font.GetFontSelector()) {
+      selector->RegisterForInvalidationCallbacks(this);
+    }
+  }
+  last_font_ = &font;
+  last_font_index_ = index;
+  return index;
+}
+
+void CanvasTextRecord::PendText(Canvas2DRecorderContext& context,
+                                const String& text,
+                                unsigned start,
+                                unsigned end,
+                                const Font& font,
+                                const SimpleFontData& font_data,
+                                bool rtl,
+                                bool bidi_override,
+                                const gfx::PointF& location,
+                                double width,
+                                double font_width,
+                                bool stroke) {
+  has_pending_ = false;
+  if (end <= start || end > text.length()) {
+    return;  // draws nothing
+  }
+  const CanvasRenderingContext2DState& state = context.GetState();
+  Entry& entry = pending_;
+  Begin(context, entry, Kind::kText);
+  // A cluster draw keeps only the part it draws.
+  entry.text = (start == 0 && end == text.length())
+                   ? text
+                   : text.substr(start, end - start);
+  entry.stroke = stroke;
+  entry.line = false;
+  entry.shadow_or_filter = state.ShouldDrawShadows() || HasFilter(state);
+  entry.alpha = static_cast<float>(state.GlobalAlpha());
+  SetStyle<Entry, Style>(
+      entry,
+      state.Style(stroke ? CanvasRenderingContext2DState::kStrokePaintType
+                         : CanvasRenderingContext2DState::kFillPaintType));
+  entry.rect = gfx::RectF();
+  entry.x = location.x();
+  entry.y = location.y();
+  entry.width = static_cast<float>(width);
+  entry.font_width = static_cast<float>(font_width);
+  const FontMetrics& metrics = font_data.GetFontMetrics();
+  entry.ascent = metrics.FloatAscent();
+  entry.descent = metrics.FloatDescent();
+  entry.rtl = rtl;
+  entry.bidi_override = bidi_override;
+  pending_font_ = &font;
+  has_pending_ = true;
+}
+
+void CanvasTextRecord::OnDraw(
+    Canvas2DRecorderContext& context,
+    const gfx::RectF& bounds,
+    CanvasRenderingContext2DState::PaintType paint_type,
+    CanvasPerformanceMonitor::DrawType draw_type,
+    const SkIRect& clip_bounds) {
+  if (draw_type == CanvasPerformanceMonitor::DrawType::kText) {
+    if (!has_pending_) {
+      return;
+    }
+    has_pending_ = false;
+    const Font* font = pending_font_.Get();
+    pending_font_ = nullptr;
+    if (context.layer_count_ > 0) {
+      drew_in_layer_ = true;
+      pending_.text = String();
+      return;
+    }
+    pending_.clip = clip_bounds;
+    if (pending_.text.length() > kMaxRunChars) {
+      // Too long to keep: what it draws is an operation not followed, and
+      // the canvas says it lost a run.
+      pending_.kind = Kind::kOther;
+      pending_.rect =
+          gfx::RectF(pending_.x, pending_.y - pending_.ascent, pending_.width,
+                     pending_.ascent + pending_.descent);
+      pending_.text = String();
+      truncated_ = true;
+    } else {
+      pending_.font = FontIndex(*font);
+      // This draw determined the font's primary font on its current list.
+      font_stale_[pending_.font] = false;
+    }
+    Append(context, pending_);
+    return;
+  }
+  if (context.layer_count_ > 0) {
+    drew_in_layer_ = true;
+    return;
+  }
+  const CanvasRenderingContext2DState& state = context.GetState();
+  const bool fill =
+      draw_type == CanvasPerformanceMonitor::DrawType::kRectangle &&
+      paint_type == CanvasRenderingContext2DState::kFillPaintType;
+  Entry entry;
+  Begin(context, entry, fill ? Kind::kFill : Kind::kOther);
+  entry.clip = clip_bounds;
+  entry.rect = bounds;
+  entry.shadow_or_filter = state.ShouldDrawShadows() || HasFilter(state);
+  if (fill) {
+    entry.alpha = static_cast<float>(state.GlobalAlpha());
+    SetStyle<Entry, Style>(entry, state.FillStyle());
+  } else if (draw_type == CanvasPerformanceMonitor::DrawType::kPath &&
+             paint_type == CanvasRenderingContext2DState::kStrokePaintType) {
+    // A stroked path comes padded for the sharpest miter join
+    // (InflateStrokeRect). A path straight along an axis -- an underline, a
+    // dashed squiggle -- has no join that reaches past its caps: half the
+    // line width (a square cap's corner, a little more) is all it covers.
+    const float half = static_cast<float>(state.LineWidth() / 2);
+    float padding = half;
+    if (state.GetLineJoin() == kMiterJoin) {
+      padding *= static_cast<float>(state.MiterLimit());
+    } else if (state.GetLineCap() == kSquareCap) {
+      padding *= std::sqrt(2.0f);
+    }
+    const float raw_width = std::max(0.0f, bounds.width() - 2 * padding);
+    const float raw_height = std::max(0.0f, bounds.height() - 2 * padding);
+    if (raw_width < 0.5f || raw_height < 0.5f) {
+      const float cap =
+          state.GetLineCap() == kSquareCap ? half * std::sqrt(2.0f) : half;
+      entry.rect = gfx::RectF(bounds.CenterPoint().x() - raw_width / 2 - cap,
+                              bounds.CenterPoint().y() - raw_height / 2 - cap,
+                              raw_width + 2 * cap, raw_height + 2 * cap);
+      entry.line = state.LineWidth() <= 3;
+    }
+  }
+  Append(context, entry);
+}
+
+void CanvasTextRecord::OnClear(Canvas2DRecorderContext& context,
+                               const gfx::RectF& rect,
+                               const SkIRect& clip_bounds) {
+  if (context.layer_count_ > 0) {
+    drew_in_layer_ = true;
+    return;
+  }
+  Entry entry;
+  Begin(context, entry, Kind::kClear);
+  entry.clip = clip_bounds;
+  entry.rect = rect;
+  Append(context, entry);
+}
+
+void CanvasTextRecord::OnDeviceDraw(Canvas2DRecorderContext& context,
+                                    const gfx::Rect& device_rect) {
+  Entry entry;
+  entry.kind = Kind::kDevice;
+  entry.composite = static_cast<uint8_t>(SkBlendMode::kSrcOver);
+  entry.clip = SkIRect::MakeWH(context.Width(), context.Height());
+  entry.rect = gfx::RectF(device_rect);
+  entry.m[0] = 1;
+  entry.m[1] = 0;
+  entry.m[2] = 0;
+  entry.m[3] = 1;
+  entry.m[4] = 0;
+  entry.m[5] = 0;
+  Append(context, entry);
+}
+
+void CanvasTextRecord::OnLayerEnd(Canvas2DRecorderContext& context,
+                                  cc::PaintCanvas& canvas) {
+  if (!drew_in_layer_) {
+    return;
+  }
+  drew_in_layer_ = false;
+  SkIRect clip;
+  if (!canvas.getDeviceClipBounds(&clip)) {
+    return;
+  }
+  // What the layers drew lands now, within the clip, filters and all.
+  Entry entry;
+  entry.kind = Kind::kDevice;
+  entry.composite = static_cast<uint8_t>(SkBlendMode::kSrcOver);
+  entry.clip = clip;
+  entry.rect = ClipRect(clip);
+  entry.m[0] = 1;
+  entry.m[1] = 0;
+  entry.m[2] = 0;
+  entry.m[3] = 1;
+  entry.m[4] = 0;
+  entry.m[5] = 0;
+  Append(context, entry);
+}
+
+void CanvasTextRecord::Clear() {
+  log_.Shrink(0);
+  has_pending_ = false;
+  pending_.text = String();
+  pending_font_ = nullptr;
+  EmptyShown();
+  // A resize may follow: the next compaction sizes the grid again.
+  cells_.clear();
+  cell_gen_.clear();
+  cols_ = 0;
+  rows_ = 0;
+  truncated_ = false;
+  drew_in_layer_ = false;
+  fonts_.Shrink(0);
+  font_uses_.Shrink(0);
+  font_css_.Shrink(0);
+  free_fonts_.Shrink(0);
+  font_stale_.Shrink(0);
+  last_font_ = nullptr;
+}
+
