+namespace blink {
+
+class Canvas2DRecorderContext;
+class Font;
+class PlainTextPainter;
+class SimpleFontData;
+
+// browser: the text and fills an HTML <canvas> element's 2D context still
+// shows, for Page.agentCanvasText. Off unless the browser runs with
+// --enable-canvas-text-record.
+//
+// At draw time a call appends one plain entry to the log -- what the draw had
+// in hand: the text, the font it used, the style's colour, globalAlpha, the
+// composite mode, the transform, the device clip bounds and whether the clip
+// is an exact device rectangle -- and resolves nothing. What still shows is
+// resolved by replaying the log in order onto the set of showing runs and
+// fills (Compact), when the log reaches kCompactAt entries and when it is read.
+//
+// Bounded work and memory: a showing item is indexed in at most kMaxItemCells
+// cells of a grid of device space, or else in a short list of large items
+// (at most kMaxLarge alive); an operation not followed whose area spans more
+// than kMarkCells cells is kept as one mark, judged at read time, instead of
+// visiting what it covers; a cover of the whole canvas empties the set at
+// once; an area spanning more cells than the set has items walks the items,
+// not the cells; the large list drops its dead at every operation, and dead
+// cell entries are dropped by a squeeze inside the replay once they
+// outnumber the live ones; "the same again" is found by a hash of the
+// quantised device start point. Left: one cell may hold many small items
+// (up to the caps), each operation on it scanning them all.
+//
+// Only contexts of an HTMLCanvasElement own one: an OffscreenCanvas's and the
+// paint worklet's contexts keep a null record and record nothing. Everything
+// runs on the context's own (main) thread. Nothing here is reachable from
+// script; the log is off the Oilpan heap except one reference per font that a
+// showing run or a logged draw uses, released once none does.
+class MODULES_EXPORT CanvasTextRecord final
+    : public GarbageCollected<CanvasTextRecord>,
+      public FontSelectorClient {
+ public:
+  // Whether a new context records: true under --enable-canvas-text-record.
+  // Read once per process.
+  static bool Enabled();
+
+  CanvasTextRecord();
+  CanvasTextRecord(const CanvasTextRecord&) = delete;
+  CanvasTextRecord& operator=(const CanvasTextRecord&) = delete;
+  ~CanvasTextRecord();
+
+  // ---- Draw time.
+
+  // fillText, strokeText and the cluster draws, before their Draw<>: what the
+  // draw has in hand, kept until that Draw<> hands OnDraw its clip (a draw
+  // that does nothing never gets there). `location` is the run's left end on
+  // the alphabetic baseline, in the text's own coordinates; `width` its
+  // advance after the maxWidth squeeze, `font_width` before it.
+  void PendText(Canvas2DRecorderContext& context,
+                const String& text,
+                unsigned start,
+                unsigned end,
+                const Font& font,
+                const SimpleFontData& font_data,
+                bool rtl,
+                bool bidi_override,
+                const gfx::PointF& location,
+                double width,
+                double font_width,
+                bool stroke);
+  // Every draw through Canvas2DRecorderContext::Draw, after its own checks:
+  // text takes the pending text; fillRect is followed; everything else is an
+  // operation the record does not follow, with its local bounds.
+  void OnDraw(Canvas2DRecorderContext& context,
+              const gfx::RectF& bounds,
+              CanvasRenderingContext2DState::PaintType paint_type,
+              CanvasPerformanceMonitor::DrawType draw_type,
+              const SkIRect& clip_bounds);
+  void OnClear(Canvas2DRecorderContext& context,
+               const gfx::RectF& rect,
+               const SkIRect& clip_bounds);
+  // Pixels changed outside the transform and the clip, in device pixels: a
+  // putImageData, a focus ring.
+  void OnDeviceDraw(Canvas2DRecorderContext& context,
+                    const gfx::Rect& device_rect);
+  // The outermost endLayer, with the canvas the layer was drawn into.
+  void OnLayerEnd(Canvas2DRecorderContext& context, cc::PaintCanvas& canvas);
+  // reset(), a resize and a lost context.
+  void Clear();
+
+  // ---- Read time.
+  enum class Inexact : uint8_t {
+    kNone,
+    kPartlyCovered,
+    kNotFollowed,
+    kFontChanged,
+  };
+  struct RunReading {
+    String text;
+    String font;
+    String color;
+    double alpha = 1;
+    bool stroke = false;
+    bool rtl = false;
+    bool bidi = false;
+    // In canvas pixels (the transform applied): the left and right ends of
+    // the baseline and the run's box (left-top, right-top, right-bottom,
+    // left-bottom).
+    gfx::PointF start;
+    gfx::PointF end;
+    gfx::QuadF quad;
+    // In the text's own units.
+    double width = 0;
+    Vector<double> advances;
+    Inexact inexact = Inexact::kNone;
+  };
+  struct FillReading {
+    gfx::QuadF quad;  // canvas pixels
+    String color;
+    double alpha = 1;
+    Inexact inexact = Inexact::kNone;
+  };
+  struct Reading {
+    Vector<RunReading> runs;
+    Vector<FillReading> fills;
+    bool truncated = false;
+    // Runs and fills still showing and kept by the caller's filter, left out
+    // past its caps (the oldest go first).
+    wtf_size_t runs_left = 0;
+    wtf_size_t fills_left = 0;
+    wtf_size_t chars = 0;
+    // The record's own memory, estimated from its stores' capacities, now
+    // and at its highest (measured at the end of each compaction).
+    uint64_t memory_bytes = 0;
+    uint64_t peak_bytes = 0;
+  };
+  // What still shows, oldest first: the runs and fills `keep` accepts (given
+  // each one's quad in canvas pixels), at most `max_runs` runs of
+  // `max_chars` UTF-16 units in all and `max_fills` fills, the newest kept.
+  // Only the runs answered are shaped, by the reader's own canvas-mode
+  // painter, never starting a font load.
+  void Read(const gfx::Size& canvas_size,
+            PlainTextPainter& painter,
+            wtf_size_t max_runs,
+            wtf_size_t max_chars,
+            wtf_size_t max_fills,
+            base::FunctionRef<bool(const gfx::QuadF&)> keep,
+            Reading& out);
+
+  // FontSelectorClient: a font came, went or loaded, and fallback lists may
+  // have been invalidated. Registered with the selector of each font a draw
+  // brings, which holds it weakly.
+  void FontsNeedUpdate(FontSelector*, FontInvalidationReason) override;
+
+  void Trace(Visitor*) const override;
+
+  // The showing set's caps, the log's compaction size, and the index's
+  // bounds.
+  static constexpr wtf_size_t kMaxRuns = 20000;
+  static constexpr wtf_size_t kMaxFills = 20000;
+  static constexpr wtf_size_t kMaxChars = 1000000;
+  static constexpr wtf_size_t kMaxRunChars = 4096;
+  static constexpr wtf_size_t kCompactAt = 2048;
+  static constexpr int kMaxItemCells = 16;
+  static constexpr wtf_size_t kMaxLarge = 256;
+  static constexpr int kMarkCells = 64;
+  static constexpr wtf_size_t kMaxMarks = 64;
+
+ private:
+  enum class Kind : uint8_t { kText, kFill, kClear, kOther, kDevice };
+  enum class Style : uint8_t { kColor, kGradient, kPattern };
+
+  // One call, as the draw had it in hand; the text fields for kText only.
+  struct Entry {
+    String text;  // the drawn part only
+    SkIRect clip;
+    float m[6];
+    // kFill, kClear, kOther: local; kDevice: device.
+    gfx::RectF rect;
+    Color color;
+    float alpha = 1;
+    float x = 0;  // kText: left end, alphabetic baseline, text space
+    float y = 0;
+    float width = 0;
+    float font_width = 0;
+    float ascent = 0;
+    float descent = 0;
+    uint32_t font = 0;  // in fonts_
+    Kind kind = Kind::kOther;
+    uint8_t composite = 0;  // SkBlendMode
+    Style style = Style::kColor;
+    bool clip_exact = false;
+    bool shadow_or_filter = false;
+    bool stroke = false;
+    // kOther: a straight stroke along an axis, at most 3 px wide (an
+    // underline, a squiggle, a rule): it can cross a run's central band, but
+    // cannot hide a fill.
+    bool line = false;
+    bool rtl = false;
+    bool bidi_override = false;
+  };
+
+  // A showing run or fill.
+  struct Item {
+    gfx::QuadF quad;    // device: a run's box, a fill's rect
+    gfx::RectF box;     // quad's bounds
+    gfx::RectF band;    // a run's central band's bounds; a fill's box
+    String text;        // runs
+    gfx::PointF start;  // runs: the device baseline's ends
+    gfx::PointF end;
+    Color color;
+    float alpha = 1;
+    float width = 0;
+    float font_width = 0;
+    // Read-time cache: caret positions before the squeeze, and the width
+    // shaped.
+    Vector<float> positions;
+    float shaped_width = 0;
+    uint32_t seq = 0;        // order of adding
+    uint32_t stamp = 0;      // the last scan that met it
+    uint32_t next_same = 0;  // the next in its hash chain, plus one
+    uint32_t font = 0;
+    uint16_t cells = 0;  // grid entries it holds; 0 for a large one
+    Inexact inexact = Inexact::kNone;
+    Style style = Style::kColor;
+    bool alive = true;
+    bool fill = false;
+    bool stroke = false;
+    bool rtl = false;
+    bool bidi_override = false;
+    bool rectilinear = true;
+    bool bidi = false;
+    bool cached = false;
+  };
+
+  // A grid cell's (or the large list's) reference to an item, with its box,
+  // so a scan reads the item only where the boxes meet.
+  struct CellEntry {
+    uint32_t index;
+    float left;
+    float top;
+    float right;
+    float bottom;
+  };
+
+  // An operation not followed over a large area: what was showing before it
+  // (seq below) and meets it is not followed. `fills`: it can hide fills too.
+  struct Mark {
+    gfx::RectF area;
+    uint32_t seq;
+    bool fills;
+  };
+
+  void Begin(Canvas2DRecorderContext& context, Entry& entry, Kind kind);
+  void Append(Canvas2DRecorderContext& context, Entry& entry);
+  bool SameAsLast(const Entry& entry) const;
+  uint32_t FontIndex(const Font& font);
+  void Compact(const gfx::Size& canvas_size);
+  void Apply(Entry& entry);
+  void Cover(const gfx::RectF& area);
+  void NotFollowed(const gfx::RectF& area, bool fills);
+  void AddRun(Entry& entry);
+  void AddFill(const Entry& entry, const gfx::QuadF& quad);
+  void Add(Item&& item);
+  void Index(uint32_t index);
+  template <typename Visit>
+  void ForEachIn(const gfx::RectF& area, const Visit& visit);
+  template <typename Visit>
+  void ForEachSame(bool fill, const gfx::PointF& at, const Visit& visit);
+  Vector<CellEntry>& CellAt(int row, int col);
+  void Kill(uint32_t index);
+  void KillOldest(bool fill);
+  void MaybeSqueeze();
+  void Squeeze();
+  void EmptyShown();
+  // `system_fonts`: the system-only fonts made during one read, by font slot.
+  void Shape(Item& run,
+             PlainTextPainter& painter,
+             HeapVector<Member<const Font>>& system_fonts);
+  Inexact MarkedInexact(const Item& item) const;
+  uint64_t MemoryBytes() const;
+  static gfx::PointF Map(const float m[6], float x, float y);
+  static uint64_t SameKey(bool fill, float x, float y);
+
+  // The raw log, and the text draw waiting for its Draw<> with its font.
+  Vector<Entry> log_;
+  Entry pending_;
+  Member<const Font> pending_font_;
+  bool has_pending_ = false;
+
+  // The showing set, oldest first.
+  Vector<Item> items_;
+  wtf_size_t runs_alive_ = 0;
+  wtf_size_t fills_alive_ = 0;
+  wtf_size_t chars_alive_ = 0;
+  wtf_size_t large_alive_ = 0;
+  wtf_size_t runs_head_ = 0;  // the oldest that may be alive
+  wtf_size_t fills_head_ = 0;
+  wtf_size_t dead_items_ = 0;
+  uint32_t next_seq_ = 1;
+  // The grid (rows_ by cols_, row-major); a cell whose generation is not
+  // grid_gen_ is empty. The large items' list. Live and dead entries in both.
+  Vector<Vector<CellEntry>> cells_;
+  Vector<uint32_t> cell_gen_;
+  uint32_t grid_gen_ = 1;
+  int cols_ = 0;
+  int rows_ = 0;
+  Vector<CellEntry> large_;
+  wtf_size_t live_entries_ = 0;
+  wtf_size_t dead_entries_ = 0;
+  // The same-again index: a quantised device start point to the head of its
+  // chain of items (an index plus one).
+  HashMap<uint64_t, uint32_t> same_;
+  Vector<Mark> marks_;
+  gfx::Size canvas_size_;
+  uint64_t peak_bytes_ = 0;
+  uint32_t stamp_ = 0;
+  bool truncated_ = false;
+  // Draws inside a layer since the outermost beginLayer.
+  bool drew_in_layer_ = false;
+  // The fonts showing runs and logged draws use (a slot is null once none
+  // does), how many use each, and each one's CSS string once written.
+  HeapVector<Member<const Font>> fonts_;
+  Vector<uint32_t> font_uses_;
+  Vector<String> font_css_;
+  Vector<uint32_t> free_fonts_;
+  // The last font asked for and its slot: compared only, and only while that
+  // slot holds it.
+  UntracedMember<const Font> last_font_;
+  uint32_t last_font_index_ = 0;
+  // Per slot: whether the font's list may have been invalidated (and since
+  // refreshed) after the last text draw with it. Clear: its list is the one
+  // that draw used, whose primary font that draw determined (the page's own
+  // lookup). Set by FontsNeedUpdate, cleared by a draw.
+  Vector<bool> font_stale_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_CANVAS_TEXT_RECORD_H_
