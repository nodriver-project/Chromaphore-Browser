+
+// The record's own memory, from its stores' capacities (strings by their
+// characters).
+uint64_t CanvasTextRecord::MemoryBytes() const {
+  uint64_t bytes = sizeof(*this);
+  bytes += uint64_t{log_.capacity()} * sizeof(Entry);
+  for (const Entry& entry : log_) {
+    bytes += uint64_t{entry.text.CharactersSizeInBytes()};
+  }
+  bytes += uint64_t{items_.capacity()} * sizeof(Item);
+  for (const Item& item : items_) {
+    bytes += uint64_t{item.text.CharactersSizeInBytes()} +
+             uint64_t{item.positions.capacity()} * sizeof(float);
+  }
+  bytes += uint64_t{cells_.capacity()} * sizeof(Vector<CellEntry>) +
+           uint64_t{cell_gen_.capacity()} * sizeof(uint32_t);
+  for (const Vector<CellEntry>& cell : cells_) {
+    bytes += uint64_t{cell.capacity()} * sizeof(CellEntry);
+  }
+  bytes += uint64_t{large_.capacity()} * sizeof(CellEntry);
+  bytes += uint64_t{same_.Capacity()} * (sizeof(uint64_t) + sizeof(uint32_t));
+  bytes += uint64_t{marks_.capacity()} * sizeof(Mark);
+  bytes += uint64_t{fonts_.capacity()} * sizeof(Member<const Font>) +
+           uint64_t{font_uses_.capacity()} * sizeof(uint32_t) +
+           uint64_t{font_css_.capacity()} * sizeof(String) +
+           uint64_t{free_fonts_.capacity()} * sizeof(uint32_t);
+  return bytes;
+}
+
+// ---- The replay.
+
+void CanvasTextRecord::EmptyShown() {
+  for (const Item& item : items_) {
+    if (item.alive && !item.fill) {
+      --font_uses_[item.font];
+    }
+  }
+  items_.Shrink(0);
+  runs_alive_ = 0;
+  fills_alive_ = 0;
+  chars_alive_ = 0;
+  large_alive_ = 0;
+  runs_head_ = 0;
+  fills_head_ = 0;
+  dead_items_ = 0;
+  // Every cell empty at once: each is emptied when next used.
+  ++grid_gen_;
+  large_.Shrink(0);
+  live_entries_ = 0;
+  dead_entries_ = 0;
+  same_.clear();
+  marks_.Shrink(0);
+}
+
+Vector<CanvasTextRecord::CellEntry>& CanvasTextRecord::CellAt(int row,
+                                                              int col) {
+  const wtf_size_t index = row * cols_ + col;
+  if (cell_gen_[index] != grid_gen_) {
+    cells_[index].Shrink(0);
+    cell_gen_[index] = grid_gen_;
+  }
+  return cells_[index];
+}
+
+void CanvasTextRecord::Compact(const gfx::Size& canvas_size) {
+  canvas_size_ = canvas_size;
+  if (cols_ == 0) {
+    // The grid's width is the canvas's, fixed until Clear() (a resize goes
+    // through it).
+    cols_ = std::clamp(
+        static_cast<int>(std::ceil(canvas_size.width() / kCellWidth)), 1,
+        kMaxCols);
+  }
+  for (Entry& entry : log_) {
+    Apply(entry);
+    MaybeSqueeze();
+  }
+  // The record at its fullest: the log, and the set before the next squeeze.
+  peak_bytes_ = std::max(peak_bytes_, MemoryBytes());
+  log_.Shrink(0);
+  // The fonts no showing run and no logged draw uses any more go.
+  for (wtf_size_t i = 0; i < fonts_.size(); ++i) {
+    if (fonts_[i] && font_uses_[i] == 0) {
+      fonts_[i] = nullptr;
+      font_css_[i] = String();
+      free_fonts_.push_back(i);
+      if (last_font_index_ == i) {
+        last_font_ = nullptr;
+      }
+    }
+  }
+}
+
+void CanvasTextRecord::Apply(Entry& entry) {
+  const SkBlendMode mode = static_cast<SkBlendMode>(entry.composite);
+  const gfx::RectF clip = ClipRect(entry.clip);
+  // Under copy, a draw first clears its whole clip, whatever it draws.
+  if (mode == SkBlendMode::kSrc &&
+      (entry.kind == Kind::kText || entry.kind == Kind::kFill ||
+       entry.kind == Kind::kOther)) {
+    if (entry.clip_exact) {
+      Cover(clip);
+    } else {
+      NotFollowed(clip, /*fills=*/true);
+    }
+  }
+  const bool followed =
+      (mode == SkBlendMode::kSrcOver || mode == SkBlendMode::kSrc) &&
+      !entry.shadow_or_filter;
+  // Where an operation not followed may have changed pixels.
+  const auto touched = [&](const gfx::RectF& device_bounds) {
+    if (IsFullClipMode(mode) || entry.shadow_or_filter) {
+      return clip;
+    }
+    gfx::RectF area = device_bounds;
+    area.Outset(1);  // antialiasing
+    area.Intersect(clip);
+    return area;
+  };
+  const auto quad_of = [&](const gfx::RectF& rect) {
+    return gfx::QuadF(Map(entry.m, rect.x(), rect.y()),
+                      Map(entry.m, rect.right(), rect.y()),
+                      Map(entry.m, rect.right(), rect.bottom()),
+                      Map(entry.m, rect.x(), rect.bottom()));
+  };
+  switch (entry.kind) {
+    case Kind::kText: {
+      if (!followed) {
+        NotFollowed(touched(quad_of(gfx::RectF(entry.x, entry.y - entry.ascent,
+                                               entry.width,
+                                               entry.ascent + entry.descent))
+                                .BoundingBox()),
+                    /*fills=*/true);
+        --font_uses_[entry.font];
+        return;
+      }
+      AddRun(entry);
+      return;
+    }
+    case Kind::kFill: {
+      const gfx::QuadF quad = quad_of(entry.rect);
+      if (!followed) {
+        NotFollowed(touched(quad.BoundingBox()), /*fills=*/true);
+        return;
+      }
+      const bool opaque = entry.style == Style::kColor &&
+                          entry.color.IsOpaque() && entry.alpha >= 1;
+      if (opaque) {
+        gfx::RectF area = quad.BoundingBox();
+        if (entry.clip_exact && AxisAligned(entry.m)) {
+          area.Intersect(clip);
+          Cover(area);
+        } else {
+          NotFollowed(touched(area), /*fills=*/true);
+        }
+      } else if (entry.style != Style::kColor) {
+        // A gradient or a pattern may hide the text under it: the runs it
+        // crosses are not followed (a fill under it stays as it is).
+        NotFollowed(touched(quad.BoundingBox()), /*fills=*/false);
+      }
+      AddFill(entry, quad);
+      return;
+    }
+    case Kind::kClear: {
+      gfx::RectF area = quad_of(entry.rect).BoundingBox();
+      if (entry.clip_exact && AxisAligned(entry.m)) {
+        area.Intersect(clip);
+        Cover(area);
+      } else {
+        area.Outset(1);
+        area.Intersect(clip);
+        NotFollowed(area, /*fills=*/true);
+      }
+      return;
+    }
+    case Kind::kOther: {
+      const gfx::RectF bounds = quad_of(entry.rect).BoundingBox();
+      if (entry.line && mode == SkBlendMode::kSrcOver &&
+          !entry.shadow_or_filter && AxisAligned(entry.m)) {
+        // A line drawn plainly touches the whole pixels its stroke lies in,
+        // no more; and it leaves fills as they are.
+        gfx::RectF area(gfx::ToEnclosingRect(bounds));
+        area.Intersect(clip);
+        NotFollowed(area, /*fills=*/false);
+      } else {
+        NotFollowed(touched(bounds), /*fills=*/true);
+      }
+      return;
+    }
+    case Kind::kDevice: {
+      gfx::RectF area = entry.rect;
+      area.Intersect(clip);
+      NotFollowed(area, /*fills=*/true);
+      return;
+    }
+  }
+}
+
+template <typename Visit>
+void CanvasTextRecord::ForEachIn(const gfx::RectF& area, const Visit& visit) {
+  const float left = area.x();
+  const float top = area.y();
+  const float right = area.right();
+  const float bottom = area.bottom();
+  const auto meets = [&](float l, float t, float r, float b) {
+    return r >= left && l <= right && b >= top && t <= bottom;
+  };
+  // The large items, the dead dropped first wherever they lie: the list
+  // holds at most kMaxLarge live entries and those that died since the last
+  // operation.
+  {
+    wtf_size_t kept = 0;
+    for (wtf_size_t i = 0; i < large_.size(); ++i) {
+      const CellEntry entry = large_[i];
+      Item& item = items_[entry.index];
+      if (!item.alive) {
+        --dead_entries_;
+        continue;  // dropped
+      }
+      large_[kept++] = entry;
+      if (meets(entry.left, entry.top, entry.right, entry.bottom) &&
+          item.stamp != stamp_) {
+        item.stamp = stamp_;
+        visit(entry.index);
+      }
+    }
+    large_.Shrink(kept);
+  }
+  if (rows_ == 0) {
+    return;
+  }
+  const int col_first = CellOf(left, kCellWidth, cols_);
+  const int col_last = CellOf(right, kCellWidth, cols_);
+  const int row_first = CellOf(top, kCellHeight, rows_);
+  const int row_last = CellOf(bottom, kCellHeight, rows_);
+  const int64_t cells =
+      int64_t{col_last - col_first + 1} * int64_t{row_last - row_first + 1};
+  if (cells > static_cast<int64_t>(items_.size())) {
+    // More cells than items (a cover of most of a large canvas): the small
+    // items themselves, so the work is the set's size, never the area's.
+    for (wtf_size_t i = 0; i < items_.size(); ++i) {
+      Item& item = items_[i];
+      if (!item.alive || !item.cells) {
+        continue;  // dead, or large (seen above)
+      }
+      const gfx::RectF& box = item.box;
+      if (meets(box.x(), box.y(), box.right(), box.bottom()) &&
+          item.stamp != stamp_) {
+        item.stamp = stamp_;
+        visit(i);
+      }
+    }
+    return;
+  }
+  // Kept entries move down over the dead ones met: a dead one is scanned at
+  // most once more.
+  const auto scan = [&](Vector<CellEntry>& entries) {
+    wtf_size_t kept = 0;
+    for (wtf_size_t i = 0; i < entries.size(); ++i) {
+      const CellEntry entry = entries[i];
+      if (meets(entry.left, entry.top, entry.right, entry.bottom)) {
+        Item& item = items_[entry.index];
+        if (!item.alive) {
+          --dead_entries_;
+          continue;  // dropped
+        }
+        if (item.stamp != stamp_) {
+          item.stamp = stamp_;
+          visit(entry.index);
+        }
+      }
+      entries[kept++] = entry;
+    }
+    entries.Shrink(kept);
+  };
+  for (int row = row_first; row <= row_last; ++row) {
+    for (int col = col_first; col <= col_last; ++col) {
+      scan(CellAt(row, col));
+    }
+  }
+}
+
+template <typename Visit>
+void CanvasTextRecord::ForEachSame(bool fill,
+                                   const gfx::PointF& at,
+                                   const Visit& visit) {
+  // Every point within kSame of `at` lies in one of four unit squares.
+  const float x0 = std::floor(at.x() - kSame);
+  const float y0 = std::floor(at.y() - kSame);
+  for (int dx = 0; dx < 2; ++dx) {
+    for (int dy = 0; dy < 2; ++dy) {
+      auto it = same_.find(SameKey(fill, x0 + dx, y0 + dy));
+      if (it == same_.end()) {
+        continue;
+      }
+      // Walk its chain, unlinking the dead.
+      uint32_t previous = 0;
+      uint32_t current = it->value;
+      while (current) {
+        Item& item = items_[current - 1];
+        const uint32_t next = item.next_same;
+        if (!item.alive) {
+          if (previous) {
+            items_[previous - 1].next_same = next;
+          } else {
+            it->value = next;
+          }
+          current = next;
+          continue;
+        }
+        visit(current - 1);
+        previous = current;
+        current = next;
+      }
+    }
+  }
+}
+
+void CanvasTextRecord::Index(uint32_t index) {
+  Item& item = items_[index];
+  const gfx::RectF& box = item.box;
+  const CellEntry entry{index, box.x(), box.y(), box.right(), box.bottom()};
+  const int col_first = CellOf(box.x(), kCellWidth, cols_);
+  const int col_last = CellOf(box.right(), kCellWidth, cols_);
+  const int row_first = CellOf(box.y(), kCellHeight, kMaxRows);
+  const int row_last = CellOf(box.bottom(), kCellHeight, kMaxRows);
+  const int count = (col_last - col_first + 1) * (row_last - row_first + 1);
+  if (count > kMaxItemCells) {
+    // Large: one entry in the short list, scanned by every operation.
+    large_.push_back(entry);
+    item.cells = 0;
+    ++large_alive_;
+    ++live_entries_;
+  } else {
+    if (row_last >= rows_) {
+      rows_ = row_last + 1;
+      cells_.resize(rows_ * cols_);
+      cell_gen_.resize(rows_ * cols_);  // generation 0: empty
+    }
+    for (int row = row_first; row <= row_last; ++row) {
+      for (int col = col_first; col <= col_last; ++col) {
+        CellAt(row, col).push_back(entry);
+      }
+    }
+    item.cells = static_cast<uint16_t>(count);
+    live_entries_ += count;
+  }
+  // The same-again index.
+  const gfx::PointF& at = item.fill ? item.quad.p1() : item.start;
+  const uint64_t key = SameKey(item.fill, at.x(), at.y());
+  auto result = same_.insert(key, index + 1);
+  if (!result.is_new_entry) {
+    item.next_same = result.stored_value->value;
+    result.stored_value->value = index + 1;
+  } else {
+    item.next_same = 0;
+  }
+}
+
+void CanvasTextRecord::Kill(uint32_t index) {
+  Item& item = items_[index];
+  if (!item.alive) {
+    return;
+  }
+  item.alive = false;
+  ++dead_items_;
+  const wtf_size_t entries = item.cells ? item.cells : 1;
+  live_entries_ -= entries;
+  dead_entries_ += entries;
+  if (!item.cells) {
+    --large_alive_;
+  }
+  if (item.fill) {
+    --fills_alive_;
+  } else {
+    --runs_alive_;
+    chars_alive_ -= item.text.length();
+    --font_uses_[item.font];
+    item.text = String();
+    item.positions.clear();
+  }
+}
+
+void CanvasTextRecord::KillOldest(bool fill) {
+  wtf_size_t& head = fill ? fills_head_ : runs_head_;
+  while (head < items_.size() &&
+         (!items_[head].alive || items_[head].fill != fill)) {
+    ++head;
+  }
+  if (head < items_.size()) {
+    Kill(head);
+  }
+}
+
+void CanvasTextRecord::Add(Item&& item) {
+  item.seq = next_seq_++;
+  const bool fill = item.fill;
+  const wtf_size_t length = item.text.length();
+  const uint32_t index = items_.size();
+  items_.push_back(std::move(item));
+  if (fill) {
+    ++fills_alive_;
+  } else {
+    ++runs_alive_;
+    chars_alive_ += length;
+  }
+  Index(index);
+  // Rule 7: past a cap, the oldest go.
+  while (runs_alive_ > kMaxRuns || chars_alive_ > kMaxChars) {
+    KillOldest(/*fill=*/false);
+    truncated_ = true;
+  }
+  while (fills_alive_ > kMaxFills) {
+    KillOldest(/*fill=*/true);
+    truncated_ = true;
+  }
+  if (large_alive_ > kMaxLarge) {
+    // The oldest large one goes.
+    uint32_t oldest = std::numeric_limits<uint32_t>::max();
+    uint32_t oldest_seq = std::numeric_limits<uint32_t>::max();
+    for (const CellEntry& entry : large_) {
+      const Item& large = items_[entry.index];
+      if (large.alive && large.seq < oldest_seq) {
+        oldest_seq = large.seq;
+        oldest = entry.index;
+      }
+    }
+    if (oldest != std::numeric_limits<uint32_t>::max()) {
+      Kill(oldest);
+      truncated_ = true;
+    }
+  }
+}
+
+void CanvasTextRecord::Cover(const gfx::RectF& area) {
+  if (area.IsEmpty()) {
+    return;
+  }
+  gfx::RectF slack = area;
+  slack.Outset(kSlack);
+  const gfx::RectF canvas_rect{gfx::SizeF(canvas_size_)};
+  if (slack.Contains(canvas_rect)) {
+    EmptyShown();
+    truncated_ = false;
+    return;
+  }
+  ++stamp_;
+  ForEachIn(area, [&](uint32_t index) {
+    Item& item = items_[index];
+    // What can show of it is what lies on the canvas: its central band's
+    // part there, or, with none of the band there, its box's.
+    bool inside;
+    if (item.rectilinear) {
+      gfx::RectF part;
+      if (!CutTo(item.band, canvas_rect, part) &&
+          !CutTo(item.box, canvas_rect, part)) {
+        return;  // nothing of it on the canvas: no cover changes it
+      }
+      inside = Within(part, slack);
+    } else {
+      inside = QuadInside(area, item.fill ? item.quad : CentralBand(item.quad));
+    }
+    if (inside) {
+      Kill(index);
+    } else if (Crosses(item.band, area) && item.inexact == Inexact::kNone) {
+      item.inexact = Inexact::kPartlyCovered;
+    }
+  });
+}
+
+void CanvasTextRecord::NotFollowed(const gfx::RectF& area, bool fills) {
+  if (area.IsEmpty()) {
+    return;
+  }
+  // A large area is one mark, judged at read time; a small one marks what it
+  // crosses now.
+  const int cols = CellOf(area.right(), kCellWidth, kMaxCols) -
+                   CellOf(area.x(), kCellWidth, kMaxCols) + 1;
+  const int rows = CellOf(area.bottom(), kCellHeight, kMaxRows) -
+                   CellOf(area.y(), kCellHeight, kMaxRows) + 1;
+  if (cols * rows > kMarkCells) {
+    if (!marks_.empty() && marks_.back().area == area &&
+        marks_.back().fills == fills) {
+      marks_.back().seq = next_seq_;  // the same again, later
+      return;
+    }
+    marks_.push_back(Mark{area, next_seq_, fills});
+    if (marks_.size() > kMaxMarks) {
+      // The two oldest as one: more is marked, never less.
+      Mark merged = marks_[0];
+      merged.area.Union(marks_[1].area);
+      merged.seq = std::max(marks_[0].seq, marks_[1].seq);
+      merged.fills = marks_[0].fills || marks_[1].fills;
+      marks_.EraseAt(0, 2);
+      marks_.push_front(merged);
+    }
+    return;
+  }
+  ++stamp_;
+  ForEachIn(area, [&](uint32_t index) {
+    Item& item = items_[index];
+    if (item.fill && !fills) {
+      return;
+    }
+    if (item.inexact == Inexact::kNone && Crosses(item.band, area)) {
+      item.inexact = Inexact::kNotFollowed;
+    }
+  });
+}
+
+CanvasTextRecord::Inexact CanvasTextRecord::MarkedInexact(
+    const Item& item) const {
+  for (const Mark& mark : marks_) {
+    if (mark.seq > item.seq && (!item.fill || mark.fills) &&
+        Crosses(item.band, mark.area)) {
+      return Inexact::kNotFollowed;
+    }
+  }
+  return Inexact::kNone;
+}
+
+void CanvasTextRecord::AddRun(Entry& entry) {
+  const float top = entry.y - entry.ascent;
+  const float bottom = entry.y + entry.descent;
+  const float left = entry.x;
+  const float right = entry.x + entry.width;
+  Item run;
+  run.quad =
+      gfx::QuadF(Map(entry.m, left, top), Map(entry.m, right, top),
+                 Map(entry.m, right, bottom), Map(entry.m, left, bottom));
+  run.box = run.quad.BoundingBox();
+  // Rule 1: a draw whose box misses the clip shows nothing. A run of no
+  // width (marks only) shows where its box lies inside the clip.
+  if (!Crosses(run.box, ClipRect(entry.clip))) {
+    --font_uses_[entry.font];
+    return;
+  }
+  run.band = CentralBand(run.quad).BoundingBox();
+  run.rectilinear = run.quad.IsRectilinear();
+  run.start = Map(entry.m, left, entry.y);
+  run.end = Map(entry.m, right, entry.y);
+
+  // Rule 2: the same text, font and style on the same device baseline
+  // replaces a showing run.
+  const FontDescription& description = fonts_[entry.font]->GetFontDescription();
+  ForEachSame(/*fill=*/false, run.start, [&](uint32_t index) {
+    Item& other = items_[index];
+    if (!Near(other.start, run.start) || !Near(other.end, run.end) ||
+        other.stroke != entry.stroke || other.style != entry.style ||
+        (entry.style == Style::kColor && other.color != entry.color)) {
+      return;
+    }
+    if (other.font != entry.font &&
+        fonts_[other.font]->GetFontDescription() != description) {
+      return;
+    }
+    if (other.text != entry.text) {
+      return;
+    }
+    Kill(index);
+  });
+
+  run.text = std::move(entry.text);
+  run.font = entry.font;  // its use moves to the run
+  run.style = entry.style;
+  run.color = entry.color;
+  run.alpha = entry.alpha;
+  run.stroke = entry.stroke;
+  run.width = entry.width;
+  run.font_width = entry.font_width;
+  run.rtl = entry.rtl;
+  run.bidi_override = entry.bidi_override;
+  Add(std::move(run));
+}
+
+void CanvasTextRecord::AddFill(const Entry& entry, const gfx::QuadF& quad) {
+  Item fill;
+  fill.fill = true;
+  fill.quad = quad;
+  fill.box = quad.BoundingBox();
+  if (!Crosses(fill.box, ClipRect(entry.clip)) || fill.box.IsEmpty()) {
+    return;  // rule 1
+  }
+  fill.band = fill.box;  // an operation not followed need only meet it
+  fill.rectilinear = quad.IsRectilinear();
+  fill.style = entry.style;
+  fill.color = entry.color;
+  fill.alpha = entry.alpha;
+  // Rule 2 for fills: the same device quad, colour and alpha.
+  ForEachSame(/*fill=*/true, quad.p1(), [&](uint32_t index) {
+    Item& other = items_[index];
+    if (other.style == fill.style && other.alpha == fill.alpha &&
+        (fill.style != Style::kColor || other.color == fill.color) &&
+        Near(other.quad.p1(), quad.p1()) && Near(other.quad.p2(), quad.p2()) &&
+        Near(other.quad.p3(), quad.p3()) && Near(other.quad.p4(), quad.p4())) {
+      Kill(index);
+    }
+  });
+  Add(std::move(fill));
+}
+
+void CanvasTextRecord::MaybeSqueeze() {
+  if (dead_entries_ > live_entries_ + kDeadSlack ||
+      dead_items_ > runs_alive_ + fills_alive_ + kDeadSlack) {
+    Squeeze();
+  }
+}
+
+// Drops the dead items and index entries, rebuilds the index, and drops the
+// marks nothing showing is older than.
+void CanvasTextRecord::Squeeze() {
+  wtf_size_t kept = 0;
+  for (wtf_size_t i = 0; i < items_.size(); ++i) {
+    if (items_[i].alive) {
+      if (kept != i) {
+        items_[kept] = std::move(items_[i]);
+      }
+      ++kept;
+    }
+  }
+  items_.Shrink(kept);
+  runs_head_ = 0;
+  fills_head_ = 0;
+  dead_items_ = 0;
+  ++grid_gen_;
+  large_.Shrink(0);
+  live_entries_ = 0;
+  dead_entries_ = 0;
+  large_alive_ = 0;
+  same_.clear();
+  uint32_t oldest = next_seq_;
+  for (wtf_size_t i = 0; i < items_.size(); ++i) {
+    oldest = std::min(oldest, items_[i].seq);
+    Index(i);
+  }
+  wtf_size_t marks_kept = 0;
+  for (const Mark& mark : marks_) {
+    if (mark.seq > oldest) {
+      marks_[marks_kept++] = mark;
+    }
+  }
+  marks_.Shrink(marks_kept);
+}
+
+// ---- Read time.
+
+// The caret positions of the run's boundaries, from its left end, from the
+// shaping the draw used (the items' ShapeResults, as TextMetrics takes them),
+// with the font as the draw had it. Never starts a font load, and never
+// makes, refreshes or revalidates a fallback list the page's fonts share, nor
+// determines its primary font (FontFallbackList's primary-font lookup begins
+// a load unguarded): the page's font is used only when a text draw used it
+// since the last font invalidation (so its list is that draw's, whose primary
+// font the draw determined) and its list holds no web font not loaded (a
+// loading fallback). Any other run -- its font's lists invalidated since its
+// last draw (a web font came, went or loaded), or holding a web font not
+// loaded -- is shaped with its system fonts only: the same glyphs when the
+// run used no web font, which its width then shows; otherwise the run says
+// the font changed.
+void CanvasTextRecord::Shape(Item& run,
+                             PlainTextPainter& painter,
+                             HeapVector<Member<const Font>>& system_fonts) {
+  if (run.cached) {
+    return;
+  }
+  const unsigned length = run.text.length();
+  run.positions.resize(length + 1);
+  const Font* font = fonts_[run.font].Get();
+  if (!font) {
+    for (unsigned k = 0; k <= length; ++k) {
+      const float at = length ? run.font_width * k / length : 0;
+      run.positions[k] = run.rtl ? run.font_width - at : at;
+    }
+    run.shaped_width = -1;  // not shaped
+    run.bidi = false;
+    return;  // not cached: a later read may shape it
+  }
+  // The page's font when its list is still the one its last draw used (with
+  // the primary font that draw determined) and holds no loading fallback. A
+  // valid list is its description's entry in its selector's map, so Get()
+  // finds the font's own list and creates nothing.
+  bool system_only = true;
+  if (!font_stale_[run.font] && font->IsFallbackValid()) {
+    if (FontSelector* selector = font->GetFontSelector()) {
+      system_only = selector->GetFontFallbackMap()
+                        .Get(font->GetFontDescription())
+                        ->HasLoadingFallback();
+    }
+  }
+  if (system_only) {
+    // No selector: the list comes from the font cache's own map, which holds
+    // system fonts only and is not the page's. One per font slot and read.
+    if (system_fonts.size() <= run.font) {
+      system_fonts.resize(fonts_.size());
+    }
+    if (!system_fonts[run.font]) {
+      system_fonts[run.font] =
+          MakeGarbageCollected<Font>(font->GetFontDescription());
+    }
+    font = system_fonts[run.font].Get();
+  }
+  ScopedNoFontLoads no_font_loads;
+  const TextDirection direction =
+      run.rtl ? TextDirection::kRtl : TextDirection::kLtr;
+  const PlainTextNode& node = painter.SegmentAndShape(
+      TextRun(run.text, direction, run.bidi_override), *font);
+  Vector<bool> placed(length + 1, false);
+  float x = 0;
+  bool ltr_items = false;
+  bool rtl_items = false;
+  for (const PlainTextItem& item : node.ItemList()) {
+    const ShapeResult* result = item.GetShapeResult();
+    if (!result) {
+      continue;
+    }
+    (item.Direction() == TextDirection::kRtl ? rtl_items : ltr_items) = true;
+    const unsigned from = std::min<unsigned>(item.StartOffset(), length);
+    const unsigned to = std::min<unsigned>(item.EndOffset(), length);
+    for (unsigned i = from; i <= to; ++i) {
+      // At a boundary between two items, the first in visual order's, as
+      // TextMetrics' first rect for that offset.
+      if (placed[i]) {
+        continue;
+      }
+      placed[i] = true;
+      run.positions[i] =
+          result->CaretPositionForOffset(i - item.StartOffset(), item.Text(),
+                                         AdjustMidCluster::kToStart) +
+          x;
+    }
+    x += result->Width();
+  }
+  run.shaped_width = x;
+  run.bidi = ltr_items && rtl_items;
+  for (unsigned k = 0; k <= length; ++k) {
+    if (!placed[k]) {
+      run.positions[k] = k > 0 ? run.positions[k - 1] : (run.rtl ? x : 0);
+    }
+  }
+  // Shaped with system fonts only, it is kept only when it came out as wide
+  // as the draw (it used no web font); else a later read, with the page's
+  // list valid again, may do better.
+  run.cached = !system_only || std::abs(x - run.font_width) <=
+                                   std::max(0.01f, 1e-4f * run.font_width);
+}
+
+void CanvasTextRecord::Read(const gfx::Size& canvas_size,
+                            PlainTextPainter& painter,
+                            wtf_size_t max_runs,
+                            wtf_size_t max_chars,
+                            wtf_size_t max_fills,
+                            base::FunctionRef<bool(const gfx::QuadF&)> keep,
+                            Reading& out) {
+  Compact(canvas_size);
+  out.truncated = truncated_;
+  // The runs answered: the newest the caller keeps, within its caps.
+  Vector<uint32_t> chosen;
+  wtf_size_t chars = 0;
+  for (wtf_size_t i = items_.size(); i > 0; --i) {
+    const Item& item = items_[i - 1];
+    if (!item.alive || item.fill || !keep(item.quad)) {
+      continue;
+    }
+    if (chosen.size() >= max_runs || chars + item.text.length() > max_chars) {
+      ++out.runs_left;
+      continue;
+    }
+    chosen.push_back(i - 1);
+    chars += item.text.length();
+  }
+  out.chars = chars;
+  out.memory_bytes = MemoryBytes();
+  out.peak_bytes = std::max(peak_bytes_, out.memory_bytes);
+  out.runs.ReserveInitialCapacity(chosen.size());
+  HeapVector<Member<const Font>> system_fonts;
+  for (wtf_size_t c = chosen.size(); c > 0; --c) {
+    Item& run = items_[chosen[c - 1]];
+    Shape(run, painter, system_fonts);
+    RunReading reading;
+    reading.text = run.text;
+    if (font_css_[run.font].IsNull()) {
+      font_css_[run.font] = FontCss(fonts_[run.font]->GetFontDescription());
+    }
+    reading.font = font_css_[run.font];
+    reading.color = run.style == Style::kColor
+                        ? run.color.SerializeAsCanvasColor()
+                    : run.style == Style::kGradient ? String("gradient")
+                                                    : String("pattern");
+    reading.alpha = run.alpha;
+    reading.stroke = run.stroke;
+    reading.rtl = run.rtl;
+    reading.bidi = run.bidi;
+    reading.start = run.start;
+    reading.end = run.end;
+    reading.quad = run.quad;
+    reading.width = run.width;
+    // The advances, in the run's units, so that the last boundary is at its
+    // width and every point stays in its box: shaped as drawn, the caret
+    // positions times the maxWidth squeeze, as the draw scales; shaped
+    // otherwise now (fontChanged), the current shaping scaled to the run's
+    // width; nothing shaped, spread evenly over it.
+    const bool font_changed =
+        run.shaped_width < 0 || std::abs(run.shaped_width - run.font_width) >
+                                    std::max(0.01f, 1e-4f * run.font_width);
+    const unsigned length = run.text.length();
+    reading.advances.ReserveInitialCapacity(run.positions.size());
+    if (!font_changed || run.shaped_width < 0 || run.shaped_width > 0) {
+      // Not shaped: the positions are already spread over font_width.
+      const double from = font_changed && run.shaped_width > 0
+                              ? run.shaped_width
+                              : run.font_width;
+      const double scale = from > 0 ? run.width / from : 1;
+      for (float p : run.positions) {
+        reading.advances.push_back(p * scale);
+      }
+    } else {
+      for (unsigned k = 0; k <= length; ++k) {
+        const double at = length ? run.width * k / length : 0;
+        reading.advances.push_back(run.rtl ? run.width - at : at);
+      }
+    }
+    reading.inexact =
+        run.inexact != Inexact::kNone ? run.inexact : MarkedInexact(run);
+    if (reading.inexact == Inexact::kNone && font_changed) {
+      reading.inexact = Inexact::kFontChanged;  // a font came or went since
+    }
+    if (!run.cached) {
+      run.positions.clear();
+    }
+    out.runs.push_back(std::move(reading));
+  }
+  // The fills answered: the newest the caller keeps, within its cap.
+  chosen.clear();
+  for (wtf_size_t i = items_.size(); i > 0; --i) {
+    const Item& item = items_[i - 1];
+    if (!item.alive || !item.fill || !keep(item.quad)) {
+      continue;
+    }
+    if (chosen.size() >= max_fills) {
+      ++out.fills_left;
+      continue;
+    }
+    chosen.push_back(i - 1);
+  }
+  out.fills.ReserveInitialCapacity(chosen.size());
+  for (wtf_size_t c = chosen.size(); c > 0; --c) {
+    const Item& fill = items_[chosen[c - 1]];
+    FillReading reading;
+    reading.quad = fill.quad;
+    reading.color = fill.style == Style::kColor
+                        ? fill.color.SerializeAsCanvasColor()
+                    : fill.style == Style::kGradient ? String("gradient")
+                                                     : String("pattern");
+    reading.alpha = fill.alpha;
+    reading.inexact =
+        fill.inexact != Inexact::kNone ? fill.inexact : MarkedInexact(fill);
+    out.fills.push_back(std::move(reading));
+  }
+}
+
+}  // namespace blink
