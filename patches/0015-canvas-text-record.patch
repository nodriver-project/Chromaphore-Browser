+ public:
+  ScopedNoFontLoads();
+  ScopedNoFontLoads(const ScopedNoFontLoads&) = delete;
+  ScopedNoFontLoads& operator=(const ScopedNoFontLoads&) = delete;
+  ~ScopedNoFontLoads();
+  static bool Active();
+};
