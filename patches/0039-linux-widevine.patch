diff --git a/media/cdm/windows_widevine.cc b/media/cdm/windows_widevine.cc
new file mode 100644
index 0000000000..b7e23787d6
--- /dev/null
+++ b/media/cdm/windows_widevine.cc
@@ -0,0 +1,400 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/cdm/windows_widevine.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/rand_util.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "components/browser/browser_switches.h"
+#include "third_party/boringssl/src/include/openssl/cipher.h"
+#include "third_party/boringssl/src/include/openssl/rsa.h"
+#include "url/origin.h"
+
+namespace media {
+
+namespace {
+
+constexpr char kWidevineKeySystem[] = "com.widevine.alpha";
+
+// The major Widevine streaming services, whose content must play: they get
+// the Linux Widevine unchanged. --widevine-playback-sites adds to them.
+constexpr const char* kPlaybackSites[] = {
+    "netflix.com",      "youtube.com",        "primevideo.com",
+    "amazon.com",       "disneyplus.com",     "hulu.com",
+    "max.com",          "hbomax.com",         "paramountplus.com",
+    "peacocktv.com",    "apple.com",          "spotify.com",
+    "tidal.com",        "crunchyroll.com",    "dazn.com",
+    "espn.com",         "sling.com",          "fubo.tv",
+    "starz.com",        "discoveryplus.com",  "mubi.com",
+    "plex.tv",          "vudu.com",           "fandangoathome.com",
+    "tubitv.com",       "pluto.tv",           "philo.com",
+};
+
+// SignedMessage.MessageType.
+constexpr uint64_t kLicenseRequestMessage = 1;
+constexpr uint64_t kServiceCertificateRequestMessage = 4;
+constexpr uint64_t kServiceCertificateMessage = 5;
+// DrmCertificate.Type.
+constexpr uint64_t kServiceCertificateType = 3;
+
+// The client identification Chrome 156's Widevine (4.10.3112.0) encrypts on
+// Windows: 3,696 bytes of ciphertext, so 3,680 to 3,695 bytes before AES's
+// padding (measured). The Linux one is about 1,470 bytes; the
+// rest is filler in ClientIdentification's vmp_data field (7), which
+// Windows' Widevine fills with its verified media path data.
+constexpr size_t kWindowsClientIdSize = 3680;
+constexpr uint32_t kVmpDataField = 7;
+
+// Protocol buffer wire format, as much of it as these messages need.
+struct Field {
+  uint32_t number = 0;
+  uint32_t wire_type = 0;
+  uint64_t varint = 0;
+  // The value of a length-delimited field.
+  base::span<const uint8_t> bytes;
+  // The whole field, tag included.
+  base::span<const uint8_t> encoded;
+};
+
+bool ReadVarint(base::span<const uint8_t> data, size_t& pos, uint64_t& value) {
+  value = 0;
+  for (int shift = 0; shift < 64; shift += 7) {
+    if (pos >= data.size()) {
+      return false;
+    }
+    const uint8_t byte = data[pos++];
+    value |= static_cast<uint64_t>(byte & 0x7f) << shift;
+    if (!(byte & 0x80)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<std::vector<Field>> Parse(base::span<const uint8_t> data) {
+  std::vector<Field> fields;
+  size_t pos = 0;
+  while (pos < data.size()) {
+    const size_t start = pos;
+    uint64_t key = 0;
+    if (!ReadVarint(data, pos, key)) {
+      return std::nullopt;
+    }
+    Field field;
+    field.number = static_cast<uint32_t>(key >> 3);
+    field.wire_type = static_cast<uint32_t>(key & 7);
+    if (field.number == 0) {
+      return std::nullopt;
+    }
+    switch (field.wire_type) {
+      case 0:
+        if (!ReadVarint(data, pos, field.varint)) {
+          return std::nullopt;
+        }
+        break;
+      case 1:
+        if (data.size() - pos < 8) {
+          return std::nullopt;
+        }
+        pos += 8;
+        break;
+      case 2: {
+        uint64_t length = 0;
+        if (!ReadVarint(data, pos, length) || length > data.size() - pos) {
+          return std::nullopt;
+        }
+        field.bytes = data.subspan(pos, static_cast<size_t>(length));
+        pos += static_cast<size_t>(length);
+        break;
+      }
+      case 5:
+        if (data.size() - pos < 4) {
+          return std::nullopt;
+        }
+        pos += 4;
+        break;
+      default:
+        return std::nullopt;
+    }
+    field.encoded = data.subspan(start, pos - start);
+    fields.push_back(field);
+  }
+  return fields;
+}
+
+const Field* Find(const std::vector<Field>& fields,
+                  uint32_t number,
+                  uint32_t wire_type) {
+  for (const Field& field : fields) {
+    if (field.number == number && field.wire_type == wire_type) {
+      return &field;
+    }
+  }
+  return nullptr;
+}
+
+void AppendVarint(std::vector<uint8_t>& out, uint64_t value) {
+  while (value >= 0x80) {
+    out.push_back(static_cast<uint8_t>(value | 0x80));
+    value >>= 7;
+  }
+  out.push_back(static_cast<uint8_t>(value));
+}
+
+void AppendBytesField(std::vector<uint8_t>& out,
+                      uint32_t number,
+                      base::span<const uint8_t> value) {
+  AppendVarint(out, (number << 3) | 2);
+  AppendVarint(out, value.size());
+  out.insert(out.end(), value.begin(), value.end());
+}
+
+void AppendRaw(std::vector<uint8_t>& out, base::span<const uint8_t> raw) {
+  out.insert(out.end(), raw.begin(), raw.end());
+}
+
+std::optional<std::vector<uint8_t>> AesCbcEncrypt(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> iv,
+    base::span<const uint8_t> plaintext) {
+  bssl::ScopedEVP_CIPHER_CTX context;
+  if (!EVP_EncryptInit_ex(context.get(), EVP_aes_128_cbc(), nullptr,
+                          key.data(), iv.data())) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> out(plaintext.size() + EVP_MAX_BLOCK_LENGTH);
+  int written = 0;
+  int final_written = 0;
+  if (!EVP_EncryptUpdate(context.get(), out.data(), &written,
+                         plaintext.data(),
+                         base::checked_cast<int>(plaintext.size())) ||
+      !EVP_EncryptFinal_ex(
+          context.get(),
+          base::span(out).subspan(static_cast<size_t>(written)).data(),
+          &final_written)) {
+    return std::nullopt;
+  }
+  out.resize(static_cast<size_t>(written) + static_cast<size_t>(final_written));
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> RsaOaepEncrypt(
+    base::span<const uint8_t> public_key,
+    base::span<const uint8_t> message) {
+  bssl::UniquePtr<RSA> rsa(
+      RSA_public_key_from_bytes(public_key.data(), public_key.size()));
+  if (!rsa) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> out(RSA_size(rsa.get()));
+  size_t written = 0;
+  // Widevine wraps the privacy key with RSA-OAEP over SHA-1.
+  if (!RSA_encrypt(rsa.get(), &written, out.data(), out.size(), message.data(),
+                   message.size(), RSA_PKCS1_OAEP_PADDING)) {
+    return std::nullopt;
+  }
+  out.resize(written);
+  return out;
+}
+
+}  // namespace
+
+WindowsWidevineCertificate::WindowsWidevineCertificate() = default;
+WindowsWidevineCertificate::WindowsWidevineCertificate(
+    const WindowsWidevineCertificate&) = default;
+WindowsWidevineCertificate& WindowsWidevineCertificate::operator=(
+    const WindowsWidevineCertificate&) = default;
+WindowsWidevineCertificate::~WindowsWidevineCertificate() = default;
+
+bool WindowsWidevineApplies(const std::string& key_system,
+                            const url::Origin& origin) {
+  if (key_system != kWidevineKeySystem) {
+    return false;
+  }
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(::switches::kUseChromiumDefaults)) {
+    return false;
+  }
+  if (origin.opaque()) {
+    return true;
+  }
+  static const base::NoDestructor<std::vector<std::string>> playback_sites([] {
+    std::vector<std::string> sites(std::begin(kPlaybackSites),
+                                   std::end(kPlaybackSites));
+    for (const std::string& site : base::SplitString(
+             base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                 ::switches::kWidevinePlaybackSites),
+             ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      sites.push_back(base::ToLowerASCII(site));
+    }
+    return sites;
+  }());
+  const std::string host = base::ToLowerASCII(origin.host());
+  for (const std::string& site : *playback_sites) {
+    if (site == "*" || host == site || base::EndsWith(host, "." + site)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<WindowsWidevineCertificate> ParseWidevineSignedDrmCertificate(
+    base::span<const uint8_t> data) {
+  const std::optional<std::vector<Field>> signed_certificate = Parse(data);
+  if (!signed_certificate) {
+    return std::nullopt;
+  }
+  const Field* drm_certificate = Find(*signed_certificate, 1, 2);
+  if (!drm_certificate) {
+    return std::nullopt;
+  }
+  const std::optional<std::vector<Field>> certificate =
+      Parse(drm_certificate->bytes);
+  if (!certificate) {
+    return std::nullopt;
+  }
+  const Field* type = Find(*certificate, 1, 0);
+  const Field* serial_number = Find(*certificate, 2, 2);
+  const Field* public_key = Find(*certificate, 4, 2);
+  const Field* provider_id = Find(*certificate, 7, 2);
+  if (!type || type->varint != kServiceCertificateType || !serial_number ||
+      !public_key) {
+    return std::nullopt;
+  }
+  bssl::UniquePtr<RSA> rsa(RSA_public_key_from_bytes(
+      public_key->bytes.data(), public_key->bytes.size()));
+  if (!rsa) {
+    return std::nullopt;
+  }
+  WindowsWidevineCertificate result;
+  result.serial_number.assign(serial_number->bytes.begin(),
+                              serial_number->bytes.end());
+  result.public_key.assign(public_key->bytes.begin(), public_key->bytes.end());
+  if (provider_id) {
+    result.provider_id.assign(provider_id->bytes.begin(),
+                              provider_id->bytes.end());
+  }
+  return result;
+}
+
+std::optional<WindowsWidevineCertificate> ParseWidevineServiceCertificate(
+    base::span<const uint8_t> data) {
+  const std::optional<std::vector<Field>> signed_message = Parse(data);
+  if (!signed_message) {
+    return std::nullopt;
+  }
+  const Field* type = Find(*signed_message, 1, 0);
+  const Field* message = Find(*signed_message, 2, 2);
+  if (!type || type->varint != kServiceCertificateMessage || !message) {
+    return std::nullopt;
+  }
+  return ParseWidevineSignedDrmCertificate(message->bytes);
+}
+
+std::vector<uint8_t> WidevineServiceCertificateRequest() {
+  return {0x08, static_cast<uint8_t>(kServiceCertificateRequestMessage)};
+}
+
+std::optional<std::vector<uint8_t>> MakeWidevinePrivacyRequest(
+    base::span<const uint8_t> clear_request,
+    const WindowsWidevineCertificate& certificate) {
+  const std::optional<std::vector<Field>> signed_message =
+      Parse(clear_request);
+  if (!signed_message) {
+    return std::nullopt;
+  }
+  const Field* type = Find(*signed_message, 1, 0);
+  const Field* message = Find(*signed_message, 2, 2);
+  if (!type || type->varint != kLicenseRequestMessage || !message) {
+    return std::nullopt;
+  }
+  const std::optional<std::vector<Field>> request = Parse(message->bytes);
+  if (!request) {
+    return std::nullopt;
+  }
+  const Field* client_id = Find(*request, 1, 2);
+  if (!client_id) {
+    return std::nullopt;
+  }
+
+  // The identification, sized as Windows' with filler inside the
+  // encryption, which only the license service can open.
+  std::vector<uint8_t> plaintext(client_id->bytes.begin(),
+                                 client_id->bytes.end());
+  const size_t target =
+      kWindowsClientIdSize + static_cast<size_t>(base::RandUint64() % 16);
+  // A filler of 128 to 16,383 bytes takes a tag byte and two length bytes.
+  if (plaintext.size() + 3 + 128 <= target) {
+    std::vector<uint8_t> filler(target - plaintext.size() - 3);
+    base::RandBytes(filler);
+    AppendBytesField(plaintext, kVmpDataField, filler);
+  }
+
+  std::vector<uint8_t> key(16);
+  std::vector<uint8_t> iv(16);
+  base::RandBytes(key);
+  base::RandBytes(iv);
+  const std::optional<std::vector<uint8_t>> ciphertext =
+      AesCbcEncrypt(key, iv, plaintext);
+  const std::optional<std::vector<uint8_t>> wrapped_key =
+      RsaOaepEncrypt(certificate.public_key, key);
+  if (!ciphertext || !wrapped_key) {
+    return std::nullopt;
+  }
+
+  // EncryptedClientIdentification.
+  std::vector<uint8_t> encrypted_client_id;
+  if (!certificate.provider_id.empty()) {
+    AppendBytesField(encrypted_client_id, 1,
+                     base::as_byte_span(certificate.provider_id));
+  }
+  AppendBytesField(encrypted_client_id, 2, certificate.serial_number);
+  AppendBytesField(encrypted_client_id, 3, *ciphertext);
+  AppendBytesField(encrypted_client_id, 4, iv);
+  AppendBytesField(encrypted_client_id, 5, *wrapped_key);
+
+  // The LicenseRequest without client_id (1), with encrypted_client_id (8)
+  // in field order, as Windows' Widevine writes it.
+  std::vector<uint8_t> privacy_request;
+  bool inserted = false;
+  for (const Field& field : *request) {
+    if (field.number == 1) {
+      continue;
+    }
+    if (field.number > 8 && !inserted) {
+      AppendBytesField(privacy_request, 8, encrypted_client_id);
+      inserted = true;
+    }
+    AppendRaw(privacy_request, field.encoded);
+  }
+  if (!inserted) {
+    AppendBytesField(privacy_request, 8, encrypted_client_id);
+  }
+
+  std::vector<uint8_t> out;
+  for (const Field& field : *signed_message) {
+    if (field.number == 2 && field.wire_type == 2) {
+      AppendBytesField(out, 2, privacy_request);
+    } else {
+      AppendRaw(out, field.encoded);
+    }
+  }
+  return out;
+}
+
+CdmKeyInformation::KeyStatus WindowsWidevineHdcpStatus(
+    HdcpVersion min_hdcp_version) {
+  return min_hdcp_version <= HdcpVersion::kHdcpVersion2_2
+             ? CdmKeyInformation::USABLE
+             : CdmKeyInformation::OUTPUT_RESTRICTED;
+}
