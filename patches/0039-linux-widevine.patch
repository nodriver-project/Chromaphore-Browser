+class Origin;
+}
+
+namespace media {
+
+// browser: Widevine as Chrome on Windows runs it, for a Linux build
+// presenting Windows. Chrome's Windows Widevine works in privacy mode: a
+// session's first message is a service-certificate request (the two bytes
+// 08 04), and once the page answers it with the license service's
+// certificate, the license request carries the client identification
+// encrypted to that certificate's key. The Linux Widevine has no privacy
+// mode: its first message is the license request with the identification in
+// the clear (platform_name "Linux"). CdmAdapter runs the session flow; this
+// file holds the message work.
+
+// Whether the emulation applies to a CDM of |key_system| for |origin|: a
+// Linux build presenting Windows (no --use-chromium-defaults), Widevine, and
+// an origin that is not a playback site. The request built here carries the
+// CDM's signature over the original request, which a license server
+// refuses, so the major streaming services, and the sites listed in
+// --widevine-playback-sites, get the Linux Widevine unchanged and play.
+bool WindowsWidevineApplies(const std::string& key_system,
+                            const url::Origin& origin);
+
+// What a privacy-mode license request needs of the license service's
+// certificate.
+struct WindowsWidevineCertificate {
+  WindowsWidevineCertificate();
+  WindowsWidevineCertificate(const WindowsWidevineCertificate&);
+  WindowsWidevineCertificate& operator=(const WindowsWidevineCertificate&);
+  ~WindowsWidevineCertificate();
+
+  std::string provider_id;
+  std::vector<uint8_t> serial_number;
+  // PKCS#1 RSAPublicKey, DER.
+  std::vector<uint8_t> public_key;
+};
+
+// A SignedDrmCertificate of a service, as MediaKeys.setServerCertificate()
+// takes it.
+std::optional<WindowsWidevineCertificate> ParseWidevineSignedDrmCertificate(
+    base::span<const uint8_t> data);
+
+// A license server's answer to a service-certificate request: a
+// SignedMessage of type SERVICE_CERTIFICATE around a SignedDrmCertificate.
+std::optional<WindowsWidevineCertificate> ParseWidevineServiceCertificate(
+    base::span<const uint8_t> data);
+
+// The service-certificate request Windows' Widevine opens a session with.
+std::vector<uint8_t> WidevineServiceCertificateRequest();
+
+// |clear_request|, a SignedMessage around a LicenseRequest with its
+// client_id in the clear, in privacy mode: client_id replaced by an
+// EncryptedClientIdentification for |certificate|, sized as Chrome 156's
+// Widevine on Windows sizes it. Nullopt when |clear_request| is not such a
+// message.
+std::optional<std::vector<uint8_t>> MakeWidevinePrivacyRequest(
+    base::span<const uint8_t> clear_request,
+    const WindowsWidevineCertificate& certificate);
+
+// MediaKeys.getStatusForPolicy() as Chrome answers it on a Windows desktop
+// with an HDCP 2.2 display: usable up to HDCP 2.2.
+CdmKeyInformation::KeyStatus WindowsWidevineHdcpStatus(
+    HdcpVersion min_hdcp_version);
+
