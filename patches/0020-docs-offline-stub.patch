index 37f5f7edf2..a0ff5cdd94 100644
--- a/chrome/browser/resources/component_extension_resources.grd
+++ b/chrome/browser/resources/component_extension_resources.grd
@@ -12,6 +12,9 @@
   </outputs>
   <release seq="1">
     <includes>
+      <include name="IDR_GOOGLE_DOCS_OFFLINE_STUB_PAGE_EMBED_SCRIPT_JS" file="google_docs_offline_stub/page_embed_script.js" type="BINDATA" />
+      <part file="markdown_viewer/markdown_viewer_resources.grdp" />
+
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_JS" file="network_speech_synthesis/tts_extension.js" type="BINDATA" />
 
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_MV3_AUDIO_HTML" file="network_speech_synthesis/mv3/audio.html" type="BINDATA" />
diff --git a/chrome/browser/resources/google_docs_offline_stub/manifest.json b/chrome/browser/resources/google_docs_offline_stub/manifest.json
