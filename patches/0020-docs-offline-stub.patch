From 3a370f2d070756c5b70bc7e54b726c8ae1db629e Mon Sep 17 00:00:00 2001
From: The browser Authors <noreply@browser.invalid>
Date: Fri, 13 Nov 2026 02:13:37 -0500
Subject: [PATCH 20/61] docs-offline-stub

Google Docs Offline component-extension stub (URL-namespace parity).

Riders: the markdown viewer's component-loader, allowlist and resource-bundle hunks (markdown-viewer).
---
 chrome/browser/browser_resources.grd          |  2 ++
 .../allowlist.cc                              |  9 ++++++
 chrome/browser/extensions/component_loader.cc | 29 +++++++++++++++++++
 chrome/browser/extensions/component_loader.h  |  6 ++++
 .../component_extension_resources.grd         |  3 ++
 .../google_docs_offline_stub/manifest.json    | 12 ++++++++
 .../page_embed_script.js                      |  7 +++++
 7 files changed, 68 insertions(+)
 create mode 100644 chrome/browser/resources/google_docs_offline_stub/manifest.json
 create mode 100644 chrome/browser/resources/google_docs_offline_stub/page_embed_script.js

diff --git a/chrome/browser/browser_resources.grd b/chrome/browser/browser_resources.grd
index e8b4901c99..34264f0b61 100644
--- a/chrome/browser/browser_resources.grd
+++ b/chrome/browser/browser_resources.grd
@@ -185,6 +185,8 @@
         <include name="IDR_DESK_API_MANIFEST" file="resources\chromeos\desk_api\manifest.json" type="BINDATA" />
       </if>
 
+      <include name="IDR_GOOGLE_DOCS_OFFLINE_STUB_MANIFEST" file="resources\google_docs_offline_stub\manifest.json" type="BINDATA" />
+      <include name="IDR_MARKDOWN_VIEWER_MANIFEST" file="resources\markdown_viewer\manifest.json" type="BINDATA" />
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_MANIFEST" file="resources\network_speech_synthesis\manifest.json" type="BINDATA" />
       <include name="IDR_NETWORK_SPEECH_SYNTHESIS_MANIFEST_MV3" file="resources\network_speech_synthesis\mv3\manifest.json" type="BINDATA" />
       <include name="IDR_READING_MODE_GDOCS_HELPER_MANIFEST" file="resources\reading_mode_gdocs_helper\manifest.json" type="BINDATA" />
diff --git a/chrome/browser/extensions/component_extensions_allowlist/allowlist.cc b/chrome/browser/extensions/component_extensions_allowlist/allowlist.cc
index 4fb8aaa6b8..bce5caf99b 100644
--- a/chrome/browser/extensions/component_extensions_allowlist/allowlist.cc
+++ b/chrome/browser/extensions/component_extensions_allowlist/allowlist.cc
@@ -37,9 +37,14 @@ bool IsComponentExtensionAllowlisted(const std::string& extension_id) {
   constexpr auto kAllowed = base::MakeFixedFlatSet<std::string_view>({
       extension_misc::kAimEligibilityExtensionId,
       extension_misc::kContextualTasksExtensionId,
+      // browser: stub of the Google Docs Offline extension, so that the
+      // chrome-extension://<id>/ namespace resolves as in a signed-in Chrome.
+      extension_misc::kDocsOfflineExtensionId,
       extension_misc::kGlicExtensionId,
       extension_misc::kInAppPaymentsSupportAppId,
       extension_misc::kPdfExtensionId,
+      // browser: the built-in markdown viewer.
+      extension_misc::kMarkdownViewerExtensionId,
 #if BUILDFLAG(IS_CHROMEOS)
       extension_misc::kAssessmentAssistantExtensionId,
       extension_misc::kAccessibilityCommonExtensionId,
@@ -96,6 +101,10 @@ bool IsComponentExtensionAllowlisted(int manifest_resource_id) {
     case IDR_AIM_ELIGIBILITY_EXTENSION_MANIFEST_JSON:
     case IDR_CONTEXTUAL_TASKS_EXTENSION_MANIFEST_JSON:
     case IDR_GLIC_EXTENSION_MANIFEST:
+    // browser: the Google Docs Offline stub.
+    case IDR_GOOGLE_DOCS_OFFLINE_STUB_MANIFEST:
+    // browser: the built-in markdown viewer.
+    case IDR_MARKDOWN_VIEWER_MANIFEST:
     case IDR_NETWORK_SPEECH_SYNTHESIS_MANIFEST:
     case IDR_NETWORK_SPEECH_SYNTHESIS_MANIFEST_MV3:
     case IDR_READING_MODE_GDOCS_HELPER_MANIFEST:
diff --git a/chrome/browser/extensions/component_loader.cc b/chrome/browser/extensions/component_loader.cc
index 54969eebf8..23fab901f8 100644
--- a/chrome/browser/extensions/component_loader.cc
+++ b/chrome/browser/extensions/component_loader.cc
@@ -573,6 +573,28 @@ void ComponentLoader::AddContextualTasksExtension() {
   }
 }
 
+// browser: Chrome installs the Google Docs Offline extension
+// (ghbmnnjooekpmoecnnnilnnbdlolhkhi) on the first launch of a signed-in
+// profile, and pages can tell by fetching
+// chrome-extension://<id>/page_embed_script.js. This stub answers that fetch
+// with an empty script and bundles none of the offline editing machinery.
+// Note that --disable-component-extensions-with-background-pages disables
+// every component extension, this stub included.
+void ComponentLoader::AddGoogleDocsOfflineStubExtension() {
+  Add(IDR_GOOGLE_DOCS_OFFLINE_STUB_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("google_docs_offline_stub")));
+}
+
+// browser: the markdown viewer is a MIME handler extension like the PDF
+// viewer: it takes file:// and http(s) responses of type text/markdown and
+// shows them read-only. Its files are built by the markdown-viewer project
+// outside this tree and listed in
+// chrome/browser/resources/markdown_viewer/markdown_viewer_resources.grdp.
+void ComponentLoader::AddMarkdownViewerExtension() {
+  Add(IDR_MARKDOWN_VIEWER_MANIFEST,
+      base::FilePath(FILE_PATH_LITERAL("markdown_viewer")));
+}
+
 void ComponentLoader::AddWithNameAndDescription(
     int manifest_resource_id,
     const base::FilePath& root_directory,
@@ -697,6 +719,9 @@ void ComponentLoader::AddDefaultComponentExtensions(
     Add(pdf_extension_util::GetManifest(),
         base::FilePath(FILE_PATH_LITERAL("pdf")));
 #endif  // BUILDFLAG(ENABLE_PDF)
+    // browser: the markdown viewer sits beside the PDF viewer, out of reach
+    // of the switch that turns off the background-page extensions.
+    AddMarkdownViewerExtension();
   }
 
   AddDefaultComponentExtensionsWithBackgroundPages(skip_session_components);
@@ -795,6 +820,10 @@ void ComponentLoader::AddDefaultComponentExtensionsWithBackgroundPages(
 #if BUILDFLAG(GOOGLE_CHROME_BRANDING) && !BUILDFLAG(IS_CHROMEOS)
   AddNetworkSpeechSynthesisExtension();
 #endif  // BUILDFLAG(GOOGLE_CHROME_BRANDING) && !BUILDFLAG(IS_CHROMEOS)
+
+  // browser: unconditional; Chrome installs the real extension regardless
+  // of branding.
+  AddGoogleDocsOfflineStubExtension();
 }
 
 void ComponentLoader::
diff --git a/chrome/browser/extensions/component_loader.h b/chrome/browser/extensions/component_loader.h
index 0a47e6ac8a..1bd6247577 100644
--- a/chrome/browser/extensions/component_loader.h
+++ b/chrome/browser/extensions/component_loader.h
@@ -235,6 +235,12 @@ class ComponentLoader : public KeyedService {
 
   void AddAimEligibilityExtension();
 
+  // browser: registers the Google Docs Offline stub; see the .cc file.
+  void AddGoogleDocsOfflineStubExtension();
+
+  // browser: registers the built-in markdown viewer; see the .cc file.
+  void AddMarkdownViewerExtension();
+
   void AddGlicExtension();
 
   void AddContextualTasksExtension();
