index 0000000000..88cb0f3a7d
--- /dev/null
+++ b/chrome/browser/resources/google_docs_offline_stub/manifest.json
@@ -0,0 +1,12 @@
+{
+   "key": "",
+   "manifest_version": 3,
+   "name": "Google Docs Offline",
+   "version": "1.104.1",
+   "description": "Get things done offline with the Google Docs family of products.",
+   "minimum_chrome_version": "88",
+   "web_accessible_resources": [ {
+      "matches": [ "<all_urls>" ],
+      "resources": [ "page_embed_script.js" ]
