diff --git a/chrome/browser/resources/markdown_viewer/README.chromium b/chrome/browser/resources/markdown_viewer/README.chromium
new file mode 100644
index 0000000000..3361d0bc97
--- /dev/null
+++ b/chrome/browser/resources/markdown_viewer/README.chromium
@@ -0,0 +1,35 @@
+Name: Markdown viewer bundle
+Short Name: markdown_viewer
+URL: https://milkdown.dev/
+Version: see the table below
+License: MIT, Apache-2.0
+License File: LICENSE
+Security Critical: no
+Shipped: yes
+
+Description:
+The browser's built-in viewer for text/markdown: a read-only MIME-handler
+component extension, like the PDF viewer. viewer.js and viewer.css are an
+esbuild bundle of the libraries below plus the viewer's own small plugins;
+the KaTeX_*.woff2 files are KaTeX's fonts. The bundle is generated by the
+markdown viewer's build script; do not edit it by hand.
+
+Bundled third-party libraries (full license texts in LICENSE):
+
+  Milkdown Crepe             @milkdown/crepe 7.22.3  MIT
+  Milkdown Kit               @milkdown/kit 7.22.3  MIT
+  ProseMirror                prosemirror-model 1.25.12  MIT
+  remark                     remark 15.0.1  MIT
+  unified                    unified 11.0.5  MIT
+  remark-frontmatter         remark-frontmatter 5.0.0  MIT
+  unist-util-visit           unist-util-visit 5.1.0  MIT
+  CodeMirror                 codemirror 6.0.2  MIT
+  CodeMirror language data   @codemirror/language-data 6.5.2  MIT
+  CodeMirror One Dark theme  @codemirror/theme-one-dark 6.1.3  MIT
+  KaTeX (code and fonts)     katex 0.19.0  MIT
+  Vue                        vue 3.5.44  MIT
+  DOMPurify                  dompurify 3.4.17  (MPL-2.0 OR Apache-2.0)
+
+Local Modifications:
+None. The libraries are bundled unmodified; the viewer's own code lives in
+the markdown viewer project, not in this directory.
diff --git a/chrome/browser/resources/markdown_viewer/index.html b/chrome/browser/resources/markdown_viewer/index.html
new file mode 100644
index 0000000000..0146fe5ca2
--- /dev/null
+++ b/chrome/browser/resources/markdown_viewer/index.html
@@ -0,0 +1,17 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="color-scheme" content="light dark">
+  <title>Markdown</title>
+  <style>
+    html { background: #ffffff; }
+    @media (prefers-color-scheme: dark) { html { background: #0d1117; } }
+  </style>
+  <link rel="stylesheet" href="viewer.css">
+</head>
+<body>
+  <main id="root" class="viewer"></main>
+  <script type="module" src="viewer.js"></script>
+</body>
+</html>
diff --git a/chrome/browser/resources/markdown_viewer/manifest.json b/chrome/browser/resources/markdown_viewer/manifest.json
new file mode 100644
index 0000000000..22f9965e32
--- /dev/null
+++ b/chrome/browser/resources/markdown_viewer/manifest.json
@@ -0,0 +1,18 @@
+{
+  "key": "",
+  "manifest_version": 2,
+  "name": "Markdown Viewer",
+  "version": "1.0",
+  "description": "Shows markdown files, read-only.",
+  "offline_enabled": true,
+  "incognito": "split",
+  "permissions": [
+    "tabs"
+  ],
+  "mime_types": [
+    "text/markdown",
+    "text/x-markdown"
+  ],
+  "mime_types_handler": "index.html",
+  "content_security_policy": "script-src 'self'; object-src 'self'"
+}
