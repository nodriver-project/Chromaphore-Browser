diff --git a/chrome/common/media/cdm_registration.cc b/chrome/common/media/cdm_registration.cc
index 60a79ace42..c36f818612 100644
--- a/chrome/common/media/cdm_registration.cc
+++ b/chrome/common/media/cdm_registration.cc
@@ -375,6 +375,19 @@ void AddPlayReady(std::vector<content::CdmInfo>* cdms) {
                      kPlayReadyCdmDisplayName, kPlayReadyCdmType,
                      playready_version_info->GetFileVersion(),
                      /*path=*/base::FilePath());
+
+  // browser: also register the software secure (SL2000) OS PlayReady CDM,
+  // as Edge does. Its capability is queried lazily through the Media
+  // Foundation service like the hardware secure one, and only allow-listed
+  // origins can see it (CdmRegistryImpl::IsSoftwarePlayReadyAllowedForOrigin),
+  // so every other site sees what stock Chrome reports.
+  cdms->emplace_back(kPlayReadyKeySystemRecommendationDefault,
+                     content::CdmInfo::Robustness::kSoftwareSecure,
+                     /*capability=*/std::nullopt,
+                     /*supports_sub_key_systems=*/true,
+                     kPlayReadyCdmDisplayName, kPlayReadyCdmType,
+                     playready_version_info->GetFileVersion(),
+                     /*path=*/base::FilePath());
 }
 #endif  // BUILDFLAG(ENABLE_PLAYREADY)
 
