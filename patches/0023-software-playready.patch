+// browser: PlayReady key systems by name (software-playready).
+// static
+bool CdmRegistryImpl::IsPlayReadyKeySystem(const std::string& key_system) {
+  static constexpr char kPlayReadyKeySystemBase[] =
+      "com.microsoft.playready.recommendation";
+  return key_system == kPlayReadyKeySystemBase ||
+         media::IsSubKeySystemOf(key_system, kPlayReadyKeySystemBase);
+}
+
+// static
+bool CdmRegistryImpl::IsSoftwarePlayReadyAllowedForOrigin(
+    const url::Origin& origin) {
+  static const base::NoDestructor<std::vector<std::string>> allowed_sites([] {
+    std::vector<std::string> sites = {"primevideo.com", "amazon.com"};
+    for (const std::string& site : base::SplitString(
+             base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                 switches::kSoftwarePlayreadySites),
+             ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      sites.push_back(base::ToLowerASCII(site));
+    }
+    return sites;
+  }());
+
+  if (origin.opaque()) {
+    return false;
+  }
+  const std::string host = base::ToLowerASCII(origin.host());
+  for (const std::string& site : *allowed_sites) {
+    if (site == "*" || host == site || base::EndsWith(host, "." + site)) {
+      return true;
+    }
+  }
+  return false;
+}
