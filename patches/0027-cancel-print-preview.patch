 void PrintViewManager::ShowScriptedPrintPreview() {
@@ -576,6 +584,19 @@ void PrintViewManager::OnScriptedPrintPreviewCallback(
     }
   }
 
+  // browser: --cancel-print-preview. Nobody is there to answer a preview, so
+  // none is shown; it is closed after a person's moment, by what closing the
+  // dialog runs. The page saw beforeprint and is blocked in print() until then.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kCancelPrintPreview)) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&PrintViewManager::CloseUnseenPreview,
+                       weak_factory_.GetWeakPtr(), rfh_id),
+        base::RandTimeDelta(base::Seconds(1), base::Seconds(4)));
+    return;
+  }
+
   auto* dialog_controller = PrintPreviewDialogController::GetInstance();
   CHECK(dialog_controller);
   mojom::RequestPrintPreviewParams params;
@@ -587,6 +608,18 @@ void PrintViewManager::OnScriptedPrintPreviewCallback(
   PrintPreviewAllowedForTesting();
 }
 
+// browser: --cancel-print-preview.
+void PrintViewManager::CloseUnseenPreview(
+    content::GlobalRenderFrameHostId rfh_id) {
+  // A preview that ended some other way (its frame gone) and a new print()
+  // since must not be closed early by the old one's timer.
+  if (print_preview_state_ != SCRIPTED_PREVIEW || !print_preview_rfh_ ||
+      print_preview_rfh_->GetGlobalId() != rfh_id) {
+    return;
+  }
+  PrintPreviewDone();
+}
+
 void PrintViewManager::RequestPrintPreview(
     mojom::RequestPrintPreviewParamsPtr params) {
   content::RenderFrameHost& rfh = CurrentTargetFrame();
