@@ -74,10 +81,57 @@ void HeadlessPrintManager::GetPrintPreviewParams(
 
 void HeadlessPrintManager::SetupScriptedPrintPreview(
     SetupScriptedPrintPreviewCallback callback) {
+  // browser: with --cancel-print-preview, print() pauses as it does in a
+  // headed browser -- a preview opened and closed unanswered after a moment --
+  // and the page is told it closed (afterprint); without the switch headless
+  // answers at once and never tells it. A second print() while one waits is
+  // answered at once, as PrintViewManager answers one while a preview is open.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kCancelPrintPreview) &&
+      !scripted_preview_callback_ && CurrentTargetFrame().IsActive()) {
+    content::RenderFrameHost& rfh = CurrentTargetFrame();
+    // A preview opening ends page fullscreen, as any dialog does
+    // (crbug.com/41322524) -- as PrintViewManager does it.
+    if (web_contents()->IsFullscreen()) {
+      auto weak_this = weak_factory_.GetWeakPtr();
+      web_contents()->ExitFullscreen(true);
+      if (!weak_this) {
+        return;
+      }
+    }
+    // Connected now, as PrintViewManager does for a renderer-initiated print.
+    GetPrintRenderFrame(&rfh);
+    scripted_preview_callback_ = std::move(callback);
+    scripted_preview_rfh_id_ = rfh.GetGlobalId();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&HeadlessPrintManager::CloseUnseenPreview,
+                       weak_factory_.GetWeakPtr(), scripted_preview_rfh_id_),
+        base::RandTimeDelta(base::Seconds(1), base::Seconds(4)));
+    // browser: the page waits in print() from here; whoever watches the
+    // tab hears it now, not once the print ends.
+    web_contents()->DidRequestScriptedPrint(&rfh);
+    return;
+  }
   DLOG(ERROR) << "Scripted print preview is not supported";
   std::move(callback).Run();
 }
 
+// browser: --cancel-print-preview.
+void HeadlessPrintManager::CloseUnseenPreview(
+    content::GlobalRenderFrameHostId rfh_id) {
+  if (!scripted_preview_callback_ || scripted_preview_rfh_id_ != rfh_id) {
+    return;
+  }
+  // As PrintViewManager::PrintPreviewDone: the frame hears the preview closed
+  // (it dispatches afterprint), then the waiting print() returns.
+  content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(rfh_id);
+  if (rfh && rfh->IsRenderFrameLive() && IsPrintRenderFrameConnected(rfh)) {
+    GetPrintRenderFrame(rfh)->OnPrintPreviewDialogClosed();
+  }
+  std::move(scripted_preview_callback_).Run();
+}
+
 void HeadlessPrintManager::ShowScriptedPrintPreview() {
   DLOG(ERROR) << "Scripted print preview is not supported";
 }
