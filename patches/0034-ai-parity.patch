+// browser: this build ships no on-device model service, so a page sees what
+// a fresh Chrome that has not downloaded the model shows: downloadable where
+// Chrome's own CPU rule admits the machine
+// (services/on_device_model/public/cpp/cpu.cc: 15000 MB of memory and 4
+// processors; the memory is the one pages see, navigator.deviceMemory's
+// bucket, so the two agree), and downloading once a page has started the
+// download, which never ends.
+bool AIManager::IsOnDeviceModelEligible() const {
+  blink::ApproximatedDeviceMemory::Initialize();
+  return blink::ApproximatedDeviceMemory::GetApproximatedDeviceMemory() >= 16 &&
+         base::SysInfo::NumberOfProcessors() >= 4;
+}
+
+blink::mojom::ModelAvailabilityCheckResult
+AIManager::AvailabilityWithoutService(
+    std::optional<optimization_guide::mojom::OnDeviceFeature> feature) const {
+  if (!IsOnDeviceModelEligible()) {
+    return blink::mojom::ModelAvailabilityCheckResult::
+        kUnavailableModelNotEligible;
+  }
+  return feature && StartedDownloadsWithoutService().contains(*feature)
+             ? blink::mojom::ModelAvailabilityCheckResult::kDownloading
+             : blink::mojom::ModelAvailabilityCheckResult::kDownloadable;
+}
+
+void AIManager::StartDownloadWithoutService(
+    optimization_guide::mojom::OnDeviceFeature feature,
+    mojo::PendingRemote<on_device_model::mojom::DownloadObserver> monitor) {
+  StartedDownloadsWithoutService().insert(feature);
+  if (monitor) {
+    if (stalled_monitors_.size() >= kMaxStalledCreates) {
+      stalled_monitors_.Remove(stalled_monitors_.begin().id());
+    }
+    const mojo::RemoteSetElementId id =
+        stalled_monitors_.Add(std::move(monitor));
+    // A download's first update is zero (Blink's CreateMonitor).
+    stalled_monitors_.Get(id)->OnDownloadProgressUpdate(
+        0, optimization_guide::kNormalizedDownloadProgressMax);
+  }
+}
