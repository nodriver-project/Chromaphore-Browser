@@ -7,13 +7,73 @@
 #include <utility>
 
 #include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
 #include "components/language_detection/core/browser/language_detection_model_provider.h"
 
 namespace language_detection {
 
+namespace {
+
+// browser: the language detection model this build ships, for drivers given
+// no model provider. The browser's own defaults switch the optimization guide
+// off (OptimizationHints), so no model service delivers the model Chrome
+// downloads. The build copies that model, which the test data holds byte for
+// byte (//components/test/data/translate/valid_model.tflite), to
+// LanguageDetection/model.tflite beside the browser's module. One provider
+// serves every profile and opens the file on a best-effort task, as Chrome's
+// model service opens its downloaded copy: such tasks wait until startup is
+// complete, so the detector answers "downloadable" until then and
+// "available" after, as on a Chrome profile that has the model. Without the
+// file the model is never set: "downloadable", with requests waiting as on a
+// download that has not finished.
+class BundledModelProvider : public LanguageDetectionModelProvider {
+ public:
+  BundledModelProvider()
+      : LanguageDetectionModelProvider(
+            base::ThreadPool::CreateSequencedTaskRunner(
+                {base::MayBlock(), base::TaskPriority::BEST_EFFORT})) {
+    base::FilePath dir;
+    if (!base::PathService::Get(base::DIR_ASSETS, &dir)) {
+      return;
+    }
+    const base::FilePath path =
+        dir.AppendASCII("LanguageDetection").AppendASCII("model.tflite");
+    // Unretained: the provider is never destroyed (see
+    // GetBundledModelProvider()).
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::BindOnce(&base::PathExists, path),
+        base::BindOnce(&BundledModelProvider::OnModelFileChecked,
+                       base::Unretained(this), path));
+  }
+
+ private:
+  void OnModelFileChecked(const base::FilePath& path, bool exists) {
+    if (exists) {
+      ReplaceModelFile(path);
+    }
+  }
+};
+
+LanguageDetectionModelProvider* GetBundledModelProvider() {
+  static base::NoDestructor<BundledModelProvider> provider;
+  return provider.get();
+}
+
+}  // namespace
+
+// browser: a driver given no model provider uses the model this build
+// ships.
 ContentLanguageDetectionDriver::ContentLanguageDetectionDriver(
     LanguageDetectionModelProvider* language_detection_model_provider)
-    : language_detection_model_provider_(language_detection_model_provider) {}
+    : language_detection_model_provider_(language_detection_model_provider
+                                             ? language_detection_model_provider
+                                             : GetBundledModelProvider()) {}
 
 ContentLanguageDetectionDriver::~ContentLanguageDetectionDriver() = default;
 
