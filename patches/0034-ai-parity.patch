+// browser: the features whose model download a page has started, for the
+// whole browser as a download is (see
+// AIManager::AvailabilityWithoutService()).
+base::flat_set<optimization_guide::mojom::OnDeviceFeature>&
+StartedDownloadsWithoutService() {
+  static base::NoDestructor<
+      base::flat_set<optimization_guide::mojom::OnDeviceFeature>>
+      features;
+  return *features;
+}
+
+// browser: how many create() calls of one kind, and how many download
+// monitors, a document's AIManager holds without a model service. Beyond it
+// the oldest call is answered as stock Chromium answers every one, and the
+// oldest monitor is dropped.
+constexpr size_t kMaxStalledCreates = 32;
+
+template <typename Client>
+void HoldStalledCreate(mojo::RemoteSet<Client>& held,
+                       mojo::PendingRemote<Client> client) {
+  if (held.size() >= kMaxStalledCreates) {
+    const auto oldest = held.begin();
+    on_device_ai::SendClientRemoteError(
+        *oldest,
+        blink::mojom::AIManagerCreateClientError::kUnableToCreateSession);
+    held.Remove(oldest.id());
+  }
+  held.Add(std::move(client));
+}
+
 }  // namespace
 
