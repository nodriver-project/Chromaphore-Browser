 namespace {
 
 constexpr int kCaptionButtonHeight = 18;
@@ -114,6 +118,18 @@ gfx::Rect OpaqueBrowserFrameViewLayout::GetWindowBoundsForClientBounds(
 
 gfx::Insets OpaqueBrowserFrameViewLayout::FrameBorderInsets(
     bool restored) const {
+#if BUILDFLAG(IS_LINUX)
+  // browser: Windows keeps 8 px of frame border at the sides and the bottom
+  // of a restored window (SM_CXSIZEFRAME plus SM_CXPADDEDBORDER) and none
+  // when maximized or fullscreen; a page reads it as outerWidth minus
+  // innerWidth. A Linux build presenting Windows lays its frame out the
+  // same way, whatever the platform's decorations.
+  if (blink::PresentsWindowsPlatform()) {
+    return !restored && (delegate_->IsMaximized() || delegate_->IsFullscreen())
+               ? gfx::Insets()
+               : gfx::Insets::TLBR(0, 8, 8, 8);
+  }
+#endif
   return !restored && delegate_->IsFrameCondensed()
              ? gfx::Insets()
              : RestoredFrameBorderInsets();
diff --git a/ui/views/win/hwnd_message_handler_headless.cc b/ui/views/win/hwnd_message_handler_headless.cc
index c434bce087..0d53b6165c 100644
--- a/ui/views/win/hwnd_message_handler_headless.cc
+++ b/ui/views/win/hwnd_message_handler_headless.cc
@@ -481,6 +481,15 @@ void HWNDMessageHandlerHeadless::SizeConstraintsChanged() {
 bool HWNDMessageHandlerHeadless::GetClientAreaInsets(
     gfx::Insets* insets,
     int frame_thickness) const {
+  // browser: Windows outdents a maximized window by the frame thickness on
+  // every edge, so its client area is the monitor's work area. A headless
+  // window is zoomed to the work area itself (GetZoomedWindowBounds()), so
+  // its whole window is the client area and it takes no insets, as a headed
+  // maximized window's client area is the work area.
+  if (IsMaximized()) {
+    *insets = gfx::Insets();
+    return true;
+  }
   if (delegate_->GetClientAreaInsets(insets, frame_thickness)) {
     return true;
   }
