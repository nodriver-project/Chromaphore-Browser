+namespace {
+
+#if !defined(BUILDING_CHROME_RENDERER)
+#if BUILDFLAG(IS_WIN)
+// browser: whether the primary monitor is the machine's own panel, by the
+// output technology of its display path. Nullopt when the system does not say.
+std::optional<bool> PrimaryMonitorIsInternal() {
+  constexpr POINT kOrigin = {0, 0};
+  const std::optional<DISPLAYCONFIG_PATH_INFO> path =
+      display::win::GetDisplayConfigPathInfo(
+          ::MonitorFromPoint(kOrigin, MONITOR_DEFAULTTOPRIMARY));
+  if (!path) {
+    return std::nullopt;
+  }
+  // The kinds display::win takes for a built-in panel.
+  switch (path->targetInfo.outputTechnology) {
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_INTERNAL:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_DISPLAYPORT_EMBEDDED:
+    case DISPLAYCONFIG_OUTPUT_TECHNOLOGY_UDI_EMBEDDED:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// browser: a headless browser's screen (--screen-info) and window from the
+// monitor the machine has, as a headed browser's come from it, unless a screen
+// was given outright. Left alone, headless reports an 800x600 screen at a ratio
+// of 1 under a window bigger than that screen, which no desktop has, so a page
+// that compares screen, window and viewport tells the two apart at once. The
+// primary monitor, where a headed browser opens its first window: its pixels,
+// its work area, the system scale (--force-device-scale-factor honoured), the
+// colour depth of 24 display::win reports for every monitor, and internal as
+// its output technology says (a battery standing in when it does not). The
+// window is maximized on it, as most are.
+void ApplyHeadlessScreenParity(base::CommandLine& command_line) {
+  if (command_line.HasSwitch(switches::kScreenInfo)) {
+    return;
+  }
+  const int width_px = ::GetSystemMetrics(SM_CXSCREEN);
+  const int height_px = ::GetSystemMetrics(SM_CYSCREEN);
+  RECT work_area = {};
+  const float scale = display::win::GetDPIScale();
+  // --screen-info refuses a ratio below 0.5 or one it cannot parse, and
+  // headless stops at that.
+  if (width_px <= 0 || height_px <= 0 || !std::isfinite(scale) ||
+      scale < 0.5f ||
+      !::SystemParametersInfoW(SPI_GETWORKAREA, 0, &work_area, 0)) {
+    return;
+  }
+  // The work area as --screen-info takes it: insets from the screen's edges,
+  // in pixels. A taskbar can take any edge; an area the system reports past
+  // an edge counts as reaching it.
+  const int left = std::clamp(static_cast<int>(work_area.left), 0, width_px);
+  const int top = std::clamp(static_cast<int>(work_area.top), 0, height_px);
+  const int right = std::clamp(width_px - static_cast<int>(work_area.right), 0,
+                               width_px - left);
+  const int bottom = std::clamp(height_px - static_cast<int>(work_area.bottom),
+                                0, height_px - top);
+  // The machine's own panel or not, as the display says; when it does not,
+  // a machine with a battery is taken for a laptop on its own panel.
+  std::optional<bool> internal = PrimaryMonitorIsInternal();
+  if (!internal) {
+    SYSTEM_POWER_STATUS power = {};
+    internal = ::GetSystemPowerStatus(&power) &&
+               !(power.BatteryFlag & BATTERY_FLAG_NO_BATTERY);
+  }
+  command_line.AppendSwitchASCII(
+      switches::kScreenInfo,
+      base::StringPrintf(
+          "{%dx%d workAreaLeft=%d workAreaTop=%d "
+          "workAreaRight=%d workAreaBottom=%d colorDepth=24 "
+          "devicePixelRatio=%s isInternal=%s}",
+          width_px, height_px, left, top, right, bottom,
+          base::NumberToString(static_cast<double>(scale)).c_str(),
+          *internal ? "true" : "false"));
+  // Maximized: the window fills the work area at its corner, with the frame
+  // a maximized window has. A window merely sized to the work area keeps a
+  // restored window's borders, which no maximized window shows. An explicit
+  // size or position stands and leaves the window restored, as headed.
+  if (!command_line.HasSwitch(switches::kWindowSize) &&
+      !command_line.HasSwitch(switches::kWindowPosition)) {
+    command_line.AppendSwitch(switches::kStartMaximized);
+  }
+}
+#endif  // BUILDFLAG(IS_WIN)
+
+#if BUILDFLAG(IS_LINUX)
+// browser: a Linux build presenting Windows has no Windows monitor to copy,
+// and a server has none at all, so its headless screen is one fixed Windows
+// desktop: 1920x1080 at a scale of 1 with Windows 11's 48 px taskbar along
+// the bottom, the colour depth of 24 Windows reports, an external monitor.
+// The window is maximized on it unless a size or position is given, as on
+// Windows.
+void ApplyHeadlessScreenParity(base::CommandLine& command_line) {
+  if (command_line.HasSwitch(switches::kScreenInfo) ||
+      !blink::PresentsWindowsPlatform()) {
+    return;
+  }
+  command_line.AppendSwitchASCII(
+      switches::kScreenInfo,
+      "{1920x1080 workAreaLeft=0 workAreaTop=0 workAreaRight=0 "
+      "workAreaBottom=48 colorDepth=24 devicePixelRatio=1 isInternal=false}");
+  if (!command_line.HasSwitch(switches::kWindowSize) &&
+      !command_line.HasSwitch(switches::kWindowPosition)) {
+    command_line.AppendSwitch(switches::kStartMaximized);
+  }
+}
+#endif  // BUILDFLAG(IS_LINUX)
+#endif  // !defined(BUILDING_CHROME_RENDERER)
+
+}  // namespace
+
 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
   // browser: expand the browser-defaults preset (opt out with
   // --use-chromium-defaults) before anything else reads the command line.
   // Browser process only.
   browser::MaybeExpandBrowserDefaults();
+  base::CommandLine* startup_command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!startup_command_line->HasSwitch(switches::kProcessType)) {
+#if !defined(BUILDING_CHROME_RENDERER)
+    // browser: headless's own screen and window.
+    if (headless::IsHeadlessMode()) {
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+      ApplyHeadlessScreenParity(*startup_command_line);
+#endif
+    }
+#endif
+  }
 
 #if BUILDFLAG(IS_CHROMEOS)
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();
diff --git a/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc b/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc
index fbd11f0352..57f13908d9 100644
--- a/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc
+++ b/chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.cc
@@ -440,6 +440,21 @@ void BrowserWebContentsDelegate::SetFocusToLocationBar() {
   // (2) This is called with |is_user_initiated| == false, because this is a
   //     renderer initiated focus (this method is a WebContentsDelegate
   //     override).
+  // browser: a headless window has no one to type in its location bar, and
+  // the page a person has reached holds the focus. Every decision to focus
+  // the bar by default ends here -- the startup about:blank (a content-side
+  // flag that bypasses ShouldFocusLocationBarByDefault), the new-tab page,
+  // a commit that expected the bar focused -- so the active page takes the
+  // focus instead, and document.hasFocus() answers as in a headed window
+  // someone is using. A protocol navigation never moves focus on its own,
+  // so without this the first tab's page would never hold the focus.
+  if (headless::IsHeadlessMode()) {
+    if (content::WebContents* active =
+            browser_->GetTabStripModel()->GetActiveWebContents()) {
+      active->Focus();
+    }
+    return;
+  }
   window_->SetFocusToLocationBar(false);
 }
 
