@@ -0,0 +1,104 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_AGENT_AUDIO_CAPTURE_H_
+#define CONTENT_BROWSER_DEVTOOLS_AGENT_AUDIO_CAPTURE_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "media/base/audio_capturer_source.h"
+
+namespace media {
+class AudioBuffer;
+class AudioBus;
+struct AudioGlitchInfo;
+}  // namespace media
+
+namespace content {
+
+// The sound of one tab for the video recorder: a loopback capture of the
+// tab's audio group (WebContents::GetAudioGroupId) from the audio service,
+// 48 kHz stereo in 10 ms buffers, as Page.screencast's MediaRecorder takes
+// it. The stream is asked for directly from the audio service, so the tab
+// counts no capturer and the page sees nothing. The service clocks the
+// loopback on TimeTicks: each buffer's capture time is the moment its first
+// sample plays, the same clock and meaning as a video frame's reference time.
+// A tab that plays nothing gives silence.
+//
+// Lives on the UI thread, owned by the recorder's capture of the tab. The
+// device's own thread only copies each buffer and posts it here.
+class AgentAudioCapture : public media::AudioCapturerSource::CaptureCallback {
+ public:
+  static constexpr int kSampleRate = 48000;
+  static constexpr int kChannels = 2;
+  static constexpr int kFramesPerBuffer = 480;
+
+  // Called on the UI thread.
+  class Client {
+   public:
+    // `buffer` holds planar float samples; `capture_time` is when its first
+    // sample plays.
+    virtual void OnAudioCaptured(scoped_refptr<media::AudioBuffer> buffer,
+                                 base::TimeTicks capture_time) = 0;
+    // The capture failed, for example the audio service restarted. Nothing
+    // more comes; the capture may be stopped from inside this call.
+    virtual void OnAudioCaptureError() = 0;
+
+   protected:
+    virtual ~Client() = default;
+  };
+
+  // `client` outlives this object.
+  AgentAudioCapture(Client* client, const base::UnguessableToken& group_id);
+  AgentAudioCapture(const AgentAudioCapture&) = delete;
+  AgentAudioCapture& operator=(const AgentAudioCapture&) = delete;
+  ~AgentAudioCapture() override;
+
+  void Start();
+  // Idempotent. Returns once the device's thread has ended, so no callback
+  // runs after it; buffers already posted are dropped.
+  void Stop();
+
+ private:
+  // media::AudioCapturerSource::CaptureCallback. Capture runs on the
+  // device's thread; OnCaptureError on that thread or on this one.
+  void Capture(const media::AudioBus* audio_source,
+               base::TimeTicks audio_capture_time,
+               const media::AudioGlitchInfo& glitch_info,
+               double volume) override;
+  void OnCaptureError(media::AudioCapturerSource::ErrorCode code,
+                      const std::string& message) override;
+  void OnCaptureMuted(bool is_muted) override;
+
+  // The posted halves, on the UI thread.
+  void DeliverCaptured(scoped_refptr<media::AudioBuffer> buffer,
+                       base::TimeTicks capture_time);
+  void DeliverError();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  const raw_ptr<Client> client_;
+  const base::UnguessableToken group_id_;
+  // The UI thread, where the posted halves run.
+  const scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  scoped_refptr<media::AudioCapturerSource> device_;
+  bool running_ = false;
+  bool error_reported_ = false;
+
+  // Made on the UI thread before the device starts and only copied after,
+  // so the device's thread can bind it into the tasks it posts.
+  base::WeakPtr<AgentAudioCapture> weak_this_;
+  base::WeakPtrFactory<AgentAudioCapture> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_AGENT_AUDIO_CAPTURE_H_
