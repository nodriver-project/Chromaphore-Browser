@@ -0,0 +1,114 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/paint/agent_redaction/agent_redaction.h"
+
+#include "base/time/time.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/loader/document_load_timing.h"
+#include "third_party/blink/renderer/core/loader/document_loader.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "third_party/blink/renderer/core/view_transition/view_transition.h"
+#include "third_party/blink/renderer/core/view_transition/view_transition_utils.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_set.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/heap/persistent.h"
+#include "third_party/blink/renderer/platform/wtf/std_lib_extras.h"
+
+namespace blink {
+
+namespace {
+
+// Main thread only, as is every caller.
+uint32_t g_generation = 0;
+
+// When the generation was set in this process. The browser tells viz before
+// any renderer, so a copy viz made for a navigation that started after this
+// moment was made under the generation.
+base::TimeTicks g_applied_at;
+
+using TransitionSet = GCedHeapHashSet<WeakMember<ViewTransition>>;
+
+// The view transitions that were running when the generation was set. Weak:
+// a transition that is collected leaves the set by itself.
+TransitionSet& TransitionsFromBefore() {
+  DEFINE_STATIC_LOCAL(Persistent<TransitionSet>, transitions,
+                      (MakeGarbageCollected<TransitionSet>()));
+  return *transitions;
+}
+
+// Drops the transitions that have ended.
+void DropEndedTransitions(TransitionSet& transitions) {
+  transitions.erase_if([](const WeakMember<ViewTransition>& transition) {
+    return !transition || transition->IsDone();
+  });
+}
+
+}  // namespace
+
+// static
+uint32_t AgentRedaction::Generation() {
+  return g_generation;
+}
+
+// static
+void AgentRedaction::Apply(uint32_t generation) {
+  if (generation == g_generation) {
+    return;
+  }
+  g_generation = generation;
+  g_applied_at = base::TimeTicks::Now();
+  TransitionSet& transitions = TransitionsFromBefore();
+  transitions.clear();
+  // Every document repaints, so the frames stamped from here on hold only
+  // what was painted after this point. A transition running now shows what
+  // it captured before: remember it, so its local root stamps 0 meanwhile.
+  // Disarmed (0), nothing is stamped, so nothing is remembered.
+  Page::InvalidatePaintOfAllPages([&transitions,
+                                   generation](Document& document) {
+    if (!generation) {
+      return;
+    }
+    ViewTransitionUtils::ForEachTransition(
+        document, [&transitions](ViewTransition& transition) {
+          if (!transition.IsDone()) {
+            transitions.insert(&transition);
+          }
+        });
+  });
+}
+
+// static
+bool AgentRedaction::RunsViewTransitionFromBefore(const Document& document) {
+  if (!g_generation) {
+    return false;
+  }
+  TransitionSet& transitions = TransitionsFromBefore();
+  if (!transitions.empty()) {
+    DropEndedTransitions(transitions);
+  }
+  // A transition into a new document did not exist when the generation was
+  // set if the document came after, yet it shows the old document's
+  // snapshot, which viz copied after the navigation started. When the
+  // navigation started before the generation was set here, that copy may
+  // have been made before viz was told of it.
+  DocumentLoader* loader = document.Loader();
+  const bool navigated_before =
+      !loader || loader->GetTiming().NavigationStart() <= g_applied_at;
+  bool runs = false;
+  ViewTransitionUtils::ForEachTransition(
+      document,
+      [&transitions, &runs, navigated_before](ViewTransition& transition) {
+        if (transition.IsDone()) {
+          return;
+        }
+        if (transitions.Contains(&transition) ||
+            (navigated_before && transition.IsForNavigationOnNewDocument())) {
+          runs = true;
+        }
+      });
+  return runs;
+}
+
+}  // namespace blink
