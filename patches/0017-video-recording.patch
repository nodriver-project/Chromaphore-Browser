+// ---------------------------------------------------------------------------
+// One capture device on one tab. Two exist while the recording moves to
+// another tab.
+
+class AgentVideoRecorder::Capture : public WebContentsObserver,
+                                    public AgentAudioCapture::Client {
+ public:
+  Capture(AgentVideoRecorder* recorder,
+          WebContents* web_contents,
+          std::string target_id,
+          uint64_t serial)
+      : WebContentsObserver(web_contents),
+        recorder_(recorder),
+        target_id_(std::move(target_id)),
+        serial_(serial) {}
+
+  Capture(const Capture&) = delete;
+  Capture& operator=(const Capture&) = delete;
+
+  ~Capture() override { Stop(); }
+
+  // False when the tab cannot be captured.
+  bool Start(const media::VideoCaptureParams& params, bool suspended) {
+    RenderFrameHost* main_frame = web_contents()->GetPrimaryMainFrame();
+    if (!main_frame) {
+      return false;
+    }
+    WebContentsMediaCaptureId capture_id(
+        main_frame->GetProcess()->GetDeprecatedID(),
+        main_frame->GetRoutingID());
+    device_ = WebContentsVideoCaptureDevice::Create(capture_id.ToString());
+    if (!device_) {
+      return false;
+    }
+    // A hidden capturer: the page's visibility and size never change.
+    device_->KeepPageHidden();
+    // The person's own pointer never shows in a recording.
+    device_->SetDrawsSystemCursor(false);
+    // Frames in shared memory, which the encoder reads directly.
+    device_->SetBufferFormatPreference(
+        viz::mojom::BufferFormatPreference::kDefault);
+    device_->AllocateAndStartWithReceiver(
+        params, std::make_unique<FrameReceiver>(weak_factory_.GetWeakPtr()));
+    if (suspended) {
+      device_->MaybeSuspend();
+    }
+    started_at_ = base::TimeTicks::Now();
+    became_current_at_ = started_at_;
+    if (recorder_->draw_cursor_) {
+      StartCursor();
+    }
+    // The tab's sound, from its audio group, which outlives navigations.
+    if (recorder_->records_audio_) {
+      audio_ = std::make_unique<AgentAudioCapture>(
+          this, web_contents()->GetAudioGroupId());
+      audio_->Start();
+    }
+    return true;
+  }
+
+  void Stop() {
+    // Stop joins the sound's thread: nothing of it arrives after.
+    if (audio_) {
+      audio_->Stop();
+      audio_.reset();
+    }
+    // The cursor goes before the device: its overlay is the capturer's.
+    cursor_changed_ = base::CallbackListSubscription();
+    cursor_wait_timer_.Stop();
+    cursor_fallback_timer_.Stop();
+    cursor_overlay_.reset();
+    if (device_) {
+      device_->StopAndDeAllocate();
+      device_.reset();
+    }
+    buffers_.clear();
+    Observe(nullptr);
+  }
+
+  void Suspend() {
+    if (device_) {
+      device_->MaybeSuspend();
+    }
+  }
+
+  void Resume() {
+    if (device_) {
+      device_->Resume();
+      device_->RequestRefreshFrame();
+    }
+  }
+
+  // Asks for a frame when none came for a while.
+  void KeepAlive() {
+    if (!device_) {
+      return;
+    }
+    const base::TimeTicks last =
+        last_frame_time_.is_null() ? started_at_ : last_frame_time_;
+    if (base::TimeTicks::Now() - last >= kKeepAliveInterval) {
+      device_->RequestRefreshFrame();
+    }
+  }
+
+  void RequestRefresh() {
+    if (device_) {
+      device_->RequestRefreshFrame();
+    }
+  }
+
+  // Stops the sound after it failed; the video goes on.
+  void StopAudio() {
+    audio_failed_ = true;
+    if (audio_) {
+      audio_->Stop();
+    }
+  }
+
+  // When this tab became the one the file shows: its sound counts from
+  // then.
+  base::TimeTicks became_current_at() const { return became_current_at_; }
+  void set_became_current_at(base::TimeTicks time) {
+    became_current_at_ = time;
+  }
+  bool audio_failed() const { return audio_failed_; }
+
+  uint64_t serial() const { return serial_; }
+  const std::string& target_id() const { return target_id_; }
+  // Null once the tab is gone or the capture stopped.
+  WebContents* target() { return web_contents(); }
+
+ private:
+  // A capture buffer mapped into this process, kept alive by every frame
+  // that wraps it.
+  struct Buffer : public base::RefCountedThreadSafe<Buffer> {
+    Buffer(base::ReadOnlySharedMemoryMapping read_only,
+           base::WritableSharedMemoryMapping writable)
+        : read_only(std::move(read_only)), writable(std::move(writable)) {}
+
+    base::span<const uint8_t> memory() const {
+      return read_only.IsValid() ? read_only.GetMemoryAsSpan<uint8_t>()
+                                 : writable.GetMemoryAsSpan<uint8_t>();
+    }
+
+    base::ReadOnlySharedMemoryMapping read_only;
+    base::WritableSharedMemoryMapping writable;
+
+   private:
+    friend class base::RefCountedThreadSafe<Buffer>;
+    ~Buffer() = default;
+  };
+
+  // Hands the device's frames to the capture; the device owns it.
+  class FrameReceiver : public media::VideoFrameReceiver {
+   public:
+    explicit FrameReceiver(base::WeakPtr<Capture> capture)
+        : capture_(std::move(capture)) {}
+    ~FrameReceiver() override = default;
+
+    void OnNewBuffer(int32_t buffer_id,
+                     media::mojom::VideoBufferHandlePtr handle) override {
+      if (capture_) {
+        capture_->OnNewBuffer(buffer_id, std::move(handle));
+      }
+    }
+    void OnFrameReadyInBuffer(media::ReadyFrameInBuffer frame) override {
+      if (capture_) {
+        capture_->OnFrameReadyInBuffer(std::move(frame));
+      }
+    }
+    void OnBufferRetired(int buffer_id) override {
+      if (capture_) {
+        capture_->OnBufferRetired(buffer_id);
+      }
+    }
+    void OnError(media::VideoCaptureError error) override {
+      if (capture_) {
+        capture_->OnError();
+      }
+    }
+    void OnCaptureConfigurationChanged() override {}
+    void OnFrameDropped(media::VideoCaptureFrameDropReason reason) override {}
+    void OnNewCaptureVersion(media::CaptureVersion capture_version) override {}
+    void OnFrameWithEmptyRegionCapture() override {}
+    void OnLog(const std::string& message) override {}
+    void OnStarted() override {}
+    void OnStartedUsingGpuDecode() override {}
+    void OnStopped() override {}
+
+   private:
+    base::WeakPtr<Capture> capture_;
+  };
+
+  void OnNewBuffer(int32_t buffer_id,
+                   media::mojom::VideoBufferHandlePtr handle) {
+    base::ReadOnlySharedMemoryMapping read_only;
+    base::WritableSharedMemoryMapping writable;
+    if (handle->is_read_only_shmem_region()) {
+      read_only = handle->get_read_only_shmem_region().Map();
+      if (!read_only.IsValid()) {
+        return;
+      }
+    } else if (handle->is_unsafe_shmem_region()) {
+      writable = handle->get_unsafe_shmem_region().Map();
+      if (!writable.IsValid()) {
+        return;
+      }
+    } else {
+      // GPU buffers are not asked for (BufferFormatPreference::kDefault).
+      return;
+    }
+    buffers_[buffer_id] = base::MakeRefCounted<Buffer>(std::move(read_only),
+                                                       std::move(writable));
+  }
+
+  void OnFrameReadyInBuffer(media::ReadyFrameInBuffer ready) {
+    auto it = buffers_.find(ready.buffer_id);
+    if (it == buffers_.end() || !ready.frame_info) {
+      return;
+    }
+    const media::mojom::VideoFrameInfoPtr& info = ready.frame_info;
+    OnCursorFrame(info->metadata);
+    if (info->pixel_format != media::PIXEL_FORMAT_I420) {
+      return;
+    }
+    base::span<const uint8_t> memory = it->second->memory();
+    if (memory.size() < media::VideoFrame::AllocationSize(info->pixel_format,
+                                                         info->coded_size)) {
+      return;
+    }
+    const gfx::Rect visible_rect = info->visible_rect;
+    scoped_refptr<media::VideoFrame> frame =
+        media::VideoFrame::WrapExternalData(
+            info->pixel_format, info->coded_size, visible_rect,
+            visible_rect.size(), memory, info->timestamp);
+    if (!frame) {
+      return;
+    }
+    // The buffer stays the capturer's until the frame is gone: sending it
+    // to the service copies it.
+    frame->AddDestructionObserver(base::BindOnce(
+        [](std::unique_ptr<media::VideoCaptureDevice::Client::Buffer::
+                               ScopedAccessPermission> permission,
+           scoped_refptr<Buffer> buffer) {},
+        std::move(ready.buffer_read_permission), it->second));
+    frame->set_metadata(info->metadata);
+    frame->set_color_space(info->color_space);
+
+    last_frame_time_ = base::TimeTicks::Now();
+    const base::TimeTicks reference_time =
+        info->metadata.reference_time.value_or(last_frame_time_);
+    recorder_->OnCaptureFrame(this, std::move(frame), reference_time);
+  }
+
+  void OnBufferRetired(int buffer_id) { buffers_.erase(buffer_id); }
+
+  // The CDP cursor, drawn into this capture's frames by viz through an
+  // overlay on its capturer, fed from the tab's CdpCursorOverlay. Its change
+  // callback runs inside input dispatch, up to 1000 times a second in a
+  // drag, so it only marks the cursor dirty: the cursor is read and sent at
+  // most once per frame period, and not again until that push's frame came
+  // or two periods passed.
+  void StartCursor() {
+    cursor_overlay_ = device_->CreateOverlay(kCursorStackingIndex);
+    CdpCursorOverlay* cursor = CdpCursorOverlay::ForRecording(web_contents());
+    if (!cursor_overlay_ || !cursor) {
+      cursor_overlay_.reset();
+      return;
+    }
+    cursor_clicks_seen_ = cursor->click_count();
+    // Unretained: the subscription is this capture's and goes before it.
+    cursor_changed_ = cursor->AddChangedCallback(base::BindRepeating(
+        &Capture::OnCursorChanged, base::Unretained(this)));
+    // So that the first frame carries the cursor; the view's size and scale
+    // stand in for a frame's until one comes.
+    cursor_dirty_ = true;
+    MaybePushCursor();
+  }
+
+  void OnCursorChanged() {
+    // A press: one count compared here, and the line written by the
+    // recorder when this capture is the one the file shows.
+    CdpCursorOverlay* cursor =
+        CdpCursorOverlay::FromWebContents(web_contents());
+    if (cursor && cursor->click_count() != cursor_clicks_seen_) {
+      cursor_clicks_seen_ = cursor->click_count();
+      // A press before any point placed the pointer has no place to name.
+      if (cursor->has_position()) {
+        recorder_->OnCursorClick(this, CursorPoint(*cursor));
+      }
+    }
+    cursor_dirty_ = true;
+    MaybePushCursor();
+  }
+
+  // A frame came: the push before it has had its frame, and the frame says
+  // the surface's size and scale.
+  void OnCursorFrame(const media::VideoFrameMetadata& metadata) {
+    if (!cursor_overlay_) {
+      return;
+    }
+    if (metadata.source_size && metadata.device_scale_factor) {
+      const float dsf = static_cast<float>(*metadata.device_scale_factor);
+      if (*metadata.source_size != cursor_source_size_ ||
+          dsf != cursor_dsf_) {
+        cursor_source_size_ = *metadata.source_size;
+        cursor_dsf_ = dsf;
+        cursor_dirty_ = true;
+      }
+    }
+    cursor_push_outstanding_ = false;
+    MaybePushCursor();
+  }
+
+  void OnCursorFallback() {
+    // viz skipped the push's frame, or has not made it yet.
+    cursor_push_outstanding_ = false;
+    MaybePushCursor();
+  }
+
+  // Reads and sends the cursor when it changed, no push waits for its
+  // frame, and a frame period has passed since the last read.
+  void MaybePushCursor() {
+    if (!cursor_dirty_ || cursor_push_outstanding_ || !cursor_overlay_) {
+      return;
+    }
+    const base::TimeTicks now = base::TimeTicks::Now();
+    const base::TimeDelta wait =
+        cursor_last_push_ + recorder_->SamplePeriod() - now;
+    if (!cursor_last_push_.is_null() && wait.is_positive()) {
+      if (!cursor_wait_timer_.IsRunning()) {
+        cursor_wait_timer_.Start(
+            FROM_HERE, wait,
+            base::BindOnce(&Capture::MaybePushCursor, base::Unretained(this)));
+      }
+      return;
+    }
+    cursor_wait_timer_.Stop();
+    cursor_dirty_ = false;
+    // A read counts against the period whether or not it sends anything, so
+    // callbacks that change nothing viz draws cannot each cost a read.
+    cursor_last_push_ = now;
+    if (!PushCursor()) {
+      return;  // viz has it as it is
+    }
+    cursor_push_outstanding_ = true;
+    cursor_fallback_timer_.Start(
+        FROM_HERE, recorder_->SamplePeriod() * 2,
+        base::BindOnce(&Capture::OnCursorFallback, base::Unretained(this)));
+  }
+
+  // Reads the cursor once and sends viz what changed: a new sprite when its
+  // look, its scale or its visibility did, else new bounds when it moved.
+  // False when nothing was sent.
+  bool PushCursor() {
+    CdpCursorOverlay* cursor =
+        CdpCursorOverlay::FromWebContents(web_contents());
+    gfx::Size source;
+    float dsf = 0;
+    CursorSurface(&source, &dsf);
+    const gfx::Rect content =
+        source.IsEmpty() ? gfx::Rect()
+                         : media::ComputeLetterboxRegionForI420(
+                               gfx::Rect(recorder_->size_), source);
+    // No cursor before input has placed it.
+    if (!cursor || !cursor->has_position() || content.IsEmpty() ||
+        !std::isfinite(dsf) || dsf <= 0) {
+      return HideCursor();
+    }
+    const float scale = dsf * content.width() / source.width();
+    if (!cursor_shown_ || cursor->look_version() != cursor_look_ ||
+        scale != cursor_scale_) {
+      gfx::PointF hotspot;
+      const SkBitmap sprite = cursor->RenderSprite(scale, &hotspot);
+      if (sprite.drawsNothing()) {
+        return HideCursor();
+      }
+      cursor_look_ = cursor->look_version();
+      cursor_scale_ = scale;
+      cursor_hotspot_ = hotspot;
+      cursor_sprite_size_ = gfx::Size(sprite.width(), sprite.height());
+      cursor_bounds_ =
+          PlaceCursor(cursor->position(), cursor_hotspot_,
+                      cursor_sprite_size_, source, dsf, recorder_->size_)
+              .bounds;
+      cursor_shown_ = true;
+      cursor_overlay_->SetImageAndBounds(sprite, cursor_bounds_);
+      return true;
+    }
+    const gfx::RectF bounds =
+        PlaceCursor(cursor->position(), cursor_hotspot_, cursor_sprite_size_,
+                    source, dsf, recorder_->size_)
+            .bounds;
+    if (bounds == cursor_bounds_) {
+      return false;
+    }
+    cursor_bounds_ = bounds;
+    cursor_overlay_->SetBounds(cursor_bounds_);
+    return true;
+  }
+
+  // Empty bounds hide the overlay until the next sprite.
+  bool HideCursor() {
+    if (!cursor_shown_) {
+      return false;
+    }
+    cursor_shown_ = false;
+    cursor_bounds_ = gfx::RectF();
+    cursor_overlay_->SetBounds(cursor_bounds_);
+    return true;
+  }
+
+  // The captured surface's size in pixels and its pixels per DIP: the last
+  // frame's, else the tab's view's.
+  void CursorSurface(gfx::Size* source, float* dsf) {
+    if (!cursor_source_size_.IsEmpty() && cursor_dsf_ > 0) {
+      *source = cursor_source_size_;
+      *dsf = cursor_dsf_;
+      return;
+    }
+    auto* view = static_cast<RenderWidgetHostViewBase*>(
+        web_contents()->GetRenderWidgetHostView());
+    if (view) {
+      *source = view->GetCompositorViewportPixelSize();
+      *dsf = view->GetDeviceScaleFactor();
+    }
+  }
+
+  // The cursor's hotspot in the file, in its pixels; 0,0 while the surface
+  // has no size.
+  gfx::PointF CursorPoint(const CdpCursorOverlay& cursor) {
+    gfx::Size source;
+    float dsf = 0;
+    CursorSurface(&source, &dsf);
+    if (source.IsEmpty() || !std::isfinite(dsf) || dsf <= 0) {
+      return gfx::PointF();
+    }
+    const gfx::Rect content = media::ComputeLetterboxRegionForI420(
+        gfx::Rect(recorder_->size_), source);
+    if (content.IsEmpty()) {
+      return gfx::PointF();
+    }
+    return CursorPointInFile(cursor.position(), source, dsf, content);
+  }
+
+  // AgentAudioCapture::Client, on the UI thread from a task of the
+  // capture's own:
+  void OnAudioCaptured(scoped_refptr<media::AudioBuffer> buffer,
+                       base::TimeTicks capture_time) override {
+    recorder_->OnAudioCaptured(this, std::move(buffer), capture_time);
+  }
+  void OnAudioCaptureError() override { recorder_->OnAudioCaptureLost(this); }
+
+  void OnError() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AgentVideoRecorder::OnCaptureError,
+                                  recorder_->weak_factory_.GetWeakPtr(),
+                                  serial_));
+  }
+
+  // WebContentsObserver:
+  void WebContentsDestroyed() override {
+    Stop();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AgentVideoRecorder::OnCaptureLost,
+                                  recorder_->weak_factory_.GetWeakPtr(),
+                                  serial_));
+  }
+
+  const raw_ptr<AgentVideoRecorder> recorder_;
+  const std::string target_id_;
+  const uint64_t serial_;
+  std::unique_ptr<WebContentsVideoCaptureDevice> device_;
+  base::flat_map<int, scoped_refptr<Buffer>> buffers_;
+  base::TimeTicks started_at_;
+  base::TimeTicks last_frame_time_;
+  base::TimeTicks became_current_at_;
+  // The tab's sound while the service records it.
+  std::unique_ptr<AgentAudioCapture> audio_;
+  bool audio_failed_ = false;
+
+  // The CDP cursor in this capture's frames (StartCursor), declared after
+  // the device so that it goes first.
+  std::unique_ptr<viz::ClientFrameSinkVideoCapturer::Overlay> cursor_overlay_;
+  base::CallbackListSubscription cursor_changed_;
+  // The cursor changed since it was last sent.
+  bool cursor_dirty_ = false;
+  // A push waits for its frame.
+  bool cursor_push_outstanding_ = false;
+  base::TimeTicks cursor_last_push_;
+  // Holds a push back until a frame period has passed since the last one.
+  base::OneShotTimer cursor_wait_timer_;
+  // Stops waiting for a push's frame after two periods.
+  base::OneShotTimer cursor_fallback_timer_;
+  // The surface as the last frame gave it.
+  gfx::Size cursor_source_size_;
+  float cursor_dsf_ = 0;
+  // What viz has: whether the cursor shows, the sprite's look, scale,
+  // hotspot and size, and the bounds.
+  bool cursor_shown_ = false;
+  uint64_t cursor_look_ = 0;
+  float cursor_scale_ = 0;
+  gfx::PointF cursor_hotspot_;
+  gfx::Size cursor_sprite_size_;
+  gfx::RectF cursor_bounds_;
+  uint64_t cursor_clicks_seen_ = 0;
+
+  base::WeakPtrFactory<Capture> weak_factory_{this};
+};
+
+// ---------------------------------------------------------------------------
+// Files, on the registry's blocking sequence.
+
+AgentVideoRecorder::Files::Files() = default;
+AgentVideoRecorder::Files::~Files() = default;
+
+AgentVideoRecorder::Files::OpenResult AgentVideoRecorder::Files::Open(
+    const base::FilePath& video_path,
+    const base::FilePath& events_path) {
+  OpenResult result;
+  video_path_ = video_path;
+  events_path_ = events_path;
+  if (!base::CreateDirectory(video_path.DirName())) {
+    return result;
+  }
+  // FLAG_CREATE fails on an existing file: a recording never replaces one.
+  constexpr uint32_t kFlags = base::File::FLAG_CREATE | base::File::FLAG_WRITE;
+  video_.Initialize(video_path, kFlags);
+  if (!video_.IsValid()) {
+    if (video_.error_details() == base::File::FILE_ERROR_EXISTS) {
+      result.status = OpenResult::Status::kExists;
+      result.existing = video_path;
+    }
+    return result;
+  }
+  video_created_ = true;
+  events_.Initialize(events_path, kFlags);
+  if (!events_.IsValid()) {
+    if (events_.error_details() == base::File::FILE_ERROR_EXISTS) {
+      result.status = OpenResult::Status::kExists;
+      result.existing = events_path;
+    }
+    // Removes the video file just created; the sidecar was not.
+    Discard();
+    return result;
+  }
+  events_created_ = true;
+  result.status = OpenResult::Status::kOk;
+  return result;
+}
+
+bool AgentVideoRecorder::Files::AppendVideo(const std::vector<uint8_t>& data,
+                                            int64_t duration_us) {
+  if (!video_.IsValid() || !video_.WriteAtCurrentPosAndCheck(data)) {
+    write_failed_ = true;
+    return false;
+  }
+  video_bytes_ += base::checked_cast<int64_t>(data.size());
+  if (!head_done_) {
+    const size_t room = kMaxHeadBytes - head_.size();
+    head_.insert(head_.end(), data.begin(),
+                 data.begin() + std::min(room, data.size()));
+    FindLengthFields();
+  }
+  // The video itself was written; a length field that could not be
+  // rewritten keeps its old value (see WriteLength).
+  WriteLength(duration_us);
+  return true;
+}
+
+void AgentVideoRecorder::Files::FindLengthFields() {
+  // Reads `bytes` big-endian bytes of the head at `at`.
+  const auto read = [this](size_t at, size_t bytes) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < bytes; ++i) {
+      value = (value << 8) | head_[at + i];
+    }
+    return value;
+  };
+  // The box at `at` within `end`: its type, where its body starts and where
+  // the next box starts; false while it is not all in the head yet.
+  struct Box {
+    uint32_t type = 0;
+    size_t body = 0;
+    size_t next = 0;
+  };
+  const auto box_at = [&](size_t at, size_t end, Box* box) {
+    if (at + 8 > end) {
+      return false;
+    }
+    uint64_t size = read(at, 4);
+    box->type = static_cast<uint32_t>(read(at + 4, 4));
+    box->body = at + 8;
+    if (size == 1) {
+      if (at + 16 > end) {
+        return false;
+      }
+      size = read(at + 8, 8);
+      box->body = at + 16;
+    }
+    if (size < box->body - at || size > end - at) {
+      return false;
+    }
+    box->next = at + static_cast<size_t>(size);
+    return true;
+  };
+  constexpr uint32_t kMoov = 0x6d6f6f76;  // 'moov'
+  constexpr uint32_t kMvhd = 0x6d766864;  // 'mvhd'
+  constexpr uint32_t kTrak = 0x7472616b;  // 'trak'
+  constexpr uint32_t kTkhd = 0x746b6864;  // 'tkhd'
+  constexpr uint32_t kMdia = 0x6d646961;  // 'mdia'
+  constexpr uint32_t kMdhd = 0x6d646864;  // 'mdhd'
+
+  // The header comes after ftyp; find moov among the top-level boxes.
+  Box top;
+  size_t at = 0;
+  const size_t end = head_.size();
+  while (true) {
+    if (!box_at(at, end, &top)) {
+      // Not all here yet, or beyond what the head keeps.
+      if (head_.size() >= kMaxHeadBytes) {
+        head_done_ = true;
+        head_.clear();
+      }
+      return;
+    }
+    if (top.type == kMoov) {
+      break;
+    }
+    at = top.next;
+  }
+  head_done_ = true;
+  uint32_t movie_timescale = 0;
+  std::vector<LengthField> fields;
+  // mvhd and mdhd: version, flags, two times, the timescale, the length.
+  const auto header_field = [&](const Box& box, uint32_t* timescale) {
+    if (box.body >= box.next) {
+      return false;
+    }
+    const bool wide = head_[box.body] == 1;
+    const size_t times = wide ? 16 : 8;
+    if (box.body + 4 + times + 4 + (wide ? 8 : 4) > box.next) {
+      return false;
+    }
+    *timescale = static_cast<uint32_t>(read(box.body + 4 + times, 4));
+    fields.push_back({base::checked_cast<int64_t>(box.body + 4 + times + 4),
+                      wide, *timescale});
+    return *timescale != 0;
+  };
+  Box child;
+  for (size_t c = top.body; c < top.next && box_at(c, top.next, &child);
+       c = child.next) {
+    if (child.type == kMvhd) {
+      if (!header_field(child, &movie_timescale)) {
+        head_.clear();
+        return;
+      }
+    } else if (child.type == kTrak && movie_timescale) {
+      Box part;
+      for (size_t t = child.body;
+           t < child.next && box_at(t, child.next, &part); t = part.next) {
+        if (part.type == kTkhd && part.body < part.next) {
+          // tkhd: version, flags, two times, the track id, 4 reserved, then
+          // the length, counted in the movie's timescale.
+          const bool wide = head_[part.body] == 1;
+          const size_t length_at = part.body + 4 + (wide ? 16 : 8) + 8;
+          if (length_at + (wide ? 8 : 4) <= part.next) {
+            fields.push_back({base::checked_cast<int64_t>(length_at), wide,
+                              movie_timescale});
+          }
+        } else if (part.type == kMdia) {
+          Box media;
+          for (size_t m = part.body;
+               m < part.next && box_at(m, part.next, &media); m = media.next) {
+            uint32_t media_timescale = 0;
+            if (media.type == kMdhd) {
+              header_field(media, &media_timescale);
+            }
+          }
+        }
+      }
+    }
+  }
+  length_fields_ = std::move(fields);
+  head_.clear();
+}
+
+void AgentVideoRecorder::Files::WriteLength(int64_t duration_us) {
+  if (length_fields_.empty() || !video_.IsValid() || duration_us < 0) {
+    return;
+  }
+  for (const LengthField& field : length_fields_) {
+    if (!field.timescale) {
+      continue;
+    }
+    const uint64_t units = base::checked_cast<uint64_t>(
+        (duration_us * field.timescale + 500000) / 1000000);
+    const size_t bytes = field.wide ? 8 : 4;
+    const uint64_t value =
+        field.wide ? units : std::min<uint64_t>(units, 0xffffffffu);
+    std::vector<uint8_t> big(bytes);
+    for (size_t i = 0; i < bytes; ++i) {
+      big[i] = static_cast<uint8_t>(value >> (8 * (bytes - 1 - i)));
+    }
+    // A field that cannot be rewritten keeps the length it had: the video
+    // itself is whole, so this is no failure of the recording.
+    video_.WriteAndCheck(field.offset, big);
+  }
+  // A positioned write moves the file pointer on Windows: back to the end of
+  // what was appended. If that fails, the next append would land on the
+  // header, so the file is closed and every later write fails cleanly.
+  if (video_.Seek(base::File::FROM_BEGIN, video_bytes_) != video_bytes_) {
+    write_failed_ = true;
+    video_.Close();
+  }
+}
+
+bool AgentVideoRecorder::Files::AppendLine(const std::string& line) {
+  // Unbuffered: each line is in the file once the write returns.
+  if (!events_.IsValid() ||
+      !events_.WriteAtCurrentPosAndCheck(base::as_byte_span(line))) {
+    write_failed_ = true;
+    return false;
+  }
+  return true;
+}
+
+AgentVideoRecorder::Files::CloseResult AgentVideoRecorder::Files::Close(
+    int64_t duration_us) {
+  WriteLength(duration_us);
+  video_.Close();
+  events_.Close();
+  CloseResult result;
+  result.bytes = video_bytes_;
+  result.write_failed = write_failed_;
+  return result;
+}
+
+void AgentVideoRecorder::Files::Discard() {
+  video_.Close();
+  events_.Close();
+  if (video_created_) {
+    base::DeleteFile(video_path_);
+    video_created_ = false;
+  }
+  if (events_created_) {
+    base::DeleteFile(events_path_);
+    events_created_ = false;
+  }
+}
