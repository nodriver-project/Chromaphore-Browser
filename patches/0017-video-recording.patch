+
+namespace blink {
+
+bool PaintAgentRedactedText(const InlineCursor& cursor,
+                            const PaintInfo& paint_info,
+                            const TextFragmentPaintInfo& fragment_paint_info,
+                            const gfx::Rect& visual_rect) {
+  // What a canvas shows is canvas content, and a page can read it back.
+  if (paint_info.IsPrivacyPreserving()) {
+    return false;
+  }
+  const FragmentItem& item = *cursor.CurrentItem();
+  const LayoutObject* object = item.GetLayoutObject();
+  // The node the text belongs to: a ::first-letter part's text node, else
+  // the nearest node up the layout tree (a hyphen or an ellipsis the layout
+  // made belongs to its block; generated content to its pseudo-element).
+  const Node* node = nullptr;
+  if (const auto* fragment = DynamicTo<LayoutTextFragment>(object)) {
+    node = fragment->AssociatedTextNode();
+  }
+  for (const LayoutObject* up = object; !node && up; up = up->Parent()) {
+    node = up->GetNode();
+  }
+  if (!node || !AgentRedactionMarks::HidesText(*node)) {
+    return false;
+  }
+  // Nothing is drawn: the hidden root's cover (PaintAgentRedactionCover) is
+  // the black, and it does not follow the text. TextPainter::Paint's two
+  // reports of drawn text are still made; a symbol list marker, which
+  // PaintSymbol draws with no text, makes none, as it would not.
+  if (item.IsSymbolMarker()) {
+    return true;
+  }
+  if (!fragment_paint_info.text.SubstringContainsOnlyWhitespaceOrEmpty(
+          fragment_paint_info.from, fragment_paint_info.to)) {
+    paint_info.context.GetPaintController().SetTextPainted();
+  }
+  const auto* combine = DynamicTo<LayoutTextCombine>(object->Parent());
+  const Font* font = combine && combine->CompressedFont()
+                         ? combine->CompressedFont()
+                         : &item.ScaledFont();
+  if (!font->ShouldSkipDrawing()) {
+    PaintTimingDetector::NotifyTextPaint(visual_rect);
+  }
+  return true;
+}
+
+void PaintAgentRedactionCover(const PhysicalBoxFragment& fragment,
+                              const PaintInfo& paint_info,
+                              const DisplayItemClient& client,
+                              const PhysicalRect& rect,
+                              const gfx::Rect& visual_rect,
+                              bool in_contents_space) {
+  if (paint_info.IsPrivacyPreserving()) {
+    return;
+  }
+  const auto* element =
+      DynamicTo<Element>(fragment.GetLayoutObject()->GetNode());
+  if (!element || !AgentRedactionMarks::IsHiddenRoot(*element)) {
+    return;
+  }
+  GraphicsContext& context = paint_info.context;
+  std::optional<DrawingRecorder> recorder;
+  if (!context.InDrawingRecorder()) {
+    if (DrawingRecorder::UseCachedDrawingIfPossible(
+            context, client, DisplayItem::kAgentRedactionCover)) {
+      return;
+    }
+    recorder.emplace(context, client, DisplayItem::kAgentRedactionCover,
+                     visual_rect);
+  }
+  // Dark mode's filter could make the fill light.
+  if (in_contents_space) {
+    context.FillRect(ToPixelSnappedRect(rect), Color::kBlack,
+                     AutoDarkMode::Disabled());
+    return;
+  }
+  // The border box, its corners following the border's radius on the sides
+  // this fragment includes.
+  const ContouredRect cover =
+      ContouredBorderGeometry::PixelSnappedContouredBorder(
+          fragment.Style(), rect, fragment.SidesToInclude());
+  context.FillContouredRect(cover, Color::kBlack, AutoDarkMode::Disabled());
+}
+
+}  // namespace blink
