+
+// From Initialize to the end of the self-test.
+constexpr base::TimeDelta kStartTimeout = base::Seconds(3);
+
+// An output owed this long with none arriving ends the recording: Media
+// Foundation only logs a failed ProcessOutput and then never answers.
+constexpr base::TimeDelta kOutputTimeout = base::Seconds(5);
+
+// The self-test's frames, stamped one frame apart from 0: the first
+// kTestKeyframes are asked as keyframes, the rest follow them.
+constexpr int kTestFrames = 3;
+constexpr int kTestKeyframes = 2;
+// The first test frame is a keyframe, which makes the parser every later
+// output is checked with.
+static_assert(kTestKeyframes >= 1 && kTestKeyframes < kTestFrames);
+
+// Output buffers with the encoder at a time: one for each frame the service
+// may have in flight.
+constexpr size_t kOutputBuffers = 4;
+
+// The largest output buffer the encoder may ask for.
+constexpr size_t kMaxOutputBufferBytes = 32 * 1024 * 1024;
+
+}  // namespace
+
+AgentVideoHardwareEncoder::OutputBuffer::OutputBuffer() = default;
+AgentVideoHardwareEncoder::OutputBuffer::OutputBuffer(OutputBuffer&&) =
+    default;
+AgentVideoHardwareEncoder::OutputBuffer&
+AgentVideoHardwareEncoder::OutputBuffer::operator=(OutputBuffer&&) = default;
+AgentVideoHardwareEncoder::OutputBuffer::~OutputBuffer() = default;
+
+AgentVideoHardwareEncoder::EncodeInFlight::EncodeInFlight() = default;
+AgentVideoHardwareEncoder::EncodeInFlight::EncodeInFlight(EncodeInFlight&&) =
+    default;
+AgentVideoHardwareEncoder::EncodeInFlight&
+AgentVideoHardwareEncoder::EncodeInFlight::operator=(EncodeInFlight&&) =
+    default;
+AgentVideoHardwareEncoder::EncodeInFlight::~EncodeInFlight() = default;
+
+AgentVideoHardwareEncoder::AgentVideoHardwareEncoder(
+    mojo::PendingRemote<media::mojom::VideoEncodeAcceleratorProvider>
+        provider)
+    : pending_provider_(std::move(provider)) {}
+
+AgentVideoHardwareEncoder::~AgentVideoHardwareEncoder() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The encoder goes first, so none of its calls reaches this object while
+  // it is destroyed. Callbacks not run yet are dropped.
+  vea_.reset();
+}
+
+void AgentVideoHardwareEncoder::Initialize(media::VideoCodecProfile profile,
+                                           const Options& options,
+                                           EncoderInfoCB info_cb,
+                                           OutputCB output_cb,
+                                           EncoderStatusCB done_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The answer always comes in a task of its own: the caller may destroy
+  // this encoder when it gets it.
+  done_cb = BindCallbackToCurrentLoopIfNeeded(std::move(done_cb));
+  if (state_ != State::kIdle) {
+    std::move(done_cb).Run(
+        media::EncoderStatus::Codes::kEncoderInitializeTwice);
+    return;
+  }
+  start_cb_ = std::move(done_cb);
+  state_ = State::kStarting;
+  if (!pending_provider_.is_valid()) {
+    FailStart(media::EncoderStatus::Codes::kEncoderInitializationError);
+    return;
+  }
+  if (options.frame_size.IsEmpty() || !options.bitrate ||
+      options.bitrate->target_bps() == 0 || !options.framerate ||
+      *options.framerate < 1) {
+    FailStart(media::EncoderStatus::Codes::kEncoderUnsupportedConfig);
+    return;
+  }
+  frame_size_ = options.frame_size;
+  fps_ = base::ClampRound<uint32_t>(*options.framerate);
+  frame_duration_ = base::Seconds(1) / fps_;
+  info_cb_ = std::move(info_cb);
+  output_cb_ = std::move(output_cb);
+
+  // No command buffer: the frames are in shared memory.
+  provider_.Bind(std::move(pending_provider_));
+  mojo::PendingRemote<media::mojom::VideoEncodeAccelerator> vea;
+  provider_->CreateVideoEncodeAccelerator(
+      /*command_buffer_id=*/nullptr, vea.InitWithNewPipeAndPassReceiver());
+  // The unique_ptr's deleter calls Destroy(), the only way to delete a
+  // MojoVideoEncodeAccelerator.
+  vea_ = base::WrapUnique<media::VideoEncodeAccelerator>(
+      new media::MojoVideoEncodeAccelerator(std::move(vea)));
+
+  // The encoder's own variable rate control, with a peak of twice the
+  // target: the browser ends a recording that sends more than that. A
+  // constant bitrate would run this tree's software rate controller on some
+  // encoders, which keeps the quantizer of display content at 35 or under
+  // and so can overshoot a low target without limit.
+  const uint32_t target_bps = options.bitrate->target_bps();
+  const media::Bitrate bitrate = media::Bitrate::VariableBitrate(
+      target_bps, base::saturated_cast<uint32_t>(uint64_t{target_bps} * 2));
+  media::VideoEncodeAccelerator::Config config(
+      media::PIXEL_FORMAT_I420, frame_size_, profile, bitrate, fps_,
+      media::VideoEncodeAccelerator::Config::StorageType::kShmem,
+      media::VideoEncodeAccelerator::Config::ContentType::kDisplay);
+  if (options.keyframe_interval) {
+    config.gop_length =
+        base::saturated_cast<uint32_t>(*options.keyframe_interval);
+  }
+  // Low delay, so no B-frames: the muxer writes no composition offsets, so
+  // every frame must come out in the order it went in.
+  config.require_low_delay = true;
+  // The rest keeps its defaults: a hardware encoder only, no frame dropping
+  // by the encoder, no layers, and not constrained baseline (which some
+  // encoders do not offer).
+
+  // A sync call to the GPU process, which a utility process may make. The
+  // media log must not be null: MojoVideoEncodeAccelerator clones it.
+  const media::EncoderStatus status =
+      vea_->Initialize(config, this, std::make_unique<media::NullMediaLog>());
+  if (!status.is_ok()) {
+    FailStart(status);
+    return;
+  }
+  // Also a sync call, so asked once.
+  flush_supported_ = vea_->IsFlushSupported();
+  // The timer is this object's, so its task never outlives it.
+  start_timer_.Start(FROM_HERE, kStartTimeout,
+                     base::BindOnce(&AgentVideoHardwareEncoder::OnStartTimeout,
+                                    base::Unretained(this)));
+}
+
+void AgentVideoHardwareEncoder::Encode(scoped_refptr<media::VideoFrame> frame,
+                                       const EncodeOptions& encode_options,
+                                       EncoderStatusCB done_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ == State::kError) {
+    PostStatus(std::move(done_cb), error_);
+    return;
+  }
+  if (state_ != State::kRunning) {
+    PostStatus(std::move(done_cb),
+               media::EncoderStatus::Codes::kEncoderInitializeNeverCompleted);
+    return;
+  }
+  // The encoder takes unpadded I420 at the recording's size.
+  if (!frame || frame->format() != media::PIXEL_FORMAT_I420 ||
+      frame->coded_size() != frame_size_) {
+    PostStatus(std::move(done_cb),
+               media::EncoderStatus::Codes::kInvalidInputFrame);
+    return;
+  }
+  // A wrapper carries the encoder's timestamp, so the caller's frame never
+  // changes. It keeps the frame's shared memory, so the frame crosses to the
+  // GPU process as a handle, not a copy.
+  scoped_refptr<media::VideoFrame> sent = media::VideoFrame::WrapVideoFrame(
+      frame, frame->format(), frame->visible_rect(), frame->natural_size());
+  if (!sent) {
+    PostStatus(std::move(done_cb),
+               media::EncoderStatus::Codes::kInvalidInputFrame);
+    return;
+  }
+  // Past the test frames, so the encoder's timestamps keep rising and none
+  // repeats a test frame's.
+  sent->set_timestamp(frame->timestamp() + kTestFrames * frame_duration_);
+
+  EncodeInFlight encode;
+  encode.timestamp = frame->timestamp();
+  encode.sent_timestamp = sent->timestamp();
+  encode.color_space = frame->ColorSpace();
+  encode.done_cb = std::move(done_cb);
+  pending_.push_back(std::move(encode));
+  vea_->Encode(std::move(sent), EncodeOptions(encode_options.key_frame));
+  if (!output_timer_.IsRunning()) {
+    ArmOutputTimer();
+  }
+}
+
+void AgentVideoHardwareEncoder::ChangeOptions(const Options& options,
+                                              OutputCB output_cb,
+                                              EncoderStatusCB done_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // A recording keeps its options from start to end.
+  PostStatus(std::move(done_cb),
+             media::EncoderStatus::Codes::kEncoderUnsupportedConfig);
+}
+
+void AgentVideoHardwareEncoder::Flush(EncoderStatusCB done_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ == State::kError) {
+    PostStatus(std::move(done_cb), error_);
+    return;
+  }
+  if (state_ != State::kRunning) {
+    PostStatus(std::move(done_cb),
+               media::EncoderStatus::Codes::kEncoderInitializeNeverCompleted);
+    return;
+  }
+  if (flush_cb_) {
+    PostStatus(std::move(done_cb),
+               media::EncoderStatus::Codes::kEncoderIllegalState);
+    return;
+  }
+  if (pending_.empty()) {
+    PostStatus(std::move(done_cb), media::EncoderStatus::Codes::kOk);
+    return;
+  }
+  // Done once every frame in flight came back; the stall watchdog bounds
+  // the wait.
+  flush_cb_ = std::move(done_cb);
+  if (flush_supported_) {
+    // Pushes out whatever the hardware holds. The reply comes on another
+    // pipe than the outputs, so it proves nothing about them, and is only
+    // logged when the flush failed.
+    vea_->Flush(base::BindOnce([](bool flushed) {
+      if (!flushed) {
+        LOG(WARNING) << "Hardware video encoder flush failed";
+      }
+    }));
+  }
+}
+
+void AgentVideoHardwareEncoder::RequireBitstreamBuffers(
+    unsigned int input_count,
+    const gfx::Size& input_coded_size,
+    size_t output_buffer_size) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Asked once, before the first frame: the GPU process refuses a frame
+  // sent before it.
+  if (state_ != State::kStarting || !buffers_.empty()) {
+    Fail(media::EncoderStatus(
+        media::EncoderStatus::Codes::kEncoderIllegalState,
+        "output buffers asked twice"));
+    return;
+  }
+  // The frames go unpadded, and the buffers stay bounded.
+  if (input_coded_size != frame_size_ || output_buffer_size == 0 ||
+      output_buffer_size > kMaxOutputBufferBytes) {
+    Fail(media::EncoderStatus::Codes::kEncoderUnsupportedConfig);
+    return;
+  }
+  for (size_t i = 0; i < kOutputBuffers; ++i) {
+    OutputBuffer buffer;
+    buffer.region = base::UnsafeSharedMemoryRegion::Create(output_buffer_size);
+    if (buffer.region.IsValid()) {
+      buffer.mapping = buffer.region.Map();
+    }
+    if (!buffer.mapping.IsValid()) {
+      Fail(media::EncoderStatus::Codes::kOutOfMemoryError);
+      return;
+    }
+    buffers_.push_back(std::move(buffer));
+  }
+  for (size_t i = 0; i < kOutputBuffers; ++i) {
+    GiveBuffer(static_cast<int32_t>(i));
+  }
+  SendTestFrame();
+}
+
+void AgentVideoHardwareEncoder::BitstreamBufferReady(
+    int32_t bitstream_buffer_id,
+    const media::BitstreamBufferMetadata& metadata) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const int32_t id = bitstream_buffer_id;
+  if (state_ == State::kStarting) {
+    OnTestOutput(id, metadata);
+    return;
+  }
+  if (state_ != State::kRunning) {
+    return;
+  }
+  if (!TakeBuffer(id) || pending_.empty()) {
+    Fail(media::EncoderStatus(
+        media::EncoderStatus::Codes::kInvalidOutputBuffer,
+        "output not asked for"));
+    return;
+  }
+  // One output per input, in input order: this is the oldest frame's.
+  const EncodeInFlight& oldest = pending_.front();
+  if (metadata.payload_size_bytes == 0 || metadata.dropped_frame()) {
+    // The encoder dropped the frame. An empty output tells the service,
+    // which counts the tick as dropped.
+    GiveBuffer(id);
+    media::VideoEncoderOutput output;
+    output.timestamp = oldest.timestamp;
+    Deliver(std::move(output), std::nullopt);
+    return;
+  }
+  // An output out of order, or one lost, cannot be muxed.
+  if (metadata.timestamp != oldest.sent_timestamp) {
+    Fail(media::EncoderStatus(
+        media::EncoderStatus::Codes::kEncoderFailedEncode,
+        "output out of order"));
+    return;
+  }
+  if (metadata.payload_size_bytes >
+      buffers_[static_cast<size_t>(id)].mapping.size()) {
+    Fail(media::EncoderStatus(
+        media::EncoderStatus::Codes::kInvalidOutputBuffer,
+        "output larger than its buffer"));
+    return;
+  }
+  media::VideoEncoderOutput output;
+  // Annex B as the encoder gave it: the muxer converts each sample itself.
+  output.data = CopyPayload(id, metadata.payload_size_bytes);
+  bool config_changed = false;
+  if (!ParseOutput(output.data.as_span(), &config_changed)) {
+    Fail(media::EncoderStatus::Codes::kBitstreamConversionError);
+    return;
+  }
+  if (config_changed) {
+    // The file's one avc1 entry holds the parameter sets for every sample.
+    CodecDescription record;
+    if (!converter_->GetCurrentConfig().Serialize(record) ||
+        record != description_) {
+      Fail(media::EncoderStatus(
+          media::EncoderStatus::Codes::kEncoderUnsupportedConfig,
+          "parameter sets changed"));
+      return;
+    }
+  }
+  GiveBuffer(id);
+  output.timestamp = oldest.timestamp;
+  output.key_frame = metadata.key_frame;
+  output.color_space =
+      metadata.encoded_color_space.value_or(oldest.color_space);
+  std::optional<CodecDescription> description;
+  if (output.key_frame) {
+    description = description_;
+  }
+  Deliver(std::move(output), std::move(description));
+}
+
+void AgentVideoHardwareEncoder::NotifyErrorStatus(
+    const media::EncoderStatus& status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // A lost GPU process comes here too, as kEncoderMojoConnectionError.
+  Fail(status);
+}
+
+void AgentVideoHardwareEncoder::NotifyEncoderInfoChange(
+    const media::VideoEncoderInfo& info) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (info_cb_) {
+    info_cb_.Run(info);
+  }
+}
+
+void AgentVideoHardwareEncoder::SendTestFrame() {
+  scoped_refptr<media::VideoFrame> frame =
+      media::VideoFrame::CreateBlackFrame(frame_size_);
+  if (!frame) {
+    Fail(media::EncoderStatus::Codes::kOutOfMemoryError);
+    return;
+  }
+  test_timestamp_ = test_outputs_ * frame_duration_;
+  frame->set_timestamp(test_timestamp_);
+  vea_->Encode(std::move(frame),
+               EncodeOptions(/*key_frame=*/test_outputs_ < kTestKeyframes));
+}
+
+void AgentVideoHardwareEncoder::OnTestOutput(
+    int32_t id,
+    const media::BitstreamBufferMetadata& metadata) {
+  const bool keyframe_test = test_outputs_ < kTestKeyframes;
+  // At the test frame's time, with a payload within its buffer, and a
+  // keyframe when one was asked.
+  if (!TakeBuffer(id) || metadata.dropped_frame() ||
+      metadata.payload_size_bytes == 0 ||
+      (keyframe_test && !metadata.key_frame) ||
+      metadata.timestamp != test_timestamp_ ||
+      metadata.payload_size_bytes >
+          buffers_[static_cast<size_t>(id)].mapping.size()) {
+    Fail(media::EncoderStatus(
+        media::EncoderStatus::Codes::kEncoderInitializationError,
+        "self-test output wrong"));
+    return;
+  }
+  const base::HeapArray<uint8_t> data =
+      CopyPayload(id, metadata.payload_size_bytes);
+  if (keyframe_test) {
+    // Each test keyframe is parsed from nothing, as the muxer parses the
+    // file's first sample: it must carry its parameter sets itself.
+    converter_.emplace(/*add_parameter_sets_in_bitstream=*/false);
+  }
+  bool config_changed = false;
+  if (!ParseOutput(data.as_span(), &config_changed)) {
+    Fail(media::EncoderStatus::Codes::kBitstreamConversionError);
+    return;
+  }
+  if (keyframe_test || config_changed) {
+    const media::mp4::AVCDecoderConfigurationRecord& config =
+        converter_->GetCurrentConfig();
+    CodecDescription record;
+    // The muxer parses the record back and writes it into the file's
+    // header, checking the first only in debug builds, so both are done
+    // here.
+    media::mp4::AVCDecoderConfigurationRecord parsed;
+    CodecDescription again;
+    if (config.sps_list.empty() || config.pps_list.empty() ||
+        !config.Serialize(record) || !parsed.Parse(record) ||
+        !parsed.Serialize(again)) {
+      Fail(media::EncoderStatus::Codes::kBitstreamConversionError);
+      return;
+    }
+    // One avcC record for the whole file: every test output's is the
+    // first's.
+    if (test_outputs_ > 0 && record != description_) {
+      Fail(media::EncoderStatus(
+          media::EncoderStatus::Codes::kEncoderUnsupportedConfig,
+          "parameter sets changed"));
+      return;
+    }
+    description_ = std::move(record);
+  }
+  GiveBuffer(id);
+  if (++test_outputs_ < kTestFrames) {
+    // The next frame only now: the output came without it.
+    SendTestFrame();
+    return;
+  }
+  // The recording's own outputs are parsed from nothing too, so this check
+  // knows exactly the parameter sets the muxer's parser will know.
+  converter_.emplace(/*add_parameter_sets_in_bitstream=*/false);
+  start_timer_.Stop();
+  state_ = State::kRunning;
+  // Posts: the caller may destroy this encoder when it gets the answer.
+  std::move(start_cb_).Run(media::EncoderStatus::Codes::kOk);
+}
+
+void AgentVideoHardwareEncoder::OnStartTimeout() {
+  Fail(media::EncoderStatus(
+      media::EncoderStatus::Codes::kEncoderInitializationError,
+      "self-test timed out"));
+}
+
+void AgentVideoHardwareEncoder::OnOutputTimeout() {
+  Fail(media::EncoderStatus(media::EncoderStatus::Codes::kEncoderFailedEncode,
+                            "no output"));
+}
+
+void AgentVideoHardwareEncoder::ArmOutputTimer() {
+  // The timer is this object's, so its task never outlives it.
+  output_timer_.Start(
+      FROM_HERE, kOutputTimeout,
+      base::BindOnce(&AgentVideoHardwareEncoder::OnOutputTimeout,
+                     base::Unretained(this)));
+}
+
+bool AgentVideoHardwareEncoder::TakeBuffer(int32_t id) {
+  if (id < 0 || static_cast<size_t>(id) >= buffers_.size()) {
+    return false;
+  }
+  OutputBuffer& buffer = buffers_[static_cast<size_t>(id)];
+  if (!buffer.at_encoder) {
+    return false;
+  }
+  buffer.at_encoder = false;
+  return true;
+}
+
+void AgentVideoHardwareEncoder::GiveBuffer(int32_t id) {
+  OutputBuffer& buffer = buffers_[static_cast<size_t>(id)];
+  buffer.at_encoder = true;
+  vea_->UseOutputBitstreamBuffer(media::BitstreamBuffer(
+      id, buffer.region.Duplicate(), buffer.region.GetSize()));
+}
+
+base::HeapArray<uint8_t> AgentVideoHardwareEncoder::CopyPayload(int32_t id,
+                                                                size_t size) {
+  // A copy: the encoder writes the buffer again as soon as it has it back.
+  return base::HeapArray<uint8_t>::CopiedFrom(
+      buffers_[static_cast<size_t>(id)].mapping.GetMemoryAsSpan<uint8_t>(
+          size));
+}
+
+bool AgentVideoHardwareEncoder::ParseOutput(base::span<const uint8_t> data,
+                                            bool* config_changed) {
+  size_t size = 0;
+  media::MP4Status status =
+      converter_->ConvertChunk(data, scratch_, config_changed, &size);
+  if (status.code() == media::MP4Status::Codes::kBufferTooSmall) {
+    // Only whether it converts matters, not what it converts to.
+    scratch_.resize(size);
+    status = converter_->ConvertChunk(data, scratch_, config_changed, &size);
+  }
+  // An output with no slice converts to nothing, which the muxer refuses.
+  return status.is_ok() && size > 0;
+}
+
+void AgentVideoHardwareEncoder::Deliver(
+    media::VideoEncoderOutput output,
+    std::optional<CodecDescription> description) {
+  EncodeInFlight encode = std::move(pending_.front());
+  pending_.pop_front();
+  // The callbacks may end the recording or destroy this object: after
+  // each, this object is touched only while it exists.
+  base::WeakPtr<AgentVideoHardwareEncoder> self = weak_factory_.GetWeakPtr();
+  output_cb_.Run(std::move(output), std::move(description));
+  if (!self) {
+    return;
+  }
+  // The service counts frames in flight by this: the frame is done once
+  // its output is out.
+  std::move(encode.done_cb).Run(media::EncoderStatus::Codes::kOk);
+  if (!self || state_ != State::kRunning) {
+    return;
+  }
+  if (!pending_.empty()) {
+    ArmOutputTimer();
+    return;
+  }
+  output_timer_.Stop();
+  if (flush_cb_) {
+    std::move(flush_cb_).Run(media::EncoderStatus::Codes::kOk);
+  }
+}
+
+void AgentVideoHardwareEncoder::PostStatus(EncoderStatusCB done_cb,
+                                           media::EncoderStatus status) {
+  BindCallbackToCurrentLoopIfNeeded(std::move(done_cb)).Run(std::move(status));
+}
+
+void AgentVideoHardwareEncoder::Fail(media::EncoderStatus status) {
+  if (state_ == State::kStarting) {
+    FailStart(std::move(status));
+    return;
+  }
+  if (state_ != State::kRunning) {
+    return;
+  }
+  LOG(WARNING) << "Hardware video encoder failed: "
+               << static_cast<int>(status.code());
+  state_ = State::kError;
+  error_ = status;
+  output_timer_.Stop();
+  // The encoder goes first, so nothing more arrives from it.
+  vea_.reset();
+  base::circular_deque<EncodeInFlight> pending;
+  pending.swap(pending_);
+  EncoderStatusCB flush_cb = std::move(flush_cb_);
+  // Only locals from here: a callback may end the recording and destroy
+  // this object.
+  for (EncodeInFlight& encode : pending) {
+    std::move(encode.done_cb).Run(status);
+  }
+  if (flush_cb) {
+    std::move(flush_cb).Run(status);
+  }
+}
+
+void AgentVideoHardwareEncoder::FailStart(media::EncoderStatus status) {
+  LOG(WARNING) << "Hardware video encoder failed to start: "
+               << static_cast<int>(status.code());
+  start_timer_.Stop();
+  // A failed Media Foundation start can still report an error afterwards;
+  // with the encoder gone, nothing more arrives.
+  vea_.reset();
+  state_ = State::kError;
+  error_ = status;
+  // Posts: the caller may destroy this encoder when it gets the answer.
+  std::move(start_cb_).Run(std::move(status));
+}
+
+}  // namespace content
+
+#endif  // BUILDFLAG(ENABLE_OPENH264) && BUILDFLAG(USE_PROPRIETARY_CODECS)
