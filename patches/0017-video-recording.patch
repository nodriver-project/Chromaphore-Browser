+  }
+  AgentVideoRecorder* recorder =
+      AgentVideoRecorder::Registry::Get().Find(in_recording_id);
+  if (!recorder) {
+    return NoVideoRecording(in_recording_id);
+  }
+  return recorder->Pause(in_label, out_media_time_ms);
+}
+
+Response BrowserHandler::ResumeVideoRecording(
+    const std::string& in_recording_id,
+    std::optional<std::string> in_label,
+    double* out_media_time_ms) {
+  if (!IsBrowserTarget()) {
+    return Response::MethodNotFound(
+        "'Browser.resumeVideoRecording' wasn't found");
+  }
+  AgentVideoRecorder* recorder =
+      AgentVideoRecorder::Registry::Get().Find(in_recording_id);
+  if (!recorder) {
+    return NoVideoRecording(in_recording_id);
+  }
+  return recorder->Resume(in_label, out_media_time_ms);
+}
+
+Response BrowserHandler::MarkVideoRecording(const std::string& in_recording_id,
+                                            const std::string& in_event,
+                                            double* out_media_time_ms) {
+  if (!IsBrowserTarget()) {
+    return Response::MethodNotFound(
+        "'Browser.markVideoRecording' wasn't found");
+  }
+  AgentVideoRecorder* recorder =
+      AgentVideoRecorder::Registry::Get().Find(in_recording_id);
+  if (!recorder) {
+    return NoVideoRecording(in_recording_id);
+  }
+  return recorder->Mark(in_event, out_media_time_ms);
+}
+
+void BrowserHandler::StopVideoRecording(
+    const std::string& in_recording_id,
+    std::unique_ptr<StopVideoRecordingCallback> callback) {
+  if (!IsBrowserTarget()) {
+    callback->sendFailure(
+        Response::MethodNotFound("'Browser.stopVideoRecording' wasn't found"));
+    return;
+  }
+  AgentVideoRecorder* recorder =
+      AgentVideoRecorder::Registry::Get().Find(in_recording_id);
+  if (!recorder) {
+    callback->sendFailure(NoVideoRecording(in_recording_id));
+    return;
+  }
+  recorder->Stop(base::BindOnce(
+      [](std::unique_ptr<StopVideoRecordingCallback> callback,
+         base::expected<AgentVideoRecorder::Result, Response> result) {
+        if (!result.has_value()) {
+          callback->sendFailure(result.error());
+          return;
+        }
+        callback->sendSuccess(ToVideoRecordingResult(*result));
+      },
+      std::move(callback)));
+}
+
+Response BrowserHandler::VideoRecordingStatus(
+    bool* out_recording,
+    std::optional<std::string>* out_recording_id,
+    std::optional<std::string>* out_state,
+    std::optional<std::string>* out_target_id,
+    std::optional<std::string>* out_path,
+    std::optional<double>* out_media_time_ms,
+    std::optional<int>* out_frames,
+    std::optional<double>* out_bytes,
+    std::optional<bool>* out_redacted,
+    std::optional<double>* out_remaining_ms) {
+  if (!IsBrowserTarget()) {
+    return Response::MethodNotFound(
+        "'Browser.videoRecordingStatus' wasn't found");
+  }
+  // browser: any browser-target session may ask, whoever started the
+  // recording; nothing changes.
+  AgentVideoRecorder* recorder = AgentVideoRecorder::Registry::Get().Current();
+  *out_recording = !!recorder;
+  if (!recorder) {
+    return Response::Success();
+  }
+  const AgentVideoRecorder::Status status = recorder->GetStatus();
+  *out_recording_id = recorder->id();
+  *out_state = status.state;
+  *out_target_id = status.target_id;
+  *out_path = status.path.AsUTF8Unsafe();
+  *out_media_time_ms = status.media_time_ms;
+  *out_frames = status.frames;
+  *out_bytes = status.bytes;
+  *out_redacted = status.redacted;
+  *out_remaining_ms = status.remaining_ms;
+  return Response::Success();
+}
+
+void BrowserHandler::OnVideoRecordingEnded(
+    const std::string& recording_id,
+    const AgentVideoRecorder::Result& result) {
+  if (frontend_) {
+    frontend_->VideoRecordingEnded(recording_id,
+                                   ToVideoRecordingResult(result));
+  }
+}
