+
+# The OpenH264 encoder comes through //media, which carries
+# //third_party/openh264:encoder as a public dependency when
+# media_use_openh264 and proprietary_codecs are both set
+# (media/video/BUILD.gn). The code checks the same pair with
+# BUILDFLAG(ENABLE_OPENH264) and BUILDFLAG(USE_PROPRIETARY_CODECS).
+# The hardware encoder sits behind the same pair; it drives the GPU process's
+# encoder with MojoVideoEncodeAccelerator from //media/mojo/clients.
+# The audio track drives the GPU process's AAC encoder with MojoAudioEncoder
+# from the same target, and reads the browser's buffers with the
+# media.mojom.AudioBuffer converters of //media/mojo/common.
+source_set("agent_video_encoding_service") {
+  sources = [
+    "agent_audio_track.cc",
+    "agent_audio_track.h",
+    "agent_video_encoding_service_impl.cc",
+    "agent_video_encoding_service_impl.h",
+    "agent_video_hardware_encoder.cc",
+    "agent_video_hardware_encoder.h",
+  ]
+
+  configs += [ "//content:content_implementation" ]
+
+  deps = [
+    "//base",
+    "//content:export",
+    "//media",
+    "//media:media_buildflags",
+    "//media/mojo/clients",
+    "//media/mojo/common",
+    "//media/mojo/mojom",
+    "//mojo/public/cpp/bindings",
+    "//ui/gfx/geometry",
+  ]
+
+  public_deps = [ "public/mojom" ]
+}
diff --git a/content/services/agent_video_encoding_service/agent_audio_track.cc b/content/services/agent_video_encoding_service/agent_audio_track.cc
new file mode 100644
index 0000000000..7ab35ba229
--- /dev/null
+++ b/content/services/agent_video_encoding_service/agent_audio_track.cc
@@ -0,0 +1,612 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/services/agent_video_encoding_service/agent_audio_track.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "media/audio/audio_opus_encoder.h"
+#include "media/base/audio_buffer.h"
+#include "media/base/audio_bus.h"
+#include "media/base/audio_codecs.h"
+#include "media/base/audio_timestamp_helper.h"
+#include "media/base/channel_layout.h"
+#include "media/base/decoder_buffer.h"
+#include "media/base/offloading_audio_encoder.h"
+#include "media/base/timestamp_constants.h"
+#include "media/formats/mp4/es_descriptor.h"
+#include "media/mojo/clients/mojo_audio_encoder.h"
+#include "media/mojo/mojom/audio_encoder.mojom.h"
+
+namespace content {
+
+namespace {
+
+// One of the four rates Windows' AAC encoder takes; Opus uses the same.
+constexpr int kBitrate = 128000;
+
+// AAC's self-test: this much silence must bring the AudioSpecificConfig
+// within kAacTestTimeout. Windows' encoder holds two packets and gives the
+// first output once three are in.
+constexpr int kAacPacketFrames = 1024;
+constexpr int kAacTestBuses = 4;
+constexpr base::TimeDelta kAacTestTimeout = base::Seconds(2);
+
+// The pre-skip the muxer writes into every Opus file (80 ms), and the
+// lookahead AudioOpusEncoder reports at 48 kHz, which its OpusHead carries
+// in bytes 10-11 (little-endian).
+constexpr int kMuxerOpusPreSkip = 3840;
+constexpr int kOpusLookahead = 312;
+constexpr base::TimeDelta kOpusPacketDuration = base::Milliseconds(20);
+
+// A buffer this far from where the count stands is placed by its time.
+constexpr int64_t kToleranceFrames = AgentAudioTrack::kSampleRate / 50;
+// More silence than this for one buffer means a clock gone wrong.
+constexpr int64_t kMaxSilenceFrames = 10 * AgentAudioTrack::kSampleRate;
+// Silence is fed in buses of at most a second.
+constexpr int64_t kSilenceBusFrames = AgentAudioTrack::kSampleRate;
+// Encodes in flight before incoming audio is dropped: a second of 10 ms
+// buffers.
+constexpr int kMaxBusesInFlight = 100;
+// Windows' AAC encoder fails a flush with fewer than two packets' worth of
+// input; three are fed at least.
+constexpr int64_t kMinFramesForFlush = 3 * kAacPacketFrames;
+// No bus shorter than this goes to the encoder (what is left of a buffer
+// after its overlap was dropped, or a span of silence): Windows' AAC encoder
+// refuses an input under its smallest, which it only says at run time, and
+// a millisecond of sound is not worth an encode.
+constexpr int64_t kMinBusFrames = 32;
+constexpr base::TimeDelta kFinishTimeout = base::Seconds(3);
+
+base::TimeDelta FramesToTime(int64_t frames) {
+  return media::AudioTimestampHelper::FramesToTime(
+      frames, AgentAudioTrack::kSampleRate);
+}
+
+// Whether `config`, an AudioSpecificConfig from the GPU process, can go into
+// the file's esds box: a few bytes that parse back once wrapped as the muxer
+// wraps them (the muxer checks that only in debug builds).
+bool AacConfigFits(const media::AudioEncoder::CodecDescription& config) {
+  constexpr size_t kMaxConfigBytes = 64;
+  if (config.empty() || config.size() > kMaxConfigBytes) {
+    return false;
+  }
+  return media::mp4::ESDescriptor().Parse(
+      media::mp4::ESDescriptor::CreateEsds(config));
+}
+
+// The lookahead in an OpusHead, or -1 when `description` is none.
+int OpusHeadPreSkip(const media::AudioEncoder::CodecDescription& description) {
+  constexpr std::string_view kMagic = "OpusHead";
+  if (description.size() < 12 ||
+      !std::ranges::equal(base::span(description).first(kMagic.size()),
+                          base::as_byte_span(kMagic))) {
+    return -1;
+  }
+  return description[10] | (description[11] << 8);
+}
+
+}  // namespace
+
+AgentAudioTrack::AgentAudioTrack(PacketCallback packet_callback,
+                                 base::OnceClosure ended_callback)
+    : packet_callback_(std::move(packet_callback)),
+      ended_callback_(std::move(ended_callback)),
+      params_(media::AudioParameters::AUDIO_PCM_LOW_LATENCY,
+              media::ChannelLayoutConfig::Stereo(),
+              kSampleRate,
+              kAacPacketFrames) {}
+
+AgentAudioTrack::~AgentAudioTrack() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  encoder_weak_factory_.InvalidateWeakPtrs();
+  encoder_.reset();
+}
+
+media::AudioEncoder::Options AgentAudioTrack::EncoderOptions(
+    media::AudioCodec codec) const {
+  media::AudioEncoder::Options options;
+  options.codec = codec;
+  options.channels = kChannels;
+  options.sample_rate = kSampleRate;
+  options.bitrate = kBitrate;
+  if (codec == media::AudioCodec::kAAC) {
+    // Raw AAC: the AudioSpecificConfig goes into the file's header.
+    media::AudioEncoder::AacOptions aac;
+    aac.format = media::AudioEncoder::AacOutputFormat::AAC;
+    options.aac = aac;
+  }
+  return options;
+}
+
+void AgentAudioTrack::Start(Choice choice,
+                            mojo::PendingRemote<media::mojom::AudioEncoder> aac,
+                            StartCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kIdle) {
+    return;
+  }
+  choice_ = choice;
+  start_callback_ = std::move(callback);
+  if (choice_ != Choice::kOpus && aac.is_valid()) {
+    StartAac(std::move(aac));
+    return;
+  }
+  if (choice_ == Choice::kAac) {
+    // No GPU process, or the browser has no media service to ask.
+    state_ = State::kEnded;
+    Settle(Codec::kNone, "The AAC encoder could not start.");
+    return;
+  }
+  StartOpus();
+}
+
+void AgentAudioTrack::StartAac(
+    mojo::PendingRemote<media::mojom::AudioEncoder> aac) {
+  state_ = State::kTestingAac;
+  encoder_ = std::make_unique<media::MojoAudioEncoder>(std::move(aac));
+  // The timer is this object's, so its task never outlives it.
+  test_timer_.Start(FROM_HERE, kAacTestTimeout,
+                    base::BindOnce(&AgentAudioTrack::OnAacFailed,
+                                   base::Unretained(this)));
+  encoder_->Initialize(
+      EncoderOptions(media::AudioCodec::kAAC),
+      base::BindRepeating(&AgentAudioTrack::OnEncoderOutput,
+                          encoder_weak_factory_.GetWeakPtr()),
+      base::BindOnce(&AgentAudioTrack::OnAacInitialized,
+                     encoder_weak_factory_.GetWeakPtr()));
+}
+
+void AgentAudioTrack::OnAacInitialized(media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kTestingAac) {
+    return;
+  }
+  if (!status.is_ok()) {
+    OnAacFailed();
+    return;
+  }
+  // Silence, stamped one packet apart from 0. The flush waits for every
+  // done callback: the encoder takes a flush only once two packets' worth
+  // of input is inside it.
+  for (int i = 0; i < kAacTestBuses; ++i) {
+    std::unique_ptr<media::AudioBus> bus =
+        media::AudioBus::Create(kChannels, kAacPacketFrames);
+    bus->Zero();
+    encoder_->Encode(std::move(bus),
+                     base::TimeTicks() + FramesToTime(i * kAacPacketFrames),
+                     base::BindOnce(&AgentAudioTrack::OnAacTestEncoded,
+                                    encoder_weak_factory_.GetWeakPtr()));
+  }
+}
+
+void AgentAudioTrack::OnAacTestEncoded(media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kTestingAac) {
+    return;
+  }
+  if (!status.is_ok()) {
+    OnAacFailed();
+    return;
+  }
+  if (++aac_test_encodes_ < kAacTestBuses) {
+    return;
+  }
+  encoder_->Flush(base::BindOnce(&AgentAudioTrack::OnAacTestFlushed,
+                                 encoder_weak_factory_.GetWeakPtr()));
+}
+
+void AgentAudioTrack::OnAacTestFlushed(media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kTestingAac) {
+    return;
+  }
+  // The outputs come on the encoder's pipe before the flush's answer, so the
+  // AudioSpecificConfig is in by now if it came at all; the muxer needs it
+  // with the file's first packet.
+  if (!status.is_ok() || !aac_description_ ||
+      !AacConfigFits(*aac_description_)) {
+    OnAacFailed();
+    return;
+  }
+  test_timer_.Stop();
+  // The flush reset the encoder's clock: the recording's first input,
+  // stamped 0, starts its outputs at 0.
+  codec_ = Codec::kAac;
+  state_ = State::kRunning;
+  Settle(Codec::kAac, std::string());
+}
+
+void AgentAudioTrack::OnAacFailed() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kTestingAac) {
+    return;
+  }
+  LOG(WARNING) << "Video recording AAC encoder failed its self-test";
+  StopEncoding();
+  aac_description_.reset();
+  if (choice_ == Choice::kAac) {
+    state_ = State::kEnded;
+    Settle(Codec::kNone, "The AAC encoder could not start.");
+    return;
+  }
+  StartOpus();
+}
+
+void AgentAudioTrack::StartOpus() {
+  state_ = State::kStartingOpus;
+  encoder_ = std::make_unique<media::OffloadingAudioEncoder>(
+      std::make_unique<media::AudioOpusEncoder>());
+  encoder_->Initialize(
+      EncoderOptions(media::AudioCodec::kOpus),
+      base::BindRepeating(&AgentAudioTrack::OnEncoderOutput,
+                          encoder_weak_factory_.GetWeakPtr()),
+      base::BindOnce(&AgentAudioTrack::OnOpusInitialized,
+                     encoder_weak_factory_.GetWeakPtr()));
+}
+
+void AgentAudioTrack::OnOpusInitialized(media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kStartingOpus) {
+    return;
+  }
+  if (!status.is_ok()) {
+    LOG(WARNING) << "Video recording Opus encoder failed to start: "
+                 << static_cast<int>(status.code());
+    StopEncoding();
+    state_ = State::kEnded;
+    // No sound rather than no recording, unless Opus was named.
+    Settle(Codec::kNone, choice_ == Choice::kOpus
+                             ? "The Opus encoder could not start."
+                             : std::string());
+    return;
+  }
+  // The muxer declares 3840 samples of pre-skip; the encoder's lookahead
+  // covers 312 of them and this silence the rest, so a player that skips
+  // 3840 starts at media time 0.
+  lead_frames_ = kMuxerOpusPreSkip - kOpusLookahead;
+  codec_ = Codec::kOpus;
+  state_ = State::kRunning;
+  Settle(Codec::kOpus, std::string());
+}
+
+void AgentAudioTrack::Settle(Codec codec, const std::string& error) {
+  if (!start_callback_) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(start_callback_), codec, error));
+}
+
+void AgentAudioTrack::Add(const media::AudioBuffer& buffer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning) {
+    return;
+  }
+  // Dropped while the encoder holds a second of input; the gap becomes
+  // silence when a later buffer is placed.
+  if (in_flight_ >= kMaxBusesInFlight) {
+    return;
+  }
+  const int64_t frames = buffer.frame_count();
+  if (frames < 1 || frames > kMaxBufferFrames) {
+    return;
+  }
+  const int64_t at =
+      media::AudioTimestampHelper::TimeToFrames(buffer.timestamp(),
+                                                kSampleRate);
+  int64_t skip = 0;
+  if (!timeline_started_) {
+    // The timeline stands at 0: the whole lateness becomes silence, so the
+    // first packet starts at media time 0.
+    timeline_started_ = true;
+    if (at > 0 && !FeedSilence(at)) {
+      return;
+    }
+    if (at < 0) {
+      skip = std::min(frames, -at);
+    }
+  } else {
+    const int64_t late = at - next_sample_;
+    if (late > kToleranceFrames) {
+      if (!FeedSilence(late)) {
+        return;
+      }
+    } else if (late < -kToleranceFrames) {
+      // Already covered: the overlapping head goes.
+      skip = std::min(frames, -late);
+    }
+  }
+  if (frames - skip < kMinBusFrames) {
+    return;
+  }
+  std::unique_ptr<media::AudioBus> bus =
+      media::AudioBus::Create(kChannels, static_cast<int>(frames - skip));
+  buffer.ReadFrames(static_cast<int>(frames - skip), static_cast<int>(skip),
+                    0, bus.get());
+  Feed(std::move(bus));
+}
+
+void AgentAudioTrack::Prime() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning) {
+    return;
+  }
+  // Windows' AAC encoder gives its first packet once three packets' worth
+  // of input is in.
+  timeline_started_ = true;
+  if (next_sample_ < kMinFramesForFlush) {
+    FeedSilence(kMinFramesForFlush - next_sample_);
+  }
+}
+
+bool AgentAudioTrack::FeedSilence(int64_t frames) {
+  if (frames > kMaxSilenceFrames) {
+    Fail("the audio's time jumped by more than 10 s");
+    return false;
+  }
+  if (frames <= 0) {
+    return true;
+  }
+  // No bus under kMinBusFrames: a shorter span is raised to it (0.65 ms at
+  // most, counted on the timeline), and a short remainder goes with the bus
+  // before it.
+  frames = std::max(frames, kMinBusFrames);
+  while (frames > 0) {
+    int64_t count = std::min(frames, kSilenceBusFrames);
+    if (frames - count < kMinBusFrames) {
+      count = frames;
+    }
+    std::unique_ptr<media::AudioBus> bus =
+        media::AudioBus::Create(kChannels, static_cast<int>(count));
+    bus->Zero();
+    Feed(std::move(bus));
+    frames -= count;
+  }
+  return true;
+}
+
+void AgentAudioTrack::Feed(std::unique_ptr<media::AudioBus> bus) {
+  if (!lead_fed_) {
+    lead_fed_ = true;
+    if (lead_frames_ > 0) {
+      std::unique_ptr<media::AudioBus> lead =
+          media::AudioBus::Create(kChannels, static_cast<int>(lead_frames_));
+      lead->Zero();
+      EncodeBus(std::move(lead));
+    }
+  }
+  next_sample_ += bus->frames();
+  EncodeBus(std::move(bus));
+}
+
+void AgentAudioTrack::EncodeBus(std::unique_ptr<media::AudioBus> bus) {
+  // Both encoders stamp their outputs by counting samples from the first
+  // input's time, which is 0 here; the later stamps say the same.
+  const base::TimeTicks at = base::TimeTicks() + FramesToTime(frames_fed_);
+  frames_fed_ += bus->frames();
+  ++in_flight_;
+  encoder_->Encode(std::move(bus), at,
+                   base::BindOnce(&AgentAudioTrack::OnEncodeDone,
+                                  encoder_weak_factory_.GetWeakPtr()));
+}
+
+void AgentAudioTrack::OnEncodeDone(media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  --in_flight_;
+  if (state_ != State::kRunning && state_ != State::kFinishing) {
+    return;
+  }
+  if (!status.is_ok()) {
+    LOG(WARNING) << "Video recording audio encode failed: "
+                 << static_cast<int>(status.code());
+    // A lost GPU process comes here too, as kEncoderMojoConnectionError.
+    Fail("the encoder failed");
+    return;
+  }
+  MaybeFlush();
+}
+
+void AgentAudioTrack::OnEncoderOutput(
+    media::EncodedAudioBuffer output,
+    std::optional<media::AudioEncoder::CodecDescription> description) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ == State::kTestingAac) {
+    if (description && !description->empty()) {
+      aac_description_ = std::move(description);
+    }
+    return;
+  }
+  if (state_ != State::kRunning && state_ != State::kFinishing) {
+    return;
+  }
+  if (output.encoded_data.empty()) {
+    return;
+  }
+  // The GPU process's word is checked before it reaches the muxer, which
+  // CHECKs the parameters of the first packet.
+  if (output.params.IsValid() &&
+      (output.params.sample_rate() != kSampleRate ||
+       output.params.channels() != kChannels)) {
+    Fail("the encoder's output has another format");
+    return;
+  }
+  const base::TimeDelta timestamp = output.timestamp - base::TimeTicks();
+  // A duration in the file is the next stamp less this one, unsigned.
+  if (timestamp.is_negative() ||
+      (packets_ > 0 && timestamp <= last_timestamp_)) {
+    Fail("the encoder's output stamps do not rise");
+    return;
+  }
+  std::optional<media::AudioEncoder::CodecDescription> first_description;
+  if (packets_ == 0) {
+    if (codec_ == Codec::kAac) {
+      // The muxer CHECKs that the first AAC packet brings its
+      // AudioSpecificConfig.
+      first_description = (description && !description->empty())
+                              ? std::move(description)
+                              : aac_description_;
+      if (!first_description || !AacConfigFits(*first_description)) {
+        Fail("no usable AudioSpecificConfig");
+        return;
+      }
+    } else if (description) {
+      const int pre_skip = OpusHeadPreSkip(*description);
+      if (pre_skip >= 0 && pre_skip != kOpusLookahead) {
+        LOG(WARNING) << "Video recording Opus lookahead is " << pre_skip
+                     << ", not " << kOpusLookahead
+                     << "; the sound is off by the difference";
+      }
+      first_description = std::move(description);
+    }
+  }
+  base::TimeDelta duration = output.duration;
+  if (duration == media::kNoTimestamp || !duration.is_positive()) {
+    duration = NominalPacketDuration();
+  }
+  scoped_refptr<media::DecoderBuffer> buffer =
+      media::DecoderBuffer::FromArray(std::move(output.encoded_data));
+  buffer->set_timestamp(timestamp);
+  buffer->set_duration(duration);
+  buffer->set_is_key_frame(true);
+  ++packets_;
+  last_timestamp_ = timestamp;
+  const base::TimeDelta media_end =
+      timestamp + duration - FramesToTime(lead_frames_);
+  // Last: the service puts the packet into the muxer.
+  packet_callback_.Run(
+      media::Muxer::EncodedFrame(params_, std::move(first_description),
+                                 std::move(buffer)),
+      timestamp, media_end);
+}
+
+base::TimeDelta AgentAudioTrack::NominalPacketDuration() const {
+  return codec_ == Codec::kAac ? FramesToTime(kAacPacketFrames)
+                               : kOpusPacketDuration;
+}
+
+void AgentAudioTrack::Finish(base::TimeDelta end, base::OnceClosure done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                             std::move(done));
+    return;
+  }
+  state_ = State::kFinishing;
+  finish_done_ = std::move(done);
+  // The timer is this object's, so its task never outlives it.
+  finish_timer_.Start(FROM_HERE, kFinishTimeout,
+                      base::BindOnce(&AgentAudioTrack::OnFinishTimeout,
+                                     base::Unretained(this)));
+  // The sound runs to the video's end. A gap of more than 10 s means the
+  // capture was lost, and the sound ends where it stopped instead.
+  const int64_t short_by =
+      media::AudioTimestampHelper::TimeToFrames(end, kSampleRate) -
+      next_sample_;
+  if (short_by > 0 && short_by <= kMaxSilenceFrames) {
+    FeedSilence(short_by);
+  }
+  if (frames_fed_ < kMinFramesForFlush) {
+    FeedSilence(kMinFramesForFlush - frames_fed_);
+  }
+  MaybeFlush();
+}
+
+void AgentAudioTrack::MaybeFlush() {
+  // Flushed once every input is in, so the encoder holds them all.
+  if (state_ != State::kFinishing || flushing_ || in_flight_ > 0) {
+    return;
+  }
+  flushing_ = true;
+  encoder_->Flush(base::BindOnce(&AgentAudioTrack::OnFlushed,
+                                 encoder_weak_factory_.GetWeakPtr()));
+}
+
+void AgentAudioTrack::OnFlushed(media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kFinishing) {
+    return;
+  }
+  if (!status.is_ok()) {
+    LOG(WARNING) << "Video recording audio flush failed: "
+                 << static_cast<int>(status.code());
+  }
+  FinishDone();
+}
+
+void AgentAudioTrack::OnFinishTimeout() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kFinishing) {
+    return;
+  }
+  LOG(WARNING) << "Video recording audio flush timed out";
+  FinishDone();
+}
+
+void AgentAudioTrack::FinishDone() {
+  StopEncoding();
+  state_ = State::kEnded;
+  ended_callback_.Reset();
+  if (finish_done_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(finish_done_));
+  }
+}
+
+void AgentAudioTrack::End() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ == State::kEnded) {
+    return;
+  }
+  const bool finishing = state_ == State::kFinishing;
+  StopEncoding();
+  state_ = State::kEnded;
+  start_callback_.Reset();
+  ended_callback_.Reset();
+  if (finishing && finish_done_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(finish_done_));
+  }
+}
+
+void AgentAudioTrack::Fail(const char* reason) {
+  if (state_ == State::kEnded) {
+    return;
+  }
+  LOG(WARNING) << "Video recording audio track ended: " << reason;
+  const bool finishing = state_ == State::kFinishing;
+  StopEncoding();
+  state_ = State::kEnded;
+  if (finishing && finish_done_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(finish_done_));
+  }
+  if (ended_callback_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(ended_callback_));
+  }
+}
+
+void AgentAudioTrack::StopEncoding() {
+  test_timer_.Stop();
+  finish_timer_.Stop();
+  encoder_weak_factory_.InvalidateWeakPtrs();
+  in_flight_ = 0;
+  flushing_ = false;
+  // Deleted from a task of its own: this may run inside one of the
+  // encoder's callbacks.
+  if (encoder_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(encoder_));
+  }
+}
+
+}  // namespace content
