+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/paint/agent_redaction/agent_field_rules.h"
+
+#include "third_party/blink/renderer/core/html/forms/html_input_element.h"
+#include "third_party/blink/renderer/core/html_names.h"
+#include "third_party/blink/renderer/platform/wtf/text/atomic_string.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+// static
+bool AgentFieldRules::IsCardSecretInput(const HTMLInputElement& input) {
+  const AtomicString& autocomplete =
+      input.FastGetAttribute(html_names::kAutocompleteAttr);
+  if (autocomplete.empty()) {
+    return false;
+  }
+  for (const String& token :
+       autocomplete.GetString().SimplifyWhiteSpace().Split(' ')) {
+    if (EqualIgnoringAsciiCase(token, "cc-number") ||
+        EqualIgnoringAsciiCase(token, "cc-csc")) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace blink
