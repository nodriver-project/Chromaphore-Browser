+#include "third_party/blink/renderer/core/editing/editing_utilities.h"
+#include "third_party/blink/renderer/core/html/forms/html_input_element.h"
+#include "third_party/blink/renderer/core/html/forms/text_control_element.h"
+#include "third_party/blink/renderer/core/html/html_frame_owner_element.h"
+#include "third_party/blink/renderer/core/layout/layout_object.h"
+#include "third_party/blink/renderer/core/layout/layout_view.h"
+#include "third_party/blink/renderer/core/paint/agent_redaction/agent_field_rules.h"
+#include "third_party/blink/renderer/core/paint/agent_redaction/agent_redaction.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_map.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_set.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/heap/persistent.h"
+#include "third_party/blink/renderer/platform/wtf/std_lib_extras.h"
+
+namespace blink {
+
+namespace {
+
+using MarkSet = GCedHeapHashSet<WeakMember<const Element>>;
+using EditTimes = GCedHeapHashMap<WeakMember<const Document>, base::TimeTicks>;
+
+// Every marked element of this process. Weak: an element that is collected
+// leaves by itself.
+MarkSet& Marked() {
+  DEFINE_STATIC_LOCAL(Persistent<MarkSet>, marked,
+                      (MakeGarbageCollected<MarkSet>()));
+  return *marked;
+}
+
+// Per document, when the spread's window last opened: a mark, an edit or a
+// key event in one of its hidden roots. Weak: a document that is collected
+// leaves by itself.
+EditTimes& LastEdits() {
+  DEFINE_STATIC_LOCAL(Persistent<EditTimes>, edits,
+                      (MakeGarbageCollected<EditTimes>()));
+  return *edits;
+}
+
+bool IsCardField(const Element& element) {
+  const auto* input = DynamicTo<HTMLInputElement>(element);
+  return input && AgentFieldRules::IsCardSecretInput(*input);
+}
+
+// Whether `key` types a character. A DOM key that is a code point is not
+// enough: Backspace, Tab, Enter, Escape and Delete are code points too
+// (U+0008, U+0009, U+000D, U+001B, U+007F, ui/events/keycodes/dom/
+// dom_key_data.inc), so the control characters are left out. Arrows,
+// modifiers and the other named keys are not code points; a dead key is
+// not either, and the key that completes it is.
+bool TypesCharacter(ui::DomKey key) {
+  if (!key.IsCharacter()) {
+    return false;
+  }
+  const uint32_t character = key.ToCharacter();
+  return character >= 0x20 && !(character >= 0x7F && character < 0xA0);
+}
+
+// Opens the spread's window in `document`, from now.
+void OpenWindow(const Document& document) {
+  LastEdits().Set(&document, base::TimeTicks::Now());
+}
+
+}  // namespace
+
+// static
+AgentRedactionMarks::Outcome AgentRedactionMarks::Mark(Element& element) {
+  // A frame's content is another document: a mark on its element would hide
+  // nothing in it.
+  if (IsA<HTMLFrameOwnerElement>(element)) {
+    return Outcome::kFrame;
+  }
+  Marked().insert(&element);
+  OpenWindow(element.GetDocument());
+  // While armed, the whole document repaints, so that the element is black
+  // in the next frame whatever it is: one with no box yet, one with a
+  // descendant in the top layer, one under an ancestor whose text-clipped
+  // background was cached. Not armed, arming repaints every document.
+  if (AgentRedaction::IsArmed()) {
+    if (LayoutView* view = element.GetDocument().GetLayoutView()) {
+      view->InvalidatePaintForViewAndDescendants();
+    }
+  }
+  return Outcome::kMarked;
+}
+
+// static
+bool AgentRedactionMarks::IsHiddenRoot(const Element& element) {
+  if (IsCardField(element)) {
+    return true;
+  }
+  const MarkSet& marked = Marked();
+  return !marked.empty() && marked.Contains(&element);
+}
+
+// static
+bool AgentRedactionMarks::HidesText(const Node& node) {
+  // A card field's value, placeholder or autofill preview, inside its
+  // user-agent shadow tree; or the field itself.
+  if (const TextControlElement* control = EnclosingTextControl(&node)) {
+    if (IsCardField(*control)) {
+      return true;
+    }
+  }
+  const auto* element = DynamicTo<Element>(node);
+  if (element && IsCardField(*element)) {
+    return true;
+  }
+  const MarkSet& marked = Marked();
+  if (marked.empty()) {
+    return false;
+  }
+  // The node itself, then its flat-tree ancestors: through a text control's
+  // user-agent shadow root to the control, and on upward, so that a marked
+  // wrapper hides the field inside it.
+  const Node* at = &node;
+  if (const auto* shadow_root = DynamicTo<ShadowRoot>(node)) {
+    at = &shadow_root->host();
+  }
+  for (; at; at = FlatTreeTraversal::Parent(*at)) {
+    const auto* ancestor = DynamicTo<Element>(at);
+    if (ancestor && marked.Contains(ancestor)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// static
+void AgentRedactionMarks::DidEdit(const Element* root) {
+  // An edit a script made with execCommand opens nothing: a page could
+  // otherwise make its own hidden root (a card field) and so mark any
+  // element it then focuses.
+  if (!root || root->GetDocument().IsRunningExecCommand() ||
+      !HidesText(*root)) {
+    return;
+  }
+  OpenWindow(root->GetDocument());
+}
+
+// static
+void AgentRedactionMarks::DidKeyEvent(const Node& target, ui::DomKey key) {
+  // Enter in a password field, then the page focusing its next editor,
+  // must not black that editor: only a key that types opens the window.
+  if (TypesCharacter(key) && HidesText(target)) {
+    OpenWindow(target.GetDocument());
+  }
+}
+
+// static
+void AgentRedactionMarks::DidScriptFocus(Element& element) {
+  EditTimes& edits = LastEdits();
+  if (edits.empty()) {
+    return;
+  }
+  auto it = edits.find(&element.GetDocument());
+  if (it == edits.end() ||
+      base::TimeTicks::Now() - it->value > kSpreadWindow) {
+    return;
+  }
+  // Only an element keys can go into: a text control, or one inside an
+  // editing host. A frame element is never one. Never the body or the root
+  // element: a page could otherwise turn itself black whole in the file by
+  // making its body editable and focusing it.
+  const Document& document = element.GetDocument();
+  if (&element == document.body() || &element == document.documentElement()) {
+    return;
+  }
+  if (!IsTextControl(element) && !IsEditable(element)) {
+    return;
+  }
+  if (IsHiddenRoot(element)) {
+    return;
+  }
+  Marked().insert(&element);
+  // The element's own subtree repaints, whether or not a recording runs, so
+  // that the repaint tells a page nothing about one; while armed, it is then
+  // painted black.
+  if (LayoutObject* layout_object = element.GetLayoutObject()) {
+    layout_object->SetSubtreeShouldDoFullPaintInvalidation();
+  }
+}
+
+}  // namespace blink
