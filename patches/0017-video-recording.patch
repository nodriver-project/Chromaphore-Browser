+
+// The CDP cursor in a recorded frame. viz blends a capture overlay into a
+// frame after two even-pixel snaps (video_capture_overlay.cc,
+// CalculateBlendInformation, lines 192-206): the relative bounds go to the
+// surface's pixels with their edges moved in to even pixels
+// (ToAbsoluteBoundsForI420, lines 88-111), then into the frame's content
+// region with the edges moved out to whole pixels and in again to even ones
+// (Transform, lines 120-142). Mapped plainly, the sprite would change size by
+// 2 pixels as it moves, and be resampled each time. So the bounds are worked
+// back from the frame: the sprite on an even pixel at its own size, and even
+// surface edges that viz's arithmetic, mirrored here, maps exactly onto it.
+
+// One edge through ToAbsoluteBoundsForI420 (video_capture_overlay.cc:90-107)
+// for a span at 0: std::fma with int arguments computes in double and the
+// result is kept as a float, which is halved, rounded up for a left or top
+// edge and down for a right or bottom one, held to int16 and doubled.
+int VizSnapToSurface(float relative, int span, bool leading) {
+  const float absolute = std::fma(relative, span, 0);
+  const float half = absolute / 2.0f;
+  return base::saturated_cast<int16_t>(leading ? std::ceil(half)
+                                               : std::floor(half)) *
+         2;
+}
+
+// One edge through Transform (video_capture_overlay.cc:127-141) from a
+// surface at 0 into the content region at `origin`: the edge times viz's
+// float scale, rounded down for a left or top edge and up for a right or
+// bottom one (gfx::ScaleToEnclosingRect, ui/gfx/geometry/rect.h:313-316),
+// moved by the origin, then a left or top edge up to even and a right or
+// bottom one less its remainder by 2 (media::MinimallyShrinkRectForI420,
+// media/base/video_util.cc:515-518).
+int VizMapToFrame(int edge, float scale, int origin, bool leading) {
+  const float scaled = edge * scale;
+  const int moved =
+      (leading ? base::ClampFloor(scaled) : base::ClampCeil(scaled)) + origin;
+  return leading ? moved + (moved % 2 + 2) % 2 : moved - moved % 2;
+}
+
+// One axis of the bounds: the relative start and length that viz maps onto
+// exactly [frame_start, frame_start + size) of the frame. `source` is the
+// surface's length in pixels; `origin` and `length` are the content
+// region's in the frame. False when no even surface edges do, which happens
+// only when the region is longer than the surface (the page shrank after the
+// recording started).
+bool SnapAxis(int frame_start,
+              int size,
+              int source,
+              int origin,
+              int length,
+              float* start,
+              float* span) {
+  // viz's scale for the axis (Transform, video_capture_overlay.cc:127-130).
+  const float scale =
+      static_cast<float>(length) / static_cast<float>(source);
+  // The even surface edge nearest the ideal, then its even neighbours. At a
+  // scale of at most 1 the surface edges that land on a frame edge span at
+  // least 2 pixels, so one of them always does.
+  const auto find = [&](int target, bool leading, int* edge) {
+    const double ideal = (target - origin) / static_cast<double>(scale);
+    const int nearest = base::ClampRound(ideal / 2) * 2;
+    const int candidates[] = {nearest, nearest - 2, nearest + 2};
+    for (int candidate : candidates) {
+      if (VizMapToFrame(candidate, scale, origin, leading) == target) {
+        *edge = candidate;
+        return true;
+      }
+    }
+    return false;
+  };
+  int left = 0;
+  int right = 0;
+  if (!find(frame_start, /*leading=*/true, &left) ||
+      !find(frame_start + size, /*leading=*/false, &right) || right <= left) {
+    return false;
+  }
+  // A quarter pixel outward, so that float rounding in viz's first snap
+  // cannot carry an edge past the even pixel it is meant to round to.
+  *start = static_cast<float>((left - 0.25) / source);
+  const float end = static_cast<float>((right + 0.25) / source);
+  *span = end - *start;
+  // As viz will see them: gfx::RectF's right edge is x plus width, a float.
+  return VizSnapToSurface(*start, source, /*leading=*/true) == left &&
+         VizSnapToSurface(*start + *span, source, /*leading=*/false) == right;
+}
+
+// The sprite's start on one axis of the frame: `ideal` rounded to the
+// nearest even pixel, and held within a sprite's length of the content
+// region so that the arithmetic stays small; viz clips what is outside.
+int EvenFrameStart(double ideal, int size, int origin, int length) {
+  const double kept =
+      std::clamp(ideal, origin - size - 2.0, origin + length + 2.0);
+  return base::ClampRound(kept / 2) * 2;
+}
+
+// The hotspot of a cursor at `position` (DIPs of the tab's root view) in
+// the file, in its pixels: the content region's origin plus the position
+// scaled by the surface's `dsf` and the region's own scale.
+gfx::PointF CursorPointInFile(const gfx::PointF& position,
+                              const gfx::Size& source,
+                              float dsf,
+                              const gfx::Rect& content) {
+  const double kx = static_cast<double>(content.width()) / source.width();
+  const double ky = static_cast<double>(content.height()) / source.height();
+  return gfx::PointF(
+      static_cast<float>(content.x() + position.x() * dsf * kx),
+      static_cast<float>(content.y() + position.y() * dsf * ky));
+}
+
+// Where a cursor's sprite goes.
+struct CursorPlacement {
+  // Relative to the captured surface, for the capture overlay.
+  gfx::RectF bounds;
+  // The hotspot in the file, in its pixels.
+  gfx::PointF point;
+};
+
+// Places a `sprite_size` sprite with its hotspot at `hotspot` for a cursor
+// at `position` (DIPs of the tab's root view), on a surface of `source`
+// pixels at `dsf` pixels per DIP, in a file of `output` pixels. The sprite
+// is meant to be drawn at the file's scale, so that viz draws it pixel for
+// pixel, its hotspot within 1 pixel of its place. Empty bounds when the
+// surface has no size.
+CursorPlacement PlaceCursor(const gfx::PointF& position,
+                            const gfx::PointF& hotspot,
+                            const gfx::Size& sprite_size,
+                            const gfx::Size& source,
+                            float dsf,
+                            const gfx::Size& output) {
+  CursorPlacement placement;
+  // The region viz scales the surface into
+  // (frame_sink_video_capturer_impl.cc:603).
+  const gfx::Rect content =
+      source.IsEmpty() ? gfx::Rect()
+                       : media::ComputeLetterboxRegionForI420(
+                             gfx::Rect(output), source);
+  if (content.IsEmpty()) {
+    return placement;
+  }
+  placement.point = CursorPointInFile(position, source, dsf, content);
+  const int x = EvenFrameStart(placement.point.x() - hotspot.x(),
+                               sprite_size.width(), content.x(),
+                               content.width());
+  const int y = EvenFrameStart(placement.point.y() - hotspot.y(),
+                               sprite_size.height(), content.y(),
+                               content.height());
+  float bx = 0;
+  float by = 0;
+  float bw = 0;
+  float bh = 0;
+  if (SnapAxis(x, sprite_size.width(), source.width(), content.x(),
+               content.width(), &bx, &bw) &&
+      SnapAxis(y, sprite_size.height(), source.height(), content.y(),
+               content.height(), &by, &bh)) {
+    placement.bounds = gfx::RectF(bx, by, bw, bh);
+    return placement;
+  }
+  // No exact mapping: the plain one, which viz may draw a few pixels
+  // smaller.
+  const double kx = static_cast<double>(content.width()) / source.width();
+  const double ky = static_cast<double>(content.height()) / source.height();
+  placement.bounds = gfx::RectF(
+      static_cast<float>((x - content.x()) / kx / source.width()),
+      static_cast<float>((y - content.y()) / ky / source.height()),
+      static_cast<float>(sprite_size.width() / kx / source.width()),
+      static_cast<float>(sprite_size.height() / ky / source.height()));
+  return placement;
+}
+
+// The last redaction generation taken, and the one armed now (0 = none).
+// UI thread.
+uint32_t g_last_redaction_generation = 0;
+uint32_t g_armed_redaction_generation = 0;
+
+// The next generation: from 1, never 0 and never the media frames' stamp.
+uint32_t NextRedactionGeneration() {
+  ++g_last_redaction_generation;
+  if (g_last_redaction_generation == 0 ||
+      g_last_redaction_generation == viz::kAgentRedactionMediaFrame) {
+    g_last_redaction_generation = 1;
+  }
+  return g_last_redaction_generation;
+}
+
+// Disarms: viz and every renderer at once, since nothing is hidden any more.
+void DisarmRedaction() {
+  g_armed_redaction_generation = 0;
+  if (viz::HostFrameSinkManager* manager = GetHostFrameSinkManager()) {
+    manager->SetRequiredRedactionGeneration(0, base::DoNothing());
+  }
+  RenderProcessHostImpl::SetAgentRedaction(0);
+}
