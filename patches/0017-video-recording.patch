+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_MARKS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_MARKS_H_
+
+#include "base/time/time.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "ui/events/keycodes/dom/dom_key.h"
+
+namespace blink {
+
+class Element;
+class Node;
+
+// The elements that hide their text in a redacted video recording, and the
+// rules for them. While one runs (AgentRedaction::IsArmed()), a "hidden
+// root" is one black box of constant size, and nothing in it is drawn: no
+// text (PaintAgentRedactedText), no caret (CaretDisplayItemClient), and its
+// own border box is filled black as the last thing of its box decoration
+// (PaintAgentRedactionCover). A hidden root is a card number or security
+// code field (AgentFieldRules), or an element the app marked as holding a
+// secret (Page.agentMarkSecretField), or one a mark followed to (see
+// DidScriptFocus).
+//
+// A mark lasts as long as its element and cannot be taken back. Marks are
+// held here, in one weak set for the whole process (an element moved to
+// another document keeps its mark), and never on the element: no attribute,
+// class, style or property changes, so a page's script cannot tell a marked
+// element from another. Marks are kept whether or not a recording runs, so a
+// recording started later hides a field filled earlier, and they change
+// nothing while none runs.
+//
+// Main thread only.
+class CORE_EXPORT AgentRedactionMarks {
+  STATIC_ONLY(AgentRedactionMarks);
+
+ public:
+  // How long after a mark, an edit or a key in a hidden root of a document,
+  // a script's focus on an editable element of the same document carries the
+  // mark to it. It bounds a page's script reacting to a key; it says nothing
+  // about human input.
+  static constexpr base::TimeDelta kSpreadWindow = base::Milliseconds(250);
+
+  enum class Outcome {
+    kMarked,
+    // A frame element (HTMLFrameOwnerElement): its content is another
+    // document, which a mark here would not hide. Nothing is marked.
+    kFrame,
+  };
+
+  // Marks `element`, unless it is a frame element, and opens the spread's
+  // window in its document (a script may move focus between the app's mark
+  // and its first key). While armed, the paint of its whole document is
+  // invalidated (the next frame repaints it, the element black whatever box
+  // it has); while not, nothing more is needed, since arming repaints every
+  // document.
+  static Outcome Mark(Element& element);
+
+  // A card field, or a marked element: while armed, one black box.
+  static bool IsHiddenRoot(const Element& element);
+
+  // Whether text or a caret at `node` is hidden while armed: the enclosing
+  // text control of `node` (as EnclosingTextControl finds it: the value,
+  // the placeholder and an autofill preview alike) is a card field, or some
+  // inclusive flat-tree ancestor of `node` (the node itself, its text
+  // control, everything above) is a hidden root. No walk while nothing is
+  // marked.
+  static bool HidesText(const Node& node);
+
+  // An edit (typing, an input method's commit, a paste, a drop, a deletion)
+  // has gone into the editable region rooted at `root`: when that is inside
+  // a hidden root, and no script made it with execCommand, the spread's
+  // window opens in its document.
+  static void DidEdit(const Element* root);
+
+  // A key event (down, press or up) whose DOM key is `key` is about to be
+  // dispatched to `target`: when the key types a character (a letter, a
+  // digit, punctuation, a space; not Enter, Tab, Escape, Backspace, Delete,
+  // an arrow or a modifier) and `target` is a hidden root or inside one, the
+  // spread's window opens in its document, so that a page that hands focus
+  // on in its key or beforeinput handler, before the character lands, is
+  // followed.
+  static void DidKeyEvent(const Node& target, ui::DomKey key);
+
+  // A script is about to focus `element` (mojom::blink::FocusType::kScript):
+  // when the spread's window of its document is open and `element` is
+  // editable (a text control, or inside an editing host) and is not the
+  // document's body or root element, it is marked before it takes focus.
+  // Its subtree's paint is invalidated whether or not a recording runs, so
+  // the repaint tells a page nothing about one.
+  static void DidScriptFocus(Element& element);
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_MARKS_H_
