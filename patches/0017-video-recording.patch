+}  // namespace
+
+// ---------------------------------------------------------------------------
+// RedactionArm.
+
+// Arms redaction browser-wide while it lives: viz shows a renderer frame in
+// any copy only when it was painted under this generation, and every
+// renderer, live or born later, repaints and stamps its frames with it.
+// Viz is told first, and the renderers only once viz has stored the
+// generation (its reply), so no renderer stamps a generation viz does not
+// hold; meanwhile the renderers stamp the one before, which viz refuses in
+// every copy, whatever order a renderer hears things in.
+class AgentVideoRecorder::RedactionArm {
+ public:
+  RedactionArm() : generation_(NextRedactionGeneration()) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    g_armed_redaction_generation = generation_;
+    // Bound weakly: a reply that comes after this arm is gone does nothing.
+    base::OnceClosure tell = base::BindOnce(&RedactionArm::TellRenderers,
+                                            weak_factory_.GetWeakPtr());
+    if (viz::HostFrameSinkManager* manager = GetHostFrameSinkManager()) {
+      manager->SetRequiredRedactionGeneration(generation_, std::move(tell));
+      return;
+    }
+    std::move(tell).Run();
+  }
+  RedactionArm(const RedactionArm&) = delete;
+  RedactionArm& operator=(const RedactionArm&) = delete;
+  // Disarms, unless a later recording armed since: the recorder dies after
+  // Registry::Release, so the next one may already hold the browser.
+  ~RedactionArm() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (g_armed_redaction_generation == generation_) {
+      DisarmRedaction();
+    }
+  }
+
+ private:
+  // Viz holds the generation: every renderer is told it, live or born
+  // later, unless a later arm or a disarm came meanwhile.
+  void TellRenderers() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (g_armed_redaction_generation == generation_) {
+      RenderProcessHostImpl::SetAgentRedaction(generation_);
+    }
+  }
+
+  const uint32_t generation_;
+  base::WeakPtrFactory<RedactionArm> weak_factory_{this};
+};
