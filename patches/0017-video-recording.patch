@@ -0,0 +1,833 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/services/agent_video_encoding_service/agent_video_encoding_service_impl.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/delay_policy.h"
+#include "base/time/time.h"
+#include "content/services/agent_video_encoding_service/agent_audio_track.h"
+#include "media/base/audio_buffer.h"
+#include "media/base/audio_codecs.h"
+#include "media/base/audio_parameters.h"
+#include "media/base/bitrate.h"
+#include "media/base/decoder_buffer.h"
+#include "media/base/limits.h"
+#include "media/base/sample_format.h"
+#include "media/base/video_codecs.h"
+#include "media/base/video_frame.h"
+#include "media/media_buildflags.h"
+#include "media/mojo/common/media_type_converters.h"
+#include "media/mojo/mojom/audio_encoder.mojom.h"
+#include "media/mojo/mojom/media_types.mojom.h"
+#include "media/muxers/mp4_muxer.h"
+#include "media/muxers/mp4_muxer_delegate.h"
+#include "media/muxers/muxer.h"
+
+#if BUILDFLAG(ENABLE_OPENH264) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+#include "content/services/agent_video_encoding_service/agent_video_hardware_encoder.h"
+#include "media/formats/mp4/h26x_annex_b_to_bitstream_converter.h"
+#include "media/video/offloading_video_encoder.h"
+#include "media/video/openh264_video_encoder.h"
+#endif
+
+namespace content {
+
+namespace {
+
+namespace encoding_mojom = agent_video_encoding_service::mojom;
+
+// A tick is skipped (counted dropped) while more frames than this wait in
+// the encoder.
+constexpr int kMaxFramesBehind = 2;
+
+constexpr uint32_t kMinSide = 16;
+
+// A tick is encoded this long after it is due, so a frame still being read
+// back from the GPU reaches the tick it belongs to: captures of a 3440x1304
+// page at 60 fps took 4-21 ms.
+constexpr base::TimeDelta kFrameWait = base::Milliseconds(50);
+
+// Frames waiting for their tick. More means the ticks have fallen behind,
+// and the oldest are placed at once.
+constexpr size_t kMaxQueuedFrames = 8;
+
+// The muxer writes a fragment at the first keyframe this long after the
+// previous one; with a keyframe a second, every keyframe starts one.
+constexpr base::TimeDelta kFragmentInterval = base::Seconds(1);
+
+// Video samples wait this long for the first audio packet, and once more
+// after silence was fed to make it: the muxer writes the file's header at
+// its first fragment, with the tracks it has seen by then.
+constexpr base::TimeDelta kAudioWait = base::Seconds(1);
+
+}  // namespace
+
+AgentVideoEncodingServiceImpl::AgentVideoEncodingServiceImpl(
+    mojo::PendingReceiver<encoding_mojom::AgentVideoEncodingService> receiver)
+    : receiver_(this, std::move(receiver)) {}
+
+AgentVideoEncodingServiceImpl::~AgentVideoEncodingServiceImpl() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ticker_.Stop();
+}
+
+void AgentVideoEncodingServiceImpl::Start(
+    mojo::PendingRemote<encoding_mojom::AgentVideoEncodingServiceClient>
+        client,
+    encoding_mojom::AgentVideoEncodingOptionsPtr options,
+    mojo::PendingRemote<media::mojom::VideoEncodeAcceleratorProvider>
+        hardware,
+    mojo::PendingRemote<media::mojom::AudioEncoder> aac,
+    StartCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kIdle) {
+    receiver_.ReportBadMessage("Start called twice");
+    return;
+  }
+  // The browser checks all of these before it starts the service.
+  if (options->fps < 1 || options->fps > 60 || options->width < kMinSide ||
+      options->height < kMinSide || options->width % 2 ||
+      options->height % 2 ||
+      options->width > static_cast<uint32_t>(media::limits::kMaxDimension) ||
+      options->height > static_cast<uint32_t>(media::limits::kMaxDimension) ||
+      options->bitrate_bps == 0) {
+    receiver_.ReportBadMessage("Invalid recording options");
+    return;
+  }
+
+#if !BUILDFLAG(ENABLE_OPENH264) || !BUILDFLAG(USE_PROPRIETARY_CODECS)
+  state_ = State::kClosed;
+  std::move(callback).Run(false,
+                          "This browser was built without an H.264 encoder.",
+                          false, encoding_mojom::AgentAudioCodec::kNone);
+#else
+  // The GPU's encoder, unless the client asked for OpenH264 or the browser
+  // had none to pass.
+  const bool use_hardware =
+      options->encoder != encoding_mojom::AgentVideoEncoderChoice::kSoftware &&
+      hardware.is_valid();
+  const bool hardware_required =
+      options->encoder == encoding_mojom::AgentVideoEncoderChoice::kHardware;
+  // The client pipe is taken first and kept even when the start is refused:
+  // its closing could reach the browser before the answer does, and the
+  // browser would then report a lost encoder process instead.
+  client_.Bind(std::move(client));
+  start_callback_ = std::move(callback);
+  if (hardware_required && !use_hardware) {
+    FailStart("No hardware H.264 encoder is available.");
+    return;
+  }
+  size_ = gfx::Size(options->width, options->height);
+  fps_ = static_cast<int>(options->fps);
+  last_keyframe_tick_ = -fps_;
+
+  encoder_options_.frame_size = size_;
+  encoder_options_.framerate = fps_;
+  encoder_options_.bitrate =
+      media::Bitrate::ConstantBitrate(options->bitrate_bps);
+  encoder_options_.keyframe_interval = fps_;
+  // Quality, not Realtime: OpenH264 skips no frame (openh264_video_encoder.cc
+  // sets bEnableFrameSkip only for Realtime). The pacer drops instead.
+  encoder_options_.latency_mode = media::VideoEncoder::LatencyMode::Quality;
+  encoder_options_.content_hint = media::VideoEncoder::ContentHint::Screen;
+  encoder_options_.avc.produce_annexb = true;
+
+  state_ = State::kStarting;
+  // The audio codec is chosen while the video encoder starts; whichever
+  // settles last builds the muxer and answers (MaybeFinishStart). Neither
+  // answers from inside this method.
+  if (options->has_audio) {
+    audio_track_ = std::make_unique<AgentAudioTrack>(
+        base::BindRepeating(&AgentVideoEncodingServiceImpl::OnAudioPacket,
+                            weak_factory_.GetWeakPtr()),
+        base::BindOnce(&AgentVideoEncodingServiceImpl::OnAudioTrackEnded,
+                       weak_factory_.GetWeakPtr()));
+    audio_track_->Start(
+        options->audio_codec, std::move(aac),
+        base::BindOnce(&AgentVideoEncodingServiceImpl::OnAudioStarted,
+                       weak_factory_.GetWeakPtr()));
+  } else {
+    audio_settled_ = true;
+  }
+  if (!use_hardware) {
+    StartSoftware();
+    return;
+  }
+  // The GPU's encoder, High profile. It answers once its self-test passed or
+  // failed; OnHardwareInitialized then falls back to OpenH264, unless the
+  // client asked for the hardware encoder.
+  hardware_ = true;
+  encoder_ = std::make_unique<AgentVideoHardwareEncoder>(std::move(hardware));
+  encoder_->Initialize(
+      media::H264PROFILE_HIGH, encoder_options_, base::DoNothing(),
+      base::BindRepeating(&AgentVideoEncodingServiceImpl::OnEncoderOutput,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&AgentVideoEncodingServiceImpl::OnHardwareInitialized,
+                     weak_factory_.GetWeakPtr(), hardware_required));
+#endif
+}
+
+void AgentVideoEncodingServiceImpl::OnEncoderInitialized(
+    media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The start was answered already: the audio side failed it.
+  if (state_ != State::kStarting) {
+    return;
+  }
+  if (!status.is_ok()) {
+    const int code = static_cast<int>(status.code());
+    LOG(WARNING) << "Video recording encoder failed to start: " << code;
+    FailStart(base::StrCat({"The H.264 encoder could not start (status ",
+                            base::NumberToString(code), ")."}));
+    return;
+  }
+  OnVideoStarted();
+}
+
+void AgentVideoEncodingServiceImpl::OnVideoStarted() {
+  video_started_ = true;
+  MaybeFinishStart();
+}
+
+void AgentVideoEncodingServiceImpl::OnAudioStarted(
+    encoding_mojom::AgentAudioCodec codec,
+    const std::string& error) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The start was answered already: the video side failed it.
+  if (state_ != State::kStarting) {
+    return;
+  }
+  if (!error.empty()) {
+    FailStart(error);
+    return;
+  }
+  audio_codec_ = codec;
+  audio_settled_ = true;
+  MaybeFinishStart();
+}
+
+void AgentVideoEncodingServiceImpl::MaybeFinishStart() {
+  if (!video_started_ || !audio_settled_) {
+    return;
+  }
+  const bool has_audio =
+      audio_codec_ != encoding_mojom::AgentAudioCodec::kNone;
+  // The muxer takes one of these two at construction; without sound it is
+  // unused.
+  const media::AudioCodec audio_codec =
+      audio_codec_ == encoding_mojom::AgentAudioCodec::kOpus
+          ? media::AudioCodec::kOpus
+          : media::AudioCodec::kAAC;
+  // avc1: the parameter sets live in the avcC record only. The muxer takes
+  // Annex B from the encoder and converts each sample itself
+  // (Mp4MuxerDelegate::AddDataToVideoFragment). The profile named here
+  // matters for VP9 only; the hardware encoder's stream is High. A track is
+  // written into the header only once its first sample came, so a declared
+  // audio track that never gets one leaves a video-only file.
+  muxer_ = std::make_unique<media::Mp4Muxer>(
+      audio_codec, /*has_video=*/true, has_audio,
+      std::make_unique<media::Mp4MuxerDelegate>(
+          audio_codec, media::VideoCodec::kH264,
+          media::H264PROFILE_BASELINE, std::nullopt,
+          /*add_parameter_sets_in_bitstream=*/false,
+          base::BindRepeating(&AgentVideoEncodingServiceImpl::OnMuxerData,
+                              weak_factory_.GetWeakPtr())),
+      kFragmentInterval);
+  audio_open_ = has_audio;
+  holding_video_ = has_audio;
+  state_ = State::kRunning;
+  std::move(start_callback_).Run(true, std::string(), hardware_, audio_codec_);
+}
+
+void AgentVideoEncodingServiceImpl::FailStart(const std::string& error) {
+  state_ = State::kClosed;
+  // Nothing goes on: an encoder still starting is destroyed with its
+  // answer, and the track ends.
+  encoder_.reset();
+  hardware_ = false;
+  if (audio_track_) {
+    audio_track_->End();
+  }
+  if (start_callback_) {
+    std::move(start_callback_)
+        .Run(false, error, false, encoding_mojom::AgentAudioCodec::kNone);
+  }
+  // The client pipe stays open, so the answer is what the browser sees.
+}
+
+#if BUILDFLAG(ENABLE_OPENH264) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+void AgentVideoEncodingServiceImpl::StartSoftware() {
+  encoder_ = std::make_unique<media::OffloadingVideoEncoder>(
+      std::make_unique<media::OpenH264VideoEncoder>());
+  encoder_->Initialize(
+      media::H264PROFILE_BASELINE, encoder_options_, base::DoNothing(),
+      base::BindRepeating(&AgentVideoEncodingServiceImpl::OnEncoderOutput,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&AgentVideoEncodingServiceImpl::OnEncoderInitialized,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AgentVideoEncodingServiceImpl::OnHardwareInitialized(
+    bool required,
+    media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The start was answered already: the audio side failed it.
+  if (state_ != State::kStarting) {
+    return;
+  }
+  if (status.is_ok()) {
+    OnVideoStarted();
+    return;
+  }
+  const int code = static_cast<int>(status.code());
+  LOG(WARNING) << "Video recording hardware encoder failed to start: "
+               << code;
+  // The encoder answers from a task of its own, never from inside one of its
+  // methods, so it may go here.
+  encoder_.reset();
+  hardware_ = false;
+  if (required) {
+    FailStart(
+        base::StrCat({"The hardware H.264 encoder could not start (status ",
+                      base::NumberToString(code), ")."}));
+    return;
+  }
+  StartSoftware();
+}
+#endif
+
+void AgentVideoEncodingServiceImpl::Frame(
+    const scoped_refptr<media::VideoFrame>& frame,
+    base::TimeTicks reference_time) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if ((state_ != State::kRunning && state_ != State::kPaused) || !frame) {
+    return;
+  }
+  // The frame's timestamp is its place on the file's timeline; the browser
+  // never sends one before another. Two captures overlap while the recording
+  // moves to another tab, and a late frame of the old one never replaces a
+  // newer one.
+  const base::TimeDelta media_time = frame->timestamp();
+  if (received_serial_ && media_time < newest_media_time_) {
+    return;
+  }
+  // A frame the browser held at the previous frame's time (it never sends
+  // one before another) is stamped later than its moment, so it does not
+  // move the file's time on this process's clock.
+  if (!received_serial_ || awaiting_frame_ ||
+      media_time > newest_media_time_) {
+    media_zero_ = reference_time - media_time;
+  }
+  newest_media_time_ = media_time;
+  queued_.push_back({frame, media_time, ++received_serial_});
+  while (queued_.size() > kMaxQueuedFrames) {
+    current_ = std::move(queued_.front());
+    queued_.pop_front();
+  }
+  // The first frame, or the first after a resume, gives the file's time on
+  // this process's clock, and the ticks go on from next_tick_.
+  if (state_ == State::kRunning && (!clock_started_ || awaiting_frame_)) {
+    clock_started_ = true;
+    awaiting_frame_ = false;
+    ScheduleNextTick();
+  }
+}
+
+void AgentVideoEncodingServiceImpl::Audio(media::mojom::AudioBufferPtr buffer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Taken while paused too: a buffer captured before the pause arrives
+  // after it, and its media time places it.
+  if ((state_ != State::kRunning && state_ != State::kPaused) ||
+      !audio_track_ || !audio_open_ || !buffer) {
+    return;
+  }
+  // Only the browser's format reaches an encoder; anything else is dropped
+  // (Windows' AAC encoder CHECKs the channel count in the GPU process).
+  if (buffer->end_of_stream ||
+      buffer->sample_format != media::kSampleFormatPlanarF32 ||
+      buffer->sample_rate != AgentAudioTrack::kSampleRate ||
+      buffer->channel_count != AgentAudioTrack::kChannels ||
+      buffer->frame_count < 1 ||
+      buffer->frame_count > AgentAudioTrack::kMaxBufferFrames ||
+      buffer->timestamp.is_negative() || buffer->timestamp > base::Days(1)) {
+    return;
+  }
+  // Checks the data's size against the frames, and copies it.
+  scoped_refptr<media::AudioBuffer> audio =
+      mojo::ConvertTo<scoped_refptr<media::AudioBuffer>>(buffer);
+  if (!audio || audio->end_of_stream() ||
+      audio->channel_count() != AgentAudioTrack::kChannels ||
+      audio->frame_count() != buffer->frame_count) {
+    return;
+  }
+  audio_track_->Add(*audio);
+}
+
+void AgentVideoEncodingServiceImpl::Pause() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning) {
+    return;
+  }
+  // The ticks up to now are encoded at once: their frames' wait would end
+  // after the file's clock has stopped.
+  if (clock_started_ && !awaiting_frame_) {
+    EncodeTicks(LastTickAt(MediaTimeNow()), /*at_end=*/true);
+  }
+  state_ = State::kPaused;
+  ticker_.Stop();
+  awaiting_frame_ = true;
+}
+
+void AgentVideoEncodingServiceImpl::Resume() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kPaused) {
+    return;
+  }
+  state_ = State::kRunning;
+  force_keyframe_ = true;
+  // The ticks go on at next_tick_ when the next frame comes: its timestamp
+  // says where the file's time stands after the pause, so nothing came due
+  // while paused and nothing is dropped.
+}
+
+void AgentVideoEncodingServiceImpl::Stop() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning && state_ != State::kPaused) {
+    return;
+  }
+  // The ticks up to now are encoded at once, as at a pause.
+  if (state_ == State::kRunning && clock_started_ && !awaiting_frame_) {
+    EncodeTicks(LastTickAt(MediaTimeNow()), /*at_end=*/true);
+  }
+  state_ = State::kStopping;
+  ticker_.Stop();
+  if (frames_ == 0 && encodes_in_flight_ == 0) {
+    // The muxer builds the track from its first sample: a recording that
+    // never got to encode one still gets a playable file.
+    if (!PlaceFramesFor(next_tick_)) {
+      current_.frame = media::VideoFrame::CreateBlackFrame(size_);
+      current_.serial = ++received_serial_;
+    }
+    if (current_.frame) {
+      EncodeAt(next_tick_);
+    }
+  }
+  MaybeFlush();
+}
+
+base::TimeDelta AgentVideoEncodingServiceImpl::TickTime(int64_t tick) const {
+  // n/fps s, to the microsecond, from the start of the file.
+  return base::Microseconds(tick * base::Time::kMicrosecondsPerSecond / fps_);
+}
+
+base::TimeDelta AgentVideoEncodingServiceImpl::MediaTimeNow() const {
+  return base::TimeTicks::Now() - media_zero_;
+}
+
+int64_t AgentVideoEncodingServiceImpl::LastTickAt(
+    base::TimeDelta media_time) const {
+  if (media_time.is_negative()) {
+    return -1;
+  }
+  int64_t tick =
+      media_time.InMicroseconds() * fps_ / base::Time::kMicrosecondsPerSecond;
+  // TickTime truncates to the microsecond, so a tick can be at `media_time`
+  // where the division above falls just short of it.
+  while (TickTime(tick + 1) <= media_time) {
+    ++tick;
+  }
+  return tick;
+}
+
+void AgentVideoEncodingServiceImpl::ScheduleNextTick() {
+  ticker_.Start(FROM_HERE, media_zero_ + TickTime(next_tick_) + kFrameWait,
+                base::BindOnce(&AgentVideoEncodingServiceImpl::OnTick,
+                               base::Unretained(this)),
+                base::subtle::DelayPolicy::kPrecise);
+}
+
+void AgentVideoEncodingServiceImpl::OnTick() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning || awaiting_frame_) {
+    return;
+  }
+  // The timer fires for next_tick_, so at least that tick is due; a late
+  // wake-up makes more of them due, and none of them slows the file.
+  EncodeTicks(std::max(LastTickAt(MediaTimeNow() - kFrameWait), next_tick_),
+              /*at_end=*/false);
+  ScheduleNextTick();
+}
+
+void AgentVideoEncodingServiceImpl::EncodeTicks(int64_t last_due,
+                                                bool at_end) {
+  if (last_due < next_tick_) {
+    return;
+  }
+  if (next_tick_ == 0) {
+    // The file's time starts at its first sample, so tick 0 is never
+    // dropped: the file and the marks then agree.
+    if (PlaceFramesFor(0)) {
+      EncodeAt(0);
+    }
+    next_tick_ = 1;
+    if (last_due < 1) {
+      return;
+    }
+  }
+  // The encoder takes at most three frames in flight; when more ticks are
+  // due than that, the latest ones are encoded and the earlier ones dropped
+  // (the sample before them then lasts longer), so each picture still lands
+  // at its own time in the file.
+  // At a pause or a stop no later tick comes, so the last one due is encoded
+  // even past that limit and the file ends where the clock stopped.
+  const int64_t room = std::max<int64_t>(
+      at_end ? 1 : 0, kMaxFramesBehind + 1 - encodes_in_flight_);
+  const int64_t first = std::max(next_tick_, last_due - room + 1);
+  dropped_ += base::saturated_cast<uint32_t>(first - next_tick_);
+  for (int64_t tick = first; tick <= last_due; ++tick) {
+    if (PlaceFramesFor(tick)) {
+      EncodeAt(tick);
+    } else {
+      ++dropped_;
+    }
+  }
+  next_tick_ = last_due + 1;
+}
+
+bool AgentVideoEncodingServiceImpl::PlaceFramesFor(int64_t tick) {
+  const base::TimeDelta at = TickTime(tick);
+  while (!queued_.empty() && queued_.front().media_time <= at) {
+    current_ = std::move(queued_.front());
+    queued_.pop_front();
+  }
+  // Only tick 0 can come before every frame, and only if the browser's clock
+  // moved after the first one (which is half a sample before it): the sample
+  // then shows the earliest frame.
+  if (!current_.frame && !queued_.empty()) {
+    current_ = std::move(queued_.front());
+    queued_.pop_front();
+  }
+  return !!current_.frame;
+}
+
+void AgentVideoEncodingServiceImpl::EncodeAt(int64_t tick) {
+  // A wrapper per sample: the encoder reads the timestamp on its own thread
+  // while the next tick may stamp the same picture again.
+  scoped_refptr<media::VideoFrame> sample = media::VideoFrame::WrapVideoFrame(
+      current_.frame, current_.frame->format(), current_.frame->visible_rect(),
+      current_.frame->natural_size());
+  if (!sample) {
+    ++dropped_;
+    return;
+  }
+  if (encoded_serial_ == current_.serial) {
+    ++repeated_;
+  }
+  encoded_serial_ = current_.serial;
+  sample->set_timestamp(TickTime(tick));
+
+  bool keyframe = force_keyframe_ || tick - last_keyframe_tick_ >= fps_;
+  if (keyframe) {
+    force_keyframe_ = false;
+    last_keyframe_tick_ = tick;
+  }
+  ++encodes_in_flight_;
+  encoder_->Encode(
+      std::move(sample), media::VideoEncoder::EncodeOptions(keyframe),
+      base::BindOnce(&AgentVideoEncodingServiceImpl::OnEncodeDone,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AgentVideoEncodingServiceImpl::OnEncodeDone(media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  --encodes_in_flight_;
+  if (state_ == State::kClosed) {
+    return;
+  }
+  if (!status.is_ok()) {
+    Fail(status);
+    return;
+  }
+  MaybeFlush();
+}
+
+void AgentVideoEncodingServiceImpl::OnEncoderOutput(
+    media::VideoEncoderOutput output,
+    std::optional<media::VideoEncoder::CodecDescription> description) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ == State::kClosed || !muxer_) {
+    return;
+  }
+  if (output.data.empty()) {
+    // The encoder dropped the frame: the sample before covers its tick, as
+    // for a tick the pacer drops.
+    ++dropped_;
+    return;
+  }
+#if BUILDFLAG(ENABLE_OPENH264) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+  if (!muxed_first_sample_) {
+    // The muxer starts the track with a keyframe and its avcC record.
+    if (!output.key_frame) {
+      // The hardware encoder honoured a forced keyframe in its self-test,
+      // and skipping a sample would move the file's zero.
+      if (hardware_) {
+        Fail(media::EncoderStatus::Codes::kEncoderFailedEncode);
+      }
+      return;
+    }
+    if (description && !description->empty()) {
+      // The hardware encoder's record, checked in its self-test.
+      codec_description_ = std::move(description);
+    } else {
+      // OpenH264's, from the parameter sets in its keyframe.
+      media::H26xAnnexBToBitstreamConverter converter(
+          media::VideoCodec::kH264,
+          /*add_parameter_sets_in_bitstream=*/false);
+      converter.Convert(output.data.as_span());
+      codec_description_ = converter.GetCodecDescription();
+      if (codec_description_->empty()) {
+        Fail(media::EncoderStatus::Codes::kBitstreamConversionError);
+        return;
+      }
+    }
+  }
+#endif
+
+  const base::TimeDelta timestamp = output.timestamp;
+  const bool keyframe = output.key_frame;
+  scoped_refptr<media::DecoderBuffer> buffer =
+      media::DecoderBuffer::FromArray(std::move(output.data));
+  buffer->set_timestamp(timestamp);
+  buffer->set_is_key_frame(keyframe);
+
+  std::optional<media::VideoEncoder::CodecDescription> first_description;
+  if (!muxed_first_sample_) {
+    first_description = std::move(codec_description_);
+    codec_description_.reset();
+    muxed_first_sample_ = true;
+  }
+  media::Muxer::VideoParameters params(size_, fps_, media::VideoCodec::kH264,
+                                       output.color_space, std::nullopt);
+  PutVideo(media::Muxer::EncodedFrame(std::move(params),
+                                      std::move(first_description),
+                                      std::move(buffer)),
+           timestamp);
+  ++frames_;
+  last_sample_time_ = timestamp;
+}
+
+void AgentVideoEncodingServiceImpl::MaybeFlush() {
+  // The hardware encoder's Flush waits for the frames in flight itself and
+  // pushes them out of the hardware, so it is asked as soon as the recording
+  // stops; OpenH264 is flushed once its frames are back.
+  if (state_ != State::kStopping || flushing_ ||
+      (!hardware_ && encodes_in_flight_ > 0)) {
+    return;
+  }
+  flushing_ = true;
+  encoder_->Flush(
+      base::BindOnce(&AgentVideoEncodingServiceImpl::OnEncoderFlushed,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AgentVideoEncodingServiceImpl::OnEncoderFlushed(
+    media::EncoderStatus status) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kStopping) {
+    return;
+  }
+  if (!status.is_ok()) {
+    Fail(status);
+    return;
+  }
+  // The sound runs to where the video ends; the file closes once it is in.
+  if (audio_track_ && audio_open_) {
+    audio_track_->Finish(
+        frames_ ? last_sample_time_ + TickTime(1) : base::TimeDelta(),
+        base::BindOnce(&AgentVideoEncodingServiceImpl::OnAudioFinished,
+                       weak_factory_.GetWeakPtr()));
+    return;
+  }
+  Close();
+}
+
+void AgentVideoEncodingServiceImpl::OnAudioFinished() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kStopping) {
+    return;
+  }
+  Close();
+}
+
+void AgentVideoEncodingServiceImpl::Close() {
+  // Video still waiting for a first audio packet goes in without it.
+  EndAudio();
+  ReleaseHeldVideo();
+  // The final fragment.
+  muxer_->Flush();
+  muxer_.reset();
+  state_ = State::kClosed;
+  current_ = QueuedFrame();
+  queued_.clear();
+  if (client_.is_bound()) {
+    client_->OnClosed(MakeStats());
+    client_.reset();
+  }
+}
+
+void AgentVideoEncodingServiceImpl::OnMuxerData(
+    base::span<const uint8_t> data) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (data.empty() || !client_.is_bound()) {
+    return;
+  }
+  bytes_ += data.size();
+  client_->OnData(std::vector<uint8_t>(data.begin(), data.end()));
+}
+
+void AgentVideoEncodingServiceImpl::PutVideo(media::Muxer::EncodedFrame frame,
+                                             base::TimeDelta timestamp) {
+  if (!holding_video_) {
+    muxer_->PutFrame(std::move(frame), timestamp);
+    return;
+  }
+  held_video_.push_back({std::move(frame), timestamp});
+  // The wait runs from the first sample held.
+  if (!audio_wait_timer_.IsRunning()) {
+    // The timer is this object's, so its task never outlives it.
+    audio_wait_timer_.Start(
+        FROM_HERE, kAudioWait,
+        base::BindOnce(&AgentVideoEncodingServiceImpl::OnAudioWaitTimeout,
+                       base::Unretained(this)));
+  }
+}
+
+void AgentVideoEncodingServiceImpl::ReleaseHeldVideo() {
+  holding_video_ = false;
+  audio_wait_timer_.Stop();
+  std::vector<HeldVideo> held;
+  held.swap(held_video_);
+  if (!muxer_) {
+    return;
+  }
+  for (HeldVideo& sample : held) {
+    muxer_->PutFrame(std::move(sample.frame), sample.timestamp);
+  }
+}
+
+void AgentVideoEncodingServiceImpl::OnAudioWaitTimeout() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // No sound has come to make the first packet: the audio service may still
+  // be starting, or the recording was paused at once. Silence makes it, so
+  // the header gets its audio track and sound that comes later is placed by
+  // its time; the video waits once more, for that packet.
+  if (!audio_primed_ && audio_track_ && audio_open_) {
+    audio_primed_ = true;
+    audio_track_->Prime();
+    audio_wait_timer_.Start(
+        FROM_HERE, kAudioWait,
+        base::BindOnce(&AgentVideoEncodingServiceImpl::OnAudioWaitTimeout,
+                       base::Unretained(this)));
+    return;
+  }
+  LOG(WARNING) << "Video recording sound did not start; the file has none";
+  // No audio packet may follow the video into the first fragment: the
+  // header would have no track for it.
+  LoseAudio();
+  ReleaseHeldVideo();
+}
+
+void AgentVideoEncodingServiceImpl::OnAudioPacket(
+    media::Muxer::EncodedFrame frame,
+    base::TimeDelta timestamp,
+    base::TimeDelta media_end) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!muxer_ || !audio_open_ || state_ == State::kClosed) {
+    return;
+  }
+  muxer_->PutFrame(std::move(frame), timestamp);
+  audio_muxed_ = true;
+  audio_end_ = media_end;
+  // The header can name the audio track now: the held video goes in.
+  if (holding_video_) {
+    ReleaseHeldVideo();
+  }
+}
+
+void AgentVideoEncodingServiceImpl::OnAudioTrackEnded() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ == State::kClosed) {
+    return;
+  }
+  // The file goes on without sound from here.
+  LoseAudio();
+  if (holding_video_) {
+    ReleaseHeldVideo();
+  }
+}
+
+void AgentVideoEncodingServiceImpl::LoseAudio() {
+  const bool was_open = audio_open_;
+  EndAudio();
+  // The browser writes it down and stops sending sound.
+  if (was_open && client_.is_bound()) {
+    client_->OnAudioEnded();
+  }
+}
+
+void AgentVideoEncodingServiceImpl::EndAudio() {
+  audio_open_ = false;
+  if (audio_track_) {
+    audio_track_->End();
+  }
+}
+
+void AgentVideoEncodingServiceImpl::Fail(const media::EncoderStatus& status) {
+  LOG(WARNING) << "Video recording encoder failed: "
+               << static_cast<int>(status.code());
+  ticker_.Stop();
+  state_ = State::kClosed;
+  current_ = QueuedFrame();
+  queued_.clear();
+  // The sound ends with the video; held video goes in first, so the file
+  // keeps every sample it got.
+  EndAudio();
+  if (muxer_) {
+    ReleaseHeldVideo();
+    muxer_->Flush();
+    muxer_.reset();
+  }
+  client_.reset();
+}
+
+encoding_mojom::AgentVideoEncodingStatsPtr
+AgentVideoEncodingServiceImpl::MakeStats() const {
+  auto stats = encoding_mojom::AgentVideoEncodingStats::New();
+  stats->frames = frames_;
+  stats->repeated = repeated_;
+  stats->dropped = dropped_;
+  stats->bytes = bytes_;
+  // The last sample lasts one frame.
+  const base::TimeDelta duration =
+      frames_ ? last_sample_time_ + TickTime(1) : base::TimeDelta();
+  stats->duration_us = duration.InMicroseconds();
+  // The sound to the end of its last packet, at most the file's length.
+  stats->audio_duration_us =
+      audio_muxed_
+          ? std::clamp(audio_end_, base::TimeDelta(), duration).InMicroseconds()
+          : 0;
+  return stats;
+}
+
