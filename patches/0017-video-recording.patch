+bool BrowserHandler::IsBrowserTarget() {
+  return session() && session()->GetAgentHost()->GetType() ==
+                          DevToolsAgentHost::kTypeBrowser;
+}
+
+void BrowserHandler::StartVideoRecording(
+    const std::string& in_target_id,
+    const std::string& in_path,
+    int in_fps,
+    std::optional<int> in_width,
+    std::optional<int> in_height,
+    std::optional<int> in_bitrate_kbps,
+    std::optional<int> in_max_minutes,
+    std::optional<std::string> in_encoder,
+    std::optional<bool> in_cursor,
+    std::optional<bool> in_audio,
+    std::optional<std::string> in_audio_codec,
+    std::optional<bool> in_redact,
+    std::unique_ptr<StartVideoRecordingCallback> callback) {
+  if (!IsBrowserTarget()) {
+    callback->sendFailure(
+        Response::MethodNotFound("'Browser.startVideoRecording' wasn't found"));
+    return;
+  }
+  // browser: the flag holds the client's MayWriteLocalFiles().
+  if (!allow_set_download_behavior_) {
+    callback->sendFailure(Response::ServerError(
+        "Not allowed: this client may not write local files."));
+    return;
+  }
+  AgentVideoRecorder::Options options;
+  options.target_id = in_target_id;
+  options.path = base::FilePath::FromUTF8Unsafe(in_path);
+  options.fps = in_fps;
+  options.width = in_width;
+  options.height = in_height;
+  options.bitrate_kbps = in_bitrate_kbps;
+  options.max_minutes = in_max_minutes;
+  options.encoder = std::move(in_encoder);
+  options.cursor = in_cursor;
+  options.audio = in_audio;
+  options.audio_codec = std::move(in_audio_codec);
+  options.redact = in_redact.value_or(false);
+  AgentVideoRecorder::Registry::Get().Start(
+      this, std::move(options),
+      base::BindOnce(&BrowserHandler::OnVideoRecordingEnded,
+                     weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(
+          [](std::unique_ptr<StartVideoRecordingCallback> callback,
+             base::expected<AgentVideoRecorder::Started, Response> started) {
+            if (!started.has_value()) {
+              callback->sendFailure(started.error());
+              return;
+            }
+            callback->sendSuccess(
+                started->recording_id, started->size.width(),
+                started->size.height(), started->encoder, started->audio,
+                started->redacted, started->events_path.AsUTF8Unsafe(),
+                started->ends_at_ms);
+          },
+          std::move(callback)));
+}
+
+Response BrowserHandler::SetVideoRecordingTarget(
+    const std::string& in_recording_id,
+    const std::string& in_target_id) {
+  if (!IsBrowserTarget()) {
+    return Response::MethodNotFound(
+        "'Browser.setVideoRecordingTarget' wasn't found");
+  }
+  AgentVideoRecorder* recorder =
+      AgentVideoRecorder::Registry::Get().Find(in_recording_id);
+  if (!recorder) {
+    return NoVideoRecording(in_recording_id);
+  }
+  return recorder->SetTarget(in_target_id);
+}
