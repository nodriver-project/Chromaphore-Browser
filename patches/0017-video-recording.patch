+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_H_
+
+#include <stdint.h>
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+
+namespace blink {
+
+class Document;
+
+// The redaction generation this renderer paints under, for a redacted video
+// recording. The browser sets it in every renderer process while such a
+// recording runs (content.mojom.Renderer.SetAgentRedaction); 0 = not armed.
+//
+// A change repaints every document of every page in the process, ordinary or
+// not (popups, the validation bubble, the devtools overlay), and each local
+// root then stamps the compositor frames it painted after hearing of the
+// generation with that number (LocalFrameView::UpdateAgentRedactionStamp).
+// Viz shows a renderer frame in a redacted copy only with the current stamp,
+// so a part of a page that has not repainted is black in the recording.
+//
+// A view transition that was already running when the generation was set
+// shows pixels captured before it, and so may a transition into a new
+// document whose navigation started before that moment (it shows the old
+// document's snapshot): a document running one blocks the stamp of its local
+// root until the transition ends.
+//
+// Main thread only. No state a page can observe: the repaint is the only
+// effect. It draws what any repaint draws, except that while armed a field
+// that hides its text (AgentRedactionMarks) is one black box.
+class CORE_EXPORT AgentRedaction {
+  STATIC_ONLY(AgentRedaction);
+
+ public:
+  // The generation, 0 when not armed.
+  static uint32_t Generation();
+  static bool IsArmed() { return Generation() != 0; }
+
+  // Sets the generation. When it changes: every local frame of every page
+  // in the process is invalidated for paint, and the view transitions then
+  // running are remembered as begun before it.
+  static void Apply(uint32_t generation);
+
+  // True while `document` runs a view transition that may show pixels
+  // captured before the generation was set: one that was running then
+  // (document-scoped or element-scoped), or one into this document from a
+  // navigation that started before then.
+  static bool RunsViewTransitionFromBefore(const Document& document);
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_H_
