+// The service's status as the client may see it: printable ASCII, cut to
+// kMaxServiceStatus characters.
+std::string ServiceStatusForClient(const std::string& status) {
+  std::string out;
+  for (char c : status) {
+    if (out.size() == kMaxServiceStatus) {
+      break;
+    }
+    if (c >= 0x20 && c <= 0x7e) {
+      out.push_back(c);
+    }
+  }
+  return out;
