+
+#ifndef CONTENT_SERVICES_AGENT_VIDEO_ENCODING_SERVICE_AGENT_AUDIO_TRACK_H_
+#define CONTENT_SERVICES_AGENT_VIDEO_ENCODING_SERVICE_AGENT_AUDIO_TRACK_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/services/agent_video_encoding_service/public/mojom/agent_video_encoding_service.mojom.h"
+#include "media/base/audio_encoder.h"
+#include "media/base/audio_parameters.h"
+#include "media/base/encoder_status.h"
+#include "media/mojo/mojom/audio_encoder.mojom-forward.h"
+#include "media/muxers/muxer.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+
+namespace media {
+class AudioBuffer;
+class AudioBus;
+}  // namespace media
+
+namespace content {
+
+// The sound of one recording, in the recording service: encodes the tab's
+// audio, 48 kHz stereo at 128 kbit/s, and hands each packet to the service,
+// which owns the muxer and the order of everything put into it.
+//
+// The codec is chosen at Start: AAC through the GPU process's encoder (the
+// browser passes an AudioEncoder remote; media::MojoAudioEncoder drives it
+// from here) when it passes a self-test, else Opus in this process
+// (media::AudioOpusEncoder on a worker), else no sound, unless the client
+// named one codec, which must then start.
+//
+// The timeline: each buffer comes with its first sample's place on the
+// file's timeline. The track counts the samples it feeds the encoder from
+// media time 0, and a buffer more than 20 ms later than that count is preceded
+// by silence, one more than 20 ms earlier loses its overlapping head; nearer
+// ones are fed as they are, with no resampling. The first buffer's lateness
+// is all silence, so the first packet starts at media time 0, which the muxer
+// takes as the track's zero (it writes no edit list). Both encoders stamp
+// their output by counting samples from the first input, which is stamped 0.
+// Opus gets 3840 - 312 samples of silence first and uncounted, because the
+// muxer declares a fixed pre-skip of 3840 samples (80 ms) and the encoder's
+// own lookahead is 312; AAC needs none (measured: Windows' encoder and a
+// decoder return each sample at its own index).
+//
+// A failure after the start ends the track, never the recording: no packet
+// follows, the service is told once, and Finish answers at once.
+//
+// Lives on the service's sequence; every callback it runs is posted or comes
+// from an encoder callback, never from inside one of its own methods.
+class AgentAudioTrack {
+ public:
+  using Codec = agent_video_encoding_service::mojom::AgentAudioCodec;
+  using Choice = agent_video_encoding_service::mojom::AgentAudioCodecChoice;
+  // `codec` is kNone with an empty `error` when no codec started under
+  // kAuto; a non-empty `error` means the named codec did not start.
+  using StartCallback =
+      base::OnceCallback<void(Codec codec, const std::string& error)>;
+  // One packet for the muxer: `frame` carries the stream's parameters, the
+  // codec description with the first packet only, and the data; `timestamp`
+  // is its place on the track, rising strictly; `media_end` is where it ends
+  // on the file's timeline.
+  using PacketCallback =
+      base::RepeatingCallback<void(media::Muxer::EncodedFrame frame,
+                                   base::TimeDelta timestamp,
+                                   base::TimeDelta media_end)>;
+
+  static constexpr int kSampleRate = 48000;
+  static constexpr int kChannels = 2;
+  // The longest buffer Add takes: a second.
+  static constexpr int kMaxBufferFrames = kSampleRate;
+
+  // `ended_callback` runs (posted) when the track ends on its own after the
+  // start; never posted after End, and after Finish only beside its `done`.
+  AgentAudioTrack(PacketCallback packet_callback,
+                  base::OnceClosure ended_callback);
+  AgentAudioTrack(const AgentAudioTrack&) = delete;
+  AgentAudioTrack& operator=(const AgentAudioTrack&) = delete;
+  ~AgentAudioTrack();
+
+  // Chooses and starts the codec; `callback` is posted once it is settled.
+  // `aac` may be unbound.
+  void Start(Choice choice,
+             mojo::PendingRemote<media::mojom::AudioEncoder> aac,
+             StartCallback callback);
+
+  // A buffer of 48 kHz stereo samples, 1 to kMaxBufferFrames of them, whose
+  // timestamp is its first sample's place on the file's timeline. The caller
+  // checked the format. Ignored unless the track runs; dropped while the
+  // encoder holds a second of input.
+  void Add(const media::AudioBuffer& buffer);
+
+  // Makes the track's first packet from silence when no sound has come to
+  // make it: the timeline starts at 0 with three packets' worth, and sound
+  // that comes later is placed by its time as ever.
+  void Prime();
+
+  // Ends the track at `end`, the video's end on the file's timeline: feeds
+  // silence up to it, flushes the encoder and posts `done` once the last
+  // packet is out, or after 3 s. Posts `done` at once when the track has
+  // already ended.
+  void Finish(base::TimeDelta end, base::OnceClosure done);
+
+  // Ends the track now: no packet follows, and no callback but a waiting
+  // Finish's `done` runs.
+  void End();
+
+ private:
+  enum class State {
+    kIdle,
+    // AAC's self-test: Initialize, four packets' worth of silence, Flush.
+    kTestingAac,
+    kStartingOpus,
+    kRunning,
+    // Finish: the last input is in; waiting for the flush.
+    kFinishing,
+    kEnded,
+  };
+
+  media::AudioEncoder::Options EncoderOptions(media::AudioCodec codec) const;
+
+  void StartAac(mojo::PendingRemote<media::mojom::AudioEncoder> aac);
+  void OnAacInitialized(media::EncoderStatus status);
+  void OnAacTestEncoded(media::EncoderStatus status);
+  void OnAacTestFlushed(media::EncoderStatus status);
+  // The self-test failed or ran out of time: Opus next, unless AAC was
+  // named.
+  void OnAacFailed();
+  void StartOpus();
+  void OnOpusInitialized(media::EncoderStatus status);
+  // Posts the start's answer.
+  void Settle(Codec codec, const std::string& error);
+
+  // Feeds `frames` of silence, counted on the timeline; false, with the
+  // track ended, when that is more than 10 s.
+  bool FeedSilence(int64_t frames);
+  // Feeds `bus`, counted on the timeline; the Opus lead goes first.
+  void Feed(std::unique_ptr<media::AudioBus> bus);
+  // Hands `bus` to the encoder, stamped by the samples fed before it.
+  void EncodeBus(std::unique_ptr<media::AudioBus> bus);
+  void OnEncodeDone(media::EncoderStatus status);
+  void OnEncoderOutput(
+      media::EncodedAudioBuffer output,
+      std::optional<media::AudioEncoder::CodecDescription> description);
+  // A packet's length when the encoder gives none.
+  base::TimeDelta NominalPacketDuration() const;
+
+  void MaybeFlush();
+  void OnFlushed(media::EncoderStatus status);
+  void OnFinishTimeout();
+  // The flush ended, or its time ran out: the track is done.
+  void FinishDone();
+
+  // Ends the track after a failure: logs `reason`, drops the encoder and
+  // tells the service (or answers a waiting Finish).
+  void Fail(const char* reason);
+  // Stops the timers and drops the encoder; none of its callbacks reaches
+  // this object after.
+  void StopEncoding();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  PacketCallback packet_callback_;
+  base::OnceClosure ended_callback_;
+  StartCallback start_callback_;
+  base::OnceClosure finish_done_;
+
+  State state_ = State::kIdle;
+  Choice choice_ = Choice::kAuto;
+  Codec codec_ = Codec::kNone;
+  // Every packet's parameters: the muxer reads the rate and the channels.
+  const media::AudioParameters params_;
+
+  std::unique_ptr<media::AudioEncoder> encoder_;
+  // The AudioSpecificConfig from the self-test: the encoder sends it with
+  // its first output only, which a flush does not repeat.
+  std::optional<media::AudioEncoder::CodecDescription> aac_description_;
+  int aac_test_encodes_ = 0;
+
+  // Samples fed on the file's timeline since media time 0.
+  int64_t next_sample_ = 0;
+  // Every sample fed, the Opus lead included.
+  int64_t frames_fed_ = 0;
+  // Uncounted silence fed before everything else (Opus only).
+  int64_t lead_frames_ = 0;
+  bool lead_fed_ = false;
+  // A buffer has been placed: before the first, the timeline stands at 0.
+  bool timeline_started_ = false;
+  // Encodes whose done callback has not run.
+  int in_flight_ = 0;
+  bool flushing_ = false;
+
+  int64_t packets_ = 0;
+  base::TimeDelta last_timestamp_;
+
+  base::OneShotTimer test_timer_;
+  base::OneShotTimer finish_timer_;
+
+  // For the encoder's callbacks only; invalidated when the encoder goes.
+  base::WeakPtrFactory<AgentAudioTrack> encoder_weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_SERVICES_AGENT_VIDEO_ENCODING_SERVICE_AGENT_AUDIO_TRACK_H_
