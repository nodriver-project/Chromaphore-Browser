+class AgentAudioTrack;
+
+// browser: encodes one recording, in a sandboxed utility process. A pacer on
+// this sequence encodes a sample on every tick of a 1/fps clock, so the file
+// holds exactly that rate. The browser keeps the file's clock: each frame
+// comes with its place on the file's timeline as its timestamp, and a tick
+// shows the newest frame at or before it, so a GPU readback that runs late
+// does not cost a frame its tick. A still page repeats its last frame, and a
+// tick the encoder cannot take lengthens the sample before it. Sample n is
+// stamped n/fps s (to the microsecond); the muxer truncates each sample's
+// duration to whole 1/(fps*1000) s units, and each fragment's tfdt comes
+// from the stamps, so the file's time keeps to the browser's clock even
+// where single durations read one unit short.
+// Start picks one encoder for the whole file: the GPU process's H.264
+// encoder (AgentVideoHardwareEncoder, High profile) when the browser passes
+// its provider and it passes a self-test, else OpenH264 (Baseline) on a
+// worker through OffloadingVideoEncoder. Either way a keyframe comes every
+// second; Mp4Muxer cuts a fragment at each of them and every byte it writes
+// goes straight to the client, so a file cut short plays up to its last
+// complete fragment.
+//
+// The tab's sound, when the browser asks for it, is a second track in the
+// same file (AgentAudioTrack: AAC through the GPU process's encoder, else
+// Opus), chosen while the video encoder starts; the muxer is built once both
+// are settled. The muxer writes the file's header at its first fragment with
+// the tracks it has seen, so the video waits until the first audio packet
+// is in: a second for sound to come, then, with silence fed to make the
+// packet, a second more; a track that gives none by then is ended and the
+// file has no sound. A failure of the sound ends the sound, never the file,
+// and the client is told.
+class CONTENT_EXPORT AgentVideoEncodingServiceImpl
+    : public agent_video_encoding_service::mojom::AgentVideoEncodingService {
+ public:
+  explicit AgentVideoEncodingServiceImpl(
+      mojo::PendingReceiver<
+          agent_video_encoding_service::mojom::AgentVideoEncodingService>
+          receiver);
+  AgentVideoEncodingServiceImpl(const AgentVideoEncodingServiceImpl&) = delete;
+  AgentVideoEncodingServiceImpl& operator=(
+      const AgentVideoEncodingServiceImpl&) = delete;
+  ~AgentVideoEncodingServiceImpl() override;
+
+  // agent_video_encoding_service::mojom::AgentVideoEncodingService:
+  void Start(
+      mojo::PendingRemote<
+          agent_video_encoding_service::mojom::AgentVideoEncodingServiceClient>
+          client,
+      agent_video_encoding_service::mojom::AgentVideoEncodingOptionsPtr
+          options,
+      mojo::PendingRemote<media::mojom::VideoEncodeAcceleratorProvider>
+          hardware,
+      mojo::PendingRemote<media::mojom::AudioEncoder> aac,
+      StartCallback callback) override;
+  void Frame(const scoped_refptr<media::VideoFrame>& frame,
+             base::TimeTicks reference_time) override;
+  void Audio(media::mojom::AudioBufferPtr buffer) override;
+  void Pause() override;
+  void Resume() override;
+  void Stop() override;
+
+ private:
+  enum class State {
+    kIdle,
+    kStarting,
+    kRunning,
+    kPaused,
+    kStopping,
+    kClosed,
+  };
+
+  // A frame received: its place on the file's timeline, and its arrival
+  // order.
+  struct QueuedFrame {
+    scoped_refptr<media::VideoFrame> frame;
+    base::TimeDelta media_time;
+    uint64_t serial = 0;
+  };
+
+  void OnEncoderInitialized(media::EncoderStatus status);
+  // Starts OpenH264, Baseline, on a worker; OnEncoderInitialized answers.
+  void StartSoftware();
+  // The hardware encoder passed its self-test, or failed to start: OpenH264
+  // then starts instead, unless the client asked for the hardware encoder
+  // (`required`).
+  void OnHardwareInitialized(bool required, media::EncoderStatus status);
+  // The two halves of the start: the video encoder runs, and the audio
+  // codec is settled (a non-empty `error`: the codec the client named did
+  // not start).
+  void OnVideoStarted();
+  void OnAudioStarted(
+      agent_video_encoding_service::mojom::AgentAudioCodec codec,
+      const std::string& error);
+  // Once both are settled: builds the muxer, whose audio codec is fixed at
+  // construction, and answers the start.
+  void MaybeFinishStart();
+  // Answers the start with `error` and leaves nothing running.
+  void FailStart(const std::string& error);
+
+  // Sample `tick` is stamped tick/fps s, to the microsecond.
+  base::TimeDelta TickTime(int64_t tick) const;
+  // The file's time now, from the latest frame's reference time.
+  base::TimeDelta MediaTimeNow() const;
+  // The last tick at or before `media_time`; -1 when none is.
+  int64_t LastTickAt(base::TimeDelta media_time) const;
+  // Arms the timer for next_tick_, a frame's wait after it is due.
+  void ScheduleNextTick();
+  void OnTick();
+  // Encodes the ticks from next_tick_ to `last_due`: tick 0 always, and the
+  // latest of the others when the encoder has no room for all. `at_end`, at
+  // a pause or a stop, encodes `last_due` even then, so the file runs to the
+  // moment the clock stopped.
+  void EncodeTicks(int64_t last_due, bool at_end);
+  // Takes the frames at or before `tick` off the queue; the newest of them
+  // becomes the current frame. False when there is no frame at all.
+  bool PlaceFramesFor(int64_t tick);
+  void EncodeAt(int64_t tick);
+  void OnEncodeDone(media::EncoderStatus status);
+  void OnEncoderOutput(
+      media::VideoEncoderOutput output,
+      std::optional<media::VideoEncoder::CodecDescription> description);
+
+  void MaybeFlush();
+  void OnEncoderFlushed(media::EncoderStatus status);
+  void OnMuxerData(base::span<const uint8_t> data);
+
+  // Puts a video sample into the muxer, or holds it while the first audio
+  // packet is awaited.
+  void PutVideo(media::Muxer::EncodedFrame frame, base::TimeDelta timestamp);
+  // Puts the held video samples, in order, and holds no more.
+  void ReleaseHeldVideo();
+  // No audio packet came within kAudioWait of the first video sample held.
+  void OnAudioWaitTimeout();
+  void OnAudioPacket(media::Muxer::EncodedFrame frame,
+                     base::TimeDelta timestamp,
+                     base::TimeDelta media_end);
+  // The track ended on its own (an encoder failure).
+  void OnAudioTrackEnded();
+  // No audio packet goes into the muxer from now on.
+  void EndAudio();
+  // EndAudio, when the sound ends before the recording: the client is told.
+  void LoseAudio();
+  // The track finished after a stop.
+  void OnAudioFinished();
+  // Flushes the muxer and tells the client the file is closed.
+  void Close();
+
+  // Ends the recording on an encoder error: the muxer gives what it holds,
+  // and the client pipe closes without OnClosed, which the browser reads as
+  // the encoder having stopped.
+  void Fail(const media::EncoderStatus& status);
+
+  agent_video_encoding_service::mojom::AgentVideoEncodingStatsPtr
+  MakeStats() const;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  mojo::Receiver<agent_video_encoding_service::mojom::AgentVideoEncodingService>
+      receiver_;
+  mojo::Remote<
+      agent_video_encoding_service::mojom::AgentVideoEncodingServiceClient>
+      client_;
+
+  State state_ = State::kIdle;
+  gfx::Size size_;
+  int fps_ = 0;
+
+  std::unique_ptr<media::VideoEncoder> encoder_;
+  // The GPU process's encoder (AgentVideoHardwareEncoder) runs, or starts.
+  bool hardware_ = false;
+  // What either encoder starts with.
+  media::VideoEncoder::Options encoder_options_;
+  std::unique_ptr<media::Muxer> muxer_;
+  // The avcC record, taken from OpenH264's first keyframe or given by the
+  // hardware encoder with its own; the muxer needs it once, with the first
+  // sample.
+  std::optional<media::VideoEncoder::CodecDescription> codec_description_;
+  bool muxed_first_sample_ = false;
+
+  // The start's answer, sent once both halves are settled.
+  StartCallback start_callback_;
+  bool video_started_ = false;
+  bool audio_settled_ = false;
+
+  // The sound: its track and codec, and whether the muxer may still take its
+  // packets.
+  std::unique_ptr<AgentAudioTrack> audio_track_;
+  agent_video_encoding_service::mojom::AgentAudioCodec audio_codec_ =
+      agent_video_encoding_service::mojom::AgentAudioCodec::kNone;
+  bool audio_open_ = false;
+  bool audio_muxed_ = false;
+  // Where the last audio packet put ends on the file's timeline.
+  base::TimeDelta audio_end_;
+  // Video samples held until the first audio packet is in the muxer.
+  struct HeldVideo {
+    media::Muxer::EncodedFrame frame;
+    base::TimeDelta timestamp;
+  };
+  bool holding_video_ = false;
+  // The wait for the first audio packet ran out once and silence was fed.
+  bool audio_primed_ = false;
+  std::vector<HeldVideo> held_video_;
+  base::OneShotTimer audio_wait_timer_;
+
+  // The pacer: a precise one-shot timer re-armed for each tick.
+  base::DeadlineTimer ticker_;
+  bool clock_started_ = false;
+  // Paused, or resumed with no frame since: the file's time after the pause
+  // comes with the next frame.
+  bool awaiting_frame_ = false;
+  // When the file's time was zero on this process's clock, from the latest
+  // frame's reference time and timestamp.
+  base::TimeTicks media_zero_;
+  int64_t next_tick_ = 0;
+  int64_t last_keyframe_tick_ = 0;
+  bool force_keyframe_ = true;
+
+  // Frames received and not yet placed on a tick, oldest first.
+  base::circular_deque<QueuedFrame> queued_;
+  // The newest frame placed so far: it fills every tick until a newer one
+  // is due.
+  QueuedFrame current_;
+  // No frame before this one on the timeline is taken: a late frame of the
+  // tab the recording left never replaces a newer one.
+  base::TimeDelta newest_media_time_;
+  uint64_t received_serial_ = 0;
+  uint64_t encoded_serial_ = 0;
+  int encodes_in_flight_ = 0;
+  bool flushing_ = false;
+
+  // Stats.
+  uint32_t frames_ = 0;
+  uint32_t repeated_ = 0;
+  uint32_t dropped_ = 0;
+  uint64_t bytes_ = 0;
+  base::TimeDelta last_sample_time_;
+
+  base::WeakPtrFactory<AgentVideoEncodingServiceImpl> weak_factory_{this};
+};
+
+}  // namespace content
+
