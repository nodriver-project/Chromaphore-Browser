--- /dev/null
+++ b/content/services/agent_video_encoding_service/public/mojom/agent_video_encoding_service.mojom
@@ -0,0 +1,149 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module agent_video_encoding_service.mojom;
+
+import "media/mojo/mojom/audio_encoder.mojom";
+import "media/mojo/mojom/media_types.mojom";
+import "media/mojo/mojom/video_encode_accelerator.mojom";
+import "mojo/public/mojom/base/time.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+
+// Which H.264 encoder a recording may use. kAuto: the GPU process's
+// hardware encoder when the browser passes one and it passes its self-test
+// at Start, else OpenH264. kHardware: the hardware encoder, or the start
+// fails. kSoftware: OpenH264.
+enum AgentVideoEncoderChoice {
+  kAuto,
+  kHardware,
+  kSoftware,
+};
+
+// Which audio codec a recording may use. kAuto: AAC through the GPU
+// process's encoder when the browser passes one and it passes a self-test
+// at Start, else Opus in the service, else no sound. kAac and kOpus: that
+// codec, or the start fails.
+enum AgentAudioCodecChoice {
+  kAuto,
+  kAac,
+  kOpus,
+};
+
+// The codec of a recording's sound; kNone: the file has none.
+enum AgentAudioCodec {
+  kNone,
+  kAac,
+  kOpus,
+};
+
+// How one recording is encoded. The browser has already checked every value:
+// `width` and `height` are even and at least 16, and `fps` is 1-60.
+// `has_audio` asks for the tab's sound, with the codec `audio_codec`.
+//
+// Sample n is stamped n/fps seconds, to the microsecond, from the first
+// frame. The muxer truncates each sample's duration to whole 1/(fps*1000) s
+// units, so a single duration can read one unit short at rates that do not
+// divide a second evenly; each fragment's tfdt comes from the stamps, so the
+// file's time stays on the wall clock, which is the browser's media clock.
+struct AgentVideoEncodingOptions {
+  uint32 width;
+  uint32 height;
+  uint32 fps;
+  uint32 bitrate_bps;
+  bool has_audio;
+  AgentVideoEncoderChoice encoder;
+  AgentAudioCodecChoice audio_codec;
+};
+
+// What the file holds once the service closed it.
+struct AgentVideoEncodingStats {
+  // Samples written.
+  uint32 frames;
+  // Of them, repeats of a frame already encoded (a still page).
+  uint32 repeated;
+  // Ticks with no sample because the encoder was more than two frames
+  // behind, or dropped the frame. The previous sample lasts longer instead.
+  uint32 dropped;
+  // Bytes handed to the client.
+  uint64 bytes;
+  // The file's length.
+  int64 duration_us;
+  // The sound's length on the file's timeline: to the end of its last
+  // packet, at most the file's length; 0 without sound.
+  int64 audio_duration_us;
+};
+
+// Implemented in the browser process.
+interface AgentVideoEncodingServiceClient {
+  // The next bytes of the MP4 file, in order: ftyp, then moov and one moof
+  // and mdat per fragment of about a second.
+  OnData(array<uint8> data);
+
+  // The file's sound ended before the recording did: its encoder failed, or
+  // no sound could be had at the start. The file goes on without it, and
+  // Audio() is ignored from now on. At most once.
+  OnAudioEnded();
+
+  // The encoder and the muxer are flushed and every byte was sent through
+  // OnData. Nothing follows.
+  OnClosed(AgentVideoEncodingStats stats);
+};
+
+// Encodes the frames of one recording to H.264 and muxes them into a
+// fragmented MP4, at a constant frame rate. The encoder is the GPU process's
+// (High profile) when the browser passes its provider and it passes a
+// self-test at Start, else OpenH264 (Baseline); one encoder runs for the
+// whole file. The tab's sound, when asked for, is a second track in the same
+// file: AAC through the GPU process's audio encoder, else Opus in this
+// process.
+//
+// Trust boundary: implemented in a sandboxed utility process, because the
+// frames are page pixels and so untrusted input to the encoder. Called by
+// the browser process; AgentVideoEncodingServiceClient is implemented there.
+// With the GPU process's encoder the frames are encoded there, as a
+// renderer's are, and this process parses each output before muxing it.
+[ServiceSandbox=sandbox.mojom.Sandbox.kUtility]
+interface AgentVideoEncodingService {
+  // Sets the encoders and the muxer up; called once, answered once both
+  // encoders are settled. `hardware` is the GPU process's encoder provider:
+  // the browser passes it unless the choice is kSoftware or there is no GPU
+  // process. `aac` is the GPU process's audio encoder: the browser passes it
+  // when `has_audio` is set, the choice is not kOpus and a GPU process runs.
+  // `ok` is false with a client-readable `error` when the video encoder, or
+  // an audio codec the client named, cannot start; nothing then runs.
+  // `hardware` in the reply says which encoder runs, for the whole file: the
+  // GPU's (true) or OpenH264 (false); `audio` is the codec of the file's
+  // sound, kNone without it.
+  Start(pending_remote<AgentVideoEncodingServiceClient> client,
+        AgentVideoEncodingOptions options,
+        pending_remote<media.mojom.VideoEncodeAcceleratorProvider>? hardware,
+        pending_remote<media.mojom.AudioEncoder>? aac)
+      => (bool ok, string error, bool hardware, AgentAudioCodec audio);
+
+  // A captured I420 frame of the recording's size. Its timestamp is its
+  // place on the file's timeline, never before the frame sent before it: the
+  // browser keeps the file's clock. The first frame's is negative, half a
+  // sample before tick 0. `reference_time` is the moment the page
+  // shows it, which ties the file's time to this process's clock. The
+  // service shows the newest frame at or before each tick of its 1/fps
+  // clock, and encodes a tick a little after it is due, so a frame still in
+  // flight reaches it.
+  Frame(media.mojom.VideoFrame frame,
+        mojo_base.mojom.TimeTicks reference_time);
+
+  // The tab's sound: 48 kHz stereo planar float, 1 to 48000 frames. Its
+  // timestamp is its first sample's place on the file's timeline, from its
+  // capture time. Buffers come in capture order; the service fills gaps with
+  // silence and drops overlaps. Ignored without an audio track, while
+  // stopping, and in any other format.
+  Audio(media.mojom.AudioBuffer buffer);
+
+  // Stops the clock; the file's time holds. Resume restarts it, continues
+  // the sample count and starts the next sample with a keyframe.
+  Pause();
+  Resume();
+
+  // Flushes the encoder and the muxer, sends the last bytes, then OnClosed.
+  Stop();
+};
