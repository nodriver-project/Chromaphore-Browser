+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_PAINTER_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_PAINTER_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace gfx {
+class Rect;
+}  // namespace gfx
+
+namespace blink {
+
+class DisplayItemClient;
+class InlineCursor;
+class PhysicalBoxFragment;
+struct PaintInfo;
+struct PhysicalRect;
+struct TextFragmentPaintInfo;
+
+// While a redacted video recording runs (AgentRedaction::IsArmed()), a
+// hidden root (AgentRedactionMarks) is one black box of constant size and
+// nothing in it is drawn. These two paint it.
+//
+// Neither paints for a canvas's children painted for drawElementImage
+// (PaintInfo::IsPrivacyPreserving()): a page can read a canvas back, and a
+// black field there would tell it that this browser hides fields; what a
+// canvas shows is canvas content.
+
+// The text item at `cursor`: when its text is hidden
+// (AgentRedactionMarks::HidesText of its node), nothing of it is drawn, not
+// even a rect that would follow its length; the two reports
+// TextPainter::Paint makes for drawn text are made (`visual_rect` is the
+// item's ink overflow), so First and Largest Contentful Paint are as they
+// would be. True when the item is hidden, and the caller then draws nothing
+// of it.
+CORE_EXPORT bool PaintAgentRedactedText(
+    const InlineCursor& cursor,
+    const PaintInfo& paint_info,
+    const TextFragmentPaintInfo& fragment_paint_info,
+    const gfx::Rect& visual_rect);
+
+// The cover of the box `fragment`, when its element is a hidden root, black,
+// auto dark mode off, as the last thing of its own box decoration in each of
+// the two passes that paint a box's background, whether or not it has any
+// decoration to paint:
+// - in the border-box pass (`in_contents_space` false), `rect` is the border
+//   box, and the cover's corners follow the border's radius (the sides the
+//   fragment includes: a box broken across fragments is square at the
+//   break);
+// - in a scroll container's contents-space pass (true), which calls it only
+//   when that pass paints a background, `rect` is the whole scrolling
+//   background rect, filled square, so the box is black at any scroll
+//   offset and its background painted there never shows.
+// Recorded under `client` (the box's in the first pass, its scrolling
+// background's in the second) as its own display item, inside
+// `visual_rect`. Its size is the box's, which nothing typed into it changes,
+// or the scrolled content's, which only the scrolling contents layer shows.
+CORE_EXPORT void PaintAgentRedactionCover(const PhysicalBoxFragment& fragment,
+                                          const PaintInfo& paint_info,
+                                          const DisplayItemClient& client,
+                                          const PhysicalRect& rect,
+                                          const gfx::Rect& visual_rect,
+                                          bool in_contents_space);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_PAINT_AGENT_REDACTION_AGENT_REDACTION_PAINTER_H_
