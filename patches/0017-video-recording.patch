+
+// browser: the browser's one video recording and the session it belongs to.
+// Lives for the browser's lifetime on the UI thread and is never destroyed:
+// at shutdown the file holds every fragment the encoder finished, since each
+// is written as it comes (on a BLOCK_SHUTDOWN sequence).
+class CONTENT_EXPORT AgentVideoRecorder::Registry {
+ public:
+  static Registry& Get();
+
+  Registry(const Registry&) = delete;
+  Registry& operator=(const Registry&) = delete;
+
+  // `owner` is the starting session's handler; `ended_callback` reports an
+  // end the client did not ask for.
+  void Start(const void* owner,
+             Options options,
+             EndedCallback ended_callback,
+             StartCallback callback);
+
+  // The recording with `recording_id`, or null.
