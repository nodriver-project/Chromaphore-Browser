+// browser: the recorder's result as the protocol has it.
+std::unique_ptr<Browser::VideoRecordingResult> ToVideoRecordingResult(
+    const AgentVideoRecorder::Result& result) {
+  auto out = Browser::VideoRecordingResult::Create()
+                 .SetPath(result.path.AsUTF8Unsafe())
+                 .SetEventsPath(result.events_path.AsUTF8Unsafe())
+                 .SetDurationMs(result.duration_ms)
+                 .SetFrames(result.frames)
+                 .SetRepeated(result.repeated)
+                 .SetDropped(result.dropped)
+                 .SetBytes(result.bytes)
+                 .SetWidth(result.size.width())
+                 .SetHeight(result.size.height())
+                 .SetFps(result.fps)
+                 .SetEncoder(result.encoder)
+                 .SetAudio(result.audio)
+                 .SetAudioDurationMs(result.audio_duration_ms)
+                 .SetRedacted(result.redacted)
+                 .SetReason(AgentVideoRecorder::ReasonName(result.reason))
+                 .Build();
+  if (result.error) {
+    out->SetError(*result.error);
+  }
+  return out;
+}
