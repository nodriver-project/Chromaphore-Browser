+
+#ifndef CONTENT_SERVICES_AGENT_VIDEO_ENCODING_SERVICE_AGENT_VIDEO_HARDWARE_ENCODER_H_
+#define CONTENT_SERVICES_AGENT_VIDEO_ENCODING_SERVICE_AGENT_VIDEO_HARDWARE_ENCODER_H_
+
+#include "media/media_buildflags.h"
+
+#if BUILDFLAG(ENABLE_OPENH264) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/containers/circular_deque.h"
+#include "base/containers/heap_array.h"
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/shared_memory_mapping.h"
+#include "base/memory/unsafe_shared_memory_region.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "media/base/encoder_status.h"
+#include "media/base/video_codecs.h"
+#include "media/base/video_encoder.h"
+#include "media/formats/mp4/h264_annex_b_to_avc_bitstream_converter.h"
+#include "media/mojo/mojom/video_encode_accelerator.mojom.h"
+#include "media/video/video_encode_accelerator.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "ui/gfx/color_space.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace media {
+class VideoFrame;
+}  // namespace media
+
+namespace content {
+
+// browser: the GPU process's H.264 encoder as a media::VideoEncoder, so the
+// recording service holds it where it would hold OpenH264. It drives a
+// media::MojoVideoEncodeAccelerator made from the provider the browser
+// passes, on the service's sequence, with I420 frames in shared memory (the
+// frames cross to the GPU process as handles, not copies).
+//
+// Initialize answers only after a self-test: two black keyframes and a frame
+// that follows them, each sent only once the one before came back, must each
+// come back at the time sent, and each keyframe must carry parameter sets
+// that parse, the same both times. That proves the encoder gives each
+// frame's output without waiting for the next, which the service's stall
+// handling and pause rely on; that a keyframe can start the file, whose
+// muxer learns the parameter sets from its first sample; and that the avcC
+// record stays the same from one keyframe to the next, as one avc1 entry
+// needs.
+//
+// Media Foundation gives one output per input, in input order, so the
+// outputs are matched to the frames in flight first in, first out. Each
+// frame's done callback runs when its output came back, which is the
+// service's back-pressure. Any failure after the start ends the recording:
+// the encoder is destroyed and every frame in flight fails with the status.
+class AgentVideoHardwareEncoder final
+    : public media::VideoEncoder,
+      public media::VideoEncodeAccelerator::Client {
+ public:
+  explicit AgentVideoHardwareEncoder(
+      mojo::PendingRemote<media::mojom::VideoEncodeAcceleratorProvider>
+          provider);
+  AgentVideoHardwareEncoder(const AgentVideoHardwareEncoder&) = delete;
+  AgentVideoHardwareEncoder& operator=(const AgentVideoHardwareEncoder&) =
+      delete;
+  ~AgentVideoHardwareEncoder() override;
+
+  // media::VideoEncoder:
+  void Initialize(media::VideoCodecProfile profile,
+                  const Options& options,
+                  EncoderInfoCB info_cb,
+                  OutputCB output_cb,
+                  EncoderStatusCB done_cb) override;
+  void Encode(scoped_refptr<media::VideoFrame> frame,
+              const EncodeOptions& encode_options,
+              EncoderStatusCB done_cb) override;
+  void ChangeOptions(const Options& options,
+                     OutputCB output_cb,
+                     EncoderStatusCB done_cb) override;
+  void Flush(EncoderStatusCB done_cb) override;
+
+  // media::VideoEncodeAccelerator::Client:
+  void RequireBitstreamBuffers(unsigned int input_count,
+                               const gfx::Size& input_coded_size,
+                               size_t output_buffer_size) override;
+  void BitstreamBufferReady(
+      int32_t bitstream_buffer_id,
+      const media::BitstreamBufferMetadata& metadata) override;
+  void NotifyErrorStatus(const media::EncoderStatus& status) override;
+  void NotifyEncoderInfoChange(const media::VideoEncoderInfo& info) override;
+
+ private:
+  enum class State {
+    kIdle,
+    // Initialized: waiting for the output buffers' size, then for the test
+    // outputs.
+    kStarting,
+    kRunning,
+    // Failed: the encoder is gone and `error_` says why.
+    kError,
+  };
+
+  // One shared memory buffer the encoder writes an output into.
+  struct OutputBuffer {
+    OutputBuffer();
+    OutputBuffer(OutputBuffer&&);
+    OutputBuffer& operator=(OutputBuffer&&);
+    ~OutputBuffer();
+
+    base::UnsafeSharedMemoryRegion region;
+    base::WritableSharedMemoryMapping mapping;
+    // Handed to the encoder and not back yet.
+    bool at_encoder = false;
+  };
+
+  // A frame sent to the encoder whose output has not come back.
+  struct EncodeInFlight {
+    EncodeInFlight();
+    EncodeInFlight(EncodeInFlight&&);
+    EncodeInFlight& operator=(EncodeInFlight&&);
+    ~EncodeInFlight();
+
+    // The caller's timestamp, and the later one the encoder got.
+    base::TimeDelta timestamp;
+    base::TimeDelta sent_timestamp;
+    gfx::ColorSpace color_space;
+    EncoderStatusCB done_cb;
+  };
+
+  // Encodes the next black test frame: two keyframes, then one that follows
+  // them.
+  void SendTestFrame();
+  // Checks one test output; sends the next test frame, or answers Initialize
+  // after the last.
+  void OnTestOutput(int32_t id,
+                    const media::BitstreamBufferMetadata& metadata);
+  void OnStartTimeout();
+  void OnOutputTimeout();
+  // (Re)starts the stall watchdog for the oldest frame in flight.
+  void ArmOutputTimer();
+
+  // Takes buffer `id` back from the encoder; false when the encoder does not
+  // hold it.
+  bool TakeBuffer(int32_t id);
+  // Hands buffer `id` to the encoder.
+  void GiveBuffer(int32_t id);
+  // A copy of the first `size` bytes of buffer `id`.
+  base::HeapArray<uint8_t> CopyPayload(int32_t id, size_t size);
+  // Parses an Annex B output with converter_, which keeps the parameter sets
+  // seen so far; false when it does not parse or holds no slice.
+  bool ParseOutput(base::span<const uint8_t> data, bool* config_changed);
+
+  // Pops the oldest frame in flight and runs output_cb_ with `output`, then
+  // the frame's done callback, then completes a waiting flush once nothing
+  // is in flight.
+  void Deliver(media::VideoEncoderOutput output,
+               std::optional<CodecDescription> description);
+
+  // Runs `done_cb` from a task of its own, never from inside the
+  // media::VideoEncoder method that took it.
+  void PostStatus(EncoderStatusCB done_cb, media::EncoderStatus status);
+
+  // Fails the start, or after it ends the recording; does nothing once
+  // failed.
+  void Fail(media::EncoderStatus status);
+  // Destroys the encoder and answers Initialize with `status`.
+  void FailStart(media::EncoderStatus status);
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  // The provider until Initialize binds it; it is then kept for as long as
+  // the encoder it made.
+  mojo::PendingRemote<media::mojom::VideoEncodeAcceleratorProvider>
+      pending_provider_;
+  mojo::Remote<media::mojom::VideoEncodeAcceleratorProvider> provider_;
+  // A media::MojoVideoEncodeAccelerator; its deleter calls Destroy(), after
+  // which no client call arrives.
+  std::unique_ptr<media::VideoEncodeAccelerator> vea_;
+
+  State state_ = State::kIdle;
+  media::EncoderStatus error_;
+  gfx::Size frame_size_;
+  uint32_t fps_ = 0;
+  // One frame at `fps_`: the test frames are stamped this far apart from 0,
+  // and every later frame goes to the encoder as many frames after its own
+  // timestamp as there were test frames.
+  base::TimeDelta frame_duration_;
+  bool flush_supported_ = false;
+
+  EncoderInfoCB info_cb_;
+  OutputCB output_cb_;
+  // Initialize's answer; posts when run.
+  EncoderStatusCB start_cb_;
+  EncoderStatusCB flush_cb_;
+
+  std::vector<OutputBuffer> buffers_;
+  base::circular_deque<EncodeInFlight> pending_;
+
+  // The self-test: outputs passed so far, and the test frame's timestamp.
+  int test_outputs_ = 0;
+  base::TimeDelta test_timestamp_;
+
+  // Checks every output the way the muxer's parser will read it. Made anew
+  // for each test keyframe and again for the recording's first output, so a
+  // keyframe is only accepted with its own parameter sets.
+  std::optional<media::H264AnnexBToAvcBitstreamConverter> converter_;
+  std::vector<uint8_t> scratch_;
+  // The avcC record from the self-test, given with every keyframe.
+  CodecDescription description_;
+
+  base::OneShotTimer start_timer_;
+  base::OneShotTimer output_timer_;
+
+  base::WeakPtrFactory<AgentVideoHardwareEncoder> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // BUILDFLAG(ENABLE_OPENH264) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+
+#endif  // CONTENT_SERVICES_AGENT_VIDEO_ENCODING_SERVICE_AGENT_VIDEO_HARDWARE_ENCODER_H_
