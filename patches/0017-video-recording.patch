+// static
+const char* AgentVideoRecorder::ReasonName(EndReason reason) {
+  switch (reason) {
+    case EndReason::kStopped:
+      return "stopped";
+    case EndReason::kTimeLimit:
+      return "timeLimit";
+    case EndReason::kTargetClosed:
+      return "targetClosed";
+    case EndReason::kSessionClosed:
+      return "sessionClosed";
+    case EndReason::kError:
+      return "error";
+  }
+  NOTREACHED();
+}
+
+// ---------------------------------------------------------------------------
+// The recorder.
+
+AgentVideoRecorder::AgentVideoRecorder(
+    const void* owner,
+    Options options,
+    EndedCallback ended_callback,
+    WebContents* target,
+    const gfx::Size& size,
+    uint32_t bitrate_bps,
+    scoped_refptr<base::SequencedTaskRunner> file_runner)
+    : owner_(owner),
+      ended_callback_(std::move(ended_callback)),
+      id_(base::Uuid::GenerateRandomV4().AsLowercaseString()),
+      path_(options.path),
+      events_path_(base::FilePath(options.path.RemoveFinalExtension().value() +
+                                  FILE_PATH_LITERAL(".events.ndjson"))),
+      fps_(options.fps),
+      time_limit_(
+          base::Minutes(options.max_minutes.value_or(kDefaultMinutes))),
+      size_(size),
+      bitrate_bps_(bitrate_bps),
+      max_bytes_(2 *
+                     ((static_cast<int64_t>(bitrate_bps) +
+                       (options.audio.value_or(true) ? kAudioBitrate : 0)) /
+                      8) *
+                     time_limit_.InSeconds() +
+                 kByteAllowance),
+      // Registry::Start refused any other value.
+      encoder_choice_(
+          ParseEncoderChoice(options.encoder).value_or(EncoderChoice::kAuto)),
+      draw_cursor_(options.cursor.value_or(true)),
+      redact_(options.redact),
+      audio_requested_(options.audio.value_or(true)),
+      // Registry::Start refused any other value.
+      audio_codec_choice_(
+          ParseAudioChoice(options.audio_codec).value_or(AudioChoice::kAuto)),
+      start_target_id_(options.target_id),
+      start_target_(target->GetWeakPtr()),
+      files_(std::move(file_runner)) {
+  // The capturer scales the page into this fixed size, letterboxed
+  // (FIXED_RESOLUTION gives it the same minimum and maximum size).
+  capture_params_.requested_format =
+      media::VideoCaptureFormat(size_, fps_, media::PIXEL_FORMAT_I420);
+  capture_params_.resolution_change_policy =
+      media::ResolutionChangePolicy::FIXED_RESOLUTION;
+  // No capture scale override (WebContentsAutoScaler): the page's own
+  // rendering is never changed for the recording. The file is at most the
+  // page's size, so there is nothing to gain from it anyway.
+  capture_params_.is_high_dpi_enabled = false;
+  limit_left_ = time_limit_;
+}
+
+AgentVideoRecorder::~AgentVideoRecorder() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  StopCaptures();
+}
+
+void AgentVideoRecorder::Begin(StartCallback callback) {
+  start_callback_ = std::move(callback);
+  // Armed first, so renderers repaint and stamp while the files open
+  // and the encoders start, and the file's first frames are not black.
+  if (redact_) {
+    redaction_arm_ = std::make_unique<RedactionArm>();
+  }
+  files_.AsyncCall(&Files::Open)
+      .WithArgs(path_, events_path_)
+      .Then(base::BindOnce(&AgentVideoRecorder::OnFilesOpened,
+                           weak_factory_.GetWeakPtr()));
+}
+
+void AgentVideoRecorder::OnFilesOpened(Files::OpenResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kOpening) {
+    return;
+  }
+  if (result.status == Files::OpenResult::Status::kExists) {
+    // A path is the client's own and no secret.
+    FailStart(protocol::Response::InvalidParams(
+        base::StrCat({"A file already exists at ",
+                      result.existing.AsUTF8Unsafe(),
+                      "; choose another path."})));
+    return;
+  }
+  if (result.status != Files::OpenResult::Status::kOk) {
+    FailStart(protocol::Response::ServerError(
+        "Could not create the video file or the folder for it."));
+    return;
+  }
+  state_ = State::kStarting;
+  service_ = ServiceProcessHost::Launch<
+      encoding_mojom::AgentVideoEncodingService>(
+      ServiceProcessHost::Options()
+          .WithDisplayName("Video Recording Encoder")
+#if BUILDFLAG(IS_MAC)
+          .WithChildFlags(ChildProcessHost::CHILD_RENDERER)
+#endif
+          .WithProcessCallback(
+              base::BindOnce(&AgentVideoRecorder::OnServiceLaunched,
+                             weak_factory_.GetWeakPtr()))
+          .Pass());
+  service_.set_disconnect_handler(base::BindOnce(
+      &AgentVideoRecorder::OnServiceGone, base::Unretained(this)));
+  // The GPU process's video encoders, for the service to try its H.264
+  // encoder; none when the client asked for software or no GPU process runs
+  // (none is started for this). The service then uses OpenH264, or refuses
+  // the start when the client asked for hardware.
+  mojo::PendingRemote<media::mojom::VideoEncodeAcceleratorProvider> hardware;
+  if (encoder_choice_ != EncoderChoice::kSoftware) {
+    GpuProcessHost* gpu = GpuProcessHost::Get(GPU_PROCESS_KIND_SANDBOXED,
+                                              /*force_create=*/false);
+    if (gpu) {
+      gpu->gpu_service()->CreateVideoEncodeAcceleratorProvider(
+          hardware.InitWithNewPipeAndPassReceiver());
+    }
+  }
+  // The GPU process's AAC encoder, for the service to try before Opus; none
+  // when the client asked for Opus or no sound, or no GPU process runs (none
+  // is started for this, and GetMediaService() would start one). No frame:
+  // the factory serves an audio encoder without one, as it does for
+  // workers (FramelessMediaInterfaceProxy).
+  mojo::PendingRemote<media::mojom::AudioEncoder> aac;
+  if (audio_requested_ && audio_codec_choice_ != AudioChoice::kOpus &&
+      GpuProcessHost::Get(GPU_PROCESS_KIND_SANDBOXED,
+                          /*force_create=*/false)) {
+    mojo::PendingRemote<media::mojom::FrameInterfaceFactory> no_frame;
+    std::ignore = no_frame.InitWithNewPipeAndPassReceiver();
+    GetMediaService().CreateInterfaceFactory(
+        media_factory_.BindNewPipeAndPassReceiver(), std::move(no_frame));
+    media_factory_->CreateAudioEncoder(aac.InitWithNewPipeAndPassReceiver());
+  }
+  service_->Start(
+      client_receiver_.BindNewPipeAndPassRemote(),
+      encoding_mojom::AgentVideoEncodingOptions::New(
+          base::checked_cast<uint32_t>(size_.width()),
+          base::checked_cast<uint32_t>(size_.height()),
+          base::checked_cast<uint32_t>(fps_), bitrate_bps_, audio_requested_,
+          encoder_choice_, audio_codec_choice_),
+      std::move(hardware), std::move(aac),
+      base::BindOnce(&AgentVideoRecorder::OnServiceStarted,
+                     weak_factory_.GetWeakPtr()));
+  start_timer_.Start(FROM_HERE, kStartTimeout,
+                     base::BindOnce(&AgentVideoRecorder::OnStartTimeout,
+                                    base::Unretained(this)));
+  client_receiver_.set_disconnect_handler(base::BindOnce(
+      &AgentVideoRecorder::OnServiceGone, base::Unretained(this)));
+}
+
+void AgentVideoRecorder::OnServiceLaunched(const base::Process& process) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  service_process_ = process.Duplicate();
+}
+
+void AgentVideoRecorder::OnStartTimeout() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kStarting) {
+    return;
+  }
+  // A service waiting on the GPU process's answer does not see its pipes
+  // close, so its process is ended here.
+  if (service_process_.IsValid()) {
+    service_process_.Terminate(RESULT_CODE_HUNG, /*wait=*/false);
+  }
+  FailStart(protocol::Response::ServerError(
+      "The encoder did not start in time."));
+}
+
+void AgentVideoRecorder::OnServiceStarted(
+    bool ok,
+    const std::string& error,
+    bool hardware,
+    encoding_mojom::AgentAudioCodec audio) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kStarting) {
+    return;
+  }
+  start_timer_.Stop();
+  if (!ok) {
+    // The browser's own words, and at most a short status from the service.
+    std::string message = "The encoder could not start.";
+    const std::string status = ServiceStatusForClient(error);
+    if (!status.empty()) {
+      base::StrAppend(&message, {" (", status, ")"});
+    }
+    FailStart(protocol::Response::ServerError(message));
+    return;
+  }
+  // One encoder runs for the whole file, and one audio codec or none.
+  encoder_name_ = hardware ? "hardware" : "software";
+  records_audio_ =
+      audio_requested_ && audio != encoding_mojom::AgentAudioCodec::kNone;
+  audio_name_ = records_audio_ ? AudioName(audio) : "none";
+  // The GPU's media interfaces serve only the AAC encoder.
+  if (!records_audio_ || audio != encoding_mojom::AgentAudioCodec::kAac) {
+    media_factory_.reset();
+  }
+  StartCapture();
+}
+
+void AgentVideoRecorder::StartCapture() {
+  WebContents* target = start_target_.get();
+  if (!target) {
+    FailStart(protocol::Response::ServerError(
+        "The page closed before the recording started."));
+    return;
+  }
+  current_ = StartCaptureOf(target, start_target_id_);
+  if (!current_) {
+    FailStart(protocol::Response::ServerError("This page cannot be captured."));
+    return;
+  }
+  state_ = State::kRunning;
+
+  const base::Time now = base::Time::Now();
+  StartLimitTimer();
+  keep_alive_timer_.Start(FROM_HERE, kKeepAliveInterval,
+                          base::BindRepeating(&AgentVideoRecorder::OnKeepAlive,
+                                              base::Unretained(this)));
+
+  base::DictValue line;
+  line.Set("type", "start");
+  line.Set("t", 0);
+  line.Set("fps", fps_);
+  line.Set("width", size_.width());
+  line.Set("height", size_.height());
+  line.Set("encoder", encoder_name_);
+  line.Set("cursor", draw_cursor_);
+  line.Set("audio", audio_name_);
+  line.Set("redacted", redact_);
+  line.Set("targetId", start_target_id_);
+  shown_target_id_ = start_target_id_;
+  // A page's address can hold a secret (a reset link, a token), and nothing
+  // in the browser can tell one: a redacted recording names none.
+  if (!redact_) {
+    line.Set("url", target->GetLastCommittedURL().spec());
+  }
+  line.Set("startedAt", now.InMillisecondsFSinceUnixEpochIgnoringNull());
+  WriteEvent(std::move(line));
+
+  Started started;
+  started.recording_id = id_;
+  started.size = size_;
+  started.encoder = encoder_name_;
+  started.audio = audio_name_;
+  started.redacted = redact_;
+  started.events_path = events_path_;
+  started.ends_at_ms =
+      (now + time_limit_).InMillisecondsFSinceUnixEpochIgnoringNull();
+  std::move(start_callback_).Run(std::move(started));
+}
+
+void AgentVideoRecorder::FailStart(protocol::Response response) {
+  DCHECK(state_ == State::kOpening || state_ == State::kStarting);
+  StartCallback callback = std::move(start_callback_);
+  Abandon();
+  if (callback) {
+    std::move(callback).Run(base::unexpected(std::move(response)));
+  }
+}
+
+void AgentVideoRecorder::Abandon() {
+  state_ = State::kDone;
+  start_timer_.Stop();
+  start_callback_.Reset();
+  StopCaptures();
+  client_receiver_.reset();
+  service_.reset();
+  files_.AsyncCall(&Files::Discard);
+  Registry::Get().Release(this);
+}
+
+std::unique_ptr<AgentVideoRecorder::Capture>
+AgentVideoRecorder::StartCaptureOf(WebContents* target,
+                                   const std::string& target_id) {
+  auto capture = std::make_unique<Capture>(this, target, target_id,
+                                           next_capture_serial_++);
+  if (!capture->Start(capture_params_,
+                      /*suspended=*/state_ == State::kPaused)) {
+    return nullptr;
+  }
+  capture->RequestRefresh();
+  return capture;
+}
+
+void AgentVideoRecorder::OnCaptureFrame(Capture* capture,
+                                        scoped_refptr<media::VideoFrame> frame,
+                                        base::TimeTicks reference_time) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Frames that arrive while paused (already in flight) are not used: the
+  // file's clock is stopped.
+  if (state_ != State::kRunning) {
+    return;
+  }
+  if (pending_ && capture == pending_.get()) {
+    PromotePending();
+  }
+  if (capture != current_.get()) {
+    return;
+  }
+  // The file's clock is kept here, and each frame goes to the service with
+  // its place on it as its timestamp: the service puts frames on its ticks by
+  // that place, not by when they arrive, since a GPU readback can take 4-21
+  // ms on a large page. The clock starts half a sample after the first
+  // frame's reference time, the moment the page shows it.
+  if (media_origin_.is_null()) {
+    media_origin_ = reference_time + SamplePeriod() / 2;
+  }
+  // A frame the compositor drew has its reference time on the display's
+  // frame grid, after its capture began; a refresh is captured at once, and
+  // its reference time comes first.
+  const std::optional<base::TimeTicks>& began =
+      frame->metadata().capture_begin_time;
+  if (began && reference_time > *began) {
+    AlignTicks(reference_time);
+  }
+  const base::TimeDelta media_time = std::max(
+      reference_time - media_origin_ - paused_total_, last_sent_media_time_);
+  last_sent_media_time_ = media_time;
+  frame->set_timestamp(media_time);
+  service_->Frame(std::move(frame), reference_time);
+  ++frames_taken_;
+  // The clock has its zero now: the sound held until then goes.
+  if (!pending_audio_.empty()) {
+    SendPendingAudio();
+  }
+}
+
+base::TimeDelta AgentVideoRecorder::TickTime(int64_t tick) const {
+  return base::Microseconds(tick * base::Time::kMicrosecondsPerSecond / fps_);
+}
+
+base::TimeDelta AgentVideoRecorder::SamplePeriod() const {
+  return TickTime(1);
+}
+
+void AgentVideoRecorder::AlignTicks(base::TimeTicks reference_time) {
+  // The shortest spacing between drawn frames is how often the page draws.
+  // Once it is known, and again whenever a shorter one appears, the clock
+  // moves by at most half of it so that the frames fall midway between the
+  // file's ticks: no frame then sits so close to a tick that it lands on one
+  // side or the other by chance. That holds while the file's period is a
+  // multiple of the spacing or the spacing a multiple of the period; at
+  // other rates the frames sweep across the ticks however they are placed.
+  const base::TimeTicks last = last_grid_frame_;
+  last_grid_frame_ = reference_time;
+  if (last.is_null()) {
+    return;
+  }
+  const base::TimeDelta spacing = reference_time - last;
+  if (spacing < kMinGridSpacing ||
+      (grid_spacing_.is_positive() && spacing * 10 >= grid_spacing_ * 9)) {
+    return;
+  }
+  grid_spacing_ = spacing;
+  const base::TimeDelta cell = std::min(grid_spacing_, SamplePeriod());
+  // The frame's distance past the tick before it, taken against the ticks'
+  // own grid (TickTime): a grid of whole-microsecond samples would drift
+  // from it, 40 us a second at 60 fps, and a later alignment would then
+  // land frames on the ticks again.
+  const base::TimeDelta at = reference_time - media_origin_ - paused_total_;
+  int64_t tick =
+      at.InMicroseconds() * fps_ / base::Time::kMicrosecondsPerSecond;
+  if (at.is_negative()) {
+    --tick;
+  }
+  base::TimeDelta offset = at - TickTime(tick);
+  if (cell < SamplePeriod()) {
+    offset %= cell;
+  }
+  media_origin_ += offset - cell / 2;
+}
+
+void AgentVideoRecorder::PromotePending() {
+  retarget_timer_.Stop();
+  if (!pending_) {
+    return;
+  }
+  WebContents* target = pending_->target();
+  if (!target) {
+    // The new tab went during the overlap; the recording ends when the old
+    // one is gone too.
+    DropPending();
+    if (ShowsNothing()) {
+      BeginStop(EndReason::kTargetClosed, std::nullopt);
+    }
+    return;
+  }
+  const bool returned = pending_returns_;
+  pending_returns_ = false;
+  // The tab this move leaves, for a return when the new one closes; none
+  // when it is gone.
+  if (current_ && current_->target()) {
+    previous_target_ = current_->target()->GetWeakPtr();
+    previous_target_id_ = current_->target_id();
+  } else {
+    previous_target_.reset();
+    previous_target_id_.clear();
+  }
+  if (current_) {
+    current_->Stop();
+  }
+  current_ = std::move(pending_);
+  shown_target_id_ = current_->target_id();
+  // The file's sound is the new tab's from now on.
+  current_->set_became_current_at(base::TimeTicks::Now());
+  // The new tab gets its own restart after a fatal capture error.
+  capture_restarted_ = false;
+  // And its own alignment: it may draw at another rate, or on another
+  // display's frame grid.
+  last_grid_frame_ = base::TimeTicks();
+  grid_spacing_ = base::TimeDelta();
+
+  // The line is written when the file shows the new tab, not when the move
+  // was asked for.
+  base::DictValue line;
+  line.Set("type", "target");
+  line.Set("t", MediaTimeMs());
+  line.Set("targetId", current_->target_id());
+  // As at the start: a redacted recording names no address.
+  if (!redact_) {
+    line.Set("url", target->GetLastCommittedURL().spec());
+  }
+  if (returned) {
+    line.Set("returned", true);
+  }
+  WriteEvent(std::move(line));
+  // Its sound failed during the move.
+  if (current_->audio_failed() && records_audio_) {
+    LoseAudio();
+  }
+}
+
+void AgentVideoRecorder::DropPending() {
+  retarget_timer_.Stop();
+  if (!pending_) {
+    return;
+  }
+  base::DictValue line;
+  line.Set("type", "targetFailed");
+  line.Set("targetId", pending_->target_id());
+  line.Set("t", MediaTimeMs());
+  if (pending_returns_) {
+    line.Set("returned", true);
+  }
+  WriteEvent(std::move(line));
+  pending_.reset();
+  pending_returns_ = false;
+}
+
+bool AgentVideoRecorder::ReturnToPrevious() {
+  WebContents* target = previous_target_.get();
+  const std::string target_id = previous_target_id_;
+  previous_target_.reset();
+  previous_target_id_.clear();
+  if (!target) {
+    return false;
+  }
+  pending_ = StartCaptureOf(target, target_id);
+  if (!pending_) {
+    return false;
+  }
+  // As SetTarget: the move takes effect at the tab's first frame, or after
+  // the overlap.
+  pending_returns_ = true;
+  retarget_timer_.Start(FROM_HERE, kRetargetOverlap,
+                        base::BindOnce(&AgentVideoRecorder::PromotePending,
+                                       base::Unretained(this)));
+  return true;
+}
+
+bool AgentVideoRecorder::ShowsNothing() const {
+  return !current_ || !current_->target();
+}
+
+void AgentVideoRecorder::OnCaptureLost(uint64_t serial) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning && state_ != State::kPaused) {
+    return;
+  }
+  if (pending_ && pending_->serial() == serial) {
+    // The new tab closed before the move finished; the old one goes on, or
+    // the recording ends when the old one is gone too.
+    DropPending();
+    if (ShowsNothing()) {
+      BeginStop(EndReason::kTargetClosed, std::nullopt);
+    }
+    return;
+  }
+  if (current_ && current_->serial() == serial) {
+    if (pending_ && pending_->target()) {
+      PromotePending();
+      return;
+    }
+    DropPending();
+    // Back to the tab the last move left (a sign-in popup that closed
+    // itself, say), when it is still open.
+    if (ReturnToPrevious()) {
+      return;
+    }
+    BeginStop(EndReason::kTargetClosed, std::nullopt);
+  }
+}
+
+void AgentVideoRecorder::OnCaptureError(uint64_t serial) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning && state_ != State::kPaused) {
+    return;
+  }
+  if (pending_ && pending_->serial() == serial) {
+    DropPending();
+    if (ShowsNothing()) {
+      BeginStop(EndReason::kTargetClosed, std::nullopt);
+    }
+    return;
+  }
+  if (!current_ || current_->serial() != serial) {
+    return;
+  }
+  if (pending_ && pending_->target()) {
+    PromotePending();
+    return;
+  }
+  DropPending();
+  // A capture that fails at once can race a cross-process navigation of
+  // its tab; while the tab lives, a fresh capture gets one more try.
+  WebContents* target = current_->target();
+  if (target && !capture_restarted_) {
+    capture_restarted_ = true;
+    const std::string target_id = current_->target_id();
+    current_.reset();
+    current_ = StartCaptureOf(target, target_id);
+    if (current_) {
+      return;
+    }
+  }
+  BeginStop(EndReason::kError, "The capture of the page stopped.");
+}
+
+void AgentVideoRecorder::OnKeepAlive() {
+  if (state_ != State::kRunning) {
+    return;
+  }
+  if (current_) {
+    current_->KeepAlive();
+  }
+  if (pending_) {
+    pending_->KeepAlive();
+  }
+}
+
+void AgentVideoRecorder::OnCursorClick(Capture* capture,
+                                       const gfx::PointF& point) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Only the tab the file shows, while its clock runs.
+  if (state_ != State::kRunning || capture != current_.get()) {
+    return;
+  }
+  base::DictValue line;
+  line.Set("type", "click");
+  line.Set("t", MediaTimeMs());
+  line.Set("x", base::ClampRound(point.x()));
+  line.Set("y", base::ClampRound(point.y()));
+  WriteEvent(std::move(line));
+}
+
+void AgentVideoRecorder::OnAudioCaptured(
+    Capture* capture,
+    scoped_refptr<media::AudioBuffer> buffer,
+    base::TimeTicks capture_time) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Only the tab the file shows, from the moment it does, while the file's
+  // clock may still place sound (a buffer arrives 20-40 ms after its
+  // capture, so it may come while paused).
+  if ((state_ != State::kRunning && state_ != State::kPaused) ||
+      capture != current_.get() ||
+      capture_time < capture->became_current_at()) {
+    return;
+  }
+  if (media_origin_.is_null()) {
+    pending_audio_frames_ += buffer->frame_count();
+    pending_audio_.push_back({std::move(buffer), capture_time});
+    while (pending_audio_frames_ > kMaxPendingAudioFrames) {
+      pending_audio_frames_ -= pending_audio_.front().buffer->frame_count();
+      pending_audio_.pop_front();
+    }
+    return;
+  }
+  SendAudio(std::move(buffer), capture_time);
+}
+
+void AgentVideoRecorder::SendPendingAudio() {
+  base::circular_deque<PendingAudio> pending;
+  pending.swap(pending_audio_);
+  pending_audio_frames_ = 0;
+  for (PendingAudio& audio : pending) {
+    SendAudio(std::move(audio.buffer), audio.capture_time);
+  }
+}
+
+void AgentVideoRecorder::SendAudio(scoped_refptr<media::AudioBuffer> buffer,
+                                   base::TimeTicks capture_time) {
+  // A buffer captured inside a pause is dropped. Otherwise the pause total
+  // that applied at its capture time is taken off, not the current one: the
+  // buffer arrives after its capture.
+  base::TimeDelta paused_before;
+  for (const PauseSpan& pause : pauses_) {
+    if (capture_time < pause.start) {
+      break;
+    }
+    if (pause.end.is_null() || capture_time < pause.end) {
+      return;
+    }
+    paused_before = pause.total_after;
+  }
+  // A frame's formula, with the capture time, which is when the sound plays,
+  // as a frame's reference time is when it shows. AlignTicks moves
+  // media_origin_ by up to half the page's frame spacing, and the sound
+  // follows it with no special case: the service places a buffer by its time
+  // only when it is more than 20 ms off, which such a move is not unless
+  // both the page draws and the file runs under 25 frames a second; there a
+  // move (at the start, a resume, a tab move, or when the page starts to
+  // draw faster) may cost one inserted or dropped span of sound.
+  const base::TimeDelta media_time =
+      capture_time - media_origin_ - paused_before;
+  // Before the file's first sample.
+  if (media_time.is_negative()) {
+    return;
+  }
+  buffer->set_timestamp(media_time);
+  service_->Audio(media::mojom::AudioBuffer::From(*buffer));
+}
+
+void AgentVideoRecorder::OnAudioCaptureLost(Capture* capture) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  capture->StopAudio();
+  // A tab still moving in says so when the file shows it (PromotePending).
+  if (capture == current_.get()) {
+    LoseAudio();
+  }
+}
+
+void AgentVideoRecorder::OnAudioEnded() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The service takes no more sound.
+  LoseAudio();
+}
+
+void AgentVideoRecorder::LoseAudio() {
+  // The file has no sound from here on: no capture makes any, and a tab the
+  // recording moves to later starts none.
+  records_audio_ = false;
+  pending_audio_.clear();
+  pending_audio_frames_ = 0;
+  if (current_) {
+    current_->StopAudio();
+  }
+  if (pending_) {
+    pending_->StopAudio();
+  }
+  WriteAudioLost();
+}
+
+void AgentVideoRecorder::WriteAudioLost() {
+  if (audio_lost_written_ ||
+      (state_ != State::kRunning && state_ != State::kPaused)) {
+    return;
+  }
+  audio_lost_written_ = true;
+  base::DictValue line;
+  line.Set("type", "audioLost");
+  line.Set("t", MediaTimeMs());
+  WriteEvent(std::move(line));
+}
+
+protocol::Response AgentVideoRecorder::CheckActive() const {
+  if (state_ == State::kOpening || state_ == State::kStarting) {
+    return protocol::Response::ServerError("The recording is still starting.");
+  }
+  if (state_ == State::kStopping || state_ == State::kDone) {
+    return protocol::Response::ServerError("The recording is ending.");
+  }
+  return protocol::Response::Success();
+}
+
+protocol::Response AgentVideoRecorder::SetTarget(const std::string& target_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  protocol::Response active = CheckActive();
+  if (active.IsError()) {
+    return active;
+  }
+  WebContents* target = FindPageTarget(target_id);
+  if (!target) {
+    return NoTarget(target_id);
+  }
+  // A move asked for earlier is replaced by this one, or cancelled when this
+  // one names the tab already recorded; the sidecar says it did not happen.
+  DropPending();
+  if (current_ && current_->target() == target) {
+    return protocol::Response::Success();
+  }
+  pending_ = StartCaptureOf(target, target_id);
+  if (!pending_) {
+    // The tab recorded closed and a return to the one before was under way:
+    // with no move left, nothing shows, and the recording ends.
+    if (ShowsNothing()) {
+      BeginStop(EndReason::kTargetClosed, std::nullopt);
+    }
+    return protocol::Response::ServerError("This page cannot be captured.");
+  }
+  // Success means the move began; the sidecar's target line says when it
+  // took effect, or a targetFailed line that it did not.
+  retarget_timer_.Start(FROM_HERE, kRetargetOverlap,
+                        base::BindOnce(&AgentVideoRecorder::PromotePending,
+                                       base::Unretained(this)));
+  return protocol::Response::Success();
+}
+
+protocol::Response AgentVideoRecorder::Pause(
+    const std::optional<std::string>& label,
+    double* media_time_ms) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  protocol::Response active = CheckActive();
+  if (active.IsError()) {
+    return active;
+  }
+  if (state_ == State::kPaused) {
+    return protocol::Response::ServerError("The recording is already paused.");
+  }
+  pause_started_ = base::TimeTicks::Now();
+  pauses_.push_back({pause_started_, base::TimeTicks(), paused_total_});
+  state_ = State::kPaused;
+  // Paused time does not count against the time limit.
+  StopLimitTimer();
+  if (current_) {
+    current_->Suspend();
+  }
+  if (pending_) {
+    pending_->Suspend();
+  }
+  service_->Pause();
+
+  *media_time_ms = MediaTimeMs();
+  base::DictValue line;
+  line.Set("type", "pause");
+  line.Set("t", *media_time_ms);
+  if (label) {
+    line.Set("label", *label);
+  }
+  WriteEvent(std::move(line));
+  return protocol::Response::Success();
+}
+
+protocol::Response AgentVideoRecorder::Resume(
+    const std::optional<std::string>& label,
+    double* media_time_ms) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  protocol::Response active = CheckActive();
+  if (active.IsError()) {
+    return active;
+  }
+  if (state_ != State::kPaused) {
+    return protocol::Response::ServerError("The recording is not paused.");
+  }
+  // Before the first frame the clock has not begun, so there is no paused
+  // time to take off.
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!media_origin_.is_null()) {
+    paused_total_ += now - pause_started_;
+  }
+  // The pause's span ends now; sound captured after it takes off the new
+  // total.
+  if (!pauses_.empty() && pauses_.back().end.is_null()) {
+    pauses_.back().end = now;
+    pauses_.back().total_after = paused_total_;
+  }
+  // The pause moved the file's ticks against the page's frames: they are
+  // aligned again from the next two drawn frames.
+  last_grid_frame_ = base::TimeTicks();
+  grid_spacing_ = base::TimeDelta();
+  state_ = State::kRunning;
+  StartLimitTimer();
+  service_->Resume();
+  if (current_) {
+    current_->Resume();
+  }
+  if (pending_) {
+    pending_->Resume();
+  }
+
+  *media_time_ms = MediaTimeMs();
+  base::DictValue line;
+  line.Set("type", "resume");
+  line.Set("t", *media_time_ms);
+  if (label) {
+    line.Set("label", *label);
+  }
+  WriteEvent(std::move(line));
+  return protocol::Response::Success();
+}
+
+protocol::Response AgentVideoRecorder::Mark(const std::string& event,
+                                            double* media_time_ms) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  protocol::Response active = CheckActive();
+  if (active.IsError()) {
+    return active;
+  }
+  if (event.size() > kMaxEventBytes) {
+    return protocol::Response::InvalidParams("event is over 16 KB.");
+  }
+  std::optional<base::DictValue> line =
+      base::JSONReader::ReadDict(event, base::JSON_PARSE_RFC);
+  if (!line) {
+    return protocol::Response::InvalidParams("event must be a JSON object.");
+  }
+  if (const base::Value* type = line->Find("type")) {
+    if (!type->is_string()) {
+      return protocol::Response::InvalidParams("type must be a string.");
+    }
+    if (std::ranges::contains(kOwnEventTypes,
+                              std::string_view(type->GetString()))) {
+      return protocol::Response::InvalidParams(base::StrCat(
+          {"type '", type->GetString(), "' is the recorder's own."}));
+    }
+  } else {
+    line->Set("type", "mark");
+  }
+  *media_time_ms = MediaTimeMs();
+  line->Set("t", *media_time_ms);
+  WriteEvent(std::move(*line));
+  return protocol::Response::Success();
+}
+
+void AgentVideoRecorder::Stop(StopCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ == State::kOpening || state_ == State::kStarting) {
+    std::move(callback).Run(base::unexpected(
+        protocol::Response::ServerError("The recording is still starting.")));
+    return;
+  }
+  if (stop_callback_) {
+    std::move(callback).Run(base::unexpected(protocol::Response::ServerError(
+        "A stop is already waiting for this recording.")));
+    return;
+  }
+  // A recording already ending on its own answers this stop when it is done.
+  stop_callback_ = std::move(callback);
+  BeginStop(EndReason::kStopped, std::nullopt);
+}
+
+void AgentVideoRecorder::OnData(const std::vector<uint8_t>& data) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning && state_ != State::kPaused &&
+      state_ != State::kStopping) {
+    return;
+  }
+  // The utility process is not trusted with the disk: past its allowance
+  // nothing more is written and the recording ends.
+  received_bytes_ += base::checked_cast<int64_t>(data.size());
+  if (received_bytes_ > max_bytes_) {
+    EndWithError("The encoder sent more than it should.");
+    return;
+  }
+  files_.AsyncCall(&Files::AppendVideo)
+      .WithArgs(data, base::ClampRound<int64_t>(MediaTimeMs() * 1000))
+      .Then(base::BindOnce(&AgentVideoRecorder::OnVideoWritten,
+                           weak_factory_.GetWeakPtr()));
+}
+
+void AgentVideoRecorder::OnVideoWritten(bool ok) {
+  if (ok || state_ == State::kDone) {
+    return;
+  }
+  if (state_ == State::kStopping) {
+    reason_ = EndReason::kError;
+    error_ = kWriteFailed;
+    return;
+  }
+  BeginStop(EndReason::kError, kWriteFailed);
+}
+
+void AgentVideoRecorder::OnClosed(
+    encoding_mojom::AgentVideoEncodingStatsPtr stats) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kStopping) {
+    return;
+  }
+  stats_ = std::move(stats);
+  Finish();
+}
+
+void AgentVideoRecorder::OnServiceGone() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  switch (state_) {
+    case State::kOpening:
+    case State::kDone:
+      return;
+    case State::kStarting:
+      FailStart(protocol::Response::ServerError(
+          "The encoder process could not start."));
+      return;
+    case State::kRunning:
+    case State::kPaused:
+      EndWithError("The encoder stopped.");
+      return;
+    case State::kStopping:
+      if (!stats_) {
+        EndWithError("The encoder stopped before the file was finished.");
+      }
+      return;
+  }
+}
+
+void AgentVideoRecorder::OnCloseTimeout() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EndWithError(
+      "The encoder did not finish in time; the file ends at its last "
+      "complete fragment.");
+}
+
+void AgentVideoRecorder::EndWithError(const std::string& error) {
+  if (state_ == State::kRunning || state_ == State::kPaused) {
+    BeginStop(EndReason::kError, error);
+  }
+  if (state_ != State::kStopping) {
+    return;
+  }
+  reason_ = EndReason::kError;
+  error_ = error;
+  Finish();
+}
+
+void AgentVideoRecorder::BeginStop(EndReason reason,
+                                   std::optional<std::string> error) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (state_ != State::kRunning && state_ != State::kPaused) {
+    return;
+  }
+  // A move still in its overlap did not happen.
+  DropPending();
+  end_media_time_ms_ = MediaTimeMs();
+  stopped_at_ = base::TimeTicks::Now();
+  state_ = State::kStopping;
+  reason_ = reason;
+  error_ = std::move(error);
+  // The time left stays as it was at the end, for the status.
+  StopLimitTimer();
+  keep_alive_timer_.Stop();
+  retarget_timer_.Stop();
+  StopCaptures();
+  if (service_.is_bound()) {
+    service_->Stop();
+  }
+  close_timer_.Start(FROM_HERE, kCloseTimeout,
+                     base::BindOnce(&AgentVideoRecorder::OnCloseTimeout,
+                                    base::Unretained(this)));
+}
+
+void AgentVideoRecorder::StopCaptures() {
+  pending_.reset();
+  current_.reset();
+}
+
+void AgentVideoRecorder::Finish() {
+  DCHECK_EQ(state_, State::kStopping);
+  state_ = State::kDone;
+  close_timer_.Stop();
+  client_receiver_.reset();
+  service_.reset();
+
+  base::DictValue line;
+  line.Set("type", "end");
+  line.Set("reason", ReasonName(reason_));
+  if (stats_) {
+    line.Set("t", static_cast<double>(stats_->duration_us) / 1000);
+    line.Set("frames", static_cast<double>(stats_->frames));
+    line.Set("repeated", static_cast<double>(stats_->repeated));
+    line.Set("dropped", static_cast<double>(stats_->dropped));
+    line.Set("bytes", static_cast<double>(stats_->bytes));
+  } else {
+    line.Set("t", end_media_time_ms_);
+  }
+  if (error_) {
+    line.Set("error", *error_);
+  }
+  WriteEvent(std::move(line));
+  // The file's exact length when the encoder counted it; otherwise the clock.
+  const int64_t length_us =
+      stats_ ? stats_->duration_us
+             : base::ClampRound<int64_t>(end_media_time_ms_ * 1000);
+  files_.AsyncCall(&Files::Close)
+      .WithArgs(length_us)
+      .Then(base::BindOnce(&AgentVideoRecorder::OnFilesClosed,
+                           weak_factory_.GetWeakPtr()));
+}
+
+void AgentVideoRecorder::OnFilesClosed(Files::CloseResult closed) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (closed.write_failed) {
+    // Any write, the last fragments' included.
+    reason_ = EndReason::kError;
+    error_ = kWriteFailed;
+  }
+  Result result;
+  result.path = path_;
+  result.events_path = events_path_;
+  result.size = size_;
+  result.fps = fps_;
+  result.encoder = encoder_name_;
+  result.audio = audio_name_;
+  result.bytes = static_cast<double>(closed.bytes);
+  result.reason = reason_;
+  result.error = error_;
+  result.redacted = redact_;
+  if (stats_) {
+    result.duration_ms = static_cast<double>(stats_->duration_us) / 1000;
+    result.frames = base::saturated_cast<int>(stats_->frames);
+    result.repeated = base::saturated_cast<int>(stats_->repeated);
+    result.dropped = base::saturated_cast<int>(stats_->dropped);
+    result.audio_duration_ms =
+        static_cast<double>(stats_->audio_duration_us) / 1000;
+    // A file that got no sound has none, whatever codec the start chose.
+    if (stats_->audio_duration_us == 0) {
+      result.audio = "none";
+    }
+  } else {
+    // The encoder never said: the file holds about this much, up to its last
+    // complete fragment.
+    result.duration_ms = end_media_time_ms_;
+  }
+
+  if (stop_callback_) {
+    std::move(stop_callback_).Run(result);
+  } else if (ended_callback_) {
+    std::move(ended_callback_).Run(id_, result);
+  }
+  Registry::Get().Release(this);
+}
+
+void AgentVideoRecorder::StartLimitTimer() {
+  limit_started_ = base::TimeTicks::Now();
+  limit_running_ = true;
+  time_limit_timer_.Start(
+      FROM_HERE, std::max(limit_left_, base::TimeDelta()),
+      base::BindOnce(&AgentVideoRecorder::BeginStop, base::Unretained(this),
+                     EndReason::kTimeLimit, std::optional<std::string>()));
+}
+
+void AgentVideoRecorder::StopLimitTimer() {
+  if (!limit_running_) {
+    return;
+  }
+  limit_running_ = false;
+  limit_left_ -= base::TimeTicks::Now() - limit_started_;
+  time_limit_timer_.Stop();
+}
+
+base::TimeDelta AgentVideoRecorder::RemainingTime() const {
+  base::TimeDelta left = limit_left_;
+  if (limit_running_) {
+    left -= base::TimeTicks::Now() - limit_started_;
+  }
+  return std::max(left, base::TimeDelta());
+}
+
+AgentVideoRecorder::Status AgentVideoRecorder::GetStatus() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Status status;
+  switch (state_) {
+    case State::kOpening:
+    case State::kStarting:
+      status.state = "starting";
+      break;
+    case State::kRunning:
+      status.state = "recording";
+      break;
+    case State::kPaused:
+      status.state = "paused";
+      break;
+    case State::kStopping:
+    case State::kDone:
+      status.state = "stopping";
+      break;
+  }
+  // The tab the file shows now, or showed last once the recording stops;
+  // once a return to the previous tab has begun, that tab, which the file
+  // shows from its first frame.
+  if (pending_ && pending_returns_) {
+    status.target_id = pending_->target_id();
+  } else if (current_) {
+    status.target_id = current_->target_id();
+  } else {
+    status.target_id =
+        shown_target_id_.empty() ? start_target_id_ : shown_target_id_;
+  }
+  status.path = path_;
+  status.media_time_ms = MediaTimeMs();
+  status.frames = base::saturated_cast<int>(frames_taken_);
+  status.bytes = static_cast<double>(received_bytes_);
+  status.redacted = redact_;
+  status.remaining_ms = RemainingTime().InMillisecondsF();
+  return status;
+}
+
+base::TimeDelta AgentVideoRecorder::MediaTime() const {
+  if (media_origin_.is_null()) {
+    return base::TimeDelta();
+  }
+  base::TimeTicks end;
+  switch (state_) {
+    case State::kPaused:
+      end = pause_started_;
+      break;
+    case State::kStopping:
+    case State::kDone:
+      end = stopped_at_;
+      break;
+    default:
+      end = base::TimeTicks::Now();
+      break;
+  }
+  return std::max(end - media_origin_ - paused_total_, base::TimeDelta());
+}
+
+double AgentVideoRecorder::MediaTimeMs() const {
+  return MediaTime().InMillisecondsF();
+}
+
+void AgentVideoRecorder::WriteEvent(base::DictValue event) {
+  std::optional<std::string> json = base::WriteJson(event);
+  if (!json) {
+    return;
+  }
+  json->push_back('\n');
+  // A failed line is remembered by Files and reported at the end.
+  files_.AsyncCall(base::IgnoreResult(&Files::AppendLine))
+      .WithArgs(std::move(*json));
+}
+
+// ---------------------------------------------------------------------------
+// The registry.
+
+// static
+AgentVideoRecorder::Registry& AgentVideoRecorder::Registry::Get() {
+  static base::NoDestructor<Registry> registry;
+  return *registry;
+}
+
+AgentVideoRecorder::Registry::Registry() = default;
+AgentVideoRecorder::Registry::~Registry() = default;
+
+void AgentVideoRecorder::Registry::Start(
+    [[maybe_unused]] const void* owner,
+    Options options,
+    [[maybe_unused]] EndedCallback ended_callback,
+    StartCallback callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto refuse = [&callback](protocol::Response response) {
+    std::move(callback).Run(base::unexpected(std::move(response)));
+  };
+  if (recorder_) {
+    refuse(protocol::Response::ServerError(
+        base::StrCat({"A video recording is already running (",
+                      recorder_->id(), "); stop it first."})));
+    return;
+  }
+  if (options.fps < 1 || options.fps > kMaxFps) {
+    refuse(protocol::Response::InvalidParams("fps must be 1-60."));
+    return;
+  }
+  if (!options.path.IsAbsolute() || options.path.ReferencesParent() ||
+      !options.path.MatchesFinalExtension(FILE_PATH_LITERAL(".mp4"))) {
+    refuse(protocol::Response::InvalidParams(
+        "path must be an absolute path to a .mp4 file."));
+    return;
+  }
+  const int minutes = options.max_minutes.value_or(kDefaultMinutes);
+  if (minutes < 1 || minutes > kMaxMinutes) {
+    refuse(protocol::Response::InvalidParams("maxMinutes must be 1-120."));
+    return;
+  }
+  if (options.bitrate_kbps && (*options.bitrate_kbps < kMinBitrateKbps ||
+                               *options.bitrate_kbps > kMaxBitrateKbps)) {
+    refuse(protocol::Response::InvalidParams(
+        "bitrateKbps must be 100-100000."));
+    return;
+  }
+  if ((options.width && *options.width < kMinSide) ||
+      (options.height && *options.height < kMinSide)) {
+    refuse(protocol::Response::InvalidParams(
+        "width and height must be at least 16."));
+    return;
+  }
+  if (!ParseEncoderChoice(options.encoder)) {
+    refuse(protocol::Response::InvalidParams(
+        "encoder must be auto, hardware or software."));
+    return;
+  }
+  if (!ParseAudioChoice(options.audio_codec)) {
+    refuse(protocol::Response::InvalidParams(
+        "audioCodec must be auto, aac or opus."));
+    return;
+  }
+  WebContents* target = FindPageTarget(options.target_id);
+  if (!target) {
+    refuse(NoTarget(options.target_id));
+    return;
+  }
+  const gfx::Size page = PagePixelSize(target);
+  if (page.width() < kMinSide || page.height() < kMinSide) {
+    refuse(protocol::Response::ServerError(
+        "The page has no size to record yet."));
+    return;
+  }
+
+  // The file is never larger than the page: a larger side is clamped to the
+  // page's. One side given, the other follows the page's shape.
+  int width = page.width();
+  int height = page.height();
+  if (options.width && options.height) {
+    width = std::min(*options.width, page.width());
+    height = std::min(*options.height, page.height());
+  } else if (options.width) {
+    width = std::min(*options.width, page.width());
+    height = base::ClampRound(static_cast<double>(width) * page.height() /
+                              page.width());
+  } else if (options.height) {
+    height = std::min(*options.height, page.height());
+    width = base::ClampRound(static_cast<double>(height) * page.width() /
+                             page.height());
+  }
+  const gfx::Size size(EvenFloor(width), EvenFloor(height));
+  if (size.width() < kMinSide || size.height() < kMinSide) {
+    refuse(protocol::Response::InvalidParams(
+        "The file must be at least 16x16."));
+    return;
+  }
+
+#if !BUILDFLAG(ENABLE_OPENH264) || !BUILDFLAG(USE_PROPRIETARY_CODECS)
+  refuse(protocol::Response::ServerError(
+      "This browser was built without an H.264 encoder."));
+#else
+  uint32_t bitrate_bps = 0;
+  if (options.bitrate_kbps) {
+    bitrate_bps = base::checked_cast<uint32_t>(*options.bitrate_kbps) * 1000;
+  } else {
+    bitrate_bps = base::ClampRound<uint32_t>(std::clamp(
+        static_cast<double>(size.GetArea()) * options.fps *
+            kDefaultBitsPerPixel,
+        kMinDefaultBitrate, kMaxDefaultBitrate));
+  }
+  // One sequence for every recording's files, so a failed start's Discard
+  // always runs before the next start's Open. Made at the first recording.
+  if (!file_runner_) {
+    file_runner_ = base::ThreadPool::CreateSequencedTaskRunner(
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+  }
+  recorder_ = base::WrapUnique(new AgentVideoRecorder(
+      owner, std::move(options), std::move(ended_callback), target, size,
+      bitrate_bps, file_runner_));
+  recorder_->Begin(std::move(callback));
+#endif
+}
+
+AgentVideoRecorder* AgentVideoRecorder::Registry::Find(
+    const std::string& recording_id) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (recorder_ && recorder_->id() == recording_id) {
+    return recorder_.get();
+  }
+  return nullptr;
+}
+
+AgentVideoRecorder* AgentVideoRecorder::Registry::Current() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return recorder_.get();
+}
+
+void AgentVideoRecorder::Registry::OnSessionGone(const void* owner) {
+  // Every BrowserHandler calls this when it goes; most have nothing here.
+  if (!recorder_ || recorder_->owner_ != owner) {
+    return;
+  }
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  AgentVideoRecorder* recorder = recorder_.get();
+  recorder->owner_ = nullptr;
+  recorder->ended_callback_.Reset();
+  switch (recorder->state_) {
+    case State::kOpening:
+    case State::kStarting:
+      recorder->Abandon();
+      return;
+    case State::kRunning:
+    case State::kPaused:
+      recorder->BeginStop(EndReason::kSessionClosed, std::nullopt);
+      return;
+    case State::kStopping:
+    case State::kDone:
+      return;
+  }
+}
+
+void AgentVideoRecorder::Registry::Release(AgentVideoRecorder* recorder) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (recorder_.get() != recorder) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(recorder_));
+}
+
+}  // namespace content
