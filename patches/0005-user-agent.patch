+// browser: UA-string product tokens for non-Chrome brands, with the version
+// used when no version switch is set.
+struct BrandSuffix {
+  std::string_view key;
+  std::string_view token;
+  std::string_view default_version;
+};
+constexpr BrandSuffix kBrandSuffixes[] = {
+    {"Edge", "Edg", "145.0.0.0"},
+    {"Opera", "OPR", "123.0.0.0"},
+    {"Vivaldi", "Vivaldi", "7.5.3735.66"},
+};
+
 }  // namespace
 
 UserAgentBrandVersion::UserAgentBrandVersion(const std::string& ua_brand,
@@ -237,4 +257,41 @@ bool operator==(const UserAgentOverride& a, const UserAgentOverride& b) {
          a.ua_metadata_override == b.ua_metadata_override;
 }
 
+// browser
+std::string GetUserAgentFingerprintBrandInfo() {
+  static const base::NoDestructor<std::string> cached([]() -> std::string {
+    const std::string& brand_key = browser::SpoofedBrand();
+    if (brand_key.empty() || brand_key == "Chrome") {
+      return std::string();
+    }
+    std::string version = browser::SpoofedBrandVersionLong();
+    if (version.empty() && !browser::SpoofedBrandVersion().empty()) {
+      version = browser::SpoofedBrandVersion() + ".0.0.0";
+    }
+    std::string_view token = brand_key;
+    std::string_view default_version = "0.0.0.0";
+    for (const BrandSuffix& entry : kBrandSuffixes) {
+      if (entry.key == brand_key) {
+        token = entry.token;
+        default_version = entry.default_version;
+      }
+    }
+    return base::StrCat(
+        {" ", token, "/", version.empty() ? default_version : version});
+  }());
+  return *cached;
+}
+
+// browser
+bool PresentsWindowsPlatform() {
+#if BUILDFLAG(IS_LINUX)
+  static const bool presents =
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kUseChromiumDefaults);
+  return presents;
+#else
+  return false;
+#endif
+}
+
 }  // namespace blink
