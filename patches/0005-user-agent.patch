+// browser: brand and version overrides, shared by the UA string, the brand
+// list and the full-version client hint.
+struct FingerprintBrandConfig {
+  bool active = false;
+  // True when a version switch is set, not only the brand.
+  bool version_spoofed = false;
+  std::string major_version;
+  std::string full_version;
+  std::string display_brand;
+};
+
+struct BrandDisplayName {
+  std::string_view key;
+  std::string_view name;
+};
+constexpr BrandDisplayName kBrandDisplayNames[] = {
+    {"Chrome", "Google Chrome"},
+    {"Edge", "Microsoft Edge"},
+    {"Opera", "Opera"},
+    {"Vivaldi", "Vivaldi"},
+};
+
+std::string MajorVersionOf(std::string_view version) {
+  return std::string(version.substr(0, version.find('.')));
+}
+
+const FingerprintBrandConfig& GetFingerprintBrandConfig() {
+  static const base::NoDestructor<FingerprintBrandConfig> config([] {
+    FingerprintBrandConfig result;
+    if (!browser::BrandSpoofActive()) {
+      return result;
+    }
+    const std::string& brand_key = browser::SpoofedBrand();
+    const std::string& short_version = browser::SpoofedBrandVersion();
+    const std::string& long_version = browser::SpoofedBrandVersionLong();
+    result.active = true;
+    result.version_spoofed = !short_version.empty() || !long_version.empty();
+
+    if (!short_version.empty()) {
+      result.major_version = short_version;
+    } else if (!long_version.empty()) {
+      result.major_version = MajorVersionOf(long_version);
+    } else {
+      result.major_version = version_info::GetMajorVersionNumber();
+    }
+    if (!long_version.empty()) {
+      result.full_version = long_version;
+    } else if (!short_version.empty()) {
+      result.full_version = result.major_version + ".0.0.0";
+    } else {
+      result.full_version = std::string(version_info::GetVersionNumber());
+    }
+    result.display_brand = brand_key.empty() ? "Google Chrome" : brand_key;
+    for (const BrandDisplayName& entry : kBrandDisplayNames) {
+      if (entry.key == brand_key) {
+        result.display_brand = std::string(entry.name);
+      }
+    }
+    return result;
+  }());
+  return *config;
+}
+
 const blink::UserAgentBrandList GetUserAgentBrandList(
     const std::string& major_version,
     const std::string& full_version,
     blink::UserAgentBrandVersionType output_version_type,
     std::optional<blink::UserAgentBrandVersion> additional_brand_version) {
+  // browser: the spoofed brand and versions replace the real ones.
+  const FingerprintBrandConfig& config = GetFingerprintBrandConfig();
+  const std::string& effective_major =
+      config.active ? config.major_version : major_version;
+  const std::string& effective_full =
+      config.active ? config.full_version : full_version;
+
   int major_version_number;
-  bool parse_result = base::StringToInt(major_version, &major_version_number);
+  bool parse_result = base::StringToInt(effective_major, &major_version_number);
   DCHECK(parse_result);
   std::optional<std::string> brand;
+  if (config.active) {
+    brand = config.display_brand;
+  } else {
 #if !BUILDFLAG(CHROMIUM_BRANDING)
-  brand = version_info::GetProductName();
+    brand = version_info::GetProductName();
 #endif
+  }
 
   std::string brand_version =
       output_version_type == blink::UserAgentBrandVersionType::kFullVersion
-          ? full_version
-          : major_version;
+          ? effective_full
+          : effective_major;
 
   return GenerateBrandVersionList(major_version_number, brand, brand_version,
                                   output_version_type,
@@ -215,8 +292,12 @@ const blink::UserAgentBrandList GetUserAgentBrandFullVersionListInternal(
 // depending on the Reduce User-Agent reduction phase features.
 std::string GetUserAgentInternal() {
   std::string product = GetProductAndVersion();
-  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kHeadless)) {
-    product.insert(0, "Headless");
+  // browser: the UA string always carries the reduced Chrome/MAJOR.0.0.0
+  // token; the full version only appears in client hints. The "Headless"
+  // prefix is never added.
+  const FingerprintBrandConfig& config = GetFingerprintBrandConfig();
+  if (config.version_spoofed) {
+    product = "Chrome/" + config.major_version + ".0.0.0";
   }
 
 #if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS)
@@ -225,9 +306,13 @@ std::string GetUserAgentInternal() {
   }
 #endif
 
-  return ShouldSendUserAgentUnifiedPlatform()
-             ? BuildUnifiedPlatformUserAgentFromProduct(product)
-             : BuildUserAgentFromProduct(product);
+  std::string user_agent =
+      ShouldSendUserAgentUnifiedPlatform()
+          ? BuildUnifiedPlatformUserAgentFromProduct(product)
+          : BuildUserAgentFromProduct(product);
+  // browser: non-Chrome brands add their own product token.
+  user_agent += blink::GetUserAgentFingerprintBrandInfo();
+  return user_agent;
 }
 
 // Generate random order list based on the input size and seed.
@@ -279,6 +364,12 @@ blink::UserAgentBrandList ShuffleBrandList(
