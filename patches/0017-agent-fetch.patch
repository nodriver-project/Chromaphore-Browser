+// WaitForSettle -------------------------------------------------------------
+
+void AgentFetchAgent::WaitForSettle(mojom::blink::AgentSettleOptionsPtr options,
+                                    WaitForSettleCallback callback) {
+  SettleState state;
+  state.quiet =
+      base::Milliseconds(std::clamp(options->quiet_ms, 0, kMaxSettleMs));
+  state.busy_quiet =
+      base::Milliseconds(std::clamp(options->busy_quiet_ms, 0, kMaxSettleMs));
+  state.max_inflight = std::clamp(options->max_inflight, 0, 100000);
+  state.cap = base::Milliseconds(std::clamp(options->cap_ms, 0, kMaxSettleMs));
+  state.min_text = std::clamp(options->min_text, 0, kMaxTextLength);
+  state.start = base::TimeTicks::Now();
+  state.tick = kSettleTick;
+  LocalFrame* frame = GetSupplementable()->GetFrame();
+  // A wait with none pending subscribes afresh, so it never takes an idle
+  // time an earlier wait saw.
+  if (frame && !pending_settles_) {
+    network_idle_at_ = base::TimeTicks();
+    network_idle_subscription_ =
+        frame->RequestNetworkIdleCallback(blink::BindOnce(
+            &AgentFetchAgent::OnNetworkIdle, WrapWeakPersistent(this)));
+  }
+  ++pending_settles_;
+  SettleTick(state, std::move(callback));
+}
+
+void AgentFetchAgent::OnNetworkIdle() {
+  network_idle_at_ = base::TimeTicks::Now();
+}
+
+void AgentFetchAgent::SettleTick(SettleState state,
+                                 WaitForSettleCallback callback) {
+  if (receiver_set_.empty()) {
+    // Nobody is left to answer: stop ticking and drop the reply.
+    EndSettle();
+    return;
+  }
+  Document& document = *GetSupplementable();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!document.GetFrame()) {
+    // The document lost its frame mid-wait: answer with what there is (the
+    // browser also sees the pipe drop when the document goes).
+    FinishSettle(state, "cap", std::move(callback));
+    return;
+  }
+  const base::TimeTicks dcl_end =
+      document.GetTiming().DomContentLoadedEventEnd();
+  // A tick that measures nothing is cheap.
+  bool cheap = true;
+  // Nothing counts before DOMContentLoaded: a page's text can sit still
+  // before it and change once its scripts run.
+  if (document.HasFinishedParsing() && !dcl_end.is_null()) {
+    // The DOM tree version is only a cheap gate (it also counts attribute
+    // writes); the signature is what has to stay still.
+    const uint64_t version = document.DomTreeVersion();
+    if (!state.have_signature || version != state.last_version) {
+      state.last_version = version;
+      int32_t length = 0;
+      int32_t nodes = 0;
+      const base::TimeTicks measure_start = base::TimeTicks::Now();
+      const bool complete = MeasureText(document, &length, &nodes);
+      const base::TimeDelta spent = base::TimeTicks::Now() - measure_start;
+      cheap = spent < kCheapMeasure;
+      if (spent > kSlowMeasure) {
+        state.tick = std::min(state.tick * 2, kMaxSettleTick);
+      }
+      // A walk cut short at its bounds counts as unchanged: a page that
+      // large settles on quiet time alone.
+      if (!state.have_signature || (complete && (length != state.text_length ||
+                                                 nodes != state.text_nodes))) {
+        state.text_length = length;
+        state.text_nodes = nodes;
+        state.last_change = now;
+      }
+      state.have_signature = true;
+    }
+    const ResourceFetcher* fetcher = document.Fetcher();
+    const int active = fetcher ? fetcher->ActiveRequestCount() : 0;
+    const base::TimeDelta quiet_needed =
+        active > state.max_inflight ? state.busy_quiet : state.quiet;
+    if (state.text_length >= state.min_text &&
+        now - std::max(state.last_change, dcl_end) >= quiet_needed) {
+      FinishSettle(state, "quiet", std::move(callback));
+      return;
+    }
+    if (!network_idle_at_.is_null() &&
+        now - std::max(state.last_change, network_idle_at_) >=
+            kNetworkIdleQuiet) {
+      FinishSettle(state, "networkIdle", std::move(callback));
+      return;
+    }
+  }
+  if (now - state.start >= state.cap) {
+    FinishSettle(state, "cap", std::move(callback));
+    return;
+  }
+  if (cheap) {
+    state.tick = std::max(state.tick / 2, kSettleTick);
+  }
+  // kInternalUserInteraction is not throttled, unlike the page's timers.
+  document.GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostDelayedTask(
+          FROM_HERE,
+          blink::BindOnce(&AgentFetchAgent::SettleTick,
+                          WrapWeakPersistent(this), state, std::move(callback)),
+          state.tick);
+}
+
+void AgentFetchAgent::FinishSettle(const SettleState& state,
+                                   const char* reason,
+                                   WaitForSettleCallback callback) {
+  Document& document = *GetSupplementable();
+  auto report = mojom::blink::AgentSettleReport::New();
+  report->reason = reason;
+  report->waited_ms = base::saturated_cast<int32_t>(
+      (base::TimeTicks::Now() - state.start).InMilliseconds());
+  report->dcl_fired =
+      !document.GetTiming().DomContentLoadedEventEnd().is_null();
+  report->load_fired = document.LoadEventFinished();
+  int32_t length = state.text_length;
+  int32_t nodes = state.text_nodes;
+  if (!state.have_signature && document.GetFrame()) {
+    MeasureText(document, &length, &nodes);
+  }
+  report->text_length = length;
+  report->text_nodes = nodes;
+  const ResourceFetcher* fetcher = document.Fetcher();
+  report->active_requests = fetcher ? fetcher->ActiveRequestCount() : 0;
+  report->visible = !document.hidden();
+  report->ready_state = ReadyState(document);
+  EndSettle();
+  std::move(callback).Run(std::move(report));
+}
+
+void AgentFetchAgent::EndSettle() {
+  // The last pending wait lets go of the frame's network-idle callback.
+  if (pending_settles_ > 0 && !--pending_settles_) {
+    network_idle_subscription_ = base::CallbackListSubscription();
+  }
+}
+
+// Markers -------------------------------------------------------------------
+
+void AgentFetchAgent::Markers(MarkersCallback callback) {
+  auto markers = mojom::blink::AgentChallengeMarkers::New();
+  markers->title = g_empty_string;
+  markers->head = g_empty_string;
+  markers->dd_rt = g_empty_string;
+  markers->dd_t = g_empty_string;
+  Document& document = *GetSupplementable();
+  if (!IsUsable(document)) {
+    std::move(callback).Run(std::move(markers));
+    return;
+  }
+  markers->title = NonNull(document.title());
+  // The visible text as the last frame laid it out; no forced layout.
+  String text = g_empty_string;
+  if (HTMLElement* body = document.body()) {
+    text = Collapse(body->GetInnerTextWithoutUpdate(), false);
+  }
+  markers->text_length = base::saturated_cast<int32_t>(text.length());
+  markers->head = NonNull(Truncate(text, kHeadLength));
+
+  MarkerHits hit = {};
+  hit[kCfTitle] = markers->title.StripWhiteSpace() == "Just a moment...";
+  ScanScripts(document, hit, *markers);
+  hit[kCfErrorText] = HasMatch(document, "#challenge-error-text");
+  hit[kCfLegacy] = HasMatch(document,
+                            "#challenge-form,#challenge-running,"
+                            "#challenge-stage,#cf-challenge-running,"
+                            ".cf-browser-verification");
+  hit[kDdCmsg] = HasMatch(document, "p#cmsg");
+  hit[kPxCaptcha] =
+      hit[kPxCaptcha] ||
+      HasMatch(document,
+               "#px-captcha,#px-captcha-wrapper,[data-px-captcha],"
+               ".px-captcha-error-container");
+  // AWS WAF's captcha container counts with its script.
+  hit[kWafScript] = hit[kWafScript] || HasMatch(document, "#captcha-container");
+  hit[kAkamaiCpt] = hit[kAkamaiCpt] ||
+                    HasMatch(document, "#sec-if-cpt-container,#sec-cpt-if");
+  ScanMetaRefresh(document, hit);
+  Vector<String> hosts;
+  ScanFrames(document, hit, hosts);
+  const KURL& url = document.Url();
+  hit[kGoogleSorry] = (url.Host().ToString().contains("google.") &&
+                       url.GetPath().ToString().starts_with("/sorry/")) ||
+                      HasMatch(document, "#captcha-form");
+
+  for (wtf_size_t i = 0; i < kMarkerCount; ++i) {
+    if (hit[i]) {
+      markers->matched.push_back(kMarkerNames[i]);
+    }
+  }
+  markers->frame_hosts = std::move(hosts);
+  std::move(callback).Run(std::move(markers));
+}
