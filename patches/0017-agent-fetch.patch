+
+namespace {
+
+constexpr int kMaxRestarts = 5;
+constexpr base::TimeDelta kChallengeCap = base::Seconds(15);
+constexpr base::TimeDelta kInteractiveGrace = base::Seconds(3);
+constexpr base::TimeDelta kMarkersPoll = base::Milliseconds(250);
+// A same-document clear: the markers left and the text grew by this much.
+constexpr int kClearedTextGrowth = 500;
+// Time kept back from the settle for the extraction and the reply.
+constexpr base::TimeDelta kExtractReserve = base::Seconds(2);
+// The least settle a document that replaced another gets, however little
+// of the shared settle budget is left.
+constexpr base::TimeDelta kMinDocumentSettle = base::Seconds(3);
+constexpr base::TimeDelta kReplyReserve = base::Milliseconds(500);
+// The API call's body cap.
+constexpr int32_t kApiMaxBodyBytes = 64 * 1024 * 1024;
+// The page's whole text, up to the renderer's own maximum (kMaxMarkdownChars),
+// not the extraction default of 200,000: the caller cuts the reply to its own
+// budget and keeps the whole page when it does.
+constexpr int32_t kMarkdownChars = 4 * 1024 * 1024;
+// The most links a call that asked for every one gets: the renderer's own
+// maximum (kMaxLinks). Otherwise the extraction default of 500 is asked for.
+constexpr int32_t kAllLinks = 5000;
+// The most of one URL, and of any other string, that the renderer's
+// extraction puts into the reply; the markdown has a cap of its own.
+constexpr size_t kMaxReplyUrlBytes = 8 * 1024;
+constexpr size_t kMaxReplyTextBytes = 64 * 1024;
+// The head of the visible text the block rules read.
+constexpr size_t kHeadChars = 600;
+// How long extraction waits for a navigation the page started.
+constexpr base::TimeDelta kNavigationWait = base::Seconds(2);
+
+// Valid UTF-8, invalid sequences substituted (the CDP encoder would drop
+// them silently).
+std::string ValidUTF8(std::string_view text) {
+  if (base::IsStringUTF8AllowingNoncharacters(text)) {
+    return std::string(text);
+  }
+  return AgentFetchBodySink::DecodeToUTF8(text, "text", "utf-8", nullptr);
+}
+
+// A long text the renderer promised as UTF-8, or a note when it is not.
+std::string ValidUTF8OrNote(std::string text, std::string_view what) {
+  if (base::IsStringUTF8AllowingNoncharacters(text)) {
+    return text;
+  }
+  return base::StrCat(
+      {"[the ", what, " was not valid UTF-8 and was left out]"});
+}
+
+// Cuts `text`, valid UTF-8, to at most `max_bytes` on a character boundary.
+void CutUTF8(std::string& text, size_t max_bytes) {
+  if (text.size() > max_bytes) {
+    text.resize(base::TruncateUTF8ToByteSize(text, max_bytes).size());
+  }
+}
+
+// A string from the renderer's extraction, for the reply: valid UTF-8 (see
+// ValidUTF8), cut at `max_bytes`.
+std::string ReplyString(std::string_view text,
+                        size_t max_bytes = kMaxReplyTextBytes) {
+  std::string reply = ValidUTF8(text);
+  CutUTF8(reply, max_bytes);
+  return reply;
+}
+
+// Cuts every string in `value`, at any depth, at kMaxReplyTextBytes. The
+// JSON reader has made them valid UTF-8 already.
+void CutReplyStrings(base::Value& value) {
+  if (std::string* text = value.GetIfString()) {
+    CutUTF8(*text, kMaxReplyTextBytes);
+  } else if (base::ListValue* list = value.GetIfList()) {
+    for (base::Value& item : *list) {
+      CutReplyStrings(item);
+    }
+  } else if (base::DictValue* dict = value.GetIfDict()) {
+    for (auto [key, item] : *dict) {
+      CutReplyStrings(item);
+    }
+  }
+}
+
+// Adds one header line: names lowercased, repeats joined with ", ", values
+// made valid UTF-8 (a latin-1 value is decoded as windows-1252).
+void AddHeader(AgentFetchHeaderMap& map,
+               std::string_view name,
+               std::string_view value) {
+  std::string key = base::ToLowerASCII(name);
+  std::string clean = AgentFetchBodySink::DecodeToUTF8(
+      value, "text", std::string_view(), nullptr);
+  if (key == "set-cookie") {
+    // browser: the cookie's name only; its value is no business of the
+    // agent's.
+    clean = std::string(base::TrimWhitespaceASCII(
+        std::string_view(clean).substr(0, clean.find('=')), base::TRIM_ALL));
+  }
+  auto [it, inserted] = map.emplace(std::move(key), clean);
+  if (!inserted) {
+    it->second += ", ";
+    it->second += clean;
+  }
+}
+
+AgentFetchHeaderMap HeaderMapFrom(const net::HttpResponseHeaders* headers) {
+  AgentFetchHeaderMap map;
+  if (!headers) {
+    return map;
+  }
+  size_t iter = 0;
+  std::string name;
+  std::string value;
+  while (headers->EnumerateHeaderLines(&iter, &name, &value)) {
+    AddHeader(map, name, value);
+  }
+  return map;
+}
+
+void AppendEvidence(AgentFetchVerdict& into, const AgentFetchVerdict& from) {
+  for (const std::string& item : from.evidence) {
+    if (std::ranges::find(into.evidence, item) == into.evidence.end()) {
+      into.evidence.push_back(item);
+    }
+  }
+}
+
+}  // namespace
+
+AgentFetchJob::Response::Response() = default;
+AgentFetchJob::Response::Response(Response&&) = default;
+AgentFetchJob::Response& AgentFetchJob::Response::operator=(Response&&) =
+    default;
+AgentFetchJob::Response::~Response() = default;
+
+AgentFetchJob::AgentFetchJob(AgentFetcher* fetcher,
+                             AgentFetchParams params,
+                             std::unique_ptr<AgentFetcher::Callback> callback)
+    : fetcher_(fetcher),
+      params_(std::move(params)),
+      callback_(std::move(callback)),
+      created_(base::TimeTicks::Now()) {}
+
+AgentFetchJob::~AgentFetchJob() {
+  // browser: never answer from here. The session is gone or the
+  // job already answered; the callback is dropped as it is. Pending mojo
+  // replies run their defaults into dead weak pointers.
+  finished_ = true;
+  weak_factory_.InvalidateWeakPtrs();
+  callback_.reset();
+  Observe(nullptr);
+  agent_.reset();
+  sink_.reset();
+  if (contents_) {
+    contents_->DetachTaker();
+    AgentFetchContents::DestroySoon(std::move(contents_));
+  }
+}
+
+void AgentFetchJob::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  deadline_ = base::TimeTicks::Now() + params_.timeout;
+  timeout_timer_.Start(FROM_HERE, params_.timeout, this,
+                       &AgentFetchJob::OnTimeout);
+
+  Profile* profile = fetcher_->profile();
+  if (!profile) {
+    Finish("error", "the profile is gone");
+    return;
+  }
+  contents_ = std::make_unique<AgentFetchContents>(profile, this);
+  if (!contents_->web_contents()) {
+    Finish("error", "the fetch page could not be made");
+    return;
+  }
+  Observe(contents_->web_contents());
+  if (params_.IsApiCall()) {
+    StartSyntheticDocument();
+  } else {
+    StartNavigation();
+  }
+}
+
+void AgentFetchJob::Cancel() {
+  Finish("cancelled", std::nullopt);
+}
+
+void AgentFetchJob::Fail(const std::string& error) {
+  Finish("error", error);
+}
+
+void AgentFetchJob::StartNavigation() {
+  content::NavigationController::LoadURLParams load(params_.url);
+  // browser: a typed navigation, as from the address bar: browser-initiated
+  // (Sec-Fetch-Site: none, Sec-Fetch-User: ?1) and without a referrer, so
+  // the request is the one a person's visit makes.
+  load.transition_type = ui::PageTransitionFromInt(
+      ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+  load.is_renderer_initiated = false;
+  base::WeakPtr<content::NavigationHandle> handle =
+      web_contents()->GetController().LoadURLWithParams(load);
+  if (!handle && !finished_ && navigations_in_flight_.empty() &&
+      !document_committed_ && !body_taken_) {
+    Finish("error", "the navigation did not start");
+  }
+}
+
+void AgentFetchJob::StartSyntheticDocument() {
+  // A document of the target's origin (or of `referrer`) that makes
+  // no request and runs no site script; its fetch() is the site's own.
+  const GURL base_url = params_.referrer.is_valid()
+                            ? params_.referrer
+                            : url::Origin::Create(params_.url).GetURL();
+  content::NavigationController::LoadURLParams load(GURL("data:text/html,"));
+  load.load_type = content::NavigationController::LOAD_TYPE_DATA;
+  load.base_url_for_data_url = base_url;
+  load.virtual_url_for_special_cases = base_url;
+  load.is_renderer_initiated = false;
+  base::WeakPtr<content::NavigationHandle> handle =
+      web_contents()->GetController().LoadURLWithParams(load);
+  if (!handle && !finished_ && navigations_in_flight_.empty() &&
+      !document_committed_) {
+    Finish("error", "the API call's document did not load");
+  }
+}
+
+bool AgentFetchJob::ShouldTakeNavigationResponse(
+    content::NavigationHandle& handle,
+    const network::mojom::URLResponseHead& head,
+    bool is_download) {
+  // browser: one body per call. Once a response is taken, the page that is
+  // left behind may not replace it (nor its sink) with another.
+  if (finished_ || body_taken_ || params_.IsApiCall() ||
+      !handle.IsInPrimaryMainFrame()) {
+    return false;
+  }
+  if (params_.mode == AgentFetchParams::Mode::kRaw) {
+    return true;
+  }
+  // auto: a page renders; anything else is read as it is.
+  const std::string mime = base::ToLowerASCII(head.mime_type);
+  const bool page = mime == "text/html" || mime == "application/xhtml+xml";
+  return !page || is_download;
+}
+
+void AgentFetchJob::TakeNavigationResponse(
+    content::NavigationHandle& handle,
+    network::mojom::URLResponseHeadPtr head,
+    mojo::ScopedDataPipeConsumerHandle body,
+    network::mojom::URLLoaderClientEndpointsPtr endpoints) {
+  DropDocumentWork();
+  // A bot check that clears into a file (a challenged JSON URL) cleared.
+  if (challenge_active_) {
+    LeaveChallenge();
+  }
+  // browser: what an earlier document left (a challenge page's title and
+  // markers, its settle report) describes that document, not this body.
+  markers_.reset();
+  settle_report_.reset();
+  extraction_.reset();
+  dcl_time_ = base::TimeTicks();
+  settle_time_ = base::TimeTicks();
+  extract_time_ = base::TimeTicks();
+  body_taken_ = true;
+  taken_navigation_id_ = handle.GetNavigationId();
+  commit_time_ = base::TimeTicks::Now();
+
+  const net::HttpResponseHeaders* headers = head->headers.get();
+  RecordResponse(handle.GetNavigationId(), handle.GetURL(), headers,
+                 head->mime_type, head->charset);
+
+  AgentFetchBodySink::Options options;
+  options.url = handle.GetURL();
+  options.mime_type = response_.mime_type;
+  options.charset = head->charset;
+  if (headers) {
+    options.content_disposition =
+        headers->GetNormalizedHeader("content-disposition")
+            .value_or(std::string());
+  }
+  options.save_to = params_.save_to;
+  options.default_dir = fetcher_->save_dir();
+  options.part_tag = params_.fetch_id;
+  options.may_write_files = fetcher_->may_write_local_files();
+  sink_ = AgentFetchBodySink::ForNavigation(
+      std::move(options), std::move(body), std::move(endpoints),
+      base::BindOnce(&AgentFetchJob::OnBodyDone, weak_factory_.GetWeakPtr()));
+}
+
+void AgentFetchJob::DidStartNavigation(content::NavigationHandle* handle) {
+  // A same-document navigation (a fragment, the challenge page's own
+  // history.replaceState round trips) replaces nothing.
+  if (!handle->IsInPrimaryMainFrame() || handle->IsSameDocument()) {
+    return;
+  }
+  if (navigate_time_.is_null()) {
+    navigate_time_ = base::TimeTicks::Now();
+  }
+  navigations_in_flight_.insert(handle->GetNavigationId());
+}
+
+void AgentFetchJob::DidRedirectNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  const std::vector<GURL>& chain = handle->GetRedirectChain();
+  if (chain.size() < 2) {
+    return;
+  }
+  const net::HttpResponseHeaders* headers = handle->GetResponseHeaders();
+  pending_redirects_[handle->GetNavigationId()].push_back(Hop{
+      chain[chain.size() - 2].spec(), headers ? headers->response_code() : 0});
+}
+
+void AgentFetchJob::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  const int64_t id = handle->GetNavigationId();
+  navigations_in_flight_.erase(id);
+  // Once a body is taken it is the answer: a later commit or error page of
+  // the page left behind must not restart document work or end the call
+  // while the sink is still reading.
+  if (!finished_ && !body_taken_ && id != taken_navigation_id_) {
+    if (!handle->HasCommitted()) {
+      OnNavigationNotCommitted(handle);
+    } else if (!handle->IsSameDocument()) {
+      if (handle->IsErrorPage()) {
+        OnErrorPageCommitted(handle);
+      } else {
+        OnDocumentCommitted(handle);
+      }
+    }
+  }
+  pending_redirects_.erase(id);
+}
+
+void AgentFetchJob::DOMContentLoaded(
+    content::RenderFrameHost* render_frame_host) {
+  if (render_frame_host && render_frame_host->IsInPrimaryMainFrame()) {
+    dcl_time_ = base::TimeTicks::Now();
+  }
+}
+
+void AgentFetchJob::PrimaryMainFrameRenderProcessGone(
+    base::TerminationStatus status) {
+  // A taken body does not need the renderer.
+  if (!finished_ && !body_taken_) {
+    Finish("error", "crashed");
+  }
+}
+
+void AgentFetchJob::WebContentsDestroyed() {
+  if (!finished_) {
+    Finish("error", "the fetch page was closed");
+  }
+}
+
+void AgentFetchJob::RecordResponse(int64_t navigation_id,
+                                   const GURL& url,
+                                   const net::HttpResponseHeaders* headers,
+                                   const std::string& mime_type,
+                                   const std::string& charset) {
+  response_ = Response();
+  if (headers) {
+    response_.status = headers->response_code();
+  }
+  response_.final_url = url;
+  response_.mime_type = base::ToLowerASCII(mime_type);
+  response_.charset = base::ToLowerASCII(charset);
+  response_.headers = HeaderMapFrom(headers);
+  auto it = pending_redirects_.find(navigation_id);
+  if (it != pending_redirects_.end()) {
+    response_.redirects = it->second;
+  }
+  response_.redirected = !response_.redirects.empty();
+}
+
+void AgentFetchJob::OnNavigationNotCommitted(
+    content::NavigationHandle* handle) {
+  // A later navigation that went nowhere (a cancelled script navigation, a
+  // refused download, a 204) leaves the current document as it is; an
+  // extraction waiting on it goes ahead.
+  if (document_committed_ || body_taken_) {
+    if (waiting_for_navigation_ && navigations_in_flight_.empty()) {
+      OnNavigationWaitOver();
+    }
+    return;
+  }
+  if (!navigations_in_flight_.empty()) {
+    return;
+  }
+  const net::HttpResponseHeaders* headers = handle->GetResponseHeaders();
+  if (headers) {
+    std::string mime;
+    std::string charset;
+    headers->GetMimeTypeAndCharset(&mime, &charset);
+    RecordResponse(handle->GetNavigationId(), handle->GetURL(), headers, mime,
+                   charset);
+    // 204 and 205 commit nothing by design: an answer, not an error.
+    const int status = headers->response_code();
+    if (status == 204 || status == 205) {
+      Finish("ok", std::nullopt);
+      return;
+    }
+  }
+  int error = handle->GetNetErrorCode();
+  if (error == net::OK) {
+    error = net::ERR_ABORTED;
+  }
+  Finish("error", net::ErrorToShortString(error));
+}
+
+void AgentFetchJob::OnErrorPageCommitted(content::NavigationHandle* handle) {
+  DropDocumentWork();
+  document_committed_ = false;
+  commit_time_ = base::TimeTicks::Now();
+  const net::HttpResponseHeaders* headers = handle->GetResponseHeaders();
+  std::string mime;
+  std::string charset;
+  if (headers) {
+    headers->GetMimeTypeAndCharset(&mime, &charset);
+  }
+  RecordResponse(handle->GetNavigationId(), handle->GetURL(), headers, mime,
+                 charset);
+  const int error = handle->GetNetErrorCode();
+  // An HTTP error with an empty body shows Chrome's own page: the status is
+  // the answer, and there is no document of the site's to read.
+  if (error == net::ERR_HTTP_RESPONSE_CODE_FAILURE && response_.status) {
+    Finish("ok", std::nullopt);
+    return;
+  }
+  Finish("error",
+         net::ErrorToShortString(error == net::OK ? net::ERR_FAILED : error));
+}
+
+void AgentFetchJob::OnDocumentCommitted(content::NavigationHandle* handle) {
+  DropDocumentWork();
+  markers_.reset();
+  settle_report_.reset();
+  extraction_.reset();
+  dcl_time_ = base::TimeTicks();
+  settle_time_ = base::TimeTicks();
+  extract_time_ = base::TimeTicks();
+  ++commits_;
+  document_committed_ = true;
+  commit_time_ = base::TimeTicks::Now();
+  if (first_commit_time_.is_null()) {
+    first_commit_time_ = commit_time_;
+    settle_budget_start_ = commit_time_;
+  }
+
+  if (!BindAgent(handle->GetRenderFrameHost())) {
+    Finish("error", "the page's renderer is not live");
+    return;
+  }
+
+  if (params_.IsApiCall()) {
+    // The synthetic document: its fetch() is the call.
+    if (!api_started_) {
+      api_started_ = true;
+      RunApiFetch();
+    }
+    return;
+  }
+
+  const net::HttpResponseHeaders* headers = handle->GetResponseHeaders();
+  std::string mime;
+  std::string charset;
+  if (headers) {
+    headers->GetMimeTypeAndCharset(&mime, &charset);
+  }
+  if (mime.empty()) {
+    mime = web_contents()->GetContentsMimeType();
+  }
+  RecordResponse(handle->GetNavigationId(), handle->GetURL(), headers, mime,
+                 charset);
+
+  // Every cross-document commit is checked for the response-level
+  // signatures first; they need no renderer round trip. A ban needs no
+  // waiting either.
+  const int status = response_.status.value_or(0);
+  if (std::optional<AgentFetchVerdict> block =
+          DetectResponseBlock(status, response_.headers)) {
+    FinishBlocked(*block);
+    return;
+  }
+  response_challenge_ = DetectResponseChallenge(
+      status, response_.headers, response_.final_url, response_.redirected);
+  if (response_challenge_) {
+    if (restarts() > kMaxRestarts) {
+      challenge_ = response_challenge_;
+      FinishChallenge();
+      return;
+    }
+    EnterChallenge(*response_challenge_, /*text_length=*/0);
+    return;
+  }
+  // A new document without the signature: the check may have cleared (a
+  // same-URL POST for Cloudflare, a reload for Kasada). The settled
+  // document's markers decide.
+  if (challenge_active_) {
+    LeaveChallenge();
+  }
+  StartSettle();
+}
+
+bool AgentFetchJob::BindAgent(content::RenderFrameHost* render_frame_host) {
+  if (!render_frame_host || !render_frame_host->IsRenderFrameLive()) {
+    return false;
+  }
+  // Per document: a cross-document commit drops the old binding, so each
+  // commit binds anew.
+  render_frame_host->GetRemoteInterfaces()->GetInterface(
+      agent_.BindNewPipeAndPassReceiver());
+  return true;
+}
+
+void AgentFetchJob::DropDocumentWork() {
+  // The generation moves first: dropping the remote runs the pending
+  // replies' defaults at once, and they must find themselves stale.
+  ++generation_;
+  poll_timer_.Stop();
+  challenge_timer_.Stop();
+  navigation_wait_timer_.Stop();
+  waiting_for_navigation_ = false;
+  agent_.reset();
+}
+
+bool AgentFetchJob::EndIfAgentGone() {
+  // browser: a stale reply never gets here (DropDocumentWork and Finish move
+  // the generation first). The renderer drops a document's agent only when
+  // a commit replaces it, and that navigation was seen starting; with none
+  // in flight, nothing will rebind.
+  if (!navigations_in_flight_.empty()) {
+    return false;
+  }
+  Finish("error", "the page's renderer went away");
+  return true;
+}
+
+int AgentFetchJob::restarts() const {
+  return std::max(commits_ - 1, 0);
+}
+
+void AgentFetchJob::EnterChallenge(const AgentFetchVerdict& verdict,
+                                   int text_length) {
+  challenge_ = verdict;
+  challenge_active_ = true;
+  challenge_cleared_ = false;
+  challenge_ended_ = base::TimeTicks();
+  challenge_text_length_ = text_length;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // The cap runs from the first challenge commit, across restarts.
+  if (challenge_started_.is_null()) {
+    challenge_started_ = commit_time_.is_null() ? now : commit_time_;
+  }
+  interactive_since_ = verdict.IsInteractive() ? now : base::TimeTicks();
+  const base::TimeTicks give_up =
+      std::min(challenge_started_ + kChallengeCap, deadline_ - kReplyReserve);
+  challenge_timer_.Start(FROM_HERE, std::max(give_up - now, base::TimeDelta()),
+                         this, &AgentFetchJob::FinishChallenge);
+  PollMarkers();
+}
+
+void AgentFetchJob::LeaveChallenge() {
+  challenge_active_ = false;
+  challenge_cleared_ = true;
+  challenge_ended_ = base::TimeTicks::Now();
+  // browser: the document the clear leads to (committed now, or this one
+  // cleared in place) settles on a fresh budget; the check's wait must not
+  // starve it.
+  settle_budget_start_ = challenge_ended_;
+  interactive_since_ = base::TimeTicks();
+  poll_timer_.Stop();
+  challenge_timer_.Stop();
+}
+
+void AgentFetchJob::PollMarkers() {
+  if (finished_ || !agent_ || !challenge_active_) {
+    return;
+  }
+  agent_->Markers(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce(&AgentFetchJob::OnChallengeMarkers,
+                     weak_factory_.GetWeakPtr(), generation_),
+      nullptr));
+}
+
+void AgentFetchJob::OnChallengeMarkers(
+    int generation,
+    blink::mojom::AgentChallengeMarkersPtr markers) {
+  if (generation != generation_ || finished_ || !challenge_active_) {
+    return;
+  }
+  if (!markers) {
+    // The document is being replaced; its commit decides what comes next.
+    return;
+  }
+  std::optional<AgentFetchVerdict> dom =
+      DetectMarkerChallenge(*markers, CollectChallengeFrames(web_contents()));
+  if (dom && dom->IsBan()) {
+    markers_ = std::move(markers);
+    FinishBlocked(*dom);
+    return;
+  }
+
+  if (response_challenge_) {
+    // The response said so, and only a new commit clears it; the document
+    // adds detail (an interactive widget, DataDome's kind).
+    AgentFetchVerdict verdict = *response_challenge_;
+    if (dom) {
+      if (dom->IsInteractive()) {
+        verdict.kind = "interactive";
+      }
+      AppendEvidence(verdict, *dom);
+    }
+    challenge_ = std::move(verdict);
+  } else if (dom) {
+    challenge_ = std::move(*dom);
+  } else if (markers->text_length >
+             base::ClampAdd(challenge_text_length_, kClearedTextGrowth)) {
+    // The markers left and the text grew: cleared in place.
+    markers_ = std::move(markers);
+    LeaveChallenge();
+    StartSettle();
+    return;
+  }
+  markers_ = std::move(markers);
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (challenge_->IsInteractive()) {
+    // No point waiting long for a person who is not there.
+    if (interactive_since_.is_null()) {
+      interactive_since_ = now;
+    } else if (now - interactive_since_ >= kInteractiveGrace) {
+      FinishChallenge();
+      return;
+    }
+  } else {
+    interactive_since_ = base::TimeTicks();
+  }
+  poll_timer_.Start(FROM_HERE, kMarkersPoll, this, &AgentFetchJob::PollMarkers);
+}
+
+void AgentFetchJob::StartSettle() {
+  if (finished_ || !agent_) {
+    return;
+  }
+  // browser: params_.settle is one budget for a page whose documents replace
+  // one another (YouTube reloads itself with &themeRefresh=1), not a fresh
+  // cap per document: each document gets what is left of it since the
+  // budget began, but at least kMinDocumentSettle, and never more than
+  // params_.settle. The budget begins at the first commit and again when a
+  // bot check clears (LeaveChallenge).
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeTicks budget_start =
+      settle_budget_start_.is_null() ? now : settle_budget_start_;
+  base::TimeDelta cap = std::min(
+      params_.settle,
+      std::max(kMinDocumentSettle, params_.settle - (now - budget_start)));
+  // The call's timeout stays the hard cap.
+  cap = std::min(cap, deadline_ - now - kExtractReserve);
+  // Past the restart cap the job stops waiting on documents that keep
+  // replacing themselves and reads whatever is there.
+  if (restarts() > kMaxRestarts) {
+    cap = base::TimeDelta();
+  }
+  if (cap < base::Milliseconds(50)) {
+    CheckSettledDocument();
+    return;
+  }
+  settle_cap_ = cap;
+  auto options = blink::mojom::AgentSettleOptions::New();
+  options->cap_ms = static_cast<int32_t>(cap.InMilliseconds());
+  agent_->WaitForSettle(
+      std::move(options),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&AgentFetchJob::OnSettled, weak_factory_.GetWeakPtr(),
+                         generation_),
+          nullptr));
+}
+
+void AgentFetchJob::OnSettled(int generation,
+                              blink::mojom::AgentSettleReportPtr report) {
+  if (generation != generation_ || finished_) {
+    return;
+  }
+  if (!report) {
+    // Being replaced: the next commit rebinds and settles anew.
+    EndIfAgentGone();
+    return;
+  }
+  settle_report_ = std::move(report);
+  settle_time_ = base::TimeTicks::Now();
+  CheckSettledDocument();
+}
+
+void AgentFetchJob::CheckSettledDocument() {
+  if (finished_ || !agent_) {
+    return;
+  }
+  // The DOM markers mean little at commit, before the document has parsed;
+  // they are read once it has settled.
+  agent_->Markers(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce(&AgentFetchJob::OnSettledMarkers,
+                     weak_factory_.GetWeakPtr(), generation_),
+      nullptr));
+}
+
+void AgentFetchJob::OnSettledMarkers(
+    int generation,
+    blink::mojom::AgentChallengeMarkersPtr markers) {
+  if (generation != generation_ || finished_) {
+    return;
+  }
+  if (!markers) {
+    EndIfAgentGone();
+    return;
+  }
+  std::optional<AgentFetchVerdict> dom =
+      DetectMarkerChallenge(*markers, CollectChallengeFrames(web_contents()));
+  const int text_length = markers->text_length;
+  markers_ = std::move(markers);
+  if (dom) {
+    if (dom->IsBan()) {
+      FinishBlocked(*dom);
+      return;
+    }
+    if (restarts() > kMaxRestarts) {
+      challenge_ = std::move(dom);
+      challenge_cleared_ = false;
+      FinishChallenge();
+      return;
+    }
+    EnterChallenge(*dom, text_length);
+    return;
+  }
+  WaitForNavigationThenExtract();
+}
+
+void AgentFetchJob::WaitForNavigationThenExtract() {
+  // Follow early client redirects: while the page has a
+  // navigation of its own in flight, this document is about to go. Its
+  // commit restarts settle on the new document (DropDocumentWork ends the
+  // wait); if it goes nowhere, or takes too long, this document is read.
+  const base::TimeDelta wait = std::min(
+      kNavigationWait, deadline_ - base::TimeTicks::Now() - kExtractReserve);
+  if (navigations_in_flight_.empty() || restarts() > kMaxRestarts ||
+      !wait.is_positive()) {
+    StartExtract();
+    return;
+  }
+  waiting_for_navigation_ = true;
+  navigation_wait_timer_.Start(FROM_HERE, wait, this,
+                               &AgentFetchJob::OnNavigationWaitOver);
+}
+
+void AgentFetchJob::OnNavigationWaitOver() {
+  if (!waiting_for_navigation_) {
+    return;
+  }
+  waiting_for_navigation_ = false;
+  navigation_wait_timer_.Stop();
+  StartExtract();
+}
+
+void AgentFetchJob::StartExtract() {
+  if (finished_ || !agent_) {
+    return;
+  }
+  auto options = blink::mojom::AgentExtractOptions::New();
+  options->max_markdown_chars = kMarkdownChars;
+  // Every link comes back with its in_markdown flag; the reply filters. A
+  // call that asked for every link has the renderer look further.
+  options->want_links = true;
+  if (params_.want_links) {
+    options->max_links = kAllLinks;
+  }
+  agent_->Extract(std::move(options),
+                  mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                      base::BindOnce(&AgentFetchJob::OnExtracted,
+                                     weak_factory_.GetWeakPtr(), generation_),
+                      nullptr));
+}
+
+void AgentFetchJob::OnExtracted(int generation,
+                                blink::mojom::AgentExtractionPtr extraction) {
+  if (generation != generation_ || finished_) {
+    return;
+  }
+  if (!extraction) {
+    EndIfAgentGone();
+    return;
+  }
+  extract_time_ = base::TimeTicks::Now();
+  extraction_ = std::move(extraction);
+
+  std::string title;
+  std::string head;
+  int text_length = 0;
+  if (markers_) {
+    title = markers_->title;
+    head = markers_->head;
+    text_length = markers_->text_length;
+  } else {
+    title = extraction_->title;
+    head = base::CollapseWhitespaceASCII(
+        std::string_view(extraction_->markdown)
+            .substr(0, std::min(extraction_->markdown.size(), kHeadChars)),
+        false);
+    text_length = extraction_->visible_text_length;
+  }
+  if (std::optional<AgentFetchVerdict> block =
+          DetectBlock(response_.status.value_or(0), response_.headers, title,
+                      head, text_length)) {
+    FinishBlocked(*block);
+    return;
+  }
+  Finish("ok", std::nullopt);
+}
+
+void AgentFetchJob::RunApiFetch() {
+  if (finished_ || !agent_) {
+    return;
+  }
+  auto request = blink::mojom::AgentApiRequest::New();
+  request->url = params_.url.spec();
+  request->method = params_.method;
+  for (const auto& [name, value] : params_.headers) {
+    request->header_names.push_back(name);
+    request->header_values.push_back(value);
+  }
+  request->has_body = params_.body.has_value();
+  request->body = params_.body.value_or(std::string());
+  const int64_t left_ms =
+      (deadline_ - base::TimeTicks::Now() - kReplyReserve).InMilliseconds();
+  request->timeout_ms = static_cast<int32_t>(std::max<int64_t>(left_ms, 1000));
+  request->max_body_bytes = kApiMaxBodyBytes;
+  agent_->RunFetch(std::move(request),
+                   mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                       base::BindOnce(&AgentFetchJob::OnApiResponse,
+                                      weak_factory_.GetWeakPtr(), generation_),
+                       nullptr));
+}
+
+void AgentFetchJob::OnApiResponse(int generation,
+                                  blink::mojom::AgentApiResponsePtr response) {
+  if (generation != generation_ || finished_) {
+    return;
+  }
+  fetch_time_ = base::TimeTicks::Now();
+  if (!response) {
+    // No commit re-runs the call, so it ends either way.
+    if (!EndIfAgentGone()) {
+      Finish("error", "the API call's document went away");
+    }
+    return;
+  }
+  if (!response->ok) {
+    // A CORS failure or a network error: fetch()'s TypeError.
+    Finish("error", response->error.empty() ? std::string("fetch failed")
+                                            : ValidUTF8(response->error));
+    return;
+  }
+
+  response_ = Response();
+  response_.status = response->status;
+  response_.final_url = GURL(response->url);
+  response_.redirected = response->redirected;
+  const size_t count =
+      std::min(response->header_names.size(), response->header_values.size());
+  for (size_t i = 0; i < count; ++i) {
+    AddHeader(response_.headers, response->header_names[i],
+              response->header_values[i]);
+  }
+  std::string mime;
+  std::string charset;
+  if (auto it = response_.headers.find("content-type");
+      it != response_.headers.end()) {
+    bool had_charset = false;
+    net::HttpUtil::ParseContentType(it->second, &mime, &charset, &had_charset,
+                                    nullptr);
+  }
+  response_.mime_type = base::ToLowerASCII(mime);
+  response_.charset = base::ToLowerASCII(charset);
+  api_truncated_ = response->truncated;
+
+  // The renderer was asked for at most kApiMaxBodyBytes.
+  base::span<const uint8_t> body = response->body.byte_span();
+  if (body.size() > static_cast<size_t>(kApiMaxBodyBytes)) {
+    body = body.first(static_cast<size_t>(kApiMaxBodyBytes));
+    api_truncated_ = true;
+  }
+  std::string bytes(base::as_string_view(body));
+  AgentFetchBodySink::Options options;
+  options.url = response_.final_url;
+  options.mime_type = response_.mime_type;
+  // An API answer without a type is most often text.
+  if (options.mime_type.empty() &&
+      base::IsStringUTF8AllowingNoncharacters(bytes)) {
+    options.mime_type = "text/plain";
+  }
+  options.charset = response_.charset;
+  if (auto it = response_.headers.find("content-disposition");
+      it != response_.headers.end()) {
+    options.content_disposition = it->second;
+  }
+  options.save_to = params_.save_to;
+  options.default_dir = fetcher_->save_dir();
+  options.part_tag = params_.fetch_id;
+  options.may_write_files = fetcher_->may_write_local_files();
+  body_taken_ = true;
+  sink_ = AgentFetchBodySink::ForBytes(
+      std::move(options), std::move(bytes),
+      base::BindOnce(&AgentFetchJob::OnBodyDone, weak_factory_.GetWeakPtr()));
+}
+
+void AgentFetchJob::OnBodyDone(AgentFetchBody body) {
+  if (finished_) {
+    return;
+  }
+  body_ = std::move(body);
+  if (api_truncated_) {
+    body_->truncated = true;
+  }
+  if (body_->net_error != net::OK) {
+    Finish("error", net::ErrorToShortString(body_->net_error));
+    return;
+  }
+  const int status = response_.status.value_or(0);
+  // Raw bytes run no script, so nothing waits a bot check through here.
+  if (std::optional<AgentFetchVerdict> challenge =
+          DetectResponseChallenge(status, response_.headers,
+                                  response_.final_url, response_.redirected)) {
+    challenge_ = std::move(challenge);
+    challenge_active_ = false;
+    challenge_cleared_ = false;
+    challenge_started_ = base::TimeTicks();
+    challenge_ended_ = base::TimeTicks();
+    FinishChallenge();
+    return;
+  }
+  std::string head;
+  int text_length = 0;
+  if (body_->text) {
+    const std::string& text = *body_->text;
+    text_length = static_cast<int>(std::min<size_t>(text.size(), INT_MAX));
+    head = base::CollapseWhitespaceASCII(
+        std::string_view(text).substr(0, std::min(text.size(), kHeadChars)),
+        false);
+  }
+  // A body that is not a page gets the vendor rules only: an ordinary API
+  // error (a 403 "Forbidden", a 429) is the caller's to name.
+  std::optional<AgentFetchVerdict> block =
+      body_->kind == "html" ? DetectBlock(status, response_.headers,
+                                          std::string_view(), head, text_length)
+                            : DetectVendorBlock(status, response_.headers,
+                                                std::string_view(), head);
+  if (block) {
+    FinishBlocked(*block);
+    return;
+  }
+  Finish("ok", std::nullopt);
+}
+
+void AgentFetchJob::OnTimeout() {
+  Finish("timeout",
+         base::StrCat({"no answer within ",
+                       base::NumberToString(params_.timeout.InMilliseconds()),
+                       " ms"}));
+}
+
+void AgentFetchJob::FinishChallenge() {
+  Finish("challenge", std::nullopt);
+}
+
+void AgentFetchJob::FinishBlocked(const AgentFetchVerdict& verdict) {
+  block_ = verdict;
+  Finish("blocked", std::nullopt);
+}
+
+void AgentFetchJob::Finish(const std::string& outcome,
+                           std::optional<std::string> error) {
+  if (finished_) {
+    return;
+  }
+  finished_ = true;
+  // Replies still in flight are stale from here on. The remote and the sink
+  // stay until the job is destroyed: this may run inside their callbacks.
+  ++generation_;
+  timeout_timer_.Stop();
+  poll_timer_.Stop();
+  challenge_timer_.Stop();
+  navigation_wait_timer_.Stop();
+  waiting_for_navigation_ = false;
+  if (challenge_active_ && challenge_ended_.is_null()) {
+    challenge_ended_ = base::TimeTicks::Now();
+  }
+  SendReply(outcome, std::move(error));
+  callback_.reset();
+  // browser: torn down from a posted task, never inside a WebContents
+  // observer or mojo callback.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&AgentFetcher::OnJobDone,
+                     fetcher_->weak_factory_.GetWeakPtr(), params_.fetch_id));
+}
+
+void AgentFetchJob::SendReply(const std::string& outcome,
+                              std::optional<std::string> error) {
+  if (!callback_) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+
+  // The response.
+  std::unique_ptr<protocol::Array<protocol::Browser::AgentFetchRedirect>>
+      redirects;
+  if (!response_.redirects.empty()) {
+    redirects = std::make_unique<
+        protocol::Array<protocol::Browser::AgentFetchRedirect>>();
+    for (const Hop& hop : response_.redirects) {
+      redirects->push_back(protocol::Browser::AgentFetchRedirect::Create()
+                               .SetUrl(ValidUTF8(hop.url))
+                               .SetStatus(hop.status)
+                               .Build());
+    }
+  }
+  std::optional<std::string> final_url;
+  if (response_.final_url.is_valid()) {
+    final_url = ValidUTF8(response_.final_url.spec());
+  }
+  std::optional<std::string> content_type;
+  if (!response_.mime_type.empty()) {
+    content_type = ValidUTF8(response_.mime_type);
+  }
+  std::optional<std::string> charset;
+  if (body_ && !body_->charset.empty()) {
+    charset = ValidUTF8(body_->charset);
+  } else if (!response_.charset.empty()) {
+    charset = ValidUTF8(response_.charset);
+  }
+  std::unique_ptr<protocol::DictionaryValue> headers;
+  if (response_.status) {
+    base::DictValue dict;
+    for (const auto& [name, value] : response_.headers) {
+      dict.Set(name, value);
+    }
+    headers = std::make_unique<protocol::DictionaryValue>(std::move(dict));
+  }
+  std::string kind = "none";
+  if (body_) {
+    kind = body_->kind;
+  } else if (body_taken_) {
+    // A body still being read (the call timed out or was cancelled): its
+    // type says what it is, whatever page the fetch had left behind.
+    kind = AgentFetchBodySink::KindForMimeType(response_.mime_type);
+  } else if (!params_.IsApiCall() && document_committed_) {
+    kind = "html";
+  }
+
+  // The page.
+  std::optional<std::string> title;
+  std::optional<std::string> lang;
+  std::optional<bool> readerable;
+  std::optional<std::string> extractor;
+  std::optional<std::string> markdown;
+  std::unique_ptr<protocol::Array<protocol::Browser::AgentFetchOutlineItem>>
+      outline;
+  std::unique_ptr<protocol::DictionaryValue> facts;
+  std::unique_ptr<protocol::Array<protocol::Browser::AgentFetchLink>> links;
+  std::unique_ptr<protocol::DictionaryValue> signals;
+  std::optional<bool> truncated;
+  if (extraction_) {
+    title = ReplyString(extraction_->title);
+    if (!extraction_->lang.empty()) {
+      lang = ReplyString(extraction_->lang);
+    }
+    readerable = extraction_->readerable;
+    extractor = ValidUTF8(extraction_->extractor);
+    markdown =
+        ValidUTF8OrNote(std::move(extraction_->markdown), "page's markdown");
+    outline = std::make_unique<
+        protocol::Array<protocol::Browser::AgentFetchOutlineItem>>();
+    for (const auto& item : extraction_->outline) {
+      if (!item) {
+        continue;
+      }
+      outline->push_back(protocol::Browser::AgentFetchOutlineItem::Create()
+                             .SetLevel(item->level)
+                             .SetText(ReplyString(item->text))
+                             .SetOffset(item->offset)
+                             .Build());
+    }
+    std::optional<base::DictValue> parsed_facts = base::JSONReader::ReadDict(
+        extraction_->facts_json, base::JSON_PARSE_RFC);
+    if (parsed_facts) {
+      for (auto [key, value] : *parsed_facts) {
+        CutReplyStrings(value);
+      }
+    }
+    facts = std::make_unique<protocol::DictionaryValue>(
+        parsed_facts ? std::move(*parsed_facts) : base::DictValue());
+    if (!extraction_->canonical.empty() && !facts->Find("canonical")) {
+      facts->Set("canonical",
+                 ReplyString(extraction_->canonical, kMaxReplyUrlBytes));
+    }
+    links =
+        std::make_unique<protocol::Array<protocol::Browser::AgentFetchLink>>();
+    for (const auto& link : extraction_->links) {
+      // Without `links`, only the ones the markdown carries.
+      if (!link || (!params_.want_links && !link->in_markdown)) {
+        continue;
+      }
+      links->push_back(protocol::Browser::AgentFetchLink::Create()
+                           .SetUrl(ReplyString(link->url, kMaxReplyUrlBytes))
+                           .SetText(ReplyString(link->text))
+                           .SetRegion(ReplyString(link->region))
+                           .SetInMarkdown(link->in_markdown)
+                           .Build());
+    }
+    truncated = extraction_->truncated;
+  } else if (markers_ && !markers_->title.empty()) {
+    // A bot check's page: its title is evidence too.
+    title = ReplyString(markers_->title);
+  }
+  if (extraction_ || settle_report_) {
+    base::DictValue dict;
+    if (extraction_) {
+      std::optional<base::DictValue> parsed = base::JSONReader::ReadDict(
+          extraction_->signals_json, base::JSON_PARSE_RFC);
+      if (parsed) {
+        dict = std::move(*parsed);
+      }
+    }
+    if (settle_report_) {
+      base::DictValue settle;
+      settle.Set("reason", ValidUTF8(settle_report_->reason));
+      settle.Set("waitedMs", settle_report_->waited_ms);
+      // This document's share of the settle budget.
+      settle.Set("capMs", static_cast<int>(settle_cap_.InMilliseconds()));
+      settle.Set("dclFired", settle_report_->dcl_fired);
+      settle.Set("loadFired", settle_report_->load_fired);
+      settle.Set("textLength", settle_report_->text_length);
+      settle.Set("textNodes", settle_report_->text_nodes);
+      settle.Set("activeRequests", settle_report_->active_requests);
+      settle.Set("visible", settle_report_->visible);
+      settle.Set("readyState", ValidUTF8(settle_report_->ready_state));
+      dict.Set("settle", std::move(settle));
+    }
+    dict.Set("restarts", restarts());
+    signals = std::make_unique<protocol::DictionaryValue>(std::move(dict));
+  }
+
+  // The verdict.
+  std::unique_ptr<protocol::DictionaryValue> challenge;
+  if (outcome == "blocked" && block_) {
+    challenge = std::make_unique<protocol::DictionaryValue>(block_->ToDict());
+  } else if (challenge_) {
+    base::DictValue dict = challenge_->ToDict();
+    dict.Set("cleared", challenge_cleared_ && outcome != "challenge");
+    const base::TimeTicks end =
+        challenge_ended_.is_null() ? now : challenge_ended_;
+    dict.Set(
+        "waitedMs",
+        challenge_started_.is_null()
+            ? 0
+            : static_cast<int>((end - challenge_started_).InMilliseconds()));
+    challenge = std::make_unique<protocol::DictionaryValue>(std::move(dict));
+  }
+
+  // A body read as it is.
+  std::optional<std::string> text;
+  std::optional<std::string> saved_to;
+  std::optional<double> bytes;
+  if (body_) {
+    if (body_->text) {
+      text = ValidUTF8OrNote(std::move(*body_->text), "body");
+    }
+    if (!body_->saved_to.empty()) {
+      saved_to = ValidUTF8(body_->saved_to.AsUTF8Unsafe());
+    }
+    bytes = static_cast<double>(body_->bytes);
+    truncated = body_->truncated;
+    if (!body_->file_error.empty() && !error) {
+      error = body_->file_error;
+    }
+  }
+
+  // Milliseconds from the call.
+  auto since_call = [this](base::TimeTicks time) {
+    return static_cast<int>((time - created_).InMilliseconds());
+  };
+  base::DictValue timings;
+  if (!navigate_time_.is_null()) {
+    timings.Set("navigate", since_call(navigate_time_));
+  }
+  // A page that replaced itself: when its first document committed (commit
+  // is the last one's).
+  if (restarts() > 0 && !first_commit_time_.is_null()) {
+    timings.Set("firstCommit", since_call(first_commit_time_));
+  }
+  if (!commit_time_.is_null()) {
+    timings.Set("commit", since_call(commit_time_));
+  }
+  if (settle_report_ && settle_report_->dcl_fired && !dcl_time_.is_null()) {
+    timings.Set("dcl", since_call(dcl_time_));
+  }
+  if (!settle_time_.is_null()) {
+    timings.Set("settle", since_call(settle_time_));
+  }
+  if (!extract_time_.is_null()) {
+    timings.Set("extract", since_call(extract_time_));
+  }
+  if (!fetch_time_.is_null()) {
+    timings.Set("fetch", since_call(fetch_time_));
+  }
+  timings.Set("total", since_call(now));
+  timings.Set("restarts", restarts());
+
+  callback_->sendSuccess(
+      outcome, std::move(error), response_.status, std::move(final_url),
+      std::move(redirects), std::move(content_type), std::move(charset),
+      std::move(headers), kind, std::move(title), std::move(lang), readerable,
+      std::move(extractor), std::move(markdown), std::move(outline),
+      std::move(facts), std::move(links), std::move(signals),
+      std::move(challenge), std::move(text), std::move(saved_to), bytes,
+      truncated,
+      std::make_unique<protocol::DictionaryValue>(std::move(timings)));
+}
