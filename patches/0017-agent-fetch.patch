+constexpr int kEmitNodeBudget = 300000;
+constexpr int kMaxEmitDepth = 128;
+// browser: a whole listing page (a front page laid out as one long table)
+// fits; the markdown cap bounds the size, and EmitTable stops collecting
+// rows once they would overrun it.
+constexpr wtf_size_t kTableMaxRows = 1000;
+constexpr wtf_size_t kTableMaxColumns = 30;
+// IsLayoutTable decides from the header and this many rows, so the check
+// costs the same whatever kTableMaxRows is.
+constexpr wtf_size_t kLayoutTableSampleRows = 50;
+constexpr wtf_size_t kOutlineTextLength = 300;
+// A hard line break (<br>) inside a paragraph's inline text, until the
+// paragraph is written out.
+constexpr UChar kBreak = 0x0001;
+
+// Links.
+constexpr int kMaxLinks = 5000;
+constexpr wtf_size_t kLinkTextLength = 200;
+
+// RunFetch.
+constexpr int32_t kMaxBodyBytes = 64 * 1024 * 1024;
+constexpr int32_t kDefaultFetchTimeoutMs = 30000;
+constexpr int32_t kMaxFetchTimeoutMs = 300000;
+
+// ---------------------------------------------------------------------------
+// Strings.
+
+// Mojo refuses a null WTF::String in a non-nullable string field.
+String NonNull(const String& value) {
+  return value.IsNull() ? g_empty_string : value;
+}
+
+bool IsSpaceChar(UChar c) {
+  return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' ||
+         c == 0x0B || c == 0x00A0 || c == 0x1680 ||
+         (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 ||
+         c == 0x202F || c == 0x205F || c == 0x3000;
+}
+
+bool IsWordChar(UChar c) {
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+         (c >= '0' && c <= '9') || c == '_';
+}
+
+// Text as a reader sees it: every run of spaces one space, ends trimmed.
+// Zero-width spaces, byte-order marks, soft hyphens and private-use icon
+// glyphs go (as in the collector's CleanName). With `keep_breaks`, kBreak
+// survives as a line break (at most two in a row, none at the ends);
+// otherwise it counts as a space.
+String Collapse(const String& raw, bool keep_breaks) {
+  if (raw.empty()) {
+    return g_empty_string;
+  }
+  StringBuilder out;
+  out.ReserveCapacity(raw.length());
+  bool space = false;
+  int breaks = 0;
+  for (wtf_size_t i = 0; i < raw.length(); ++i) {
+    const UChar c = raw[i];
+    // Planes 15 and 16 are private use too: a surrogate pair whose high half
+    // is U+DB80..U+DBFF.
+    if (c >= 0xDB80 && c <= 0xDBFF && i + 1 < raw.length() &&
+        (raw[i + 1] & 0xFC00) == 0xDC00) {
+      ++i;
+      continue;
+    }
+    if ((c >= 0xE000 && c <= 0xF8FF) || c == 0x200B || c == 0xFEFF ||
+        c == 0x00AD) {
+      continue;
+    }
+    if (c == kBreak) {
+      if (!keep_breaks) {
+        space = true;
+        continue;
+      }
+      space = false;
+      if (!out.empty() && breaks < 2) {
+        out.Append(kBreak);
+        ++breaks;
+      }
+      continue;
+    }
+    if (IsSpaceChar(c)) {
+      space = true;
+      continue;
+    }
+    if (space && !out.empty() && !breaks) {
+      out.Append(' ');
+    }
+    space = false;
+    breaks = 0;
+    out.Append(c);
+  }
+  wtf_size_t end = out.length();
+  while (end && out[end - 1] == kBreak) {
+    --end;
+  }
+  out.Resize(end);
+  return out.ToString();
+}
+
+// The length of `raw` with its whitespace collapsed and trimmed, without
+// building the string. Unlike Collapse(), it keeps invisible characters.
+wtf_size_t CollapsedLength(const String& raw) {
+  wtf_size_t length = 0;
+  bool space = false;
+  for (wtf_size_t i = 0; i < raw.length(); ++i) {
+    if (IsSpaceChar(raw[i])) {
+      space = true;
+      continue;
+    }
+    if (space && length) {
+      ++length;
+    }
+    space = false;
+    ++length;
+  }
+  return length;
+}
+
+// At most `max` code units, never between the halves of a surrogate pair.
+String Truncate(const String& value, wtf_size_t max) {
+  if (value.length() <= max) {
+    return value;
+  }
+  wtf_size_t cut = max;
+  if (cut && (value[cut - 1] & 0xFC00) == 0xD800) {
+    --cut;
+  }
+  return value.substr(0, cut);
+}
+
+// Reads a URL-valued attribute resolved against the document base URL (as
+// in the collector): guarded by the element's own IsURLAttribute, because
+// Element::GetURLAttribute DCHECKs on a non-URL attribute.
+String UrlAttribute(const Element* element, const QualifiedName& name) {
+  if (!element->FastHasAttribute(name)) {
+    return String();
+  }
+  const Attribute* attribute = element->Attributes().Find(name);
+  if (!attribute || !element->IsURLAttribute(*attribute)) {
+    return String();
+  }
+  return element->GetURLAttribute(name);
+}
+
+// The first `limit` code units of an element's own text, read from its Text
+// children without building the whole of a large script's text.
+String ChildText(const Element& element, wtf_size_t limit) {
+  StringBuilder out;
+  for (Node* child = element.firstChild(); child && out.length() < limit;
+       child = child->nextSibling()) {
+    if (auto* text = DynamicTo<Text>(child)) {
+      const String& data = text->data();
+      out.Append(StringView(
+          data, 0, std::min<wtf_size_t>(data.length(), limit - out.length())));
+    }
+  }
+  return out.ToString();
+}
+
+// The word characters after `key` in `text` ('rt':'i' -> i), or "".
+String QuotedField(const String& text, const char* key) {
+  const wtf_size_t at = text.find(key);
+  if (at == kNotFound) {
+    return g_empty_string;
+  }
+  const wtf_size_t begin = at + static_cast<wtf_size_t>(std::strlen(key));
+  wtf_size_t end = begin;
+  while (end < text.length() && end - begin < 32 && IsWordChar(text[end])) {
+    ++end;
+  }
+  return text.substr(begin, end - begin);
+}
+
+bool HostIs(const String& host, const char* domain) {
+  if (host == domain) {
+    return true;
+  }
+  StringBuilder suffix;
+  suffix.Append('.');
+  suffix.Append(domain);
+  return host.ends_with(suffix.ReleaseString());
+}
+
+// ---------------------------------------------------------------------------
+// Elements.
+
+bool HasAnyTag(const Element& element,
+               base::span<const HTMLQualifiedName* const> tags) {
+  for (const HTMLQualifiedName* tag : tags) {
+    if (element.HasTagName(*tag)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Never content: code, style, metadata, form controls, embedded content.
+base::span<const HTMLQualifiedName* const> SkippedTags() {
+  static const HTMLQualifiedName* const kTags[] = {
+      &html_names::kScriptTag,   &html_names::kStyleTag,
+      &html_names::kTemplateTag, &html_names::kNoscriptTag,
+      &html_names::kHeadTag,     &html_names::kTitleTag,
+      &html_names::kMetaTag,     &html_names::kLinkTag,
+      &html_names::kBaseTag,     &html_names::kSelectTag,
+      &html_names::kOptionTag,   &html_names::kOptgroupTag,
+      &html_names::kDatalistTag, &html_names::kButtonTag,
+      &html_names::kInputTag,    &html_names::kTextareaTag,
+      &html_names::kIFrameTag,   &html_names::kFrameTag,
+      &html_names::kFramesetTag, &html_names::kObjectTag,
+      &html_names::kEmbedTag,    &html_names::kCanvasTag,
+      &html_names::kVideoTag,    &html_names::kAudioTag,
+      &html_names::kSourceTag,   &html_names::kTrackTag,
+      &html_names::kMapTag};
+  return kTags;
+}
+
+// Block-level by their HTML semantics, whatever their CSS.
+base::span<const HTMLQualifiedName* const> BlockTags() {
+  static const HTMLQualifiedName* const kTags[] = {
+      &html_names::kAddressTag,    &html_names::kArticleTag,
+      &html_names::kAsideTag,      &html_names::kBlockquoteTag,
+      &html_names::kBodyTag,       &html_names::kCaptionTag,
+      &html_names::kCenterTag,     &html_names::kDdTag,
+      &html_names::kDetailsTag,    &html_names::kDialogTag,
+      &html_names::kDivTag,        &html_names::kDlTag,
+      &html_names::kDtTag,         &html_names::kFieldsetTag,
+      &html_names::kFigcaptionTag, &html_names::kFigureTag,
+      &html_names::kFooterTag,     &html_names::kFormTag,
+      &html_names::kH1Tag,         &html_names::kH2Tag,
+      &html_names::kH3Tag,         &html_names::kH4Tag,
+      &html_names::kH5Tag,         &html_names::kH6Tag,
+      &html_names::kHeaderTag,     &html_names::kHgroupTag,
+      &html_names::kHrTag,         &html_names::kLegendTag,
+      &html_names::kLiTag,         &html_names::kMainTag,
+      &html_names::kMenuTag,       &html_names::kNavTag,
+      &html_names::kOlTag,         &html_names::kPTag,
+      &html_names::kPreTag,        &html_names::kSectionTag,
+      &html_names::kSummaryTag,    &html_names::kTableTag,
+      &html_names::kTbodyTag,      &html_names::kTdTag,
+      &html_names::kTfootTag,      &html_names::kThTag,
+      &html_names::kTheadTag,      &html_names::kTrTag,
