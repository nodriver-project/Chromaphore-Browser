+// browser: Browser.agentFetch and agentFetchCancel (agent-fetch).
+void BrowserHandler::AgentFetch(
+    const std::string& in_url,
+    std::optional<std::string> in_mode,
+    std::optional<std::string> in_method,
+    std::unique_ptr<protocol::DictionaryValue> in_headers,
+    std::optional<std::string> in_body,
+    std::optional<std::string> in_referrer,
+    std::optional<int> in_timeoutMs,
+    std::optional<int> in_settleMs,
+    std::optional<std::string> in_saveTo,
+    std::optional<bool> in_links,
+    std::optional<std::string> in_fetchId,
+    std::unique_ptr<AgentFetchCallback> callback) {
+  if (!is_browser_target_) {
+    // The same answer content gives for a command a session does not have.
+    callback->sendFailure(
+        Response::MethodNotFound("'Browser.agentFetch' wasn't found"));
+    return;
+  }
+
+  AgentFetchParams params;
+  params.url = GURL(in_url);
+  if (!params.url.is_valid() || !params.url.SchemeIsHTTPOrHTTPS()) {
+    callback->sendFailure(Response::InvalidParams("url must be http or https"));
+    return;
+  }
+
+  const std::string mode = in_mode.value_or("auto");
+  if (mode == "raw") {
+    params.mode = AgentFetchParams::Mode::kRaw;
+  } else if (mode != "auto") {
+    callback->sendFailure(Response::InvalidParams("mode must be auto or raw"));
+    return;
+  }
+
+  if (in_method) {
+    // What fetch() does: these six are upper-cased whatever their case; any
+    // other method goes out exactly as given.
+    params.method = *in_method;
+    for (std::string_view standard :
+         {"DELETE", "GET", "HEAD", "OPTIONS", "POST", "PUT"}) {
+      if (base::EqualsCaseInsensitiveASCII(params.method, standard)) {
+        params.method = std::string(standard);
+        break;
+      }
+    }
+    if (!net::HttpUtil::IsToken(params.method)) {
+      callback->sendFailure(Response::InvalidParams("method is not a token"));
+      return;
+    }
+    // What fetch() refuses too, in any case.
+    if (base::EqualsCaseInsensitiveASCII(params.method, "CONNECT") ||
+        base::EqualsCaseInsensitiveASCII(params.method, "TRACE") ||
+        base::EqualsCaseInsensitiveASCII(params.method, "TRACK")) {
+      callback->sendFailure(Response::InvalidParams("method is not allowed"));
+      return;
+    }
+  }
+
+  if (in_headers) {
+    for (auto [name, value] : *in_headers) {
+      if (!value.is_string()) {
+        callback->sendFailure(
+            Response::InvalidParams("headers values must be strings"));
+        return;
+      }
+      if (!net::HttpUtil::IsValidHeaderName(name) ||
+          !net::HttpUtil::IsValidHeaderValue(value.GetString())) {
+        callback->sendFailure(
+            Response::InvalidParams("headers holds an invalid header"));
+        return;
+      }
+      if (IsReservedAgentFetchHeader(name)) {
+        // Dropped rather than refused: an agent copying a browser's request
+        // should still get its call made.
+        continue;
+      }
+      params.headers.emplace_back(name, value.GetString());
+    }
+  }
+
+  if (in_body) {
+    if (params.method == "GET" || params.method == "HEAD") {
+      callback->sendFailure(Response::InvalidParams(
+          "a body needs a method other than GET or HEAD"));
+      return;
+    }
+    if (in_body->size() > kMaxAgentFetchBodyBytes) {
+      callback->sendFailure(
+          Response::InvalidParams("body is larger than 16 MiB"));
+      return;
+    }
+    params.body = std::move(*in_body);
+  }
+
+  if (in_referrer) {
+    params.referrer = GURL(*in_referrer);
+    if (!params.referrer.is_valid() || !params.referrer.SchemeIsHTTPOrHTTPS()) {
+      callback->sendFailure(
+          Response::InvalidParams("referrer must be http or https"));
+      return;
+    }
+  }
+
+  params.timeout =
+      base::Milliseconds(std::clamp(in_timeoutMs.value_or(30000), 1000, 60000));
+  params.settle =
+      base::Milliseconds(std::clamp(in_settleMs.value_or(10000), 500, 30000));
+
+  if (in_saveTo && !in_saveTo->empty()) {
+    if (!may_write_local_files_) {
+      callback->sendFailure(
+          Response::ServerError("saveTo is not allowed for this client"));
+      return;
+    }
+    params.save_to = base::FilePath::FromUTF8Unsafe(*in_saveTo);
+    if (!params.save_to.IsAbsolute()) {
+      callback->sendFailure(
+          Response::InvalidParams("saveTo must be an absolute path"));
+      return;
+    }
+  }
+
+  params.want_links = in_links.value_or(false);
+  if (in_fetchId) {
+    params.fetch_id = std::move(*in_fetchId);
+  }
+
+  // A fetcher whose profile went away is dead; the next call gets a new one,
+  // never on a profile that is already shutting down (it would not be told
+  // again that it is going, and its pages would outlive it).
+  if (!agent_fetcher_ || !agent_fetcher_->profile()) {
+    content::BrowserContext* context =
+        DevToolsBrowserContextManager::GetInstance().GetDefaultBrowserContext();
+    if (!context || context->ShutdownStarted()) {
+      callback->sendFailure(Response::ServerError("No browser context"));
+      return;
+    }
+    agent_fetcher_ = std::make_unique<AgentFetcher>(
+        Profile::FromBrowserContext(context), may_write_local_files_);
+  }
+  agent_fetcher_->Fetch(std::move(params), std::move(callback));
+}
+
+Response BrowserHandler::AgentFetchCancel(const std::string& in_fetchId,
+                                          bool* out_cancelled) {
+  if (!is_browser_target_) {
+    return Response::MethodNotFound("'Browser.agentFetchCancel' wasn't found");
+  }
+  *out_cancelled = agent_fetcher_ && agent_fetcher_->Cancel(in_fetchId);
+  return Response::Success();
+}
+
+// browser: Browser.startRecording, stopRecording, recordingMask,
+// recordingStatus and recordingEnded (recording).
+Response BrowserHandler::StartRecording(
+    const std::string& in_level,
+    std::optional<std::string> in_path,
+    std::optional<int> in_minutes,
+    std::unique_ptr<protocol::DictionaryValue> in_mask,
+    std::optional<int> in_maxTextBodyBytes,
+    std::optional<int> in_maxBinaryBodyBytes,
+    std::optional<int> in_maxFrameBytes,
+    std::optional<int> in_maxTotalBytes,
+    std::string* out_recordingId,
+    std::string* out_path,
+    double* out_endsAt) {
+  if (!is_browser_target_) {
+    return Response::MethodNotFound("'Browser.startRecording' wasn't found");
+  }
+  if (in_level != "network" && in_level != "full") {
+    return Response::InvalidParams("level must be network or full");
+  }
+
+  RecordingRegistry::Request request;
+  request.level = in_level;
+  if (in_path && !in_path->empty()) {
+    if (!may_write_local_files_) {
+      return Response::ServerError("path is not allowed for this client");
+    }
+    request.dir = base::FilePath::FromUTF8Unsafe(*in_path);
+    if (!request.dir.IsAbsolute()) {
+      return Response::InvalidParams("path must be an absolute path");
+    }
+  } else {
+    content::BrowserContext* context =
+        DevToolsBrowserContextManager::GetInstance().GetDefaultBrowserContext();
+    if (!context || context->ShutdownStarted()) {
+      return Response::ServerError("No browser context");
+    }
+    request.dir =
+        Profile::FromBrowserContext(context)
+            ->GetPath()
+            .AppendASCII("recordings")
+            .AppendASCII("rec-" +
+                         base::NumberToString(
+                             base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  }
+
+  request.limit = base::Minutes(std::clamp(in_minutes.value_or(15), 1, 120));
+  std::string error;
+  if (!ReadRecordingMasks(in_mask.get(), &request.masks, &error)) {
+    return Response::InvalidParams(error);
+  }
+  // A limit the caller left out keeps its Recording::Caps default.
+  Recording::Caps& caps = request.caps;
+  caps.max_text_body_bytes =
+      RecordingCap(in_maxTextBodyBytes, caps.max_text_body_bytes);
+  caps.max_binary_body_bytes =
+      RecordingCap(in_maxBinaryBodyBytes, caps.max_binary_body_bytes);
+  caps.max_frame_bytes = RecordingCap(in_maxFrameBytes, caps.max_frame_bytes);
+  caps.max_total_bytes = RecordingCap(in_maxTotalBytes, caps.max_total_bytes);
+
+  RecordingRegistry& registry = RecordingRegistry::GetInstance();
+  const std::string id = registry.Start(std::move(request), &error);
+  if (id.empty()) {
+    return Response::ServerError(error);
+  }
+  *out_recordingId = id;
+  *out_path = registry.current() ? registry.current()->dir().AsUTF8Unsafe()
+                                 : std::string();
+  const base::Time ends_at = registry.ends_at();
+  *out_endsAt = ends_at.is_null() ? 0 : ends_at.InMillisecondsFSinceUnixEpoch();
+  return Response::Success();
+}
+
+void BrowserHandler::StopRecording(
+    const std::string& in_recordingId,
+    std::unique_ptr<StopRecordingCallback> callback) {
+  if (!is_browser_target_) {
+    callback->sendFailure(
+        Response::MethodNotFound("'Browser.stopRecording' wasn't found"));
+    return;
+  }
+  RecordingRegistry& registry = RecordingRegistry::GetInstance();
+  if (!registry.current() || registry.current_id() != in_recordingId) {
+    callback->sendFailure(
+        Response::InvalidParams("that recording is not running"));
+    return;
+  }
+  if (registry.stop_waiting()) {
+    // Somebody is already waiting for these files; a second wait would take
+    // the first caller's answer.
+    callback->sendFailure(
+        Response::ServerError("that recording is already stopping"));
+    return;
+  }
+  // Answered from the registry's record of the recording once its files are
+  // closed, whatever ended it: a recording already ending on its own (the
+  // time limit, the size cap) is waited for the same way.
+  registry.Stop(in_recordingId,
+                base::BindOnce(&SendRecordingStopped, std::move(callback)));
+}
+
+Response BrowserHandler::RecordingMask(
+    const std::string& in_recordingId,
+    std::unique_ptr<protocol::DictionaryValue> in_values,
+    bool* out_applied) {
+  if (!is_browser_target_) {
+    return Response::MethodNotFound("'Browser.recordingMask' wasn't found");
+  }
+  std::vector<std::pair<std::string, std::string>> masks;
+  std::string error;
+  if (!ReadRecordingMasks(in_values.get(), &masks, &error)) {
+    return Response::InvalidParams(error);
+  }
+  *out_applied =
+      RecordingRegistry::GetInstance().AddMasks(in_recordingId, masks);
+  return Response::Success();
+}
+
+Response BrowserHandler::RecordingStatus(bool* out_recording,
+                                         std::string* out_recordingId,
+                                         std::string* out_level,
+                                         std::string* out_path,
+                                         double* out_entries,
+                                         double* out_scripts,
+                                         double* out_bytes,
+                                         double* out_endsAt) {
+  if (!is_browser_target_) {
+    return Response::MethodNotFound("'Browser.recordingStatus' wasn't found");
+  }
+  RecordingRegistry& registry = RecordingRegistry::GetInstance();
+  Recording* recording = registry.current();
+  *out_recording = recording != nullptr;
+  *out_recordingId = recording ? registry.current_id() : std::string();
+  *out_level = recording ? recording->level() : std::string();
+  *out_path = recording ? recording->dir().AsUTF8Unsafe() : std::string();
+  *out_entries = recording ? static_cast<double>(recording->entry_count()) : 0;
+  *out_scripts = recording ? static_cast<double>(recording->script_count()) : 0;
+  *out_bytes = recording ? static_cast<double>(recording->total_bytes()) : 0;
+  const base::Time ends_at = registry.ends_at();
+  *out_endsAt = (recording && !ends_at.is_null())
+                    ? ends_at.InMillisecondsFSinceUnixEpoch()
+                    : 0;
+  return Response::Success();
+}
+
+void BrowserHandler::OnRecordingEnded(const std::string& recording_id,
+                                      const std::string& reason,
+                                      const std::string& path,
+                                      const std::string& summary) {
+  if (frontend_) {
+    frontend_->RecordingEnded(recording_id, reason, path, summary);
+  }
+}
 
