diff --git a/third_party/blink/public/mojom/agent_snapshot/agent_fetch.mojom b/third_party/blink/public/mojom/agent_snapshot/agent_fetch.mojom
new file mode 100644
index 0000000000..ca0aa18d55
--- /dev/null
+++ b/third_party/blink/public/mojom/agent_snapshot/agent_fetch.mojom
@@ -0,0 +1,161 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// browser: the renderer half of Browser.agentFetch. Bound per document on the
+// primary main frame of a fetch page, next to AgentSnapshotCollector; the
+// browser binds it after each cross-document commit. Everything here reads
+// the document from a private isolated world or from C++ and leaves no trace
+// the page can see.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "mojo/public/mojom/base/big_string.mojom";
+
+// When the document counts as settled: no change in its visible text for
+// quiet_ms after DOMContentLoaded (busy_quiet_ms while more than max_inflight
+// requests are active), or network idle plus a short quiet, or cap_ms.
+struct AgentSettleOptions {
+  int32 quiet_ms = 300;
+  int32 busy_quiet_ms = 1000;
+  int32 max_inflight = 2;
+  int32 cap_ms = 10000;
+  // The visible text must be at least this long for "quiet" to count.
+  int32 min_text = 1;
+};
+
+struct AgentSettleReport {
+  // quiet | networkIdle | cap
+  string reason;
+  int32 waited_ms;
+  bool dcl_fired;
+  bool load_fired;
+  int32 text_length;
+  int32 text_nodes;
+  int32 active_requests;
+  // document.visibilityState == "visible" and document.readyState.
+  bool visible;
+  string ready_state;
+};
+
+// The cheap look the browser takes while waiting through a bot check.
+struct AgentChallengeMarkers {
+  string title;
+  int32 text_length;
+  // The first 600 characters of the visible text, whitespace collapsed.
+  string head;
+  // Markers found, by name (see agent_fetch_agent.cc for the list):
+  // cf.title, cf.chl_opt, cf.orchestrate, cf.error_text, cf.legacy,
+  // cf.refresh, dd.var, dd.cmsg, dd.script, px.captcha, px.inline,
+  // kasada.inline, kasada.ips, waf.inline, waf.script, akamai.cpt,
+  // imperva.resource, google.sorry, captcha.frame, recaptcha.anchor,
+  // hcaptcha.frame, turnstile.frame, meta.refresh.
+  array<string> matched;
+  // The DataDome rt and t fields when dd.var matched, else empty.
+  string dd_rt;
+  string dd_t;
+  // Hosts of the child frames, at most 32, from a same-process frame's
+  // document URL and from every frame owner's src. The browser classifies
+  // frames from its own frame tree instead.
+  array<string> frame_hosts;
+};
+
+struct AgentOutlineItem {
+  int32 level;
+  string text;
+  // UTF-16 code-unit offset of the heading line in the markdown.
+  int32 offset;
+};
+
+struct AgentLink {
+  string url;
+  string text;
+  // main | nav | header | footer | aside | none
+  string region;
+  // Whether the markdown already carries this link.
+  bool in_markdown;
+  string rel;
+};
+
+struct AgentExtractOptions {
+  int32 max_markdown_chars = 200000;
+  int32 max_links = 500;
+  bool want_links = true;
+  // Try Readability first (else the structural walk only).
+  bool prefer_readability = true;
+};
+
+struct AgentExtraction {
+  string title;
+  string lang;
+  // link[rel=canonical], resolved; empty when absent.
+  string canonical;
+  // isProbablyReaderable() on the document.
+  bool readerable;
+  // readability | structural | none
+  string extractor;
+  mojo_base.mojom.BigString markdown;
+  array<AgentOutlineItem> outline;
+  // A JSON object: {"meta": {...}, "og": {...}, "twitter": {...},
+  // "jsonld": [...], "readability": {"byline", "siteName", "publishedTime",
+  // "excerpt"}}. Values are strings; jsonld items are the parsed objects.
+  string facts_json;
+  array<AgentLink> links;
+  // A JSON object of detection inputs for the browser's classifier:
+  // visible_text_length, main_text_length, password_fields_visible,
+  // skipped_controls (rendered buttons and fields the reader leaves out),
+  // paragraph_count, heading_count, has_article_or_main, mount_root_empty,
+  // not_free (JSON-LD isAccessibleForFree false), paywall_selectors[],
+  // login_selectors[], modal_open, scroll_locked, noscript_only,
+  // large_canvas, canvas_coverage (the largest visible canvas's share of the
+  // viewport, 0 to 1), element_count.
+  string signals_json;
+  bool truncated;
+  int32 visible_text_length;
+  int32 main_text_length;
+};
+
+// A real fetch() from the document, in the private world.
+struct AgentApiRequest {
+  string url;
+  string method;
+  array<string> header_names;
+  array<string> header_values;
+  bool has_body;
+  mojo_base.mojom.BigString body;
+  int32 timeout_ms;
+  int32 max_body_bytes;
+};
+
+struct AgentApiResponse {
+  // The fetch resolved (the status may still be 4xx/5xx). When false, error
+  // carries the TypeError's message (a CORS failure, a network error).
+  bool ok;
+  string error;
+  int32 status;
+  string status_text;
+  // response.url: the final URL after redirects.
+  string url;
+  bool redirected;
+  array<string> header_names;
+  array<string> header_values;
+  mojo_base.mojom.BigBuffer body;
+  bool truncated;
+};
+
+interface AgentFetchAgent {
+  // Answers once the document has settled (see AgentSettleOptions). The
+  // reply is dropped if the document is replaced; the browser re-binds.
+  WaitForSettle(AgentSettleOptions options) => (AgentSettleReport report);
+
+  // A cheap look at the document for bot-check markers.
+  Markers() => (AgentChallengeMarkers markers);
+
+  // Extracts the main content as markdown, with facts, outline, links and
+  // the classifier's signals.
+  Extract(AgentExtractOptions options) => (AgentExtraction extraction);
+
+  // Runs fetch() in the private world and awaits it.
+  RunFetch(AgentApiRequest request) => (AgentApiResponse response);
+};
