+// ---------------------------------------------------------------------------
+// ExtractJob.
+
+// browser: owned by the posted task that carries it (a std::unique_ptr bound
+// into each step), so the reply callback is destroyed on the main thread when
+// a step runs or its task is dropped, never in a GC finalizer. The DOM it
+// holds between steps is held through Persistents.
+struct AgentFetchAgent::ExtractJob {
+  USING_FAST_MALLOC(ExtractJob);
+
+ public:
+  ExtractJob(mojom::blink::AgentExtractOptionsPtr options,
+             ExtractCallback reply)
+      : max_markdown_chars(static_cast<wtf_size_t>(
+            options->max_markdown_chars > 0
+                ? std::min(options->max_markdown_chars, kMaxMarkdownChars)
+                : kDefaultMarkdownChars)),
+        max_links(static_cast<wtf_size_t>(
+            std::clamp(options->max_links, 0, kMaxLinks))),
+        want_links(options->want_links && options->max_links > 0),
+        prefer_readability(options->prefer_readability),
+        callback(std::move(reply)),
+        result(NewExtraction()) {}
+  ExtractJob(const ExtractJob&) = delete;
+  ExtractJob& operator=(const ExtractJob&) = delete;
+
+  const wtf_size_t max_markdown_chars;
+  const wtf_size_t max_links;
+  const bool want_links;
+  const bool prefer_readability;
+  ExtractCallback callback;
+  mojom::blink::AgentExtractionPtr result;
+
+  // Task (a). The facts object; task (b) adds Readability's, and the reply
+  // serializes it into facts_json.
+  std::unique_ptr<JSONObject> facts;
+  String og_title;
+  bool not_free = false;
+
+  // Task (b).
+  bool readerable = false;
+  // Readability's article, in the detached clone (which it keeps alive).
+  Persistent<Element> article;
+
+  // Task (c).
+  Persistent<Element> region;
+  // The hrefs the chosen markdown carries.
+  HashSet<String> inline_hrefs;
+};
