+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/agent_fetch_challenge.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_fetch.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Challenge and block pages are short; real pages rarely are.
+constexpr int kShortPage = 1500;
+
+// The phrases of a site-native "are you human" interstitial.
+constexpr std::string_view kHumanCheckPhrases[] = {
+    "prove your humanity",
+    "verify you are human",
+    "verify that you are human",
+    "verify you're human",
+    "verify that you're human",
+    "verify you are a human",
+    "verify that you are a human",
+    "verify you\xE2\x80\x99re human",
+    "are you a robot",
+    "are you a human",
+    "robot or human",
+    "human verification",
+    "security check",
+    "press & hold",
+    "press and hold",
+    "i'm not a robot",
+    "i\xE2\x80\x99m not a robot",
+};
+
+// What a PerimeterX block page says.
+constexpr std::string_view kPerimeterXPhrases[] = {
+    "press & hold",
+    "press and hold",
+    "robot or human?",
+    "access to this page has been denied",
+};
+
+// Rule B5: what a generic block page says.
+constexpr std::string_view kBlockPhrases[] = {
+    "access denied",
+    "forbidden",
+    "you've been blocked",
+    "you\xE2\x80\x99ve been blocked",
+    "you have been blocked",
+    "request blocked",
+    "request was blocked",
+    "request has been blocked",
+    "not authorized",
+    "not authorised",
+    "unavailable for legal reasons",
+};
+
+const std::string* FindHeader(const AgentFetchHeaderMap& headers,
+                              std::string_view name) {
+  auto it = headers.find(std::string(name));
+  return it == headers.end() ? nullptr : &it->second;
+}
+
+bool HasMarker(const std::vector<std::string>& matched, std::string_view name) {
+  return std::ranges::find(matched, name) != matched.end();
+}
+
+// The first of `phrases` that `lowered` contains, or empty.
+std::string_view FindPhrase(std::string_view lowered,
+                            base::span<const std::string_view> phrases) {
+  for (std::string_view phrase : phrases) {
+    if (lowered.find(phrase) != std::string_view::npos) {
+      return phrase;
+    }
+  }
+  return std::string_view();
+}
+
+AgentFetchVerdict MakeVerdict(std::string_view vendor,
+                              std::string_view kind,
+                              std::string_view rule,
+                              std::string evidence) {
+  AgentFetchVerdict verdict;
+  verdict.vendor = std::string(vendor);
+  verdict.kind = std::string(kind);
+  verdict.rule = std::string(rule);
+  verdict.evidence.push_back(std::move(evidence));
+  return verdict;
+}
+
+std::string FrameLabel(const GURL& url) {
+  const std::string_view path = url.path();
+  if (url.DomainIs("challenges.cloudflare.com")) {
+    return "turnstile";
+  }
+  if (url.DomainIs("geo.captcha-delivery.com")) {
+    if (path.starts_with("/captcha")) {
+      return "datadome.captcha";
+    }
+    if (path.starts_with("/interstitial")) {
+      return "datadome.interstitial";
+    }
+  }
+  // The anchor of a visible widget; api2/aframe and invisible widgets
+  // load on ordinary pages.
+  if ((url.DomainIs("google.com") || url.DomainIs("recaptcha.net")) &&
+      (path.starts_with("/recaptcha/api2/anchor") ||
+       path.starts_with("/recaptcha/enterprise/anchor")) &&
+      url.query().find("size=invisible") == std::string_view::npos) {
+    return "recaptcha.anchor";
+  }
+  if (url.DomainIs("hcaptcha.com") && path.starts_with("/captcha")) {
+    return "hcaptcha";
+  }
+  if (url.DomainIs("arkoselabs.com")) {
+    return "arkose";
+  }
+  if (path.find("_Incapsula_Resource") != std::string_view::npos) {
+    return "imperva";
+  }
+  if (path.find("/_sec/cp_challenge/") != std::string_view::npos) {
+    return "akamai";
+  }
+  return std::string();
+}
+
+bool HasFrame(const std::vector<std::string>& frames, std::string_view label) {
+  return std::ranges::find(frames, label) != frames.end();
+}
+
+}  // namespace
+
+AgentFetchVerdict::AgentFetchVerdict() = default;
+AgentFetchVerdict::AgentFetchVerdict(const AgentFetchVerdict&) = default;
+AgentFetchVerdict::AgentFetchVerdict(AgentFetchVerdict&&) = default;
+AgentFetchVerdict& AgentFetchVerdict::operator=(const AgentFetchVerdict&) =
+    default;
+AgentFetchVerdict& AgentFetchVerdict::operator=(AgentFetchVerdict&&) = default;
+AgentFetchVerdict::~AgentFetchVerdict() = default;
+
+base::DictValue AgentFetchVerdict::ToDict() const {
+  base::DictValue dict;
+  dict.Set("vendor", vendor);
+  dict.Set("kind", kind);
+  dict.Set("rule", rule);
+  base::ListValue list;
+  for (const std::string& item : evidence) {
+    list.Append(item);
+  }
+  dict.Set("evidence", std::move(list));
+  if (rate_limited) {
+    dict.Set("rateLimited", true);
+  }
+  if (!retry_after.empty()) {
+    dict.Set("retryAfter", retry_after);
+  }
+  return dict;
+}
+
+std::optional<AgentFetchVerdict> DetectResponseChallenge(
+    int status,
+    const AgentFetchHeaderMap& headers,
+    const GURL& url,
+    bool redirected) {
+  // Cloudflare sets it "for all challenge page types".
+  if (const std::string* value = FindHeader(headers, "cf-mitigated");
+      value && base::ToLowerASCII(*value) == "challenge") {
+    return MakeVerdict("cloudflare", "auto", "C1", "cf-mitigated: challenge");
+  }
+  // Kasada's interstitial; its fingerprint subframe also answers 429,
+  // which is why only primary main-frame responses come here. With its
+  // failure code it is a ban instead (DetectResponseBlock).
+  if (status == 429 && FindHeader(headers, "x-kpsdk-ct") &&
+      !FindHeader(headers, "x-kpsdk-fc")) {
+    return MakeVerdict("kasada", "auto", "C4", "status 429 + x-kpsdk-ct");
+  }
+  // PerimeterX sends a blocked visitor to its Press & Hold page,
+  // /blocked?url=<base64>&uuid=...
+  if (redirected && url.SchemeIsHTTPOrHTTPS() && url.path() == "/blocked" &&
+      (url.query().starts_with("url=") ||
+       url.query().find("&url=") != std::string_view::npos)) {
+    return MakeVerdict("perimeterx", "interactive", "C3",
+                       "redirect to /blocked?url=");
+  }
+  // AWS WAF, 202 for the silent challenge and 405 for the captcha.
+  if (const std::string* value = FindHeader(headers, "x-amzn-waf-action");
+      value && (status == 202 || status == 405)) {
+    const bool captcha = status == 405;
+    return MakeVerdict("aws_waf", captcha ? "interactive" : "auto", "C5",
+                       base::StrCat({"status ", base::NumberToString(status),
+                                     " + x-amzn-waf-action: ", *value}));
+  }
+  // Akamai's sec-cpt.
+  if (status == 428) {
+    return MakeVerdict("akamai", "auto", "C6", "status 428");
+  }
+  // X-datadome alone is on every page of a DataDome site; the 403 with
+  // DataDome's own server or its x-dd-b is the interstitial.
+  if (status == 403) {
+    const std::string* server = FindHeader(headers, "server");
+    const bool datadome_server = server && base::ToLowerASCII(*server).find(
+                                               "datadome") != std::string::npos;
+    if (datadome_server || FindHeader(headers, "x-dd-b") ||
+        FindHeader(headers, "x-datadome-cid")) {
+      return MakeVerdict("datadome", "auto", "C2",
+                         datadome_server ? "status 403 + server: DataDome"
+                                         : "status 403 + x-dd-b");
+    }
+  }
+  // Google's "unusual traffic" page.
+  if (url.SchemeIsHTTPOrHTTPS() && url.path().starts_with("/sorry/") &&
+      (url.DomainIs("google.com") || url.host().starts_with("google.") ||
+       url.host().starts_with("www.google."))) {
+    return MakeVerdict("google", "interactive", "C8", "url /sorry/");
+  }
+  return std::nullopt;
+}
+
+std::optional<AgentFetchVerdict> DetectResponseBlock(
+    int status,
+    const AgentFetchHeaderMap& headers) {
+  // x-kpsdk-fc is Kasada's failure code; no wait clears it.
+  if (status == 429) {
+    if (const std::string* code = FindHeader(headers, "x-kpsdk-fc")) {
+      return MakeVerdict("kasada", "ban", "C4",
+                         base::StrCat({"status 429 + x-kpsdk-fc: ", *code}));
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<std::string> CollectChallengeFrames(
+    content::WebContents* web_contents) {
+  std::vector<std::string> labels;
+  if (!web_contents) {
+    return labels;
+  }
+  content::RenderFrameHost* main_frame = web_contents->GetPrimaryMainFrame();
+  if (!main_frame) {
+    return labels;
+  }
+  main_frame->ForEachRenderFrameHost(
+      [main_frame, &labels](content::RenderFrameHost* frame) {
+        if (frame == main_frame) {
+          return;
+        }
+        const GURL& url = frame->GetLastCommittedURL();
+        if (!url.SchemeIsHTTPOrHTTPS()) {
+          return;
+        }
+        std::string label = FrameLabel(url);
+        if (!label.empty() && !HasFrame(labels, label)) {
+          labels.push_back(std::move(label));
+        }
+      });
+  return labels;
+}
+
+std::optional<AgentFetchVerdict> DetectMarkerChallenge(
+    const blink::mojom::AgentChallengeMarkers& markers,
+    const std::vector<std::string>& frames) {
+  const std::vector<std::string>& matched = markers.matched;
+  const std::string title = base::ToLowerASCII(markers.title);
+  const std::string head = base::ToLowerASCII(markers.head);
+  const bool short_page = markers.text_length < kShortPage;
+
+  // Google's "unusual traffic" page.
+  if (HasMarker(matched, "google.sorry")) {
+    return MakeVerdict("google", "interactive", "C8", "marker google.sorry");
+  }
+
+  // DataDome. rt 'c' is the slider, 'i' the device check; t 'bv' is a
+  // banned address, which no wait clears.
+  if (HasMarker(matched, "dd.var") || HasFrame(frames, "datadome.captcha") ||
+      HasFrame(frames, "datadome.interstitial") ||
+      (HasMarker(matched, "dd.cmsg") && HasMarker(matched, "dd.script"))) {
+    AgentFetchVerdict verdict;
+    verdict.vendor = "datadome";
+    verdict.rule = "C2";
+    for (std::string_view name : {"dd.var", "dd.cmsg", "dd.script"}) {
+      if (HasMarker(matched, name)) {
+        verdict.evidence.push_back(base::StrCat({"marker ", name}));
+      }
+    }
+    for (std::string_view label :
+         {"datadome.captcha", "datadome.interstitial"}) {
+      if (HasFrame(frames, label)) {
+        verdict.evidence.push_back(base::StrCat({"frame ", label}));
+      }
+    }
+    if (markers.dd_t == "bv") {
+      verdict.kind = "ban";
+      verdict.evidence.push_back("dd t=bv (address banned)");
+    } else if (markers.dd_rt == "c" || HasFrame(frames, "datadome.captcha")) {
+      verdict.kind = "interactive";
+      verdict.evidence.push_back("dd rt=c (captcha)");
+    } else {
+      verdict.kind = "auto";
+    }
+    return verdict;
+  }
+
+  // PerimeterX's Press & Hold. Its scripts and cookies are on ordinary
+  // pages too, so only the captcha element or the block text count.
+  if (HasMarker(matched, "px.captcha")) {
+    return MakeVerdict("perimeterx", "interactive", "C3", "marker px.captcha");
+  }
+  if (HasMarker(matched, "px.inline") && short_page) {
+    std::string_view phrase = FindPhrase(head, kPerimeterXPhrases);
+    if (phrase.empty()) {
+      phrase = FindPhrase(title, kPerimeterXPhrases);
+    }
+    if (!phrase.empty()) {
+      AgentFetchVerdict verdict =
+          MakeVerdict("perimeterx", "interactive", "C3", "marker px.inline");
+      verdict.evidence.push_back(base::StrCat({"text '", phrase, "'"}));
+      return verdict;
+    }
+  }
+
+  // Cloudflare, any two of its interstitial markers. The challenge
+  // platform scripts alone are on most Cloudflare sites.
+  {
+    AgentFetchVerdict verdict;
+    for (std::string_view name : {"cf.title", "cf.chl_opt", "cf.orchestrate",
+                                  "cf.error_text", "cf.legacy", "cf.refresh"}) {
+      if (HasMarker(matched, name)) {
+        verdict.evidence.push_back(base::StrCat({"marker ", name}));
+      }
+    }
+    if (verdict.evidence.size() >= 2) {
+      verdict.vendor = "cloudflare";
+      verdict.rule = "C1";
+      verdict.kind = "auto";
+      if (head.find("completing the action below") != std::string::npos) {
+        verdict.kind = "interactive";
+        verdict.evidence.push_back("text 'completing the action below'");
+      }
+      if (HasFrame(frames, "turnstile")) {
+        verdict.evidence.push_back("frame challenges.cloudflare.com");
+      }
+      return verdict;
+    }
+  }
+
+  // Kasada's empty interstitial. ips.js alone is on ordinary pages.
+  if (HasMarker(matched, "kasada.inline") &&
+      (HasMarker(matched, "kasada.ips") || markers.text_length < 200)) {
+    return MakeVerdict("kasada", "auto", "C4", "marker kasada.inline");
+  }
+
+  // AWS WAF's challenge page.
+  if ((HasMarker(matched, "waf.inline") || HasMarker(matched, "waf.script")) &&
+      short_page) {
+    return MakeVerdict("aws_waf", "auto", "C5",
+                       HasMarker(matched, "waf.inline") ? "marker waf.inline"
+                                                        : "marker waf.script");
+  }
+
+  // Akamai's sec-cpt.
+  if (HasMarker(matched, "akamai.cpt") || HasFrame(frames, "akamai")) {
+    return MakeVerdict("akamai", "auto", "C6",
+                       HasMarker(matched, "akamai.cpt") ? "marker akamai.cpt"
+                                                        : "frame cp_challenge");
+  }
+
+  // Imperva's JS challenge, or its bot protection's interstitial.
+  if ((HasMarker(matched, "imperva.resource") || HasFrame(frames, "imperva")) &&
+      short_page) {
+    return MakeVerdict("imperva", "auto", "C7", "_Incapsula_Resource");
+  }
+  if (title.find("pardon our interruption") != std::string::npos) {
+    return MakeVerdict("imperva", "auto", "C7",
+                       "title 'Pardon Our Interruption'");
+  }
+
+  // A site-native "are you human" page: short, the wording, and a
+  // visible widget. A widget alone is no verdict.
+  if (short_page) {
+    std::string_view label;
+    for (std::string_view frame :
+         {"turnstile", "recaptcha.anchor", "hcaptcha", "arkose"}) {
+      if (HasFrame(frames, frame)) {
+        label = frame;
+        break;
+      }
+    }
+    if (label.empty()) {
+      for (std::string_view name : {"recaptcha.anchor", "hcaptcha.frame",
+                                    "turnstile.frame", "captcha.frame"}) {
+        if (HasMarker(matched, name)) {
+          label = name;
+          break;
+        }
+      }
+    }
+    if (!label.empty()) {
+      std::string_view phrase = FindPhrase(title, kHumanCheckPhrases);
+      if (phrase.empty()) {
+        phrase = FindPhrase(std::string_view(head).substr(
+                                0, std::min<size_t>(head.size(), 300)),
+                            kHumanCheckPhrases);
+      }
+      if (!phrase.empty()) {
+        AgentFetchVerdict verdict =
+            MakeVerdict("captcha", "interactive", "C9",
+                        base::StrCat({"text '", phrase, "'"}));
+        verdict.evidence.push_back(base::StrCat({"widget ", label}));
+        verdict.evidence.push_back(base::StrCat(
+            {"visible text ", base::NumberToString(markers.text_length),
+             " chars"}));
+        return verdict;
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<AgentFetchVerdict> DetectVendorBlock(
+    int status,
+    const AgentFetchHeaderMap& headers,
+    std::string_view title,
+    std::string_view head) {
+  if (std::optional<AgentFetchVerdict> block =
+          DetectResponseBlock(status, headers)) {
+    return block;
+  }
+
+  const std::string title_lower = base::ToLowerASCII(title);
+  const std::string head_lower = base::ToLowerASCII(head);
+  const std::string* server_header = FindHeader(headers, "server");
+  const std::string server =
+      server_header ? base::ToLowerASCII(*server_header) : std::string();
+
+  // Cloudflare's firewall (a 403 that is not a challenge), and its 1xxx
+  // error pages.
+  if (status == 403 && !FindHeader(headers, "cf-mitigated")) {
+    if (title_lower.find("attention required! | cloudflare") !=
+        std::string::npos) {
+      return MakeVerdict("cloudflare", "ban", "B1",
+                         "title 'Attention Required! | Cloudflare'");
+    }
+    std::string_view phrase = FindPhrase(
+        head_lower, {"sorry, you have been blocked", "you are unable to access",
+                     "cloudflare ray id:"});
+    if (!phrase.empty()) {
+      return MakeVerdict("cloudflare", "ban", "B1",
+                         base::StrCat({"text '", phrase, "'"}));
+    }
+  }
+  if (server.find("cloudflare") != std::string::npos) {
+    std::string_view phrase =
+        FindPhrase(head_lower, {"error 1015", "you are being rate limited"});
+    if (!phrase.empty()) {
+      AgentFetchVerdict verdict = MakeVerdict(
+          "cloudflare", "ban", "B1", base::StrCat({"text '", phrase, "'"}));
+      verdict.rate_limited = true;
+      if (const std::string* retry = FindHeader(headers, "retry-after")) {
+        verdict.retry_after = *retry;
+      }
+      return verdict;
+    }
+    phrase = FindPhrase(head_lower, {"error 1020", "error 1010"});
+    if (!phrase.empty()) {
+      return MakeVerdict("cloudflare", "ban", "B1",
+                         base::StrCat({"text '", phrase, "'"}));
+    }
+  }
+
+  // Akamai's "Access Denied" with its reference number.
+  if (title_lower.find("access denied") != std::string::npos) {
+    std::string_view phrase = FindPhrase(
+        head_lower, {"you don't have permission to access", "reference #18."});
+    if (!phrase.empty()) {
+      AgentFetchVerdict verdict = MakeVerdict(
+          "akamai", "ban", "B2", base::StrCat({"text '", phrase, "'"}));
+      if (server.find("akamaighost") != std::string::npos) {
+        verdict.evidence.push_back("server: AkamaiGHost");
+      }
+      return verdict;
+    }
+  }
+
+  // A block: Imperva's incident page.
+  if (head_lower.find("incapsula incident id") != std::string::npos) {
+    return MakeVerdict("imperva", "ban", "C7", "text 'Incapsula incident ID'");
+  }
+
+  // A network-security block page.
+  {
+    std::string_view phrase =
+        FindPhrase(head_lower, {"you've been blocked by network security",
+                                "you\xE2\x80\x99ve been blocked by network "
+                                "security",
+                                "you have been blocked by network security"});
+    if (!phrase.empty()) {
+      return MakeVerdict("generic", "ban", "B4",
+                         base::StrCat({"text '", phrase, "'"}));
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<AgentFetchVerdict> DetectBlock(int status,
+                                             const AgentFetchHeaderMap& headers,
+                                             std::string_view title,
+                                             std::string_view head,
+                                             int text_length) {
+  if (std::optional<AgentFetchVerdict> block =
+          DetectVendorBlock(status, headers, title, head)) {
+    return block;
+  }
+
+  const std::string title_lower = base::ToLowerASCII(title);
+  const std::string head_lower = base::ToLowerASCII(head);
+  const bool short_page = text_length < kShortPage;
+
+  // A rate limit (Kasada's 429 is a challenge, not this).
+  {
+    const std::string* retry = FindHeader(headers, "retry-after");
+    std::string evidence;
+    if (status == 429 && !FindHeader(headers, "x-kpsdk-ct")) {
+      evidence = "status 429";
+    } else if (status == 503 && retry) {
+      evidence = "status 503 + retry-after";
+    } else if (short_page) {
+      std::string_view phrase = FindPhrase(
+          head_lower, {"too many requests", "rate limit", "whoa there"});
+      if (!phrase.empty()) {
+        evidence = base::StrCat({"text '", phrase, "'"});
+      }
+    }
+    if (!evidence.empty()) {
+      AgentFetchVerdict verdict =
+          MakeVerdict("generic", "ban", "B3", std::move(evidence));
+      verdict.rate_limited = true;
+      if (retry) {
+        verdict.retry_after = *retry;
+      }
+      return verdict;
+    }
+  }
+
+  // A generic block, by status on a short page.
+  if ((status == 401 || status == 403 || status == 451) && short_page) {
+    std::string_view phrase = FindPhrase(title_lower, kBlockPhrases);
+    if (phrase.empty()) {
+      phrase = FindPhrase(head_lower, kBlockPhrases);
+    }
+    if (!phrase.empty()) {
+      AgentFetchVerdict verdict = MakeVerdict(
+          "generic", "ban", "B5", base::StrCat({"text '", phrase, "'"}));
+      verdict.evidence.push_back(
+          base::StrCat({"status ", base::NumberToString(status)}));
+      return verdict;
+    }
+    if (status == 403) {
+      AgentFetchVerdict verdict =
+          MakeVerdict("generic", "ban", "B5", "status 403 on a short page");
+      verdict.evidence.push_back("medium confidence");
+      return verdict;
+    }
+  }
+  return std::nullopt;
+}
