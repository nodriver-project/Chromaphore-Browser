new file mode 100644
index 0000000000..a3cf0a3018
--- /dev/null
+++ b/chrome/browser/devtools/protocol/agent_fetcher.cc
@@ -0,0 +1,179 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/agent_fetcher.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/devtools/protocol/agent_fetch_job.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace {
+
+// browser: bodies saved under the profile that nobody collected do not pile
+// up. Runs on a blocking pool sequence; a write in flight is younger than
+// the cutoff.
+void DeleteOldSaves(const base::FilePath& dir) {
+  const base::Time cutoff = base::Time::Now() - AgentFetcher::kSaveLifetime;
+  base::FileEnumerator files(dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    if (files.GetInfo().GetLastModifiedTime() < cutoff) {
+      base::DeleteFile(path);
+    }
+  }
+}
+
+}  // namespace
+
+AgentFetchParams::AgentFetchParams() = default;
+AgentFetchParams::AgentFetchParams(AgentFetchParams&&) = default;
+AgentFetchParams& AgentFetchParams::operator=(AgentFetchParams&&) = default;
+AgentFetchParams::~AgentFetchParams() = default;
+
+bool AgentFetchParams::IsApiCall() const {
+  return method != "GET" || !headers.empty() || body.has_value();
+}
+
+AgentFetcher::AgentFetcher(Profile* profile, bool may_write_local_files)
+    : profile_(profile),
+      may_write_local_files_(may_write_local_files),
+      save_dir_(profile->GetPath().Append(FILE_PATH_LITERAL("agent_fetch"))) {
+  profile_observation_.Observe(profile);
+  base::ThreadPool::PostTask(FROM_HERE,
+                             {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+                              base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+                             base::BindOnce(&DeleteOldSaves, save_dir_));
+}
+
+AgentFetcher::~AgentFetcher() {
+  // browser: the session detached. Nobody is listening, so the jobs go
+  // without answering; each hands its page to a posted deletion.
+  weak_factory_.InvalidateWeakPtrs();
+  queued_.clear();
+  running_.clear();
+}
+
+void AgentFetcher::OnProfileWillBeDestroyed(Profile* profile) {
+  // browser: no page may outlive its profile. Unlike a detach, the session
+  // may still be listening, so every job answers "error" first (one whose
+  // page's own profile notice came first has answered that already), then
+  // goes at once. Each page also watches the profile and closes its
+  // WebContents in this same notice, so the posted deletions find nothing
+  // left to close. Nothing starts after this.
+  profile_observation_.Reset();
+  profile_ = nullptr;
+  std::vector<std::unique_ptr<AgentFetchJob>> queued = std::move(queued_);
+  std::map<std::string, std::unique_ptr<AgentFetchJob>> running =
+      std::move(running_);
+  queued_.clear();
+  running_.clear();
+  for (const std::unique_ptr<AgentFetchJob>& job : queued) {
+    job->Fail("the profile is gone");
+  }
+  for (const auto& entry : running) {
+    entry.second->Fail("the profile is gone");
+  }
+  // The OnJobDone tasks those answers posted find nothing to do.
+  weak_factory_.InvalidateWeakPtrs();
+  queued.clear();
+  running.clear();
+}
+
+void AgentFetcher::Fetch(AgentFetchParams params,
+                         std::unique_ptr<Callback> callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile_) {
+    callback->sendFailure(
+        protocol::Response::ServerError("the profile is gone"));
+    return;
+  }
+  if (running_.size() >= static_cast<size_t>(kMaxConcurrent) &&
+      queued_.size() >= static_cast<size_t>(kMaxQueued)) {
+    callback->sendFailure(protocol::Response::ServerError(
+        "too many agentFetch calls are waiting"));
+    return;
+  }
+  auto in_use = [this](const std::string& id) {
+    return running_.contains(id) ||
+           std::ranges::any_of(
+               queued_, [&id](const std::unique_ptr<AgentFetchJob>& job) {
+                 return job->fetch_id() == id;
+               });
+  };
+  if (params.fetch_id.empty()) {
+    do {
+      params.fetch_id = base::NumberToString(next_id_++);
+    } while (in_use(params.fetch_id));
+  } else if (in_use(params.fetch_id)) {
+    callback->sendFailure(
+        protocol::Response::InvalidParams("fetchId is already in use"));
+    return;
+  }
+
+  auto job = std::make_unique<AgentFetchJob>(this, std::move(params),
+                                             std::move(callback));
+  if (running_.size() >= static_cast<size_t>(kMaxConcurrent)) {
+    queued_.push_back(std::move(job));
+    return;
+  }
+  AgentFetchJob* raw = job.get();
+  running_.emplace(raw->fetch_id(), std::move(job));
+  raw->Start();
+}
+
+bool AgentFetcher::Cancel(const std::string& fetch_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (auto it = running_.find(fetch_id); it != running_.end()) {
+    if (it->second->finished()) {
+      return false;
+    }
+    // It answers now; OnJobDone destroys it from a posted task.
+    it->second->Cancel();
+    return true;
+  }
+  auto it = std::ranges::find_if(
+      queued_, [&fetch_id](const std::unique_ptr<AgentFetchJob>& job) {
+        return job->fetch_id() == fetch_id;
+      });
+  if (it == queued_.end()) {
+    return false;
+  }
+  // Never started: no page, no observer; it can go at once.
+  std::unique_ptr<AgentFetchJob> job = std::move(*it);
+  queued_.erase(it);
+  job->Cancel();
+  return true;
+}
+
+void AgentFetcher::OnJobDone(const std::string& fetch_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto it = running_.find(fetch_id);
+  // Only the job that finished: a cancelled queued job's id may have been
+  // taken by a new fetch since.
+  if (it != running_.end() && it->second->finished()) {
+    running_.erase(it);
+  }
+  StartQueued();
+}
+
+void AgentFetcher::StartQueued() {
+  if (!profile_) {
+    return;
+  }
+  while (running_.size() < static_cast<size_t>(kMaxConcurrent) &&
+         !queued_.empty()) {
+    std::unique_ptr<AgentFetchJob> job = std::move(queued_.front());
+    queued_.erase(queued_.begin());
+    AgentFetchJob* raw = job.get();
+    running_.emplace(raw->fetch_id(), std::move(job));
+    raw->Start();
+  }
+}
