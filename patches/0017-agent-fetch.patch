+#include "ui/base/window_open_disposition.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "url/origin.h"
+
+namespace {
+
+// With no browser window to copy, a 1280x720 window whose frame is
+// that of a real headless window: 16 px wider and 95 px taller than its
+// contents. The split between the edges is a guess (8 px sides, 87 px top).
+constexpr int kFallbackWidth = 1280;
+constexpr int kFallbackHeight = 720;
+constexpr int kFrameLeft = 8;
+constexpr int kFrameTop = 87;
+constexpr int kFrameWidth = 16;
+constexpr int kFrameHeight = 95;
+
+// Where the page sits: the window's screen bounds and the contents' bounds
+// inside it, and the window's widget for the theme.
+struct HostGeometry {
+  gfx::Rect outer;
+  gfx::Rect inner;
+  raw_ptr<views::Widget> color_source = nullptr;
+};
+
+gfx::Rect FallbackInner(const gfx::Rect& outer) {
+  return gfx::Rect(kFrameLeft, kFrameTop,
+                   std::max(outer.width() - kFrameWidth, 1),
+                   std::max(outer.height() - kFrameHeight, 1));
+}
+
+// The profile's most recently active browser window, as a real tab in it
+// would see its window: outerWidth/Height, innerWidth/Height and screenX/Y.
+HostGeometry ReferenceGeometry(Profile* profile) {
+  BrowserWindowInterface* reference = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [profile, &reference](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() != profile || !browser->GetWindow() ||
+            browser->capabilities()->IsAttemptingToCloseBrowser()) {
+          return true;
+        }
+        reference = browser;
+        return false;
+      });
+
+  HostGeometry geometry;
+  if (reference) {
+    ui::BaseWindow* window = reference->GetWindow();
+    const gfx::Rect outer = window->GetBounds();
+    if (!outer.IsEmpty()) {
+      geometry.outer = outer;
+      geometry.inner = FallbackInner(outer);
+      TabStripModel* tabs = reference->GetTabStripModel();
+      content::WebContents* active =
+          tabs ? tabs->GetActiveWebContents() : nullptr;
+      if (active) {
+        const gfx::Rect inner = active->GetContainerBounds();
+        if (!inner.IsEmpty()) {
+          geometry.inner =
+              gfx::Rect(inner.x() - outer.x(), inner.y() - outer.y(),
+                        inner.width(), inner.height());
+        }
+      }
+      geometry.color_source =
+          views::Widget::GetWidgetForNativeWindow(window->GetNativeWindow());
+      return geometry;
+    }
+  }
+  geometry.outer = gfx::Rect(0, 0, kFallbackWidth, kFallbackHeight);
+  geometry.inner = FallbackInner(geometry.outer);
+  return geometry;
+}
+
+}  // namespace
+
+AgentFetchDialogManager::AgentFetchDialogManager() = default;
+AgentFetchDialogManager::~AgentFetchDialogManager() = default;
+
+void AgentFetchDialogManager::RunJavaScriptDialog(
+    content::WebContents* web_contents,
+    content::RenderFrameHost* render_frame_host,
+    content::JavaScriptDialogType dialog_type,
+    const std::u16string& message_text,
+    const std::u16string& default_prompt_text,
+    DialogClosedCallback callback,
+    bool* did_suppress_message) {
+  // browser: the dialog "shows" and is dismissed a human-like moment later,
+  // like the print and permission prompts of the patched build.
+  *did_suppress_message = false;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&AgentFetchDialogManager::Dismiss,
+                     weak_factory_.GetWeakPtr(), std::move(callback)),
+      base::Milliseconds(base::RandIntInclusive(1000, 4000)));
+}
+
+void AgentFetchDialogManager::RunBeforeUnloadDialog(
+    content::WebContents* web_contents,
+    content::RenderFrameHost* render_frame_host,
+    bool is_reload,
+    DialogClosedCallback callback) {
+  std::move(callback).Run(/*success=*/true, std::u16string());
+}
+
+void AgentFetchDialogManager::CancelDialogs(content::WebContents* web_contents,
+                                            bool reset_state) {
+  // Nothing is answered synchronously: a pending dismissal still arrives
+  // later, and content ignores it if its frame is gone.
+}
+
+void AgentFetchDialogManager::Dismiss(DialogClosedCallback callback) {
+  std::move(callback).Run(/*success=*/false, std::u16string());
+}
+
+AgentFetchContents::AgentFetchContents(Profile* profile,
+                                       content::AgentFetchResponseTaker* taker)
+    : taker_(taker) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  // Not initially hidden: the page starts visible, as a foreground tab does.
+  web_contents_ =
+      content::WebContents::Create(content::WebContents::CreateParams(profile));
+  // browser: before anything else. Setting the first delegate is what
+  // creates DevTools hosts, and this delegate is what hides them; it also
+  // routes the very first response to the taker.
+  web_contents_->SetDelegate(this);
+  // The same helpers a tab has: renderer preferences (languages, font
+  // rendering), the permission, print and popup machinery, and the rest.
+  TabHelpers::AttachTabHelpers(web_contents_.get());
+  CreateHost(profile);
+  web_contents_->SetAudioMuted(true);
+  profile_observation_.Observe(profile);
+}
+
+AgentFetchContents::~AgentFetchContents() {
+  DestroyWebContents();
+}
+
+// static
+void AgentFetchContents::DestroySoon(
+    std::unique_ptr<AgentFetchContents> contents) {
+  if (!contents) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(contents));
+}
+
+void AgentFetchContents::CreateHost(Profile* profile) {
+  const HostGeometry geometry = ReferenceGeometry(profile);
+
+  // DetachedWebContents' pattern: a frameless widget that is never
+  // activated. Without a host the page produces no frames at all.
+  widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::Ownership::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.bounds = geometry.outer;
+#if BUILDFLAG(IS_WIN)
+  // A headless browser's window in both modes: the widget is shown and its
+  // compositor draws, but the native window never reaches the screen. A
+  // headed widget that is never shown leaves its compositor off, and the
+  // page stalls after a few frames.
+  params.headless_native_window = true;
+  params.dont_show_in_taskbar = true;
+#endif
+  widget_->Init(std::move(params));
+
+  views::View* root = widget_->SetContentsView(std::make_unique<views::View>());
+  views::WebView* web_view =
+      root->AddChildView(std::make_unique<views::WebView>(profile));
+  web_view->SetBoundsRect(geometry.inner);
+  web_view->SetWebContents(web_contents_.get());
+
+  // On Windows it is never on screen (above), and shown inactive it is in
+  // the state a headless browser's window is in. Elsewhere a headed widget
+  // would really appear, so it is shown only in a headless browser there.
+#if BUILDFLAG(IS_WIN)
+  widget_->ShowInactive();
+#else
+  if (headless::IsHeadlessMode()) {
+    widget_->ShowInactive();
+  }
+#endif
+
+  // After parenting: the capture lock is only taken once the view has a
+  // host. PageContextFetcher's arguments: visible, no wake lock.
+  capture_handle_ = web_contents_->IncrementCapturerCount(
+      gfx::Size(), /*stay_hidden=*/false, /*stay_awake=*/false,
+      /*is_activity=*/false);
+
+  // The WebView pointed the theme at its own widget; a tab's is the browser
+  // window's.
+  if (geometry.color_source) {
+    web_contents_->SetColorProviderSource(geometry.color_source.get());
+  }
+}
+
+void AgentFetchContents::DestroyWebContents() {
+  profile_observation_.Reset();
+  capture_handle_.RunAndReset();
+  widget_.reset();
+  web_contents_.reset();
+}
+
+content::WebContents* AgentFetchContents::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  // A new tab or window has nowhere to go; the page's own navigations stay.
+  if (params.disposition != WindowOpenDisposition::CURRENT_TAB) {
+    return nullptr;
+  }
+  base::WeakPtr<content::NavigationHandle> handle =
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+  if (handle && navigation_handle_callback) {
+    std::move(navigation_handle_callback).Run(*handle);
+  }
+  return source;
+}
+
+content::WebContents* AgentFetchContents::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // A popup the popup blocker let through is dropped.
+  return nullptr;
+}
+
+void AgentFetchContents::CanDownload(const GURL& url,
+                                     const std::string& request_method,
+                                     base::OnceCallback<void(bool)> callback) {
+  // The taker reads every non-page response; nothing may become a download.
+  std::move(callback).Run(false);
+}
+
+content::JavaScriptDialogManager*
+AgentFetchContents::GetJavaScriptDialogManager(content::WebContents* source) {
+  return &dialog_manager_;
+}
+
+bool AgentFetchContents::CanEnterFullscreenModeForTab(
+    content::RenderFrameHost* requesting_frame) {
+  return false;
+}
+
+void AgentFetchContents::RequestMediaAccessPermission(
+    content::WebContents* web_contents,
+    const content::MediaStreamRequest& request,
+    content::MediaResponseCallback callback) {
+  // browser: a tab's path (BrowserWebContentsDelegate): the permission
+  // prompt, which the patched build dismisses after a moment, rather than
+  // content's instant NOT_SUPPORTED, a tell. A fetch page is an http(s)
+  // page, never an extension's, so there is no extension to pass.
+  MediaCaptureDevicesDispatcher::GetInstance()->ProcessMediaAccessRequest(
+      web_contents, request, std::move(callback), /*extension=*/nullptr);
+}
+
+bool AgentFetchContents::CheckMediaAccessPermission(
+    content::RenderFrameHost* render_frame_host,
+    const url::Origin& security_origin,
+    blink::mojom::MediaStreamType type) {
+  // browser: as a tab answers it, so enumerateDevices() labels follow the
+  // origin's permission.
+  return MediaCaptureDevicesDispatcher::GetInstance()
+      ->CheckMediaAccessPermission(render_frame_host, security_origin, type);
+}
+
+bool AgentFetchContents::IsAgentFetchContents() {
+  return true;
+}
+
+content::AgentFetchResponseTaker*
+AgentFetchContents::GetAgentFetchResponseTaker() {
+  return taker_.get();
+}
+
+void AgentFetchContents::OnProfileWillBeDestroyed(Profile* profile) {
+  // A WebContents must not outlive its profile. This is a profile callback,
+  // not one of the WebContents' own, so it may go at once.
+  DestroyWebContents();
+}
