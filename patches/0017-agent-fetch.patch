+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_AGENT_FETCH_CHALLENGE_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_AGENT_FETCH_CHALLENGE_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_fetch.mojom-forward.h"
+
+class GURL;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// browser: response headers of one response, by lowercased name; repeated
+// headers joined with ", ".
+using AgentFetchHeaderMap = std::map<std::string, std::string>;
+
+// browser: what Browser.agentFetch concluded about a bot check or a block.
+// Only the coarse browser-level verdict lives here; the
+// finer naming (login, paywall, empty, not found) is the caller's.
+struct AgentFetchVerdict {
+  AgentFetchVerdict();
+  AgentFetchVerdict(const AgentFetchVerdict&);
+  AgentFetchVerdict(AgentFetchVerdict&&);
+  AgentFetchVerdict& operator=(const AgentFetchVerdict&);
+  AgentFetchVerdict& operator=(AgentFetchVerdict&&);
+  ~AgentFetchVerdict();
+
+  // cloudflare | datadome | perimeterx | kasada | aws_waf | akamai |
+  // imperva | google | captcha | generic
+  std::string vendor;
+  // A challenge: auto (clears by itself) | interactive (wants a person).
+  // A block: ban.
+  std::string kind;
+  // The rule that matched, e.g. "C1" or "B5".
+  std::string rule;
+  // Human-readable reasons, e.g. "cf-mitigated: challenge".
+  std::vector<std::string> evidence;
+  // Blocks only: a rate limit, with its Retry-After when the site sent one.
+  bool rate_limited = false;
+  std::string retry_after;
+
+  bool IsInteractive() const { return kind == "interactive"; }
+  bool IsBan() const { return kind == "ban"; }
+
+  // {vendor, kind, rule, evidence[], rateLimited?, retryAfter?}.
+  base::DictValue ToDict() const;
+};
+
+// browser: the response-level challenge signatures, read from a primary
+// main-frame response alone (no renderer round trip): cf-mitigated,
+// DataDome's 403, PerimeterX's redirect to /blocked, Kasada's 429, AWS WAF's
+// 202/405, Akamai's 428 and Google's /sorry/. `redirected`: the response
+// came after a server redirect.
+std::optional<AgentFetchVerdict> DetectResponseChallenge(
+    int status,
+    const AgentFetchHeaderMap& headers,
+    const GURL& url,
+    bool redirected);
+
+// browser: a ban the response's status and headers alone show, with no
+// waiting worth doing: Kasada's 429 with its failure code.
+std::optional<AgentFetchVerdict> DetectResponseBlock(
+    int status,
+    const AgentFetchHeaderMap& headers);
+
+// browser: the hosts of the primary page's child frames that are bot-check
+// widgets, read from the browser-side frame tree. This sees the Turnstile
+// OOPIF a closed shadow root hides from the DOM. Labels:
+// turnstile, datadome.captcha, datadome.interstitial, recaptcha.anchor,
+// hcaptcha, arkose, imperva, akamai.
+std::vector<std::string> CollectChallengeFrames(
+    content::WebContents* web_contents);
+
+// browser: a challenge read from the document (the renderer's markers by
+// name) and the widget frames; null when the page is not a bot check.
+std::optional<AgentFetchVerdict> DetectMarkerChallenge(
+    const blink::mojom::AgentChallengeMarkers& markers,
+    const std::vector<std::string>& frames);
+
+// browser: the vendor block rules alone: Kasada's failure code,
+// Cloudflare, Akamai, Imperva's incident page and the
+// network-security text. These read a body that is not a page too; the
+// generic status rules would misread an ordinary API error there,
+// and naming those is the caller's.
+std::optional<AgentFetchVerdict> DetectVendorBlock(
+    int status,
+    const AgentFetchHeaderMap& headers,
+    std::string_view title,
+    std::string_view head);
+
+// browser: the block rules for a page: the vendor rules, then B3 and B5 by
+// status, headers, title and the head of the visible text (`text_length` is
+// the whole visible text's length).
+std::optional<AgentFetchVerdict> DetectBlock(int status,
+                                             const AgentFetchHeaderMap& headers,
+                                             std::string_view title,
+                                             std::string_view head,
+                                             int text_length);
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_AGENT_FETCH_CHALLENGE_H_
