+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "net/base/filename_util.h"
+#include "net/base/net_errors.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/mojom/early_hints.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "third_party/blink/public/common/mime_util/mime_util.h"
+
+// browser: the file half of a body sink. Lives on a blocking-IO sequence. It
+// writes to `<target>.<tag>.part`, a name no other write shares, and renames
+// that to the target on Commit(); a writer destroyed without a commit
+// deletes its `.part` (and its reservation, below).
+class AgentFetchFileWriter {
+ public:
+  // With `make_unique`, the target name is reserved first: the file is
+  // created empty and exclusively, adding " (N)" until that succeeds, so two
+  // fetches never commit to one name; the commit then replaces the empty
+  // reservation. Without it (a saveTo the caller chose), the target is
+  // replaced on commit.
+  AgentFetchFileWriter(base::FilePath target,
+                       std::string tag,
+                       bool make_unique) {
+    if (!base::CreateDirectory(target.DirName())) {
+      failed_ = true;
+      return;
+    }
+    if (make_unique) {
+      for (int i = 0; i < 100 && target_.empty(); ++i) {
+        base::FilePath candidate =
+            i == 0 ? target
+                   : target.InsertBeforeExtensionASCII(
+                         " (" + base::NumberToString(i) + ")");
+        base::File reservation(
+            candidate, base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+        if (reservation.IsValid()) {
+          target_ = candidate;
+          reserved_ = true;
+        }
+      }
+      if (target_.empty()) {
+        failed_ = true;
+        return;
+      }
+    } else {
+      target_ = target;
+    }
+    part_ = target_.AddExtensionASCII(tag).AddExtensionASCII("part");
+    file_.Initialize(part_, base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+    if (!file_.IsValid()) {
+      part_.clear();
+      failed_ = true;
+    }
+  }
+
+  AgentFetchFileWriter(const AgentFetchFileWriter&) = delete;
+  AgentFetchFileWriter& operator=(const AgentFetchFileWriter&) = delete;
+
+  ~AgentFetchFileWriter() {
+    if (!done_) {
+      Discard();
+    }
+  }
+
+  void Write(std::string data) {
+    if (failed_ || done_) {
+      return;
+    }
+    std::optional<size_t> written =
+        file_.WriteAtCurrentPos(base::as_byte_span(data));
+    if (!written || *written != data.size()) {
+      failed_ = true;
+    }
+  }
+
+  // The final path, or empty when the file could not be written.
+  base::FilePath Commit() {
+    done_ = true;
+    file_.Close();
+    if (failed_ || part_.empty() || !base::Move(part_, target_)) {
+      Discard();
+      return base::FilePath();
+    }
+    return target_;
+  }
+
+ private:
+  // Removes what this write left: its `.part` and an unused reservation.
+  void Discard() {
+    file_.Close();
+    if (!part_.empty()) {
+      base::DeleteFile(part_);
+    }
+    if (reserved_) {
+      base::DeleteFile(target_);
+    }
+  }
+
+  base::FilePath target_;
+  base::FilePath part_;
+  base::File file_;
+  // `target_` is an empty file this writer created to hold the name.
+  bool reserved_ = false;
+  bool failed_ = false;
+  bool done_ = false;
+};
+
+namespace {
+
+// The middle of a `.part` name: the fetch's id, kept to characters safe in
+// any file name, and a random number, so that no two writes share a `.part`
+// even when two sessions use the same id.
+std::string PartTag(std::string_view fetch_id) {
+  std::string tag;
+  for (char c : fetch_id) {
+    if (tag.size() == 32) {
+      break;
+    }
+    if (base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_') {
+      tag.push_back(c);
+    }
+  }
+  return base::StrCat({tag.empty() ? "fetch" : tag, "-",
+                       base::NumberToString(base::RandUint64() % 1000000000)});
+}
+
+// What browsers decode these labels as (the WHATWG encoding table).
+std::string NormalizeCharset(std::string_view charset) {
+  std::string lower =
+      base::ToLowerASCII(base::TrimString(charset, " \t\"'", base::TRIM_ALL));
+  if (lower == "utf8" || lower == "unicode-1-1-utf-8") {
+    return "utf-8";
+  }
+  if (lower == "iso-8859-1" || lower == "iso8859-1" || lower == "latin1" ||
+      lower == "l1" || lower == "us-ascii" || lower == "ascii" ||
+      lower == "cp1252" || lower == "x-cp1252") {
+    return "windows-1252";
+  }
+  return lower;
+}
+
+// Converts `bytes` from `charset` to UTF-8, substituting invalid sequences.
+// False when the charset is unknown.
+bool ConvertToUTF8(std::string_view bytes,
+                   const std::string& charset,
+                   std::string* out) {
+  if (charset == "utf-8" && base::IsStringUTF8AllowingNoncharacters(bytes)) {
+    *out = std::string(bytes);
+    return true;
+  }
+  std::u16string utf16;
+  if (!base::CodepageToUTF16(bytes, charset.c_str(),
+                             base::OnStringConversionError::SUBSTITUTE,
+                             &utf16)) {
+    return false;
+  }
+  *out = base::UTF16ToUTF8(utf16);
+  return true;
+}
+
+// The encoding named by an XML declaration, or empty.
+std::string XmlDeclaredEncoding(std::string_view body) {
+  std::string_view head = body.substr(0, std::min<size_t>(body.size(), 1024));
+  size_t start = head.find_first_not_of(" \t\r\n");
+  if (start == std::string_view::npos ||
+      !head.substr(start).starts_with("<?xml")) {
+    return std::string();
+  }
+  size_t end = head.find("?>", start);
+  if (end == std::string_view::npos) {
+    return std::string();
+  }
+  std::string_view decl = head.substr(start, end - start);
+  size_t pos = decl.find("encoding");
+  if (pos == std::string_view::npos) {
+    return std::string();
+  }
+  pos = decl.find_first_not_of(" \t\r\n", pos + 8);
+  if (pos == std::string_view::npos || decl[pos] != '=') {
+    return std::string();
+  }
+  pos = decl.find_first_not_of(" \t\r\n", pos + 1);
+  if (pos == std::string_view::npos ||
+      (decl[pos] != '"' && decl[pos] != '\'')) {
+    return std::string();
+  }
+  size_t close = decl.find(decl[pos], pos + 1);
+  if (close == std::string_view::npos) {
+    return std::string();
+  }
+  return std::string(decl.substr(pos + 1, close - pos - 1));
+}
+
+// `bytes` without a UTF-8 sequence cut off at its very end, as a body kept
+// up to a size cap usually has one. The cut alone must not make a UTF-8 body
+// look like another encoding.
+std::string_view WithoutCutUTF8Tail(std::string_view bytes) {
+  const size_t size = bytes.size();
+  for (size_t back = 1; back <= 3 && back <= size; ++back) {
+    const unsigned char c = static_cast<unsigned char>(bytes[size - back]);
+    if ((c & 0xC0) == 0x80) {
+      // A continuation byte: its lead is further back.
+      continue;
+    }
+    size_t length = 1;
+    if ((c & 0xE0) == 0xC0) {
+      length = 2;
+    } else if ((c & 0xF0) == 0xE0) {
+      length = 3;
+    } else if ((c & 0xF8) == 0xF0) {
+      length = 4;
+    }
+    return length > back ? bytes.substr(0, size - back) : bytes;
+  }
+  return bytes;
+}
+
+}  // namespace
+
+AgentFetchBody::AgentFetchBody() = default;
+AgentFetchBody::AgentFetchBody(AgentFetchBody&&) = default;
+AgentFetchBody& AgentFetchBody::operator=(AgentFetchBody&&) = default;
+AgentFetchBody::~AgentFetchBody() = default;
+
+AgentFetchBodySink::Options::Options() = default;
+AgentFetchBodySink::Options::Options(const Options&) = default;
