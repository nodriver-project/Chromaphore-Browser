+class HttpResponseHeaders;
+}  // namespace net
+
+// browser: one Browser.agentFetch call, from its start to its one reply.
+//
+// A GET without headers or body is a typed navigation in its own offscreen
+// page. A response that is not a page (or any response, in raw mode) is
+// taken before it commits and read by a body sink. A page commits; after
+// each cross-document commit of the primary main frame the job binds the
+// renderer agent, checks the response for a bot check, and either waits
+// through the check (polling its markers until the next commit clears it) or
+// lets the document settle, and then extracts it. Any other call is an API
+// call: a real fetch() from a synthetic document of the right origin.
+//
+// The job classifies at the browser level only (ok, challenge, blocked) and
+// passes everything finer on. It answers exactly once, unless it is
+// destroyed first, and asks its fetcher to destroy it through a posted task,
+// never from inside a WebContents or mojo callback.
+class AgentFetchJob : public content::WebContentsObserver,
+                      public content::AgentFetchResponseTaker {
+ public:
+  AgentFetchJob(AgentFetcher* fetcher,
+                AgentFetchParams params,
+                std::unique_ptr<AgentFetcher::Callback> callback);
+  AgentFetchJob(const AgentFetchJob&) = delete;
+  AgentFetchJob& operator=(const AgentFetchJob&) = delete;
+  ~AgentFetchJob() override;
+
+  const std::string& fetch_id() const { return params_.fetch_id; }
+  bool finished() const { return finished_; }
+
+  void Start();
+  // Answers "cancelled" and lets the fetcher tear the job down.
+  void Cancel();
+  // Answers "error" with `error`, unless the job has answered already.
+  void Fail(const std::string& error);
+
+  // content::AgentFetchResponseTaker:
+  bool ShouldTakeNavigationResponse(content::NavigationHandle& handle,
+                                    const network::mojom::URLResponseHead& head,
+                                    bool is_download) override;
+  void TakeNavigationResponse(
+      content::NavigationHandle& handle,
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      network::mojom::URLLoaderClientEndpointsPtr endpoints) override;
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* handle) override;
+  void DidRedirectNavigation(content::NavigationHandle* handle) override;
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void DOMContentLoaded(content::RenderFrameHost* render_frame_host) override;
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override;
+  void WebContentsDestroyed() override;
+
+ private:
+  // One redirect hop: the URL that answered with a redirect, and how.
+  struct Hop {
+    std::string url;
+    int status = 0;
+  };
+
+  // The response the reply describes: the last committed document's, the
+  // taken one's, or the API call's.
+  struct Response {
+    Response();
+    Response(Response&&);
+    Response& operator=(Response&&);
+    ~Response();
+
+    std::optional<int> status;
+    GURL final_url;
+    std::vector<Hop> redirects;
+    // It came after a server redirect (an API call's: fetch() followed one).
+    bool redirected = false;
+    std::string mime_type;
+    std::string charset;
+    AgentFetchHeaderMap headers;
+  };
+
+  void StartNavigation();
+  void StartSyntheticDocument();
+  void RecordResponse(int64_t navigation_id,
+                      const GURL& url,
+                      const net::HttpResponseHeaders* headers,
+                      const std::string& mime_type,
+                      const std::string& charset);
+  void OnNavigationNotCommitted(content::NavigationHandle* handle);
+  void OnErrorPageCommitted(content::NavigationHandle* handle);
+  void OnDocumentCommitted(content::NavigationHandle* handle);
+  bool BindAgent(content::RenderFrameHost* render_frame_host);
+  // Ends the document-level work in flight: replies to it are ignored.
+  void DropDocumentWork();
+  // For an empty reply about the current document: with no navigation in
+  // flight nothing will commit and rebind, so the agent is gone for good and
+  // the job ends with "error". True when it ended.
+  bool EndIfAgentGone();
+  int restarts() const;
+
+  // The challenge wait.
+  void EnterChallenge(const AgentFetchVerdict& verdict, int text_length);
+  void LeaveChallenge();
+  void PollMarkers();
+  void OnChallengeMarkers(int generation,
+                          blink::mojom::AgentChallengeMarkersPtr markers);
+
+  // Settle, a last look for a bot check, then extraction.
+  void StartSettle();
+  void OnSettled(int generation, blink::mojom::AgentSettleReportPtr report);
+  void CheckSettledDocument();
+  void OnSettledMarkers(int generation,
+                        blink::mojom::AgentChallengeMarkersPtr markers);
+  // A navigation the page has started (a script or meta redirect)
+  // is waited for, up to kNavigationWait, before this document is read.
+  void WaitForNavigationThenExtract();
+  void OnNavigationWaitOver();
+  void StartExtract();
+  void OnExtracted(int generation, blink::mojom::AgentExtractionPtr extraction);
+
+  // The API call.
+  void RunApiFetch();
+  void OnApiResponse(int generation,
+                     blink::mojom::AgentApiResponsePtr response);
+
+  void OnBodyDone(AgentFetchBody body);
+
+  void OnTimeout();
+  void FinishChallenge();
+  void FinishBlocked(const AgentFetchVerdict& verdict);
+  void Finish(const std::string& outcome, std::optional<std::string> error);
+  void SendReply(const std::string& outcome, std::optional<std::string> error);
+
+  const raw_ptr<AgentFetcher> fetcher_;
+  AgentFetchParams params_;
+  std::unique_ptr<AgentFetcher::Callback> callback_;
+
+  const base::TimeTicks created_;
+  base::TimeTicks deadline_;
+  bool finished_ = false;
+
+  std::unique_ptr<AgentFetchContents> contents_;
+  mojo::Remote<blink::mojom::AgentFetchAgent> agent_;
+  std::unique_ptr<AgentFetchBodySink> sink_;
+
+  // Bumped by every commit, takeover and the end, so that replies meant for
+  // an older document are ignored.
+  int generation_ = 0;
+  int commits_ = 0;
+  bool document_committed_ = false;
+  bool body_taken_ = false;
+  bool api_started_ = false;
+  bool api_truncated_ = false;
+  bool waiting_for_navigation_ = false;
+  int64_t taken_navigation_id_ = -1;
+  // Cross-document primary main-frame navigations started and not finished.
+  std::set<int64_t> navigations_in_flight_;
+  std::map<int64_t, std::vector<Hop>> pending_redirects_;
+
+  Response response_;
+  // The current document's response-level challenge signature.
+  std::optional<AgentFetchVerdict> response_challenge_;
+  std::optional<AgentFetchVerdict> challenge_;
+  std::optional<AgentFetchVerdict> block_;
+  bool challenge_active_ = false;
+  bool challenge_cleared_ = false;
+  int challenge_text_length_ = 0;
+  base::TimeTicks challenge_started_;
+  base::TimeTicks challenge_ended_;
+  base::TimeTicks interactive_since_;
+
+  // The settle budget (StartSettle) runs from here: the first commit, and
+  // again from each bot-check clear.
+  base::TimeTicks settle_budget_start_;
+  // The cap the last WaitForSettle was given, reported with its report.
+  base::TimeDelta settle_cap_;
+
+  blink::mojom::AgentChallengeMarkersPtr markers_;
+  blink::mojom::AgentSettleReportPtr settle_report_;
