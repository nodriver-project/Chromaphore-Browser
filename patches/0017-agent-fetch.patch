+void AgentFetchAgent::Bind(
+    mojo::PendingReceiver<mojom::blink::AgentFetchAgent> receiver) {
+  receiver_set_.Add(
+      std::move(receiver),
+      GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
