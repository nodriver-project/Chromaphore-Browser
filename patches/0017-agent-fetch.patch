+// ---------------------------------------------------------------------------
+// Signals and links.
+
+constexpr const char* kLoginSelectors[] = {
+    "input[type=password]", "input[autocomplete=current-password]",
+    "form[action*=login i]"};
+constexpr wtf_size_t kLoginCount =
+    static_cast<wtf_size_t>(std::size(kLoginSelectors));
+
+// The paywall selectors the classifier knows, matched by hand in the same
+// flat-tree walk (so shadow trees count too) and only on visible elements.
+// CheckPaywall indexes this list.
+// browser: the last four are Medium's member-only stories, whose preview
+// carries none of the other markers.
+constexpr const char* kPaywallSelectors[] = {".paywall",
+                                             "[class*='paywall' i]",
+                                             "[id*='paywall' i]",
+                                             "[data-testid*='paywall' i]",
+                                             "#gateway-content",
+                                             "[class*='regwall' i]",
+                                             ".tp-modal",
+                                             ".tp-container-inner",
+                                             ".wsj-snippet-login",
+                                             "#cx-snippet-overlay",
+                                             ".meteredContent",
+                                             "[data-testid='paywall']",
+                                             "[aria-label*='member-only' i]",
+                                             "[class*='member-only' i]"};
+constexpr wtf_size_t kPaywallCount =
+    static_cast<wtf_size_t>(std::size(kPaywallSelectors));
+
+constexpr char kMountRoots[] =
+    "#root,#__next,#app,#__nuxt,#___gatsby,app-root,#svelte,#react-root,"
+    "[data-reactroot]";
+
+struct PageScan {
+  int elements = 0;
+  int paragraphs = 0;
+  int headings = 0;
+  int password_fields = 0;
+  // browser: the rendered controls the reader leaves out (IsSkippedControl).
+  int controls = 0;
+  bool article_or_main = false;
+  bool modal_dialog = false;
+  bool fixed_cover = false;
+  // The largest visible canvas's share of the viewport, 0 to 1.
+  double canvas_coverage = 0;
+  std::array<bool, kLoginCount> login = {};
+  std::array<bool, kPaywallCount> paywall = {};
+};
+
+void CheckPaywall(const Element& element,
+                  std::array<bool, kPaywallCount>& hits) {
+  DEFINE_STATIC_LOCAL(const AtomicString, paywall_class, ("paywall"));
+  DEFINE_STATIC_LOCAL(const AtomicString, tp_modal_class, ("tp-modal"));
+  DEFINE_STATIC_LOCAL(const AtomicString, tp_inner_class,
+                      ("tp-container-inner"));
+  DEFINE_STATIC_LOCAL(const AtomicString, wsj_class, ("wsj-snippet-login"));
+  DEFINE_STATIC_LOCAL(const AtomicString, metered_class, ("meteredContent"));
+  DEFINE_STATIC_LOCAL(const AtomicString, test_id_attr, ("data-testid"));
+  static_assert(kPaywallCount == 14);
+  std::array<bool, kPaywallCount> found = {};
+  bool any = false;
+  if (element.HasClass()) {
+    const String& classes = element.GetClassAttribute().GetString();
+    found[0] = element.HasClassName(paywall_class);
+    found[1] = classes.FindIgnoringAsciiCase("paywall") != kNotFound;
+    found[5] = classes.FindIgnoringAsciiCase("regwall") != kNotFound;
+    found[6] = element.HasClassName(tp_modal_class);
+    found[7] = element.HasClassName(tp_inner_class);
+    found[8] = element.HasClassName(wsj_class);
+    found[10] = element.HasClassName(metered_class);
+    found[13] = classes.FindIgnoringAsciiCase("member-only") != kNotFound;
+  }
+  if (element.HasID()) {
+    const String& id = element.GetIdAttribute().GetString();
+    found[2] = id.FindIgnoringAsciiCase("paywall") != kNotFound;
+    found[4] = id == "gateway-content";
+    found[9] = id == "cx-snippet-overlay";
+  }
+  const AtomicString& test_id = element.getAttribute(test_id_attr);
+  if (!test_id.empty()) {
+    found[3] =
+        test_id.GetString().FindIgnoringAsciiCase("paywall") != kNotFound;
+    found[11] = test_id == "paywall";
+  }
+  const AtomicString& aria_label =
+      element.FastGetAttribute(html_names::kAriaLabelAttr);
+  if (!aria_label.empty()) {
+    found[12] = aria_label.GetString().FindIgnoringAsciiCase("member-only") !=
+                kNotFound;
+  }
+  for (bool hit : found) {
+    any = any || hit;
+  }
+  if (!any || !IsRendered(element)) {
+    return;
+  }
+  for (wtf_size_t i = 0; i < kPaywallCount; ++i) {
+    hits[i] = hits[i] || found[i];
+  }
+}
+
+// The landmark a link sits in: the extracted region counts as main, the body
+// too when it is the region (a link outside the chrome landmarks).
+String LinkRegion(const Element& link, const Element* region) {
+  for (const ContainerNode* node = FlatTreeTraversal::Parent(link); node;
+       node = FlatTreeTraversal::Parent(*node)) {
+    const auto* element = DynamicTo<Element>(node);
+    if (!element) {
+      continue;
+    }
+    if (element == region) {
+      return "main";
+    }
+    if (element->HasTagName(html_names::kBodyTag)) {
+      break;
+    }
+    if (const char* name = LandmarkName(*element)) {
+      return name;
+    }
+  }
+  return "none";
+}
+
+void AddLink(HTMLAnchorElementBase& anchor,
+             const Element* region,
+             const HashSet<String>& inline_hrefs,
+             HashSet<String>& seen,
+             Vector<mojom::blink::AgentLinkPtr>& links) {
+  const KURL url = anchor.Href();
+  if (!url.IsValid() || url.ProtocolIs("javascript")) {
+    return;
+  }
+  const String href = url.GetString().GetString();
+  if (href.empty() || !seen.insert(href).is_new_entry) {
+    return;
+  }
+  String text = Collapse(anchor.GetInnerTextWithoutUpdate(), false);
+  if (text.empty()) {
+    text = Collapse(LinkLabel(anchor), false);
+  }
+  auto link = mojom::blink::AgentLink::New();
+  link->url = href;
+  link->text = NonNull(Truncate(text, kLinkTextLength));
+  link->region = LinkRegion(anchor, region);
+  link->in_markdown = inline_hrefs.Contains(href);
+  link->rel = NonNull(Collapse(
+      anchor.FastGetAttribute(html_names::kRelAttr).GetString(), false));
+  links.push_back(std::move(link));
+}
+
+// One flat-tree pass over the whole document (shadow trees included): the
+// links, and the counts the classifier's signals need.
+void ScanPage(Document& document,
+              const Element* region,
+              const HashSet<String>& inline_hrefs,
+              bool want_links,
+              wtf_size_t max_links,
+              Vector<mojom::blink::AgentLinkPtr>& links,
+              PageScan& scan) {
+  LocalDOMWindow* window = document.domWindow();
+  const int64_t viewport_width = window ? window->innerWidth() : 0;
+  const int64_t viewport_height = window ? window->innerHeight() : 0;
+  // The visible part of the document, in the absolute coordinates that
+  // AbsoluteBoundingBoxRect uses (layout is clean: no update here).
+  gfx::Rect visible_rect;
+  if (const LocalFrameView* view = document.View()) {
+    if (const PaintLayerScrollableArea* layout_viewport =
+            view->LayoutViewport()) {
+      visible_rect = layout_viewport->VisibleContentRect(kExcludeScrollbars);
+    }
+  }
+  const uint64_t visible_area = visible_rect.size().Area64();
+  HashSet<String> seen;
+  int budget = kWalkNodeBudget;
+  for (Node* node = document.documentElement(); node && budget-- > 0;
+       node = FlatTreeTraversal::Next(*node)) {
+    auto* element = DynamicTo<Element>(node);
+    if (!element) {
+      continue;
+    }
+    ++scan.elements;
+    if (want_links && links.size() < max_links &&
+        element->FastHasAttribute(html_names::kHrefAttr)) {
+      if (auto* anchor = DynamicTo<HTMLAnchorElementBase>(element)) {
+        AddLink(*anchor, region, inline_hrefs, seen, links);
+      }
+    }
+    const LayoutObject* layout_object = element->GetLayoutObject();
+    if (!layout_object) {
+      continue;
+    }
+    if (IsSkippedControl(*element) && IsRendered(*element)) {
+      ++scan.controls;
+    }
+    if (element->HasTagName(html_names::kPTag)) {
+      ++scan.paragraphs;
+    } else if (element->HasTagName(html_names::kH1Tag) ||
+               element->HasTagName(html_names::kH2Tag) ||
+               element->HasTagName(html_names::kH3Tag)) {
+      ++scan.headings;
+    }
+    if (!scan.article_or_main) {
+      const ax::mojom::blink::Role role =
+          AXObject::DetermineRawAriaRole(*element);
+      scan.article_or_main = role == ax::mojom::blink::Role::kMain ||
+                             role == ax::mojom::blink::Role::kArticle ||
+                             element->HasTagName(html_names::kMainTag) ||
+                             element->HasTagName(html_names::kArticleTag);
+    }
+    if (const auto* dialog = DynamicTo<HTMLDialogElement>(element)) {
+      if (dialog->IsOpen() && dialog->IsModal()) {
+        scan.modal_dialog = true;
+      }
+    }
+    if (!scan.fixed_cover && viewport_width > 0 && viewport_height > 0 &&
+        layout_object->IsBox() &&
+        To<LayoutBox>(*layout_object).IsFixedToView() &&
+        layout_object->StyleRef().Visibility() == EVisibility::kVisible) {
+      const gfx::Rect box = layout_object->AbsoluteBoundingBoxRect();
+      const int64_t width =
+          std::min<int64_t>(std::max(box.width(), 0), viewport_width);
+      const int64_t height =
+          std::min<int64_t>(std::max(box.height(), 0), viewport_height);
+      scan.fixed_cover = width * height * 2 > viewport_width * viewport_height;
+    }
+    // browser: a canvas app (a whiteboard, a map, a game) draws its content
+    // where the text walk cannot see it; the classifier learns how much of
+    // the window a canvas fills.
+    if (visible_area && element->HasTagName(html_names::kCanvasTag) &&
+        layout_object->StyleRef().Visibility() == EVisibility::kVisible) {
+      gfx::Rect box = layout_object->AbsoluteBoundingBoxRect();
+      box.Intersect(visible_rect);
+      scan.canvas_coverage = std::max(scan.canvas_coverage,
+                                      static_cast<double>(box.size().Area64()) /
+                                          static_cast<double>(visible_area));
+    }
+    if (const auto* input = DynamicTo<HTMLInputElement>(element)) {
+      const bool password = input->FormControlType() ==
+                            mojom::blink::FormControlType::kInputPassword;
+      const bool current_password =
+          input->FastGetAttribute(html_names::kAutocompleteAttr)
+              .GetString()
+              .FindIgnoringAsciiCase("current-password") != kNotFound;
+      if ((password || current_password) && IsRendered(*input)) {
+        if (password) {
+          ++scan.password_fields;
+          scan.login[0] = true;
+        }
+        if (current_password) {
+          scan.login[1] = true;
+        }
+      }
+    } else if (element->HasTagName(html_names::kFormTag)) {
+      if (element->FastGetAttribute(html_names::kActionAttr)
+                  .GetString()
+                  .FindIgnoringAsciiCase("login") != kNotFound &&
+          IsRendered(*element)) {
+        scan.login[2] = true;
+      }
+    }
+    CheckPaywall(*element, scan.paywall);
+  }
+}
+
+bool IsScrollLocked(const Element* element) {
+  const ComputedStyle* style = element ? element->GetComputedStyle() : nullptr;
+  return style && (style->OverflowY() == EOverflow::kHidden ||
+                   style->OverflowY() == EOverflow::kClip);
+}
