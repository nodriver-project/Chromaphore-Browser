+// Extract -------------------------------------------------------------------
+
+void AgentFetchAgent::Extract(mojom::blink::AgentExtractOptionsPtr options,
+                              ExtractCallback callback) {
+  ExtractFacts(
+      std::make_unique<ExtractJob>(std::move(options), std::move(callback)));
+}
+
+void AgentFetchAgent::PostExtractStep(
+    void (AgentFetchAgent::*step)(std::unique_ptr<ExtractJob>),
+    std::unique_ptr<ExtractJob> job) {
+  // If the agent is collected first, the task is cancelled and drops the
+  // job (and its callback) together with the receiver.
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostTask(FROM_HERE, blink::BindOnce(step, WrapWeakPersistent(this),
+                                            std::move(job)));
+}
+
+// static
+void AgentFetchAgent::FinishExtract(ExtractJob& job) {
+  if (!job.callback || !job.result) {
+    return;
+  }
+  if (job.facts) {
+    job.result->facts_json = NonNull(job.facts->ToJSONString());
+  }
+  std::move(job.callback).Run(std::move(job.result));
+}
+
+// Task (a): facts from the live document.
+void AgentFetchAgent::ExtractFacts(std::unique_ptr<ExtractJob> job) {
+  Document& document = *GetSupplementable();
+  if (!IsUsable(document)) {
+    FinishExtract(*job);
+    return;
+  }
+  mojom::blink::AgentExtraction& result = *job->result;
+
+  auto meta = std::make_unique<JSONObject>();
+  auto og = std::make_unique<JSONObject>();
+  auto twitter = std::make_unique<JSONObject>();
+  CollectMeta(document, *meta, *og, *twitter);
+  auto jsonld = std::make_unique<JSONArray>();
+  job->not_free = CollectJsonLd(document, *jsonld);
+  String og_title;
+  og->GetString("og:title", &og_title);
+  job->og_title = Collapse(og_title, false);
+
+  result.title = NonNull(Collapse(document.title(), false));
+  if (result.title.empty()) {
+    result.title = NonNull(job->og_title);
+  }
+  result.lang = NonNull(Collapse(document.documentElement()
+                                     ->FastGetAttribute(html_names::kLangAttr)
+                                     .GetString(),
+                                 false));
+  if (result.lang.empty()) {
+    String content_language;
+    meta->GetString("content-language", &content_language);
+    result.lang = NonNull(content_language);
+  }
+  result.canonical = Canonical(document);
+
+  job->facts = std::make_unique<JSONObject>();
+  job->facts->SetObject("meta", std::move(meta));
+  job->facts->SetObject("og", std::move(og));
+  job->facts->SetObject("twitter", std::move(twitter));
+  job->facts->SetArray("jsonld", std::move(jsonld));
+
+  PostExtractStep(&AgentFetchAgent::ExtractReadability, std::move(job));
+}
+
+// Task (b): readerable on the live document, then the clone and Readability,
+// in the private world.
+void AgentFetchAgent::ExtractReadability(std::unique_ptr<ExtractJob> job) {
+  Document& document = *GetSupplementable();
+  if (!IsUsable(document)) {
+    FinishExtract(*job);
+    return;
+  }
+  mojom::blink::AgentExtraction& result = *job->result;
+
+  ReadabilityOutcome outcome;
+  // Readability is skipped on a very large DOM: its parse would be a long
+  // task; the structural walk serves instead.
+  if (job->prefer_readability &&
+      CountElements(document, kReadabilityElementLimit + 1) <=
+          kReadabilityElementLimit) {
+    outcome = RunReadability(document);
+  }
+  job->readerable = outcome.readerable;
+  job->article = outcome.article;
+  auto readability = std::make_unique<JSONObject>();
+  readability->SetString("byline", NonNull(outcome.byline));
+  readability->SetString("siteName", NonNull(outcome.site_name));
+  readability->SetString("publishedTime", NonNull(outcome.published_time));
+  readability->SetString("excerpt", NonNull(outcome.excerpt));
+  if (job->facts) {
+    job->facts->SetObject("readability", std::move(readability));
+  }
+  if (result.title.empty()) {
+    result.title = NonNull(Collapse(outcome.title, false));
+  }
+  if (result.lang.empty()) {
+    result.lang = NonNull(outcome.lang);
+  }
+  result.readerable = job->readerable;
+
+  PostExtractStep(&AgentFetchAgent::ExtractContent, std::move(job));
+}
+
+// Task (c): the structural walk of the live document, and the choice
+// between it and Readability's article.
+void AgentFetchAgent::ExtractContent(std::unique_ptr<ExtractJob> job) {
+  Document& document = *GetSupplementable();
+  if (!IsUsable(document)) {
+    FinishExtract(*job);
+    return;
+  }
+  document.UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  HTMLElement* body = document.body();
+  if (!body || !IsUsable(document)) {
+    FinishExtract(*job);
+    return;
+  }
+  mojom::blink::AgentExtraction& result = *job->result;
+  const String body_text = body->GetInnerTextWithoutUpdate();
+  result.visible_text_length =
+      base::saturated_cast<int32_t>(CollapsedLength(body_text));
+  Element* region = ChooseRegion(*body, body_text.length());
+  job->region = region;
+
+  MarkdownEmitter structural(/*live=*/true, region,
+                             /*skip_chrome=*/region == body, body_text.length(),
+                             job->max_markdown_chars);
+  structural.EmitChildrenOf(*region);
+  result.main_text_length =
+      base::saturated_cast<int32_t>(structural.text_chars());
+
+  // Readability's article wins when the page is readerable and the article
+  // holds at least half of the main region's visible text.
+  bool used_readability = false;
+  if (job->readerable && job->article) {
+    MarkdownEmitter article(/*live=*/false, /*region=*/nullptr,
+                            /*skip_chrome=*/false, /*body_text_length=*/0,
+                            job->max_markdown_chars);
+    article.EmitChildrenOf(*job->article);
+    if (article.text_chars() &&
+        article.text_chars() * 2 >= structural.text_chars()) {
+      AdoptMarkdown(article, "readability", result);
+      job->inline_hrefs = std::move(article.hrefs());
+      used_readability = true;
+    }
+  }
+  if (!used_readability) {
+    AdoptMarkdown(structural, "structural", result);
+    job->inline_hrefs = std::move(structural.hrefs());
+  } else {
+    PrependTitle(result, job->og_title.empty() ? result.title : job->og_title);
+  }
+  // The clone is no longer needed.
+  job->article = nullptr;
+
+  PostExtractStep(&AgentFetchAgent::ExtractLinksAndSignals, std::move(job));
+}
+
+// Task (d): links and the classifier's signals; replies.
+void AgentFetchAgent::ExtractLinksAndSignals(std::unique_ptr<ExtractJob> job) {
+  Document& document = *GetSupplementable();
+  if (!IsUsable(document)) {
+    FinishExtract(*job);
+    return;
+  }
+  document.UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  if (!IsUsable(document)) {
+    FinishExtract(*job);
+    return;
+  }
+  mojom::blink::AgentExtraction& result = *job->result;
+
+  PageScan scan;
+  ScanPage(document, job->region.Get(), job->inline_hrefs, job->want_links,
+           job->max_links, result.links, scan);
+
+  bool mount_root_empty = false;
+  if (StaticElementList* roots =
+          document.QuerySelectorAll(AtomicString(kMountRoots))) {
+    const wtf_size_t count = std::min<wtf_size_t>(roots->length(), 10);
+    for (wtf_size_t i = 0; i < count && !mount_root_empty; ++i) {
+      mount_root_empty =
+          CollapsedLength(roots->item(i)->GetInnerTextWithoutUpdate()) < 50;
+    }
+  }
+  // A page whose only words are in a <noscript> (not rendered while script
+  // runs): next to nothing visible, and a <noscript> with text.
+  bool noscript_only = false;
+  if (result.visible_text_length < 50) {
+    if (StaticElementList* noscripts =
+            document.QuerySelectorAll(AtomicString("noscript"))) {
+      const wtf_size_t count = std::min<wtf_size_t>(noscripts->length(), 10);
+      for (wtf_size_t i = 0; i < count && !noscript_only; ++i) {
+        noscript_only =
+            CollapsedLength(noscripts->item(i)->textContent()) >= 20;
+      }
+    }
+  }
+  const bool scroll_locked = IsScrollLocked(document.body()) ||
+                             IsScrollLocked(document.documentElement());
+
+  auto signals = std::make_unique<JSONObject>();
+  signals->SetInteger("visible_text_length", result.visible_text_length);
+  signals->SetInteger("main_text_length", result.main_text_length);
+  signals->SetInteger("password_fields_visible", scan.password_fields);
+  signals->SetInteger("skipped_controls", scan.controls);
+  signals->SetInteger("paragraph_count", scan.paragraphs);
+  signals->SetInteger("heading_count", scan.headings);
+  signals->SetBoolean("has_article_or_main", scan.article_or_main);
+  signals->SetBoolean("mount_root_empty", mount_root_empty);
+  signals->SetBoolean("not_free", job->not_free);
+  auto paywall = std::make_unique<JSONArray>();
+  for (wtf_size_t i = 0; i < kPaywallCount; ++i) {
+    if (scan.paywall[i]) {
+      paywall->PushString(kPaywallSelectors[i]);
+    }
+  }
+  signals->SetArray("paywall_selectors", std::move(paywall));
+  auto login = std::make_unique<JSONArray>();
+  for (wtf_size_t i = 0; i < kLoginCount; ++i) {
+    if (scan.login[i]) {
+      login->PushString(kLoginSelectors[i]);
+    }
+  }
+  signals->SetArray("login_selectors", std::move(login));
+  signals->SetBoolean("modal_open",
+                      scan.modal_dialog || (scan.fixed_cover && scroll_locked));
+  signals->SetBoolean("scroll_locked", scroll_locked);
+  signals->SetBoolean("noscript_only", noscript_only);
+  // browser: a canvas over 40% of the window means the page's content is
+  // drawn, not written (excalidraw's onboarding hints are not the page).
+  signals->SetBoolean("large_canvas", scan.canvas_coverage >= 0.4);
+  signals->SetDouble("canvas_coverage",
+                     std::round(scan.canvas_coverage * 1000) / 1000);
+  signals->SetInteger("element_count", scan.elements);
+  result.signals_json = NonNull(signals->ToJSONString());
+
+  FinishExtract(*job);
+}
+
+// RunFetch ------------------------------------------------------------------
+
+void AgentFetchAgent::RunFetch(mojom::blink::AgentApiRequestPtr request,
+                               RunFetchCallback callback) {
+  Document& document = *GetSupplementable();
+  LocalFrame* frame = document.GetFrame();
+  LocalDOMWindow* window = document.domWindow();
+  if (!frame || !window) {
+    ReplyFetchError(std::move(callback), "no document");
+    return;
+  }
+  // The executor would queue the script until the page resumes, by when the
+  // world's origin may have been set for another document: refuse instead.
+  if (window->IsContextFrozenOrPaused()) {
+    ReplyFetchError(std::move(callback), "the page is paused");
+    return;
+  }
+  PrepareWorld(*window);
+  v8::Isolate* isolate = ToIsolate(frame);
+  v8::HandleScope handle_scope(isolate);
+  ScriptState* script_state =
+      ToScriptState(frame, *DOMWrapperWorld::EnsureIsolatedWorld(
+                               isolate, IsolatedWorldId::kAgentFetchWorldId));
+  if (!script_state || !script_state->ContextIsValid()) {
+    ReplyFetchError(std::move(callback), "no script context");
+    return;
+  }
+  const int32_t max_body =
+      request->max_body_bytes > 0
+          ? std::min(request->max_body_bytes, kMaxBodyBytes)
+          : kMaxBodyBytes;
+  const int32_t timeout_ms =
+      request->timeout_ms > 0
+          ? std::min(request->timeout_ms, kMaxFetchTimeoutMs)
+          : kDefaultFetchTimeoutMs;
+  Vector<WebScriptSource> sources;
+  sources.push_back(WebScriptSource(
+      WebString(BuildFetchScript(*request, max_body, timeout_ms))));
+  // browser: a real fetch() from the page's own fetch path, in the private
+  // world, awaited by the executor; the page sees only its network effect.
+  PausableScriptExecutor::CreateAndRun(
+      script_state, std::move(sources),
+      ExecuteScriptPolicy::kExecuteScriptWhenScriptsDisabled,
+      mojom::blink::UserActivationOption::kDoNotActivate,
+      mojom::blink::EvaluationTiming::kSynchronous,
+      mojom::blink::LoadEventBlockingOption::kDoNotBlock,
+      mojom::blink::WantResultOption::kWantResult,
+      mojom::blink::PromiseResultOption::kAwait,
+      blink::BindOnce(&OnFetchResult, std::move(callback)),
+      /*script_injector_id=*/String());
+}
+
+}  // namespace blink
