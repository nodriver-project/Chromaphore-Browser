 gfx::Rect HWNDMessageHandlerHeadless::GetZoomedWindowBounds() {
+  if (!display::win::GetScreenWin()->IsHeadless()) {
+    // browser: a headless window in a headed browser (Widget::InitParams::
+    // headless_native_window) zooms to the real work area of its monitor,
+    // already in pixels. GetScreenWinHeadless() would CHECK.
+    RECT rect = bounds_.ToRECT();
+    MONITORINFO monitor_info = {};
+    monitor_info.cbSize = sizeof(monitor_info);
+    if (::GetMonitorInfo(::MonitorFromRect(&rect, MONITOR_DEFAULTTONEAREST),
+                         &monitor_info)) {
+      return gfx::Rect(monitor_info.rcWork);
+    }
+    return bounds_;
+  }
   gfx::Rect zoomed_bounds = display::win::GetScreenWinHeadless()
                                 ->GetDisplayMatching(bounds_)
                                 .work_area();
