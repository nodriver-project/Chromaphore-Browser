+// Markers.
+
+enum Marker : wtf_size_t {
+  kCfTitle,
+  kCfChlOpt,
+  kCfOrchestrate,
+  kCfErrorText,
+  kCfLegacy,
+  kCfRefresh,
+  kDdVar,
+  kDdCmsg,
+  kDdScript,
+  kPxCaptcha,
+  kPxInline,
+  kKasadaInline,
+  kKasadaIps,
+  kWafInline,
+  kWafScript,
+  kAkamaiCpt,
+  kImpervaResource,
+  kGoogleSorry,
+  kCaptchaFrame,
+  kRecaptchaAnchor,
+  kHcaptchaFrame,
+  kTurnstileFrame,
+  kMetaRefresh,
+  kMarkerCount,
+};
+
+constexpr const char* kMarkerNames[] = {
+    "cf.title",         "cf.chl_opt",      "cf.orchestrate", "cf.error_text",
+    "cf.legacy",        "cf.refresh",      "dd.var",         "dd.cmsg",
+    "dd.script",        "px.captcha",      "px.inline",      "kasada.inline",
+    "kasada.ips",       "waf.inline",      "waf.script",     "akamai.cpt",
+    "imperva.resource", "google.sorry",    "captcha.frame",  "recaptcha.anchor",
+    "hcaptcha.frame",   "turnstile.frame", "meta.refresh"};
+static_assert(std::size(kMarkerNames) == kMarkerCount);
+
+using MarkerHits = std::array<bool, kMarkerCount>;
+
+bool HasMatch(Document& document, const char* selectors) {
+  return document.QuerySelector(AtomicString(selectors)) != nullptr;
+}
+
+// /cdn-cgi/challenge-platform/h/<x>/orchestrate/ (the challenge page's own
+// script; the jsd and precursor scripts on normal pages do not match).
+bool IsOrchestrateScript(const String& src) {
+  static constexpr char kPrefix[] = "/cdn-cgi/challenge-platform/h/";
+  const wtf_size_t at = src.find(kPrefix);
+  if (at == kNotFound) {
+    return false;
+  }
+  const wtf_size_t begin = at + static_cast<wtf_size_t>(sizeof(kPrefix) - 1);
+  wtf_size_t end = begin;
+  while (end < src.length() && IsWordChar(src[end])) {
+    ++end;
+  }
+  return end > begin && src.find("/orchestrate/", end) == end;
+}
+
+void ScanScripts(Document& document,
+                 MarkerHits& hit,
+                 mojom::blink::AgentChallengeMarkers& markers) {
+  StaticElementList* scripts =
+      document.QuerySelectorAll(AtomicString("script"));
+  if (!scripts) {
+    return;
+  }
+  const wtf_size_t count = std::min<wtf_size_t>(scripts->length(), kMaxScripts);
+  for (wtf_size_t i = 0; i < count; ++i) {
+    const Element* script = scripts->item(i);
+    const String& src =
+        script->FastGetAttribute(html_names::kSrcAttr).GetString();
+    if (!src.empty()) {
+      hit[kCfOrchestrate] = hit[kCfOrchestrate] || IsOrchestrateScript(src);
+      hit[kDdScript] = hit[kDdScript] || src.contains("captcha-delivery.com");
+      hit[kKasadaIps] = hit[kKasadaIps] || src.contains("/ips.js");
+      hit[kWafScript] = hit[kWafScript] || src.contains("awswaf.com");
+      hit[kAkamaiCpt] = hit[kAkamaiCpt] || src.contains("/_sec/cp_challenge/");
+      hit[kImpervaResource] =
+          hit[kImpervaResource] || src.contains("_Incapsula_Resource");
+      hit[kPxCaptcha] = hit[kPxCaptcha] || src.contains("captcha.px-cdn.net");
+      continue;
+    }
+    // Inline: the isolated world cannot see main-world globals, so the
+    // script's text is what is tested.
+    const String head = ChildText(*script, kInlineScriptPrefix);
+    if (head.empty()) {
+      continue;
+    }
+    hit[kCfChlOpt] = hit[kCfChlOpt] || head.contains("_cf_chl_opt");
+    hit[kKasadaInline] = hit[kKasadaInline] || head.contains("window.KPSDK");
+    hit[kPxInline] = hit[kPxInline] || head.contains("_pxAppId");
+    hit[kWafInline] = hit[kWafInline] || head.contains("AwsWafIntegration") ||
+                      head.contains("gokuProps");
+    if (!hit[kDdVar] && head.contains("var dd={")) {
+      hit[kDdVar] = true;
+      markers.dd_rt = NonNull(QuotedField(head, "'rt':'"));
+      markers.dd_t = NonNull(QuotedField(head, "'t':'"));
+    }
+  }
+}
+
+void ScanMetaRefresh(Document& document, MarkerHits& hit) {
+  StaticElementList* metas =
+      document.QuerySelectorAll(AtomicString("meta[http-equiv]"));
+  if (!metas) {
+    return;
+  }
+  const wtf_size_t count = std::min<wtf_size_t>(metas->length(), 50);
+  for (wtf_size_t i = 0; i < count; ++i) {
+    const auto* meta = DynamicTo<HTMLMetaElement>(metas->item(i));
+    if (!meta || !EqualIgnoringAsciiCase(meta->HttpEquiv(), "refresh")) {
+      continue;
+    }
+    hit[kMetaRefresh] = true;
+    // Cloudflare's challenge page: content="360".
+    const String content = meta->Content().GetString().StripWhiteSpace();
+    if (content.starts_with("360") &&
+        (content.length() == 3 || content[3] < '0' || content[3] > '9')) {
+      hit[kCfRefresh] = true;
+    }
+  }
+}
+
+void TestFrameUrl(const KURL& url, MarkerHits& hit, Vector<String>& hosts) {
+  if (!url.IsValid() || !url.ProtocolIsInHttpFamily()) {
+    return;
+  }
+  const String host = url.Host().ToString().ToAsciiLower();
+  const String& spec = url.GetString().GetString();
+  if (!host.empty() && hosts.size() < kMaxFrameHosts && !hosts.Contains(host)) {
+    hosts.push_back(host);
+  }
+  if (host == "challenges.cloudflare.com") {
+    hit[kTurnstileFrame] = true;
+  }
+  if ((HostIs(host, "captcha-delivery.com") &&
+       (spec.contains("/captcha") || spec.contains("/interstitial"))) ||
+      HostIs(host, "arkoselabs.com")) {
+    hit[kCaptchaFrame] = true;
+  }
+  if ((spec.contains("/recaptcha/api2/anchor") ||
+       spec.contains("/recaptcha/enterprise/anchor")) &&
+      !spec.contains("size=invisible")) {
+    hit[kRecaptchaAnchor] = true;
+  }
+  if (HostIs(host, "hcaptcha.com") && spec.contains("/captcha")) {
+    hit[kHcaptchaFrame] = true;
+  }
+  if (spec.contains("_Incapsula_Resource")) {
+    hit[kImpervaResource] = true;
+  }
+  if (spec.contains("/_sec/cp_challenge/")) {
+    hit[kAkamaiCpt] = true;
+  }
+}
+
+// Child frames from the frame tree (a frame in a closed shadow root is there
+// too; an OOPIF's URL comes from its owner's src), plus iframe[src] in the
+// light DOM for frames not created yet.
+void ScanFrames(Document& document, MarkerHits& hit, Vector<String>& hosts) {
+  Vector<KURL> urls;
+  if (LocalFrame* frame = document.GetFrame()) {
+    for (Frame* child = frame->FirstChild();
+         child && urls.size() < kMaxFrameUrls; child = child->NextSibling()) {
+      if (auto* local_child = DynamicTo<LocalFrame>(child)) {
+        if (Document* child_document = local_child->GetDocument()) {
+          urls.push_back(child_document->Url());
+        }
+      }
+      if (HTMLFrameOwnerElement* owner = child->DeprecatedLocalOwner()) {
+        const String src = UrlAttribute(owner, html_names::kSrcAttr);
+        if (!src.empty()) {
+          urls.push_back(KURL(src));
+        }
+      }
+    }
+  }
+  if (StaticElementList* frames =
+          document.QuerySelectorAll(AtomicString("iframe[src],frame[src]"))) {
+    const wtf_size_t count = std::min<wtf_size_t>(frames->length(), 64);
+    for (wtf_size_t i = 0; i < count && urls.size() < kMaxFrameUrls * 2; ++i) {
+      const String src = UrlAttribute(frames->item(i), html_names::kSrcAttr);
+      if (!src.empty()) {
+        urls.push_back(KURL(src));
+      }
+    }
+  }
+  for (const KURL& url : urls) {
+    TestFrameUrl(url, hit, hosts);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// RunFetch.
+
+void AppendJsonString(StringBuilder& out, const String& value) {
+  out.Append('"');
+  EscapeStringForJSON(value, &out);
+  out.Append('"');
+}
+
+// The rest of the fetch() expression after `const r = await fetch(...)`:
+// reads the body up to `max` bytes and resolves to a plain object the
+// embedder's value converter turns into a base::Value (the ArrayBuffer
+// becomes a BLOB).
+constexpr char kFetchScriptTail[] = R"JS(
+  const chunks = [];
+  let size = 0;
+  let truncated = false;
+  if (r.body) {
+    const reader = r.body.getReader();
+    for (;;) {
+      const {done, value} = await reader.read();
+      if (done) {
+        break;
+      }
+      if (size + value.byteLength > max) {
+        chunks.push(value.subarray(0, max - size));
+        size = max;
+        truncated = true;
+        await reader.cancel().catch(() => {});
+        break;
+      }
+      chunks.push(value);
+      size += value.byteLength;
+    }
+  }
+  const body = new Uint8Array(size);
+  let at = 0;
+  for (const chunk of chunks) {
+    body.set(chunk, at);
+    at += chunk.byteLength;
+  }
+  return {ok: true, status: r.status, statusText: r.statusText, url: r.url,
+          redirected: r.redirected, headers: [...r.headers],
+          body: body.buffer, truncated};
+})().catch((e) => ({ok: false, error: String((e && e.message) || e)}))
+)JS";
+
+// browser: every value spliced into the script is JSON-encoded, so nothing
+// from the request reaches the parser unescaped. An absent body is left out
+// of the init, not passed as null.
+String BuildFetchScript(const mojom::blink::AgentApiRequest& request,
+                        int32_t max_body,
+                        int32_t timeout_ms) {
+  StringBuilder script;
+  script.Append("(async () => {\n  const max = ");
+  script.AppendNumber(max_body);
+  script.Append(";\n  const init = {method: ");
+  AppendJsonString(script,
+                   request.method.empty() ? String("GET") : request.method);
+  script.Append(", headers: [");
+  const wtf_size_t headers =
+      std::min(request.header_names.size(), request.header_values.size());
+  for (wtf_size_t i = 0; i < headers; ++i) {
+    if (i) {
+      script.Append(", ");
+    }
+    script.Append('[');
+    AppendJsonString(script, request.header_names[i]);
+    script.Append(", ");
+    AppendJsonString(script, request.header_values[i]);
+    script.Append(']');
+  }
+  script.Append(
+      "], credentials: \"include\", redirect: \"follow\", "
+      "signal: AbortSignal.timeout(");
+  script.AppendNumber(timeout_ms);
+  script.Append(")};\n");
+  if (request.has_body) {
+    script.Append("  init.body = ");
+    AppendJsonString(script, request.body);
+    script.Append(";\n");
+  }
+  script.Append("  const r = await fetch(");
+  AppendJsonString(script, request.url);
+  script.Append(", init);");
+  script.Append(kFetchScriptTail);
+  return script.ReleaseString();
+}
+
+mojom::blink::AgentApiResponsePtr NewApiResponse() {
+  auto response = mojom::blink::AgentApiResponse::New();
+  response->error = g_empty_string;
+  response->status_text = g_empty_string;
+  response->url = g_empty_string;
+  return response;
+}
+
+// Answers RunFetch with `error` and nothing else.
+void ReplyFetchError(mojom::blink::AgentFetchAgent::RunFetchCallback callback,
+                     const char* error) {
+  mojom::blink::AgentApiResponsePtr response = NewApiResponse();
+  response->error = error;
+  std::move(callback).Run(std::move(response));
+}
+
+String ReadString(const base::DictValue& dict, std::string_view key) {
+  const std::string* value = dict.FindString(key);
+  return value ? NonNull(String::FromUtf8(*value)) : g_empty_string;
+}
+
+int32_t ReadInt(const base::DictValue& dict, std::string_view key) {
+  if (const std::optional<int> value = dict.FindInt(key)) {
+    return *value;
+  }
+  if (const std::optional<double> value = dict.FindDouble(key)) {
+    return base::saturated_cast<int32_t>(*value);
+  }
+  return 0;
+}
+
+void OnFetchResult(mojom::blink::AgentFetchAgent::RunFetchCallback callback,
+                   std::optional<base::Value> value,
+                   base::TimeTicks) {
+  const base::DictValue* dict = value ? value->GetIfDict() : nullptr;
+  if (!dict) {
+    ReplyFetchError(std::move(callback), "no result");
+    return;
+  }
+  mojom::blink::AgentApiResponsePtr response = NewApiResponse();
+  response->ok = dict->FindBool("ok").value_or(false);
+  response->error = ReadString(*dict, "error");
+  response->status = ReadInt(*dict, "status");
+  response->status_text = ReadString(*dict, "statusText");
+  response->url = ReadString(*dict, "url");
+  response->redirected = dict->FindBool("redirected").value_or(false);
+  response->truncated = dict->FindBool("truncated").value_or(false);
+  if (const base::ListValue* headers = dict->FindList("headers")) {
+    for (const base::Value& pair : *headers) {
+      const base::ListValue* entry = pair.GetIfList();
+      if (!entry || entry->size() != 2) {
+        continue;
+      }
+      const std::string* name = (*entry)[0].GetIfString();
+      const std::string* header_value = (*entry)[1].GetIfString();
+      if (!name || !header_value) {
+        continue;
+      }
+      response->header_names.push_back(NonNull(String::FromUtf8(*name)));
+      response->header_values.push_back(
+          NonNull(String::FromUtf8(*header_value)));
+    }
+  }
+  if (const base::Value* body = dict->Find("body"); body && body->is_blob()) {
+    response->body = mojo_base::BigBuffer(base::span(body->GetBlob()));
+  }
+  if (!response->ok && response->error.empty()) {
+    response->error = "fetch failed";
+  }
+  std::move(callback).Run(std::move(response));
+}
+
+// ---------------------------------------------------------------------------
+// Shared.
+
+bool IsUsable(const Document& document) {
+  return document.GetFrame() && document.documentElement() &&
+         document.domWindow();
+}
+
+const char* ReadyState(const Document& document) {
+  if (document.IsLoadCompleted()) {
+    return "complete";
+  }
+  return document.HasFinishedParsing() ? "interactive" : "loading";
+}
+
+// The settle signature, read from the last frame's layout (no forced
+// layout) in one flat-tree walk of the body: the visible characters of its
+// laid-out Text nodes (whitespace collapsed per node) and how many such
+// nodes there are. The walk stops past kMeasureTextLimit characters or
+// kWalkNodeBudget nodes and then returns false: the counts are partial.
+bool MeasureText(Document& document, int32_t* length, int32_t* nodes) {
+  *length = 0;
+  *nodes = 0;
+  HTMLElement* body = document.body();
+  if (!body) {
+    return true;
+  }
+  int64_t chars = 0;
+  int32_t count = 0;
+  int budget = kWalkNodeBudget;
+  bool complete = true;
+  for (Node* node = FlatTreeTraversal::FirstChild(*body); node;
+       node = FlatTreeTraversal::Next(*node, body)) {
+    if (--budget < 0) {
+      complete = false;
+      break;
+    }
+    const auto* text = DynamicTo<Text>(node);
+    if (!text) {
+      continue;
+    }
+    const LayoutObject* layout_object = text->GetLayoutObject();
+    if (!layout_object ||
+        layout_object->StyleRef().Visibility() != EVisibility::kVisible) {
+      continue;
+    }
+    // The raw length bounds the scan before it is spent.
+    if (chars + text->length() > kMeasureTextLimit) {
+      complete = false;
+      break;
+    }
+    ++count;
+    chars += CollapsedLength(text->data());
+  }
+  *length = base::saturated_cast<int32_t>(chars);
+  *nodes = count;
+  return complete;
+}
+
+mojom::blink::AgentExtractionPtr NewExtraction() {
+  auto result = mojom::blink::AgentExtraction::New();
+  result->title = g_empty_string;
+  result->lang = g_empty_string;
+  result->canonical = g_empty_string;
+  result->extractor = "none";
+  result->markdown = g_empty_string;
+  result->facts_json = "{}";
+  result->signals_json = "{}";
+  return result;
+}
+
+void AdoptMarkdown(const MarkdownEmitter& emitter,
+                   const char* extractor,
+                   mojom::blink::AgentExtraction& result) {
+  result.markdown = NonNull(emitter.markdown());
+  result.extractor = result.markdown.empty() ? "none" : extractor;
+  result.truncated = emitter.truncated();
+  result.outline.clear();
+  for (const OutlineEntry& entry : emitter.outline()) {
+    result.outline.push_back(mojom::blink::AgentOutlineItem::New(
+        entry.level, NonNull(entry.text),
+        base::saturated_cast<int32_t>(entry.offset)));
+  }
+}
+
+// Readability may drop the page's h1: when the markdown has none, the page
+// title goes on top as one, at offset 0.
+void PrependTitle(mojom::blink::AgentExtraction& result, const String& title) {
+  if (title.empty()) {
+    return;
+  }
+  for (const auto& item : result.outline) {
+    if (item->level == 1) {
+      return;
+    }
+  }
+  StringBuilder markdown;
+  markdown.Append("# ");
+  markdown.Append(title);
+  markdown.Append("\n\n");
+  const int32_t shift = base::saturated_cast<int32_t>(markdown.length());
+  markdown.Append(result.markdown);
+  result.markdown = markdown.ReleaseString();
+  Vector<mojom::blink::AgentOutlineItemPtr> outline;
+  outline.push_back(mojom::blink::AgentOutlineItem::New(
+      1, Truncate(title, kOutlineTextLength), 0));
+  for (auto& item : result.outline) {
+    item->offset = base::saturated_cast<int32_t>(
+        static_cast<int64_t>(item->offset) + shift);
+    outline.push_back(std::move(item));
+  }
+  result.outline = std::move(outline);
+}
