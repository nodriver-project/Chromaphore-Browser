@@ -0,0 +1,178 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_AGENT_FETCH_BODY_SINK_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_AGENT_FETCH_BODY_SINK_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "mojo/public/cpp/system/data_pipe_drainer.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "url/gurl.h"
+
+class AgentFetchFileWriter;
+
+// browser: a response body Browser.agentFetch read to the end, as the reply
+// carries it.
+struct AgentFetchBody {
+  AgentFetchBody();
+  AgentFetchBody(AgentFetchBody&&);
+  AgentFetchBody& operator=(AgentFetchBody&&);
+  ~AgentFetchBody();
+
+  // net::OK, or why the body stopped early.
+  int net_error = 0;
+  // html | text | json | xml | binary
+  std::string kind;
+  // The charset the text was decoded from (text kinds), lowercased.
+  std::string charset;
+  // Text kinds: the body (or its first 8 MiB), always valid UTF-8.
+  std::optional<std::string> text;
+  // Where the body (a binary, or a text past 8 MiB) was written.
+  base::FilePath saved_to;
+  // Body bytes read (after content decoding).
+  int64_t bytes = 0;
+  bool truncated = false;
+  // Why no file was written, when one should have been.
+  std::string file_error;
+};
+
+// browser: reads one response body for Browser.agentFetch: a navigation
+// response the fetch took over (it owns that request's loader from then on)
+// or an API call's body already in memory. Text kinds are decoded to UTF-8
+// and kept up to kMaxTextBytes, the rest spilling to a file; binary kinds
+// stream to `<save_to>.<tag>.part` on a blocking-IO sequence and are renamed
+// once complete. Nothing is written when the client may not write files.
+class AgentFetchBodySink : public network::mojom::URLLoaderClient,
+                           public mojo::DataPipeDrainer::Client {
+ public:
+  struct Options {
+    Options();
+    Options(const Options&);
+    Options& operator=(const Options&);
+    ~Options();
+
+    // The response URL, for a default file name.
+    GURL url;
+    // The final MIME type (sniffed), lowercased.
+    std::string mime_type;
+    // The Content-Type charset, if any.
+    std::string charset;
+    std::string content_disposition;
+    // An absolute path the caller chose; empty for a default one.
+    base::FilePath save_to;
+    // Where a file goes when `save_to` is empty.
+    base::FilePath default_dir;
+    // Names this write's `.part` file (the fetch's id); a random number is
+    // added, so no two writes share one.
+    std::string part_tag;
+    bool may_write_files = false;
+  };
+  using DoneCallback = base::OnceCallback<void(AgentFetchBody)>;
+
+  static constexpr int64_t kMaxTextBytes = 8 * 1024 * 1024;
+  static constexpr int64_t kMaxBytes = 256 * 1024 * 1024;
+
+  // html | text | json | xml | binary, from a final MIME type.
+  static std::string KindForMimeType(std::string_view mime_type);
+
+  // Decodes a text body to valid UTF-8: the BOM, else `header_charset`, else
+  // UTF-8 for JSON, else the XML declaration, else UTF-8 when the bytes are
+  // valid UTF-8, else windows-1252. Invalid sequences become U+FFFD.
+  static std::string DecodeToUTF8(std::string_view bytes,
+                                  std::string_view kind,
+                                  std::string_view header_charset,
+                                  std::string* charset_used);
+
+  // Takes over a navigation's response. `done` runs once, last.
+  static std::unique_ptr<AgentFetchBodySink> ForNavigation(
+      Options options,
+      mojo::ScopedDataPipeConsumerHandle body,
+      network::mojom::URLLoaderClientEndpointsPtr endpoints,
+      DoneCallback done);
+
+  // Reads a body already in memory. `done` runs once, from a posted task.
+  static std::unique_ptr<AgentFetchBodySink> ForBytes(Options options,
+                                                      std::string bytes,
+                                                      DoneCallback done);
+
+  AgentFetchBodySink(const AgentFetchBodySink&) = delete;
+  AgentFetchBodySink& operator=(const AgentFetchBodySink&) = delete;
+  ~AgentFetchBodySink() override;
+
+ private:
+  AgentFetchBodySink(Options options, DoneCallback done);
+
+  void StartDraining(mojo::ScopedDataPipeConsumerHandle body,
+                     network::mojom::URLLoaderClientEndpointsPtr endpoints);
+  void FeedBytes(std::string bytes);
+
+  // network::mojom::URLLoaderClient:
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr early_hints) override;
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> cached_metadata) override;
+  void OnReceiveRedirect(const net::RedirectInfo& redirect_info,
+                         network::mojom::URLResponseHeadPtr head) override;
+  void OnUploadProgress(int64_t current_position,
+                        int64_t total_size,
+                        OnUploadProgressCallback callback) override;
+  void OnTransferSizeUpdated(int32_t transfer_size_diff) override;
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override;
+
+  // mojo::DataPipeDrainer::Client:
+  void OnDataAvailable(base::span<const uint8_t> data) override;
+  void OnDataComplete() override;
+
+  void OnLoaderDisconnected();
+  void Append(base::span<const uint8_t> data);
+  void EnsureWriter();
+  void WriteToFile(base::span<const uint8_t> data);
+  // Stops reading at the size cap.
+  void StopAtCap();
+  void MaybeFinish();
+  void Finish();
+  void OnFileCommitted(base::FilePath path);
+  void RunDone();
+
+  const Options options_;
+  DoneCallback done_;
+  AgentFetchBody result_;
+
+  mojo::Remote<network::mojom::URLLoader> url_loader_;
+  mojo::Receiver<network::mojom::URLLoaderClient> client_receiver_{this};
+  std::unique_ptr<mojo::DataPipeDrainer> drainer_;
+
+  // The text kept for the reply (text kinds), at most kMaxTextBytes.
+  std::string text_buffer_;
+  // A text body past kMaxTextBytes: the whole of it goes to a file.
+  bool spilling_ = false;
+  base::SequenceBound<AgentFetchFileWriter> writer_;
+  // No file may or can be written; bytes past the reply are dropped.
+  bool writer_unavailable_ = false;
+
+  bool data_complete_ = false;
+  bool load_complete_ = false;
+  // The body passed kMaxBytes; the rest is not read.
+  bool capped_ = false;
+  bool finished_ = false;
+
+  base::WeakPtrFactory<AgentFetchBodySink> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_AGENT_FETCH_BODY_SINK_H_
