+AgentFetchAgent::AgentFetchAgent(base::PassKey<AgentFetchAgent>,
+                                 LocalFrame& frame)
+    : Supplement<Document>(*frame.GetDocument()),
+      receiver_set_(this, frame.DomWindow()) {}
