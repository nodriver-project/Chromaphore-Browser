+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_AGENT_SNAPSHOT_AGENT_FETCH_AGENT_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_AGENT_SNAPSHOT_AGENT_FETCH_AGENT_H_
+
+#include <stdint.h>
+
+#include <memory>
+
+#include "base/callback_list.h"
+#include "base/time/time.h"
+#include "base/types/pass_key.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_fetch.mojom-blink.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_receiver_set.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+class Document;
+class LocalFrame;
+
+// browser: the renderer half of Browser.agentFetch. One per document; the
+// browser binds it on the fetch page's primary main frame after each
+// cross-document commit (every LocalFrame gets a binder, so a subframe may
+// get one too). It waits for the document to settle, takes a cheap look for
+// bot-check markers, extracts the main content as markdown with facts,
+// outline, links and the classifier's signals, and runs fetch() for API
+// calls. Everything is read from C++ or from the private isolated world
+// kAgentFetchWorldId: no main-world script, no mutation of the live document
+// and no network beyond RunFetch's own request.
+//
+// Lives in modules/ next to AgentSnapshotCollectorImpl because landmark
+// roles come from modules/accessibility (AXObject::DetermineRawAriaRole,
+// which needs no AX cache).
+class AgentFetchAgent final : public GarbageCollected<AgentFetchAgent>,
+                              public mojom::blink::AgentFetchAgent,
+                              public Supplement<Document> {
+ public:
+  static const char kSupplementName[];
+  static AgentFetchAgent* From(Document&);
+  static void BindReceiver(
+      LocalFrame* frame,
+      mojo::PendingReceiver<mojom::blink::AgentFetchAgent> receiver);
+
+  explicit AgentFetchAgent(base::PassKey<AgentFetchAgent>, LocalFrame&);
+  AgentFetchAgent(const AgentFetchAgent&) = delete;
+  AgentFetchAgent& operator=(const AgentFetchAgent&) = delete;
+  ~AgentFetchAgent() override;
+
+  void Trace(Visitor* visitor) const override;
+
+  // mojom::blink::AgentFetchAgent:
+  void WaitForSettle(mojom::blink::AgentSettleOptionsPtr options,
+                     WaitForSettleCallback callback) override;
+  void Markers(MarkersCallback callback) override;
+  void Extract(mojom::blink::AgentExtractOptionsPtr options,
+               ExtractCallback callback) override;
+  void RunFetch(mojom::blink::AgentApiRequestPtr request,
+                RunFetchCallback callback) override;
+
+ private:
+  // One Extract() call's state, carried across its tasks. Defined in the .cc.
+  // Not garbage-collected: it owns the reply callback, which must never be
+  // destroyed in a GC finalizer. It reaches the DOM through Persistents.
+  struct ExtractJob;
+
+  // One WaitForSettle() call's state, carried from tick to tick.
+  struct SettleState {
+    base::TimeDelta quiet;
+    base::TimeDelta busy_quiet;
+    int max_inflight = 0;
+    base::TimeDelta cap;
+    int min_text = 0;
+    base::TimeTicks start;
+    // The delay to the next tick: 50 ms, doubled (up to 400 ms) while
+    // measuring is slow and halved back while it is cheap.
+    base::TimeDelta tick;
+    // When the signature last changed; null until the first one is taken.
+    base::TimeTicks last_change;
+    uint64_t last_version = 0;
+    bool have_signature = false;
+    int32_t text_length = 0;
+    int32_t text_nodes = 0;
+  };
+
+  void SettleTick(SettleState state, WaitForSettleCallback callback);
+  void FinishSettle(const SettleState& state,
+                    const char* reason,
+                    WaitForSettleCallback callback);
+  // Ends one pending wait (answered or dropped).
+  void EndSettle();
+  void OnNetworkIdle();
+
+  // Extract() runs as four tasks so that no single task runs long, and
+  // re-checks the document at the start of each: (a) facts, (b) clone,
+  // readerable and Readability, (c) the structural walk and the markdown,
+  // (d) links and signals, which replies.
+  void ExtractFacts(std::unique_ptr<ExtractJob> job);
+  void ExtractReadability(std::unique_ptr<ExtractJob> job);
+  void ExtractContent(std::unique_ptr<ExtractJob> job);
+  void ExtractLinksAndSignals(std::unique_ptr<ExtractJob> job);
+  void PostExtractStep(
+      void (AgentFetchAgent::*step)(std::unique_ptr<ExtractJob>),
+      std::unique_ptr<ExtractJob> job);
+  static void FinishExtract(ExtractJob& job);
+
+  void Bind(mojo::PendingReceiver<mojom::blink::AgentFetchAgent> receiver);
+
+  HeapMojoReceiverSet<mojom::blink::AgentFetchAgent, AgentFetchAgent>
+      receiver_set_;
+  // The frame's network-idle subscription, shared by the pending
+  // WaitForSettle() calls: taken afresh by a call when none is pending and
+  // released when the last one answers. `network_idle_at_` is when it fired
+  // (null until then).
+  base::CallbackListSubscription network_idle_subscription_;
+  base::TimeTicks network_idle_at_;
+  int pending_settles_ = 0;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_AGENT_SNAPSHOT_AGENT_FETCH_AGENT_H_
diff --git a/third_party/blink/renderer/modules/agent_snapshot/resources/agent_fetch.js b/third_party/blink/renderer/modules/agent_snapshot/resources/agent_fetch.js
new file mode 100644
index 0000000000..3b15a5d5cc
--- /dev/null
+++ b/third_party/blink/renderer/modules/agent_snapshot/resources/agent_fetch.js
@@ -0,0 +1,144 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// browser: the private-world driver for AgentFetchAgent::Extract.
+//
+// AgentFetchAgent concatenates Readability.js, Readability-readerable.js and
+// this file inside one function and returns agentFetchRun()'s value, so none
+// of the three leaves a global behind. It runs only in kAgentFetchWorldId,
+// with the document's origin and an empty world CSP. It reads the live
+// document (isProbablyReaderable looks at inline styles and text only) and
+// lets Readability work on a clone, which tidyHeadings() edits first; nothing
+// here writes to the live document.
+//
+// Returns [metaJson, articleElementOrNull]. The C++ side takes the string as
+// a WTF::String and the element through V8Element::ToWrappable, then turns
+// the element into markdown itself.
+
+/* global Readability, isProbablyReaderable */
+/* exported agentFetchRun */
+
+// browser: lifts headings out of the wrappers that only decorate them, on the
+// CLONE (never the live document), before Readability sees it. Readability's
+// conditional cleaning drops a link-heavy, near-empty wrapper div together
+// with its heading (MediaWiki's <div class="mw-heading"><h2>..</h2><span
+// class="mw-editsection">[edit]</span></div>), which costs the outline every
+// h2. Edit-section links go first; then a div, section or header whose only
+// other content is under 20 characters of text (no other heading, no block or
+// embedded content) is replaced by its heading, climbing nested wrappers.
+function tidyHeadings(doc) {
+  "use strict";
+  for (const element of doc.querySelectorAll("[class*='editsection' i]")) {
+    element.remove();
+  }
+  const wrappers = new Set(["div", "section", "header"]);
+  // Content that must not be dropped with a wrapper, however little text it
+  // holds; other headings among it.
+  const keep = new Set([
+    "h1", "h2", "h3", "h4", "h5", "h6", "p", "ul", "ol", "dl", "table",
+    "pre", "blockquote", "figure", "img", "picture", "video", "audio",
+    "iframe", "object", "embed", "canvas", "math", "form",
+  ]);
+  // Text that is not content.
+  const ignored = new Set(["script", "style", "template", "noscript"]);
+  // The node after `node` in tree order within `root`, past its children when
+  // `skipChildren`.
+  const next = (node, root, skipChildren) => {
+    if (!skipChildren && node.firstChild) {
+      return node.firstChild;
+    }
+    for (; node && node !== root; node = node.parentNode) {
+      if (node.nextSibling) {
+        return node.nextSibling;
+      }
+    }
+    return null;
+  };
+  // True when `wrapper` holds `heading` and next to nothing else. Bounded: a
+  // wrapper with many nodes is not a decoration.
+  const onlyWraps = (wrapper, heading) => {
+    let rest = 0;
+    let budget = 200;
+    for (let node = wrapper.firstChild; node;) {
+      if (--budget < 0) {
+        return false;
+      }
+      let skip = false;
+      if (node === heading) {
+        skip = true;
+      } else if (node.nodeType === Node.TEXT_NODE) {
+        rest += node.data.replace(/\s+/g, "").length;
+        if (rest >= 20) {
+          return false;
+        }
+      } else if (node.nodeType === Node.ELEMENT_NODE) {
+        if (keep.has(node.localName)) {
+          return false;
+        }
+        skip = ignored.has(node.localName);
+      }
+      node = next(node, wrapper, skip);
+    }
+    return true;
+  };
+  for (const heading of doc.querySelectorAll("h1,h2,h3,h4,h5,h6")) {
+    for (let parent = heading.parentElement;
+         parent && wrappers.has(parent.localName) &&
+         onlyWraps(parent, heading);
+         parent = heading.parentElement) {
+      parent.replaceWith(heading);
+    }
+  }
+}
+
+function agentFetchRun() {
+  "use strict";
+  const meta = {
+    readerable: false,
+    title: "",
+    byline: "",
+    siteName: "",
+    publishedTime: "",
+    excerpt: "",
+    lang: "",
+    textLength: 0,
+    error: "",
+  };
+  const text = (value) => (typeof value === "string" ? value : "");
+  let article = null;
+  try {
+    meta.readerable = !!isProbablyReaderable(document);
+    // The C++ side only uses the article on a readerable page, so a page that
+    // is not readerable skips the clone and the parse altogether.
+    if (meta.readerable) {
+      const clone = document.cloneNode(true);
+      // A failed tidy leaves a valid (partly tidied) clone; Readability still
+      // runs on it.
+      try {
+        tidyHeadings(clone);
+      } catch (e) {
+        meta.error = "tidy: " + String((e && e.message) || e).slice(0, 300);
+      }
+      const result = new Readability(clone, {
+        serializer: (element) => element,
+      }).parse();
+      if (result) {
+        meta.title = text(result.title);
+        meta.byline = text(result.byline);
+        meta.siteName = text(result.siteName);
+        meta.publishedTime = text(result.publishedTime);
+        meta.excerpt = text(result.excerpt);
+        meta.lang = text(result.lang);
+        meta.textLength = typeof result.length === "number" ? result.length : 0;
+        const content = result.content;
+        if (content && content.nodeType === Node.ELEMENT_NODE) {
+          article = content;
+        }
+      }
+    }
+  } catch (e) {
+    meta.error = String((e && e.message) || e).slice(0, 300);
+  }
+  return [JSON.stringify(meta), article];
+}
