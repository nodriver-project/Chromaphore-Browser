+
+// Phrasing content that stays inside its paragraph even when it holds
+// blocks (a card wrapped in a link reads as one link).
+base::span<const HTMLQualifiedName* const> InlineTags() {
+  static const HTMLQualifiedName* const kTags[] = {
+      &html_names::kATag,      &html_names::kAbbrTag,  &html_names::kBTag,
+      &html_names::kBdiTag,    &html_names::kBdoTag,   &html_names::kCiteTag,
+      &html_names::kCodeTag,   &html_names::kDataTag,  &html_names::kDelTag,
+      &html_names::kDfnTag,    &html_names::kEmTag,    &html_names::kFontTag,
+      &html_names::kITag,      &html_names::kInsTag,   &html_names::kKbdTag,
+      &html_names::kMarkTag,   &html_names::kQTag,     &html_names::kSTag,
+      &html_names::kSampTag,   &html_names::kSmallTag, &html_names::kStrikeTag,
+      &html_names::kStrongTag, &html_names::kSubTag,   &html_names::kSupTag,
+      &html_names::kTimeTag,   &html_names::kTtTag,    &html_names::kUTag,
