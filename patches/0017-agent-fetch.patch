diff --git a/content/public/browser/agent_fetch_response_taker.h b/content/public/browser/agent_fetch_response_taker.h
new file mode 100644
index 0000000000..244bf61f62
--- /dev/null
+++ b/content/public/browser/agent_fetch_response_taker.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_PUBLIC_BROWSER_AGENT_FETCH_RESPONSE_TAKER_H_
+#define CONTENT_PUBLIC_BROWSER_AGENT_FETCH_RESPONSE_TAKER_H_
+
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace content {
+
+class NavigationHandle;
+
+// browser: lets the embedder take over the response of a top-level navigation
+// in one of its own WebContents (see WebContentsDelegate::
+// GetAgentFetchResponseTaker). The decision is made once the response is
+// final -- after every throttle, with the MIME type sniffed -- and before the
+// download or plugin handling and before anything commits. A taken response
+// never reaches a renderer: the navigation ends with net::ERR_ABORTED, which
+// commits no error page and adds no history entry.
+class AgentFetchResponseTaker {
+ public:
+  virtual ~AgentFetchResponseTaker() = default;
+
+  // Whether to take this response. `is_download` is the navigation's own
+  // download decision. Only asked for the primary main frame.
+  virtual bool ShouldTakeNavigationResponse(
+      NavigationHandle& handle,
+      const network::mojom::URLResponseHead& head,
+      bool is_download) = 0;
+
+  // The response itself: its head, the body pipe and the live loader
+  // endpoints. The taker owns the loader from here on (it keeps the request
+  // alive) and reads the body to completion. The body arrives decoded.
+  virtual void TakeNavigationResponse(
+      NavigationHandle& handle,
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      network::mojom::URLLoaderClientEndpointsPtr endpoints) = 0;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_AGENT_FETCH_RESPONSE_TAKER_H_
