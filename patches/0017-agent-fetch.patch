+// static
+void AgentFetchAgent::BindReceiver(
+    LocalFrame* frame,
+    mojo::PendingReceiver<mojom::blink::AgentFetchAgent> receiver) {
+  DCHECK(frame && frame->GetDocument());
+  auto& document = *frame->GetDocument();
+  auto* agent = AgentFetchAgent::From(document);
+  if (!agent) {
+    agent = MakeGarbageCollected<AgentFetchAgent>(
+        base::PassKey<AgentFetchAgent>(), *frame);
+    Supplement<Document>::ProvideTo(document, agent);
+  }
+  agent->Bind(std::move(receiver));
+}
