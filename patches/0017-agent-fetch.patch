+
+bool IsBlockTag(const Element& element) {
+  return element.IsHTMLElement() && HasAnyTag(element, BlockTags());
+}
+
+bool IsInlineTag(const Element& element) {
+  return element.IsHTMLElement() && HasAnyTag(element, InlineTags());
+}
+
+bool IsSkippedElement(const Element& element) {
+  if (element.IsSVGElement()) {
+    return true;
+  }
+  if (!element.IsHTMLElement()) {
+    return false;
+  }
+  if (HasAnyTag(element, SkippedTags())) {
+    return true;
+  }
+  if (const auto* dialog = DynamicTo<HTMLDialogElement>(element)) {
+    return !dialog->IsOpen();
+  }
+  return false;
+}
+
+int HeadingLevel(const Element& element) {
+  if (element.HasTagName(html_names::kH1Tag)) {
+    return 1;
+  }
+  if (element.HasTagName(html_names::kH2Tag)) {
+    return 2;
+  }
+  if (element.HasTagName(html_names::kH3Tag)) {
+    return 3;
+  }
+  if (element.HasTagName(html_names::kH4Tag)) {
+    return 4;
+  }
+  if (element.HasTagName(html_names::kH5Tag)) {
+    return 5;
+  }
+  if (element.HasTagName(html_names::kH6Tag)) {
+    return 6;
+  }
+  return 0;
+}
+
+bool IsCell(const Element& element) {
+  return element.HasTagName(html_names::kTdTag) ||
+         element.HasTagName(html_names::kThTag);
+}
+
+// Rows, cells, sections and captions: a sticky header row or column is still
+// part of its table, never an overlay.
+bool IsTablePart(const Element& element) {
+  return IsCell(element) || element.HasTagName(html_names::kTrTag) ||
+         element.HasTagName(html_names::kTheadTag) ||
+         element.HasTagName(html_names::kTbodyTag) ||
+         element.HasTagName(html_names::kTfootTag) ||
+         element.HasTagName(html_names::kCaptionTag);
+}
+
+bool IsLink(const Element& element) {
+  return IsA<HTMLAnchorElementBase>(element) &&
+         element.FastHasAttribute(html_names::kHrefAttr);
+}
+
+bool IsAriaHidden(const Element& element) {
+  return AXObject::IsAriaAttributeTrue(element, html_names::kAriaHiddenAttr);
+}
+
+// Laid out and painted with a box of some size.
+bool IsRendered(const Element& element) {
+  const LayoutObject* layout_object = element.GetLayoutObject();
+  if (!layout_object ||
+      layout_object->StyleRef().Visibility() != EVisibility::kVisible) {
+    return false;
+  }
+  const gfx::Rect box = layout_object->AbsoluteBoundingBoxRect();
+  return box.width() > 0 && box.height() > 0;
+}
+
+// browser: a control the reader never reads (SkippedTags): a button, a
+// select, a text area, or an input other than a hidden one. Not the
+// browser's own parts of a control (a file input's button, media controls),
+// nor the button a customizable select shows, which is the select's.
+bool IsSkippedControl(const Element& element) {
+  if (element.IsInUserAgentShadowRoot()) {
+    return false;
+  }
+  if (const auto* input = DynamicTo<HTMLInputElement>(element)) {
+    return input->FormControlType() !=
+           mojom::blink::FormControlType::kInputHidden;
+  }
+  if (element.HasTagName(html_names::kButtonTag)) {
+    const Element* parent = element.parentElement();
+    return !parent || !parent->HasTagName(html_names::kSelectTag);
+  }
+  return element.HasTagName(html_names::kSelectTag) ||
+         element.HasTagName(html_names::kTextareaTag);
+}
+
+// A screen-reader-only box: clipped to (almost) nothing.
+bool IsSrOnly(const LayoutObject& layout_object) {
+  if (!layout_object.IsBox()) {
+    return false;
+  }
+  const ComputedStyle& style = layout_object.StyleRef();
+  if (style.OverflowX() == EOverflow::kVisible &&
+      style.OverflowY() == EOverflow::kVisible && style.HasAutoClip()) {
+    return false;
+  }
+  const gfx::Rect box = layout_object.AbsoluteBoundingBoxRect();
+  return box.width() <= 1 || box.height() <= 1;
+}
+
+// Fixed to the viewport: banners, bars, overlays.
+bool IsFixed(const LayoutObject& layout_object) {
+  return layout_object.IsBox() && To<LayoutBox>(layout_object).IsFixedToView();
+}
+
+// Whether a header, footer or aside belongs to a section of the page rather
+// than to the page (HTML-AAM: only an unscoped one is a landmark).
+bool IsInSection(const Element& element) {
+  for (const ContainerNode* node = FlatTreeTraversal::Parent(element); node;
+       node = FlatTreeTraversal::Parent(*node)) {
+    const auto* ancestor = DynamicTo<Element>(node);
+    if (!ancestor) {
+      continue;
+    }
+    if (ancestor->HasTagName(html_names::kBodyTag)) {
+      return false;
+    }
+    if (ancestor->HasTagName(html_names::kArticleTag) ||
+        ancestor->HasTagName(html_names::kAsideTag) ||
+        ancestor->HasTagName(html_names::kMainTag) ||
+        ancestor->HasTagName(html_names::kNavTag) ||
+        ancestor->HasTagName(html_names::kSectionTag)) {
+      return true;
+    }
+    switch (AXObject::DetermineRawAriaRole(*ancestor)) {
+      case ax::mojom::blink::Role::kArticle:
+      case ax::mojom::blink::Role::kComplementary:
+      case ax::mojom::blink::Role::kMain:
+      case ax::mojom::blink::Role::kNavigation:
+      case ax::mojom::blink::Role::kRegion:
+        return true;
+      default:
+        break;
+    }
+  }
+  return false;
+}
+
+// The landmark an element is (main | nav | header | footer | aside), from
+// its explicit ARIA role, else its tag; nullptr when it is none. No AX cache.
+const char* LandmarkName(const Element& element) {
+  switch (AXObject::DetermineRawAriaRole(element)) {
+    case ax::mojom::blink::Role::kMain:
+      return "main";
+    case ax::mojom::blink::Role::kNavigation:
+      return "nav";
+    case ax::mojom::blink::Role::kBanner:
+      return "header";
+    case ax::mojom::blink::Role::kContentInfo:
+      return "footer";
+    case ax::mojom::blink::Role::kComplementary:
+      return "aside";
+    case ax::mojom::blink::Role::kUnknown:
+      break;
+    default:
+      return nullptr;
+  }
+  if (!element.IsHTMLElement()) {
+    return nullptr;
+  }
+  if (element.HasTagName(html_names::kMainTag)) {
+    return "main";
+  }
+  if (element.HasTagName(html_names::kNavTag)) {
+    return "nav";
+  }
+  if (element.HasTagName(html_names::kHeaderTag)) {
+    return IsInSection(element) ? nullptr : "header";
+  }
+  if (element.HasTagName(html_names::kFooterTag)) {
+    return IsInSection(element) ? nullptr : "footer";
+  }
+  if (element.HasTagName(html_names::kAsideTag)) {
+    return IsInSection(element) ? nullptr : "aside";
+  }
+  return nullptr;
+}
+
+// Page chrome the body-minus-chrome region leaves out.
+bool IsChromeLandmark(const Element& element) {
+  const char* name = LandmarkName(element);
+  return name && std::strcmp(name, "main") != 0;
+}
+
+// The text a link shows when it has no text of its own.
+String LinkLabel(const Element& element) {
+  const AtomicString& label =
+      element.FastGetAttribute(html_names::kAriaLabelAttr);
+  if (!label.empty()) {
+    return label.GetString();
+  }
+  const AtomicString& title = element.FastGetAttribute(html_names::kTitleAttr);
+  if (!title.empty()) {
+    return title.GetString();
+  }
+  int budget = 64;
+  for (Node* node = FlatTreeTraversal::FirstChild(element);
+       node && budget-- > 0; node = FlatTreeTraversal::Next(*node, &element)) {
+    const auto* child = DynamicTo<Element>(node);
+    if (child && child->HasTagName(html_names::kImgTag)) {
+      const AtomicString& alt = child->FastGetAttribute(html_names::kAltAttr);
+      if (!alt.empty()) {
+        return alt.GetString();
+      }
+    }
+  }
+  return g_empty_string;
+}
+
+// <ol start>, else 1.
+int ListStart(const Element& element) {
+  const String start = element.FastGetAttribute(html_names::kStartAttr)
+                           .GetString()
+                           .StripWhiteSpace();
+  wtf_size_t i = 0;
+  bool negative = false;
+  if (!start.empty() && start[0] == '-') {
+    negative = true;
+    i = 1;
+  }
+  int value = 0;
+  bool any = false;
+  for (; i < start.length() && start[i] >= '0' && start[i] <= '9' &&
+         value < 100000000;
+       ++i) {
+    value = value * 10 + (start[i] - '0');
+    any = true;
+  }
+  if (!any) {
+    return 1;
+  }
+  return negative ? -value : value;
+}
+
+// language-x / lang-x / highlight-source-x in a class attribute.
+String LanguageFromClass(const Element& element) {
+  const String& classes = element.GetClassAttribute().GetString();
+  if (classes.empty()) {
+    return g_empty_string;
+  }
+  for (const char* prefix : {"language-", "lang-", "highlight-source-"}) {
+    wtf_size_t at = classes.find(prefix);
+    while (at != kNotFound && at && !IsSpaceChar(classes[at - 1])) {
+      at = classes.find(prefix, at + 1);
+    }
+    if (at == kNotFound) {
+      continue;
+    }
+    const wtf_size_t begin = at + static_cast<wtf_size_t>(std::strlen(prefix));
+    wtf_size_t end = begin;
+    while (end < classes.length() && end - begin < 32 &&
+           (IsWordChar(classes[end]) || classes[end] == '-' ||
+            classes[end] == '+' || classes[end] == '#' ||
+            classes[end] == '.')) {
+      ++end;
+    }
+    if (end > begin) {
+      return classes.substr(begin, end - begin).ToAsciiLower();
+    }
+  }
+  return g_empty_string;
+}
+
+void SplitLines(const String& text, Vector<String>& lines) {
+  wtf_size_t start = 0;
+  while (start <= text.length()) {
+    wtf_size_t end = text.find('\n', start);
+    if (end == kNotFound) {
+      end = text.length();
+    }
+    wtf_size_t stop = end;
+    if (stop > start && text[stop - 1] == '\r') {
+      --stop;
+    }
+    lines.push_back(text.substr(start, stop - start));
+    start = end + 1;
+  }
+}
+
+// Table helpers.
+
+void CollectRows(Element& table, HeapVector<Member<Element>>& rows) {
+  for (Node* child = FlatTreeTraversal::FirstChild(table); child;
+       child = FlatTreeTraversal::NextSibling(*child)) {
+    auto* element = DynamicTo<Element>(child);
+    if (!element) {
+      continue;
+    }
+    if (element->HasTagName(html_names::kTrTag)) {
+      rows.push_back(element);
+      continue;
+    }
+    if (!element->HasTagName(html_names::kTheadTag) &&
+        !element->HasTagName(html_names::kTbodyTag) &&
+        !element->HasTagName(html_names::kTfootTag)) {
+      continue;
+    }
+    for (Node* row = FlatTreeTraversal::FirstChild(*element); row;
+         row = FlatTreeTraversal::NextSibling(*row)) {
+      auto* row_element = DynamicTo<Element>(row);
+      if (row_element && row_element->HasTagName(html_names::kTrTag)) {
+        rows.push_back(row_element);
+      }
+    }
+  }
+}
+
+bool HasBlockStructure(const Element& cell) {
+  int budget = 400;
+  for (Node* node = FlatTreeTraversal::FirstChild(cell); node && budget-- > 0;
+       node = FlatTreeTraversal::Next(*node, &cell)) {
+    const auto* element = DynamicTo<Element>(node);
+    if (element &&
+        (element->HasTagName(html_names::kTableTag) ||
+         element->HasTagName(html_names::kUlTag) ||
+         element->HasTagName(html_names::kOlTag) ||
+         element->HasTagName(html_names::kPreTag) ||
+         element->HasTagName(html_names::kBlockquoteTag) ||
+         element->HasTagName(html_names::kDlTag) || HeadingLevel(*element))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// A table used for layout rather than data: presentational, one column, or
+// cells that hold structure of their own (nested tables, lists, headings).
+bool IsLayoutTable(const Element& table,
+                   const HeapVector<Member<Element>>& rows) {
+  if (AXObject::DetermineRawAriaRole(table) == ax::mojom::blink::Role::kNone) {
+    return true;
+  }
+  if (rows.empty()) {
+    return true;
+  }
+  wtf_size_t widest = 0;
+  wtf_size_t looked = 0;
+  for (const Member<Element>& row : rows) {
+    if (++looked > kLayoutTableSampleRows + 1) {
+      break;
+    }
+    wtf_size_t cells = 0;
+    for (Node* child = FlatTreeTraversal::FirstChild(*row); child;
+         child = FlatTreeTraversal::NextSibling(*child)) {
+      const auto* cell = DynamicTo<Element>(child);
+      if (!cell || !IsCell(*cell)) {
+        continue;
+      }
+      ++cells;
+      if (HasBlockStructure(*cell)) {
+        return true;
+      }
+    }
+    widest = std::max(widest, cells);
+  }
+  return widest <= 1;
+}
+
+// A markdown link destination: `<url>` when the URL holds a space or a
+// bracket that would end the plain form early, with `<` and `>` then
+// percent-encoded; else the URL as it is.
+void AppendLinkDestination(const String& href, StringBuilder& out) {
+  bool angle = false;
+  for (wtf_size_t i = 0; i < href.length() && !angle; ++i) {
+    const UChar c = href[i];
+    angle = c == ' ' || c == '(' || c == ')' || c == '<' || c == '>';
+  }
+  if (!angle) {
+    out.Append(href);
+    return;
+  }
+  out.Append('<');
+  for (wtf_size_t i = 0; i < href.length(); ++i) {
+    const UChar c = href[i];
+    if (c == '<') {
+      out.Append("%3C");
+    } else if (c == '>') {
+      out.Append("%3E");
+    } else {
+      out.Append(c);
+    }
+  }
+  out.Append('>');
+}
+
+String EscapeCell(const String& text) {
+  if (!text.contains('|')) {
+    return text;
+  }
+  StringBuilder out;
+  for (wtf_size_t i = 0; i < text.length(); ++i) {
+    if (text[i] == '|') {
+      out.Append('\\');
+    }
+    out.Append(text[i]);
+  }
+  return out.ReleaseString();
+}
+
+String TableRow(const Vector<String>& cells, wtf_size_t columns) {
+  StringBuilder line;
+  line.Append('|');
+  for (wtf_size_t i = 0; i < columns; ++i) {
+    line.Append(' ');
+    if (i < cells.size()) {
+      line.Append(cells[i]);
+    }
+    line.Append(" |");
+  }
+  return line.ReleaseString();
+}
+
+String TableRule(wtf_size_t columns) {
+  StringBuilder line;
+  line.Append('|');
+  for (wtf_size_t i = 0; i < columns; ++i) {
+    line.Append(" --- |");
+  }
+  return line.ReleaseString();
+}
+
+// ---------------------------------------------------------------------------
+// Markdown.
+
+struct OutlineEntry {
+  int level = 0;
+  String text;
+  wtf_size_t offset = 0;
+};
+
+// Turns a subtree into markdown. Two inputs share it:
+//  - the live document (`live`): layout-aware. Only rendered text counts;
+//    fixed/sticky overlays, sr-only boxes and aria-hidden subtrees are
+//    dropped, and with `skip_chrome` so are nav/header/footer/aside
+//    landmarks. Closed <details> are read whole.
+//  - Readability's article element in the detached clone: no layout, so
+//    everything counts as visible except [hidden] and aria-hidden.
+// Read-only: it never touches the DOM it reads beyond style and layout
+// getters.
+class MarkdownEmitter {
+  STACK_ALLOCATED();
+
+ public:
+  MarkdownEmitter(bool live,
+                  Element* region,
+                  bool skip_chrome,
+                  wtf_size_t body_text_length,
+                  wtf_size_t max_chars)
+      : live_(live),
+        region_(region),
+        skip_chrome_(skip_chrome),
+        body_text_length_(body_text_length),
+        max_chars_(max_chars) {}
+  MarkdownEmitter(const MarkdownEmitter&) = delete;
+  MarkdownEmitter& operator=(const MarkdownEmitter&) = delete;
+
+  // Emits what `root` holds (not `root` itself: the region, or Readability's
+  // page wrapper).
+  void EmitChildrenOf(Element& root) {
+    VisitChildren(root, 0);
+    FlushInline();
+    Finish();
+  }
+
+  const String& markdown() const { return markdown_; }
+  const Vector<OutlineEntry>& outline() const { return outline_; }
+  HashSet<String>& hrefs() { return hrefs_; }
+  // Visible characters taken in, whitespace collapsed.
+  wtf_size_t text_chars() const { return text_chars_; }
+  bool truncated() const { return truncated_; }
+
+ private:
+  // A block container that prefixes each line it holds: a list item (its
+  // marker on the first line, indentation after) or a blockquote.
+  struct Container {
+    String first;
+    String rest;
+    bool list_item = false;
+    bool used = false;
+  };
+  struct ListState {
+    bool ordered = false;
+    int next = 1;
+  };
+
+  bool Full() const { return truncated_; }
+
+  // Walking.
+
+  void VisitChildren(Node& parent, int depth) {
+    for (Node* child = FlatTreeTraversal::FirstChild(parent); child && !Full();
+         child = FlatTreeTraversal::NextSibling(*child)) {
+      Visit(*child, depth + 1);
+    }
+  }
+
+  void Visit(Node& node, int depth) {
+    if (Full()) {
+      return;
+    }
+    if (--budget_ <= 0) {
+      truncated_ = true;
+      return;
+    }
+    if (auto* text = DynamicTo<Text>(node)) {
+      AppendText(*text, inline_);
+      return;
+    }
+    auto* element = DynamicTo<Element>(node);
+    if (!element || Skip(*element)) {
+      return;
+    }
+    if (depth > kMaxEmitDepth) {
+      AppendPlainText(*element, inline_);
+      return;
+    }
+    const bool hidden_details = OpensHiddenDetails(*element);
+    if (hidden_details) {
+      ++ignore_layout_;
+    }
+    VisitElement(*element, depth);
+    if (hidden_details) {
+      --ignore_layout_;
+    }
+  }
+
+  void VisitElement(Element& element, int depth) {
+    if (element.HasTagName(html_names::kBrTag)) {
+      inline_.Append(kBreak);
+      return;
+    }
+    if (element.HasTagName(html_names::kImgTag)) {
+      AppendImage(element, inline_);
+      return;
+    }
+    if (const int level = HeadingLevel(element)) {
+      EmitHeading(element, level, depth);
+      return;
+    }
+    if (element.HasTagName(html_names::kUlTag) ||
+        element.HasTagName(html_names::kOlTag) ||
+        element.HasTagName(html_names::kMenuTag)) {
+      EmitList(element, element.HasTagName(html_names::kOlTag), depth);
+      return;
+    }
+    if (element.HasTagName(html_names::kLiTag)) {
+      EmitListItem(element, depth);
+      return;
+    }
+    if (element.HasTagName(html_names::kPreTag)) {
+      EmitPre(element);
+      return;
+    }
+    if (element.HasTagName(html_names::kBlockquoteTag)) {
+      EmitQuote(element, depth);
+      return;
+    }
+    if (element.HasTagName(html_names::kHrTag)) {
+      EmitRule();
+      return;
+    }
+    if (element.HasTagName(html_names::kTableTag)) {
+      EmitTable(element, depth);
+      return;
+    }
+    if (element.HasTagName(html_names::kDlTag)) {
+      EmitDefinitions(element, depth);
+      return;
+    }
+    if (!IsInlineTag(element) &&
+        (IsBlockTag(element) || LaidOutAsBlock(element) ||
+         HasBlockChild(element, 0))) {
+      FlushInline();
+      VisitChildren(element, depth);
+      FlushInline();
+      return;
+    }
+    RenderElement(element, inline_, depth);
+  }
+
+  // Whether to leave an element (and its subtree) out.
+  bool Skip(Element& element) {
+    if (IsSkippedElement(element) || IsAriaHidden(element)) {
+      return true;
+    }
+    if (!live_ || ignore_layout_ > 0) {
+      return element.FastHasAttribute(html_names::kHiddenAttr);
+    }
+    const LayoutObject* layout_object = element.GetLayoutObject();
+    if (!layout_object) {
+      return !element.HasDisplayContentsStyle();
+    }
+    if (IsSrOnly(*layout_object)) {
+      return true;
+    }
+    // Fixed boxes are overlays wherever they are. Sticky ones are only
+    // outside the content region: inside it they are section headings,
+    // table headers and the like. A table part is never an overlay.
+    if (!IsTablePart(element) &&
+        (IsFixed(*layout_object) ||
+         (layout_object->IsStickyPositioned() && !InContentRegion(element))) &&
+        IsOverlay(element)) {
+      return true;
+    }
+    return skip_chrome_ && IsChromeLandmark(element);
+  }
+
+  // Strictly inside the chosen main or article. A walk of the whole body
+  // (`skip_chrome_`) has no content region: everything is outside it.
+  bool InContentRegion(const Element& element) const {
+    return region_ && !skip_chrome_ &&
+           FlatTreeTraversal::IsDescendantOf(element, *region_);
+  }
+
+  // A fixed or sticky box that is not the content: it neither is nor holds
+  // the region, nor holds most of the page's text (an app shell does).
+  bool IsOverlay(Element& element) {
+    if (region_ && (region_ == &element ||
+                    FlatTreeTraversal::IsDescendantOf(*region_, element))) {
+      return false;
+    }
+    return !(body_text_length_ &&
+             element.GetInnerTextWithoutUpdate().length() * 2 >
+                 body_text_length_);
+  }
+
+  bool TextShown(const Text& text) const {
+    if (!live_ || ignore_layout_ > 0) {
+      return true;
+    }
+    const LayoutObject* layout_object = text.GetLayoutObject();
+    return layout_object &&
+           layout_object->StyleRef().Visibility() == EVisibility::kVisible;
+  }
+
+  // A closed <details> on the live page: its content has no layout, but it
+  // is part of the page (READMEs fold real content into them).
+  bool OpensHiddenDetails(const Element& element) const {
+    return live_ && element.HasTagName(html_names::kDetailsTag) &&
+           !element.FastHasAttribute(html_names::kOpenAttr);
+  }
+
+  bool LaidOutAsBlock(const Element& element) const {
+    if (!live_ || ignore_layout_ > 0) {
+      return false;
+    }
+    const LayoutObject* layout_object = element.GetLayoutObject();
+    return layout_object && !layout_object->IsInline();
+  }
+
+  // Whether a child (through display:contents wrappers such as slots) is a
+  // block, which makes an otherwise inline element a block container.
+  bool HasBlockChild(Element& element, int depth) const {
+    int budget = 64;
+    for (Node* child = FlatTreeTraversal::FirstChild(element);
+         child && budget-- > 0;
+         child = FlatTreeTraversal::NextSibling(*child)) {
+      auto* child_element = DynamicTo<Element>(child);
+      if (!child_element) {
+        continue;
+      }
+      if (IsBlockTag(*child_element) || LaidOutAsBlock(*child_element)) {
+        return true;
+      }
+      if (live_ && depth < 3 && !child_element->GetLayoutObject() &&
+          child_element->HasDisplayContentsStyle() &&
+          HasBlockChild(*child_element, depth + 1)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Inline content.
+
+  void RenderChildren(Element& element, StringBuilder& out, int depth) {
+    for (Node* child = FlatTreeTraversal::FirstChild(element); child && !Full();
+         child = FlatTreeTraversal::NextSibling(*child)) {
+      RenderInline(*child, out, depth + 1);
+    }
+  }
+
+  void RenderInline(Node& node, StringBuilder& out, int depth) {
+    if (--budget_ <= 0) {
+      truncated_ = true;
+      return;
+    }
+    if (auto* text = DynamicTo<Text>(node)) {
+      AppendText(*text, out);
+      return;
+    }
+    auto* element = DynamicTo<Element>(node);
+    if (!element || Skip(*element)) {
+      return;
+    }
+    if (depth > kMaxEmitDepth) {
+      AppendPlainText(*element, out);
+      return;
+    }
+    const bool hidden_details = OpensHiddenDetails(*element);
+    if (hidden_details) {
+      ++ignore_layout_;
+    }
+    RenderElement(*element, out, depth);
+    if (hidden_details) {
+      --ignore_layout_;
+    }
+  }
+
+  void RenderElement(Element& element, StringBuilder& out, int depth) {
+    if (element.HasTagName(html_names::kBrTag)) {
+      out.Append(link_depth_ ? static_cast<UChar>(' ') : kBreak);
+      return;
+    }
+    if (element.HasTagName(html_names::kImgTag)) {
+      AppendImage(element, out);
+      return;
+    }
+    // A block flattened into a line, or an inline element laid out as a
+    // block (a flex item): keep it apart from its neighbours.
+    const bool spaced = IsBlockTag(element) || LaidOutAsBlock(element);
+    if (spaced) {
+      out.Append(' ');
+    }
+    if (IsLink(element)) {
+      AppendLink(element, out, depth);
+    } else if (element.HasTagName(html_names::kStrongTag) ||
+               element.HasTagName(html_names::kBTag)) {
+      AppendWrapped(element, "**", out, depth);
+    } else if (element.HasTagName(html_names::kEmTag) ||
+               element.HasTagName(html_names::kITag)) {
+      AppendWrapped(element, "*", out, depth);
+    } else if (element.HasTagName(html_names::kCodeTag) ||
+               element.HasTagName(html_names::kKbdTag) ||
+               element.HasTagName(html_names::kSampTag) ||
+               element.HasTagName(html_names::kTtTag)) {
+      AppendCode(element, out, depth);
+    } else {
+      RenderChildren(element, out, depth);
+    }
+    if (spaced) {
+      out.Append(' ');
+    }
+  }
+
+  void AppendText(const Text& text, StringBuilder& out) {
+    const String& data = text.data();
+    if (!TextShown(text)) {
+      // Unrendered whitespace still keeps words apart.
+      if (data.ContainsOnlyWhitespaceOrEmpty()) {
+        out.Append(' ');
+      }
+      return;
+    }
+    out.Append(data);
+    text_chars_ += CollapsedLength(data);
+  }
+
+  void AppendImage(const Element& element, StringBuilder& out) {
+    const String alt = Collapse(
+        element.FastGetAttribute(html_names::kAltAttr).GetString(), false);
+    if (alt.empty()) {
+      return;
+    }
+    out.Append(" ![");
+    out.Append(alt);
+    out.Append("] ");
+  }
+
+  void AppendLink(Element& element, StringBuilder& out, int depth) {
+    StringBuilder inner;
+    ++link_depth_;
+    RenderChildren(element, inner, depth);
+    --link_depth_;
+    const String raw = inner.ToString();
+    String text = Collapse(raw, false);
+    if (text.empty()) {
+      text = Collapse(LinkLabel(element), false);
+    }
+    if (!raw.empty() && IsSpaceChar(raw[0])) {
+      out.Append(' ');
+    }
+    if (!text.empty()) {
+      const KURL url = To<HTMLAnchorElementBase>(element).Href();
+      // A link inside a link shows as text; javascript: is not a link.
+      if (!link_depth_ && url.IsValid() && !url.ProtocolIs("javascript")) {
+        const String& href = url.GetString().GetString();
+        out.Append('[');
+        out.Append(text);
+        out.Append("](");
+        AppendLinkDestination(href, out);
+        out.Append(')');
+        hrefs_.insert(href);
+      } else {
+        out.Append(text);
+      }
+    }
+    if (!raw.empty() && IsSpaceChar(raw[raw.length() - 1])) {
+      out.Append(' ');
+    }
+  }
+
+  void AppendWrapped(Element& element,
+                     const char* marker,
+                     StringBuilder& out,
+                     int depth) {
+    StringBuilder inner;
+    RenderChildren(element, inner, depth);
+    const String raw = inner.ToString();
+    const String text = Collapse(raw, false);
+    if (!raw.empty() && IsSpaceChar(raw[0])) {
+      out.Append(' ');
+    }
+    if (!text.empty()) {
+      out.Append(marker);
+      out.Append(text);
+      out.Append(marker);
+    }
+    if (!raw.empty() && IsSpaceChar(raw[raw.length() - 1])) {
+      out.Append(' ');
+    }
+  }
+
+  void AppendCode(Element& element, StringBuilder& out, int depth) {
+    StringBuilder inner;
+    RenderChildren(element, inner, depth);
+    const String text = Collapse(inner.ToString(), false);
+    if (text.empty()) {
+      return;
+    }
+    const bool has_tick = text.contains('`');
+    out.Append(has_tick ? "`` " : "`");
+    out.Append(text);
+    out.Append(has_tick ? " ``" : "`");
+  }
+
+  // Past the depth limit: the subtree's text, flat, without recursion.
+  void AppendPlainText(Element& root, StringBuilder& out) {
+    for (Node* node = FlatTreeTraversal::FirstChild(root); node;) {
+      if (--budget_ <= 0) {
+        truncated_ = true;
+        return;
+      }
+      if (auto* text = DynamicTo<Text>(node)) {
+        AppendText(*text, out);
+        node = FlatTreeTraversal::Next(*node, &root);
+        continue;
+      }
+      auto* element = DynamicTo<Element>(node);
+      if (element && Skip(*element)) {
+        node = FlatTreeTraversal::NextSkippingChildren(*node, &root);
+        continue;
+      }
+      if (element && (IsBlockTag(*element) || LaidOutAsBlock(*element))) {
+        out.Append(' ');
+      }
+      node = FlatTreeTraversal::Next(*node, &root);
+    }
+  }
+
+  // A heading's plain text, for the outline. Counts nothing.
+  String PlainText(Element& root) {
+    StringBuilder out;
+    int budget = 4000;
+    for (Node* node = FlatTreeTraversal::FirstChild(root);
+         node && budget-- > 0;) {
+      if (auto* text = DynamicTo<Text>(node)) {
+        if (TextShown(*text)) {
+          out.Append(text->data());
+        }
+        node = FlatTreeTraversal::Next(*node, &root);
+        continue;
+      }
+      auto* element = DynamicTo<Element>(node);
+      if (element && Skip(*element)) {
+        node = FlatTreeTraversal::NextSkippingChildren(*node, &root);
+        continue;
+      }
+      if (element && element->HasTagName(html_names::kBrTag)) {
+        out.Append(' ');
+      }
+      node = FlatTreeTraversal::Next(*node, &root);
+    }
+    return out.ToString();
+  }
+
+  // Output.
+
+  bool InListItem() const {
+    for (const Container& container : containers_) {
+      if (container.list_item) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Whether the innermost list item already holds a block, so that the next
+  // block in it is a paragraph of its own (a "loose" item), not a lazy
+  // continuation of the last one.
+  bool ItemHoldsBlock() const {
+    for (wtf_size_t i = containers_.size(); i > 0; --i) {
+      if (containers_[i - 1].list_item) {
+        return containers_[i - 1].used;
+      }
+    }
+    return false;
+  }
+
+  // The containers' prefix for the next line. A blank line takes the
+  // continuation prefix with its trailing spaces cut and spends no marker.
+  void AppendPrefix(bool blank) {
+    StringBuilder prefix;
+    for (Container& container : containers_) {
+      prefix.Append(container.used || blank ? container.rest : container.first);
+      if (!blank) {
+        container.used = true;
+      }
+    }
+    if (!blank) {
+      out_.Append(prefix);
+      return;
+    }
+    const String text = prefix.ToString();
+    wtf_size_t end = text.length();
+    while (end && text[end - 1] == ' ') {
+      --end;
+    }
+    out_.Append(StringView(text, 0, end));
+  }
+
+  void WriteLine(const String& line) {
+    if (Full()) {
+      return;
+    }
+    AppendPrefix(line.empty());
+    out_.Append(line);
+    out_.Append('\n');
+    last_line_blank_ = line.empty();
+    if (out_.length() >= max_chars_) {
+      truncated_ = true;
+    }
+  }
+
+  // Ends the previous line and, between blocks, leaves a blank line; items
+  // of one list stay together unless a block asked for room. Blocks within
+  // one item are kept apart (the blank line carries no marker, and the
+  // block's lines take the item's indentation).
+  void Separate() {
+    if (out_.empty()) {
+      need_blank_ = false;
+      return;
+    }
+    if (out_[out_.length() - 1] != '\n') {
+      out_.Append('\n');
+    }
+    if ((need_blank_ || !InListItem() || ItemHoldsBlock()) &&
+        !last_line_blank_) {
+      AppendPrefix(/*blank=*/true);
+      out_.Append('\n');
+      last_line_blank_ = true;
+    }
+    need_blank_ = false;
+  }
+
+  // A paragraph whose kBreaks are line breaks.
+  void WriteParagraph(const String& text) {
+    if (Full() || text.empty()) {
+      return;
+    }
+    Separate();
+    wtf_size_t start = 0;
+    while (!Full()) {
+      const wtf_size_t end = text.find(kBreak, start);
+      if (end == kNotFound) {
+        WriteLine(text.substr(start));
+        break;
+      }
+      WriteLine(text.substr(start, end - start));
+      start = end + 1;
+    }
+  }
+
+  void FlushInline() {
+    if (inline_.empty()) {
+      return;
+    }
+    const String text = Collapse(inline_.ToString(), /*keep_breaks=*/true);
+    inline_.Clear();
+    WriteParagraph(text);
+  }
+
+  // Blocks.
+
+  void EmitHeading(Element& element, int level, int depth) {
+    FlushInline();
+    if (Full()) {
+      return;
+    }
+    const String plain = Collapse(PlainText(element), false);
+    if (plain.empty()) {
+      return;
+    }
+    StringBuilder inner;
+    RenderChildren(element, inner, depth);
+    String text = Collapse(inner.ToString(), false);
+    if (text.empty()) {
+      text = plain;
+    }
+    need_blank_ = true;
+    Separate();
+    const wtf_size_t offset = out_.length();
+    StringBuilder line;
+    for (int i = 0; i < level; ++i) {
+      line.Append('#');
+    }
+    line.Append(' ');
+    line.Append(text);
+    WriteLine(line.ReleaseString());
+    outline_.push_back(
+        OutlineEntry{level, Truncate(plain, kOutlineTextLength), offset});
+    need_blank_ = true;
+  }
+
+  void EmitList(Element& element, bool ordered, int depth) {
+    FlushInline();
+    const bool nested = InListItem();
+    if (!nested) {
+      need_blank_ = true;
+    }
+    lists_.push_back(ListState{ordered, ordered ? ListStart(element) : 1});
+    VisitChildren(element, depth);
+    FlushInline();
+    lists_.pop_back();
+    if (!nested) {
+      need_blank_ = true;
+    }
+  }
+
+  void EmitListItem(Element& element, int depth) {
+    FlushInline();
+    StringBuilder marker;
+    if (!lists_.empty() && lists_.back().ordered) {
+      marker.AppendNumber(lists_.back().next++);
+      marker.Append(". ");
+    } else {
+      marker.Append("- ");
+    }
+    const String first = marker.ReleaseString();
+    StringBuilder rest;
+    for (wtf_size_t i = 0; i < first.length(); ++i) {
+      rest.Append(' ');
+    }
+    containers_.push_back(
+        Container{first, rest.ReleaseString(), /*list_item=*/true});
+    VisitChildren(element, depth);
+    FlushInline();
+    containers_.pop_back();
+  }
+
+  void EmitQuote(Element& element, int depth) {
+    FlushInline();
+    need_blank_ = true;
+    Separate();
+    containers_.push_back(Container{"> ", "> "});
+    VisitChildren(element, depth);
+    FlushInline();
+    containers_.pop_back();
+    need_blank_ = true;
+  }
+
+  void EmitRule() {
+    FlushInline();
+    need_blank_ = true;
+    Separate();
+    WriteLine("---");
+    need_blank_ = true;
+  }
+
+  void EmitPre(Element& element) {
+    FlushInline();
+    if (Full()) {
+      return;
+    }
+    StringBuilder raw;
+    GatherPre(element, raw, 0);
+    Vector<String> lines;
+    SplitLines(raw.ToString(), lines);
+    wtf_size_t begin = 0;
+    wtf_size_t end = lines.size();
+    while (begin < end && lines[begin].ContainsOnlyWhitespaceOrEmpty()) {
+      ++begin;
+    }
+    while (end > begin && lines[end - 1].ContainsOnlyWhitespaceOrEmpty()) {
+      --end;
+    }
+    if (begin == end) {
+      return;
+    }
+    bool tildes = false;
+    for (wtf_size_t i = begin; i < end; ++i) {
+      if (lines[i].contains("```")) {
+        tildes = true;
+      }
+      text_chars_ += CollapsedLength(lines[i]);
+    }
+    const char* fence = tildes ? "~~~~" : "```";
+    need_blank_ = true;
+    Separate();
+    StringBuilder open;
+    open.Append(fence);
+    open.Append(CodeLanguage(element));
+    WriteLine(open.ReleaseString());
+    for (wtf_size_t i = begin; i < end; ++i) {
+      WriteLine(lines[i]);
+    }
+    WriteLine(fence);
+    need_blank_ = true;
+  }
+
+  // A <pre>'s text as rendered: whitespace kept, <br> and line-per-block
+  // markup (highlighters) as newlines.
+  void GatherPre(Element& element, StringBuilder& out, int depth) {
+    for (Node* child = FlatTreeTraversal::FirstChild(element); child;
+         child = FlatTreeTraversal::NextSibling(*child)) {
+      if (--budget_ <= 0) {
+        truncated_ = true;
+        return;
+      }
+      if (auto* text = DynamicTo<Text>(child)) {
+        if (TextShown(*text)) {
+          out.Append(text->data());
+        }
+        continue;
+      }
+      auto* child_element = DynamicTo<Element>(child);
+      if (!child_element || Skip(*child_element)) {
+        continue;
+      }
+      if (child_element->HasTagName(html_names::kBrTag)) {
+        out.Append('\n');
+        continue;
+      }
+      if (depth > kMaxEmitDepth) {
+        continue;
+      }
+      const bool block =
+          IsBlockTag(*child_element) || LaidOutAsBlock(*child_element);
+      if (block && !out.empty() && out[out.length() - 1] != '\n') {
+        out.Append('\n');
+      }
+      GatherPre(*child_element, out, depth + 1);
+      if (block && !out.empty() && out[out.length() - 1] != '\n') {
+        out.Append('\n');
+      }
+    }
+  }
+
+  String CodeLanguage(Element& pre) {
+    String language = LanguageFromClass(pre);
+    if (!language.empty()) {
+      return language;
+    }
+    for (Node* child = FlatTreeTraversal::FirstChild(pre); child;
+         child = FlatTreeTraversal::NextSibling(*child)) {
+      const auto* code = DynamicTo<Element>(child);
+      if (code && code->HasTagName(html_names::kCodeTag)) {
+        language = LanguageFromClass(*code);
+        break;
+      }
+    }
+    if (!language.empty()) {
+      return language;
+    }
+    // GitHub: <div class="highlight highlight-source-js"><pre>.
+    if (const auto* parent =
+            DynamicTo<Element>(FlatTreeTraversal::Parent(pre))) {
+      return LanguageFromClass(*parent);
+    }
+    return g_empty_string;
+  }
+
+  void EmitTable(Element& table, int depth) {
+    FlushInline();
+    HeapVector<Member<Element>> rows;
+    CollectRows(table, rows);
+    if (IsLayoutTable(table, rows)) {
+      VisitChildren(table, depth);
+      FlushInline();
+      return;
+    }
+    Vector<Vector<String>> cells;
+    wtf_size_t columns = 0;
+    wtf_size_t dropped = 0;
+    // browser: rows are only collected while they fit in what is left of the
+    // markdown cap. Writing them then reaches the cap (and marks the output
+    // truncated), so the rows past it are neither rendered nor noted.
+    const wtf_size_t room =
+        out_.length() < max_chars_ ? max_chars_ - out_.length() : 0;
+    wtf_size_t pending = 0;
+    for (const Member<Element>& row : rows) {
+      if (Full()) {
+        return;
+      }
+      if (pending > room) {
+        break;
+      }
+      if (Skip(*row)) {
+        continue;
+      }
+      // The header row and kTableMaxRows more.
+      if (cells.size() > kTableMaxRows) {
+        ++dropped;
+        continue;
+      }
+      Vector<String> line;
+      for (Node* child = FlatTreeTraversal::FirstChild(*row);
+           child && line.size() < kTableMaxColumns;
+           child = FlatTreeTraversal::NextSibling(*child)) {
+        auto* cell = DynamicTo<Element>(child);
+        if (!cell || !IsCell(*cell) || Skip(*cell)) {
+          continue;
+        }
+        StringBuilder inner;
+        RenderChildren(*cell, inner, depth + 1);
+        line.push_back(EscapeCell(Collapse(inner.ToString(), false)));
+        // TableRow writes each cell as " text |".
+        pending += line.back().length() + 2;
+      }
+      if (line.empty()) {
+        continue;
+      }
+      columns = std::max(columns, line.size());
+      cells.push_back(std::move(line));
+    }
+    if (cells.empty()) {
+      return;
+    }
+    need_blank_ = true;
+    Separate();
+    for (wtf_size_t i = 0; i < cells.size(); ++i) {
+      WriteLine(TableRow(cells[i], columns));
+      if (!i) {
+        WriteLine(TableRule(columns));
+      }
+    }
+    if (dropped) {
+      StringBuilder note;
+      note.Append('(');
+      note.AppendNumber(dropped);
+      note.Append(dropped == 1 ? " more row)" : " more rows)");
+      need_blank_ = true;
+      WriteParagraph(note.ReleaseString());
+    }
+    need_blank_ = true;
+  }
+
+  // <dl> as list items "**term**: definition; definition".
+  void EmitDefinitions(Element& element, int depth) {
+    FlushInline();
+    Vector<std::pair<bool, String>> entries;
+    CollectDefinitions(element, entries, depth, /*groups=*/true);
+    Vector<String> items;
+    String term;
+    StringBuilder definitions;
+    auto flush = [&]() {
+      if (term.empty() && definitions.empty()) {
+        return;
+      }
+      StringBuilder item;
+      if (!term.empty()) {
+        item.Append("**");
+        item.Append(term);
+        item.Append("**");
+        if (!definitions.empty()) {
+          item.Append(": ");
+        }
+      }
+      item.Append(definitions);
+      items.push_back(item.ReleaseString());
+      term = String();
+      definitions.Clear();
+    };
+    for (const auto& entry : entries) {
+      if (entry.second.empty()) {
+        continue;
+      }
+      if (entry.first) {
+        flush();
+        term = entry.second;
+      } else {
+        if (!definitions.empty()) {
+          definitions.Append("; ");
+        }
+        definitions.Append(entry.second);
+      }
+    }
+    flush();
+    if (items.empty()) {
+      return;
+    }
+    const bool nested = InListItem();
+    if (!nested) {
+      need_blank_ = true;
+    }
+    for (const String& item : items) {
+      containers_.push_back(Container{"- ", "  ", /*list_item=*/true});
+      WriteParagraph(item);
+      containers_.pop_back();
+    }
+    if (!nested) {
+      need_blank_ = true;
+    }
+  }
+
+  // dt/dd children, also inside <div> groups.
+  void CollectDefinitions(Element& parent,
+                          Vector<std::pair<bool, String>>& out,
+                          int depth,
+                          bool groups) {
+    for (Node* child = FlatTreeTraversal::FirstChild(parent); child && !Full();
+         child = FlatTreeTraversal::NextSibling(*child)) {
+      auto* element = DynamicTo<Element>(child);
+      if (!element || Skip(*element)) {
+        continue;
+      }
+      const bool is_term = element->HasTagName(html_names::kDtTag);
+      if (is_term || element->HasTagName(html_names::kDdTag)) {
+        StringBuilder inner;
+        RenderChildren(*element, inner, depth + 1);
+        out.push_back(
+            std::make_pair(is_term, Collapse(inner.ToString(), false)));
+      } else if (groups && element->HasTagName(html_names::kDivTag)) {
+        CollectDefinitions(*element, out, depth + 1, /*groups=*/false);
+      }
+    }
+  }
+
+  // Cuts at max_chars_ with a trailing ellipsis line when the walk stopped
+  // early, and drops outline entries past the cut.
+  void Finish() {
+    const String text = out_.ToString();
+    wtf_size_t end = text.length();
+    while (end && (text[end - 1] == '\n' || text[end - 1] == ' ')) {
+      --end;
+    }
+    if (truncated_ && end > max_chars_) {
+      end = max_chars_;
+      if (end && (text[end - 1] & 0xFC00) == 0xD800) {
+        --end;
+      }
+    }
+    StringBuilder result;
+    result.Append(StringView(text, 0, end));
+    if (truncated_) {
+      if (end) {
+        result.Append("\n\n");
+      }
+      result.Append(static_cast<UChar>(0x2026));
+    }
+    markdown_ = result.ReleaseString();
+    Vector<OutlineEntry> kept;
+    for (const OutlineEntry& entry : outline_) {
+      if (entry.offset < end) {
+        kept.push_back(entry);
+      }
+    }
+    outline_ = std::move(kept);
+  }
+
+  const bool live_;
+  Element* const region_;
+  const bool skip_chrome_;
+  const wtf_size_t body_text_length_;
+  const wtf_size_t max_chars_;
+
+  StringBuilder out_;
+  // The current paragraph's inline text, raw until FlushInline().
+  StringBuilder inline_;
+  Vector<Container> containers_;
+  Vector<ListState> lists_;
+  Vector<OutlineEntry> outline_;
+  HashSet<String> hrefs_;
+  String markdown_;
+  wtf_size_t text_chars_ = 0;
+  int budget_ = kEmitNodeBudget;
+  int ignore_layout_ = 0;
+  int link_depth_ = 0;
+  bool need_blank_ = false;
+  bool last_line_blank_ = false;
+  bool truncated_ = false;
+};
+
+// The live region to extract: a visible main ([role=main]) holding at least
+// half the body's text, else the largest such article, else the body (which
+// the emitter then walks without its chrome landmarks).
+Element* ChooseRegion(HTMLElement& body, wtf_size_t body_length) {
+  HeapVector<Member<Element>> mains;
+  HeapVector<Member<Element>> articles;
+  int budget = kWalkNodeBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(body);
+       node && budget-- > 0;) {
+    auto* element = DynamicTo<Element>(node);
+    if (!element) {
+      node = FlatTreeTraversal::Next(*node, &body);
+      continue;
+    }
+    const bool laid_out = element->GetLayoutObject() != nullptr;
+    if ((!laid_out && !element->HasDisplayContentsStyle()) ||
+        IsAriaHidden(*element)) {
+      node = FlatTreeTraversal::NextSkippingChildren(*node, &body);
+      continue;
+    }
+    if (laid_out) {
+      const ax::mojom::blink::Role role =
+          AXObject::DetermineRawAriaRole(*element);
+      const bool unknown = role == ax::mojom::blink::Role::kUnknown;
+      if (role == ax::mojom::blink::Role::kMain ||
+          (unknown && element->HasTagName(html_names::kMainTag))) {
+        if (mains.size() < 8) {
+          mains.push_back(element);
+        }
+      } else if (role == ax::mojom::blink::Role::kArticle ||
+                 (unknown && element->HasTagName(html_names::kArticleTag))) {
+        if (articles.size() < 64) {
+          articles.push_back(element);
+        }
+      }
+    }
+    node = FlatTreeTraversal::Next(*node, &body);
+  }
+  for (const Member<Element>& main : mains) {
+    if (main->GetInnerTextWithoutUpdate().length() * 2 >= body_length) {
+      return main.Get();
+    }
+  }
+  Element* best = nullptr;
+  wtf_size_t best_length = 0;
+  for (const Member<Element>& article : articles) {
+    const wtf_size_t length = article->GetInnerTextWithoutUpdate().length();
+    if (length * 2 >= body_length && (!best || length > best_length)) {
+      best = article.Get();
+      best_length = length;
+    }
+  }
+  return best ? best : &body;
+}
+
+// ---------------------------------------------------------------------------
+// Facts.
+
+bool IsOpenGraphKey(const String& key) {
+  return key.starts_with("og:") || key.starts_with("article:") ||
+         key.starts_with("product:") || key.starts_with("book:") ||
+         key.starts_with("profile:");
+}
+
+bool IsFactMetaName(const String& name) {
+  static constexpr const char* kNames[] = {"description",
+                                           "author",
+                                           "keywords",
+                                           "news_keywords",
+                                           "robots",
+                                           "googlebot",
+                                           "date",
+                                           "pubdate",
+                                           "publish_date",
+                                           "publish-date",
+                                           "last-modified",
+                                           "dc.title",
+                                           "dc.creator",
+                                           "dc.date",
+                                           "dc.description",
+                                           "citation_title",
+                                           "citation_author",
+                                           "citation_publication_date",
+                                           "citation_doi",
+                                           "parsely-title",
+                                           "parsely-author",
+                                           "parsely-pub-date",
+                                           "generator",
+                                           "application-name",
+                                           "publisher",
+                                           "copyright",
+                                           "thumbnail"};
+  for (const char* candidate : kNames) {
+    if (name == candidate) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SetOnce(JSONObject& object, const String& key, const String& value) {
+  if (!object.Get(key)) {
+    object.SetString(key, value);
+  }
+}
+
+void CollectMeta(Document& document,
+                 JSONObject& meta,
+                 JSONObject& og,
+                 JSONObject& twitter) {
+  StaticElementList* metas = document.QuerySelectorAll(AtomicString("meta"));
+  if (!metas) {
+    return;
+  }
+  const wtf_size_t count = std::min<wtf_size_t>(metas->length(), kMaxMetas);
+  for (wtf_size_t i = 0; i < count; ++i) {
+    const auto* element = DynamicTo<HTMLMetaElement>(metas->item(i));
+    if (!element) {
+      continue;
+    }
+    const String content = Truncate(
+        Collapse(element->Content().GetString(), false), kMetaValueLength);
+    if (content.empty()) {
+      continue;
+    }
+    const String name =
+        element->GetName().GetString().StripWhiteSpace().ToAsciiLower();
+    const String property =
+        element->Property().GetString().StripWhiteSpace().ToAsciiLower();
+    const String http_equiv =
+        element->HttpEquiv().GetString().StripWhiteSpace().ToAsciiLower();
+    if (!property.empty()) {
+      if (IsOpenGraphKey(property)) {
+        SetOnce(og, property, content);
+      } else if (property.starts_with("twitter:")) {
+        SetOnce(twitter, property, content);
+      }
+    }
+    if (!name.empty()) {
+      if (name.starts_with("twitter:")) {
+        SetOnce(twitter, name, content);
+      } else if (IsOpenGraphKey(name)) {
+        SetOnce(og, name, content);
+      } else if (IsFactMetaName(name)) {
+        SetOnce(meta, name, content);
+      }
+    }
+    if (http_equiv == "content-language") {
+      SetOnce(meta, "content-language", content);
+    }
+  }
+}
+
+String Canonical(Document& document) {
+  StaticElementList* links =
+      document.QuerySelectorAll(AtomicString("link[rel][href]"));
+  if (!links) {
+    return g_empty_string;
+  }
+  const wtf_size_t count = std::min<wtf_size_t>(links->length(), 200);
+  for (wtf_size_t i = 0; i < count; ++i) {
+    const auto* link = DynamicTo<HTMLLinkElement>(links->item(i));
+    if (!link || !link->RelAttribute().IsCanonical()) {
+      continue;
+    }
+    const KURL url = link->Href();
+    if (url.IsValid()) {
+      return NonNull(url.GetString().GetString());
+    }
+  }
+  return g_empty_string;
+}
+
+// isAccessibleForFree false anywhere in a JSON-LD item, its hasPart or its
+// @graph (Google's paywalled-content markup).
+bool IsNotFree(const JSONValue* value, int depth) {
+  if (!value || depth > 5) {
+    return false;
+  }
+  if (const JSONArray* array = JSONArray::Cast(value)) {
+    for (wtf_size_t i = 0; i < array->size(); ++i) {
+      if (IsNotFree(array->at(i), depth + 1)) {
+        return true;
+      }
+    }
+    return false;
+  }
+  const JSONObject* object = JSONObject::Cast(value);
+  if (!object) {
+    return false;
+  }
+  if (const JSONValue* flag = object->Get("isAccessibleForFree")) {
+    bool is_free = true;
+    String text;
+    if (flag->AsBoolean(&is_free) && !is_free) {
+      return true;
+    }
+    if (flag->AsString(&text) &&
+        EqualIgnoringAsciiCase(text.StripWhiteSpace(), "false")) {
+      return true;
+    }
+  }
+  return IsNotFree(object->Get("hasPart"), depth + 1) ||
+         IsNotFree(object->Get("@graph"), depth + 1);
+}
+
+// The objects of a JSON-LD block, arrays and @graph flattened, kept as
+// parsed.
+void AddJsonLdItems(const JSONValue& value, JSONArray& out, int depth) {
+  if (out.size() >= kJsonLdMaxItems || depth > 3) {
+    return;
+  }
+  if (const JSONArray* array = JSONArray::Cast(&value)) {
+    for (wtf_size_t i = 0; i < array->size(); ++i) {
+      if (const JSONValue* item = array->at(i)) {
+        AddJsonLdItems(*item, out, depth + 1);
+      }
+    }
+    return;
+  }
+  const JSONObject* object = JSONObject::Cast(&value);
+  if (!object) {
+    return;
+  }
+  if (const JSONArray* graph = object->GetArray("@graph")) {
+    AddJsonLdItems(*graph, out, depth + 1);
+    return;
+  }
+  out.PushValue(object->Clone());
+}
+
+// Every script[type*=ld+json]'s text, parsed with Blink's JSON parser.
+// browser: the text is read from the script's Text children; the script is
+// never run and nothing is set on it. Returns whether any item says
+// isAccessibleForFree false.
+bool CollectJsonLd(Document& document, JSONArray& out) {
+  StaticElementList* scripts =
+      document.QuerySelectorAll(AtomicString("script[type*='ld+json' i]"));
+  if (!scripts) {
+    return false;
+  }
+  bool not_free = false;
+  wtf_size_t blocks = 0;
+  for (wtf_size_t i = 0; i < scripts->length() && blocks < kJsonLdMaxBlocks;
+       ++i) {
+    const Element* script = scripts->item(i);
+    const String source = ChildText(*script, kJsonLdSourceLimit + 1);
+    if (source.empty() || source.length() > kJsonLdSourceLimit) {
+      continue;
+    }
+    const std::unique_ptr<JSONValue> value = ParseJSON(source);
+    if (!value) {
+      continue;
+    }
+    ++blocks;
+    if (IsNotFree(value.get(), 0)) {
+      not_free = true;
+    }
+    AddJsonLdItems(*value, out, 0);
+  }
+  return not_free;
+}
+
+int CountElements(Document& document, int limit) {
+  int count = 0;
+  for (Element* element = ElementTraversal::FirstWithin(document);
+       element && count < limit; element = ElementTraversal::Next(*element)) {
+    ++count;
+  }
+  return count;
+}
+
+// ---------------------------------------------------------------------------
+// The private world.
+
+// browser: before every run, the private world takes the document's origin
+// and an empty, non-null CSP. The empty policy is what keeps a Trusted Types
+// page from firing page-visible violations at our innerHTML and cloneNode.
+// Both maps are process-global per world id, so this is set again each time.
+void PrepareWorld(LocalDOMWindow& window) {
+  const scoped_refptr<SecurityOrigin> origin =
+      window.GetSecurityOrigin()->IsolatedCopy();
+  DOMWrapperWorld::SetIsolatedWorldSecurityOrigin(
+      IsolatedWorldId::kAgentFetchWorldId, origin);
+  IsolatedWorldCSP::Get().SetContentSecurityPolicy(
+      IsolatedWorldId::kAgentFetchWorldId, g_empty_string, origin);
+}
+
+// Readability.js + Readability-readerable.js + agent_fetch.js inside one
+// function, so nothing lands on the world's global; built once per renderer.
+String BuildReadabilityScript() {
+  StringBuilder script;
+  script.Append("(function () {\n");
+  script.Append(UncompressResourceAsString(IDR_AGENT_FETCH_READABILITY_JS));
+  script.Append("\n;\n");
+  script.Append(UncompressResourceAsString(IDR_AGENT_FETCH_READERABLE_JS));
+  script.Append("\n;\n");
+  script.Append(UncompressResourceAsString(IDR_AGENT_FETCH_JS));
+  script.Append("\nreturn agentFetchRun();\n})();\n");
+  return script.ReleaseString();
+}
+
+const String& ReadabilityScript() {
+  DEFINE_STATIC_LOCAL(const String, script, (BuildReadabilityScript()));
+  return script;
+}
+
+struct ReadabilityOutcome {
+  STACK_ALLOCATED();
+
+ public:
+  bool readerable = false;
+  String title;
+  String byline;
+  String site_name;
+  String published_time;
+  String excerpt;
+  String lang;
+  Element* article = nullptr;
+};
+
+// Runs the driver in kAgentFetchWorldId: isProbablyReaderable on the live
+// document, then (if readerable) Readability on document.cloneNode(true).
+// Any failure leaves the outcome empty, and the caller falls back to the
+// structural walk.
+ReadabilityOutcome RunReadability(Document& document) {
+  ReadabilityOutcome outcome;
+  LocalFrame* frame = document.GetFrame();
+  LocalDOMWindow* window = document.domWindow();
+  if (!frame || !window) {
+    return outcome;
+  }
+  PrepareWorld(*window);
+  v8::Isolate* isolate = ToIsolate(frame);
+  v8::HandleScope handle_scope(isolate);
+  const ScriptEvaluationResult result =
+      ClassicScript::CreateUnspecifiedScript(
+          ReadabilityScript(), ScriptSourceLocationType::kInternal)
+          ->RunScriptInIsolatedWorldAndReturnValue(
+              window, IsolatedWorldId::kAgentFetchWorldId);
+  if (result.GetResultType() != ScriptEvaluationResult::ResultType::kSuccess) {
+    return outcome;
+  }
+  ScriptState* script_state =
+      ToScriptState(frame, *DOMWrapperWorld::EnsureIsolatedWorld(
+                               isolate, IsolatedWorldId::kAgentFetchWorldId));
+  if (!script_state || !script_state->ContextIsValid()) {
+    return outcome;
+  }
+  ScriptState::Scope script_state_scope(script_state);
+  V8DoNotRunMicrotasksScope microtasks_scope(script_state);
+  const v8::Local<v8::Value> value = result.GetSuccessValue();
+  if (value.IsEmpty() || !value->IsArray()) {
+    return outcome;
+  }
+  const v8::Local<v8::Array> array = value.As<v8::Array>();
+  const v8::Local<v8::Context> context = script_state->GetContext();
+  v8::Local<v8::Value> meta_value;
+  v8::Local<v8::Value> element_value;
+  if (array->Length() < 2 || !array->Get(context, 0).ToLocal(&meta_value) ||
+      !array->Get(context, 1).ToLocal(&element_value)) {
+    return outcome;
+  }
+  if (meta_value->IsString()) {
+    const std::unique_ptr<JSONValue> parsed =
+        ParseJSON(ToCoreString(isolate, meta_value.As<v8::String>()));
+    if (const JSONObject* meta = JSONObject::Cast(parsed.get())) {
+      outcome.readerable = meta->BooleanProperty("readerable", false);
+      meta->GetString("title", &outcome.title);
+      meta->GetString("byline", &outcome.byline);
+      meta->GetString("siteName", &outcome.site_name);
+      meta->GetString("publishedTime", &outcome.published_time);
+      meta->GetString("excerpt", &outcome.excerpt);
+      meta->GetString("lang", &outcome.lang);
+    }
+  }
+  outcome.article = V8Element::ToWrappable(isolate, element_value);
+  return outcome;
+}
