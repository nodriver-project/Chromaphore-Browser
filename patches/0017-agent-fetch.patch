+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "url/gurl.h"
+
+class AgentFetchJob;
+
+// browser: what one Browser.agentFetch call asked for, validated.
+struct AgentFetchParams {
+  enum class Mode { kAuto, kRaw };
+
+  AgentFetchParams();
+  AgentFetchParams(AgentFetchParams&&);
+  AgentFetchParams& operator=(AgentFetchParams&&);
+  ~AgentFetchParams();
+
+  // A method other than GET, any header, or a body makes the call an API
+  // call: a real fetch() from a synthetic document of the URL's origin (or of
+  // `referrer`), instead of a navigation.
+  bool IsApiCall() const;
+
+  // Empty when the caller gave none; the fetcher then mints one.
+  std::string fetch_id;
+  GURL url;
+  Mode mode = Mode::kAuto;
+  std::string method = "GET";
+  // In the caller's order; forbidden names already stripped.
+  std::vector<std::pair<std::string, std::string>> headers;
+  std::optional<std::string> body;
+  // The API call's document URL; empty means "<origin>/".
+  GURL referrer;
+  // The whole call, from navigation start to reply.
+  base::TimeDelta timeout = base::Seconds(30);
+  // The settle budget: the first committed document's cap, shared by the
+  // documents that replace it (each gets at least 3 s), and given in full
+  // again to the document a cleared bot check leads to.
+  base::TimeDelta settle = base::Seconds(10);
+  // Where a binary body goes; empty means a file under the profile.
+  base::FilePath save_to;
+  // Whether to return every link rather than the inline ones only.
+  bool want_links = false;
+};
+
+// browser: owns the Browser.agentFetch jobs of one DevTools session. Each job
+// owns its offscreen page (or its synthetic document for an API call), its
+// renderer agent remote, its body sink, its timer and its reply callback.
+// Jobs run concurrently up to kMaxConcurrent; later calls queue, up to
+// kMaxQueued of them, and a call past those is refused. Destroying the
+// fetcher (the session detached) destroys every job without answering:
+// nobody is listening any more. The profile going away ends every job with
+// "error" (the session may still be listening) and leaves the fetcher dead:
+// profile() is null and every new call fails.
+class AgentFetcher : public ProfileObserver {
+ public:
+  using Callback = protocol::Browser::Backend::AgentFetchCallback;
+
+  static constexpr int kMaxConcurrent = 6;
+  // The most calls that may wait for a running one to end.
+  static constexpr int kMaxQueued = 64;
+
+  AgentFetcher(Profile* profile, bool may_write_local_files);
+  AgentFetcher(const AgentFetcher&) = delete;
+  AgentFetcher& operator=(const AgentFetcher&) = delete;
+  ~AgentFetcher() override;
+
+  // Starts (or queues) a fetch. The callback is answered exactly once, on the
+  // UI thread, unless the fetcher dies first.
+  void Fetch(AgentFetchParams params, std::unique_ptr<Callback> callback);
+
+  // Ends a running or queued fetch with outcome "cancelled". False when no
+  // fetch has that id.
+  bool Cancel(const std::string& fetch_id);
+
+  // Null once the profile is going away.
+  Profile* profile() { return profile_; }
+  bool may_write_local_files() const { return may_write_local_files_; }
+  // Where a body goes when the call gave no saveTo: <profile>/agent_fetch.
+  // Files there older than kSaveLifetime are deleted when a fetcher is made.
+  const base::FilePath& save_dir() const { return save_dir_; }
+
+  static constexpr base::TimeDelta kSaveLifetime = base::Hours(24);
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+ private:
+  friend class AgentFetchJob;
+
+  // A finished job calls this (through a posted task) to be destroyed and to
+  // let the next queued job start.
+  void OnJobDone(const std::string& fetch_id);
+  void StartQueued();
+
+  raw_ptr<Profile> profile_;
+  const bool may_write_local_files_;
+  const base::FilePath save_dir_;
+  int next_id_ = 1;
+  std::map<std::string, std::unique_ptr<AgentFetchJob>> running_;
+  std::vector<std::unique_ptr<AgentFetchJob>> queued_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<AgentFetcher> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_AGENT_FETCHER_H_
