+    const Options&) = default;
+AgentFetchBodySink::Options::~Options() = default;
+
+// static
+std::string AgentFetchBodySink::KindForMimeType(std::string_view mime_type) {
+  const std::string mime = base::ToLowerASCII(mime_type);
+  if (mime == "text/html" || mime == "application/xhtml+xml") {
+    return "html";
+  }
+  if (blink::IsJSONMimeType(mime)) {
+    return "json";
+  }
+  // Includes image/svg+xml and the rss and atom types.
+  if (blink::IsXMLMimeType(mime)) {
+    return "xml";
+  }
+  if (blink::IsSupportedJavascriptMimeType(mime) ||
+      blink::IsUnsupportedTextMimeType(mime) || mime.starts_with("text/")) {
+    return "text";
+  }
+  return "binary";
+}
+
+// static
+std::string AgentFetchBodySink::DecodeToUTF8(std::string_view bytes,
+                                             std::string_view kind,
+                                             std::string_view header_charset,
+                                             std::string* charset_used) {
+  std::string charset;
+  std::string_view body = bytes;
+  if (body.starts_with("\xEF\xBB\xBF")) {
+    charset = "utf-8";
+    body.remove_prefix(3);
+  } else if (body.starts_with("\xFE\xFF")) {
+    charset = "utf-16be";
+    body.remove_prefix(2);
+  } else if (body.starts_with("\xFF\xFE")) {
+    charset = "utf-16le";
+    body.remove_prefix(2);
+  } else if (!header_charset.empty()) {
+    charset = NormalizeCharset(header_charset);
+  } else if (kind == "json") {
+    // RFC 8259: JSON exchanged between systems is UTF-8.
+    charset = "utf-8";
+  } else if (kind == "xml") {
+    charset = NormalizeCharset(XmlDeclaredEncoding(body));
+    // A declaration readable as ASCII is not in UTF-16, whatever it says.
+    if (charset.starts_with("utf-16")) {
+      charset = "utf-8";
+    }
+  }
+
+  std::string out;
+  if (charset.empty() || !ConvertToUTF8(body, charset, &out)) {
+    charset = base::IsStringUTF8AllowingNoncharacters(WithoutCutUTF8Tail(body))
+                  ? "utf-8"
+                  : "windows-1252";
+    if (!ConvertToUTF8(body, charset, &out)) {
+      out.clear();
+    }
+  }
+  // The CDP encoder drops invalid bytes silently; never hand it any.
+  if (!base::IsStringUTF8AllowingNoncharacters(out)) {
+    std::string repaired;
+    if (!ConvertToUTF8(out, "utf-8", &repaired)) {
+      repaired.clear();
+    }
+    out = std::move(repaired);
+  }
+  if (charset_used) {
+    *charset_used = charset;
+  }
+  return out;
+}
+
+// static
+std::unique_ptr<AgentFetchBodySink> AgentFetchBodySink::ForNavigation(
+    Options options,
+    mojo::ScopedDataPipeConsumerHandle body,
+    network::mojom::URLLoaderClientEndpointsPtr endpoints,
+    DoneCallback done) {
+  auto sink = base::WrapUnique(
+      new AgentFetchBodySink(std::move(options), std::move(done)));
+  sink->StartDraining(std::move(body), std::move(endpoints));
+  return sink;
+}
+
+// static
+std::unique_ptr<AgentFetchBodySink> AgentFetchBodySink::ForBytes(
+    Options options,
+    std::string bytes,
+    DoneCallback done) {
+  auto sink = base::WrapUnique(
+      new AgentFetchBodySink(std::move(options), std::move(done)));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&AgentFetchBodySink::FeedBytes,
+                     sink->weak_factory_.GetWeakPtr(), std::move(bytes)));
+  return sink;
+}
+
+AgentFetchBodySink::AgentFetchBodySink(Options options, DoneCallback done)
+    : options_(std::move(options)), done_(std::move(done)) {
+  result_.kind = KindForMimeType(options_.mime_type);
+}
+
+AgentFetchBodySink::~AgentFetchBodySink() = default;
+
+void AgentFetchBodySink::StartDraining(
+    mojo::ScopedDataPipeConsumerHandle body,
+    network::mojom::URLLoaderClientEndpointsPtr endpoints) {
+  if (endpoints) {
+    // Holding the loader keeps the request alive until the body is read.
+    url_loader_.Bind(std::move(endpoints->url_loader));
+    client_receiver_.Bind(std::move(endpoints->url_loader_client));
+    // Unretained: `client_receiver_` is owned by this and never runs the
+    // handler after it is destroyed.
+    client_receiver_.set_disconnect_handler(base::BindOnce(
+        &AgentFetchBodySink::OnLoaderDisconnected, base::Unretained(this)));
+  } else {
+    load_complete_ = true;
+  }
+  if (body) {
+    drainer_ = std::make_unique<mojo::DataPipeDrainer>(this, std::move(body));
+  } else {
+    data_complete_ = true;
+  }
+  if (data_complete_ && load_complete_) {
+    // Never answer from inside the caller's own call.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AgentFetchBodySink::MaybeFinish,
+                                  weak_factory_.GetWeakPtr()));
+  }
+}
+
+void AgentFetchBodySink::FeedBytes(std::string bytes) {
+  Append(base::as_byte_span(bytes));
+  data_complete_ = true;
+  load_complete_ = true;
+  MaybeFinish();
+}
+
+void AgentFetchBodySink::OnReceiveEarlyHints(
+    network::mojom::EarlyHintsPtr early_hints) {
+  // The response had arrived before the sink took over.
+}
+
+void AgentFetchBodySink::OnReceiveResponse(
+    network::mojom::URLResponseHeadPtr head,
+    mojo::ScopedDataPipeConsumerHandle body,
+    std::optional<mojo_base::BigBuffer> cached_metadata) {
+  // The response had arrived before the sink took over.
+}
+
+void AgentFetchBodySink::OnReceiveRedirect(
+    const net::RedirectInfo& redirect_info,
+    network::mojom::URLResponseHeadPtr head) {
+  // Redirects were followed before the sink took over.
+}
+
+void AgentFetchBodySink::OnUploadProgress(int64_t current_position,
+                                          int64_t total_size,
+                                          OnUploadProgressCallback callback) {
+  std::move(callback).Run();
+}
+
+void AgentFetchBodySink::OnTransferSizeUpdated(int32_t transfer_size_diff) {}
+
+void AgentFetchBodySink::OnComplete(
+    const network::URLLoaderCompletionStatus& status) {
+  load_complete_ = true;
+  if (status.error_code != net::OK && result_.net_error == net::OK) {
+    result_.net_error = status.error_code;
+  }
+  MaybeFinish();
+}
+
+void AgentFetchBodySink::OnDataAvailable(base::span<const uint8_t> data) {
+  Append(data);
+}
+
+void AgentFetchBodySink::OnDataComplete() {
+  data_complete_ = true;
+  MaybeFinish();
+}
+
+void AgentFetchBodySink::OnLoaderDisconnected() {
+  if (!load_complete_) {
+    load_complete_ = true;
+    if (result_.net_error == net::OK) {
+      result_.net_error = net::ERR_FAILED;
+    }
+  }
+  MaybeFinish();
+}
+
+void AgentFetchBodySink::Append(base::span<const uint8_t> data) {
+  if (finished_ || capped_) {
+    return;
+  }
+  bool over_cap = false;
+  const int64_t room = kMaxBytes - result_.bytes;
+  if (static_cast<int64_t>(data.size()) > room) {
+    data = data.first(static_cast<size_t>(std::max<int64_t>(room, 0)));
+    over_cap = true;
+  }
+  result_.bytes += static_cast<int64_t>(data.size());
+
+  if (result_.kind == "binary") {
+    WriteToFile(data);
+  } else if (!spilling_ && static_cast<int64_t>(text_buffer_.size() +
+                                                data.size()) <= kMaxTextBytes) {
+    text_buffer_.append(data.begin(), data.end());
+  } else {
+    if (!spilling_) {
+      // Past 8 MiB the whole body goes to a file; the reply keeps the head.
+      spilling_ = true;
+      result_.truncated = true;
+      WriteToFile(base::as_byte_span(text_buffer_));
+      const size_t keep = static_cast<size_t>(
+          std::max<int64_t>(kMaxTextBytes - text_buffer_.size(), 0));
+      base::span<const uint8_t> head = data.first(std::min(keep, data.size()));
+      text_buffer_.append(head.begin(), head.end());
+    }
+    WriteToFile(data);
+  }
+
+  if (over_cap) {
+    StopAtCap();
+  }
+}
+
+void AgentFetchBodySink::EnsureWriter() {
+  if (writer_ || writer_unavailable_) {
+    return;
+  }
+  if (!options_.may_write_files) {
+    writer_unavailable_ = true;
+    result_.file_error = "this client may not write local files";
+    return;
+  }
+  base::FilePath target = options_.save_to;
+  bool make_unique = false;
+  if (target.empty()) {
+    if (options_.default_dir.empty()) {
+      writer_unavailable_ = true;
+      result_.file_error = "no directory to save to";
+      return;
+    }
+    target = options_.default_dir.Append(net::GenerateFileName(
+        options_.url, options_.content_disposition, std::string(),
+        std::string(), options_.mime_type, "download"));
+    make_unique = true;
+  }
+  writer_ = base::SequenceBound<AgentFetchFileWriter>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}),
+      std::move(target), PartTag(options_.part_tag), make_unique);
+}
+
+void AgentFetchBodySink::WriteToFile(base::span<const uint8_t> data) {
+  EnsureWriter();
+  if (!writer_ || data.empty()) {
+    return;
+  }
+  writer_.AsyncCall(&AgentFetchFileWriter::Write)
+      .WithArgs(std::string(data.begin(), data.end()));
+}
+
+void AgentFetchBodySink::StopAtCap() {
+  // The drainer is in its own callback here, so it is left to see the pipe
+  // close; dropping the loader cancels the request like a user stop.
+  capped_ = true;
+  result_.truncated = true;
+  url_loader_.reset();
+  client_receiver_.reset();
+  load_complete_ = true;
+  if (!drainer_) {
+    data_complete_ = true;
+  }
+  MaybeFinish();
+}
+
+void AgentFetchBodySink::MaybeFinish() {
+  if (!finished_ && data_complete_ && load_complete_) {
+    Finish();
+  }
+}
+
+void AgentFetchBodySink::Finish() {
+  finished_ = true;
+  if (result_.kind != "binary") {
+    result_.text = DecodeToUTF8(text_buffer_, result_.kind, options_.charset,
+                                &result_.charset);
+    text_buffer_.clear();
+    // Raw GitHub and others serve .json as text/plain.
+    if (result_.kind == "text" && !result_.truncated &&
+        base::ToLowerASCII(options_.mime_type) == "text/plain") {
+      std::string_view trimmed =
+          base::TrimWhitespaceASCII(*result_.text, base::TRIM_LEADING);
+      if ((trimmed.starts_with("{") || trimmed.starts_with("[")) &&
+          base::JSONReader::Read(trimmed, base::JSON_PARSE_RFC)) {
+        result_.kind = "json";
+      }
+    }
+  } else {
+    result_.charset = base::ToLowerASCII(options_.charset);
+  }
+
+  if (!writer_) {
+    if (result_.kind == "binary" && result_.file_error.empty() &&
+        result_.bytes > 0) {
+      result_.file_error = "nothing was written";
+    }
+    RunDone();
+    return;
+  }
+  // A binary that stopped early is useless: its `.part` is deleted.
+  if (result_.kind == "binary" && (capped_ || result_.net_error != net::OK)) {
+    result_.file_error = capped_ ? "too_large" : "incomplete";
+    writer_.Reset();
+    RunDone();
+    return;
+  }
+  writer_.AsyncCall(&AgentFetchFileWriter::Commit)
+      .Then(base::BindOnce(&AgentFetchBodySink::OnFileCommitted,
+                           weak_factory_.GetWeakPtr()));
+}
+
+void AgentFetchBodySink::OnFileCommitted(base::FilePath path) {
+  writer_.Reset();
+  if (path.empty()) {
+    result_.file_error = "the file could not be written";
+  } else {
+    result_.saved_to = std::move(path);
+  }
+  RunDone();
+}
+
+void AgentFetchBodySink::RunDone() {
+  // Last statement: the owner may act on the result at once.
+  if (done_) {
+    std::move(done_).Run(std::move(result_));
+  }
+}
