@@ -0,0 +1,85 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/browser/browser_switches.h"
+
+namespace switches {
+
+// Presence-only opt-out. The browser-defaults preset (telemetry off,
+// privacy-positive features; see browser::MaybeExpandBrowserDefaults) is
+// applied on every launch; this switch skips it so the browser behaves like
+// stock Chromium.
+const char kUseChromiumDefaults[] = "use-chromium-defaults";
+
+// Browser brand (e.g. "Chrome").
+const char kFingerprintBrand[] = "fingerprint-brand";
+
+// Browser major version (e.g. "145").
+const char kFingerprintBrandVersion[] = "fingerprint-brand-version";
+
+// Full browser version (e.g. "145.0.7309.92").
+const char kFingerprintBrandVersionLong[] = "fingerprint-brand-version-long";
+
+// Comma-separated hosts (subdomains included) that may use the software
+// secure PlayReady CDM in addition to primevideo.com and amazon.com; "*"
+// allows every origin. Other origins see the EME answers of stock Chrome.
+const char kSoftwarePlayreadySites[] = "software-playready-sites";
+
+// Linux, a comma-separated list of sites (a host or a parent domain; "*"
+// for every site) that get Linux's Widevine unchanged, so their Widevine
+// content plays, in addition to the major streaming services. Other sites
+// see Widevine as Chrome on Windows runs it (media/cdm/windows_widevine.h),
+// whose license requests a license server refuses.
+const char kWidevinePlaybackSites[] = "widevine-playback-sites";
+
+// Internal, set by the browser on each renderer's command line: the
+// microseconds renderers add to the monotonic clock before they clamp
+// DOMHighResTimeStamps, so the rounding follows a clock 2 to 30 days old
+// when the browser session started, drawn once per session
+// (render_process_host_impl.cc), and not the machine's uptime
+// (third_party/blink/renderer/core/timing/performance.cc).
+const char kTimerUptimeOffset[] = "timer-uptime-offset";
+
+// Presence-only. Draws a cursor overlay while a DevTools client is attached.
+const char kShowCdpCursor[] = "show-cdp-cursor";
+
+// Presence-only. navigator.credentials.create() and .get() with a publicKey
+// option short-circuit in the browser process before any platform
+// authenticator UI (Windows Hello, Touch ID) appears. After a random 1-5 s
+// delay, mimicking a user dismissing the prompt, the request rejects with
+// NotAllowedError, the same DOMException a site sees after a real cancel.
+// isUserVerifyingPlatformAuthenticatorAvailable() and
+// isConditionalMediationAvailable() keep their truthful answers so the site
+// sees no inconsistency between "authenticator available" and "declined".
+const char kAutoDeclineWebauthn[] = "auto-decline-webauthn";
+
+// Presence-only. The browser keeps its own in-memory clipboard instead of
+// the operating system's: copy, cut and paste -- keyboard shortcuts,
+// execCommand and the async Clipboard API alike -- work within this browser
+// process and never read or overwrite the clipboard of the person at the
+// machine, nor that of any other browser running beside it. The same
+// platform-independent clipboard headless mode always uses.
+const char kPrivateClipboard[] = "private-clipboard";
+
+// The seed of the pointer's human-movement persona (one identity, one
+// hand); an int64. Absent: derived from the master seed, or random.
+// Browser process only.
+const char kMovementPersonaSeed[] = "movement-persona-seed";
+
+// Presence-only. A page's window.print() runs Chrome's own scripted-print flow
+// -- beforeprint, print() blocked while the page is paused -- but no print
+// preview opens. After a random 1-4 s, the time a person takes to close a
+// preview they did not want, the preview is closed as the dialog's Cancel
+// closes it: the page gets afterprint and print() returns. Page.printToPDF is
+// unaffected.
+const char kCancelPrintPreview[] = "cancel-print-preview";
+
+// Presence-only. A page's PaymentRequest.show() opens Chrome's payment
+// sheet, which takes the tab's input while it is up. After a random 1-2 s,
+// the time a person takes to close a sheet they did not mean to open, it is
+// closed as its Cancel button closes it: show() rejects with Chrome's own
+// AbortError.
+const char kCancelPaymentRequest[] = "cancel-payment-request";
+
+}  // namespace switches
