+
+std::optional<std::array<float, 2>> WindowsGpuFloatPairParameter(
+    uint32_t pname) {
+  if (!PresentsWindowsGpu() || pname != GL_ALIASED_POINT_SIZE_RANGE) {
+    return std::nullopt;
+  }
+  return std::array<float, 2>{1.0f, 1024.0f};
+}
+
+bool WindowsGpuPrecisionFormat(uint32_t precision_type,
+                               std::array<int32_t, 2>& range,
+                               int32_t& precision) {
+  if (!PresentsWindowsGpu()) {
+    return false;
+  }
+  switch (precision_type) {
+    case GL_LOW_FLOAT:
+    case GL_MEDIUM_FLOAT:
+    case GL_HIGH_FLOAT:
+      range = {127, 127};
+      precision = 23;
+      return true;
+    case GL_LOW_INT:
+    case GL_MEDIUM_INT:
+    case GL_HIGH_INT:
+      range = {31, 30};
+      precision = 0;
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool WindowsGpuHidesExtension(std::string_view name) {
+  if (!PresentsWindowsGpu()) {
+    return false;
+  }
+  for (std::string_view hidden : kHiddenExtensions) {
+    if (hidden == name) {
+      return true;
+    }
+  }
+  return false;
+}
+
+int64_t WindowsGpuCombinedVertexUniformComponents(int vertex_uniform_vectors) {
+  return int64_t{12} * 16384 + int64_t{4} * vertex_uniform_vectors;
+}
+
+std::optional<std::array<uint32_t, 2>> WindowsGpuSubgroupRange(
+    std::string_view vendor,
+    std::string_view architecture) {
+  if (vendor == "nvidia") {
+    return std::array<uint32_t, 2>{32, 32};
+  }
+  if (vendor == "amd") {
+    if (architecture.starts_with("gcn-")) {
+      return std::array<uint32_t, 2>{64, 64};
+    }
+    if (architecture.starts_with("rdna-")) {
+      return std::array<uint32_t, 2>{32, 64};
+    }
+    return std::nullopt;
+  }
+  if (vendor == "intel") {
+    // Dawn lowers Gen 12 LP's minimum to 8.
+    if (architecture == "gen-12-lp") {
+      return std::array<uint32_t, 2>{8, 32};
+    }
+    if (architecture.starts_with("gen-") || architecture.starts_with("xe-")) {
+      return std::array<uint32_t, 2>{16, 32};
+    }
+  }
+  return std::nullopt;
+}
+
+base::span<const std::string_view> WindowsGpuWebgpuFeatures() {
+  return kWebgpuFeatures;
+}
+
+void ApplyWindowsGpuWebgpuLimits(wgpu::Limits& limits,
+                                 wgpu::CompatibilityModeLimits& compat_limits) {
+  limits.maxTextureDimension1D = 16384;
+  limits.maxTextureDimension2D = 16384;
+  limits.maxTextureDimension3D = 2048;
+  limits.maxTextureArrayLayers = 2048;
+  limits.maxBindGroups = 4;
+  limits.maxBindGroupsPlusVertexBuffers = 24;
+  limits.maxBindingsPerBindGroup = 1000;
+  limits.maxDynamicUniformBuffersPerPipelineLayout = 10;
+  limits.maxDynamicStorageBuffersPerPipelineLayout = 8;
+  limits.maxSampledTexturesPerShaderStage = 48;
+  limits.maxSamplersPerShaderStage = 16;
+  limits.maxStorageBuffersPerShaderStage = 16;
+  limits.maxStorageTexturesPerShaderStage = 8;
+  limits.maxUniformBuffersPerShaderStage = 12;
+  limits.maxUniformBufferBindingSize = 65536;
+  limits.maxStorageBufferBindingSize = 2147483644;
+  limits.minUniformBufferOffsetAlignment = 256;
+  limits.minStorageBufferOffsetAlignment = 256;
+  limits.maxVertexBuffers = 8;
+  limits.maxBufferSize = 2147483648;
+  limits.maxVertexAttributes = 30;
+  limits.maxVertexBufferArrayStride = 2048;
+  limits.maxInterStageShaderVariables = 28;
+  limits.maxColorAttachments = 8;
+  limits.maxColorAttachmentBytesPerSample = 128;
+  limits.maxComputeWorkgroupStorageSize = 32768;
+  limits.maxComputeInvocationsPerWorkgroup = 1024;
+  limits.maxComputeWorkgroupSizeX = 1024;
+  limits.maxComputeWorkgroupSizeY = 1024;
+  limits.maxComputeWorkgroupSizeZ = 64;
+  limits.maxComputeWorkgroupsPerDimension = 65535;
+  limits.maxImmediateSize = 64;
+  compat_limits.maxStorageBuffersInFragmentStage = 16;
+  compat_limits.maxStorageTexturesInFragmentStage = 8;
+  compat_limits.maxStorageBuffersInVertexStage = 16;
+  compat_limits.maxStorageTexturesInVertexStage = 8;
+}
+
+}  // namespace blink
