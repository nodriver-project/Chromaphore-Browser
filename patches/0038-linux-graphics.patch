+#if BUILDFLAG(IS_LINUX)
+// browser: what |shader| was compiled with: its source and the extensions
+// the page had enabled (the translation is made from these, as ANGLE on
+// Windows translates at compile time).
+void GLES2DecoderPassthroughImpl::RecordCompiledShader(GLuint shader) {
+  const GLuint service_id = GetShaderServiceID(shader, resources_);
+  if (!service_id) {
+    return;
+  }
+  GLint source_length = 0;
+  api()->glGetShaderivFn(service_id, GL_SHADER_SOURCE_LENGTH, &source_length);
+  CompiledShader& compiled = compiled_shaders_[shader];
+  compiled.source.clear();
+  if (source_length > 0) {
+    std::vector<char> buffer(source_length, 0);
+    GLsizei length = 0;
+    api()->glGetShaderSourceFn(service_id, source_length, &length,
+                               buffer.data());
+    compiled.source.assign(buffer.data(), length);
+  }
+  const char* extensions =
