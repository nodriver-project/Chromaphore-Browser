+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_GPU_WINDOWS_GPU_PROFILE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_GPU_WINDOWS_GPU_PROFILE_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+#include "base/containers/span.h"
+
+#include "third_party/blink/renderer/platform/graphics/gpu/webgpu_cpp.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink {
+
+// browser: what WebGL reports in a Linux build presenting Windows: the values
+// ANGLE's Direct3D 11 backend reports on Windows in place of the host's
+// (SwiftShader on a server), and one common Intel integrated GPU's names when
+// no persona claims another. Only what pages read changes; the limits Blink
+// and the GPU process enforce stay the host's.
+PLATFORM_EXPORT bool PresentsWindowsGpu();
+
+inline constexpr char kWindowsGpuVendor[] = "Google Inc. (Intel)";
+inline constexpr char kWindowsGpuRenderer[] =
+    "ANGLE (Intel, Intel(R) Iris(R) Xe Graphics (0x00009A49) Direct3D11 "
+    "vs_5_0 ps_5_0, D3D11)";
+inline constexpr int kWindowsGpuVertexUniformVectors = 4096;
+
+// Direct3D 11's value for a parameter getParameter() returns as a number,
+// a pair or a float; nullopt for the ones it reports as the host does.
+PLATFORM_EXPORT std::optional<int64_t> WindowsGpuIntParameter(uint32_t pname);
+PLATFORM_EXPORT std::optional<float> WindowsGpuFloatParameter(uint32_t pname);
+PLATFORM_EXPORT std::optional<std::array<int32_t, 2>>
+WindowsGpuIntPairParameter(uint32_t pname);
+PLATFORM_EXPORT std::optional<std::array<float, 2>>
+WindowsGpuFloatPairParameter(uint32_t pname);
+
+// Every precision is full precision in Direct3D 11. False for an unknown
+// precision type.
+PLATFORM_EXPORT bool WindowsGpuPrecisionFormat(uint32_t precision_type,
+                                               std::array<int32_t, 2>& range,
+                                               int32_t& precision);
+
+// The extensions Direct3D 11 never offers.
+PLATFORM_EXPORT bool WindowsGpuHidesExtension(std::string_view name);
+
+// MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS for a number of vertex uniform
+// vectors: 12 uniform blocks of 16384 components plus 4 per vector.
+PLATFORM_EXPORT int64_t
+WindowsGpuCombinedVertexUniformComponents(int vertex_uniform_vectors);
+
+// WebGPU: the GPU-less default's adapter.info names, as Dawn gives them for
+// Iris Xe (0x9A49, Gen 12 LP).
+inline constexpr char kWindowsGpuWebgpuVendor[] = "intel";
+inline constexpr char kWindowsGpuWebgpuArchitecture[] = "gen-12-lp";
+
+// The subgroup sizes Chrome reports on Windows for an architecture, the
+// Direct3D 12 driver's wave lane counts; nullopt for one not listed.
+PLATFORM_EXPORT std::optional<std::array<uint32_t, 2>> WindowsGpuSubgroupRange(
+    std::string_view vendor,
+    std::string_view architecture);
+
+// The Direct3D 12 adapter features Chrome reports on Windows (measured),
+// as feature names.
+PLATFORM_EXPORT base::span<const std::string_view> WindowsGpuWebgpuFeatures();
+
+// Chrome's tiered adapter limits on Windows (measured).
+PLATFORM_EXPORT void ApplyWindowsGpuWebgpuLimits(
+    wgpu::Limits& limits,
+    wgpu::CompatibilityModeLimits& compat_limits);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_GPU_WINDOWS_GPU_PROFILE_H_
