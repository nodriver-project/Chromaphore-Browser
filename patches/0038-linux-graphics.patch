diff --git a/gpu/command_buffer/service/d3d11_shader_translation.cc b/gpu/command_buffer/service/d3d11_shader_translation.cc
new file mode 100644
index 0000000000..d02c3f6ff2
--- /dev/null
+++ b/gpu/command_buffer/service/d3d11_shader_translation.cc
@@ -0,0 +1,251 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "gpu/command_buffer/service/d3d11_shader_translation.h"
+
+#include <iterator>
+#include <map>
+#include <string_view>
+#include <tuple>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "ui/gfx/extension_set.h"
+#include "base/synchronization/lock.h"
+#include "components/browser/browser_switches.h"
+#include "third_party/angle/include/GLSLANG/ShaderLang.h"
+#include "ui/gl/gl_bindings.h"
+#include "ui/gl/gl_switches.h"
+
+namespace gpu::gles2 {
+
+namespace {
+
+// A D3D11 workaround of ANGLE's: on when --enable-angle-features names it,
+// off when --disable-angle-features does, otherwise as on |default_on|.
+bool NamedFeature(std::string_view name, bool default_on) {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  for (const auto& [list, value] :
+       {std::make_pair(::switches::kEnableANGLEFeatures, true),
+        std::make_pair(::switches::kDisableANGLEFeatures, false)}) {
+    for (const std::string& named :
+         base::SplitString(command_line.GetSwitchValueASCII(list), ",",
+                           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      if (named == name) {
+        return value;
+      }
+    }
+  }
+  return default_on;
+}
+
+// The vendor workarounds renderer11_utils.cpp turns on for D3D11 shaders:
+// NVIDIA's keep vertex constant register 0 free and read texture dimensions
+// without the base level; Intel's add texelFetch offsets beforehand.
+struct Workarounds {
+  bool skip_vs_constant_register_zero = false;
+  bool get_dimensions_ignores_base_level = false;
+  bool pre_add_texel_fetch_offsets = true;
+};
+
+const Workarounds& ClaimedWorkarounds() {
+  static const Workarounds workarounds{
+      NamedFeature("skipVSConstantRegisterZero", false),
+      NamedFeature("getDimensionsIgnoresBaseLevel", false),
+      NamedFeature("preAddTexelFetchOffsets", true)};
+  return workarounds;
+}
+
+// The limits ANGLE's D3D11 back end gives the translator at feature level
+// 11_1 (Compiler.cpp from renderer11_utils.cpp's caps), as WebGL contexts
+// have them; the Windows GPU profile reports the same to pages.
+ShBuiltInResources Direct3D11Resources(bool webgl2) {
+  ShBuiltInResources resources;
+  sh::InitBuiltInResources(&resources);
+  resources.MaxVertexAttribs = 16;
+  resources.MaxVertexUniformVectors =
+      ClaimedWorkarounds().skip_vs_constant_register_zero ? 4095 : 4096;
+  resources.MaxVaryingVectors = 30;
+  resources.MaxVertexTextureImageUnits = 16;
+  resources.MaxCombinedTextureImageUnits = 32;
+  resources.MaxTextureImageUnits = 16;
+  resources.MaxFragmentUniformVectors = 1024;
+  resources.MaxDrawBuffers = 8;
+  resources.MaxVertexOutputVectors = 30;
+  resources.MaxFragmentInputVectors = 30;
+  resources.MinProgramTexelOffset = -8;
+  resources.MaxProgramTexelOffset = 7;
+  resources.MaxFragmentUniformBlocks = 12;
+  resources.MaxVertexUniformBlocks = 12;
+  resources.MaxUniformBufferBindings = 24;
+  resources.MaxDualSourceDrawBuffers = 1;
+  resources.MaxSamples = 8;
+  resources.MinPointSize = 1;
+  resources.MaxPointSize = 1024;
+  resources.MaxViewsOVR = 4;
+  resources.MaxClipDistances = 8;
+  resources.MaxCullDistances = 8;
+  resources.MaxCombinedClipAndCullDistances = 8;
+  resources.HashFunction = nullptr;
+  return resources;
+}
+
+// The shader extensions the D3D11 back end supports (renderer11_utils.cpp
+// GenerateCaps) that a WebGL context of this version offers, each on once
+// the page has enabled it, as Windows defines their macros (measured). The
+// translator then applies each extension's own shader-version rules.
+struct ShaderExtension {
+  const char* name;
+  int ShBuiltInResources::* flag;
+  bool webgl1;
+  bool webgl2;
+  // On for every context of a version it serves, whatever the host lists.
+  bool always = false;
+};
+constexpr ShaderExtension kShaderExtensions[] = {
+    {"GL_OES_standard_derivatives",
+     &ShBuiltInResources::OES_standard_derivatives, true, false},
+    {"GL_EXT_shader_texture_lod", &ShBuiltInResources::EXT_shader_texture_lod,
+     true, false},
+    {"GL_EXT_frag_depth", &ShBuiltInResources::EXT_frag_depth, true, false},
+    {"GL_EXT_draw_buffers", &ShBuiltInResources::EXT_draw_buffers, true,
+     false},
+    {"GL_EXT_blend_func_extended",
+     &ShBuiltInResources::EXT_blend_func_extended, true, true},
+    {"GL_ANGLE_multi_draw", &ShBuiltInResources::ANGLE_multi_draw, true,
+     true},
+    {"GL_OVR_multiview2", &ShBuiltInResources::OVR_multiview2, false, true},
+    {"GL_ANGLE_clip_cull_distance",
+     &ShBuiltInResources::ANGLE_clip_cull_distance, false, true},
+    {"GL_NV_shader_noperspective_interpolation",
+     &ShBuiltInResources::NV_shader_noperspective_interpolation, false, true},
+    {"GL_EXT_conservative_depth", &ShBuiltInResources::EXT_conservative_depth,
+     false, true},
+    {"GL_OES_sample_variables", &ShBuiltInResources::OES_sample_variables,
+     false, true},
+    {"GL_OES_shader_multisample_interpolation",
+     &ShBuiltInResources::OES_shader_multisample_interpolation, false, true},
+    // Requested by Chrome's decoder for every context, so defined in every
+    // WebGL shader of a version they serve.
+    {"GL_OES_EGL_image_external", &ShBuiltInResources::OES_EGL_image_external,
+     true, true, /*always=*/true},
+    {"GL_OES_EGL_image_external_essl3",
+     &ShBuiltInResources::OES_EGL_image_external_essl3, false, true,
+     /*always=*/true},
+    // On with OVR_multiview2; the translator hides its macro in WebGL.
+    {"GL_OVR_multiview", &ShBuiltInResources::OVR_multiview, false, true},
+};
+
+static_assert(std::size(kShaderExtensions) <= 32);
+
+}  // namespace
+
+uint32_t ShaderExtensionBits(bool webgl2, const std::string& gl_extensions) {
+  const gfx::ExtensionSet enabled = gfx::MakeExtensionSet(gl_extensions);
+  uint32_t bits = 0;
+  for (size_t i = 0; i < std::size(kShaderExtensions); ++i) {
+    const ShaderExtension& extension = kShaderExtensions[i];
+    if ((webgl2 ? extension.webgl2 : extension.webgl1) &&
+        (extension.always || gfx::HasExtension(enabled, extension.name))) {
+      bits |= 1u << i;
+    }
+  }
+  return bits;
+}
+
+namespace {
+
+// libANGLE's Shader::compile() for a WebGL (hardened) context, then
+// ShaderD3D::compile() for D3D11 on Windows 10 or later.
+ShCompileOptions Direct3D11Options(uint32_t shader_type) {
+  const Workarounds& workarounds = ClaimedWorkarounds();
+  ShCompileOptions options = {};
+  options.objectCode = true;
+  options.emulateGLDrawID = true;
+  options.initGLPosition = true;
+  options.limitCallStackDepth = true;
+  options.limitExpressionComplexity = true;
+  options.initSharedVariables = true;
+  options.rejectWebglShadersWithLargeVariables = true;
+  options.rejectWebglShadersWithUndefinedBehavior = true;
+  options.expandFragmentOutputsToVec4 = true;
+  options.removeInactiveVariables = true;
+  options.clampIndirectArrayBounds = true;
+  options.expandSelectHLSLIntegerPowExpressions = true;
+  options.HLSLGetDimensionsIgnoresBaseLevel =
+      workarounds.get_dimensions_ignores_base_level;
+  options.rewriteTexelFetchOffsetToTexelFetch =
+      workarounds.pre_add_texel_fetch_offsets;
+  options.skipD3DConstantRegisterZero =
+      workarounds.skip_vs_constant_register_zero &&
+      shader_type == GL_VERTEX_SHADER;
+  options.allowTranslateUniformBlockToStructuredBuffer = true;
+  options.initializeBuiltinsForInstancedMultiview = true;
+  options.pls.type = ShPixelLocalStorageType::ImageLoadStore;
+  options.pls.fragmentSyncType =
+      ShFragmentSynchronizationType::RasterizerOrderViews_D3D;
+  options.pls.supportsNativeRGBA8ImageFormats = true;
+  options.validateAST = false;
+  return options;
+}
+
+}  // namespace
+
+bool PresentsWindowsShaderTranslation() {
+  static const bool presents =
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kUseChromiumDefaults);
+  return presents;
+}
+
+std::string TranslateAsDirect3D11(uint32_t shader_type,
+                                  bool webgl2,
+                                  const std::string& source,
+                                  uint32_t extension_bits) {
+  if (shader_type != GL_VERTEX_SHADER && shader_type != GL_FRAGMENT_SHADER) {
+    return std::string();
+  }
+  const uint32_t extensions = extension_bits;
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<
+      std::map<std::tuple<uint32_t, bool, uint32_t>, ShHandle>>
+      compilers;
+  base::AutoLock auto_lock(*lock);
+  static const bool initialized = sh::Initialize();
+  if (!initialized) {
+    return std::string();
+  }
+  ShHandle& compiler = (*compilers)[{shader_type, webgl2, extensions}];
+  if (!compiler) {
+    ShBuiltInResources resources = Direct3D11Resources(webgl2);
+    for (size_t i = 0; i < std::size(kShaderExtensions); ++i) {
+      resources.*kShaderExtensions[i].flag = (extensions >> i) & 1;
+    }
+    // WebGL 1 without WEBGL_draw_buffers has one draw buffer.
+    if (!webgl2 && !resources.EXT_draw_buffers) {
+      resources.MaxDrawBuffers = 1;
+    }
+    compiler = sh::ConstructCompiler(shader_type,
+                                     webgl2 ? SH_WEBGL2_SPEC : SH_WEBGL_SPEC,
+                                     SH_HLSL_4_1_OUTPUT, &resources);
+    if (!compiler) {
+      return std::string();
+    }
+  }
+  const char* strings[] = {source.c_str()};
+  if (!sh::Compile(compiler, strings, 1, Direct3D11Options(shader_type))) {
+    return std::string();
+  }
+  // ShaderD3D's debug info, as Shader::getTranslatedSourceWithDebugInfo()
+  // returns it.
+  return "// INITIAL HLSL BEGIN\n\n" + sh::GetObjectCode(compiler) +
+         "\n// INITIAL HLSL END\n\n\n" + "\n// " +
+         (shader_type == GL_VERTEX_SHADER ? "VERTEX" : "FRAGMENT") +
+         " SHADER END\n";
+}
+
+}  // namespace gpu::gles2
