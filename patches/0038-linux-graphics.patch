+++ b/gpu/command_buffer/service/d3d11_shader_translation.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef GPU_COMMAND_BUFFER_SERVICE_D3D11_SHADER_TRANSLATION_H_
+#define GPU_COMMAND_BUFFER_SERVICE_D3D11_SHADER_TRANSLATION_H_
+
+#include <stdint.h>
+
+#include <string>
+
+namespace gpu::gles2 {
+
+// browser: whether this GPU process serves a Linux build presenting Windows
+// (no --use-chromium-defaults).
+bool PresentsWindowsShaderTranslation();
+
+// browser: what Chrome on Windows returns from WEBGL_debug_shaders'
+// getTranslatedShaderSource() for a WebGL shader of |shader_type|
+// (GL_VERTEX_SHADER or GL_FRAGMENT_SHADER) and |source|: ANGLE's Direct3D 11
+// back end translates it to HLSL and returns that text between its debug
+// markers. Translated here by ANGLE's own HLSL translator with the options
+// and limits that back end uses at feature level 11_1, and the vendor
+// workarounds --enable-angle-features and --disable-angle-features name
+// (Intel's otherwise, the Windows GPU profile's default). Empty when it does
+// not compile. |extension_bits| are ShaderExtensionBits() when the shader
+// was compiled: ANGLE on Windows defines a shader extension's macro only
+// once the extension is enabled.
+std::string TranslateAsDirect3D11(uint32_t shader_type,
+                                  bool webgl2,
+                                  const std::string& source,
+                                  uint32_t extension_bits);
+
+// browser: which shader extensions of the D3D11 back end's a WebGL context
+// has enabled, from its GL_EXTENSIONS string, for TranslateAsDirect3D11().
+uint32_t ShaderExtensionBits(bool webgl2, const std::string& gl_extensions);
+
+}  // namespace gpu::gles2
+
+#endif  // GPU_COMMAND_BUFFER_SERVICE_D3D11_SHADER_TRANSLATION_H_
