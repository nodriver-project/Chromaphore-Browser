+#include "third_party/blink/renderer/core/timing/session_clock_offset.h"
 #include "third_party/blink/renderer/core/timing/time_clamper.h"
 #include "third_party/blink/renderer/platform/heap/garbage_collected.h"
 #include "third_party/blink/renderer/platform/heap/persistent.h"
@@ -132,6 +136,22 @@ base::TimeDelta GetUnixAtZeroMonotonic(const base::Clock* clock) {
   return unix_time_now - time_since_origin;
 }
 
+// browser: this browser session's offset to the monotonic clock
+// (switches::kTimerUptimeOffset), read once; none without the switch.
+base::TimeDelta TimerUptimeOffset() {
+  static const base::TimeDelta offset = [] {
+    int64_t microseconds = 0;
+    if (!base::StringToInt64(
+            base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                ::switches::kTimerUptimeOffset),
+            &microseconds)) {
+      microseconds = 0;
+    }
+    return base::Microseconds(microseconds);
+  }();
+  return offset;
+}
+
 void RecordLongTaskUkm(ExecutionContext* execution_context,
                        base::TimeDelta start_time,
                        base::TimeDelta duration) {
@@ -1324,6 +1344,10 @@ DOMHighResTimeStamp Performance::ClampTimeResolution(
       .InMillisecondsF();
 }
 
+base::TimeDelta SessionClockOffset() {
+  return TimerUptimeOffset();
+}
+
 // static
 DOMHighResTimeStamp Performance::MonotonicTimeToDOMHighResTimeStamp(
     base::TimeTicks time_origin,
@@ -1334,10 +1358,16 @@ DOMHighResTimeStamp Performance::MonotonicTimeToDOMHighResTimeStamp(
   if (monotonic_time.is_null() || time_origin.is_null())
     return 0.0;
 
+  // browser: both times are clamped as values of the monotonic clock, which
+  // counts from boot, and the rounding of their difference grows with the
+  // clock's size: pages would see the machine's uptime band, the same in
+  // every session until it reboots. They are clamped on this browser
+  // session's clock instead (TimerUptimeOffset()).
+  const base::TimeDelta offset = TimerUptimeOffset();
   DOMHighResTimeStamp clamped_time =
-      ClampTimeResolution(monotonic_time.since_origin(),
+      ClampTimeResolution(monotonic_time.since_origin() + offset,
                           cross_origin_isolated_capability) -
-      ClampTimeResolution(time_origin.since_origin(),
+      ClampTimeResolution(time_origin.since_origin() + offset,
                           cross_origin_isolated_capability);
   if (clamped_time < 0 && !allow_negative_value)
     return 0.0;
diff --git a/third_party/blink/renderer/core/timing/session_clock_offset.h b/third_party/blink/renderer/core/timing/session_clock_offset.h
new file mode 100644
index 0000000000..7b94176ad4
--- /dev/null
+++ b/third_party/blink/renderer/core/timing/session_clock_offset.h
@@ -0,0 +1,24 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_TIMING_SESSION_CLOCK_OFFSET_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_TIMING_SESSION_CLOCK_OFFSET_H_
+
+#include "base/time/time.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+// browser: this browser session's offset to the monotonic clock, which
+// counts from boot (switches::kTimerUptimeOffset): pages see an uptime of 2
+// to 30 days drawn when the session started, not the machine's. Zero without
+// the switch (--use-chromium-defaults). DOMHighResTimeStamps are clamped on
+// the clock plus it (Performance::MonotonicTimeToDOMHighResTimeStamp()); a
+// timestamp a page reads as time since boot, such as a media stream frame's,
+// adds it.
+CORE_EXPORT base::TimeDelta SessionClockOffset();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_TIMING_SESSION_CLOCK_OFFSET_H_
