 .../blink/renderer/core/timing/build.gni      |  1 +
 .../blink/renderer/core/timing/performance.cc | 34 +++++++++++++++++--
 .../core/timing/session_clock_offset.h        | 24 +++++++++++++
 .../frame_queue_underlying_source.cc          |  8 +++--
 ...ia_stream_audio_track_underlying_source.cc |  4 ++-
 ...edia_stream_video_track_underlying_sink.cc | 11 ++++--
 7 files changed, 100 insertions(+), 7 deletions(-)
 create mode 100644 third_party/blink/renderer/core/timing/session_clock_offset.h

diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
index 6551558d19..d342aa6cf1 100644
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -3803,6 +3803,23 @@ static void AppendCompositorCommandLineFlags(base::CommandLine* command_line) {
     command_line->AppendSwitch(switches::kEnableMainFrameBeforeActivation);
 }
 
+namespace {
+
+// browser: the uptime this browser session's pages see, 2 to 30 days when
+// it started, drawn once, as the offset renderers add to their monotonic
+// clock (switches::kTimerUptimeOffset).
+int64_t TimerUptimeOffsetMicroseconds() {
+  static const int64_t offset = [] {
+    const uint64_t spread = base::Days(28).InMicroseconds();
+    const base::TimeDelta uptime =
+        base::Days(2) + base::Microseconds(base::RandGenerator(spread));
+    return (uptime - base::TimeTicks::Now().since_origin()).InMicroseconds();
+  }();
+  return offset;
+}
+
+}  // namespace
+
 void RenderProcessHostImpl::AppendRendererCommandLine(
     base::CommandLine* command_line) {
   // Pass the process type first, so it shows first in process listings.
@@ -3841,6 +3858,14 @@ void RenderProcessHostImpl::AppendRendererCommandLine(
       *base::CommandLine::ForCurrentProcess();
   PropagateBrowserCommandLineToRenderer(browser_command_line, command_line);
 
+  // browser: the session's clock for DOMHighResTimeStamps (see above); none
+  // with --use-chromium-defaults.
+  if (!browser_command_line.HasSwitch(switches::kUseChromiumDefaults)) {
+    command_line->AppendSwitchASCII(
+        switches::kTimerUptimeOffset,
+        base::NumberToString(TimerUptimeOffsetMicroseconds()));
+  }
+
   // Pass on the browser locale.
   const std::string locale =
       GetContentClient()->browser()->GetApplicationLocale();
