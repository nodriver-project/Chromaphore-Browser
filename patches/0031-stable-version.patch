+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_STABLE_VERSION_STABLE_VERSION_H_
+#define CHROME_BROWSER_STABLE_VERSION_STABLE_VERSION_H_
+
+#include "base/memory/scoped_refptr.h"
+
+namespace base {
+class CommandLine;
+}  // namespace base
+
+namespace network {
+class SharedURLLoaderFactory;
+}  // namespace network
+
+// The full version the browser reports (the user agent's client hints) is the
+// Chrome release of this major version that the stable channel serves now,
+// not the release this build was cut from, which a week of rollouts leaves
+// behind. The list of served releases is fetched at most once a day and kept
+// beside the default user data directory for every profile on the machine.
+// The request goes through the system network context: a --proxy-server on
+// the command line carries it, a proxy set by an extension or a profile
+// does not. It is made whatever --disable-background-networking says (the
+// browser's own defaults set that switch); --use-chromium-defaults or an
+// explicit brand version is what turns it off.
+namespace stable_version {
+
+// Browser process, before anything reads the user agent. Unless a brand
+// version is given outright or --use-chromium-defaults asks for stock
+// Chromium, appends --fingerprint-brand-version-long with a served release of
+// this major version: drawn for the profile by the releases' rollout shares,
+// and never older than the one the profile reported before. Does nothing
+// until a list has been fetched.
+void ApplyServedVersion(base::CommandLine& command_line);
+
+// Browser process, after startup. Fetches the list of served releases in the
+// background when the kept one is missing or more than a day old.
+void RefreshServedReleasesIfStale(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory);
+
+}  // namespace stable_version
+
+#endif  // CHROME_BROWSER_STABLE_VERSION_STABLE_VERSION_H_
