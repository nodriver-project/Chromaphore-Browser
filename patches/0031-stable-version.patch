@@ -0,0 +1,307 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/stable_version/stable_version.h"
+
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/hash/hash.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "base/version.h"
+#include "base/version_info/version_info.h"
+#include "chrome/common/chrome_paths_internal.h"
+#include "chrome/common/chrome_switches.h"
+#include "components/browser/browser_switches.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+namespace stable_version {
+
+namespace {
+
+// Chrome's public release history: every Windows 64-bit stable release that
+// is served now, with the share of installs each is rolled out to.
+constexpr char kReleasesUrl[] =
+    "https://versionhistory.googleapis.com/v1/chrome/platforms/win64/"
+    "channels/stable/versions/all/releases?filter=endtime=none";
+
+// The machine-wide list, beside the default user data directory, and the
+// version a profile last reported, in its own user data directory.
+constexpr base::FilePath::CharType kReleasesFileName[] =
+    FILE_PATH_LITERAL("Served Chrome Releases");
+constexpr base::FilePath::CharType kReportedFileName[] =
+    FILE_PATH_LITERAL("Reported Chrome Version");
+
+constexpr base::TimeDelta kRefreshAfter = base::Days(1);
+constexpr size_t kMaxListBytes = 256 * 1024;
+constexpr size_t kMaxReportedBytes = 64;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("served_chrome_releases", R"(
+        semantics {
+          sender: "Served Chrome Releases"
+          description:
+            "Fetches the list of Chrome releases the stable channel serves "
+            "now, so that the full version the browser reports is a current "
+            "one of its own major version."
+          trigger: "Browser startup, at most once a day."
+          data: "None."
+          destination: GOOGLE_OWNED_SERVICE
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Not made with --use-chromium-defaults."
+          policy_exception_justification: "Not implemented."
+        })");
+
+struct Release {
+  base::Version version;
+  double share = 0;
+};
+
+std::optional<base::FilePath> ReleasesFilePath() {
+  base::FilePath user_data_dir;
+  if (!chrome::GetDefaultUserDataDirectory(&user_data_dir)) {
+    return std::nullopt;
+  }
+  return user_data_dir.DirName().Append(kReleasesFileName);
+}
+
+// A full version of this build's major version, in four components.
+bool IsOfThisMajor(const base::Version& version) {
+  return version.IsValid() && version.components().size() == 4 &&
+         version.components()[0] ==
+             static_cast<uint32_t>(version_info::GetMajorVersionNumberAsInt());
+}
+
+// The served releases of this major version in the release history's answer,
+// or in the kept list, which has the same shape. The shares are those of the
+// installs already on this major version (the group named after it); while a
+// major version is new and has no such group, those of any group.
+std::vector<Release> ReleasesOfThisMajor(const base::DictValue& answer) {
+  const base::ListValue* releases = answer.FindList("releases");
+  if (!releases) {
+    return {};
+  }
+  const std::string own_group = version_info::GetMajorVersionNumber();
+  std::vector<Release> in_own_group;
+  std::vector<Release> in_any_group;
+  for (const base::Value& entry : *releases) {
+    const base::DictValue* release = entry.GetIfDict();
+    if (!release) {
+      continue;
+    }
+    const std::string* version = release->FindString("version");
+    const std::optional<double> share = release->FindDouble("fraction");
+    if (!version || !share || *share <= 0) {
+      continue;
+    }
+    Release parsed{base::Version(*version), *share};
+    if (!IsOfThisMajor(parsed.version)) {
+      continue;
+    }
+    const std::string* group = release->FindString("fractionGroup");
+    if (group && *group == own_group) {
+      in_own_group.push_back(parsed);
+    }
+    in_any_group.push_back(std::move(parsed));
+  }
+  return in_own_group.empty() ? in_any_group : in_own_group;
+}
+
+// The release a profile reports: drawn by the rollout shares from a number its
+// directory gives, so a profile keeps its release while the list stays the
+// same, and never older than the one it reported before, since an installed
+// browser does not go back.
+std::optional<base::Version> PickForProfile(
+    const std::vector<Release>& releases,
+    const base::FilePath& user_data_dir,
+    const std::optional<base::Version>& reported_before) {
+  double total = 0;
+  for (const Release& release : releases) {
+    total += release.share;
+  }
+  if (total <= 0) {
+    return reported_before;
+  }
+  const double position =
+      base::PersistentHash(user_data_dir.AsUTF8Unsafe()) /
+      (static_cast<double>(std::numeric_limits<uint32_t>::max()) + 1.0) * total;
+  const base::Version* picked = &releases.back().version;
+  double reached = 0;
+  for (const Release& release : releases) {
+    reached += release.share;
+    if (position < reached) {
+      picked = &release.version;
+      break;
+    }
+  }
+  if (reported_before && *reported_before > *picked) {
+    return reported_before;
+  }
+  return *picked;
+}
+
+// Missing, more than a day old, or dated in the future (a clock set back),
+// which would otherwise never age.
+bool IsStale(const base::FilePath& path) {
+  base::File::Info info;
+  if (!base::GetFileInfo(path, &info)) {
+    return true;
+  }
+  const base::TimeDelta age = base::Time::Now() - info.last_modified;
+  return age > kRefreshAfter || age.is_negative();
+}
+
+void WriteReleases(const base::FilePath& path, const std::string& json) {
+  if (base::CreateDirectory(path.DirName())) {
+    base::ImportantFileWriter::WriteFileAtomically(path, json);
+  }
+}
+
+void OnReleasesFetched(std::unique_ptr<network::SimpleURLLoader> loader,
+                       const base::FilePath& path,
+                       std::optional<std::string> body) {
+  if (!body) {
+    return;
+  }
+  const std::optional<base::DictValue> answer =
+      base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC);
+  if (!answer) {
+    return;
+  }
+  const std::vector<Release> releases = ReleasesOfThisMajor(*answer);
+  if (releases.empty()) {
+    // An answer with nothing usable leaves the kept list as it is.
+    return;
+  }
+  // Kept in the answer's own shape, this major version's releases only.
+  base::ListValue kept;
+  for (const Release& release : releases) {
+    base::DictValue entry;
+    entry.Set("version", release.version.GetString());
+    entry.Set("fraction", release.share);
+    entry.Set("fractionGroup", version_info::GetMajorVersionNumber());
+    kept.Append(std::move(entry));
+  }
+  base::DictValue list;
+  list.Set("releases", std::move(kept));
+  const std::optional<std::string> json = base::WriteJson(list);
+  if (!json) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&WriteReleases, path, *json));
+}
+
+void FetchIfStale(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+    const base::FilePath& path,
+    bool stale) {
+  if (!stale) {
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(kReleasesUrl);
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  network::SimpleURLLoader* loader_ptr = loader.get();
+  loader_ptr->DownloadToString(
+      url_loader_factory.get(),
+      base::BindOnce(&OnReleasesFetched, std::move(loader), path),
+      kMaxListBytes);
+}
+
+}  // namespace
+
+void ApplyServedVersion(base::CommandLine& command_line) {
+  if (command_line.HasSwitch(switches::kUseChromiumDefaults) ||
+      command_line.HasSwitch(switches::kFingerprintBrandVersion) ||
+      command_line.HasSwitch(switches::kFingerprintBrandVersionLong)) {
+    return;
+  }
+  const std::optional<base::FilePath> releases_path = ReleasesFilePath();
+  std::string releases_json;
+  if (!releases_path || !base::ReadFileToStringWithMaxSize(
+                            *releases_path, &releases_json, kMaxListBytes)) {
+    return;
+  }
+  const std::optional<base::DictValue> releases =
+      base::JSONReader::ReadDict(releases_json, base::JSON_PARSE_RFC);
+  if (!releases) {
+    return;
+  }
+
+  base::FilePath user_data_dir =
+      command_line.GetSwitchValuePath(switches::kUserDataDir);
+  if (user_data_dir.empty() &&
+      !chrome::GetDefaultUserDataDirectory(&user_data_dir)) {
+    return;
+  }
+  const base::FilePath reported_path = user_data_dir.Append(kReportedFileName);
+  std::string reported;
+  std::optional<base::Version> reported_before;
+  if (base::ReadFileToStringWithMaxSize(reported_path, &reported,
+                                        kMaxReportedBytes)) {
+    base::Version before(base::TrimWhitespaceASCII(reported, base::TRIM_ALL));
+    if (IsOfThisMajor(before)) {
+      reported_before = std::move(before);
+    }
+  }
+
+  const std::optional<base::Version> version = PickForProfile(
+      ReleasesOfThisMajor(*releases), user_data_dir, reported_before);
+  if (!version) {
+    return;
+  }
+  const std::string text = version->GetString();
+  if (!reported_before || text != reported_before->GetString()) {
+    // The profile remembers it, so a later list never takes it back.
+    if (base::CreateDirectory(user_data_dir)) {
+      base::WriteFile(reported_path, text);
+    }
+  }
+  command_line.AppendSwitchASCII(switches::kFingerprintBrandVersionLong, text);
+}
+
+void RefreshServedReleasesIfStale(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory) {
+  if (!url_loader_factory || base::CommandLine::ForCurrentProcess()->HasSwitch(
+                                 switches::kUseChromiumDefaults)) {
+    return;
+  }
+  const std::optional<base::FilePath> path = ReleasesFilePath();
+  if (!path) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&IsStale, *path),
+      base::BindOnce(&FetchIfStale, std::move(url_loader_factory), *path));
+}
+
+}  // namespace stable_version
