+}  // namespace
+
+// browser: Page.captureAgentSnapshot. Validates, enumerates the page's local
+// roots and fans out the per-frame Mojo calls; the reply is assembled in
+// FinishAgentSnapshot once every frame, the occlusion hit-tests and the
+// screenshot have completed.
+void PageHandler::CaptureAgentSnapshot(
+    std::optional<std::string> format,
+    std::optional<int> quality,
+    std::optional<std::string> offscreen_mode,
+    std::optional<bool> include_screenshot,
+    std::optional<int> screenshot_max_pixels,
+    std::optional<std::string> scope,
+    std::optional<std::string> since,
+    std::optional<bool> hold_for_secrets,
+    std::optional<bool> marks,
+    std::unique_ptr<Page::Viewport> clip,
+    std::unique_ptr<CaptureAgentSnapshotCallback> callback) {
+  if (!host_ || !host_->GetRenderWidgetHost() ||
+      !host_->GetRenderWidgetHost()->GetView()) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  if (!CanExecuteGlobalCommands(this, callback)) {
+    return;
+  }
+
+  auto encoder =
+      GetEncoder(format.value_or(Page::CaptureScreenshot::FormatEnum::Png),
+                 quality.value_or(kDefaultScreenshotQuality),
+                 /*optimize_for_speed=*/false);
+  if (std::holds_alternative<Response>(encoder)) {
+    callback->sendFailure(std::get<Response>(encoder));
+    return;
+  }
+
+  // A negative area is the caller's mistake. One past 64 MP means nothing
+  // and is clamped below.
+  if (screenshot_max_pixels && *screenshot_max_pixels < 0) {
+    callback->sendFailure(
+        Response::InvalidParams("screenshotMaxPixels must not be negative"));
+    return;
+  }
+
+  // browser: a clip with no area is the caller's mistake.
+  if (clip && !(clip->GetWidth() > 0 && clip->GetHeight() > 0)) {
+    callback->sendFailure(
+        Response::InvalidParams("clip needs a positive width and height"));
+    return;
+  }
+
+  auto request = base::MakeRefCounted<AgentSnapshotRequest>();
+  request->callback = std::move(callback);
+  request->encoder = std::get<BitmapEncoder>(encoder);
+  request->include_screenshot = include_screenshot.value_or(true);
+  request->hold_for_secrets = hold_for_secrets.value_or(false);
+  request->draw_marks = marks.value_or(true);
+  if (clip) {
+    request->clip = gfx::RectF(clip->GetX(), clip->GetY(), clip->GetWidth(),
+                               clip->GetHeight());
+  }
+  request->offscreen_mode = AgentOffscreenModeFromString(offscreen_mode);
+  // The layers open on the page (scope on or all; off by default).
+  if (scope == Page::CaptureAgentSnapshot::ScopeEnum::On) {
+    request->layer_scope = blink::mojom::AgentLayerScope::kOn;
+  } else if (scope == Page::CaptureAgentSnapshot::ScopeEnum::All) {
+    request->layer_scope = blink::mojom::AgentLayerScope::kAll;
+  }
+  if (screenshot_max_pixels) {
+    request->screenshot_max_pixels =
+        std::min<int64_t>(*screenshot_max_pixels, int64_t{64'000'000});
+  }
+  request->since = std::move(since);
+
+  // browser: the capture's document is fixed now -- the frame's current
+  // host -- and checked again once the frames have answered
+  // (FinishAgentSnapshot). Between ready-to-commit and the commit `host_` is
+  // already the speculative host, whose view, covers and screenshot are not
+  // the shown document's: the capture fails at once then. The id space is not
+  // held across the wait: a commit in the same host deletes it.
+  RenderFrameHostImpl* root = host_->frame_tree_node()->current_frame_host();
+  if (root != host_) {
+    request->callback->sendFailure(
+        Response::ServerError("the page changed document during the capture"));
+    return;
+  }
+  request->root_id = root->GetGlobalId();
+  request->root_document = root->GetDocumentToken();
+  // browser: a hidden page comes to the front, and a frozen one fails,
+  // once the call is accepted and before anything is asked of the page.
+  if (Response front = BringAgentPageForward(&request->brought_forward);
+      front.IsError()) {
+    request->callback->sendFailure(front);
+    return;
+  }
+  AgentIdSpace* space = AgentIdSpace::GetOrCreate(root);
+
+  // Every live local root (main frame and each OOPIF root). Same-process
+  // subframes are skipped: the renderer walks a local root's same-process
+  // descendants inside one CollectFrameElements() call and returns their
+  // boxes already in the local root's space. Calling them here too would
+  // count their elements twice and, because such a subframe shares its local
+  // root's widget view, TransformPointToRootCoordSpaceF would drop its
+  // in-root offset.
+  // browser: and active, as LiveLocalRoots takes them for the settle too:
+  // a frame leaving the page (pending deletion) is not shown.
+  for (RenderFrameHostImpl* rfh : LiveLocalRoots(root)) {
+    AgentSnapshotRequest::FrameEntry entry;
+    entry.rfh = rfh->GetWeakPtr();
+    entry.id = rfh->GetGlobalId();
+    entry.frame_id = rfh->GetDevToolsFrameToken().ToString();
+    request->frames.push_back(std::move(entry));
+  }
+  // browser: input that can move the drawing, watched from now until the
+  // screenshot's holds are released.
+  if (request->include_screenshot) {
+    request->input_watch = std::make_unique<AgentCopyInputWatch>();
+    for (const AgentSnapshotRequest::FrameEntry& entry : request->frames) {
+      if (RenderFrameHostImpl* rfh = entry.rfh.get()) {
+        request->input_watch->Watch(rfh->GetRenderWidgetHost());
+      }
+    }
+  }
+
+  if (request->frames.empty()) {
+    OnAllAgentFramesCollected(request);
+    return;
+  }
+
+  // Proceeds once every frame has replied or dropped its pipe.
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      request->frames.size(),
+      base::BindOnce(&PageHandler::OnAllAgentFramesCollected,
+                     weak_factory_.GetWeakPtr(), request));
+
+  request->collectors.reserve(request->frames.size());
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    RenderFrameHostImpl* rfh = request->frames[i].rfh.get();
+    service_manager::InterfaceProvider* remotes =
+        rfh ? rfh->GetRemoteInterfaces() : nullptr;
+    if (!remotes) {
+      // The frame went away between enumeration and dispatch.
+      request->frames[i].answered = true;
+      barrier.Run();
+      continue;
+    }
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+    remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+    auto options = blink::mojom::AgentSnapshotOptions::New();
+    options->offscreen_mode = request->offscreen_mode;
+    options->layer_scope = request->layer_scope;
+    // browser: the ids the space holds here, each one told back.
+    options->known_node_ids = space->KnownNodeIds(request->frames[i].id);
+    // A dropped pipe still advances the barrier, with a null snapshot.
+    collector->CollectFrameElements(
+        std::move(options),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&PageHandler::OnAgentFrameElementsCollected,
+                           weak_factory_.GetWeakPtr(), request, i, barrier),
+            nullptr));
+    request->frames[i].collector = static_cast<int>(request->collectors.size());
+    request->collectors.push_back(std::move(collector));
+  }
+  // browser: a renderer that neither answers nor drops its pipe does
+  // not hold the capture past kAgentCollectWait.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PageHandler::OnAgentCollectDeadline, request, barrier),
+      kAgentCollectWait);
+}
+
+void PageHandler::OnAgentFrameElementsCollected(
+    scoped_refptr<AgentSnapshotRequest> request,
+    size_t frame_index,
+    base::RepeatingClosure barrier,
+    blink::mojom::AgentFrameSnapshotPtr result) {
+  // browser: a frame given up on keeps no late answer.
+  if (frame_index >= request->frames.size() ||
+      request->frames[frame_index].answered) {
+    return;
+  }
+  request->frames[frame_index].answered = true;
+  request->frames[frame_index].snapshot = std::move(result);
+  barrier.Run();
+}
+
+// browser: every frame still out at kAgentCollectWait is given up:
+// answered as one that gave nothing -- its snapshot null, as for a dropped
+// pipe -- and its collector dropped, so no later phase calls into a renderer
+// that may still be stuck, and its pending answer (dropped as it is dropped:
+// the frame is answered) no longer holds the capture. All are marked first,
+// then the barrier runs once for each. Static, bound without the handler: a
+// stuck renderer's collector is let go even when the handler is gone (the
+// barrier's own end is weak, so nothing else runs then).
+// static
+void PageHandler::OnAgentCollectDeadline(
+    scoped_refptr<AgentSnapshotRequest> request,
+    base::RepeatingClosure barrier) {
+  size_t given_up = 0;
+  for (AgentSnapshotRequest::FrameEntry& frame : request->frames) {
+    if (frame.answered) {
+      continue;
+    }
+    frame.answered = true;
+    frame.given_up = true;
+    ++given_up;
+    if (frame.collector >= 0 &&
+        static_cast<size_t>(frame.collector) < request->collectors.size()) {
+      request->collectors[frame.collector].reset();
+    }
+  }
+  for (size_t i = 0; i < given_up; ++i) {
+    barrier.Run();
+  }
+}
+
+// Composes every frame's local boxes into root-viewport CSS px, then starts
+// the occlusion hit-tests and the screenshot in parallel.
+void PageHandler::OnAllAgentFramesCollected(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  if (!host_ || !host_->GetRenderWidgetHost() ||
+      !host_->GetRenderWidgetHost()->GetView()) {
+    if (request->callback) {
+      request->callback->sendFailure(Response::InternalError());
+    }
+    request->ReleaseHeavyParts();
+    return;
+  }
+  // browser: `host_` must still be the capture's host, its frame's
+  // current one: after a ready-to-commit meanwhile it is the speculative host,
+  // and the view, the cover tests and the screenshot would not be the shown
+  // document's.
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(request->root_id);
+  if (!root || root != host_ ||
+      root->frame_tree_node()->current_frame_host() != root) {
+    if (request->callback) {
+      request->callback->sendFailure(Response::ServerError(
+          "the page changed document during the capture"));
+    }
+    request->ReleaseHeavyParts();
+    return;
+  }
+  // browser: the page's own frame given up: a listing of
+  // the other frames alone would read as a blank page.
+  for (const AgentSnapshotRequest::FrameEntry& frame : request->frames) {
+    if (frame.id == request->root_id && frame.given_up) {
+      if (request->callback) {
+        request->callback->sendFailure(
+            Response::ServerError(kAgentCollectGaveUp));
+      }
+      request->ReleaseHeavyParts();
+      return;
+    }
+  }
+
+  RenderWidgetHostImpl* widget_host = host_->GetRenderWidgetHost();
+  auto* root_view = static_cast<RenderWidgetHostViewBase*>(host_->GetView());
+
+  // GetVisibleViewportSize() is in DIP, which is CSS px at pinch scale 1.
+  const cc::RenderFrameMetadata& metadata =
+      widget_host->render_frame_metadata_provider()->LastRenderFrameMetadata();
+  double dsf = metadata.device_scale_factor > 0
+                   ? metadata.device_scale_factor
+                   : root_view->GetDeviceScaleFactor();
+  if (dsf <= 0) {
+    dsf = 1;
+  }
+  gfx::Size visible = root_view->GetVisibleViewportSize();
+  request->device_scale_factor = dsf;
+  request->vp_width = visible.width();
+  request->vp_height = visible.height();
+  // browser: the page's scroll as its document says it (window.scrollX
+  // and scrollY, CSS px), from the root's own snapshot: the metadata's
+  // root_scroll_offset is filled only for a client that asked cc for
+  // root-scroll-offset updates, and is absent or stale otherwise. It stays
+  // the fallback when the root did not answer.
+  const AgentSnapshotRequest::FrameEntry* root_entry = nullptr;
+  for (const AgentSnapshotRequest::FrameEntry& entry : request->frames) {
+    if (entry.id == request->root_id && entry.snapshot) {
+      root_entry = &entry;
+      break;
+    }
+  }
+  if (root_entry) {
+    request->scroll_x = root_entry->snapshot->scroll_x;
+    request->scroll_y = root_entry->snapshot->scroll_y;
+  } else if (metadata.root_scroll_offset) {
+    // Physical px to CSS px, as BuildScreencastFrameMetadata does.
+    request->scroll_x = metadata.root_scroll_offset->x() / dsf;
+    request->scroll_y = metadata.root_scroll_offset->y() / dsf;
+  }
+  // browser: the scrollable content size is the root document's (its
+  // layout viewport's contents, CSS px), which stands in for
+  // blink::mojom::LocalMainFrame::GetFullPageSize; without the root's
+  // snapshot, a lower bound from the viewport and scroll offset.
+  if (root_entry) {
+    request->scroll_width = std::max<double>(
+        request->vp_width, root_entry->snapshot->content_width);
+    request->scroll_height = std::max<double>(
+        request->vp_height, root_entry->snapshot->content_height);
+  } else {
+    request->scroll_width = std::max<double>(
+        request->vp_width, request->scroll_x + request->vp_width);
+    request->scroll_height = std::max<double>(
+        request->vp_height, request->scroll_y + request->vp_height);
+  }
+
+  const gfx::RectF root_viewport_rect(0, 0, request->vp_width,
+                                      request->vp_height);
+
+  // Each frame's view as it is now, and the part of the page's view it shows.
+  // For a frame in another process that is the browser's record of what the
+  // page shows of it -- clipped by every frame and scroller around it and by
+  // the viewport, in the frame's physical px, as the parent last sent it --
+  // mapped to the page.
+  for (AgentSnapshotRequest::FrameEntry& entry : request->frames) {
+    RenderFrameHostImpl* rfh = entry.rfh.get();
+    RenderWidgetHostViewBase* view =
+        rfh && rfh->IsRenderFrameLive() ? rfh->GetView() : nullptr;
+    entry.view = view ? view->GetWeakPtr() : nullptr;
+    entry.shown = root_viewport_rect;
+    if (entry.view) {
+      entry.shown = ShownPartInRoot(*rfh);
+      entry.shown.Intersect(root_viewport_rect);
+      // By the frames' rects only when its parent local root shows nothing
+      // too: a frame directly in the page, only below its fold, has its
+      // compositor transform, CSS transforms on its frame element included.
+      if (entry.shown.IsEmpty() && !rfh->is_main_frame()) {
+        RenderFrameHostImpl* parent = rfh->GetParent();
+        while (parent && !parent->is_local_root()) {
+          parent = parent->GetParent();
+        }
+        if (parent && !parent->is_main_frame() &&
+            ShownPartInRoot(*parent).IsEmpty()) {
+          // Its parent local root shows nothing too.
+          entry.by_rects = OffsetByRects(*rfh, nullptr);
+        }
+      }
+    }
+  }
+
+  // browser: past kAgentMaxInteractive interactive elements, in the
+  // listing's order, the rest are cut here: no hit test, mark or id.
+  int interactive = 0;
+  for (auto& frame : request->frames) {
+    if (!frame.snapshot || !frame.view) {
+      continue;
+    }
+    RenderWidgetHostViewBase* frame_view = frame.view.get();
+    const GlobalRenderFrameHostId frame_rfh_id =
+        frame.rfh ? frame.rfh->GetGlobalId() : GlobalRenderFrameHostId();
+    for (const auto& el : frame.snapshot->elements) {
+      if (el->interactive && ++interactive > kAgentMaxInteractive) {
+        ++request->elements_cut;
+        continue;
+      }
+      AgentSnapshotRequest::ComposedElement ce;
+      ce.backend_node_id = el->backend_node_id;
+      ce.local_root_rfh_id = frame_rfh_id;
+      ce.frame_id = frame.frame_id;
+      ce.role = el->role;
+      ce.shut_out = el->shut_out;
+      if (!el->name.empty()) {
+        ce.name = el->name;
+      }
+      if (!el->value.empty()) {
+        ce.value = el->value;
+      }
+      if (!el->description.empty()) {
+        ce.description = el->description;
+      }
+      ce.tag = el->tag;
+      ce.interactive = el->interactive;
+      if (!el->interactive_reason.empty()) {
+        ce.interactive_reason = el->interactive_reason;
+      }
+      ce.states = el->states;
+      if (el->validity) {
+        ce.invalid = InvalidReasonNames(el->validity->reasons);
+        if (el->validity->error && !el->validity->error->empty()) {
+          ce.error = *el->validity->error;
+        }
+      }
+      ce.reads = el->reads;
+      if (el->shadow_host_backend_node_id != 0) {
+        ce.shadow_host_backend_node_id = el->shadow_host_backend_node_id;
+      }
+      if (!el->href.empty()) {
+        ce.href = el->href;
+      }
+      if (!el->src.empty()) {
+        ce.src = el->src;
+      }
+      ce.element_view = frame.view;
+      if (el->child_frame_id) {
+        ce.child_frame_token = *el->child_frame_id;
+        for (size_t k = 0; k < request->frames.size(); ++k) {
+          if (request->frames[k].frame_id == *el->child_frame_id) {
+            ce.child_frame = static_cast<int>(k);
+          }
+        }
+        // What a frame in another process shows now, not its src.
+        if (ce.child_frame >= 0) {
+          RenderFrameHostImpl* shown_rfh =
+              request->frames[ce.child_frame].rfh.get();
+          if (shown_rfh &&
+              shown_rfh->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+            ce.src = shown_rfh->GetLastCommittedURL().spec();
+          }
+        }
+      }
+
+      // The renderer already expressed same-process subframe elements in
+      // their local root's space, so `frame` is always a local root: the
+      // main frame's transform is the identity, and an OOPIF root's
+      // child-frame view maps to the true root, corner by corner. Local CSS
+      // px equal DIP at page and pinch scale 1.
+      // TODO: divide by the page/pinch scale for zoomed pages.
+      const blink::mojom::AgentElementBox& box = *el->box;
+      gfx::RectF root_box = RootBoxOf(
+          *frame_view, gfx::RectF(box.x, box.y, box.width, box.height));
+      // A frame the page shows nothing of may have no place in the
+      // compositor's hit-test data (inside a frame scrolled off the page), and
+      // its transform then comes back wrong: placed by the frames'
+      // rects in their parents instead.
+      if (frame.by_rects) {
+        root_box =
+            gfx::RectF(box.x, box.y, box.width, box.height) + *frame.by_rects;
+      }
+      ce.x = root_box.x();
+      ce.y = root_box.y();
+      ce.width = root_box.width();
+      ce.height = root_box.height();
+
+      // In view where the page shows some of it -- within the part of its
+      // frame the page shows, and within its frame's own view -- and tested
+      // there: a frame's element below the frame's fold was
+      // hit-tested outside the frame and dropped as covered.
+      ce.shown = root_box;
+      ce.shown.Intersect(frame.shown);
+      // A frame element in view only where what shows of its own frame does:
+      // the page's scrollers around it clip that, and the page's view alone
+      // does not.
+      if (ce.child_frame >= 0) {
+        ce.shown.Intersect(request->frames[ce.child_frame].shown);
+      }
+      ce.in_viewport = el->in_frame_viewport && !ce.shown.IsEmpty();
+      ce.frame_index = static_cast<size_t>(&frame - request->frames.data());
+      ce.action_point_root =
+          ce.in_viewport ? ce.shown.CenterPoint() : root_box.CenterPoint();
+      if (el->under) {
+        ce.under = *el->under;
+      }
+      // browser.
+      ce.reach_told = el->reach_told;
+      ce.layer = el->layer;
+      ce.hidden = el->hidden;
+      ce.hidden_layer = el->hidden_layer;
+      // browser.
+      ce.under_layer = el->under_layer;
+      if (el->hidden_behind) {
+        ce.hidden_behind = *el->hidden_behind;
+      }
+
+      request->composed.push_back(std::move(ce));
+    }
+  }
+
+  // browser: a blank page has nothing to show: no screenshot, and the
+  // reply says why. Every frame has answered by now.
+  if (request->include_screenshot && root_entry &&
+      root_entry->snapshot->document_blank) {
+    request->include_screenshot = false;
+    request->withheld =
+        Page::CaptureAgentSnapshot::ScreenshotWithheldEnum::Blank;
+    request->input_watch.reset();
+  }
+
+  const int outstanding = request->include_screenshot ? 2 : 1;
+  request->finish_barrier = base::BarrierClosure(
+      outstanding, base::BindOnce(&PageHandler::FinishAgentSnapshot,
+                                  weak_factory_.GetWeakPtr(), request));
+
+  StartAgentSnapshotOcclusion(request);
+  if (request->include_screenshot) {
+    StartAgentSnapshotScreenshot(request);
+  }
+}
+
+// Cross-context occlusion. Only interactive in-viewport elements are
+// hit-tested; everything else keeps obscured=false.
+void PageHandler::StartAgentSnapshotOcclusion(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  std::vector<size_t> to_test;
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    const auto& ce = request->composed[i];
+    if (ce.interactive && ce.in_viewport) {
+      to_test.push_back(i);
+    }
+  }
+
+  RenderWidgetHostDelegate* delegate =
+      host_ && host_->GetRenderWidgetHost()
+          ? host_->GetRenderWidgetHost()->delegate()
+          : nullptr;
+  auto* root_view =
+      host_ ? static_cast<RenderWidgetHostViewBase*>(host_->GetView())
+            : nullptr;
+  if (to_test.empty() || !delegate || !delegate->GetInputEventRouter() ||
+      !root_view) {
+    // browser: a cover test that could not run answered nothing.
+    for (size_t index : to_test) {
+      request->composed[index].hit_answered = false;
+    }
+    request->finish_barrier.Run();
+    return;
+  }
+
+  // TODO: one async hit-test per element; a synchronous viz::HitTestQuery
+  // off the root HostFrameSinkManager could replace them.
+  base::RepeatingClosure occlusion_barrier = base::BarrierClosure(
+      to_test.size(), base::BindOnce(&PageHandler::DescribeAgentCovers,
+                                     weak_factory_.GetWeakPtr(), request));
+  for (size_t index : to_test) {
+    delegate->GetRenderWidgetHostAtPointAsynchronously(
+        root_view, request->composed[index].action_point_root,
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&PageHandler::OnAgentElementOcclusionResolved,
+                           weak_factory_.GetWeakPtr(), request, index,
+                           occlusion_barrier),
+            base::WeakPtr<RenderWidgetHostViewBase>(),
+            std::optional<gfx::PointF>()));
+  }
+}
+
+void PageHandler::OnAgentElementOcclusionResolved(
+    scoped_refptr<AgentSnapshotRequest> request,
+    size_t element_index,
+    base::RepeatingClosure barrier,
+    base::WeakPtr<RenderWidgetHostViewBase> target_view,
+    std::optional<gfx::PointF> transformed_point) {
+  if (element_index < request->composed.size()) {
+    auto& ce = request->composed[element_index];
+    // browser: a test with no answer leaves a move back into reach
+    // untold in a delta.
+    ce.hit_answered = target_view && transformed_point.has_value();
+    // A failed hit-test leaves obscured=false. A topmost view other than the
+    // element's own means cross-context content covers it.
+    if (target_view && transformed_point.has_value()) {
+      ce.obscured = target_view.get() != ce.element_view.get();
+      // A frame element whose frame is in another process is reached by a
+      // hit in that frame's view, or in one inside it: a press there goes to
+      // what it holds, and nothing of the page lies over it.
+      // Its frame's view gone (a crashed renderer): the rule for the rest.
+      RenderWidgetHostViewBase* own =
+          ce.child_frame >= 0 ? request->frames[ce.child_frame].view.get()
+                              : nullptr;
+      if (own) {
+        // A hit in the frame element's own document's view is its own
+        // document's cover, not another context's: the renderer's UnderCover
+        // says it, and it keeps its id, as a same-process frame's does.
+        ce.obscured = target_view.get() != own &&
+                      !input::RenderWidgetHostViewInput::IsAncestorView(
+                          target_view.get(), own) &&
+                      target_view.get() != ce.element_view.get();
+      }
+      // A frame element whose frame is in this process, holding one of
+      // another: a hit in that one's view, or one inside it, lands in what
+      // it holds, as a press there would.
+      if (ce.obscured && !own && !ce.child_frame_token.empty()) {
+        for (const auto& frame : request->frames) {
+          if (frame.view.get() != target_view.get() || !frame.rfh) {
+            continue;
+          }
+          for (RenderFrameHostImpl* up = frame.rfh->GetParent(); up;
+               up = up->GetParent()) {
+            if (up->GetDevToolsFrameToken().ToString() ==
+                ce.child_frame_token) {
+              ce.obscured = false;
+              break;
+            }
+          }
+        }
+      }
+      if (ce.obscured) {
+        for (size_t k = 0; k < request->frames.size(); ++k) {
+          if (request->frames[k].view.get() == target_view.get()) {
+            ce.cover_frame = static_cast<int>(k);
+            ce.cover_point = *transformed_point;
+          }
+        }
+      }
+    }
+  }
+  barrier.Run();
+}
+
+// What lies over each element the cover test found covered: a press's hit
+// in the frame the hit landed in, at the hit's own point there,
+// so the listing can say what is on top of it. At most kMaxCoverNames.
+void PageHandler::DescribeAgentCovers(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  constexpr size_t kMaxCoverNames = 40;
+  std::vector<size_t> to_name;
+  for (size_t i = 0;
+       i < request->composed.size() && to_name.size() < kMaxCoverNames; ++i) {
+    const auto& ce = request->composed[i];
+    if (!ce.obscured || ce.cover_frame < 0) {
+      continue;
+    }
+    const int collector = request->frames[ce.cover_frame].collector;
+    // browser: a frame that has left the page since the capture began (the
+    // back-forward cache) is frozen, and never answers.
+    const RenderFrameHostImpl* frame =
+        request->frames[ce.cover_frame].rfh.get();
+    // browser: nor one given up at kAgentCollectWait, whose
+    // collector is gone.
+    if (frame && frame->IsActive() &&
+        !request->frames[ce.cover_frame].given_up && collector >= 0 &&
+        static_cast<size_t>(collector) < request->collectors.size() &&
+        request->collectors[collector].is_connected()) {
+      to_name.push_back(i);
+    }
+  }
+  if (to_name.empty()) {
+    request->finish_barrier.Run();
+    return;
+  }
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      to_name.size(),
+      base::BindOnce(&PageHandler::OnAgentCoversNamed, request));
+  for (size_t index : to_name) {
+    const auto& ce = request->composed[index];
+    request->collectors[request->frames[ce.cover_frame].collector]
+        ->DescribePoint(ce.cover_point.x(), ce.cover_point.y(),
+                        std::vector<int32_t>(),
+                        /*place=*/true,
+                        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                            base::BindOnce(&PageHandler::OnAgentCoverDescribed,
+                                           weak_factory_.GetWeakPtr(), request,
+                                           index, barrier),
+                            std::string(), 0, std::string()));
+  }
+  // browser: a renderer that neither answers nor drops its pipe does not
+  // hold the capture past kAgentCollectWait; what it names later is not
+  // waited for.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&PageHandler::OnAgentCoversNamed, request),
+      kAgentCollectWait);
+}
+
+// static
+void PageHandler::OnAgentCoversNamed(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  if (request->covers_named) {
+    return;
+  }
+  request->covers_named = true;
+  request->finish_barrier.Run();
+}
+
+void PageHandler::OnAgentCoverDescribed(
+    scoped_refptr<AgentSnapshotRequest> request,
+    size_t element_index,
+    base::RepeatingClosure barrier,
+    const std::string& hit,
+    int32_t hit_node_id,
+    const std::string& value) {
+  if (element_index < request->composed.size()) {
+    // Said with where it is: the page's own content over a frame's element,
+    // or another frame's over the element.
+    auto& ce = request->composed[element_index];
+    const bool page =
+        ce.cover_frame >= 0 &&
+        static_cast<size_t>(ce.cover_frame) < request->frames.size() &&
+        IsPageDocument(request->frames[ce.cover_frame].rfh.get());
+    ce.covered_by = CoverName(page, hit);
+    ce.cover_named = !hit.empty();
+    // browser: with layers asked, the entry of the cover frame's
+    // `layers` that holds what was met, asked of that frame's local root --
+    // still active: one gone into the back-forward cache never answers.
+    const AgentSnapshotRequest::FrameEntry* frame =
+        ce.cover_frame >= 0 &&
+                static_cast<size_t>(ce.cover_frame) < request->frames.size()
+            ? &request->frames[ce.cover_frame]
+            : nullptr;
+    const bool layers =
+        request->layer_scope == blink::mojom::AgentLayerScope::kOn ||
+        request->layer_scope == blink::mojom::AgentLayerScope::kAll;
+    if (layers && hit_node_id && frame && frame->rfh &&
+        frame->rfh->IsActive() && frame->snapshot &&
+        !frame->snapshot->layers.empty() && frame->collector >= 0 &&
+        static_cast<size_t>(frame->collector) < request->collectors.size() &&
+        request->collectors[frame->collector].is_connected()) {
+      std::vector<int32_t> roots;
+      std::vector<int32_t> veils;
+      for (const auto& layer : frame->snapshot->layers) {
+        roots.push_back(layer->root_node_id);
+        veils.push_back(layer->veil_node_id);
+      }
+      request->collectors[frame->collector]->LayerOfNode(
+          hit_node_id, std::move(roots), std::move(veils),
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&PageHandler::OnAgentCoverLayer,
+                             weak_factory_.GetWeakPtr(), request, element_index,
+                             barrier),
+              -1));
+      return;
+    }
+  }
+  barrier.Run();
+}
+
+void PageHandler::OnAgentCoverLayer(scoped_refptr<AgentSnapshotRequest> request,
+                                    size_t element_index,
+                                    base::RepeatingClosure barrier,
+                                    int32_t index) {
+  if (element_index < request->composed.size()) {
+    request->composed[element_index].cover_layer = index;
+  }
+  barrier.Run();
+}
+
+// browser: the screenshot from a frozen frame. Every
+// local root that answered the capture holds one frame still, L, with what it
+// draws of text, fields and moving boxes; the root view's surface is copied
+// while they hold (OOPIFs aggregated, as CaptureScreenshot's surface path
+// does), what each said is placed in the page while they still hold, and they
+// are released. Frames are produced even while the page is hidden: the
+// capturer count is raised first, since a hidden compositor makes no main
+// frame to freeze.
+void PageHandler::StartAgentSnapshotScreenshot(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  if (!widget_host || !widget_host->GetView()) {
+    request->input_watch.reset();
+    request->finish_barrier.Run();
+    return;
+  }
+  request->screenshot_started = base::TimeTicks::Now();
+  request->root_index = request->frames.size();
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    if (request->frames[i].id == request->root_id) {
+      request->root_index = i;
+    }
+  }
+  if (auto* wc = WebContents::FromRenderFrameHost(host_)) {
+    request->capturer_handle =
+        wc->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/true,
+                                   /*stay_awake=*/true, /*is_activity=*/false);
+  }
+  FreezeAgentFrames(request);
+}
+
+void PageHandler::FreezeAgentFrames(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  const int attempt = request->freeze_tries;
+  request->frozen.clear();
+  request->frozen.resize(request->frames.size());
+  request->try_done = false;
+  request->copy_started = false;
+  request->copied = false;
+  request->frame_lost = false;
+  request->px_per_dip = 0;
+  request->extra_black.clear();
+  request->extra_frames_blacked = 0;
+  request->screenshot_bitmap.reset();
+  if (request->input_watch && attempt > 0) {
+    request->input_watch->Reset();
+  }
+  // Text only for a caller that holds secrets: else only card fields matter.
+  const int32_t chars = request->hold_for_secrets ? kAgentRedactionChars : 0;
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      request->frames.size(),
+      base::BindOnce(&PageHandler::OnAgentFramesFrozen,
+                     weak_factory_.GetWeakPtr(), request, attempt));
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    // A try already over (the page's own frame, asked first, failed at once)
+    // asks no more frames.
+    if (attempt != request->freeze_tries || request->try_done) {
+      return;
+    }
+    const AgentSnapshotRequest::FrameEntry& frame = request->frames[i];
+    RenderFrameHostImpl* rfh = frame.rfh.get();
+    // A hidden frame (display:none, out of the page) makes no frame to
+    // freeze, and the page does not draw it: not asked.
+    const bool drawn = rfh && rfh->IsRenderFrameLive() &&
+                       rfh->GetRenderWidgetHost() &&
+                       !rfh->GetRenderWidgetHost()->IsHidden();
+    request->frozen[i].drawn_at_freeze = drawn;
+    if (!drawn || frame.collector < 0 ||
+        static_cast<size_t>(frame.collector) >= request->collectors.size() ||
+        !request->collectors[frame.collector].is_bound()) {
+      barrier.Run();
+      continue;
+    }
+    request->collectors[frame.collector]->FreezeForCopy(
+        chars, request->frozen[i].hold.BindNewPipeAndPassReceiver(),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&PageHandler::OnAgentFrameFrozen,
+                           weak_factory_.GetWeakPtr(), request, attempt, i,
+                           barrier),
+            nullptr));
+  }
+  // The page's own frame answers within its renderer's own wait; one that
+  // does not (a page frozen by a pause, a main thread stuck) ends the try.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PageHandler::OnAgentFramesFrozen,
+                     weak_factory_.GetWeakPtr(), request, attempt),
+      kAgentFreezeAnswerWait);
+}
+
+void PageHandler::OnAgentFrameFrozen(
+    scoped_refptr<AgentSnapshotRequest> request,
+    int attempt,
+    size_t frame_index,
+    base::RepeatingClosure barrier,
+    blink::mojom::AgentFreezeReplyPtr reply) {
+  bool root_failed = false;
+  if (attempt == request->freeze_tries &&
+      frame_index < request->frozen.size()) {
+    AgentSnapshotRequest::Frozen& frozen = request->frozen[frame_index];
+    frozen.late = request->copy_started;
+    if (frame_index == request->root_index && !request->copy_started) {
+      if (reply && reply->frozen) {
+        // The page's own frame is in: the others get a moment more, so that
+        // a busy frame does not hold the copy until its hold runs out.
+        base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+            FROM_HERE,
+            base::BindOnce(&PageHandler::OnAgentFramesFrozen,
+                           weak_factory_.GetWeakPtr(), request, attempt),
+            kAgentFreezeJoinWait);
+      } else {
+        // Not frozen: the try ends now, not when the others have answered.
+        root_failed = true;
+      }
+    }
+    frozen.reply = std::move(reply);
+  }
+  barrier.Run();
+  if (root_failed) {
+    OnAgentFramesFrozen(request, attempt);
+  }
+}
+
+void PageHandler::OnAgentFramesFrozen(
+    scoped_refptr<AgentSnapshotRequest> request,
+    int attempt) {
+  if (attempt != request->freeze_tries || request->copy_started) {
+    return;
+  }
+  request->copy_started = true;
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  auto* root_view =
+      widget_host
+          ? static_cast<RenderWidgetHostViewBase*>(widget_host->GetView())
+          : nullptr;
+  const blink::mojom::AgentFreezeReplyPtr* root_reply =
+      request->root_index < request->frozen.size()
+          ? &request->frozen[request->root_index].reply
+          : nullptr;
+  if (!root_reply || !*root_reply || !(*root_reply)->frozen || !root_view) {
+    // The holds go with the try: OnAgentFreezesReleased tries again or
+    // withholds the image.
+    OnAgentFreezesReleased(request, attempt);
+    return;
+  }
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(request->root_id);
+  if (request->hold_for_secrets && root) {
+    request->extra_black = OpenAgentListWindows(*root, *root_view);
+  }
+  // Copied directly: a forced redraw waits for a commit, and a paused
+  // renderer makes none until it is released.
+  root_view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), kAgentFrozenCopyWait,
+      base::BindOnce(&PageHandler::OnAgentSnapshotScreenshotCaptured,
+                     weak_factory_.GetWeakPtr(), request, attempt));
+}
+
+void PageHandler::OnAgentSnapshotScreenshotCaptured(
+    scoped_refptr<AgentSnapshotRequest> request,
+    int attempt,
+    const CopyFromSurfaceResult& result) {
+  if (attempt != request->freeze_tries) {
+    return;
+  }
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(request->root_id);
+  auto* root_view =
+      root ? static_cast<RenderWidgetHostViewBase*>(root->GetView()) : nullptr;
+  if (result.has_value() && root_view) {
+    // A writable copy: the captured bitmap shares pixels with the surface
+    // capture, and FinishAgentSnapshot draws on it.
+    const SkBitmap& src = result->bitmap;
+    const int view_width = root_view->GetViewBounds().width();
+    if (!src.drawsNothing() && view_width > 0 &&
+        request->screenshot_bitmap.tryAllocPixels(src.info())) {
+      src.readPixels(request->screenshot_bitmap.pixmap(), 0, 0);
+      request->copied = true;
+      request->px_per_dip = static_cast<double>(src.width()) / view_width;
+    }
+  }
+  // While the holds hold: each frame's views and placement in the page are
+  // the ones the copy shows.
+  if (request->copied) {
+    ComposeAgentFrozenFrames(request);
+  }
+  // Every hold is released now; each says whether its pause held until now,
+  // so after the copy.
+  size_t holds = 0;
+  for (const AgentSnapshotRequest::Frozen& frozen : request->frozen) {
+    holds += frozen.hold.is_bound() ? 1 : 0;
+  }
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      holds, base::BindOnce(&PageHandler::OnAgentFreezesReleased,
+                            weak_factory_.GetWeakPtr(), request, attempt));
+  for (size_t i = 0; i < request->frozen.size(); ++i) {
+    AgentSnapshotRequest::Frozen& frozen = request->frozen[i];
+    if (!frozen.hold.is_bound()) {
+      continue;
+    }
+    frozen.hold->Release(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        base::BindOnce(&PageHandler::OnAgentFreezeReleased,
+                       weak_factory_.GetWeakPtr(), request, attempt, i,
+                       barrier),
+        false));
+  }
+  // A hold that does not answer its release in time (a page frozen by a
+  // pause meanwhile) did not hold: the try ends without it.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PageHandler::OnAgentFreezesReleased,
+                     weak_factory_.GetWeakPtr(), request, attempt),
+      kAgentReleaseWait);
+}
+
+// browser: what each frame said, placed in the page as the copy shows
+// it, cut to the copy. Every frame the page shows gets the part it shows (by
+// the intersection its parent sent), painted solid unless its record is kept
+// (it was frozen in time, within the cap, placed by a transform the browser
+// could read, and its hold says it held); one the browser cannot place is
+// painted where its frame element is, if the page shows any of it. A frame
+// hidden when the frames were asked, and still hidden at the copy, is taken
+// as not drawn by the commit the copy shows. That rests on the order two
+// pipes arrive in: a parent sends its frames' visibility and intersections
+// while drawing that commit, over the frame's channel, and the freeze answer
+// only after the commit was presented, over the collector's; the copy comes
+// later still. The same order places every unchecked frame by its
+// intersection. A frame the page drew at the freeze and that is gone at the
+// copy fails the try: the held page still draws its last frame, which nothing
+// has read. One already dead at the freeze is painted solid where its frame
+// element is. Local roots that came after the capture began are painted
+// solid, and open list windows are blacked again.
+void PageHandler::ComposeAgentFrozenFrames(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(request->root_id);
+  auto* root_view =
+      root ? static_cast<RenderWidgetHostViewBase*>(root->GetView()) : nullptr;
+  if (!root_view || request->px_per_dip <= 0) {
+    return;
+  }
+  const gfx::RectF copy(
+      request->screenshot_bitmap.width() / request->px_per_dip,
+      request->screenshot_bitmap.height() / request->px_per_dip);
+  // What the page shows of a frame, by the intersection its parent sent:
+  // nothing when it shows none of it.
+  const auto shown_of = [&copy](RenderFrameHostImpl& rfh) {
+    gfx::RectF shown = ShownPartInRoot(rfh);
+    shown.Intersect(copy);
+    return shown;
+  };
+  // A frame in another process is placed by the transform the browser's
+  // hit-test data holds for its view; one missing from that data would be
+  // mapped as if it sat at the page's top-left, so it is not placed.
+  const auto placed = [root_view](RenderWidgetHostViewBase& view) {
+    gfx::Transform to_root;
+    return &view == root_view ||
+           view.GetTransformToViewCoordSpace(root_view, &to_root);
+  };
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    AgentSnapshotRequest::Frozen& frozen = request->frozen[i];
+    RenderFrameHostImpl* rfh = request->frames[i].rfh.get();
+    RenderWidgetHostViewBase* view =
+        rfh && rfh->IsRenderFrameLive() ? rfh->GetView() : nullptr;
+    if (!view) {
+      if (frozen.drawn_at_freeze) {
+        request->frame_lost = true;
+      } else if (rfh) {
+        frozen.solid = FrameRectInRoot(*rfh, /*if_shown=*/false);
+        frozen.solid.Intersect(copy);
+      }
+      continue;
+    }
+    RenderWidgetHostImpl* widget = rfh->GetRenderWidgetHost();
+    if (!frozen.drawn_at_freeze && widget && widget->IsHidden()) {
+      continue;
+    }
+    frozen.solid = shown_of(*rfh);
+    if (!placed(*view)) {
+      frozen.solid = FrameRectInRoot(*rfh, /*if_shown=*/true);
+      frozen.solid.Intersect(copy);
+      continue;
+    }
+    if (frozen.reply && frozen.reply->frozen && !frozen.late &&
+        !(request->hold_for_secrets && frozen.reply->runs_cut) &&
+        AgentFrozenRunsFit(*frozen.reply)) {
+      ComposeAgentFrozenFrame(request, i, *view, copy);
+      frozen.checked = true;
+    }
+  }
+  root->ForEachRenderFrameHostImpl(
+      [&request, &shown_of, &placed, &copy](RenderFrameHostImpl* rfh) {
+        if (!rfh->IsRenderFrameLive() || !rfh->is_local_root() ||
+            !rfh->IsActive() ||
+            std::ranges::any_of(request->frames, [rfh](const auto& entry) {
+              return entry.id == rfh->GetGlobalId();
+            })) {
+          return;
+        }
+        RenderWidgetHostViewBase* view = rfh->GetView();
+        gfx::RectF shown;
+        if (view && placed(*view)) {
+          shown = shown_of(*rfh);
+        } else {
+          shown = FrameRectInRoot(*rfh, /*if_shown=*/true);
+          shown.Intersect(copy);
+        }
+        if (!shown.IsEmpty()) {
+          request->extra_black.push_back(shown);
+          ++request->extra_frames_blacked;
+        }
+      });
+  if (request->hold_for_secrets) {
+    for (const gfx::RectF& box : OpenAgentListWindows(*root, *root_view)) {
+      request->extra_black.push_back(box);
+    }
+  }
+}
+
+// browser: one frozen local root's record in root DIPs, mapped by its
+// view as the copy places it and cut to the copy only (the renderer cut each
+// box to what shows): card fields, what its throttled frames show and what
+// moves either are blacked whatever matches; with holdForSecrets, its runs
+// and fields go to the client's matcher, one redaction frame per same-process
+// document.
+void PageHandler::ComposeAgentFrozenFrame(
+    scoped_refptr<AgentSnapshotRequest> request,
+    size_t frame_index,
+    RenderWidgetHostViewBase& view,
+    const gfx::RectF& copy) {
+  AgentSnapshotRequest::Frozen& frozen = request->frozen[frame_index];
+  const blink::mojom::AgentFreezeReply& reply = *frozen.reply;
+  const auto to_root = [&view,
+                        &copy](const blink::mojom::AgentElementBox& box) {
+    const gfx::RectF local(box.x, box.y, box.width, box.height);
+    if (local.IsEmpty()) {
+      return gfx::RectF();
+    }
+    gfx::RectF root = RootBoxOf(view, local);
+    root.Intersect(copy);
+    return root;
+  };
+  std::vector<gfx::RectF> motion;
+  for (const blink::mojom::AgentElementBoxPtr& box : reply.motion) {
+    motion.push_back(to_root(*box));
+  }
+  const auto motion_of = [&motion](int32_t index) {
+    return index >= 0 && static_cast<size_t>(index) < motion.size()
+               ? motion[index]
+               : gfx::RectF();
+  };
+  for (const blink::mojom::AgentFrozenFieldPtr& field : reply.fields) {
+    if (field->card) {
+      frozen.black.push_back(to_root(*field->box));
+      frozen.black.push_back(motion_of(field->motion));
+    }
+  }
+  for (const blink::mojom::AgentFrozenBoxPtr& unread : reply.unread) {
+    frozen.black.push_back(to_root(*unread->box));
+    frozen.black.push_back(motion_of(unread->motion));
+  }
+  if (!request->hold_for_secrets) {
+    return;
+  }
+  // One redaction frame per document of this local root, in its walk's order.
+  // Each field's frame and its first and last run there.
+  struct FieldRuns {
+    size_t frame = 0;
+    int first = -1;
+    int last = -1;
+  };
+  std::vector<FieldRuns> field_runs(reply.fields.size());
+  for (const blink::mojom::AgentFrozenRunPtr& run : reply.runs) {
+    const size_t doc = run->doc > 0 ? static_cast<size_t>(run->doc) : 0;
+    if (frozen.redaction.size() <= doc) {
+      frozen.redaction.resize(doc + 1);
+    }
+    AgentRedactionFrame& frame = frozen.redaction[doc];
+    const int index = static_cast<int>(frame.texts.size());
+    frame.texts.push_back(run->text);
+    frame.in_view.push_back(run->in_view);
+    frame.runs.push_back(to_root(*run->box));
+    frame.run_motion.push_back(motion_of(run->motion));
+    if (run->field >= 0 &&
+        static_cast<size_t>(run->field) < field_runs.size()) {
+      FieldRuns& runs = field_runs[run->field];
+      if (runs.first < 0) {
+        runs.frame = doc;
+        runs.first = index;
+      }
+      // A field's runs are in its own document; one said to be in another
+      // is not counted in its range.
+      if (runs.frame == doc) {
+        runs.last = index;
+      }
+    }
+  }
+  for (size_t f = 0; f < reply.fields.size(); ++f) {
+    const FieldRuns& runs = field_runs[f];
+    if (reply.fields[f]->card || runs.first < 0) {
+      continue;
+    }
+    AgentRedactionFrame::Field field;
+    field.first_run = runs.first;
+    field.end_run = runs.last + 1;
+    field.box = to_root(*reply.fields[f]->box);
+    field.motion = motion_of(reply.fields[f]->motion);
+    frozen.redaction[runs.frame].fields.push_back(field);
+  }
+}
+
+void PageHandler::OnAgentFreezeReleased(
+    scoped_refptr<AgentSnapshotRequest> request,
+    int attempt,
+    size_t frame_index,
+    base::RepeatingClosure barrier,
+    bool held) {
+  if (attempt == request->freeze_tries &&
+      frame_index < request->frozen.size()) {
+    request->frozen[frame_index].held = held;
+  }
+  barrier.Run();
+}
+
+void PageHandler::OnAgentFreezesReleased(
+    scoped_refptr<AgentSnapshotRequest> request,
+    int attempt) {
+  // Once per try: from the release barrier, the release deadline, or before
+  // the copy.
+  if (attempt != request->freeze_tries || request->try_done) {
+    return;
+  }
+  request->try_done = true;
+  const bool moved = request->input_watch && request->input_watch->moved();
+  const size_t root_index = request->root_index;
+  const bool root_ok =
+      root_index < request->frozen.size() && request->copied && !moved &&
+      !request->frame_lost && request->frozen[root_index].reply &&
+      request->frozen[root_index].reply->frozen &&
+      !request->frozen[root_index].late && request->frozen[root_index].held;
+  if (!root_ok) {
+    // Pixels are never kept without the page's own frame held from its
+    // record until after the copy, with nothing moving it meanwhile. The
+    // holds dropped end every freeze, at once or as its renderer thaws.
+    for (AgentSnapshotRequest::Frozen& frozen : request->frozen) {
+      frozen.hold.reset();
+    }
+    request->screenshot_bitmap.reset();
+    request->input_moved = moved;
+    // Another try only early enough: a page a pause froze answers once it
+    // thaws, and a try started then would meet the next input.
+    if (++request->freeze_tries < kAgentFreezeTries &&
+        base::TimeTicks::Now() - request->screenshot_started <
+            kAgentScreenshotBudget) {
+      // Posted: this can run inside the try's own loops, which must not see
+      // the next try's holds.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&PageHandler::FreezeAgentFrames,
+                                    weak_factory_.GetWeakPtr(), request));
+      return;
+    }
+    request->withheld = request->input_moved
+                            ? Page::CaptureAgentSnapshot::
+                                  ScreenshotWithheldEnum::InputDuringCopy
+                            : Page::CaptureAgentSnapshot::
+                                  ScreenshotWithheldEnum::MainFrameNotFrozen;
+    request->input_watch.reset();
+    request->capturer_handle.RunAndReset();
+    request->finish_barrier.Run();
+    return;
+  }
+  request->input_watch.reset();
+  request->always_black = std::move(request->extra_black);
+  request->frames_blacked = request->extra_frames_blacked;
+  request->redaction.clear();
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    AgentSnapshotRequest::Frozen& frozen = request->frozen[i];
+    if (frozen.checked && frozen.held) {
+      for (const gfx::RectF& box : frozen.black) {
+        request->always_black.push_back(box);
+      }
+      for (AgentRedactionFrame& document : frozen.redaction) {
+        request->redaction.push_back(std::move(document));
+      }
+      continue;
+    }
+    if (i == root_index) {
+      // Held, but not composed: its text passed the cap while secrets are
+      // held, so it was not searched; or its view went at the copy.
+      request->withheld =
+          frozen.reply->runs_cut && request->hold_for_secrets
+              ? Page::CaptureAgentSnapshot::ScreenshotWithheldEnum::PageTooLarge
+              : Page::CaptureAgentSnapshot::ScreenshotWithheldEnum::
+                    MainFrameNotFrozen;
+      request->screenshot_bitmap.reset();
+      break;
+    }
+    // A frame that could not be checked is painted solid where it shows.
+    if (!frozen.solid.IsEmpty()) {
+      request->always_black.push_back(frozen.solid);
+      ++request->frames_blacked;
+    }
+  }
+  for (AgentSnapshotRequest::Frozen& frozen : request->frozen) {
+    frozen.hold.reset();
+    frozen.reply.reset();
+  }
+  request->capturer_handle.RunAndReset();
+  request->finish_barrier.Run();
+}
+
+void PageHandler::PruneAgentCaptures() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  base::EraseIf(held_captures_, [now](const auto& held) {
+    return now - held.second->made_at > kAgentHeldCaptureLife;
+  });
+}
+
+std::string PageHandler::KeepAgentCapture(
+    std::unique_ptr<AgentHeldCapture> capture) {
+  PruneAgentCaptures();
+  while (held_captures_.size() >= kAgentHeldCapturesKept) {
+    held_captures_.erase(std::ranges::min_element(
+        held_captures_, {},
+        [](const auto& held) { return held.second->made_at; }));
+  }
+  std::string id = base::NumberToString(++held_capture_seq_);
+  held_captures_[id] = std::move(capture);
+  return id;
+}
+
+// browser: Page.agentFinishCapture. The runs and fields the client's matcher
+// named are blacked on the held copy (a run something moves: its own box and
+// the mover's; a field: its box, its runs and what moves them; on a copy cut
+// to a clip, moved by its kept_offset), then the
+// image is scaled, marked and encoded as a capture's is. An index that names
+// nothing fails the call: what the client meant to black is not known.
+Response PageHandler::AgentFinishCapture(
+    const std::string& capture_id,
+    std::unique_ptr<protocol::Array<Page::AgentFinishFrame>> frames,
+    Binary* out_screenshot,
+    double* out_screenshot_scale) {
+  auto it = held_captures_.find(capture_id);
+  if (it == held_captures_.end()) {
+    PruneAgentCaptures();
+    return Response::ServerError("captureExpired");
+  }
+  std::unique_ptr<AgentHeldCapture> capture = std::move(it->second);
+  held_captures_.erase(it);
+  PruneAgentCaptures();
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(capture->root_id);
+  if (base::TimeTicks::Now() - capture->made_at > kAgentHeldCaptureLife ||
+      !root || root->frame_tree_node()->current_frame_host() != root ||
+      root->GetDocumentToken() != capture->root_document) {
+    return Response::ServerError("captureExpired");
+  }
+  // An answer that does not name every frame cannot be trusted to have
+  // searched them all.
+  if (!frames || frames->size() != capture->frames.size()) {
+    return Response::InvalidParams(
+        "frames must answer every frame of the capture's redaction");
+  }
+  std::vector<gfx::RectF> black;
+  const auto black_run = [&black](const AgentRedactionFrame& frame, int run) {
+    black.push_back(frame.runs[run]);
+    if (!frame.run_motion[run].IsEmpty()) {
+      black.push_back(frame.run_motion[run]);
+    }
+  };
+  for (size_t f = 0; f < capture->frames.size(); ++f) {
+    const AgentRedactionFrame& frame = capture->frames[f];
+    Page::AgentFinishFrame& answer = *(*frames)[f];
+    for (int run : *answer.GetRuns()) {
+      if (run < 0 || static_cast<size_t>(run) >= frame.runs.size()) {
+        return Response::InvalidParams("a run index names no run");
+      }
+      black_run(frame, run);
+    }
+    for (int field : *answer.GetFields()) {
+      if (field < 0 || static_cast<size_t>(field) >= frame.fields.size()) {
+        return Response::InvalidParams("a field index names no field");
+      }
+      const AgentRedactionFrame::Field& named = frame.fields[field];
+      black.push_back(named.box);
+      black.push_back(named.motion);
+      for (int run = named.first_run; run < named.end_run; ++run) {
+        black_run(frame, run);
+      }
+    }
+  }
+  // browser: on a copy cut to a clip, where the kept part shows them.
+  for (gfx::RectF& box : black) {
+    box.Offset(-capture->kept_offset.x(), -capture->kept_offset.y());
+  }
+  PaintAgentRedaction(capture->bitmap, black, capture->px_per_dip);
+  double scale = capture->scale;
+  ScaleAgentScreenshot(capture->bitmap, capture->dsf, scale);
+  if (!capture->marks.empty()) {
+    std::vector<gfx::RectF> boxes;
+    for (const gfx::RectF& mark : capture->marks) {
+      boxes.push_back(gfx::ScaleRect(mark, scale));
+    }
+    DrawAgentMarks(capture->bitmap, boxes, capture->labels, capture->colors,
+                   scale);
+  }
+  std::optional<std::vector<uint8_t>> bytes =
+      capture->encoder.Run(capture->bitmap);
+  if (!bytes) {
+    return Response::ServerError("the screenshot could not be encoded");
+  }
+  *out_screenshot = Binary::fromVector(std::move(*bytes));
+  *out_screenshot_scale = scale;
+  return Response::Success();
+}
+
+// Assembles the protocol response.
+void PageHandler::FinishAgentSnapshot(
+    scoped_refptr<AgentSnapshotRequest> request) {
+  if (!request->callback) {
+    return;
+  }
+  // browser: whichever way it answers below, the capture then lets go
+  // of its heavy parts, once nothing here points into them any more.
+  base::ScopedClosureRunner release_heavy_parts(
+      base::BindOnce(&AgentSnapshotRequest::ReleaseHeavyParts, request));
+
+  // browser: the capture's document must still be the page's -- its
+  // frame's current host, with the document token it had when the capture
+  // began. Otherwise nothing is minted, pruned or stored.
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(request->root_id);
+  if (!root || root->frame_tree_node()->current_frame_host() != root ||
+      root->GetDocumentToken() != request->root_document) {
+    request->callback->sendFailure(
+        Response::ServerError("the page changed document during the capture"));
+    return;
+  }
+  request->url = root->GetLastCommittedURL().spec();
+  WebContentsImpl* contents = WebContentsImpl::FromRenderFrameHostImpl(root);
+  if (contents) {
+    request->title = base::UTF16ToUTF8(contents->GetTitle());
+  }
+  AgentIdSpace* space = AgentIdSpace::GetOrCreate(root);
+
+  auto viewport = Page::AgentSnapshotViewport::Create()
+                      .SetWidth(base::ClampRound(request->vp_width))
+                      .SetHeight(base::ClampRound(request->vp_height))
+                      .SetDeviceScaleFactor(request->device_scale_factor)
+                      .SetScrollX(request->scroll_x)
+                      .SetScrollY(request->scroll_y)
+                      .SetScrollWidth(request->scroll_width)
+                      .SetScrollHeight(request->scroll_height)
+                      .Build();
+
+  auto elements =
+      std::make_unique<protocol::Array<Page::AgentSnapshotElement>>();
+
+  // The change-detection token covers the url, the viewport geometry and
+  // each reported element's identity and composed geometry.
+  // TODO: fold the focused element's backendNodeId into the token.
+  std::string token_src = base::StringPrintf(
+      "%s|%d|%d|%.1f|%.1f", request->url.c_str(),
+      base::ClampRound(request->vp_width), base::ClampRound(request->vp_height),
+      request->scroll_x, request->scroll_y);
+
+  // The marked set is what the user can act on right now: in the viewport,
+  // interactive and not occluded. Their labels (the id space's) and the
+  // colors drive both the drawn overlay and the per-element label/color
+  // fields, so the screenshot and the listing always agree.
+  const double dsf = request->device_scale_factor;
+  // The image's pixels per CSS px. Brought to CSS px, then down to the
+  // area budget, never up; the device's when the caller asked for it (0).
+  // Always from the viewport, so the listing's colours are the same whether
+  // or not an image was asked for. The captured surface can be a scrollbar
+  // wider than the viewport: about 1 % over the budget.
+  double scale = dsf;
+  if (request->screenshot_max_pixels > 0) {
+    scale = std::min(dsf, 1.0);
+    const double area = request->vp_width * request->vp_height;
+    if (area > 0) {
+      const double budget = static_cast<double>(request->screenshot_max_pixels);
+      scale = std::min(scale, std::sqrt(budget / area));
+    }
+  }
+  if (scale / dsf >= 0.97) {
+    // Under 3 % smaller: not worth resampling the whole image.
+    scale = dsf;
+  }
+  bool has_image = request->include_screenshot && !request->withheld &&
+                   !request->screenshot_bitmap.drawsNothing();
+  // browser: what is blacked whatever matches, on the full-resolution
+  // copy before anything else touches it. With holdForSecrets the image waits
+  // for Page.agentFinishCapture at full resolution, unmarked.
+  const double px_per_dip = request->px_per_dip > 0 ? request->px_per_dip : dsf;
+  if (has_image) {
+    PaintAgentRedaction(request->screenshot_bitmap, request->always_black,
+                        px_per_dip);
+  }
+  // browser: the clip, cut after the paint (the redaction's boxes are
+  // the whole frame's) and before the scale, so a held capture is kept cut
+  // and its marks are stored offset to the kept part. One that meets none of
+  // the view withholds the image, as a blank page does.
+  std::optional<gfx::RectF> kept;
+  if (has_image && request->clip) {
+    gfx::RectF part;
+    if (CropAgentScreenshot(request->screenshot_bitmap, *request->clip,
+                            px_per_dip, &part)) {
+      kept = part;
+    } else {
+      request->withheld =
+          Page::CaptureAgentSnapshot::ScreenshotWithheldEnum::ClipOutside;
+      request->screenshot_bitmap.reset();
+      has_image = false;
+    }
+  }
+  const bool held = has_image && request->hold_for_secrets;
+  if (has_image && !held) {
+    // Resized before the marks are drawn, so the badges keep their size.
+    ScaleAgentScreenshot(request->screenshot_bitmap, dsf, scale);
+  }
+  // Scope on or all: the page's stack; with scope on, what a click cannot
+  // reach left out (clickable = shown, unclickable = hidden),
+  // counted by what it is behind.
+  const bool layers_asked =
+      request->layer_scope == blink::mojom::AgentLayerScope::kOn ||
+      request->layer_scope == blink::mojom::AgentLayerScope::kAll;
+  const bool hide = request->layer_scope == blink::mojom::AgentLayerScope::kOn;
+  // browser: what the listing leaves out off-screen: every element
+  // outside the root viewport under `none`, and under summary one that says
+  // nothing -- not a control, no name, not a progress bar or meter (its value
+  // is the news): "a3 paragraph", 30 000 times on a long statement.
+  const auto left_offscreen = [&request](const auto& ce) {
+    if (ce.in_viewport) {
+      return false;
+    }
+    if (request->offscreen_mode == blink::mojom::AgentOffscreenMode::kNone) {
+      return true;
+    }
+    return request->offscreen_mode ==
+               blink::mojom::AgentOffscreenMode::kSummary &&
+           !ce.interactive && (!ce.name || ce.name->empty()) &&
+           ce.role != "progressbar" && ce.role != "meter";
+  };
+  std::vector<LayerFrame> layer_frames;
+  const double view_area = request->vp_width * request->vp_height;
+  for (const auto& frame : request->frames) {
+    // As LayerFrameShows counts them: the page's own frame, and each other
+    // showing a tenth of the view.
+    const bool shows =
+        (frame.rfh && frame.rfh->IsOutermostMainFrame()) ||
+        (view_area > 0 && frame.shown.width() * frame.shown.height() >=
+                              view_area * kLayerFrameShowShare);
+    layer_frames.push_back(
+        {frame.rfh.get(), frame.frame_id, frame.snapshot.get(), shows});
+  }
+  PageLayers page_layers;
+  if (layers_asked) {
+    page_layers = AssemblePageLayers(layer_frames);
+    // browser: the stack read is the document's last one, the next
+    // action's report baseline; a frame that did not answer, or does not
+    // show, keeps its own.
+    base::flat_set<std::string> unread;
+    for (const LayerFrame& frame : layer_frames) {
+      if (frame.rfh && (!frame.snapshot || !frame.shows)) {
+        unread.insert(frame.frame_id);
+      }
+    }
+    space->SetLastLayers(WithUnreadLayers(
+        LastLayersOf(page_layers, layer_frames), space->last_layers(), unread));
+  }
+  std::vector<bool> dropped(request->composed.size(), false);
+  // browser: for each element left out, the entry of `layers` it is
+  // behind (-1: none) and what it is behind, as `hidden` says it.
+  std::vector<int> hidden_layer_of(request->composed.size(), -1);
+  std::vector<std::string> hidden_behind_of(request->composed.size());
+  std::vector<int> page_layer_of(request->composed.size(), -1);
+  std::vector<int> in_counts(page_layers.entries.size(), 0);
+  std::vector<int> behind_counts(page_layers.entries.size(), 0);
+  struct HiddenGroup {
+    std::string behind;
+    int layer = -1;
+    int in_view = 0;
+    int offscreen = 0;
+  };
+  std::vector<HiddenGroup> hidden_groups;
+  // The page's own frame; a local root's entry as the page's (-1: none);
+  // the page's top blocking entry, and whether it shuts the page off; and the
+  // topmost page entry holding each frame. browser: for the main
+  // scroller too; without layers there are none.
+  const size_t main = page_layers.main;
+  const auto page_index = [&](size_t frame, int local) -> int {
+    if (local < 0 || frame >= page_layers.index.size() ||
+        static_cast<size_t>(local) >= page_layers.index[frame].size()) {
+      return -1;
+    }
+    return page_layers.index[frame][static_cast<size_t>(local)];
+  };
+  int top_blocking = -1;
+  bool shuts = false;
+  std::vector<int> frame_holder(request->frames.size(), -1);
+  if (layers_asked && main < request->frames.size()) {
+    const auto& main_layers = request->frames[main].snapshot->layers;
+    for (size_t e = main_layers.size(); e-- > 0;) {
+      if (main_layers[e]->blocking) {
+        top_blocking = page_index(main, static_cast<int>(e));
+        shuts = main_layers[e]->shuts_page;
+        break;
+      }
+    }
+    for (size_t k = 0; k < request->frames.size(); ++k) {
+      for (size_t e = main_layers.size(); k != main && e-- > 0;) {
+        if (LayerHoldsFrame(*main_layers[e], request->frames[k].rfh.get())) {
+          frame_holder[k] = page_index(main, static_cast<int>(e));
+          break;
+        }
+      }
+    }
+  }
+  if (layers_asked) {
+    const auto add_hidden = [&](size_t i, int layer, std::string behind) {
+      dropped[i] = true;
+      // browser: counted as a scope: all listing would list it -- a
+      // control, or anything off-screen that is listed at all -- never text
+      // in view, which no listing lists.
+      const auto& ce_hidden = request->composed[i];
+      const bool counted = ce_hidden.interactive || !ce_hidden.in_viewport;
+      if (layer >= 0) {
+        if (counted) {
+          ++behind_counts[static_cast<size_t>(layer)];
+        }
+        behind = page_layers.entries[static_cast<size_t>(layer)].name;
+      }
+      if (behind.empty()) {
+        behind = "something";
+      }
+      hidden_layer_of[i] = layer;
+      hidden_behind_of[i] = behind;
+      if (!counted) {
+        return;
+      }
+      HiddenGroup* group = nullptr;
+      for (HiddenGroup& kept : hidden_groups) {
+        if (kept.layer == layer && kept.behind == behind) {
+          group = &kept;
+          break;
+        }
+      }
+      if (!group) {
+        hidden_groups.push_back({behind, layer, 0, 0});
+        group = &hidden_groups.back();
+      }
+      ++(ce_hidden.in_viewport ? group->in_view : group->offscreen);
+    };
+    for (size_t i = 0; i < request->composed.size(); ++i) {
+      const auto& ce = request->composed[i];
+      int layer = page_index(ce.frame_index, ce.layer);
+      if (layer < 0 && ce.frame_index != main &&
+          ce.frame_index < frame_holder.size()) {
+        layer = frame_holder[ce.frame_index];
+      }
+      page_layer_of[i] = layer;
+      // Never listed: not counted either.
+      if (left_offscreen(ce)) {
+        continue;
+      }
+      if (hide && ce.hidden) {
+        add_hidden(i, page_index(ce.frame_index, ce.hidden_layer),
+                   ce.hidden_behind);
+        continue;
+      }
+      // A text field holding a value -- a card number in a payment frame --
+      // is never left out: its box must reach the screenshot's redaction,
+      // seen through a veil. Not a checkbox's, a button's or a select's
+      // value: by its role, as the collector names text fields.
+      const bool holds_value =
+          ce.value && !ce.value->empty() &&
+          (ce.tag == "textarea" || ce.role == "textbox" ||
+           ce.role == "searchbox" || ce.role == "spinbutton" ||
+           ce.role.ends_with(" input") ||
+           (ce.role == "combobox" && ce.tag == "input"));
+      // Covered from another process (the browser's one hit test, at its
+      // middle): left out only behind the page's top blocking layer -- the
+      // page itself, or a frame that layer or one above it holds, is what
+      // the press met. A small widget of another frame over part of it (a
+      // chat launcher, an ad) leaves it listed.
+      // Never one inside that layer or above it (a payment frame in the modal
+      // under its own sticky header).
+      if (hide && ce.in_viewport && ce.interactive && ce.obscured &&
+          !holds_value && top_blocking >= 0 && layer < top_blocking &&
+          ce.cover_frame >= 0) {
+        const size_t cover_frame = static_cast<size_t>(ce.cover_frame);
+        if (cover_frame == main ||
+            (cover_frame < frame_holder.size() &&
+             frame_holder[cover_frame] >= top_blocking)) {
+          add_hidden(i, top_blocking, std::string());
+          continue;
+        }
+      }
+      // Off-screen in a frame of its own under the layer that shuts the page
+      // off, and not held by it or one above it. In view it is judged by its
+      // own cover (a frame over the modal, a challenge).
+      if (hide && shuts && top_blocking >= 0 && !ce.in_viewport &&
+          ce.frame_index != main && ce.frame_index < frame_holder.size() &&
+          frame_holder[ce.frame_index] < top_blocking) {
+        add_hidden(i, top_blocking, std::string());
+        continue;
+      }
+      if (layer >= 0) {
+        ++in_counts[static_cast<size_t>(layer)];
+      }
+      // And in the page's entry holding its frame -- an
+      // iframe wall's controls are the wall's.
+      if (ce.frame_index != main && ce.frame_index < frame_holder.size() &&
+          frame_holder[ce.frame_index] >= 0 &&
+          frame_holder[ce.frame_index] != layer) {
+        ++in_counts[static_cast<size_t>(frame_holder[ce.frame_index])];
+      }
+    }
+  }
+
+  // browser: the page's main scroller, from each local root's
+  // own (MainScrollerOf), placed in the root viewport as its elements are:
+  // the page's own window when its renderer judged that the document really
+  // scrolls, else the one that shows the most of itself. Under the page's top
+  // blocking layer (layers asked) only what that layer holds counts: the
+  // page's own frame judged its own, and another local root counts when that
+  // layer or one above it holds its frame. With none left, the reply says the
+  // layer locks the page. A scroller in a local root that gave no answer this
+  // time is not carried from the baseline: it drops out for this capture, and
+  // the delta tells it changed, then again once it is back.
+  const AgentSnapshotRequest::FrameEntry* scroller_frame = nullptr;
+  const blink::mojom::AgentScrollerCandidate* scroller = nullptr;
+  gfx::RectF scroller_box;
+  gfx::PointF scroller_aim;
+  int scroller_layer = -1;
+  // browser: the page's entry over it, when no wheel reaches it.
+  int scroller_under = -1;
+  bool scroller_wins = false;
+  bool document_locked = false;
+  for (size_t k = 0; k < request->frames.size(); ++k) {
+    const AgentSnapshotRequest::FrameEntry& frame = request->frames[k];
+    const bool page_frame = frame.id == request->root_id;
+    if (page_frame && frame.snapshot) {
+      document_locked = frame.snapshot->document_locked;
+    }
+    const blink::mojom::AgentScrollerCandidate* candidate =
+        frame.snapshot && frame.view ? frame.snapshot->main_scroller.get()
+                                     : nullptr;
+    if (!candidate || scroller_wins ||
+        (top_blocking >= 0 && !page_frame && frame_holder[k] < top_blocking)) {
+      continue;
+    }
+    const blink::mojom::AgentElementBox& visible = *candidate->visible;
+    const gfx::RectF local(visible.x, visible.y, visible.width, visible.height);
+    const gfx::RectF mapped = frame.by_rects ? local + *frame.by_rects
+                                             : RootBoxOf(*frame.view, local);
+    gfx::RectF box = mapped;
+    box.Intersect(frame.shown);
+    if (box.IsEmpty()) {
+      continue;
+    }
+    scroller_wins = page_frame && candidate->document_scrolls;
+    if (!scroller_wins && scroller &&
+        box.width() * box.height() <=
+            scroller_box.width() * scroller_box.height()) {
+      continue;
+    }
+    scroller_frame = &frame;
+    scroller = candidate;
+    scroller_box = box;
+    // Where its renderer turned the wheel: the middle of what it shows.
+    scroller_aim = mapped.CenterPoint();
+    scroller_layer = page_index(k, candidate->layer);
+    if (scroller_layer < 0 && !page_frame) {
+      scroller_layer = frame_holder[k];
+    }
+    scroller_under = page_index(k, candidate->under_layer);
+  }
+  const int locked_behind_layer = scroller ? -1 : top_blocking;
+
+  // browser: the listing -- in view, or off-screen unless left_offscreen
+  // leaves it out, and not left out behind a layer -- in order, then what was
+  // left out behind a layer, what left_offscreen left out off-screen, the
+  // renderers' verdicts on the
+  // ids they did not return, and the page's state, for the document's id
+  // space (agent_id_space.h), which mints, labels, diffs against `since` and
+  // stores.
+  AgentCaptureIn in;
+  in.scope = AgentScopeName(request->layer_scope);
+  in.offscreen_mode = AgentOffscreenName(request->offscreen_mode);
+  in.since = request->since;
+  in.url = request->url;
+  in.title = request->title;
+  in.scroll_x = base::ClampRound(request->scroll_x);
+  in.scroll_y = base::ClampRound(request->scroll_y);
+  // browser: what holds the page still, as the reply says it.
+  in.held_behind_layer = locked_behind_layer >= 0;
+  for (size_t p = 0; p < page_layers.entries.size(); ++p) {
+    in.layers.push_back(LayerRefOf(page_layers, p, layer_frames));
+  }
+  // The focused element: the listed one with the `focused` state; when
+  // several have it, the one under the local root holding the focused frame.
+  GlobalRenderFrameHostId focused_root;
+  for (RenderFrameHostImpl* frame = contents ? contents->GetFocusedFrame()
+                                             : nullptr;
+       frame; frame = frame->GetParent()) {
+    if (frame->is_local_root()) {
+      focused_root = frame->GetGlobalId();
+      break;
+    }
+  }
+  bool focus_in_root = false;
+  const auto seen_of = [](const auto& ce, AgentPlace place) {
+    AgentSeenElement seen;
+    seen.key = AgentKey(ce.local_root_rfh_id, ce.backend_node_id);
+    seen.place = place;
+    seen.reach_told = ce.reach_told;
+    seen.hit_answered = ce.hit_answered;
+    seen.role = ce.role;
+    seen.name = ce.name.value_or(std::string());
+    seen.value = ce.value.value_or(std::string());
+    seen.description = ce.description.value_or(std::string());
+    seen.href = ce.href.value_or(std::string());
+    seen.states = ce.states;
+    seen.shut_out = ce.shut_out;
+    seen.error = ce.error.value_or(std::string());
+    seen.child_frame_id = ce.child_frame_token;
+    return seen;
+  };
+  // browser: left out off-screen under `none`, by the root viewport
+  // test below or each local root's own filter, and under summary what
+  // says nothing: kept as dropped, after the listed and the hidden ones.
+  std::vector<AgentSeenElement> offscreen_seen;
+  std::vector<int> listing_index(request->composed.size(), -1);
+  std::vector<bool> marked(request->composed.size(), false);
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    const auto& ce = request->composed[i];
+    // What left_offscreen leaves out is kept as dropped, its id minted, so it
+    // comes into view as into_view, or as appended when minted since the
+    // document's first listing. How many off-screen lines a listing
+    // prints is the bridge's to cap.
+    if (left_offscreen(ce)) {
+      offscreen_seen.push_back(seen_of(ce, AgentPlace::kDropped));
+      continue;
+    }
+    // Out of a click's reach: counted in `hidden`, told below.
+    if (dropped[i]) {
+      continue;
+    }
+    marked[i] = ce.in_viewport && ce.interactive && !ce.obscured;
+    AgentSeenElement seen = seen_of(ce, !ce.in_viewport ? AgentPlace::kOffscreen
+                                        : ce.obscured   ? AgentPlace::kCovered
+                                                        : AgentPlace::kView);
+    listing_index[i] = static_cast<int>(in.seen.size());
+    seen.listing_index = listing_index[i];
+    seen.marked = marked[i];
+    if (seen.place == AgentPlace::kCovered) {
+      seen.covered_by = ce.covered_by;
+      // browser: told once named.
+      seen.cover_told = ce.cover_named;
+    }
+    // browser: a marked element's own mark, said as its coveredBy, so
+    // the delta tells it coming and going; told once its hit tests ran, and
+    // not when a click scrolls it out from under (" (stays put)": rows
+    // passing under a sticky header), which keeps the baseline's.
+    if (seen.place == AgentPlace::kView && seen.marked) {
+      seen.covered_by = ce.under;
+      seen.cover_told =
+          ce.reach_told && !base::EndsWith(ce.under, " (stays put)");
+    }
+    if (std::find(ce.states.begin(), ce.states.end(), "focused") !=
+            ce.states.end() &&
+        (!in.focus ||
+         (!focus_in_root && ce.local_root_rfh_id == focused_root))) {
+      in.focus = seen.key;
+      focus_in_root = ce.local_root_rfh_id == focused_root;
+    }
+    in.seen.push_back(std::move(seen));
+  }
+  // Left out behind a layer: kept by key, so its return is told.
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    if (!dropped[i]) {
+      continue;
+    }
+    AgentSeenElement seen = seen_of(request->composed[i], AgentPlace::kBehind);
+    seen.behind_layer_index = hidden_layer_of[i];
+    if (hidden_layer_of[i] >= 0) {
+      seen.behind_layer = in.layers[static_cast<size_t>(hidden_layer_of[i])];
+    } else {
+      seen.covered_by = hidden_behind_of[i];
+    }
+    in.seen.push_back(std::move(seen));
+  }
+  for (AgentSeenElement& seen : offscreen_seen) {
+    in.seen.push_back(std::move(seen));
+  }
+  // Every local root in the page now. One asked that gave no answer, or lost
+  // its view since, keeps its elements as the baseline had them; one that left
+  // the page is gone.
+  std::vector<GlobalRenderFrameHostId> live_roots;
+  for (RenderFrameHostImpl* rfh : LiveLocalRoots(root)) {
+    live_roots.push_back(rfh->GetGlobalId());
+  }
+  std::vector<RegionReply> region_reads;
+  for (const auto& frame : request->frames) {
+    if (!frame.snapshot || !frame.view) {
+      if (std::ranges::find(live_roots, frame.id) != live_roots.end()) {
+        in.unanswered_roots.push_back(frame.id);
+      }
+      continue;
+    }
+    for (const auto& unlisted : frame.snapshot->unlisted) {
+      in.verdicts.push_back({AgentKey(frame.id, unlisted->node_id),
+                             AgentVerdictOf(unlisted->why)});
+    }
+    for (const int32_t node_id : frame.snapshot->offscreen_node_ids) {
+      AgentSeenElement seen;
+      seen.key = AgentKey(frame.id, node_id);
+      seen.place = AgentPlace::kDropped;
+      in.seen.push_back(std::move(seen));
+    }
+    for (const auto& region : frame.snapshot->regions) {
+      AgentRegionIn read;
+      read.key = AgentKey(frame.id, region->node_id);
+      read.frame_id = frame.frame_id;
+      read.kind = region->kind;
+      read.assertive = region->assertive;
+      read.text_hash = region->text_hash;
+      read.text = region->text;
+      in.regions.push_back(std::move(read));
+      RegionReply reply;
+      reply.frame_id = frame.frame_id;
+      reply.read = region.get();
+      region_reads.push_back(std::move(reply));
+    }
+  }
+  // browser: the main scroller's key in the id space (a window's: its
+  // document's), and the key its id goes by: an element's own, a frame
+  // window's listed frame element's. None for the page's own window, whose
+  // figures are the document's scroll: a page whose only scroller is the
+  // document lists and diffs as it did with none. An element scroller not
+  // listed is kept as placement scroller, after what is listed or dropped, so
+  // it is minted and labelled last (AgentIdSpace::Mint). A listed one's role
+  // and name are the listing's.
+  const bool scroller_is_page = scroller && scroller->is_window &&
+                                scroller_frame->id == request->root_id &&
+                                scroller->frame_id &&
+                                *scroller->frame_id == scroller_frame->frame_id;
+  // browser: the document's lock, where the page is what
+  // scrolls; an app shell's pane is not held by its body's.
+  in.document_locked = document_locked && (!scroller || scroller_is_page);
+  int scroller_seen = -1;
+  std::string scroller_role = scroller ? scroller->role : std::string();
+  std::string scroller_name = scroller ? scroller->name : std::string();
+  if (scroller && !scroller_is_page) {
+    in.scroller = AgentKey(scroller_frame->id, scroller->node_id);
+    in.scroller_x = base::ClampRound(scroller->position_x);
+    in.scroller_y = base::ClampRound(scroller->position_y);
+    // A window goes by its frame element, an element by its own key.
+    const std::string window_token =
+        scroller->is_window ? scroller->frame_id.value_or(std::string())
+                            : std::string();
+    const bool look = !scroller->is_window || !window_token.empty();
+    for (size_t i = 0; look && i < request->composed.size(); ++i) {
+      if (listing_index[i] < 0) {
+        continue;
+      }
+      const auto& ce = request->composed[i];
+      const AgentNodeKey key =
+          AgentKey(ce.local_root_rfh_id, ce.backend_node_id);
+      if (scroller->is_window ? ce.child_frame_token != window_token
+                              : key != *in.scroller) {
+        continue;
+      }
+      in.scroller_named_by = key;
+      scroller_seen = listing_index[i];
+      scroller_role = ce.role;
+      // browser: its name as its own line has it.
+      if (ce.name && !ce.name->empty()) {
+        scroller_name = *ce.name;
+      }
+      break;
+    }
+    if (!scroller->is_window && scroller_seen < 0) {
+      AgentSeenElement seen;
+      seen.key = *in.scroller;
+      seen.place = AgentPlace::kScroller;
+      seen.role = scroller_role;
+      seen.name = scroller_name;
+      in.scroller_named_by = seen.key;
+      scroller_seen = static_cast<int>(in.seen.size());
+      in.seen.push_back(std::move(seen));
+    }
+  }
+  const int unanswered = base::checked_cast<int>(in.unanswered_roots.size());
+  AgentCaptureOut out = space->Apply(std::move(in), live_roots);
+  // Per listed element, by its listing index (the space's `seen` order).
+  const auto id_at = [&out](int k) {
+    return static_cast<size_t>(k) < out.agent_node_ids.size()
+               ? out.agent_node_ids[static_cast<size_t>(k)]
+               : 0;
+  };
+  const auto label_at = [&out](int k) {
+    return static_cast<size_t>(k) < out.labels.size()
+               ? out.labels[static_cast<size_t>(k)]
+               : std::string();
+  };
+
+  std::vector<int> mark_slot(request->composed.size(), -1);
+  std::vector<gfx::RectF> mark_boxes;
+  // browser: the same boxes in DIPs, offset to the kept part of a
+  // clipped image, for a held capture's marks.
+  std::vector<gfx::RectF> mark_dips;
+  std::vector<std::string> mark_labels;
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    // A marked element the space gave no label (its counter ran out) is not
+    // drawn.
+    std::string label = marked[i] ? label_at(listing_index[i]) : std::string();
+    if (label.empty()) {
+      continue;
+    }
+    const auto& ce = request->composed[i];
+    gfx::RectF shown = ce.shown;
+    if (kept) {
+      // Marks on a clipped image: only what the kept part shows, placed in it.
+      shown.Intersect(*kept);
+      if (shown.IsEmpty()) {
+        continue;
+      }
+      shown.Offset(-kept->x(), -kept->y());
+    }
+    mark_slot[i] = static_cast<int>(mark_boxes.size());
+    mark_boxes.emplace_back(shown.x() * scale, shown.y() * scale,
+                            shown.width() * scale, shown.height() * scale);
+    mark_dips.push_back(shown);
+    mark_labels.push_back(std::move(label));
+  }
+  const std::vector<int> mark_colors = AssignAgentMarkColors(mark_boxes, scale);
+
+  std::unique_ptr<Page::AgentRedaction> redaction_reply;
+  if (held) {
+    // browser: kept, with its marks in DIPs, until the matcher answers.
+    auto capture = std::make_unique<AgentHeldCapture>();
+    capture->dsf = dsf;
+    capture->px_per_dip = px_per_dip;
+    capture->scale = scale;
+    capture->encoder = request->encoder;
+    // browser: no marks kept when none are to be drawn; the finish
+    // draws what is kept.
+    if (request->draw_marks) {
+      capture->marks = mark_dips;
+    }
+    capture->labels = mark_labels;
+    capture->colors = mark_colors;
+    capture->root_id = request->root_id;
+    capture->root_document = request->root_document;
+    capture->made_at = base::TimeTicks::Now();
+    capture->bitmap = std::move(request->screenshot_bitmap);
+    capture->frames = std::move(request->redaction);
+    if (kept) {
+      capture->kept_offset = kept->OffsetFromOrigin();
+    }
+    const std::string capture_id = KeepAgentCapture(std::move(capture));
+    redaction_reply = AgentRedactionReply(
+        capture_id, held_captures_.find(capture_id)->second->frames);
+  } else if (has_image) {
+    if (!mark_boxes.empty() && request->draw_marks) {
+      DrawAgentMarks(request->screenshot_bitmap, mark_boxes, mark_labels,
+                     mark_colors, scale);
+    }
+    request->screenshot_bytes =
+        request->encoder.Run(request->screenshot_bitmap);
+  }
+
+  // browser: the entry of `layers` holding a cover met in frame
+  // `frame` that its local root's entry `local` holds; content of a frame in
+  // no entry of its own is held by the page's entry holding that frame, as
+  // `layer` reads (frame_holder). -1: none.
+  const auto held_by = [&](int frame, int local) -> int {
+    if (frame < 0) {
+      return -1;
+    }
+    const size_t k = static_cast<size_t>(frame);
+    const int layer = page_index(k, local);
+    if (layer >= 0 || k == main || k >= frame_holder.size()) {
+      return layer;
+    }
+    return frame_holder[k];
+  };
+  for (size_t i = 0; i < request->composed.size(); ++i) {
+    const auto& ce = request->composed[i];
+    // browser: the listing, as the id space took it above.
+    const int listed = listing_index[i];
+    if (listed < 0) {
+      continue;
+    }
+
+    auto states = std::make_unique<protocol::Array<std::string>>();
+    for (const auto& state : ce.states) {
+      states->emplace_back(state);
+    }
+
+    // Required fields go through the builder; optional ones are set after.
+    // browser: its id and label are the id space's, for its life in the
+    // document.
+    auto element = Page::AgentSnapshotElement::Create()
+                       .SetBackendNodeId(ce.backend_node_id)
+                       .SetAgentNodeId(id_at(listed))
+                       .SetFrameId(ce.frame_id)
+                       .SetRole(ce.role)
+                       .SetTag(ce.tag)
+                       .SetInteractive(ce.interactive)
+                       .SetStates(std::move(states))
+                       .SetX(ce.x)
+                       .SetY(ce.y)
+                       .SetWidth(ce.width)
+                       .SetHeight(ce.height)
+                       .SetInViewport(ce.in_viewport)
+                       .SetObscured(ce.obscured)
+                       .SetMarked(marked[i])
+                       .Build();
+    if (ce.name) {
+      element->SetName(*ce.name);
+    }
+    if (ce.value) {
+      element->SetValue(*ce.value);
+    }
+    if (ce.description) {
+      element->SetDescription(*ce.description);
+    }
+    if (ce.interactive_reason) {
+      element->SetInteractiveReason(*ce.interactive_reason);
+    }
+    if (ce.shadow_host_backend_node_id) {
+      element->SetShadowHostBackendNodeId(*ce.shadow_host_backend_node_id);
+    }
+    if (ce.href) {
+      element->SetHref(*ce.href);
+    }
+    if (ce.src) {
+      element->SetSrc(*ce.src);
+    }
+    if (!ce.invalid.empty()) {
+      element->SetInvalid(
+          std::make_unique<protocol::Array<std::string>>(ce.invalid));
+    }
+    if (ce.error) {
+      element->SetError(*ce.error);
+    }
+    if (!ce.reads.empty()) {
+      element->SetReads(ce.reads);
+    }
+    if (ce.obscured && ce.in_viewport) {
+      element->SetCoveredBy(ce.covered_by);
+    }
+    // browser: every listed element has its label, in view or not.
+    if (std::string label = label_at(listed); !label.empty()) {
+      element->SetLabel(label);
+    }
+    if (mark_slot[i] >= 0) {
+      const int slot = mark_slot[i];
+      element->SetColor(kAgentMarkPalette[mark_colors[slot]].name);
+      // Covered in its own process: it keeps its id, and says what lies over
+      // it.
+      if (!ce.under.empty()) {
+        element->SetCoveredBy(ce.under);
+      }
+    }
+    // browser: shut out by a modal and off-screen (so not marked): the
+    // modal it is behind wherever a reveal brings it, said as its coveredBy
+    // too, with its entry. In view, an unmarked one keeps the cover another
+    // process's test named.
+    const bool shut_unmarked =
+        mark_slot[i] < 0 && !ce.in_viewport && ce.shut_out && !ce.under.empty();
+    if (shut_unmarked) {
+      element->SetCoveredBy(ce.under);
+    }
+
+    if (layers_asked && page_layer_of[i] >= 0) {
+      element->SetLayer(page_layer_of[i]);
+    }
+    // browser: beside coveredBy, the entry its cover lies in -- from
+    // another process by the cover frame's entry, else by the renderer's.
+    if (layers_asked) {
+      int under_layer = -1;
+      if (ce.obscured && ce.in_viewport) {
+        under_layer = held_by(ce.cover_frame, ce.cover_layer);
+      } else if ((mark_slot[i] >= 0 || shut_unmarked) && !ce.under.empty()) {
+        under_layer = held_by(static_cast<int>(ce.frame_index), ce.under_layer);
+      }
+      if (under_layer >= 0) {
+        element->SetUnderLayer(under_layer);
+      }
+    }
+
+    base::StringAppendF(&token_src, ";%d,%.1f,%.1f,%.1f,%.1f",
+                        ce.backend_node_id, ce.x, ce.y, ce.width, ce.height);
+    elements->emplace_back(std::move(element));
+  }
+
+  // The stack and what was left out.
+  std::unique_ptr<protocol::Array<Page::AgentLayer>> layers_reply;
+  std::unique_ptr<protocol::Array<Page::AgentHiddenGroup>> hidden_reply;
+  if (layers_asked) {
+    layers_reply =
+        PageLayersReply(page_layers, layer_frames, &in_counts, &behind_counts);
+  }
+  if (hide) {
+    hidden_reply = std::make_unique<protocol::Array<Page::AgentHiddenGroup>>();
+    for (const HiddenGroup& group : hidden_groups) {
+      std::unique_ptr<Page::AgentHiddenGroup> reply =
+          Page::AgentHiddenGroup::Create()
+              .SetBehind(group.behind)
+              .SetInView(group.in_view)
+              .SetOffscreen(group.offscreen)
+              .Build();
+      if (group.layer >= 0) {
+        reply->SetLayer(group.layer);
+      }
+      hidden_reply->emplace_back(std::move(reply));
+    }
+  }
+
+  // browser: the regions with text, what they said since the last
+  // action, and the delta.
+  auto regions_reply =
+      std::make_unique<protocol::Array<Page::AgentLiveRegion>>();
+  for (size_t r = 0; r < region_reads.size(); ++r) {
+    region_reads[r].region_id =
+        r < out.region_ids.size() ? out.region_ids[r] : 0;
+    if (!region_reads[r].read->text.empty()) {
+      regions_reply->emplace_back(LiveRegionReply(region_reads[r]));
+    }
+  }
+  auto heard_reply = std::make_unique<protocol::Array<Page::AgentHeard>>();
+  for (const auto& frame : request->frames) {
+    if (!frame.snapshot || !frame.view) {
+      continue;
+    }
+    for (const auto& heard : frame.snapshot->heard) {
+      heard_reply->emplace_back(
+          HeardReply(*space, frame.id, frame.frame_id, *heard));
+    }
+  }
+  std::unique_ptr<Page::AgentSnapshotDelta> delta_reply;
+  if (out.delta) {
+    delta_reply = DeltaReply(*out.delta, region_reads);
+  }
+
+  // browser: the main scroller, with its id and label when it has one.
+  // Whether a wheel reaches it is its own process's hit test, and whether the
+  // page shows its frame where that wheel turns: a cover from another process
+  // (a parent's fixed header over a pane in a frame) is not seen.
+  std::unique_ptr<Page::AgentSnapshotScroller> scroller_reply;
+  if (scroller) {
+    scroller_reply =
+        Page::AgentSnapshotScroller::Create()
+            .SetPositionX(scroller->position_x)
+            .SetPositionY(scroller->position_y)
+            .SetMaxX(scroller->max_x)
+            .SetMaxY(scroller->max_y)
+            .SetLengthX(scroller->length_x)
+            .SetLengthY(scroller->length_y)
+            .SetX(scroller_box.x())
+            .SetY(scroller_box.y())
+            .SetWidth(scroller_box.width())
+            .SetHeight(scroller_box.height())
+            .SetIsPage(scroller_is_page)
+            .SetWheelReaches(scroller->wheel_reaches &&
+                             scroller_frame->shown.Contains(scroller_aim))
+            .Build();
+    if (!scroller_name.empty()) {
+      scroller_reply->SetName(scroller_name);
+    }
+    if (!scroller_role.empty()) {
+      scroller_reply->SetRole(scroller_role);
+    }
+    if (layers_asked && scroller_layer >= 0) {
+      scroller_reply->SetLayer(scroller_layer);
+    }
+    if (layers_asked && scroller_under >= 0 &&
+        scroller_under > scroller_layer) {
+      scroller_reply->SetUnderLayer(scroller_under);
+    }
+    if (const int id = scroller_seen >= 0 ? id_at(scroller_seen) : 0; id != 0) {
+      scroller_reply->SetAgentNodeId(id);
+      if (std::string label = label_at(scroller_seen); !label.empty()) {
+        scroller_reply->SetLabel(label);
+      }
+    }
+  }
+
+  std::string snapshot_token =
+      base::StringPrintf("%08x", base::PersistentHash(token_src));
+
+  std::optional<Binary> screenshot;
+  if (request->include_screenshot && request->screenshot_bytes) {
+    screenshot = Binary::fromVector(std::move(*request->screenshot_bytes));
+    // The image's pixels per CSS px.
+    viewport->SetScreenshotScale(scale);
+  }
+
+  request->callback->sendSuccess(
+      request->url, request->title, std::move(viewport), std::move(elements),
+      std::move(screenshot), snapshot_token, std::move(layers_reply),
+      std::move(hidden_reply), out.listing_id, space->document_id(),
+      out.baseline, std::move(delta_reply), std::move(regions_reply),
+      std::move(heard_reply), unanswered, std::move(redaction_reply),
+      request->withheld,
+      request->frames_blacked > 0 ? std::optional<int>(request->frames_blacked)
+                                  : std::nullopt,
+      std::move(scroller_reply),
+      locked_behind_layer >= 0 ? std::optional<int>(locked_behind_layer)
+                               : std::nullopt,
+      document_locked ? std::optional<bool>(true) : std::nullopt,
+      request->brought_forward ? std::optional<bool>(true) : std::nullopt,
+      request->elements_cut > 0 ? std::optional<int>(request->elements_cut)
+                                : std::nullopt);
+}
+
+// browser: the id space of the page's document, on its frame's current
+// host (not `host_`, which is already the speculative host between
+// ready-to-commit and the commit); null when it has none.
+AgentIdSpace* PageHandler::CurrentAgentIdSpace() {
+  return host_
+             ? AgentIdSpace::Get(host_->frame_tree_node()->current_frame_host())
+             : nullptr;
+}
+
+// browser: Page.agentNodesAlive. Each id and label is looked up in the
+// document's id space; a node of a local root still in the page is asked of
+// that local root (one call per root, a 1 s deadline), and the rest are
+// answered from the space. No script runs in the page.
+void PageHandler::AgentNodesAlive(
+    std::unique_ptr<protocol::Array<int>> agent_node_ids,
+    std::unique_ptr<protocol::Array<std::string>> labels,
+    std::optional<bool> layers,
+    std::unique_ptr<AgentNodesAliveCallback> callback) {
+  if (!host_) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  if (!CanExecuteGlobalCommands(this, callback)) {
+    return;
+  }
+  AgentIdSpace* space =
+      AgentIdSpace::GetOrCreate(host_->frame_tree_node()->current_frame_host());
+  auto request = base::MakeRefCounted<AgentNodesAliveRequest>();
+  request->callback = std::move(callback);
+  request->document_id = space->document_id();
+  // The last answer's node, when it is of a local root still in the page, is
+  // asked of that root. One that left the page, or sits in the back-forward
+  // cache (frozen: it never answers), is gone; nothing is bound there.
+  const auto ask = [&request](const AgentIdEntry& entry) {
+    const size_t slot = request->nodes->size() - 1;
+    RenderFrameHostImpl* rfh =
+        RenderFrameHostImpl::FromID(entry.key.local_root);
+    if (!rfh || !rfh->IsActive() || !rfh->IsRenderFrameLive() ||
+        !rfh->is_local_root()) {
+      (*request->nodes)[slot]->SetState("gone");
+      return;
+    }
+    AgentNodesAliveRequest::Ask* asked = nullptr;
+    for (AgentNodesAliveRequest::Ask& kept : request->asks) {
+      if (kept.local_root == entry.key.local_root) {
+        asked = &kept;
+        break;
+      }
+    }
+    if (!asked) {
+      asked = &request->asks.emplace_back();
+      asked->local_root = entry.key.local_root;
+    }
+    size_t node = 0;
+    while (node < asked->node_ids.size() &&
+           asked->node_ids[node] != entry.key.dom_node_id) {
+      ++node;
+    }
+    if (node == asked->node_ids.size()) {
+      asked->node_ids.push_back(entry.key.dom_node_id);
+      asked->slots.emplace_back();
+    }
+    asked->slots[node].push_back(slot);
+  };
+  // One answer per id, then per label, in order; each names what was asked.
+  if (agent_node_ids) {
+    for (int id : *agent_node_ids) {
+      const AgentIdEntry* entry = space->Find(id);
+      request->nodes->push_back(entry ? FoundNodeLife(*entry)
+                                      : PastNodeLife(space->Past(id)));
+      request->nodes->back()->SetAgentNodeId(id);
+      request->behind_of.push_back(entry ? entry->behind : std::nullopt);
+      if (entry) {
+        ask(*entry);
+      }
+    }
+  }
+  if (labels) {
+    for (const std::string& label : *labels) {
+      const AgentIdEntry* entry = space->FindLabel(label);
+      request->nodes->push_back(entry ? FoundNodeLife(*entry)
+                                      : PastNodeLife(space->PastLabel(label)));
+      request->nodes->back()->SetLabel(label);
+      request->behind_of.push_back(entry ? entry->behind : std::nullopt);
+      if (entry) {
+        ask(*entry);
+      }
+    }
+  }
+  // browser: with layers, the page's stack too, from the frames that
+  // show (LayerFrameShows), each given 300 ms.
+  if (layers.value_or(false)) {
+    request->layers = true;
+    RenderWidgetHostImpl* widget = host_->GetRenderWidgetHost();
+    const gfx::Size view = widget && widget->GetView()
+                               ? widget->GetView()->GetViewBounds().size()
+                               : gfx::Size();
+    for (RenderFrameHostImpl* rfh :
+         LiveLocalRoots(host_->frame_tree_node()->current_frame_host())) {
+      if (!LayerFrameShows(*rfh, view)) {
+        request->unshown.push_back(rfh->GetDevToolsFrameToken().ToString());
+        continue;
+      }
+      AgentNodesAliveRequest::LayerAsk layer_ask;
+      layer_ask.rfh = rfh->GetWeakPtr();
+      layer_ask.frame_id = rfh->GetDevToolsFrameToken().ToString();
+      request->layer_asks.push_back(std::move(layer_ask));
+    }
+  }
+  if (request->asks.empty() && request->layer_asks.empty()) {
+    OnAgentNodesAliveRead(std::move(request));
+    return;
+  }
+  // Each barrier with nothing to wait for comes in at once.
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      request->asks.size(),
+      base::BindOnce(&PageHandler::OnAgentNodesAlivePart,
+                     weak_factory_.GetWeakPtr(), request, /*nodes=*/true));
+  base::RepeatingClosure layer_barrier = base::BarrierClosure(
+      request->layer_asks.size(),
+      base::BindOnce(&PageHandler::OnAgentNodesAlivePart,
+                     weak_factory_.GetWeakPtr(), request, /*nodes=*/false));
+  for (size_t f = 0; f < request->layer_asks.size(); ++f) {
+    RenderFrameHostImpl* rfh = request->layer_asks[f].rfh.get();
+    service_manager::InterfaceProvider* remotes =
+        rfh ? rfh->GetRemoteInterfaces() : nullptr;
+    if (!remotes) {
+      layer_barrier.Run();
+      continue;
+    }
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+    remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+    auto options = blink::mojom::AgentSnapshotOptions::New();
+    options->offscreen_mode = blink::mojom::AgentOffscreenMode::kNone;
+    options->layer_scope = blink::mojom::AgentLayerScope::kAll;
+    options->layers_only = true;
+    // A dropped pipe still advances the barrier, its stack unread.
+    collector->CollectFrameElements(
+        std::move(options),
+        mojo::WrapCallbackWithDropHandler(
+            base::BindOnce(
+                [](scoped_refptr<AgentNodesAliveRequest> request, size_t f,
+                   base::RepeatingClosure barrier,
+                   blink::mojom::AgentFrameSnapshotPtr snapshot) {
+                  request->layer_asks[f].snapshot = std::move(snapshot);
+                  barrier.Run();
+                },
+                request, f, layer_barrier),
+            layer_barrier));
+    request->collectors.push_back(std::move(collector));
+  }
+  // A frame that misses the layers' 300 ms leaves its stack unread.
+  if (!request->layer_asks.empty()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&PageHandler::OnAgentNodesAlivePart,
+                       weak_factory_.GetWeakPtr(), request, /*nodes=*/false),
+        kAgentQuickReadWait);
+  }
+  for (size_t a = 0; a < request->asks.size(); ++a) {
+    RenderFrameHostImpl* rfh =
+        RenderFrameHostImpl::FromID(request->asks[a].local_root);
+    service_manager::InterfaceProvider* remotes =
+        rfh ? rfh->GetRemoteInterfaces() : nullptr;
+    if (!remotes) {
+      barrier.Run();
+      continue;
+    }
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+    remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+    // A dropped pipe still advances the barrier, its answers left unknown.
+    collector->NodesAlive(
+        request->asks[a].node_ids,
+        mojo::WrapCallbackWithDropHandler(
+            base::BindOnce(
+                [](scoped_refptr<AgentNodesAliveRequest> request, size_t a,
+                   base::RepeatingClosure barrier,
+                   std::vector<blink::mojom::AgentNodeStatePtr> nodes) {
+                  request->asks[a].reply = std::move(nodes);
+                  barrier.Run();
+                },
+                request, a, barrier),
+            barrier));
+    request->collectors.push_back(std::move(collector));
+  }
+  // A local root that misses the deadline leaves its answers unknown.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PageHandler::OnAgentNodesAliveRead,
+                     weak_factory_.GetWeakPtr(), request),
+      base::Seconds(1));
+}
+
+void PageHandler::OnAgentNodesAliveRead(
+    scoped_refptr<AgentNodesAliveRequest> request) {
+  if (!request->callback) {
+    return;
+  }
+  std::unique_ptr<AgentNodesAliveCallback> callback =
+      std::move(request->callback);
+  // The replies still out are dropped once this is answered.
+  std::vector<mojo::Remote<blink::mojom::AgentSnapshotCollector>> collectors =
+      std::move(request->collectors);
+  for (const AgentNodesAliveRequest::Ask& asked : request->asks) {
+    for (const blink::mojom::AgentNodeStatePtr& state : asked.reply) {
+      const auto node = std::ranges::find(asked.node_ids, state->node_id);
+      if (node == asked.node_ids.end()) {
+        continue;
+      }
+      for (size_t slot :
+           asked.slots[static_cast<size_t>(node - asked.node_ids.begin())]) {
+        FillNodeLife(*(*request->nodes)[slot], *state);
+      }
+    }
+  }
+  // browser: the stack read with it. Each node placed behind a layer
+  // learns whether that layer is open now (unless its frame was not read).
+  // browser: the stack is not kept as the document's last one: this
+  // read tells nothing of what opened or closed, so the call-start read with
+  // layers, or the next report, still tells it.
+  if (request->layers) {
+    std::vector<LayerFrame> frames;
+    base::flat_set<std::string> unread(request->unshown.begin(),
+                                       request->unshown.end());
+    for (const AgentNodesAliveRequest::LayerAsk& asked : request->layer_asks) {
+      if (asked.rfh && asked.snapshot) {
+        frames.push_back({asked.rfh.get(), asked.frame_id, asked.snapshot.get(),
+                          /*shows=*/true});
+      } else if (asked.rfh) {
+        unread.insert(asked.frame_id);
+      }
+    }
+    const AgentLastLayers now =
+        LastLayersOf(AssemblePageLayers(frames), frames);
+    for (size_t n = 0;
+         n < request->behind_of.size() && n < request->nodes->size(); ++n) {
+      const std::optional<AgentLayerRefData>& behind = request->behind_of[n];
+      if (!behind || unread.contains(behind->frame_id)) {
+        continue;
+      }
+      (*request->nodes)[n]->SetBehindOpen(
+          std::ranges::any_of(now.layers, [&](const AgentLastLayer& open) {
+            return open.frame_id == behind->frame_id &&
+                   open.node_id == behind->node_id;
+          }));
+    }
+  }
+  callback->sendSuccess(request->document_id, std::move(request->nodes));
+}
+
+// browser: the nodes, or the layers, are in (every reply, or the
+// layers' 300 ms); the answer goes once both are.
+void PageHandler::OnAgentNodesAlivePart(
+    scoped_refptr<AgentNodesAliveRequest> request,
+    bool nodes) {
+  (nodes ? request->nodes_in : request->layers_in) = true;
+  if (request->nodes_in && request->layers_in) {
+    OnAgentNodesAliveRead(std::move(request));
+  }
+}
+
+// browser: Page.agentAnnouncements. Every live local root is asked for
+// its live regions, with a 300 ms deadline; one that misses it is left out and
+// counted in unansweredFrames. browser: with layers, the stack of the
+// frames that show too, in the same deadline, judged and kept as the baseline.
+void PageHandler::AgentAnnouncements(
+    std::optional<bool> layers,
+    std::unique_ptr<AgentAnnouncementsCallback> callback) {
+  if (!host_) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  if (!CanExecuteGlobalCommands(this, callback)) {
+    return;
+  }
+  RenderFrameHostImpl* root = host_->frame_tree_node()->current_frame_host();
+  auto request = base::MakeRefCounted<AgentAnnouncementsRequest>();
+  request->callback = std::move(callback);
+  request->root_id = root->GetGlobalId();
+  request->root_document = root->GetDocumentToken();
+  for (RenderFrameHostImpl* rfh : LiveLocalRoots(root)) {
+    AgentAnnouncementsRequest::Frame frame;
+    frame.id = rfh->GetGlobalId();
+    frame.frame_id = rfh->GetDevToolsFrameToken().ToString();
+    request->frames.push_back(std::move(frame));
+  }
+  // browser: with layers, the page's stack too, from the frames that
+  // show (LayerFrameShows), within the regions' deadline.
+  if (layers.value_or(false)) {
+    request->layers = true;
+    RenderWidgetHostImpl* widget = host_->GetRenderWidgetHost();
+    const gfx::Size view = widget && widget->GetView()
+                               ? widget->GetView()->GetViewBounds().size()
+                               : gfx::Size();
+    for (RenderFrameHostImpl* rfh : LiveLocalRoots(root)) {
+      if (!LayerFrameShows(*rfh, view)) {
+        request->unshown.push_back(rfh->GetDevToolsFrameToken().ToString());
+        continue;
+      }
+      AgentNodesAliveRequest::LayerAsk layer_ask;
+      layer_ask.rfh = rfh->GetWeakPtr();
+      layer_ask.frame_id = rfh->GetDevToolsFrameToken().ToString();
+      request->layer_asks.push_back(std::move(layer_ask));
+    }
+  }
+  if (request->frames.empty()) {
+    OnAgentAnnouncementsRead(std::move(request));
+    return;
+  }
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      request->frames.size() + request->layer_asks.size(),
+      base::BindOnce(&PageHandler::OnAgentAnnouncementsRead,
+                     weak_factory_.GetWeakPtr(), request));
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    RenderFrameHostImpl* rfh =
+        RenderFrameHostImpl::FromID(request->frames[i].id);
+    service_manager::InterfaceProvider* remotes =
+        rfh ? rfh->GetRemoteInterfaces() : nullptr;
+    if (!remotes) {
+      barrier.Run();
+      continue;
+    }
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+    remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+    // A dropped pipe still advances the barrier, unanswered.
+    collector->LiveRegions(mojo::WrapCallbackWithDropHandler(
+        base::BindOnce(
+            [](scoped_refptr<AgentAnnouncementsRequest> request, size_t i,
+               base::RepeatingClosure barrier,
+               std::vector<blink::mojom::AgentRegionReadPtr> regions,
+               std::vector<blink::mojom::AgentHeardReadPtr> heard) {
+              AgentAnnouncementsRequest::Frame& frame = request->frames[i];
+              frame.answered = true;
+              frame.regions = std::move(regions);
+              frame.heard = std::move(heard);
+              barrier.Run();
+            },
+            request, i, barrier),
+        barrier));
+    request->collectors.push_back(std::move(collector));
+  }
+  // browser: each stack as agentNodesAlive reads it; a dropped pipe
+  // still advances the barrier, its stack unread.
+  for (size_t f = 0; f < request->layer_asks.size(); ++f) {
+    RenderFrameHostImpl* rfh = request->layer_asks[f].rfh.get();
+    service_manager::InterfaceProvider* remotes =
+        rfh ? rfh->GetRemoteInterfaces() : nullptr;
+    if (!remotes) {
+      barrier.Run();
+      continue;
+    }
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+    remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+    auto options = blink::mojom::AgentSnapshotOptions::New();
+    options->offscreen_mode = blink::mojom::AgentOffscreenMode::kNone;
+    options->layer_scope = blink::mojom::AgentLayerScope::kAll;
+    options->layers_only = true;
+    collector->CollectFrameElements(
+        std::move(options),
+        mojo::WrapCallbackWithDropHandler(
+            base::BindOnce(
+                [](scoped_refptr<AgentAnnouncementsRequest> request, size_t f,
+                   base::RepeatingClosure barrier,
+                   blink::mojom::AgentFrameSnapshotPtr snapshot) {
+                  request->layer_asks[f].snapshot = std::move(snapshot);
+                  barrier.Run();
+                },
+                request, f, barrier),
+            barrier));
+    request->collectors.push_back(std::move(collector));
+  }
+  // A local root that misses the deadline is left out, and counted.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PageHandler::OnAgentAnnouncementsRead,
+                     weak_factory_.GetWeakPtr(), request),
+      kAgentQuickReadWait);
+}
+
+void PageHandler::OnAgentAnnouncementsRead(
+    scoped_refptr<AgentAnnouncementsRequest> request) {
+  if (!request->callback) {
+    return;
+  }
+  std::unique_ptr<AgentAnnouncementsCallback> callback =
+      std::move(request->callback);
+  // The replies still out are dropped once this is answered.
+  std::vector<mojo::Remote<blink::mojom::AgentSnapshotCollector>> collectors =
+      std::move(request->collectors);
+  // The document read must still be the page's. After a navigation meanwhile
+  // nothing read is told: every frame counts as unanswered, in the new
+  // document's space.
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(request->root_id);
+  const bool same_document =
+      root && root->frame_tree_node()->current_frame_host() == root &&
+      root->GetDocumentToken() == request->root_document;
+  if (!same_document) {
+    root = host_ ? host_->frame_tree_node()->current_frame_host() : nullptr;
+  }
+  if (!root) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  AgentIdSpace* space = AgentIdSpace::GetOrCreate(root);
+  auto regions = std::make_unique<protocol::Array<Page::AgentLiveRegion>>();
+  auto heard = std::make_unique<protocol::Array<Page::AgentHeard>>();
+  int unanswered = 0;
+  for (const AgentAnnouncementsRequest::Frame& frame : request->frames) {
+    if (!same_document || !frame.answered) {
+      ++unanswered;
+      continue;
+    }
+    for (const blink::mojom::AgentRegionReadPtr& region : frame.regions) {
+      if (region->text.empty()) {
+        continue;
+      }
+      RegionReply reply;
+      reply.region_id = space->RegionIdFor(AgentKey(frame.id, region->node_id));
+      reply.frame_id = frame.frame_id;
+      reply.read = region.get();
+      regions->emplace_back(LiveRegionReply(reply));
+    }
+    for (const blink::mojom::AgentHeardReadPtr& entry : frame.heard) {
+      heard->emplace_back(HeardReply(*space, frame.id, frame.frame_id, *entry));
+    }
+  }
+  // browser: the stack read with it, judged against the document's
+  // last one as a report judges it, then kept as the next one's baseline.
+  // Nothing is judged after a navigation meanwhile, nor when the document had
+  // no stack read before: the next report then tells every layer open.
+  std::unique_ptr<protocol::Array<Page::AgentLayer>> stack;
+  LayerChanges changes;
+  if (request->layers && same_document && space->last_layers()) {
+    std::vector<LayerFrame> layer_frames;
+    base::flat_set<std::string> unread(request->unshown.begin(),
+                                       request->unshown.end());
+    for (const AgentNodesAliveRequest::LayerAsk& asked : request->layer_asks) {
+      if (asked.rfh && asked.snapshot) {
+        layer_frames.push_back({asked.rfh.get(), asked.frame_id,
+                                asked.snapshot.get(), /*shows=*/true});
+      } else if (asked.rfh) {
+        unread.insert(asked.frame_id);
+      }
+    }
+    const PageLayers page = AssemblePageLayers(layer_frames);
+    stack = PageLayersReply(page, layer_frames, nullptr, nullptr);
+    AgentLastLayers now = LastLayersOf(page, layer_frames);
+    changes = LayerChangesSince(now, *space->last_layers(), unread);
+    space->SetLastLayers(
+        WithUnreadLayers(std::move(now), space->last_layers(), unread));
+  }
+  callback->sendSuccess(space->document_id(), std::move(regions),
+                        std::move(heard), unanswered, std::move(stack),
+                        std::move(changes.opened), std::move(changes.closed),
+                        std::move(changes.reworded));
+}
+
+// browser: a call answered from the page, once: by its reply, which
+// carries this through each step, or, when none has come within
+// kAgentCollectWait, by the deadline, after which a reply finds no
+// callback and is dropped. Owned by the pending reply; once the handler
+// is gone, the deadline answers nothing.
+template <typename Callback>
+class PageHandler::AgentReplyWait {
+ public:
+  AgentReplyWait(std::unique_ptr<Callback> callback,
+                 base::WeakPtr<PageHandler> handler)
+      : callback_(std::move(callback)), handler_(std::move(handler)) {
+    timer_.Start(
+        FROM_HERE, kAgentCollectWait,
+        base::BindOnce(&AgentReplyWait::OnDeadline, base::Unretained(this)));
+  }
+  AgentReplyWait(const AgentReplyWait&) = delete;
+  AgentReplyWait& operator=(const AgentReplyWait&) = delete;
+  ~AgentReplyWait() = default;
+
+  // The call's callback; null once the deadline has answered.
+  Callback* callback() { return callback_.get(); }
+
+ private:
+  void OnDeadline() {
+    if (callback_ && handler_) {
+      callback_->sendFailure(Response::ServerError("the page did not answer"));
+    }
+    callback_.reset();
+  }
+
+  std::unique_ptr<Callback> callback_;
+  const base::WeakPtr<PageHandler> handler_;
+  base::OneShotTimer timer_;
+};
+
+// browser: Page.resolveAgentNode.
+void PageHandler::ResolveAgentNode(
+    int agent_node_id,
+    std::unique_ptr<ResolveAgentNodeCallback> callback) {
+  // browser: any id of the page's document.
+  AgentIdSpace* space = CurrentAgentIdSpace();
+  const AgentIdEntry* found = space ? space->Find(agent_node_id) : nullptr;
+  if (!found) {
+    SendAgentNodeNotFound(*callback);
+    return;
+  }
+  const AgentNodeKey entry = found->key;
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(entry.local_root);
+  // browser: only a document still in the page: one in the back-forward
+  // cache (the click before this navigated) is frozen, and never answers.
+  service_manager::InterfaceProvider* remotes =
+      rfh && rfh->IsActive() && rfh->IsRenderFrameLive()
+          ? rfh->GetRemoteInterfaces()
+          : nullptr;
+  if (!remotes) {
+    SendAgentNodeNotFound(*callback);
+    return;
+  }
+
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+  remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+  // The proxy pointer is read before the Remote moves into the reply
+  // callback, which keeps the pipe alive until the reply. A dropped pipe
+  // still answers found=false instead of hanging.
+  blink::mojom::AgentSnapshotCollector* raw = collector.get();
+  // browser: answered once: by the reply, or at kAgentCollectWait.
+  auto wait = std::make_unique<AgentNodeWait>(std::move(callback),
+                                              weak_factory_.GetWeakPtr());
+  raw->ResolveNode(entry.dom_node_id,
+                   mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                       base::BindOnce(&PageHandler::OnAgentNodeResolved,
+                                      weak_factory_.GetWeakPtr(),
+                                      std::move(wait), entry.local_root,
+                                      entry.dom_node_id, std::move(collector)),
+                       /*found=*/false, /*box=*/nullptr));
+}
+
+void PageHandler::OnAgentNodeResolved(
+    std::unique_ptr<AgentNodeWait> wait,
+    GlobalRenderFrameHostId local_root_rfh_id,
+    int32_t dom_node_id,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    bool found,
+    blink::mojom::AgentElementBoxPtr box) {
+  // browser: answered at kAgentCollectWait already: dropped.
+  ResolveAgentNodeCallback* const callback = wait->callback();
+  if (!callback) {
+    return;
+  }
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(local_root_rfh_id);
+  // browser: and still in the page once it answered.
+  if (!found || !box || !rfh || !rfh->IsActive() || !rfh->IsRenderFrameLive() ||
+      !rfh->GetView()) {
+    SendAgentNodeNotFound(*callback);
+    return;
+  }
+
+  // Same composition as the capture path: the top-left goes through the
+  // frame's widget view (identity for the main frame, the true root
+  // transform for an OOPIF's child-frame view); width and height are kept.
+  auto* view = static_cast<RenderWidgetHostViewBase*>(rfh->GetView());
+  gfx::PointF top_left =
+      view->TransformPointToRootCoordSpaceF(gfx::PointF(box->x, box->y));
+  // The identity as well as the box: a box only says where an element is, and
+  // a hit test at it finds whatever is on top there -- an <option> instead of
+  // its <select multiple>, the button under a pointer-events:none link, a
+  // frame-local node compared against root-space geometry. backendNodeId is
+  // the DOMNodeIds id the collector registered; localRootFrameId names the
+  // DevTools session that can resolve it.
+  callback->sendSuccess(/*found=*/true, top_left.x(), top_left.y(), box->width,
+                        box->height, dom_node_id,
+                        rfh->GetDevToolsFrameToken().ToString());
+}
+
+// browser: the local root of the frame a DevTools frame token names in this
+// page; null when there is none.
+RenderFrameHostImpl* PageHandler::LocalRootByFrameToken(
+    const std::string& frame_id) {
+  FrameTreeNode* node = host_ ? FrameTreeNodeFromDevToolsFrameToken(
+                                    host_->frame_tree_node(), frame_id)
+                              : nullptr;
+  RenderFrameHostImpl* rfh = node ? node->current_frame_host() : nullptr;
+  while (rfh && !rfh->is_local_root()) {
+    rfh = rfh->GetParent();
+  }
+  return rfh;
+}
+
+// browser: Page.agentHitCheck. The point is routed exactly as a mousedown is:
+// GetRenderWidgetHostAtPointAsynchronously runs the same viz hit test that
+// RenderWidgetHostInputEventRouter runs for a press with no capture. When the
+// press would go to the element's own local root, that renderer runs the hit
+// test a real press runs and says what it reaches. No script runs in the page,
+// and a closed shadow root, an inert subtree or a frame boundary is seen as
+// the press sees it. An element named by its node and frame is checked the
+// same way in that frame's local root.
+void PageHandler::AgentHitCheck(
+    std::optional<int> agent_node_id,
+    double x,
+    double y,
+    std::optional<int> backend_node_id,
+    std::optional<std::string> frame_id,
+    std::unique_ptr<AgentHitCheckCallback> callback) {
+  AgentNodeKey entry;
+  // A frame element's: the DevTools token of the frame it holds, in this
+  // process or another; a hit in that frame's view, or in the view of a frame
+  // inside it, reaches it.
+  std::string child_frame_id;
+  if (agent_node_id.has_value()) {
+    // browser: any id of the page's document.
+    AgentIdSpace* space = CurrentAgentIdSpace();
+    const AgentIdEntry* found = space ? space->Find(*agent_node_id) : nullptr;
+    if (!found) {
+      callback->sendSuccess("gone", std::nullopt, std::nullopt);
+      return;
+    }
+    entry = found->key;
+    child_frame_id = found->child_frame_id;
+  } else if (backend_node_id.has_value() && frame_id.has_value()) {
+    RenderFrameHostImpl* rfh = LocalRootByFrameToken(*frame_id);
+    if (!rfh) {
+      callback->sendFailure(
+          Response::InvalidParams("No frame with the given 'frameId'"));
+      return;
+    }
+    entry.local_root = rfh->GetGlobalId();
+    entry.dom_node_id = *backend_node_id;
+  } else {
+    callback->sendFailure(Response::InvalidParams(
+        "agentNodeId, or backendNodeId with frameId, is required"));
+    return;
+  }
+  RenderWidgetHostDelegate* delegate =
+      host_ && host_->GetRenderWidgetHost()
+          ? host_->GetRenderWidgetHost()->delegate()
+          : nullptr;
+  auto* root_view =
+      host_ ? static_cast<RenderWidgetHostViewBase*>(host_->GetView())
+            : nullptr;
+  if (!delegate || !delegate->GetInputEventRouter() || !root_view) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  // browser: answered once: by the reply, or at kAgentCollectWait.
+  auto wait = std::make_unique<AgentHitWait>(std::move(callback),
+                                             weak_factory_.GetWeakPtr());
+  // Root-viewport CSS px are DIPs at page and pinch scale 1, as for the
+  // snapshot's own boxes (see the TODO in the capture path).
+  delegate->GetRenderWidgetHostAtPointAsynchronously(
+      root_view, gfx::PointF(x, y),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&PageHandler::OnAgentHitTarget,
+                         weak_factory_.GetWeakPtr(), std::move(wait),
+                         entry.local_root, entry.dom_node_id, child_frame_id,
+                         /*frame_asked=*/agent_node_id.has_value()),
+          base::WeakPtr<RenderWidgetHostViewBase>(),
+          std::optional<gfx::PointF>()));
+}
+
+void PageHandler::OnAgentHitTarget(
+    std::unique_ptr<AgentHitWait> wait,
+    GlobalRenderFrameHostId local_root_rfh_id,
+    int32_t dom_node_id,
+    std::string child_frame_id,
+    bool frame_asked,
+    base::WeakPtr<RenderWidgetHostViewBase> target_view,
+    std::optional<gfx::PointF> transformed_point) {
+  // browser: answered at kAgentCollectWait already: dropped.
+  AgentHitCheckCallback* const callback = wait->callback();
+  if (!callback) {
+    return;
+  }
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(local_root_rfh_id);
+  // browser: only a document still in the page: one in the back-forward
+  // cache (the click before this navigated) is frozen, and never answers.
+  if (!rfh || !rfh->IsActive() || !rfh->IsRenderFrameLive() ||
+      !rfh->GetView()) {
+    callback->sendSuccess("gone", std::nullopt, std::nullopt);
+    return;
+  }
+  if (!target_view || !transformed_point.has_value()) {
+    callback->sendFailure(
+        Response::ServerError("The point could not be hit-tested"));
+    return;
+  }
+  // A press there goes to another frame process's content, so it can never
+  // reach the element -- unless that is the frame the element holds, or one
+  // inside it: a press on a frame is a press on what it holds.
+  if (target_view.get() !=
+      static_cast<RenderWidgetHostViewBase*>(rfh->GetView())) {
+    // browser: an element named by its node (a selector's match) comes
+    // with no frame: its renderer says, once, whether it is a frame element
+    // and which frame it holds, and the hit is judged with that -- for a hit
+    // inside its own local root's view, where that frame is.
+    if (!frame_asked && input::RenderWidgetHostViewInput::IsAncestorView(
+                            target_view.get(), rfh->GetView())) {
+      if (service_manager::InterfaceProvider* own =
+              rfh->GetRemoteInterfaces()) {
+        mojo::Remote<blink::mojom::AgentSnapshotCollector> asker;
+        own->GetInterface(asker.BindNewPipeAndPassReceiver());
+        // Read before the Remote moves into the reply callback, which keeps
+        // the pipe alive until the reply.
+        blink::mojom::AgentSnapshotCollector* ask = asker.get();
+        ask->AimPiece(
+            dom_node_id, 0, 0, /*with_hand=*/false,
+            mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                base::BindOnce(&PageHandler::OnAgentFrameOf,
+                               weak_factory_.GetWeakPtr(), std::move(wait),
+                               local_root_rfh_id, dom_node_id,
+                               std::move(target_view),
+                               std::move(transformed_point), std::move(asker)),
+                blink::mojom::AgentAimPiecePtr()));
+        return;
+      }
+    }
+    if (!child_frame_id.empty()) {
+      FrameTreeNode* node = FrameTreeNodeFromDevToolsFrameToken(
+          rfh->frame_tree_node(), child_frame_id);
+      RenderFrameHostImpl* child = node ? node->current_frame_host() : nullptr;
+      RenderWidgetHostViewBase* own =
+          child && child->is_local_root() && child->IsRenderFrameLive()
+              ? child->GetView()
+              : nullptr;
+      if (own && (target_view.get() == own ||
+                  input::RenderWidgetHostViewInput::IsAncestorView(
+                      target_view.get(), own))) {
+        callback->sendSuccess("reached", std::nullopt, std::nullopt);
+        return;
+      }
+      // Its frame in this process, holding another process's: a hit in that
+      // one's view lands in what it holds too.
+      if (node && !own) {
+        RenderFrameHostImpl* hit_root = nullptr;
+        if (host_) {
+          host_->ForEachRenderFrameHostImpl(
+              [&hit_root, &target_view](RenderFrameHostImpl* frame) {
+                if (!hit_root && frame->is_local_root() &&
+                    frame->IsRenderFrameLive() &&
+                    frame->GetView() == target_view.get()) {
+                  hit_root = frame;
+                }
+              });
+        }
+        if (LandsInFrame(hit_root, node)) {
+          callback->sendSuccess("reached", std::nullopt, std::nullopt);
+          return;
+        }
+      }
+    }
+    // What it is, asked in the frame it belongs to.
+    RenderFrameHostImpl* over = nullptr;
+    RenderWidgetHostViewBase* over_view = target_view.get();
+    if (host_) {
+      host_->ForEachRenderFrameHostImpl(
+          [&over, over_view](RenderFrameHostImpl* frame) {
+            if (!over && frame->is_local_root() && frame->IsRenderFrameLive() &&
+                frame->GetView() == over_view) {
+              over = frame;
+            }
+          });
+    }
+    const bool page = IsPageDocument(over);
+    service_manager::InterfaceProvider* over_remotes =
+        over ? over->GetRemoteInterfaces() : nullptr;
+    if (!over_remotes) {
+      callback->sendSuccess(page ? "covered" : "otherFrame",
+                            CoverName(page, std::string()), std::nullopt);
+      return;
+    }
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> describer;
+    over_remotes->GetInterface(describer.BindNewPipeAndPassReceiver());
+    blink::mojom::AgentSnapshotCollector* describe = describer.get();
+    describe->DescribePoint(
+        transformed_point->x(), transformed_point->y(), std::vector<int32_t>(),
+        /*place=*/true,
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&PageHandler::OnAgentCoverNamed,
+                           weak_factory_.GetWeakPtr(), std::move(wait),
+                           std::move(describer), page),
+            std::string(), 0, std::string()));
+    return;
+  }
+  service_manager::InterfaceProvider* remotes = rfh->GetRemoteInterfaces();
+  if (!remotes) {
+    callback->sendSuccess("gone", std::nullopt, std::nullopt);
+    return;
+  }
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+  remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+  // The proxy pointer is read before the Remote moves into the reply
+  // callback, which keeps the pipe alive until the reply.
+  blink::mojom::AgentSnapshotCollector* raw = collector.get();
+  raw->HitCheck(dom_node_id, transformed_point->x(), transformed_point->y(),
+                mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                    base::BindOnce(&PageHandler::OnAgentHitChecked,
+                                   weak_factory_.GetWeakPtr(), std::move(wait),
+                                   std::move(collector)),
+                    std::string("gone"), std::string(), std::string()));
+}
+
+void PageHandler::OnAgentFrameOf(
+    std::unique_ptr<AgentHitWait> wait,
+    GlobalRenderFrameHostId local_root_rfh_id,
+    int32_t dom_node_id,
+    base::WeakPtr<RenderWidgetHostViewBase> target_view,
+    std::optional<gfx::PointF> transformed_point,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    blink::mojom::AgentAimPiecePtr piece) {
+  // browser: answered at kAgentCollectWait already: dropped.
+  AgentHitCheckCallback* const callback = wait->callback();
+  if (!callback) {
+    return;
+  }
+  // The view the press went to went meanwhile: another frame's, as before.
+  if (!target_view) {
+    callback->sendSuccess("otherFrame", CoverName(false, std::string()),
+                          std::nullopt);
+    return;
+  }
+  // None, or no answer: judged as an element that holds no frame.
+  std::string child_frame_id;
+  if (piece && piece->child_frame_id) {
+    child_frame_id = *piece->child_frame_id;
+  }
+  OnAgentHitTarget(std::move(wait), local_root_rfh_id, dom_node_id,
+                   std::move(child_frame_id), /*frame_asked=*/true,
+                   std::move(target_view), std::move(transformed_point));
+}
+
+void PageHandler::OnAgentCoverNamed(
+    std::unique_ptr<AgentHitWait> wait,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    bool page,
+    const std::string& hit,
+    int32_t hit_node_id,
+    const std::string& value) {
+  // browser: answered at kAgentCollectWait already: dropped.
+  AgentHitCheckCallback* const callback = wait->callback();
+  if (!callback) {
+    return;
+  }
+  // The page's own content over a frame's element covers it as any of the
+  // page's content would; another frame's is said as such.
+  // DescribePoint names what is there, not the kind of a layer it is in.
+  callback->sendSuccess(page ? "covered" : "otherFrame", CoverName(page, hit),
+                        std::nullopt);
+}
+
+void PageHandler::OnAgentHitChecked(
+    std::unique_ptr<AgentHitWait> wait,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    const std::string& verdict,
+    const std::string& hit,
+    const std::string& hit_kind) {
+  // browser: answered at kAgentCollectWait already: dropped.
+  AgentHitCheckCallback* const callback = wait->callback();
+  if (!callback) {
+    return;
+  }
+  // browser: the kind of the open layer `hit` names, as Input.moveTo
+  // gives it.
+  const auto text = [](const std::string& value) {
+    return value.empty() ? std::nullopt : std::optional<std::string>(value);
+  };
+  callback->sendSuccess(verdict, text(hit), text(hit_kind));
+}
+
+// browser: Page.agentMarkSecretField. By id, the element is named as
+// Page.agentHitCheck names it and reached as Page.resolveAgentNode reaches
+// it; by focus, the local root the next key goes to is found as
+// InputHandler::ReadFocusedField finds it before Input.dispatchKeystrokes'
+// first key. Its AgentSnapshotCollector stores the mark (and, while a
+// redacted recording is armed, invalidates the document's paint) before it
+// replies, so the answer means the mark is in force.
+void PageHandler::AgentMarkSecretField(
+    std::optional<int> agent_node_id,
+    std::optional<int> backend_node_id,
+    std::optional<std::string> frame_id,
+    std::optional<bool> focused,
+    std::unique_ptr<AgentMarkSecretFieldCallback> callback) {
+  const bool by_focus = focused.value_or(false);
+  if (by_focus && (agent_node_id.has_value() || backend_node_id.has_value() ||
+                   frame_id.has_value())) {
+    callback->sendFailure(Response::InvalidParams(
+        "Name the element by an id or by focused, not both"));
+    return;
+  }
+  const std::string none = by_focus ? "nothing" : "gone";
+  AgentNodeKey entry;
+  if (by_focus) {
+    // The frame the keys go to: this session's own frame when it is a
+    // child's, else the focused frame, else the main frame.
+    RenderFrameHostImpl* root = nullptr;
+    if (host_ && host_->GetParent()) {
+      root = host_;
+    } else if (WebContentsImpl* web_contents =
+                   host_ ? WebContentsImpl::FromRenderFrameHostImpl(host_)
+                         : nullptr) {
+      root = web_contents->GetFocusedFrame();
+      if (!root) {
+        root = web_contents->GetPrimaryMainFrame();
+      }
+    }
+    while (root && !root->is_local_root()) {
+      root = root->GetParent();
+    }
+    if (!root) {
+      callback->sendSuccess(none);
+      return;
+    }
+    entry.local_root = root->GetGlobalId();
+  } else if (agent_node_id.has_value()) {
+    // browser: any id of the page's document.
+    AgentIdSpace* space = CurrentAgentIdSpace();
+    const AgentIdEntry* found = space ? space->Find(*agent_node_id) : nullptr;
+    if (!found) {
+      callback->sendSuccess(none);
+      return;
+    }
+    entry = found->key;
+  } else if (backend_node_id.has_value() && frame_id.has_value()) {
+    RenderFrameHostImpl* rfh = LocalRootByFrameToken(*frame_id);
+    if (!rfh) {
+      callback->sendFailure(
+          Response::InvalidParams("No frame with the given 'frameId'"));
+      return;
+    }
+    entry.local_root = rfh->GetGlobalId();
+    entry.dom_node_id = *backend_node_id;
+  } else {
+    callback->sendFailure(Response::InvalidParams(
+        "agentNodeId, backendNodeId with frameId, or focused is required"));
+    return;
+  }
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(entry.local_root);
+  // browser: only a document still in the page: one in the back-forward
+  // cache is frozen, and never answers.
+  service_manager::InterfaceProvider* remotes =
+      rfh && rfh->IsActive() && rfh->IsRenderFrameLive()
+          ? rfh->GetRemoteInterfaces()
+          : nullptr;
+  if (!remotes) {
+    callback->sendSuccess(none);
+    return;
+  }
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+  remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+  // The proxy pointer is read before the Remote moves into the reply
+  // callback, which keeps the pipe alive until the reply. A dropped pipe
+  // answers gone (or nothing) instead of hanging.
+  blink::mojom::AgentSnapshotCollector* raw = collector.get();
+  // browser: answered once: by the reply, or at kAgentCollectWait.
+  auto wait = std::make_unique<AgentMarkWait>(std::move(callback),
+                                              weak_factory_.GetWeakPtr());
+  auto reply = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindOnce(&PageHandler::OnAgentSecretFieldMarked,
+                     weak_factory_.GetWeakPtr(), std::move(wait),
+                     std::move(collector)),
+      none);
+  if (by_focus) {
+    raw->MarkFocusedField(std::move(reply));
+  } else {
+    raw->MarkSecretField(entry.dom_node_id, std::move(reply));
+  }
+}
+
+void PageHandler::OnAgentSecretFieldMarked(
+    std::unique_ptr<AgentMarkWait> wait,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    const std::string& outcome) {
+  // browser: answered at kAgentCollectWait already: dropped.
+  AgentMarkSecretFieldCallback* const callback = wait->callback();
+  if (!callback) {
+    return;
+  }
+  callback->sendSuccess(outcome);
+}
+
+// browser: Page.agentSettleArm: a settle armed for an action that is
+// not input, through the session's outcome watch (SettleArm).
+Response PageHandler::AgentSettleArm(int* out_arm_id) {
+  ActionOutcomeWatch* watch =
+      ActionOutcomeWatch::ForSession(session(), /*make=*/true);
+  const int arm_id = watch ? watch->ArmSettle(/*look=*/false) : 0;
+  if (!arm_id) {
+    return Response::ServerError("There is no page to arm a settle in");
+  }
+  *out_arm_id = arm_id;
+  return Response::Success();
+}
+
+// browser: Page.agentSettle: the arm named, which must be the
+// current one (never a settle against a stale baseline), or one armed now;
+// every live local root is awaited and the readings joined (SettleJoin).
+void PageHandler::AgentSettle(std::optional<int> arm_id,
+                              std::unique_ptr<Page::Until> until,
+                              std::optional<int> quiet_ms,
+                              std::optional<int> cap_ms,
+                              std::optional<double> timeout_ms,
+                              std::optional<bool> report,
+                              std::optional<bool> controls,
+                              std::unique_ptr<AgentSettleCallback> callback) {
+  if (!host_) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  if (!CanExecuteGlobalCommands(this, callback)) {
+    return;
+  }
+  ActionOutcomeWatch* watch =
+      ActionOutcomeWatch::ForSession(session(), /*make=*/true);
+  if (!watch) {
+    callback->sendFailure(Response::ServerError("There is no page to settle"));
+    return;
+  }
+  SettleJoin::Params params;
+  Response response = SettleJoin::ReadParams(until.get(), quiet_ms, cap_ms,
+                                             timeout_ms, &params);
+  if (response.IsError()) {
+    callback->sendFailure(response);
+    return;
+  }
+  // browser: the frame an until's selector or xpath is held to is a
+  // frame of this page.
+  if (params.frame_token) {
+    bool found = false;
+    host_->ForEachRenderFrameHostImpl([&](RenderFrameHostImpl* rfh) {
+      if (rfh->GetDevToolsFrameToken().ToString() == *params.frame_token) {
+        found = true;
+      }
+    });
+    if (!found) {
+      callback->sendFailure(
+          Response::InvalidParams("until.frameId is not a frame of this page"));
+      return;
+    }
+  }
+  // A gone element: where the document's id space has it. Only its own local
+  // root is asked (DOMNodeIds are per process); one that left the page is
+  // gone, and so, at once, is an id the space has let go of as gone.
+  if (until && until->GetGoneAgentNodeId().has_value()) {
+    const int gone_id = *until->GetGoneAgentNodeId();
+    AgentIdSpace* space = CurrentAgentIdSpace();
+    const AgentIdEntry* gone = space ? space->Find(gone_id) : nullptr;
+    if (gone) {
+      params.gone_root = gone->key.local_root;
+      params.gone_node_id = gone->key.dom_node_id;
+      RenderFrameHostImpl* owner =
+          RenderFrameHostImpl::FromID(params.gone_root);
+      params.gone_now = !owner || !owner->IsActive() ||
+                        !owner->IsRenderFrameLive() || params.gone_node_id == 0;
+    } else if (space &&
+               space->Past(gone_id).kind == AgentPastAnswer::Kind::kGone) {
+      params.gone_now = true;
+    } else {
+      callback->sendFailure(Response::InvalidParams(
+          "goneAgentNodeId is not an id of this document"));
+      return;
+    }
+  }
+  // browser: a hidden page comes to the front, and a frozen one fails,
+  // once the call's parameters are read and before the settle is armed.
+  if (Response front = BringAgentPageForward(&params.brought_forward);
+      front.IsError()) {
+    callback->sendFailure(front);
+    return;
+  }
+  SettleArm& arm = watch->settle_arm();
+  // browser: with no armId, the settle armed here is a look, not an
+  // action: the renderers keep what the regions said since the last action.
+  if (arm_id.has_value()) {
+    if (*arm_id == 0 || *arm_id != arm.id()) {
+      callback->sendFailure(Response::InvalidParams("not the current action"));
+      return;
+    }
+  } else if (!watch->ArmSettle(/*look=*/true)) {
+    callback->sendFailure(Response::ServerError("There is no page to settle"));
+    return;
+  }
+  params.arm_id = arm.id();
+  // browser: the action's report too, judged from this arm.
+  if (report.value_or(false)) {
+    params.report = true;
+    // browser: and the page's control census in it.
+    params.controls = controls.value_or(false);
+    params.assemble_report =
+        base::BindOnce(&PageHandler::AssembleActionReport,
+                       weak_factory_.GetWeakPtr(), params.arm_id);
+  }
+  // browser: the settle names elements as the latest listing has them.
+  if (AgentIdSpace* space = CurrentAgentIdSpace()) {
+    for (const AgentIdEntry& entry : space->LatestListingEntries()) {
+      if (!entry.label.empty()) {
+        params.labels.push_back({entry.key.local_root, entry.key.dom_node_id,
+                                 entry.label, entry.name});
+      }
+    }
+  }
+  // Every live local root, as captureAgentSnapshot enumerates them.
+  SettleJoin::Start(std::move(params), arm, watch->GetWeakPtr(),
+                    LiveLocalRoots(host_), std::move(callback));
+}
+
+// browser: Page.agentReport, the action's report: one part per live local
+// root (ReportNow), asked on its arm's pipe so it comes after the arm, each
+// given the settle's kSettleReportWait; once more after a closing layer's
+// animation (LayerExitWaitMs); then assembled. Refused once another action
+// armed.
+void PageHandler::AgentReport(
+    int arm_id,
+    std::optional<int> layer_exit_ms,
+    std::unique_ptr<protocol::Array<int>> agent_node_ids,
+    std::unique_ptr<AgentReportCallback> callback) {
+  if (!host_) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  if (!CanExecuteGlobalCommands(this, callback)) {
+    return;
+  }
+  ActionOutcomeWatch* watch =
+      ActionOutcomeWatch::ForSession(session(), /*make=*/false);
+  if (!watch || arm_id == 0 || watch->settle_arm().id() != arm_id) {
+    callback->sendFailure(Response::InvalidParams("not the current action"));
+    return;
+  }
+  auto request = base::MakeRefCounted<AgentReportRequest>();
+  request->callback = std::move(callback);
+  request->arm_id = arm_id;
+  request->layer_exit_ms = std::clamp(layer_exit_ms.value_or(0), 0, 1000);
+  SettleArm& arm = watch->settle_arm();
+  for (RenderFrameHostImpl* rfh :
+       LiveLocalRoots(host_->frame_tree_node()->current_frame_host())) {
+    request->frames.push_back(rfh->GetGlobalId());
+    request->renderers.push_back(arm.RendererToRead(rfh));
+  }
+  // browser: the acted-on nodes, each asked of its local root with
+  // that root's part; one whose root left the page is gone.
+  if (agent_node_ids && !agent_node_ids->empty()) {
+    AgentIdSpace* space = AgentIdSpace::GetOrCreate(
+        host_->frame_tree_node()->current_frame_host());
+    request->nodes = std::make_unique<protocol::Array<Page::AgentNodeLife>>();
+    request->node_ids_of.resize(request->frames.size());
+    for (int id : *agent_node_ids) {
+      const AgentIdEntry* entry = space->Find(id);
+      request->nodes->push_back(entry ? FoundNodeLife(*entry)
+                                      : PastNodeLife(space->Past(id)));
+      request->nodes->back()->SetAgentNodeId(id);
+      AgentReportRequest::NodeAsk ask;
+      if (entry) {
+        const auto root =
+            std::ranges::find(request->frames, entry->key.local_root);
+        if (root == request->frames.end()) {
+          request->nodes->back()->SetState("gone");
+        } else {
+          ask.root = static_cast<size_t>(root - request->frames.begin());
+          ask.dom_node_id = entry->key.dom_node_id;
+          request->node_ids_of[*ask.root].push_back(ask.dom_node_id);
+        }
+      }
+      request->node_asks.push_back(ask);
+    }
+  }
+  AskAgentReport(std::move(request));
+}
+
+void PageHandler::AskAgentReport(scoped_refptr<AgentReportRequest> request) {
+  const int generation = ++request->generation;
+  request->parts.clear();
+  request->parts.resize(request->renderers.size());
+  if (request->renderers.empty()) {
+    OnAgentReportRead(std::move(request), generation);
+    return;
+  }
+  RenderWidgetHostImpl* widget = host_ ? host_->GetRenderWidgetHost() : nullptr;
+  const gfx::Size view = widget && widget->GetView()
+                             ? widget->GetView()->GetViewBounds().size()
+                             : gfx::Size();
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      request->renderers.size(),
+      base::BindOnce(&PageHandler::OnAgentReportRead,
+                     weak_factory_.GetWeakPtr(), request, generation));
+  for (size_t i = 0; i < request->renderers.size(); ++i) {
+    SettleRenderer* renderer = request->renderers[i].get();
+    if (!renderer || !renderer->collector.is_connected()) {
+      barrier.Run();
+      continue;
+    }
+    // Only a frame that shows gives the page layers.
+    RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(request->frames[i]);
+    blink::mojom::AgentReportOptionsPtr options =
+        SettleReportOptions(rfh && LayerFrameShows(*rfh, view));
+    if (i < request->node_ids_of.size()) {
+      options->node_ids = request->node_ids_of[i];
+    }
+    // After a closing layer's animation: the action's span, reopened.
+    options->reread = request->reread;
+    renderer->collector->ReportNow(
+        request->arm_id, std::move(options),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(
+                [](scoped_refptr<AgentReportRequest> request, size_t i,
+                   int generation, base::RepeatingClosure barrier,
+                   blink::mojom::AgentFrameReportPtr report) {
+                  if (generation == request->generation &&
+                      i < request->parts.size()) {
+                    request->parts[i] = std::move(report);
+                  }
+                  barrier.Run();
+                },
+                request, i, generation, barrier),
+            nullptr));
+  }
+  // A local root that misses the deadline gives no part.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PageHandler::OnAgentReportRead,
+                     weak_factory_.GetWeakPtr(), request, generation),
+      kSettleReportWait);
+}
+
+void PageHandler::OnAgentReportRead(scoped_refptr<AgentReportRequest> request,
+                                    int generation) {
+  if (!request->callback || generation != request->generation) {
+    return;
+  }
+  // One that has not answered gives a part with no report.
+  std::vector<SettleReportPart> parts;
+  bool superseded = false;
+  for (size_t i = 0; i < request->frames.size(); ++i) {
+    SettleReportPart part;
+    part.frame = request->frames[i];
+    part.report = std::move(request->parts[i]);
+    superseded = superseded || (part.report && part.report->superseded);
+    parts.push_back(std::move(part));
+  }
+  ActionOutcomeWatch* watch =
+      ActionOutcomeWatch::ForSession(session(), /*make=*/false);
+  const bool current =
+      !superseded && watch && watch->settle_arm().id() == request->arm_id;
+  RenderFrameHostImpl* root =
+      host_ ? host_->frame_tree_node()->current_frame_host() : nullptr;
+  if (current && !request->reread && root) {
+    RenderWidgetHostImpl* widget = host_->GetRenderWidgetHost();
+    const gfx::Size view = widget && widget->GetView()
+                               ? widget->GetView()->GetViewBounds().size()
+                               : gfx::Size();
+    const int wait = LayerExitWaitMs(parts, *AgentIdSpace::GetOrCreate(root),
+                                     view, request->layer_exit_ms);
+    if (wait > 0) {
+      // What this read's late answers bring is dropped.
+      request->reread = true;
+      ++request->generation;
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&PageHandler::AskAgentReport,
+                         weak_factory_.GetWeakPtr(), request),
+          base::Milliseconds(wait));
+      return;
+    }
+  }
+  std::unique_ptr<AgentReportCallback> callback = std::move(request->callback);
+  // The renderers are the arm's: the request lets go of them, and of the
+  // replies still out on their pipes.
+  request->renderers.clear();
+  if (!current) {
+    callback->sendFailure(Response::InvalidParams("not the current action"));
+    return;
+  }
+  // browser: the acted-on nodes, from their roots' parts; one whose root
+  // gave no part stays unknown.
+  for (size_t n = 0; request->nodes && n < request->node_asks.size(); ++n) {
+    const AgentReportRequest::NodeAsk& ask = request->node_asks[n];
+    if (!ask.root || *ask.root >= parts.size() || !parts[*ask.root].report) {
+      continue;
+    }
+    for (const blink::mojom::AgentNodeStatePtr& state :
+         parts[*ask.root].report->nodes) {
+      if (state->node_id == ask.dom_node_id) {
+        FillNodeLife(*(*request->nodes)[n], *state);
+        break;
+      }
+    }
+  }
+  // After a navigation nothing else is reported, the nodes included.
+  const bool navigated = !watch->settle_arm().first_commit().is_null();
+  std::unique_ptr<Page::AgentActionReport> report = AssembleActionReport(
+      weak_factory_.GetWeakPtr(), request->arm_id, std::move(parts));
+  if (!report) {
+    callback->sendFailure(Response::ServerError("The page went away"));
+    return;
+  }
+  if (request->nodes && !navigated) {
+    report->SetNodes(std::move(request->nodes));
+  }
+  callback->sendSuccess(std::move(report));
+}
+
+// static
+std::unique_ptr<Page::AgentActionReport> PageHandler::AssembleActionReport(
+    base::WeakPtr<PageHandler> handler,
+    int arm_id,
+    std::vector<SettleReportPart> parts) {
+  if (!handler || !handler->host_) {
+    return nullptr;
+  }
+  RenderFrameHostImpl* root =
+      handler->host_->frame_tree_node()->current_frame_host();
+  if (!root) {
+    return nullptr;
+  }
+  ActionOutcomeWatch* watch =
+      ActionOutcomeWatch::ForSession(handler->session(), /*make=*/false);
+  // Only the current arm's: what a renderer read once a later action armed
+  // is that action's.
+  if (!watch || watch->settle_arm().id() != arm_id ||
+      std::ranges::any_of(parts, [](const SettleReportPart& part) {
+        return part.report && part.report->superseded;
+      })) {
+    return nullptr;
+  }
+  AgentIdSpace* space = AgentIdSpace::GetOrCreate(root);
+  int unanswered = 0;
+  for (const SettleReportPart& part : parts) {
+    if (!part.report || !RenderFrameHostImpl::FromID(part.frame)) {
+      ++unanswered;
+    }
+  }
+  // A live local root with no part at all (none could be asked) is
+  // unanswered too, its layers kept as last read.
+  std::vector<std::string> unasked;
+  for (RenderFrameHostImpl* rfh : LiveLocalRoots(root)) {
+    if (std::ranges::none_of(parts, [&](const SettleReportPart& part) {
+          return part.frame == rfh->GetGlobalId();
+        })) {
+      ++unanswered;
+      unasked.push_back(rfh->GetDevToolsFrameToken().ToString());
+    }
+  }
+  const base::TimeTicks arm_t = watch->settle_arm().t();
+  const bool navigated = !watch->settle_arm().first_commit().is_null();
+  auto regions = std::make_unique<protocol::Array<Page::AgentLiveRegion>>();
+  auto heard = std::make_unique<protocol::Array<Page::AgentHeard>>();
+  auto opened = std::make_unique<protocol::Array<int>>();
+  auto closed = std::make_unique<protocol::Array<Page::AgentLayer>>();
+  auto reworded = std::make_unique<protocol::Array<Page::AgentLayerReworded>>();
+  std::unique_ptr<protocol::Array<Page::AgentLayer>> layers;
+  std::optional<double> baseline_age_ms;
+  // browser: the census, when the parts carry one.
+  std::unique_ptr<protocol::Array<Page::AgentControl>> controls;
+  std::vector<std::string> controls_cut;
+  if (navigated) {
+    // The arm's document is gone: nothing read of the new one is the
+    // action's.
+    layers = std::make_unique<protocol::Array<Page::AgentLayer>>();
+  } else {
+    RenderWidgetHostImpl* widget = handler->host_->GetRenderWidgetHost();
+    const gfx::Size view = widget && widget->GetView()
+                               ? widget->GetView()->GetViewBounds().size()
+                               : gfx::Size();
+    std::vector<LayerFrame> frames;
+    // Frames still in the page whose stack this read lacks, or does not count.
+    base::flat_set<std::string> unread(unasked.begin(), unasked.end());
+    for (const SettleReportPart& part : parts) {
+      RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(part.frame);
+      if (!rfh) {
+        continue;
+      }
+      const std::string frame_id = rfh->GetDevToolsFrameToken().ToString();
+      if (!part.report) {
+        unread.insert(frame_id);
+        continue;
+      }
+      for (const blink::mojom::AgentRegionReadPtr& region :
+           part.report->regions) {
+        if (region->text.empty()) {
+          continue;
+        }
+        RegionReply reply;
+        reply.region_id =
+            space->RegionIdFor(AgentKey(part.frame, region->node_id));
+        reply.frame_id = frame_id;
+        reply.read = region.get();
+        regions->emplace_back(LiveRegionReply(reply));
+      }
+      for (const blink::mojom::AgentHeardReadPtr& entry : part.report->heard) {
+        heard->emplace_back(HeardReply(*space, part.frame, frame_id, *entry));
+      }
+      const bool shows = LayerFrameShows(*rfh, view);
+      if (part.report->layer_snapshot) {
+        frames.push_back(
+            {rfh, frame_id, part.report->layer_snapshot.get(), shows});
+      }
+      if (!part.report->layer_snapshot || !shows) {
+        unread.insert(frame_id);
+      }
+    }
+    const PageLayers page = AssemblePageLayers(frames);
+    layers = PageLayersReply(page, frames, nullptr, nullptr);
+    controls = ControlsReply(page, frames, parts, controls_cut);
+    // browser: a live local root never asked gave no census either.
+    controls_cut.insert(controls_cut.end(), unasked.begin(), unasked.end());
+    AgentLastLayers now = LastLayersOf(page, frames);
+    if (const std::optional<AgentLastLayers>& last = space->last_layers()) {
+      if (!arm_t.is_null()) {
+        baseline_age_ms = (arm_t - last->read_at).InMillisecondsF();
+      }
+      LayerChanges changes = LayerChangesSince(now, *last, unread);
+      opened = std::move(changes.opened);
+      closed = std::move(changes.closed);
+      reworded = std::move(changes.reworded);
+    } else {
+      // browser: no stack read before -- an action on a page never
+      // listed: every layer open now is new to the client.
+      for (size_t i = 0; i < now.layers.size(); ++i) {
+        opened->push_back(base::checked_cast<int>(i));
+      }
+    }
+    space->SetLastLayers(
+        WithUnreadLayers(std::move(now), space->last_layers(), unread));
+  }
+  std::unique_ptr<Page::AgentActionReport> report =
+      Page::AgentActionReport::Create()
+          .SetDocumentId(space->document_id())
+          .SetArmId(arm_id)
+          .SetRegions(std::move(regions))
+          .SetHeard(std::move(heard))
+          .SetLayers(std::move(layers))
+          .SetLayersOpened(std::move(opened))
+          .SetLayersClosed(std::move(closed))
+          .SetLayersReworded(std::move(reworded))
+          .SetUnansweredFrames(unanswered)
+          .Build();
+  if (baseline_age_ms) {
+    report->SetBaselineAgeMs(*baseline_age_ms);
+  }
+  if (navigated) {
+    report->SetNavigated(true);
+  }
+  if (controls) {
+    report->SetControls(std::move(controls));
+    if (!controls_cut.empty()) {
+      report->SetControlsCut(std::make_unique<protocol::Array<std::string>>(
+          std::move(controls_cut)));
+    }
+  }
+  // browser: a print asked for since the arm, after a navigation too:
+  // the browser's to tell, not a read of the page.
+  if (std::optional<base::TimeTicks> print_at = watch->settle_arm().PrintAt()) {
+    report->SetPrintAtMs((*print_at - arm_t).InMillisecondsF());
+  }
+  return report;
+}
+
+Response PageHandler::StopLoading() {
+  ResponseOrWebContents result = GetWebContentsForTopLevelActiveFrame();
+
+  if (std::holds_alternative<Response>(result)) {
+    return std::get<Response>(result);
+  }
+
+  WebContentsImpl* web_contents = std::get<WebContentsImpl*>(result);
+  web_contents->Stop();
+  return Response::Success();
+}
+
+Response PageHandler::SetWebLifecycleState(const std::string& state) {
+  // Inactive pages(e.g., a prerendered or back-forward cached page) should not
+  // affect the state.
+  ResponseOrWebContents result = GetWebContentsForTopLevelActiveFrame();
+  if (std::holds_alternative<Response>(result)) {
+    return std::get<Response>(result);
+  }
+
+  WebContentsImpl* web_contents = std::get<WebContentsImpl*>(result);
+  if (state == Page::SetWebLifecycleState::StateEnum::Frozen) {
+    // TODO(fmeawad): Instead of forcing a visibility change, only allow
+    // freezing a page if it was already hidden.
+    //
+    // browser: the forced hide is remembered, because nothing else undoes it.
+    // A headed window's native view reports the page visible again at its
+    // next update; a headless one never does, so a page frozen here would
+    // stay hidden after `active`: no BeginFrames, no rAF, timers throttled,
+    // and nothing drawn until a capture forced a frame.
+    hidden_to_freeze_ = web_contents->GetVisibility() == Visibility::VISIBLE;
+    web_contents->WasHidden();
     web_contents->SetPageFrozen(true);
+    page_frozen_ = true;
     return Response::Success();
   }
   if (state == Page::SetWebLifecycleState::StateEnum::Active) {
     web_contents->SetPageFrozen(false);
+    // browser: a page hidden to freeze it is shown again (agent-snapshot).
+    page_frozen_ = false;
+    if (hidden_to_freeze_) {
+      hidden_to_freeze_ = false;
+      if (web_contents->GetVisibility() != Visibility::VISIBLE) {
+        web_contents->WasShown();
+      }
+    }
     return Response::Success();
   }
   return Response::ServerError("Unidentified lifecycle state");
