+void AgentSnapshotCollectorImpl::AwaitSettle(
+    int64_t arm_id,
+    int32_t quiet_ms,
+    int32_t cap_ms,
+    mojom::blink::AgentUntilPtr until,
+    mojom::blink::AgentReportOptionsPtr report,
+    AwaitSettleCallback callback) {
+  if (report) {
+    // browser: the report is read once the settle answers, in a task of
+    // its own: the watcher answers from post-lifecycle steps, where the layer
+    // read's forced layout does not belong.
+    callback = blink::BindOnce(&AgentSnapshotCollectorImpl::ReportAfterSettle,
+                               WrapWeakPersistent(this), arm_id, !!until,
+                               std::move(report), std::move(callback));
+  }
+  SettleWatcher().Await(arm_id, quiet_ms, cap_ms, std::move(until),
+                        std::move(callback));
+}
+
+void AgentSnapshotCollectorImpl::ReportAfterSettle(
+    int64_t arm_id,
+    bool had_until,
+    mojom::blink::AgentReportOptionsPtr options,
+    AwaitSettleCallback callback,
+    mojom::blink::AgentSettleReadingPtr reading) {
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostTask(FROM_HERE,
+                 blink::BindOnce(&AgentSnapshotCollectorImpl::ReportForSettle,
+                                 WrapWeakPersistent(this), arm_id, had_until,
+                                 std::move(options), std::move(callback),
+                                 std::move(reading)));
+}
+
+// browser: an answer the browser no longer waits for reads nothing: a
+// wait a newer one replaced (which answered it first), one a Disarm or the
+// next Arm answered, a refusal, or an `until` wait answered unmet (the
+// settle after it is asked again); nor does a document that is gone.
+void AgentSnapshotCollectorImpl::ReportForSettle(
+    int64_t arm_id,
+    bool had_until,
+    mojom::blink::AgentReportOptionsPtr options,
+    AwaitSettleCallback callback,
+    mojom::blink::AgentSettleReadingPtr reading) {
+  if (!settle_watcher_ || !settle_watcher_->ArmedWith(arm_id) ||
+      settle_watcher_->Waiting() || (had_until && !reading->until_seen) ||
+      !GetSupplementable()->GetFrame()) {
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  ReadReport(arm_id, std::move(options),
+             blink::BindOnce(
+                 [](AwaitSettleCallback callback,
+                    mojom::blink::AgentSettleReadingPtr reading,
+                    mojom::blink::AgentFrameReportPtr report) {
+                   reading->report = std::move(report);
+                   std::move(callback).Run(std::move(reading));
+                 },
+                 std::move(callback), std::move(reading)));
+}
