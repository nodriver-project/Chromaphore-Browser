+// browser: Page.agentHitCheck, once the browser has routed the point here.
+void AgentSnapshotCollectorImpl::HitCheck(int32_t local_dom_node_id,
+                                          double x,
+                                          double y,
+                                          HitCheckCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  String hit;
+  String hit_kind;
+  // browser: an inert node with what switched it off.
+  const String verdict =
+      PressVerdict(root, OwnedElement(root, local_dom_node_id), x, y, hit,
+                   &hit_kind, /*name_inert=*/true);
+  std::move(callback).Run(verdict, hit, hit_kind);
+}
