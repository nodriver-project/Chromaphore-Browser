+  int64_t span_arm_id_ = 0;
+  base::TimeTicks action_armed_at_;
+  bool report_read_ = false;
+  base::TimeTicks report_read_at_;
+  int reads_in_flight_ = 0;
+  // browser: the next heard entry's number, never reused (one a later
