+namespace blink {
+
+class Animation;
+class Document;
+class Element;
+class LocalFrame;
+
+// browser: the settle. Has this local root finished reacting to the
+// agent's action? Armed with the action's time T (the browser's TimeTicks, one
+// clock with ours), it watches, from then on, what the agent reads and what
+// the page still has in flight:
+//   - the agent-visible signature: a hash over the in-view interactive
+//     elements of every same-process frame (their name proxies, states and
+//     boxes), recomputed when a cheap stamp moved (at most every 100 ms),
+//     every 300 ms regardless, and once more before saying "settled";
+//   - the requests in flight that the action caused (their interaction's time
+//     origin is at or after T) or that started after T with no interaction;
+//   - the renderer's own pending navigations;
+//   - finite animations on in-view elements with 1.5 s or less to run, read
+//     only right after a frame's lifecycle.
+// AwaitSettle answers once all of them held through the quiet window, at the
+// cap, or as soon as rendering is seen paused (no frames while the lifecycle
+// is dirty). It never forces style or layout, never runs script, dispatches
+// nothing, requests no frame, makes no accessibility tree and allocates on the
+// Oilpan heap only when it names a change or records what a region said; its
+// samples come from the frames the page draws anyway, and from a 50 ms timer
+// while armed when none come.
+//
+// browser: in the same walk, when the DOM moved, it also reads the live
+// regions (agent_live_regions.h), in view or not, and records each one whose
+// text changed and is not empty: what the page said during the watch, toasts
+// included, at most 8 per arm and 3 per region in it, an arm being an action's
+// or a look's, and 24 in all besides what an action's Arm carried on (heard()).
+// Their baseline is read in the arm's own sample, pending style or layout or
+// not, so a toast the action inserted reads as silent there. Only an Arm for a
+// new action clears that record and the regions' last texts, and it carries on
+// what was heard in the 30 s before it, the newest 8, under their own keys and
+// marked before_action: what the last watch heard while it still looked, after
+// the agent's last read (a quick next press, an earlier step of the same call),
+// is still told. Before it, the last watch, if still looking, reads the regions
+// once more (ReadRegionsLast; also as it pauses or is disarmed), so a toast
+// laid out since its last pass is heard, not taken into the next baseline as
+// said before. The browser re-arms with the same id after DisarmSettle, a
+// closed pipe or the lease, and that arm carries on; a look's Arm
+// (Page.agentSettle with no armId) has a new id but keeps them, their arm id
+// and the baseline, unless nothing armed this watcher before, so the record
+// grows through the looks after an action.
+// Stop, Pause, Resume and the lease keep it for the collector's captures and
+// LiveRegions. Known limits: a region first met after the baseline (in a
+// frame throttled or undrawn at the arm, or under a locked display lock, then
+// scrolled in) reads as heard with the text it already had; a region hidden
+// by display: none is not met and keeps its last text, so the same text shown
+// again within one arm is not heard again.
+//
+// A separate object from AgentSnapshotCollectorImpl, which is a lifecycle
+// observer itself and unregisters on WatchDrag's StopWatch: the two must not
+// share a registration. Held by the collector; registered on the local root's
+// view only while armed. A 10 s lease from the last call or answer ends a
+// watch whose browser went away.
+//
+// For the browser half:
+// - With no AwaitSettle waiting, the watcher stops looking 250 ms past
+//   max(T + cap, the last call or answer): it stops its timer but stays
+//   armed. An AwaitSettle after that starts it again with a fresh baseline
+//   and the deadline max(await + max(quiet, 300 ms) + 100 ms, T + the call's
+//   cap); what changed while it was not looking is not seen, save in its
+//   regions, which it still reads after the page's frames, staying
+//   registered (IdleRegions), until 5 min past the last call or answer, so
+//   what they say between calls is heard.
+// - An `until` has no deadline here but a 60 s backstop: at its own timeoutMs,
+//   which it must cap at 60 s, the browser ends the wait with a new
+//   AwaitSettle without it (which answers this one first), or DisarmSettle.
+// - gone_node_id goes only to the local root that owns the node.
+class AgentSettleWatcher final
+    : public GarbageCollected<AgentSettleWatcher>,
+      public LocalFrameView::LifecycleNotificationObserver {
+ public:
+  using AwaitCallback =
+      mojom::blink::AgentSnapshotCollector::AwaitSettleCallback;
+
+  // `local_root_document`: the document of the local root the collector
+  // serves.
+  explicit AgentSettleWatcher(Document& local_root_document);
+  AgentSettleWatcher(const AgentSettleWatcher&) = delete;
+  AgentSettleWatcher& operator=(const AgentSettleWatcher&) = delete;
+
+  void Trace(Visitor* visitor) const override;
+
+  // The collector's three mojo methods. `look`: armed by a look, not by an
+  // action.
+  void Arm(int64_t arm_id, base::TimeTicks t, bool look);
+  void Await(int64_t arm_id,
+             int32_t quiet_ms,
+             int32_t cap_ms,
+             mojom::blink::AgentUntilPtr until,
+             AwaitCallback callback);
+  void Disarm(int64_t arm_id);
+  // browser: an action still under way in this renderer (a long scroll's
+  // progress read): the watch goes on looking a cap past now (CapEnd), so what
+  // the page says late in the action is heard, and the settle call that comes
+  // after it finds the watch still looking. Nothing once it has paused. (The
+  // settle's own deadline needs nothing: the browser counts its cap from the
+  // call.)
+  void KeepLooking();
+
+  // browser: what live regions said since the last action's Arm: regions
+  // whose text changed while the watcher looked, at most 8 per arm (the
+  // action's and each look's after it) and 24 in all, besides what that Arm
+  // carried on; `index` runs on across them. Cleared only at an Arm for a new
+  // action, which keeps the newest 8 heard in the 30 s before it, marked
+  // before_action; kept through Stop, Pause, Resume, a re-arm with the same id
+  // and a look's Arm.
+  struct HeardEntry {
+    DISALLOW_NEW();
+    int32_t node_id = 0;
+    String kind;
+    bool assertive = false;
+    uint64_t text_hash = 0;
+    String text;
+    int32_t index = 0;
+    // The action's arm it was heard under: with `index`, its key.
+    int64_t arm_id = 0;
+    // When it was heard: an action's Arm carries on what is recent, and a
+    // read gives how long ago (ago_ms).
+    base::TimeTicks heard_at;
+    // Heard before the last action's Arm, which carried it on.
+    bool before_action = false;
+    // browser: `unwatched`: recorded by a read's closing pass while no watch
+    // looked, or by a paused watch's own read (IdleRegions). `own`: heard
+    // while no action's own span was open (InActionWindow): the page said it
+    // by itself.
+    bool unwatched = false;
+    bool own = false;
+    // browser: how many changes of its region it stands for, and the
+    // text of the entry it took the place of (NoteRegion; null: none).
+    int32_t changes = 1;
+    String replaced;
+    // browser: for a log, what its change added (AddedText; with
+    // `changes` 2 or more, what every change it stands for added, one way),
+    // and whether it was added at the top; null: none could be told.
+    String added;
+    bool added_prepended = false;
+  };
+  const Vector<HeardEntry>& heard() const { return heard_; }
+  // browser: the document it reads the regions of (null once gone).
+  Document* document() const { return document_.Get(); }
+
+  // browser: a live region root another read walked (LiveRegions, the
+  // per-action report): what it says now against what it was last seen
+  // saying, once an arm took its baseline. While the watch looks it is
+  // recorded as the watch's next pass would record it, now (a report read
+  // right after an action's press comes before the watch's first look at a
+  // toast the press made); while no watch looks, as unwatched.
+  void NoteRead(Element& element);
+
+  // browser: a report of the arm `arm_id` begins its read
+  // (NoteReportStart) and has read the page (NoteReportRead): when that is
+  // the latest action's, what changes once no read of it is in flight is no
+  // longer its own (InActionWindow). `reread`: the browser reads that report
+  // again, after a closing layer's animation; what was heard since the last
+  // read is the action's after all, and its span is open again.
+  void NoteReportStart(int64_t arm_id, bool reread);
+  void NoteReportRead(int64_t arm_id);
+
+  // browser: the latest arm's id (0: never armed), kept after it ends;
+  // whether that arm still holds; whether a call waits for its answer.
+  int64_t arm_id() const { return arm_id_; }
+  bool ArmedWith(int64_t id) const { return armed_ && arm_id_ == id; }
+  bool Waiting() const { return !!callback_; }
+
+  // LocalFrameView::LifecycleNotificationObserver:
+  void WillStartLifecycleUpdate(const LocalFrameView& view) override;
+  void DidFinishPostLifecycleSteps(const LocalFrameView& view) override;
+
+ private:
+  enum class SampleKind : uint8_t { kArm, kFrame, kTimer, kAwait };
+
+  // One interactive element of a signature pass: its pointer as a key (never
+  // dereferenced), the hash of what the agent reads of it, and the DOMNodeId
+  // it already had (0: none), which names it once it is gone.
+  struct SigEntry {
+    uint64_t key = 0;
+    uint64_t hash = 0;
+    int32_t id = 0;
+  };
+
+  // A counted load's name, made once as it is first counted.
+  struct CountedName {
+    uint64_t key = 0;
+    base::TimeTicks created;
+    String what;
+    bool meanwhile = false;
+  };
+
+  // The requests of one sample, by tag.
+  struct RequestTally {
+    uint16_t caused = 0;
+    uint16_t meanwhile = 0;
+    // A request the last sample counted is gone, or loads started and ended
+    // between the two samples.
+    bool ended = false;
+  };
+
+  // The local root's frame, while this watcher's document is still its own
+  // and laid out in a view.
+  LocalFrame* Root() const;
+
+  // Registers on `view` and forgets everything of the arm before.
+  void Start(LocalFrameView& view);
+  // Answers a waiting call, unregisters, stops the timer and forgets the arm,
+  // but not what the regions said (heard_ and region_said_ wait for an Arm
+  // for a new action).
+  void Stop();
+  // No call waiting, and the action long past: stops looking, stays armed.
+  // Its regions alone it still reads (IdleRegions).
+  void Pause();
+  // A call came after Pause: looks again from a fresh baseline.
+  void Resume(LocalFrameView& view, base::TimeTicks now);
+  void Register(LocalFrameView& view);
+  void Sample(SampleKind kind);
+  void OnTimer(TimerBase*);
+  void ScheduleTick(base::TimeTicks now);
+
+  // Parts of a sample. `content`: the DOM tree versions and the focus only
+  // (what changes the page, not its rendering of earlier changes).
+  uint64_t ComputeStamp(LocalFrame& root, bool& dirty, uint64_t& content) const;
+  // `baseline`: the first sample of an arm or a resume, which notes the
+  // loads in flight and judges no ends.
+  void ClassifyRequests(LocalFrame& root,
+                        base::TimeTicks now,
+                        RequestTally& tally,
+                        bool baseline);
+  void NameRequests(LocalFrame& root,
+                    base::TimeTicks now,
+                    Vector<mojom::blink::AgentChangingPtr>& changing);
+  uint8_t NavigationFlags(LocalFrame& root, bool at_arm);
+  void ReadAnimations(LocalFrame& root, base::TimeTicks now);
+  // Walks every readable frame and returns the signature, filling
+  // next_entries_ and naming the first difference from entries_ in
+  // pending_what_. Sets budget_exceeded_. With `read_regions`, hands each live
+  // region root it meets to NoteRegion.
+  uint64_t ComputeSignature(LocalFrame& root,
+                            uint64_t stamp,
+                            bool read_regions);
+  void NameGone(const SigEntry& entry);
+  // browser: who records a region's change: the watch, or the closing
+  // pass of a read made while no watch looked.
+  enum class NoteMode : uint8_t { kWatched, kUnwatched };
+  // browser: every live region root of the readable frames, to
+  // NoteRegion: the baseline while regions_baseline_ (BaselineRegions, in the
+  // arm's sample), else a read that records what changed (ReadRegionsLast).
+  void WalkRegions(LocalFrame& root, NoteMode mode = NoteMode::kWatched);
+  void BaselineRegions(LocalFrame& root);
+  // browser: while the watch still looks, owes no baseline and has an
+  // arm, one more read of the regions under that arm, before an action's Arm
+  // takes its baseline, and as it pauses or is disarmed: a toast laid out
+  // since its last pass (which its gate can hold back 100 ms) is recorded.
+  // With `at_arm`, an action's Arm reads a paused watch too, as a closing
+  // pass.
+  void ReadRegionsLast(bool at_arm = false);
+  // browser: a paused watch's read of the regions alone, after a frame
+  // of the page's own, or at the end of the gap one was held back by.
+  void IdleRegions(base::TimeTicks now);
+  // browser: one live region root of a pass, against the text it was
+  // last seen saying.
+  void NoteRegion(Element& element, NoteMode mode = NoteMode::kWatched);
+  // browser: keeps a log region's text under `key`, within 32 log
+  // roots: past them, one not kept already is not kept (LogTextRoom).
+  void KeepLogText(uint64_t key, agent_live_regions::RegionEnds ends);
+  bool LogTextRoom(uint64_t key) const;
+  // browser: the latest arm (an action's or a look's) heard its 8, or
+  // heard_ holds 24 besides what the action's Arm carried on: nothing more is
+  // recorded.
+  bool HeardFull() const;
+  // browser: the allowance of the closing passes and of a paused watch's
+  // reads is spent: 8 this arm, or heard_ holds 32 besides what the action's
+  // Arm carried on.
+  bool UnwatchedFull() const;
+  // browser: whether `now` is in the latest action's own span, from its
+  // Arm until its report read the page (kActionWindow at most when none
+  // does).
+  bool InActionWindow(base::TimeTicks now) const;
+  // `content`: ComputeStamp's content stamp, which gates the regions' read.
+  void Judge(LocalFrame& root,
+             base::TimeTicks now,
+             uint64_t stamp,
+             uint64_t content,
+             bool dirty,
+             bool long_frame);
+
+  // `until`: text, selector, gone. Checked outside the post-lifecycle steps
+  // only (a selector match may recompute slot assignments).
+  void ClearUntil();
+  void SetUntil(const mojom::blink::AgentUntilPtr& until);
+  bool HasUntil() const;
+  // browser: `appeared` is met: more shown than at the arm, over the
+  // same frames, by a count taken since the waiting call came.
+  bool ShownMore() const;
+  void MaybeCheckUntil(LocalFrame& root,
+                       base::TimeTicks now,
+                       uint64_t stamp,
+                       bool dirty);
+  void CheckUntil(LocalFrame& root, base::TimeTicks now);
+
+  // The answer.
+  base::TimeTicks Anchor() const;
+  base::TimeTicks Deadline() const;
+  // browser: how long a watch with no call waiting looks: a cap past T,
+  // or past the action's last progress read (KeepLooking) when it came later.
+  base::TimeTicks CapEnd() const;
+  void MaybeAnswer(base::TimeTicks now);
+  void Answer(base::TimeTicks now);
