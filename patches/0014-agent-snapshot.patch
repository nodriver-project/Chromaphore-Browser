+// The page's own entries, bottom to top, each frame's entries just above the
+// topmost page entry holding that frame, else on top. An entry with no name or
+// head takes its frame's document's (a layer that is only a frame: an iframe
+// wall).
+PageLayers AssemblePageLayers(const std::vector<LayerFrame>& frames) {
+  PageLayers page;
+  page.main = frames.size();
+  for (size_t k = 0; k < frames.size(); ++k) {
+    if (frames[k].snapshot && frames[k].rfh &&
+        frames[k].rfh->IsOutermostMainFrame()) {
+      page.main = k;
+    }
+  }
+  const size_t main_count =
+      page.main < frames.size() ? frames[page.main].snapshot->layers.size() : 0;
+  // Slot e: above the page's entry e; slot main_count: on top.
+  std::vector<std::vector<std::pair<size_t, size_t>>> slots(main_count + 1);
+  for (size_t k = 0; k < frames.size(); ++k) {
+    if (k == page.main || !frames[k].snapshot || !frames[k].shows) {
+      continue;
+    }
+    size_t slot = main_count;
+    for (size_t e = main_count; e-- > 0;) {
+      if (LayerHoldsFrame(*frames[page.main].snapshot->layers[e],
+                          frames[k].rfh.get())) {
+        slot = e;
+        break;
+      }
+    }
+    for (size_t i = 0; i < frames[k].snapshot->layers.size(); ++i) {
+      slots[slot].emplace_back(k, i);
+    }
+  }
+  const auto add = [&](size_t k, size_t i) {
+    const blink::mojom::AgentLayer& layer = *frames[k].snapshot->layers[i];
+    PageLayers::Entry entry;
+    entry.frame = k;
+    entry.local = i;
+    entry.name = layer.name;
+    entry.head = layer.head;
+    for (size_t f = 0;
+         f < frames.size() && (entry.name.empty() || entry.head.empty()); ++f) {
+      if (f == k || !frames[f].snapshot || !frames[f].shows ||
+          !LayerHoldsFrame(layer, frames[f].rfh.get())) {
+        continue;
+      }
+      if (entry.name.empty() && frames[f].snapshot->document_name) {
+        entry.name = *frames[f].snapshot->document_name;
+      }
+      if (entry.head.empty() && frames[f].snapshot->document_head) {
+        entry.head = *frames[f].snapshot->document_head;
+      }
+    }
+    page.entries.push_back(std::move(entry));
+  };
+  for (size_t e = 0; e < main_count; ++e) {
+    add(page.main, e);
+    for (const auto& [k, i] : slots[e]) {
+      add(k, i);
+    }
+  }
+  for (const auto& [k, i] : slots[main_count]) {
+    add(k, i);
+  }
+  page.index.resize(frames.size());
+  for (size_t k = 0; k < frames.size(); ++k) {
+    page.index[k].assign(
+        frames[k].snapshot ? frames[k].snapshot->layers.size() : 0, -1);
+  }
+  for (size_t p = 0; p < page.entries.size(); ++p) {
+    page.index[page.entries[p].frame][page.entries[p].local] =
+        static_cast<int>(p);
+  }
+  return page;
+}
