+// browser: where the wheel turns what holds the target toward it from a
+// calm place.
+void AgentSnapshotCollectorImpl::WheelStation(int32_t target_node_id,
+                                              double aim_x,
+                                              double aim_y,
+                                              int32_t axis,
+                                              double hand_x,
+                                              double hand_y,
+                                              bool pointer,
+                                              WheelStationCallback callback) {
+  const auto none = [&callback]() {
+    std::move(callback).Run(
+        false, 0, 0, mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0), 0,
+        g_empty_string);
+  };
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    none();
+    return;
+  }
+  // The carry's reading along the axis: the scrollers that hold the target,
+  // and which of them move it toward its need.
+  WheelBinder binder;
+  ReadCarry(target_node_id, aim_x, aim_y, hand_x, hand_y, axis == 2 ? 2 : 1,
+            &binder);
+  if (binder.chain.empty() || std::abs(binder.toward) < 0.5) {
+    none();
+    return;
+  }
+  const bool vertical = binder.vertical;
+  const bool forward = binder.toward > 0;
+  // The binder: the outermost of the movers that can still move it that way.
+  const wtf_size_t last =
+      std::min<wtf_size_t>(binder.movers_to, binder.chain.size() - 1);
+  const LayoutBox* bound = nullptr;
+  for (wtf_size_t i = last + 1; i-- > binder.movers_from;) {
+    if (CarryCanScroll(*binder.chain[i], vertical, forward)) {
+      bound = binder.chain[i];
+      break;
+    }
+  }
+  if (!bound) {
+    none();
+    return;
+  }
+  const int32_t bound_id = NodeIdOf(*bound);
+  const String bound_name = NonNull(BandName(*bound));
+  const auto moves_it = [&binder, last](const LayoutBox* latched) {
+    for (wtf_size_t i = binder.movers_from; latched && i <= last; ++i) {
+      if (binder.chain[i] == latched) {
+        return true;
+      }
+    }
+    return false;
+  };
+
+  const RootDips dips(*view, *widget);
+  Terrain terrain;
+  CollectTerrain(*root, dips, terrain);
+  // Fixed boxes over the binder take the wheel and Blink's band walk for
+  // themselves; one the binder lies inside is no obstacle.
+  Vector<gfx::RectF> over;
+  for (wtf_size_t i = 0; i < terrain.fixed.size(); ++i) {
+    if (!InsideObject(*bound, *terrain.fixed_objects[i])) {
+      over.push_back(RectOf(*terrain.fixed[i]->box));
+    }
+  }
+
+  // The grid: over what shows of the binder in the viewport, along the axis
+  // its middle 40-60 %, across a little in from its edges.
+  gfx::RectF area =
+      VisibleInRoot(*bound, *root, BorderOf(*bound, PortOf(*bound)));
+  area.Intersect(ViewportRect(*view));
+  if (area.IsEmpty()) {
+    none();
+    return;
+  }
+  const float along_length = vertical ? area.height() : area.width();
+  const float across_length = vertical ? area.width() : area.height();
+  const float along_from =
+      (vertical ? area.y() : area.x()) + 0.4f * along_length;
+  const float along_span = 0.2f * along_length;
+  const float inset = std::min(24.f, std::max(0.f, across_length / 2 - 1));
+  const float across_from = (vertical ? area.x() : area.y()) + inset;
+  const float across_span = std::max(0.f, across_length - 2 * inset);
+  constexpr int kAcross = 12;
+  constexpr int kAlong = 8;
+  constexpr int kCells = kAcross * kAlong;
+  // Every place on the grid, in the frame and in DIPs, and whether the cheap
+  // checks pass there: no fixed box over it, and for a pointer drag no
+  // library zone of any box it is in (InLibraryZone: only toward a side a box
+  // can scroll to, both ends for the binder).
+  Vector<gfx::PointF> roots;
+  Vector<gfx::PointF> places;
+  Vector<bool> open;
+  for (int j = 0; j < kAlong; ++j) {
+    for (int i = 0; i < kAcross; ++i) {
+      const float along = along_from + along_span * (j + 0.5f) / kAlong;
+      const float across = across_from + across_span * (i + 0.5f) / kAcross;
+      const gfx::PointF at =
+          vertical ? gfx::PointF(across, along) : gfx::PointF(along, across);
+      const gfx::PointF place = dips.Dips(at);
+      bool ok = true;
+      for (const gfx::RectF& fixed : over) {
+        if (fixed.Contains(place)) {
+          ok = false;
+          break;
+        }
+      }
+      for (const auto& band : terrain.bands) {
+        if (!ok || !pointer) {
+          break;
+        }
+        if (RectOf(*band->visible).Contains(place) &&
+            InLibraryZone(*band, place, band->id == bound_id)) {
+          ok = false;
+        }
+      }
+      roots.push_back(at);
+      places.push_back(place);
+      open.push_back(ok);
+    }
+  }
+  // The dear checks -- the wheel's latch and Blink's own band walk, a hit
+  // test each -- run only where they are needed, once per place: 0 not yet,
+  // 1 calm, 2 not.
+  Vector<int> verdict(kCells);
+  const auto calm = [&](wtf_size_t k) {
+    if (!open[k]) {
+      return false;
+    }
+    if (!verdict[k]) {
+      const bool ok =
+          moves_it(WheelLatch(*root, roots[k], vertical, forward, nullptr)) &&
+          ProbeAt(*root, roots[k]).side == 0;
+      verdict[k] = ok ? 1 : 2;
+    }
+    return verdict[k] == 1;
+  };
+  // The station: the calm place nearest the hand, tried nearest first.
+  const gfx::PointF hand(hand_x, hand_y);
+  Vector<wtf_size_t> order;
+  for (wtf_size_t k = 0; k < places.size(); ++k) {
+    if (open[k]) {
+      order.push_back(k);
+    }
+  }
+  std::stable_sort(
+      order.begin(), order.end(), [&places, &hand](wtf_size_t a, wtf_size_t b) {
+        return (places[a] - hand).Length() < (places[b] - hand).Length();
+      });
+  int best = -1;
+  for (wtf_size_t k : order) {
+    if (calm(k)) {
+      best = static_cast<int>(k);
+      break;
+    }
+  }
+  if (best < 0) {
+    none();
+    return;
+  }
+
+  // The region: the calm places 4-connected to the station on the grid, each
+  // judged once, their bounds less 3 px each way.
+  Vector<bool> seen(kCells);
+  Vector<int> queue;
+  queue.push_back(best);
+  seen[static_cast<wtf_size_t>(best)] = true;
+  const gfx::PointF start = places[static_cast<wtf_size_t>(best)];
+  float left = start.x();
+  float right = start.x();
+  float top = start.y();
+  float bottom = start.y();
+  const auto visit = [&](int i, int j) {
+    if (i < 0 || j < 0 || i >= kAcross || j >= kAlong) {
+      return;
+    }
+    const auto k = static_cast<wtf_size_t>(j * kAcross + i);
+    if (seen[k]) {
+      return;
+    }
+    seen[k] = true;
+    if (calm(k)) {
+      queue.push_back(j * kAcross + i);
+    }
+  };
+  for (wtf_size_t q = 0; q < queue.size(); ++q) {
+    const int k = queue[q];
+    const gfx::PointF p = places[static_cast<wtf_size_t>(k)];
+    left = std::min(left, p.x());
+    right = std::max(right, p.x());
+    top = std::min(top, p.y());
+    bottom = std::max(bottom, p.y());
+    visit(k % kAcross - 1, k / kAcross);
+    visit(k % kAcross + 1, k / kAcross);
+    visit(k % kAcross, k / kAcross - 1);
+    visit(k % kAcross, k / kAcross + 1);
+  }
+  gfx::RectF region(left, top, right - left, bottom - top);
+  region.Inset(gfx::InsetsF::VH(region.height() > 6 ? 3 : region.height() / 2,
+                                region.width() > 6 ? 3 : region.width() / 2));
+  std::move(callback).Run(true, start.x(), start.y(), BoxOf(region), bound_id,
+                          bound_name);
+}
+
+// browser: a hanging get on the watched set. One call waits at a time; it is
+// answered by the first look on which anything watched changed since
+// since_version, or at its timeout with the frame as it is.
+void AgentSnapshotCollectorImpl::WatchDrag(
+    mojom::blink::AgentDragWatchPtr watch,
+    uint32_t since_version,
+    int32_t timeout_ms,
+    WatchDragCallback callback) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  watch_last_contact_ = now;
+  // The call waiting before this one answers with the frame as it is.
+  AnswerWatch();
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!view || !root->GetWidgetForLocalRoot()) {
+    StopWatch();
+    std::move(callback).Run(watch_frame_ ? watch_frame_.Clone() : EmptyFrame());
+    return;
+  }
+  if (watch->box_node_ids.size() > kWatchBoxes) {
+    watch->box_node_ids.Shrink(kWatchBoxes);
+  }
+  Vector<int32_t> boxes = std::move(watch->box_node_ids);
+  const bool starting = !watch_active_ || watch_view_.Get() != view;
+  if (starting || !(boxes == watch_box_ids_) ||
+      watch->target_node_id != watch_target_id_ ||
+      watch->grab_node_id != watch_grab_id_) {
+    if (starting) {
+      StopWatch();
+      StartWatch(*view);
+    }
+    watch_box_ids_ = std::move(boxes);
+    watch_target_id_ = watch->target_node_id;
+    watch_grab_id_ = watch->grab_node_id;
+    watch_offsets_.clear();
+    watch_still_.clear();
+    watch_moving_.clear();
+    watch_frame_.reset();
+    watch_scroll_ended_ = false;
+    // The first look reads a laid-out page; the looks after it never force
+    // layout.
+    view->UpdateLifecycleToLayoutClean(DocumentUpdateReason::kInspector);
+    if (starting) {
+      // Layouts while no watch ran, or another view's, went uncounted: any
+      // count as one.
+      const uint64_t layouts = LayoutSum(*root);
+      if (watch_counted_view_ && (layouts != watch_layout_count_ ||
+                                  watch_counted_view_.Get() != view)) {
+        ++watch_layout_version_;
+      }
+      watch_layout_count_ = layouts;
+      watch_counted_view_ = view;
+    }
+    watch_target_text_ = ItemText(OwnedElement(root, watch_target_id_));
+    watch_grab_text_ = ItemText(OwnedElement(root, watch_grab_id_));
+    // The lists' names are read by the first look, which follows each slot
+    // into its list.
+    watch_target_holder_ = nullptr;
+    watch_target_list_ = String();
+    watch_grab_holder_ = nullptr;
+    watch_grab_list_ = String();
+    SampleWatch();
+  }
+  watch_callback_ = std::move(callback);
+  watch_since_ = since_version;
+  watch_deadline_ = now + base::Milliseconds(std::clamp(timeout_ms, 16, 2000));
+  MaybeAnswerWatch(now);
+}
+
+// browser: what a press at a point reaches, leaving out the elements named.
+void AgentSnapshotCollectorImpl::DescribePoint(
+    double x,
+    double y,
+    const Vector<int32_t>& exclude_node_ids,
+    bool place,
+    DescribePointCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    std::move(callback).Run(g_empty_string, 0, g_empty_string);
+    return;
+  }
+  HeapHashSet<Member<Node>> excluded;
+  for (int32_t id : exclude_node_ids) {
+    if (Node* node = OwnedNode(root, id)) {
+      excluded.insert(node);
+    }
+  }
+  // Every node under the point, topmost first: a press's hit test (read-only,
+  // into same-process frames) that goes on past the first hit.
+  const RootDips dips(*view, *widget);
+  HitTestLocation location(view->ConvertFromRootFrame(dips.Root(x, y)));
+  HitTestResult result = root->GetEventHandler().HitTestResultAtLocation(
+      location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                    HitTestRequest::kListBased |
+                    HitTestRequest::kPenetratingList |
+                    HitTestRequest::kAllowChildFrameContent);
+  HeapVector<Member<Node>> hits;
+  for (const auto& node : result.ListBasedTestResult()) {
+    hits.push_back(node);
+  }
+  for (Node* node : hits) {
+    auto* element = DynamicTo<Element>(node);
+    if (!element) {
+      element = FlatTreeTraversal::ParentElement(*node);
+    }
+    element = DragTargetOf(element);
+    if (!element || Excluded(element, excluded)) {
+      continue;
+    }
+    // In a frame of this process below the local root's own document: said
+    // so here, since the browser places the local root's own.
+    // browser: naming a cover, the open layer it lies in, as
+    // CoverFrom does -- unless a frame element under the point lies in it:
+    // the element asked for, in another process, is in that frame, so the
+    // layer is its own.
+    const char* layer_kind = nullptr;
+    Element* layer =
+        place ? CoverLayer(*element, nullptr, layer_kind) : nullptr;
+    for (wtf_size_t k = 0; layer && k < hits.size(); ++k) {
+      const auto* owner = DynamicTo<HTMLFrameOwnerElement>(hits[k].Get());
+      if (owner && HoldsAcross(*layer, *owner)) {
+        layer = nullptr;
+      }
+    }
+    String name =
+        layer ? CoverLayerName(*layer, layer_kind) : DescribeHit(*element);
+    if (place && &element->GetDocument() != root->GetDocument()) {
+      name = name + " in another frame";
+    }
+    std::move(callback).Run(
+        NonNull(name), static_cast<int32_t>(DOMNodeIds::IdForNode(element)),
+        SlotValue(*element));
+    return;
+  }
+  std::move(callback).Run(g_empty_string, 0, g_empty_string);
+}
+
+// browser: of the layers given -- a capture's `layers` of this local
+// root, bottom to top, by their roots' and veils' DOMNodeIds (0: none) -- the
+// innermost whose root holds the node, in its flat tree or across the frames
+// of this process that hold it; else the innermost whose veil does; -1 when
+// none does, or the node is not under this local root. Roots first: a veil
+// wrapping a lower layer's root does not take what lies in that layer. A veil
+// counts when it holds the node, not only when it is the node: what a press
+// met may be inside it.
+void AgentSnapshotCollectorImpl::LayerOfNode(
+    int32_t node_id,
+    const Vector<int32_t>& root_node_ids,
+    const Vector<int32_t>& veil_node_ids,
+    LayerOfNodeCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  if (Element* element = OwnedElement(root, node_id)) {
+    for (wtf_size_t k = root_node_ids.size(); k-- > 0;) {
+      const Element* layer = OwnedElement(root, root_node_ids[k]);
+      if (layer && HoldsAcross(*layer, *element)) {
+        std::move(callback).Run(static_cast<int32_t>(k));
+        return;
+      }
+    }
+    for (wtf_size_t k = std::min(root_node_ids.size(), veil_node_ids.size());
+         k-- > 0;) {
+      const Element* veil =
+          veil_node_ids[k] ? OwnedElement(root, veil_node_ids[k]) : nullptr;
+      if (veil && HoldsAcross(*veil, *element)) {
+        std::move(callback).Run(static_cast<int32_t>(k));
+        return;
+      }
+    }
+  }
+  std::move(callback).Run(-1);
+}
+
+namespace {
+
+// browser: the longest text a field reading looks in for pasted text;
+// past it, whether the text is there is not looked for.
+constexpr wtf_size_t kFieldTextMax = 2000000;
+
+// browser: a text's line breaks as \n, as a textarea keeps them, to
+// compare a field's text with what was pasted (Windows writes \r\n).
+String BreaksAsNewlines(const String& text) {
+  String out = text;
+  out.Replace("\r\n", "\n");
+  out.Replace('\r', '\n');
+  return out;
+}
+
+// browser: whether the no-typos rule a typing call sent holds for the
+// element: an input whose type, an autocomplete token, its inputmode or a
+// short maxlength says a wrong character there costs something.
+bool MatchesNoTypos(const Element& element,
+                    const mojom::blink::AgentNoTypos& rule) {
+  const auto* input = DynamicTo<HTMLInputElement>(element);
+  if (!input) {
+    return false;
+  }
+  // The type the input is, an unknown one read as text.
+  const String type = input->type();
+  for (const String& wanted : rule.input_types) {
+    if (EqualIgnoringAsciiCase(type, wanted)) {
+      return true;
+    }
+  }
+  const AtomicString& autocomplete =
+      input->FastGetAttribute(html_names::kAutocompleteAttr);
+  if (!autocomplete.empty()) {
+    for (const String& token :
+         autocomplete.GetString().SimplifyWhiteSpace().Split(' ')) {
+      for (const String& wanted : rule.autocomplete_tokens) {
+        if (EqualIgnoringAsciiCase(token, wanted)) {
+          return true;
+        }
+      }
+      for (const String& prefix : rule.autocomplete_prefixes) {
+        if (!prefix.empty() && token.StartsWithIgnoringAsciiCase(prefix)) {
+          return true;
+        }
+      }
+    }
+  }
+  const AtomicString& mode =
+      input->FastGetAttribute(html_names::kInputmodeAttr);
+  if (!mode.empty()) {
+    for (const String& wanted : rule.input_modes) {
+      if (EqualIgnoringAsciiCase(mode, wanted)) {
+        return true;
+      }
+    }
+  }
+  const int max = input->maxLength();
+  return max > 0 && max <= rule.max_length_at_most;
+}
+
+// browser: two field readings agree: the same field, holding as much,
+// as much of it selected, and (for a paste) the text there or not alike.
+// `moved` is not compared: once the field the keys started in was left, it
+// was, even if the page takes that field away since.
+bool FieldReadingsAgree(const mojom::blink::AgentFieldReading& a,
+                        const mojom::blink::AgentFieldReading& b) {
+  return a.node_id == b.node_id && a.kind == b.kind && a.length == b.length &&
+         a.selected == b.selected && a.contains == b.contains &&
+         a.complete == b.complete && a.bad_input == b.bad_input &&
+         a.part == b.part;
+}
+
+// browser: a reading holds the pasted text: it is in it, or the field
+// is one with text too long to look in. One with no text of its own -- none,
+// other, a code editor's emptied input -- does not.
+bool HoldsPasted(const mojom::blink::AgentFieldReading& reading) {
+  if (reading.contains.has_value()) {
+    return reading.contains.value();
+  }
+  return reading.kind == "value" || reading.kind == "editable";
+}
+
+// browser: an input type drawn as parts a person types.
+bool IsTemporalType(const String& type) {
+  return type == "date" || type == "time" || type == "datetime-local" ||
+         type == "month" || type == "week";
+}
+
+// browser: the kind of a date or time field's part, from its pseudo id
+// (-webkit-datetime-edit-month-field: month); empty for anything else, such
+// as the literal text between parts.
+String TemporalPartKind(const AtomicString& pseudo) {
+  constexpr char kPrefix[] = "-webkit-datetime-edit-";
+  constexpr char kSuffix[] = "-field";
+  constexpr wtf_size_t kPrefixLength = sizeof(kPrefix) - 1;
+  constexpr wtf_size_t kSuffixLength = sizeof(kSuffix) - 1;
+  const String id = pseudo.GetString();
+  if (id.length() <= kPrefixLength + kSuffixLength ||
+      !id.starts_with(kPrefix) || !id.ends_with(kSuffix)) {
+    return g_empty_string;
+  }
+  return id.substr(kPrefixLength, id.length() - kPrefixLength - kSuffixLength);
+}
+
+// browser: a part's integer attribute (aria-valuemin, -max, -now);
+// `fallback` when it has none.
+int PartNumber(const Element& part, const QualifiedName& name, int fallback) {
+  const AtomicString& value = part.FastGetAttribute(name);
+  if (value.IsNull()) {
+    return fallback;
+  }
+  return StringToIntStrict(value).value_or(fallback);
+}
+
+// browser: ColorChooserPopupUIController's action that sets the value
+// (its ColorPickerPopupAction, kept in sync with its picker's script).
+constexpr int kColorPickerSetValue = 0;
+
+// browser: a simple colour, #rrggbb: all the picker's parser is given
+// (it only DCHECKs what it cannot parse).
+bool IsSimpleColor(const String& value) {
+  if (value.length() != 7 || value[0] != '#') {
+    return false;
+  }
+  for (wtf_size_t i = 1; i < 7; ++i) {
+    if (!IsAsciiHexDigit(value[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// browser: how many elements a search for the field whose chooser is
+// open looks at, at most.
+constexpr int kFileScanBudget = 50000;
+
+// browser: whether a person sees `element` to press it: laid out,
+// visible, at least 4 by 4 px, and not clipped away by `clip` on a box out
+// of the flow, as a field kept for screen readers is. An opacity:0 one
+// stretched over a button shows: a person presses it there; so does one a
+// decorative clip-path shapes. Style and layout clean.
+bool ShowsABox(const Element& element) {
+  const LayoutObject* layout_object = element.GetLayoutObject();
+  if (!layout_object) {
+    return false;
+  }
+  const ComputedStyle& style = layout_object->StyleRef();
+  if (style.Visibility() != EVisibility::kVisible ||
+      (!style.HasAutoClip() && style.HasOutOfFlowPosition())) {
+    return false;
+  }
+  const gfx::RectF box = layout_object->AbsoluteBoundingBoxRectF();
+  return box.width() >= 4 && box.height() >= 4;
+}
+
+// browser: Input.chooseFiles' reading of `element` (the mojom's
+// AgentFileReading), its files matched against `want` when given; kind gone
+// for none. Every string is set: a null one fails the browser's check of the
+// answer, which ends this renderer. Style and layout clean.
+mojom::blink::AgentFileReadingPtr FileReadingOf(Element* element,
+                                                const Vector<String>* want) {
+  auto reading = mojom::blink::AgentFileReading::New();
+  reading->kind = "gone";
+  reading->field = g_empty_string;
+  reading->accept = g_empty_string;
+  reading->opener = g_empty_string;
+  reading->label = g_empty_string;
+  if (!element) {
+    return reading;
+  }
+  auto* input = DynamicTo<HTMLInputElement>(element);
+  reading->kind = "file";
+  if (auto* label = DynamicTo<HTMLLabelElement>(element)) {
+    input = DynamicTo<HTMLInputElement>(label->Control());
+    reading->kind = "label";
+  }
+  if (!input ||
+      input->FormControlType() != mojom::blink::FormControlType::kInputFile) {
+    reading->kind = "other";
+    return reading;
+  }
+  reading->field_node_id = static_cast<int32_t>(DOMNodeIds::IdForNode(input));
+  reading->field = DescribeHit(*input);
+  reading->disabled = input->IsDisabledFormControl();
+  reading->multiple = input->Multiple();
+  reading->folder = input->FastHasAttribute(html_names::kWebkitdirectoryAttr);
+  FileList* files = input->files();
+  reading->count = files ? static_cast<int32_t>(files->length()) : 0;
+  if (want && !want->empty() && files && files->length() == want->size()) {
+    reading->matches = true;
+    for (unsigned i = 0; i < files->length(); ++i) {
+      const File* file = files->item(i);
+      if (!file || file->name() != (*want)[i]) {
+        reading->matches = false;
+        break;
+      }
+    }
+  }
+  reading->open = input->IsPickerVisible();
+  reading->rendered = ShowsABox(*input);
+  const AtomicString& accept = input->FastGetAttribute(html_names::kAcceptAttr);
+  if (!accept.IsNull()) {
+    reading->accept = accept.GetString();
+  }
+  if (LabelsNodeList* labels = input->labels()) {
+    for (unsigned i = 0; i < labels->length(); ++i) {
+      Element* label = labels->item(i);
+      if (label && ShowsABox(*label)) {
+        reading->label_node_id =
+            static_cast<int32_t>(DOMNodeIds::IdForNode(label));
+        reading->label = DescribeHit(*label);
+        break;
+      }
+    }
+  }
+  if (!reading->rendered && !reading->label_node_id) {
+    // What may open it: the nearest element around it that shows and
+    // listens for a press, as a drop zone that forwards its click to it.
+    const Element* body = input->GetDocument().body();
+    for (Element* around = FlatTreeTraversal::ParentElement(*input);
+         around && around != body;
+         around = FlatTreeTraversal::ParentElement(*around)) {
+      if (ShowsABox(*around) && HasClickListener(around)) {
+        reading->opener = DescribeHit(*around);
+        break;
+      }
+    }
+  }
+  return reading;
+}
+
+// browser: the file input in `scope`, shadow trees in, whose chooser
+// is open; null for none, or once `budget` elements have been looked at.
+HTMLInputElement* OpenFileInputIn(ContainerNode& scope, int& budget) {
+  for (Element* element = ElementTraversal::FirstWithin(scope);
+       element && budget-- > 0;
+       element = ElementTraversal::Next(*element, &scope)) {
+    auto* input = DynamicTo<HTMLInputElement>(element);
+    if (input &&
+        input->FormControlType() == mojom::blink::FormControlType::kInputFile &&
+        input->IsPickerVisible()) {
+      return input;
+    }
+    ShadowRoot* shadow = element->GetShadowRoot();
+    if (shadow && !shadow->IsUserAgent()) {
+      if (HTMLInputElement* inside = OpenFileInputIn(*shadow, budget)) {
+        return inside;
+      }
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+// browser: what ReadField was asked.
+struct AgentSnapshotCollectorImpl::FieldAsk {
+  int32_t before_node_id = 0;
+  // The pasted text, line breaks as \n; null when not looked for.
+  String expect;
+  bool settle = false;
+  // How long a reading has to hold before it is the answer.
+  base::TimeDelta quiet;
+  bool settle_for_text = false;
+  mojom::blink::AgentNoTyposPtr no_typos;
+};
+
+// browser: a cheap mark of what a field reading reads -- the focused
+// element, its document's DOM tree version (a text edit moves it), and a
+// text control's selection. The same mark, the same reading.
+struct AgentSnapshotCollectorImpl::FieldMark {
+  int32_t node_id = 0;
+  // browser: the element that has focus itself -- a date field's part,
+  // which node_id names as its field: focus moving between parts, which
+  // changes no attribute and no text, changes it.
+  int32_t focus_id = 0;
+  uint64_t dom_version = 0;
+  unsigned selection_start = 0;
+  unsigned selection_end = 0;
+
+  bool operator==(const FieldMark&) const = default;
+};
+
+// browser: what the focused field holds, for the keystroke and paste
+// answers -- facts, never its value.
+void AgentSnapshotCollectorImpl::ReadField(
+    int32_t before_node_id,
+    const String& expect,
+    int32_t settle_ms,
+    int32_t quiet_ms,
+    bool settle_for_text,
+    mojom::blink::AgentNoTyposPtr no_typos,
+    ReadFieldCallback callback) {
+  FieldAsk ask;
+  ask.before_node_id = before_node_id;
+  ask.expect = expect.IsNull() ? String() : BreaksAsNewlines(expect);
+  ask.settle = settle_ms > 0;
+  ask.quiet = base::Milliseconds(std::clamp(quiet_ms, 0, kSettleMaxMs));
+  ask.settle_for_text = settle_for_text && !expect.IsNull();
+  ask.no_typos = std::move(no_typos);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  PollField(std::move(ask),
+            now + base::Milliseconds(std::clamp(settle_ms, 0, kSettleMaxMs)),
+            nullptr, FieldMark(), now, std::move(callback));
+}
+
+void AgentSnapshotCollectorImpl::PollField(
+    FieldAsk ask,
+    base::TimeTicks deadline,
+    mojom::blink::AgentFieldReadingPtr last,
+    FieldMark last_mark,
+    base::TimeTicks held_since,
+    ReadFieldCallback callback) {
+  // A look whose mark is the last one's is that reading again, not read: a
+  // large editor's text is not gone through every frame.
+  const FieldMark mark = FieldMarkNow();
+  mojom::blink::AgentFieldReadingPtr reading =
+      last && mark == last_mark ? last.Clone() : ReadFieldNow(ask);
+  const base::TimeTicks at = base::TimeTicks::Now();
+  const bool agree = last && FieldReadingsAgree(*last, *reading);
+  if (!agree) {
+    held_since = at;
+  }
+  // Held: the same on two looks at least, and for `quiet` -- a mask or a
+  // framework that applies a change a tick later has had the time to.
+  const bool held = agree && at - held_since >= ask.quiet;
+  const bool holds = !ask.settle_for_text || HoldsPasted(*reading);
+  if (!ask.settle || (held && holds) || at >= deadline) {
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostDelayedTask(
+          FROM_HERE,
+          blink::BindOnce(&AgentSnapshotCollectorImpl::PollField,
+                          WrapWeakPersistent(this), std::move(ask), deadline,
+                          std::move(reading), mark, held_since,
+                          std::move(callback)),
+          kSettleLook);
+}
+
+Element* AgentSnapshotCollectorImpl::FocusedField(LocalFrame*& frame) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  frame = root;
+  if (!root) {
+    return nullptr;
+  }
+  // The focused frame when it is one of this local root's: a field in a
+  // same-process frame is read there.
+  if (Page* page = root->GetPage()) {
+    LocalFrame* focused = page->GetFocusController().FocusedFrame();
+    if (focused && &focused->LocalFrameRoot() == root) {
+      frame = focused;
+    }
+  }
+  Document* document = frame->GetDocument();
+  Element* element = document ? document->FocusedElement() : nullptr;
+  // browser: a part of a control's own user-agent shadow tree -- a date
+  // field's month, day or year -- is the control.
+  while (element && element->IsInUserAgentShadowRoot()) {
+    element = element->OwnerShadowHost();
+  }
+  if (!element || element == document->body() ||
+      element == document->documentElement()) {
+    return nullptr;
+  }
+  return element;
+}
+
+AgentSnapshotCollectorImpl::FieldMark
+AgentSnapshotCollectorImpl::FieldMarkNow() {
+  FieldMark mark;
+  LocalFrame* frame = nullptr;
+  Element* element = FocusedField(frame);
+  if (!element) {
+    return mark;
+  }
+  mark.node_id = static_cast<int32_t>(DOMNodeIds::IdForNode(element));
+  if (Element* focused = frame->GetDocument()->FocusedElement()) {
+    mark.focus_id = static_cast<int32_t>(DOMNodeIds::IdForNode(focused));
+  }
+  mark.dom_version = element->GetDocument().DomTreeVersion();
+  if (const auto* control = ToTextControlOrNull(element)) {
+    mark.selection_start = control->selectionStart();
+    mark.selection_end = control->selectionEnd();
+  }
+  return mark;
+}
+
+mojom::blink::AgentFieldReadingPtr AgentSnapshotCollectorImpl::ReadFieldNow(
+    const FieldAsk& ask) {
+  auto reading = mojom::blink::AgentFieldReading::New();
+  reading->kind = "none";
+  // Every string is set: a null one fails the browser's check of the answer,
+  // which ends this renderer. Empty is "not set" there.
+  reading->frame_id = g_empty_string;
+  reading->editor = g_empty_string;
+  reading->what = g_empty_string;
+  reading->tag = g_empty_string;
+  reading->input_type = g_empty_string;
+  reading->part = g_empty_string;
+  LocalFrame* frame = nullptr;
+  Element* element = FocusedField(frame);
+  // The field a reading before found, still in the page and no longer the
+  // focused one: focus moved on by itself -- to a split code's next box, or to
+  // nothing, as a box that lets go after its last digit does.
+  if (ask.before_node_id > 0) {
+    Element* before =
+        OwnedElement(GetSupplementable()->GetFrame(), ask.before_node_id);
+    reading->moved = before && before != element && before->isConnected();
+  }
+  if (!element) {
+    return reading;
+  }
+  element->GetDocument().UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  if (!element->isConnected()) {
+    return reading;
+  }
+  reading->node_id = static_cast<int32_t>(DOMNodeIds::IdForNode(element));
+  reading->frame_id = String(frame->GetDevToolsFrameToken().ToString());
+  if (ask.no_typos) {
+    reading->strict = MatchesNoTypos(*element, *ask.no_typos);
+  }
+  // The hidden input of a code editor, emptied after every key: its length
+  // says nothing of the editor's document.
+  if (IsA<HTMLTextAreaElement>(*element)) {
+    if (Element* host = element->closest(
+            AtomicString(".CodeMirror,.ace_editor,.monaco-editor"))) {
+      reading->kind = "editor";
+      reading->editor =
+          host->HasClassName(AtomicString("CodeMirror"))   ? "CodeMirror"
+          : host->HasClassName(AtomicString("ace_editor")) ? "Ace"
+                                                           : "Monaco";
+      return reading;
+    }
+  }
+  // browser: a date or time field, whichever part has focus: whether it
+  // holds a whole value, a part with none of a whole, and the part with focus.
+  if (const auto* input = DynamicTo<HTMLInputElement>(element);
+      input && IsTemporalType(input->type())) {
+    reading->kind = "temporal";
+    reading->input_type = input->type();
+    reading->readonly = input->FastHasAttribute(html_names::kReadonlyAttr);
+    reading->disabled = input->IsDisabledFormControl();
+    reading->complete = !input->Value().empty();
+    reading->bad_input = input->HasBadInput();
+    if (const Element* part = element->GetDocument().FocusedElement();
+        part && part != element) {
+      reading->part = TemporalPartKind(part->ShadowPseudoId());
+    }
+    return reading;
+  }
+  String text;
+  // A text field or a textarea: an input of another type (a checkbox, a date)
+  // holds no text of its own (ToTextControlOrNull, not To<>, which takes any
+  // input).
+  if (auto* control = ToTextControlOrNull(element)) {
+    reading->kind = "value";
+    text = control->Value();
+    const auto* input = DynamicTo<HTMLInputElement>(element);
+    if (!input || input->InputSupportsSelectionAPI()) {
+      const unsigned start = control->selectionStart();
+      const unsigned end = control->selectionEnd();
+      reading->selected = end > start ? static_cast<int32_t>(end - start) : 0;
+    }
+    reading->readonly = control->FastHasAttribute(html_names::kReadonlyAttr);
+    reading->disabled = control->IsDisabledFormControl();
+    reading->max_length = control->maxLength();
+  } else if (const auto* html = DynamicTo<HTMLElement>(element);
+             html && html->isContentEditableForBinding()) {
+    reading->kind = "editable";
+    text = element->innerText();
+    reading->selected =
+        static_cast<int32_t>(frame->Selection().SelectedText().length());
+  } else {
+    // Something that holds no text -- a button, a select, a checkbox -- named
+    // so that a reply can say what the keys went to.
+    reading->kind = "other";
+    reading->what = DescribeHit(*element);
+    reading->tag = element->localName();
+    if (const auto* input = DynamicTo<HTMLInputElement>(element)) {
+      reading->input_type = input->type();
+    }
+    return reading;
+  }
+  reading->length = static_cast<int32_t>(text.length());
+  if (!ask.expect.IsNull() && text.length() <= kFieldTextMax) {
+    if (IsA<HTMLInputElement>(*element)) {
+      // A single-line input takes a paste with its trailing line breaks cut
+      // and the others made spaces (TextFieldInputType's text insertion).
+      String expect = ask.expect;
+      wtf_size_t end = expect.length();
+      while (end > 0 && expect[end - 1] == '\n') {
+        --end;
+      }
+      expect = expect.substr(0, end);
+      expect.Replace('\n', ' ');
+      reading->contains = text.contains(expect);
+    } else if (reading->kind == "editable") {
+      // An editor makes paragraphs of the pasted lines, which its text reads
+      // with blank lines between: compared with white space as one space.
+      reading->contains =
+          text.SimplifyWhiteSpace().contains(ask.expect.SimplifyWhiteSpace());
+    } else {
+      reading->contains = BreaksAsNewlines(text).contains(ask.expect);
+    }
+  }
+  return reading;
+}
+
+// browser: Input.fillDateTime's read of a date or time field.
+void AgentSnapshotCollectorImpl::ReadTemporal(int32_t local_dom_node_id,
+                                              const String& want,
+                                              ReadTemporalCallback callback) {
+  auto reading = mojom::blink::AgentTemporalReading::New();
+  reading->kind = "gone";
+  // Every string is set: a null one fails the browser's check of the answer,
+  // which ends this renderer.
+  reading->format = g_empty_string;
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  if (!element) {
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  auto* input = DynamicTo<HTMLInputElement>(element);
+  if (!input || !IsTemporalType(input->type())) {
+    reading->kind = "notTemporal";
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  // Same layout update as the capture path; geometry only, no AX cache.
+  element->GetDocument().UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  if (!element->isConnected()) {
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  reading->kind = input->type();
+  reading->disabled = input->IsDisabledFormControl();
+  reading->readonly = input->FastHasAttribute(html_names::kReadonlyAttr);
+  reading->complete = !input->Value().empty();
+  reading->bad_input = input->HasBadInput();
+  reading->range_underflow = input->RangeUnderflow();
+  reading->range_overflow = input->RangeOverflow();
+  reading->step_mismatch = input->StepMismatch();
+  // Right to left as the parts take their arrows: by the locale they are drawn
+  // in, not the page's direction (DateTimeFieldElement's keyboard handling).
+  reading->rtl = input->GetLocale().IsRtl();
+  reading->number = input->valueAsNumber();
+  reading->want_number = std::numeric_limits<double>::quiet_NaN();
+  // The value asked, as the field would take it: an input of the same type,
+  // min, max, step and value attribute (a step's base without a min), made in
+  // the inert template document -- frameless, so the page's document, its DOM
+  // version and the settle reading it see nothing of it.
+  if (!want.empty()) {
+    auto* probe = MakeGarbageCollected<HTMLInputElement>(
+        input->GetDocument().EnsureTemplateDocument());
+    probe->setType(AtomicString(input->type()));
+    for (const QualifiedName* name :
+         {&html_names::kMinAttr, &html_names::kMaxAttr, &html_names::kStepAttr,
+          &html_names::kValueAttr}) {
+      const AtomicString& limit = input->FastGetAttribute(*name);
+      if (!limit.IsNull()) {
+        probe->setAttribute(*name, limit);
+      }
+    }
+    probe->SetValue(want);
+    reading->want_valid = !probe->Value().empty();
+    if (reading->want_valid) {
+      reading->want_underflow = probe->RangeUnderflow();
+      reading->want_overflow = probe->RangeOverflow();
+      reading->want_step_mismatch = probe->StepMismatch();
+      reading->want_number = probe->valueAsNumber();
+    }
+  }
+  // Its parts: the children of its edit's fields wrapper, in the order it
+  // draws them (DateTimeEditElement); none when it is drawn without them.
+  ShadowRoot* shadow = input->UserAgentShadowRoot();
+  Element* edit =
+      shadow ? shadow->getElementById(shadow_element_names::kIdDateTimeEdit)
+             : nullptr;
+  Element* fields = edit ? ElementTraversal::FirstChild(*edit) : nullptr;
+  if (edit) {
+    const AtomicString& format =
+        edit->getAttribute(AtomicString("datetimeformat"));
+    if (!format.IsNull()) {
+      reading->format = format.GetString();
+    }
+  }
+  const Element* focused = input->GetDocument().FocusedElement();
+  for (Element* part = fields ? ElementTraversal::FirstChild(*fields) : nullptr;
+       part; part = ElementTraversal::NextSibling(*part)) {
+    const String kind = TemporalPartKind(part->ShadowPseudoId());
+    if (kind.empty()) {
+      continue;
+    }
+    auto piece = mojom::blink::AgentTemporalPart::New();
+    piece->kind = kind;
+    piece->node_id = static_cast<int32_t>(DOMNodeIds::IdForNode(part));
+    piece->min = PartNumber(*part, html_names::kAriaValueminAttr, 0);
+    piece->max = PartNumber(*part, html_names::kAriaValuemaxAttr, -1);
+    piece->value = PartNumber(*part, html_names::kAriaValuenowAttr, -1);
+    piece->disabled = part->FastHasAttribute(html_names::kDisabledAttr);
+    piece->focused = focused == part;
+    reading->focused = reading->focused || piece->focused;
+    reading->parts.push_back(std::move(piece));
+  }
+  std::move(callback).Run(std::move(reading));
+}
+
+// browser: Input.pickColor's read of a colour field.
+void AgentSnapshotCollectorImpl::ReadColor(int32_t local_dom_node_id,
+                                           const String& want,
+                                           ReadColorCallback callback) {
+  auto reading = mojom::blink::AgentColorReading::New();
+  // Every string is set: a null one fails the browser's check of the answer,
+  // which ends this renderer.
+  reading->kind = "gone";
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  if (!element) {
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  auto* input = DynamicTo<HTMLInputElement>(element);
+  if (!input ||
+      input->FormControlType() != mojom::blink::FormControlType::kInputColor) {
+    reading->kind = "notColor";
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  reading->kind = "color";
+  reading->disabled = input->IsDisabledFormControl();
+  // As the field would take it (SanitizeValue reads, and sets nothing): its
+  // own form for its alpha and colorspace, as a pick stores it. Only a simple
+  // colour: SanitizeValue makes anything it cannot parse black, which a black
+  // field would match.
+  reading->matches = !want.empty() && IsSimpleColor(want) &&
+                     input->Value() == input->SanitizeValue(want);
+  reading->picker_shown = OpenPopupOf(*input) != nullptr;
+  std::move(callback).Run(std::move(reading));
+}
+
+// browser: Input.pickColor's pick in a colour field's open picker (the
+// mojom says what).
+void AgentSnapshotCollectorImpl::CommitColor(int32_t local_dom_node_id,
+                                             const String& value,
+                                             CommitColorCallback callback) {
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  auto* input = DynamicTo<HTMLInputElement>(element);
+  if (!input ||
+      input->FormControlType() != mojom::blink::FormControlType::kInputColor) {
+    std::move(callback).Run(element ? "notColor" : "gone");
+    return;
+  }
+  if (!value.empty() && !IsSimpleColor(value)) {
+    std::move(callback).Run("badValue");
+    return;
+  }
+  // The picker is a page popup on a page of its own, which input from
+  // outside cannot reach. Its controller is what the picker's own script
+  // calls: the value set (ColorInputType::DidChooseColor: a trusted input,
+  // nothing for a disabled field or the same colour) and the picker closed
+  // (DidEndChooser: change, queued for the next frame), as for a person who
+  // types the code and presses Enter. Only in a picker the browser has shown:
+  // a person cannot pick in one it refused. An empty value closes one it has
+  // not shown yet too, which would otherwise show after the pick was given
+  // up and stay open.
+  WebPagePopupImpl* popup = OpenPopupOf(*input, /*shown_only=*/!value.empty());
+  LocalDOMWindow* window = popup ? popup->Window() : nullptr;
+  LocalFrame* frame = window ? window->GetFrame() : nullptr;
+  Page* page = frame ? frame->GetPage() : nullptr;
+  PagePopupController* controller =
+      page ? PagePopupController::From(*page) : nullptr;
+  if (!controller) {
+    std::move(callback).Run("notOpen");
+    return;
+  }
+  if (value.empty()) {
+    // Closed with nothing chosen, as Escape closes it on a value not changed.
+    controller->closePopup();
+    std::move(callback).Run("closed");
+    return;
+  }
+  controller->setValueAndClosePopup(kColorPickerSetValue, value,
+                                    /*is_keyboard_event=*/false);
+  std::move(callback).Run("picked");
+}
+
+// browser: Input.chooseFiles' read of an element.
+void AgentSnapshotCollectorImpl::ReadFileField(int32_t local_dom_node_id,
+                                               const Vector<String>& want,
+                                               ReadFileFieldCallback callback) {
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  if (element) {
+    // Same layout update as the capture path; geometry only, no AX cache.
+    element->GetDocument().UpdateStyleAndLayout(
+        DocumentUpdateReason::kInspector);
+    if (!element->isConnected()) {
+      element = nullptr;
+    }
+  }
+  std::move(callback).Run(FileReadingOf(element, &want));
+}
+
+// browser: Input.chooseFiles' read of the field whose chooser is open.
+void AgentSnapshotCollectorImpl::ReadOpenFileField(
+    const String& frame_id,
+    ReadOpenFileFieldCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  HTMLInputElement* open = nullptr;
+  for (Frame* frame = root; frame; frame = frame->Tree().TraverseNext(root)) {
+    auto* local = DynamicTo<LocalFrame>(frame);
+    if (!local || &local->LocalFrameRoot() != root || !local->GetDocument() ||
+        String(local->GetDevToolsFrameToken().ToString()) != frame_id) {
+      continue;
+    }
+    // Only the frame the chooser came from: a page queues choosers, and each
+    // one queued marks its field open.
+    int budget = kFileScanBudget;
+    open = OpenFileInputIn(*local->GetDocument(), budget);
+    if (!open && budget <= 0) {
+      // Too large a page to look through: not known, rather than none.
+      auto reading = FileReadingOf(nullptr, nullptr);
+      reading->kind = "unread";
+      std::move(callback).Run(std::move(reading));
+      return;
+    }
+    break;
+  }
+  if (open) {
+    open->GetDocument().UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+    if (!open->isConnected()) {
+      open = nullptr;
+    }
+  }
+  std::move(callback).Run(FileReadingOf(open, nullptr));
+}
+
+// browser: an element's slot as it is now.
+void AgentSnapshotCollectorImpl::ReadSlot(int32_t node_id,
+                                          ReadSlotCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  mojom::blink::AgentSlotPtr slot;
+  if (widget && view) {
+    view->UpdateLifecycleToLayoutClean(DocumentUpdateReason::kInspector);
+    const RootDips dips(*view, *widget);
+    slot = SlotOf(OwnedElement(root, node_id), dips, nullptr);
+  } else {
+    slot = EmptySlot();
+  }
+  slot->id = node_id;
+  std::move(callback).Run(std::move(slot));
+}
+
+// browser: the value a range input takes for a press or a drag at a point,
+// as SliderThumbElement::SetPositionFromPoint computes it, set nowhere.
+void AgentSnapshotCollectorImpl::ValueAtPoint(int32_t node_id,
+                                              double x,
+                                              double y,
+                                              ValueAtPointCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    std::move(callback).Run(false, 0);
+    return;
+  }
+  view->UpdateLifecycleToLayoutClean(DocumentUpdateReason::kInspector);
+  auto* input = DynamicTo<HTMLInputElement>(OwnedElement(root, node_id));
+  SliderParts parts;
+  if (!input || !ReadSliderParts(*input, parts)) {
+    std::move(callback).Run(false, 0);
+    return;
+  }
+  const RootDips dips(*view, *widget);
+  const StepRange range(input->CreateStepRange(kRejectAny));
+  const Decimal value =
+      SliderValueAt(*input, parts, range, AlongTrack(parts, dips.Root(x, y)));
+  std::move(callback).Run(true, value.ToDouble());
+}
+
+// browser: Input.revealElement's outer stages. The frame element that
+// holds the frame with this DevTools token, among this local root's frames
+// and their children (in this process or another), as
+// InspectorDOMAgent::getFrameOwner finds one.
+void AgentSnapshotCollectorImpl::OwnerOf(const String& frame_token,
+                                         OwnerOfCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  if (!root) {
+    std::move(callback).Run(false, 0);
+    return;
+  }
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(root, frames);
+  for (LocalFrame* frame : frames) {
+    for (Frame* child = frame->FirstChild(); child;
+         child = child->NextSibling()) {
+      if (String(child->GetDevToolsFrameToken().ToString()) != frame_token) {
+        continue;
+      }
+      auto* owner = DynamicTo<HTMLFrameOwnerElement>(child->Owner());
+      if (!owner || !owner->isConnected()) {
+        break;
+      }
+      std::move(callback).Run(
+          true, static_cast<int32_t>(DOMNodeIds::IdForNode(owner)));
+      return;
+    }
+  }
+  std::move(callback).Run(false, 0);
+}
