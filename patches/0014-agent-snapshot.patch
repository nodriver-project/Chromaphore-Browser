+
+#include <cstdint>
+
+#include "base/functional/function_ref.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+class Document;
+class Element;
+class Node;
+
+// browser: the live regions of a document, read from attributes, the layout
+// tree and the style the page already has. Nothing here forces style or
+// layout, runs script or makes an accessibility tree, so the settle watcher
+// may call it between frames; the collector calls it at a capture and for
+// LiveRegions.
+//
+// The walks are the collector's and the settle watcher's: tree order over the
+// document, a host's shadow tree (open or closed, not a form control's
+// user-agent tree) before its light children, never into a child frame's
+// document, and without a stack or a slot-assignment recalc.
+namespace agent_live_regions {
+
+// The attribute rule: aria-live polite or assertive; a role whose first
+// token is alert, status or log; or <output>. aria-live="off" is not. Reads
+// attributes only.
+bool IsRegionRoot(const Element& element);
+
+// Only for a region root: "alert" | "status" | "log" | "output" | "live", and
+// whether it is assertive (alerts included, unless aria-live says polite).
+void DescribeRegion(const Element& root, String& kind, bool& assertive);
+
+// Whether a region root counts now: not aria-busy="true", no
+// aria-hidden="true" on it or a flat-tree ancestor (by the last slot
+// assignment), rendered (a LayoutObject, or display: contents with a rendered
+// child) and visibility visible, from the style it already has. Forces
+// nothing.
+bool RegionCounts(const Element& root);
+
+// Its text: rendered text nodes with visibility visible, in the walk's order,
+// leaving out nested region roots' subtrees, aria-hidden subtrees, and the
+// text of text fields, textareas and contenteditable hosts (nothing at all
+// for a root that is one or lies inside one, or in a design-mode document);
+// whitespace squashed, and a space where text moves to another block or
+// past a <br>. `hash` covers the whole text up to 20 000 characters and does
+// not depend on `is_log`; it is 0 exactly when the text is empty. `*shown`,
+// when `shown` is not null, is 300 characters, the last 300 when `is_log`,
+// else the first; a root laid out bottom up (a column-reverse flexbox) is
+// read in the order it shows, its last child first. `*shown` is cut at a
+// word and marked "..." (U+2026) at the cut end when the text is longer.
+// With `shown` null it allocates nothing (the watcher's change check);
+// otherwise it allocates only `*shown`. Forces nothing. With `hash_all`
+// false it stops once the kept characters are read, so `hash` covers only
+// those (a reader that wants the text, not the hash).
+void ReadRegionText(const Element& root,
+                    bool is_log,
+                    uint64_t& hash,
+                    String* shown,
+                    bool hash_all = true);
+
+// browser: the most an `added` keeps, from its start.
+constexpr wtf_size_t kAddedChars = 4000;
+
+// browser: a log region's text kept at its ends, as ReadRegionText reads
+// it: all of it up to 16 000 characters (in `head`, `tail` null), else its
+// first 8 000 and its last 8 000.
+struct RegionEnds {
+  String head;
+  String tail;
+  size_t length = 0;
+
+  // Its last characters: 8 000, or more when it is whole.
+  const String& Last() const { return tail.IsNull() ? head : tail; }
+};
+
+// browser: whether `root` is a log by its role (DescribeRegion's
+// "log"). Reads the attribute only.
+bool IsLogRoot(const Element& root);
+
+// browser: `root`'s text, kept at its ends. Allocates what it keeps. Forces
+// nothing.
+RegionEnds ReadRegionEnds(const Element& root);
+
+// browser: what a log's change added, from its text before (`was`) to
+// its text now: appended -- what follows the place in `now` where `was` ended
+// (its last 4 000, or all of it) -- or, when none, prepended (`*prepended`
+// set) -- what precedes the place where it began; all of `now` when `was` was
+// empty. Null when it can tell neither (rewritten, removed, or a change too
+// large for the kept ends to place). 4 000 characters at most, from its
+// start, as read: its edge space kept, so pieces join as they stood.
+String AddedText(const RegionEnds& was, const RegionEnds& now, bool* prepended);
+
+// browser: `text` as the wire shows it: 300 characters from its start,
+// cut at a word and marked "..." (U+2026) when longer.
+String ShownStart(const String& text);
+
+// The node after `node` in the walks' order (above), within `root`'s subtree
+// (the whole document when `root` is null), without a stack. `skip_children`
+// leaves `node`'s own subtree out.
+Node* NextInWalk(const Node& node, const Node* root, bool skip_children);
+
+// A stackless walk of `document`'s rendered nodes (open and closed shadow
+// roots, not into frames; a subtree with no LayoutObject that is not display:
+// contents, and a locked display lock's contents, left out), calling `visit`
+// for each region root, within `budget` nodes (decremented; stops at 0).
+// Forces nothing.
+void ForEachRegionRoot(Document& document,
+                       int& budget,
+                       base::FunctionRef<void(Element&)> visit);
+
+}  // namespace agent_live_regions
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_AGENT_SNAPSHOT_AGENT_LIVE_REGIONS_H_
