+constexpr size_t kMaxListings = 3;
+constexpr size_t kMaxLiveEntries = 20000;
+constexpr size_t kMaxPruned = 2000;
+constexpr size_t kMaxRegions = 2000;
+constexpr size_t kMaxDropped = 10000;
+
+// The last agentNodeId or regionId a counter hands out, short of wrapping.
+constexpr int kLastId = std::numeric_limits<int32_t>::max() - 1;
+
+// The browser-wide counters (UI thread): the last agentNodeId and the last
+// regionId minted. Two, so a region id never reads as an element's.
+int& LastAgentNodeId() {
+  static int last = 0;
+  return last;
+}
+
+int& LastRegionId() {
+  static int last = 0;
+  return last;
+}
+
+// The next id from `last`, or 0 once it has handed out kLastId.
+int NextId(int& last, const char* what) {
+  if (last >= kLastId) {
+    return 0;
+  }
+  if (++last == kLastId) {
+    LOG(WARNING) << what << " reached its last value; no more are minted";
+  }
+  return last;
+}
+
+// Listing and document names, from 64-bit counters that do not wrap.
+std::string NextListingId() {
+  static uint64_t last = 0;
+  return base::StrCat({"L", base::NumberToString(++last)});
+}
+
+std::string NextDocumentId() {
+  static uint64_t last = 0;
+  return base::StrCat({"D", base::NumberToString(++last)});
+}
+
+// The document the host holds now. The checked getter crashes on a host
+// pending commit; the space only hangs on committed hosts, and a caller's
+// slip must not take the browser down.
+blink::DocumentToken TokenOf(RenderFrameHost& rfh) {
+  return static_cast<RenderFrameHostImpl&>(rfh)
+      .GetDocumentTokenIgnoringSafetyRestrictions();
+}
+
+bool IsListed(AgentPlace place) {
+  return place == AgentPlace::kView || place == AgentPlace::kOffscreen ||
+         place == AgentPlace::kCovered;
+}
+
+// The states a delta compares: `focused` goes in the page-level focus field,
+// and `visible` is always present.
+std::vector<std::string> ComparedStates(const std::vector<std::string>& all) {
+  std::vector<std::string> states;
+  for (const std::string& state : all) {
+    if (state != "focused" && state != "visible") {
+      states.push_back(state);
+    }
+  }
+  return states;
+}
+
+// n for a label "a<n>" (n >= 1, no leading zero), else 0.
+int LabelNumber(std::string_view label) {
+  if (label.size() < 2 || label.size() > 11 || label[0] != 'a' ||
+      label[1] == '0') {
+    return 0;
+  }
+  int64_t n = 0;
+  for (char c : label.substr(1)) {
+    if (c < '0' || c > '9') {
+      return 0;
+    }
+    n = n * 10 + (c - '0');
+  }
+  return n <= std::numeric_limits<int32_t>::max() ? static_cast<int>(n) : 0;
+}
+
+struct PlaceRecord {
+  enum class Kind { kNone, kAdded, kRemoved };
+  Kind kind = Kind::kNone;
+  const char* why = "";
+  // Rule 1: no record, and the element keeps its baseline placement.
+  bool held_back = false;
+};
+
+// The spec's section 3b table: the first rule that applies. `from` is empty
+// when the baseline does not hold the element; `shown` is where the baseline
+// listed it, which differs from `from` only for an element held at its
+// earlier placement by rule 1 (rules 2 to 5 read it); `told`: its reach now
+// was told; `appended`: never listed before, and minted since the document's
+// first listing; `listed_first`: listed now for the first time in the
+// document.
+PlaceRecord RecordFor(std::optional<AgentPlace> from,
+                      std::optional<AgentPlace> shown,
+                      AgentPlace to,
+                      bool told,
+                      bool minted_after,
+                      bool appended,
+                      bool listed_first) {
+  using P = AgentPlace;
+  using K = PlaceRecord::Kind;
+  // browser: the main scroller alone is not listed, and reads as
+  // unlisted on both sides: a listed element that becomes only the scroller
+  // is removed as hidden, and one listed again is added as shown.
+  const auto unlisted = [](std::optional<P> place) {
+    return place == P::kScroller ? std::optional<P>(P::kUnlisted) : place;
+  };
+  from = unlisted(from);
+  shown = unlisted(shown);
+  to = *unlisted(to);
+  const bool was_listed = shown && IsListed(*shown);
+  // 1. Back into reach, but a test that would confirm it ran out of budget.
+  if ((from == P::kCovered || from == P::kBehind) &&
+      (to == P::kView || to == P::kOffscreen || to == P::kDropped) && !told) {
+    return {.held_back = true};
+  }
+  // 2, 3.
+  if (was_listed && to == P::kGone) {
+    return {K::kRemoved, "gone"};
+  }
+  if (was_listed && to == P::kUnlisted) {
+    return {K::kRemoved, "hidden"};
+  }
+  // 4.
+  if ((shown == P::kView || shown == P::kOffscreen) &&
+      (to == P::kCovered || to == P::kBehind)) {
+    return {K::kRemoved, "covered"};
+  }
+  // 5.
+  if ((shown == P::kView || shown == P::kCovered) &&
+      (to == P::kOffscreen || to == P::kDropped)) {
+    return {K::kRemoved, "out_of_view"};
+  }
+  // 5b. browser: listed off-screen, then left out there (under
+  // summary, once it says nothing): on the page, no longer listed.
+  if (shown == P::kOffscreen && to == P::kDropped) {
+    return {K::kRemoved, "hidden"};
+  }
+  // 6.
+  if ((from == P::kBehind && (to == P::kView || to == P::kOffscreen)) ||
+      (from == P::kCovered && to == P::kView)) {
+    return {K::kAdded, "uncovered"};
+  }
+  // 7. browser: what was minted since the document's first listing and
+  // left out off-screen until now is appended content, not content the agent
+  // scrolled to; its own why, so it is never paired as a re-made one.
+  if ((from == P::kOffscreen || from == P::kDropped) && to == P::kView) {
+    return {K::kAdded, appended ? "appended" : "into_view"};
+  }
+  // 7b. browser: left out off-screen, and now listed covered: never
+  // listed, so not `shown`.
+  if (from == P::kDropped && to == P::kCovered) {
+    return {K::kAdded, appended ? "appended" : "into_view"};
+  }
+  // 7c. browser: left out off-screen, and now listed off-screen (it
+  // was given a name, or became a control): appended when minted since the
+  // document's first listing; else new when no listing showed it before,
+  // shown when one did.
+  if (from == P::kDropped && to == P::kOffscreen) {
+    return {K::kAdded, appended ? "appended" : listed_first ? "new" : "shown"};
+  }
+  // 8. Unknown, unlisted and gone (none of which a listing stores).
+  if ((!from || from == P::kUnlisted || from == P::kGone) && IsListed(to)) {
+    return {K::kAdded, minted_after ? "new" : "shown"};
+  }
+  // 9.
+  return {};
+}
+
+// The ids of `pairs` (baseline index, id), in current order, that lie outside
+// the longest run whose baseline indices increase: the fewest that moved.
+std::vector<int> NotInLongestRun(
+    const std::vector<std::pair<int, int>>& pairs) {
+  constexpr size_t kNone = std::numeric_limits<size_t>::max();
+  // tails[k]: the pair ending the lowest-ending run of length k + 1.
+  std::vector<size_t> tails;
+  std::vector<size_t> prev(pairs.size(), kNone);
+  for (size_t i = 0; i < pairs.size(); ++i) {
+    auto it = std::lower_bound(
+        tails.begin(), tails.end(), pairs[i].first,
+        [&](size_t tail, int index) { return pairs[tail].first < index; });
+    if (it != tails.begin()) {
+      prev[i] = *(it - 1);
+    }
+    if (it == tails.end()) {
+      tails.push_back(i);
+    } else {
+      *it = i;
+    }
+  }
+  std::vector<bool> in_run(pairs.size(), false);
+  for (size_t i = tails.empty() ? kNone : tails.back(); i != kNone;
+       i = prev[i]) {
+    in_run[i] = true;
+  }
+  std::vector<int> moved;
+  for (size_t i = 0; i < pairs.size(); ++i) {
+    if (!in_run[i]) {
+      moved.push_back(pairs[i].second);
+    }
+  }
+  return moved;
+}
+
+}  // namespace
+
+const char* AgentPlaceName(AgentPlace place) {
+  switch (place) {
+    case AgentPlace::kView:
+      return "view";
+    case AgentPlace::kOffscreen:
+      return "offscreen";
+    case AgentPlace::kDropped:
+      return "dropped";
+    case AgentPlace::kCovered:
+      return "covered";
+    case AgentPlace::kBehind:
+      return "behind";
+    case AgentPlace::kUnlisted:
+      return "unlisted";
+    case AgentPlace::kGone:
+      return "gone";
+    case AgentPlace::kScroller:
+      return "scroller";
+  }
+  NOTREACHED();
+}
+
+bool AgentNodeKey::operator<(const AgentNodeKey& other) const {
+  if (local_root != other.local_root) {
+    return local_root < other.local_root;
+  }
+  return dom_node_id < other.dom_node_id;
+}
+
+AgentNodeKey AgentKey(const GlobalRenderFrameHostId& local_root,
+                      int32_t dom_node_id) {
+  AgentNodeKey key;
+  key.local_root = local_root;
+  key.dom_node_id = dom_node_id;
+  return key;
+}
+
+DOCUMENT_USER_DATA_KEY_IMPL(AgentIdSpace);
+
+AgentIdSpace::AgentIdSpace(RenderFrameHost* rfh)
+    : DocumentUserData(rfh),
+      document_token_(TokenOf(*rfh)),
+      document_id_(NextDocumentId()) {}
+
+AgentIdSpace::~AgentIdSpace() = default;
+
+// static
+AgentIdSpace* AgentIdSpace::Get(RenderFrameHost* rfh) {
+  AgentIdSpace* space = GetForCurrentDocument(rfh);
+  // A crashed frame's next document can commit before the data is reset
+  // (spec section 1d): a space recorded for another document is not this
+  // one's.
+  if (space && space->document_token_ != TokenOf(*rfh)) {
+    DeleteForCurrentDocument(rfh);
+    return nullptr;
+  }
+  return space;
+}
+
+// static
+AgentIdSpace* AgentIdSpace::GetOrCreate(RenderFrameHost* rfh) {
+  if (AgentIdSpace* space = Get(rfh)) {
+    return space;
+  }
+  return GetOrCreateForCurrentDocument(rfh);
+}
+
+const std::string& AgentIdSpace::document_id() const {
+  return document_id_;
+}
+
+std::vector<int32_t> AgentIdSpace::KnownNodeIds(
+    const GlobalRenderFrameHostId& local_root) const {
+  std::vector<int32_t> ids;
+  for (auto it = live_.lower_bound(
+           AgentNodeKey{.local_root = local_root,
+                        .dom_node_id = std::numeric_limits<int32_t>::min()});
+       it != live_.end() && it->first.local_root == local_root; ++it) {
+    ids.push_back(it->first.dom_node_id);
+  }
+  return ids;
+}
+
+AgentCaptureOut AgentIdSpace::Apply(
+    AgentCaptureIn in,
+    const std::vector<GlobalRenderFrameHostId>& live_roots) {
+  const base::flat_set<GlobalRenderFrameHostId> live(live_roots.begin(),
+                                                     live_roots.end());
+  // Roots that gave no answer but still live keep what they had: their
+  // entries' placements, their stored elements and regions (spec section 3c,
+  // partial).
+  std::vector<GlobalRenderFrameHostId> kept_list;
+  for (const GlobalRenderFrameHostId& root : in.unanswered_roots) {
+    if (live.contains(root)) {
+      kept_list.push_back(root);
+    }
+  }
+  const base::flat_set<GlobalRenderFrameHostId> kept(std::move(kept_list));
+
+  AgentCaptureOut out;
+  out.listing_id = NextListingId();
+
+  // Each key's first element in `seen`; a repeat shares its id and has no
+  // record of its own.
+  std::map<AgentNodeKey, size_t> first_seen;
+  for (size_t i = 0; i < in.seen.size(); ++i) {
+    first_seen.emplace(in.seen[i].key, i);
+  }
+
+  // The verdicts. A later one wins. An element left out off-screen (under
+  // none, or under summary when it says nothing) comes in `seen` (kDropped),
+  // which goes before any verdict.
+  std::map<AgentNodeKey, AgentVerdict> verdicts;
+  for (const AgentVerdictIn& verdict : in.verdicts) {
+    verdicts.insert_or_assign(verdict.key, verdict.why);
+  }
+
+  // The placements: mint, then place every live entry.
+  Mint(in, out);
+  std::vector<AgentNodeKey> gone_for_good;
+  std::vector<int> first_listed_list;
+  for (auto& [key, entry] : live_) {
+    if (auto seen = first_seen.find(key); seen != first_seen.end()) {
+      const AgentSeenElement& element = in.seen[seen->second];
+      entry.place = element.place;
+      if (IsListed(element.place) && !entry.listed) {
+        entry.listed = true;
+        first_listed_list.push_back(entry.agent_node_id);
+      }
+      entry.behind.reset();
+      if (element.place == AgentPlace::kBehind) {
+        entry.behind = element.behind_layer;
+      }
+      if (IsListed(element.place)) {
+        // Refreshed at every listing: a re-inserted <iframe> keeps its id
+        // but holds a new frame.
+        entry.child_frame_id = element.child_frame_id;
+        entry.role = element.role;
+        entry.name = element.name;
+      }
+      continue;
+    }
+    if (kept.contains(key.local_root)) {
+      continue;
+    }
+    entry.behind.reset();
+    if (!live.contains(key.local_root)) {
+      entry.place = AgentPlace::kGone;
+      gone_for_good.push_back(key);
+      continue;
+    }
+    auto verdict = verdicts.find(key);
+    if (verdict == verdicts.end()) {
+      // The renderer answers for every known id it does not list; one with
+      // no answer was not listed either.
+      entry.place = AgentPlace::kUnlisted;
+      continue;
+    }
+    switch (verdict->second) {
+      case AgentVerdict::kCollected:
+      case AgentVerdict::kMoved:
+        gone_for_good.push_back(key);
+        entry.place = AgentPlace::kGone;
+        break;
+      case AgentVerdict::kDetached:
+        // Kept: a node still referenced may come back, and reads `shown`.
+        entry.place = AgentPlace::kGone;
+        break;
+      case AgentVerdict::kUnlisted:
+        entry.place = AgentPlace::kUnlisted;
+        break;
+      case AgentVerdict::kOffscreen:
+        // Not sent since the renderers tell offscreen_node_ids; kept for a
+        // renderer that answers kOffscreen still.
+        entry.place = AgentPlace::kDropped;
+        break;
+    }
+  }
+  for (const AgentRegionIn& region : in.regions) {
+    out.region_ids.push_back(RegionIdFor(region.key));
+  }
+
+  // The baseline: one of the stored three, taken the same way. A match uses
+  // it, so it moves to the back; a failed since touches nothing.
+  const Listing* baseline = nullptr;
+  if (in.since) {
+    auto it = std::ranges::find_if(store_, [&](const Listing& listing) {
+      return listing.id == *in.since && listing.scope == in.scope &&
+             listing.offscreen_mode == in.offscreen_mode;
+    });
+    if (it != store_.end()) {
+      std::rotate(it, it + 1, store_.end());
+      baseline = &store_.back();
+    }
+    out.baseline = baseline != nullptr;
+  }
+  // What the roots that gave no answer carry forward: the baseline's, else
+  // the most recently used listing taken the same way.
+  const Listing* source = baseline;
+  for (auto it = store_.rbegin(); !source && it != store_.rend(); ++it) {
+    if (it->scope == in.scope && it->offscreen_mode == in.offscreen_mode) {
+      source = &*it;
+    }
+  }
+
+  std::optional<AgentNodeKey> focus_key = in.focus;
+  int focus_id = 0;
+  if (focus_key) {
+    if (auto it = live_.find(*focus_key); it != live_.end()) {
+      focus_id = it->second.agent_node_id;
+    }
+  } else if (source && source->focus_key &&
+             kept.contains(source->focus_key->local_root)) {
+    // Focus inside a root that gave no answer is as it was.
+    focus_key = source->focus_key;
+    focus_id = source->focus_id;
+  }
+
+  std::vector<AgentNodeKey> held_back_list;
+  if (baseline) {
+    const base::flat_set<int> first_listed(std::move(first_listed_list));
+    out.delta = Diff(*baseline, in, out.agent_node_ids, first_seen, kept,
+                     first_listed, focus_id, held_back_list);
+  }
+  const base::flat_set<AgentNodeKey> held_back(std::move(held_back_list));
+
+  // Store this listing (spec section 2).
+  Listing listing;
+  listing.id = out.listing_id;
+  listing.scope = std::move(in.scope);
+  listing.offscreen_mode = std::move(in.offscreen_mode);
+  listing.url = std::move(in.url);
+  listing.title = std::move(in.title);
+  listing.scroll_x = in.scroll_x;
+  listing.scroll_y = in.scroll_y;
+  listing.scroller = in.scroller;
+  listing.scroller_x = in.scroller_x;
+  listing.scroller_y = in.scroller_y;
+  listing.held_behind_layer = in.held_behind_layer;
+  listing.document_locked = in.document_locked;
+  listing.focus_key = focus_key;
+  listing.focus_id = focus_id;
+  listing.layers = std::move(in.layers);
+  listing.mint_mark = LastAgentNodeId();
+  if (first_mint_mark_ < 0) {
+    first_mint_mark_ = listing.mint_mark;
+  }
+
+  std::vector<std::pair<AgentNodeKey, StoredElement>> elements;
+  for (size_t i = 0; i < in.seen.size(); ++i) {
+    AgentSeenElement& element = in.seen[i];
+    StoredElement stored;
+    stored.agent_node_id = out.agent_node_ids[i];
+    stored.place = element.place;
+    stored.shut_out = element.shut_out;
+    if (IsListed(element.place)) {
+      stored.index = element.listing_index;
+      stored.role = std::move(element.role);
+      stored.name = std::move(element.name);
+      stored.value = std::move(element.value);
+      stored.description = std::move(element.description);
+      stored.href = std::move(element.href);
+      stored.states = ComparedStates(element.states);
+      stored.error = std::move(element.error);
+    } else {
+      stored.behind_layer = std::move(element.behind_layer);
+    }
+    // browser: and a marked element's own mark; one not told keeps the
+    // baseline's when the baseline had it in the same place, for the next
+    // compare.
+    if (element.place == AgentPlace::kCovered ||
+        element.place == AgentPlace::kBehind ||
+        (element.place == AgentPlace::kView && element.marked)) {
+      stored.covered_by = std::move(element.covered_by);
+      stored.cover_told = element.cover_told;
+      if (!element.cover_told && baseline) {
+        if (auto was = baseline->elements.find(element.key);
+            was != baseline->elements.end() &&
+            was->second.place == element.place) {
+          stored.covered_by = was->second.covered_by;
+          stored.cover_told = was->second.cover_told;
+        }
+      }
+    }
+    if (held_back.contains(element.key)) {
+      // Rule 1 held back its move into reach: it stays where the baseline
+      // had it until a capture tells its reach.
+      const StoredElement& was = baseline->elements.find(element.key)->second;
+      stored.listed_as = stored.place;
+      stored.place = was.place;
+      stored.behind_layer = was.behind_layer;
+      stored.covered_by = was.covered_by;
+      stored.cover_told = was.cover_told;
+    }
+    elements.emplace_back(element.key, std::move(stored));
+  }
+  // Dropped by a verdict rather than in `seen` (an older renderer's
+  // kOffscreen); a key already stored above keeps that entry.
+  for (const auto& [key, entry] : live_) {
+    if (entry.place == AgentPlace::kDropped && !kept.contains(key.local_root)) {
+      StoredElement stored;
+      stored.agent_node_id = entry.agent_node_id;
+      stored.place = AgentPlace::kDropped;
+      elements.emplace_back(key, std::move(stored));
+    }
+  }
+  std::vector<std::pair<AgentNodeKey, uint64_t>> region_hashes;
+  for (const AgentRegionIn& region : in.regions) {
+    region_hashes.emplace_back(region.key, region.text_hash);
+  }
+  if (source) {
+    for (const auto& [key, stored] : source->elements) {
+      if (kept.contains(key.local_root)) {
+        StoredElement carried = stored;
+        carried.index = -1;  // not among this reply's elements
+        elements.emplace_back(key, std::move(carried));
+      }
+    }
+    for (const auto& [key, hash] : source->region_hashes) {
+      if (kept.contains(key.local_root)) {
+        region_hashes.emplace_back(key, hash);
+      }
+    }
+  }
+  // Keyed; a repeated key keeps its first element.
+  listing.elements =
+      base::flat_map<AgentNodeKey, StoredElement>(std::move(elements));
+  listing.region_hashes =
+      base::flat_map<AgentNodeKey, uint64_t>(std::move(region_hashes));
+  store_.push_back(std::move(listing));
+  if (store_.size() > kMaxListings) {
+    store_.erase(store_.begin());
+  }
+
+  // Prune what is gone for good, now that the delta has told it.
+  for (const AgentNodeKey& key : gone_for_good) {
+    auto it = live_.find(key);
+    pruned_.push_back({it->second.agent_node_id, std::move(it->second.role),
+                       std::move(it->second.name)});
+    by_id_.erase(it->second.agent_node_id);
+    live_.erase(it);
+  }
+  while (pruned_.size() > kMaxPruned) {
+    pruned_.pop_front();
+  }
+  std::erase_if(regions_, [&](const auto& region) {
+    return !live.contains(region.first.local_root);
+  });
+  Cap();
+  return out;
+}
+
+void AgentIdSpace::Mint(const AgentCaptureIn& in, AgentCaptureOut& out) {
+  // Marked elements first, so a page's first screen reads a1, a2, ... in
+  // listing order, and off-screen elements come after, those left out
+  // off-screen (kDropped) after them, and the main scroller, not listed
+  // (kScroller), last: `seen` holds it last.
+  bool exhausted = false;
+  for (bool marked : {true, false}) {
+    for (const AgentSeenElement& element : in.seen) {
+      if (exhausted) {
+        break;
+      }
+      if ((!IsListed(element.place) && element.place != AgentPlace::kDropped &&
+           element.place != AgentPlace::kScroller) ||
+          element.marked != marked || live_.contains(element.key)) {
+        continue;
+      }
+      const int id = NextId(LastAgentNodeId(), "agentNodeId");
+      if (!id) {
+        exhausted = true;
+        break;
+      }
+      const int label = ++label_count_;
+      if (!ranges_.empty() &&
+          ranges_.back().first_id + ranges_.back().count == id &&
+          ranges_.back().first_label + ranges_.back().count == label) {
+        ++ranges_.back().count;
+      } else {
+        ranges_.push_back({id, label, 1});
+      }
+      AgentIdEntry entry;
+      entry.key = element.key;
+      entry.agent_node_id = id;
+      entry.label = base::StrCat({"a", base::NumberToString(label)});
+      live_.emplace(element.key, std::move(entry));
+      by_id_.emplace(id, element.key);
+    }
+  }
+  out.agent_node_ids.reserve(in.seen.size());
+  out.labels.reserve(in.seen.size());
+  for (const AgentSeenElement& element : in.seen) {
+    auto it = live_.find(element.key);
+    out.agent_node_ids.push_back(it == live_.end() ? 0
+                                                   : it->second.agent_node_id);
+    out.labels.push_back(it == live_.end() ? std::string() : it->second.label);
+  }
+}
+
+AgentDeltaOut AgentIdSpace::Diff(
+    const Listing& baseline,
+    const AgentCaptureIn& in,
+    const std::vector<int>& ids,
+    const std::map<AgentNodeKey, size_t>& first_seen,
+    const base::flat_set<GlobalRenderFrameHostId>& kept_roots,
+    const base::flat_set<int>& first_listed,
+    int focus_id,
+    std::vector<AgentNodeKey>& held_back) const {
+  AgentDeltaOut delta;
+
+  // `was` is set for every removal (rules 2-5 start from a listed element);
+  // `now` when the element is in this capture's `seen`.
+  auto record = [&](const PlaceRecord& r, int id, const StoredElement* was,
+                    const AgentSeenElement* now) {
+    if (r.kind == PlaceRecord::Kind::kAdded) {
+      delta.added.push_back({id, r.why});
+    } else if (r.kind == PlaceRecord::Kind::kRemoved) {
+      AgentDeltaOut::Removed removed;
+      removed.agent_node_id = id;
+      removed.label = LabelOf(id);
+      removed.role = was->role;
+      removed.name = was->name;
+      removed.why = r.why;
+      const AgentPlace shown = was->listed_as.value_or(was->place);
+      removed.was_in_view =
+          shown == AgentPlace::kView || shown == AgentPlace::kCovered;
+      removed.baseline_index = was->index;
+      if (now && now->place == AgentPlace::kBehind) {
+        removed.behind_layer = now->behind_layer_index;
+      }
+      // Behind something that is not an entry of the layers: say what.
+      if (now && (now->place == AgentPlace::kCovered ||
+                  (now->place == AgentPlace::kBehind &&
+                   now->behind_layer_index < 0))) {
+        removed.covered_by = now->covered_by;
+      }
+      delta.removed.push_back(std::move(removed));
+    }
+  };
+
+  // An element listed both times whose own content changed; `kept`: it kept
+  // its place (no record, and not held back).
+  auto changes = [&](int id, const StoredElement& was,
+                     const AgentSeenElement& now, bool kept) {
+    auto text = [&](const char* what, const std::string& from,
+                    const std::string& to) {
+      if (from == to) {
+        return;
+      }
+      AgentDeltaOut::Changed changed;
+      changed.agent_node_id = id;
+      changed.what = what;
+      if (!from.empty()) {
+        changed.from = from;
+      }
+      if (!to.empty()) {
+        changed.to = to;
+      }
+      delta.changed.push_back(std::move(changed));
+    };
+    // browser: across a modal shutting it out, either way, not its
+    // name, description or role -- a shut-out control's name and description
+    // are read from the DOM (the accessibility tree ignores it), so the
+    // switch alone would read as a change -- and its states without
+    // "focusable", which being inert takes away.
+    const bool switched = was.shut_out != now.shut_out;
+    if (!switched) {
+      text("name", was.name, now.name);
+    }
+    text("value", was.value, now.value);
+    std::vector<std::string> states = ComparedStates(now.states);
+    std::vector<std::string> was_states = was.states;
+    if (switched) {
+      std::erase(states, "focusable");
+      std::erase(was_states, "focusable");
+    }
+    if (states != was_states) {
+      AgentDeltaOut::Changed changed;
+      changed.agent_node_id = id;
+      changed.what = "state";
+      changed.from_states = std::move(was_states);
+      changed.to_states = std::move(states);
+      delta.changed.push_back(std::move(changed));
+    }
+    if (!switched) {
+      text("role", was.role, now.role);
+      text("description", was.description, now.description);
+    }
+    text("href", was.href, now.href);
+    // browser: what lies over it, while it kept its place in view or
+    // covered -- a marked element's own mark, a covered one's cover -- as
+    // told. Into or out of view, the record and its listing line say it.
+    if (kept && was.cover_told && now.cover_told &&
+        (now.place == AgentPlace::kView || now.place == AgentPlace::kCovered)) {
+      text("coveredBy", was.covered_by, now.covered_by);
+    }
+    // browser: the page's words for what is wrong, while it stays
+    // invalid; a field turning invalid or valid is the state record's.
+    const auto invalid = [](const std::vector<std::string>& listed) {
+      return std::find(listed.begin(), listed.end(), "invalid") != listed.end();
+    };
+    if (invalid(was.states) && invalid(now.states)) {
+      text("error", was.error, now.error);
+    }
+  };
+
+  // (baseline index, id) of the elements listed both times, in current order.
+  std::vector<std::pair<int, int>> both;
+  for (size_t i = 0; i < in.seen.size(); ++i) {
+    const AgentSeenElement& now = in.seen[i];
+    const int id = ids[i];
+    // No id (minting stopped), or a repeated key: no record.
+    auto first = first_seen.find(now.key);
+    if (!id || first == first_seen.end() || first->second != i) {
+      continue;
+    }
+    auto stored = baseline.elements.find(now.key);
+    const StoredElement* was =
+        stored == baseline.elements.end() ? nullptr : &stored->second;
+    std::optional<AgentPlace> from;
+    std::optional<AgentPlace> shown;
+    if (was) {
+      from = was->place;
+      shown = was->listed_as.value_or(was->place);
+    }
+    // Reach is judged on the side that claims it, now: the browser's test
+    // after kCovered; after kBehind the renderer's tests and the browser's,
+    // which its own two hide rules rest on.
+    bool told = true;
+    if (from == AgentPlace::kCovered) {
+      told = now.hit_answered;
+    } else if (from == AgentPlace::kBehind) {
+      told = now.reach_told && now.hit_answered;
+    }
+    const PlaceRecord r =
+        RecordFor(from, shown, now.place, told, id > baseline.mint_mark,
+                  first_listed.contains(id) && first_mint_mark_ >= 0 &&
+                      id > first_mint_mark_,
+                  first_listed.contains(id));
+    record(r, id, was, &now);
+    if (r.held_back) {
+      held_back.push_back(now.key);
+    }
+    if (shown && IsListed(*shown) && IsListed(now.place)) {
+      // Beside into_view or out_of_view only; the other whys say it all.
+      const std::string_view why = r.why;
+      if (r.kind == PlaceRecord::Kind::kNone || why == "into_view" ||
+          why == "out_of_view") {
+        changes(id, *was, now,
+                r.kind == PlaceRecord::Kind::kNone && !r.held_back);
+      }
+      if (was->index >= 0) {
+        both.emplace_back(was->index, id);
+      }
+    }
+  }
+  for (const auto& [key, was] : baseline.elements) {
+    // Never minted (kBehind only), met above, or in a root that gave no
+    // answer and so keeps its baseline placement: no record.
+    if (!was.agent_node_id || first_seen.contains(key) ||
+        kept_roots.contains(key.local_root)) {
+      continue;
+    }
+    // Out of the live map since the baseline: pruned, so gone.
+    auto entry = live_.find(key);
+    const AgentPlace to =
+        entry == live_.end() ? AgentPlace::kGone : entry->second.place;
+    record(RecordFor(was.place, was.listed_as.value_or(was.place), to, true,
+                     false, false, false),
+           was.agent_node_id, &was, nullptr);
+  }
+  std::ranges::stable_sort(delta.removed, {},
+                           &AgentDeltaOut::Removed::baseline_index);
+  delta.reordered = NotInLongestRun(both);
+
+  if (focus_id != baseline.focus_id) {
+    delta.focus_changed = true;
+    delta.focus_agent_node_id = focus_id;
+    delta.focus_label = LabelOf(focus_id);
+  }
+  if (in.url != baseline.url) {
+    delta.url = in.url;
+  }
+  if (in.title != baseline.title) {
+    delta.title = in.title;
+  }
+  // browser: and when the main scroller is another, or moved, with its
+  // id and label (Mint ran first); and when what holds the page still came
+  // or went: the scroll line says it.
+  if (in.scroll_x != baseline.scroll_x || in.scroll_y != baseline.scroll_y ||
+      in.scroller != baseline.scroller ||
+      in.scroller_x != baseline.scroller_x ||
+      in.scroller_y != baseline.scroller_y ||
+      in.held_behind_layer != baseline.held_behind_layer ||
+      in.document_locked != baseline.document_locked) {
+    AgentDeltaOut::Scroll scroll;
+    scroll.x = in.scroll_x;
+    scroll.y = in.scroll_y;
+    if (in.scroller_named_by) {
+      scroll.agent_node_id = IdOfKey(*in.scroller_named_by);
+      scroll.label = LabelOf(scroll.agent_node_id);
+    }
+    delta.scroll = std::move(scroll);
+  }
+
+  // Layers are matched by frameId:nodeId.
+  auto same_layer = [](const AgentLayerRefData& a, const AgentLayerRefData& b) {
+    return a.frame_id == b.frame_id && a.node_id == b.node_id;
+  };
+  for (size_t i = 0; i < in.layers.size(); ++i) {
+    if (std::ranges::none_of(baseline.layers, [&](const auto& was) {
+          return same_layer(was, in.layers[i]);
+        })) {
+      delta.layers_opened.push_back(base::checked_cast<int>(i));
+    }
+  }
+  for (const AgentLayerRefData& was : baseline.layers) {
+    if (std::ranges::none_of(
+            in.layers, [&](const auto& now) { return same_layer(was, now); })) {
+      delta.layers_closed.push_back(was);
+    }
+  }
+
+  // A region (one key, one region id) whose text is new or changed, and not
+  // empty.
+  for (size_t i = 0; i < in.regions.size(); ++i) {
+    const AgentRegionIn& region = in.regions[i];
+    if (region.text.empty()) {
+      continue;
+    }
+    auto was = baseline.region_hashes.find(region.key);
+    if (was == baseline.region_hashes.end() ||
+        was->second != region.text_hash) {
+      delta.announcements.push_back(base::checked_cast<int>(i));
+    }
+  }
+
+  delta.partial = !in.unanswered_roots.empty();
+  delta.unchanged = delta.added.empty() && delta.removed.empty() &&
+                    delta.changed.empty() && delta.reordered.empty() &&
+                    !delta.focus_changed && !delta.url && !delta.title &&
+                    !delta.scroll && delta.layers_opened.empty() &&
+                    delta.layers_closed.empty() &&
+                    delta.announcements.empty() && !delta.partial;
+  return delta;
+}
+
+void AgentIdSpace::Cap() {
+  if (regions_.size() > kMaxRegions) {
+    std::vector<std::pair<int, AgentNodeKey>> by_age;
+    for (const auto& [key, id] : regions_) {
+      by_age.emplace_back(id, key);
+    }
+    std::ranges::sort(by_age, {}, &std::pair<int, AgentNodeKey>::first);
+    // Oldest region ids first.
+    for (const auto& item : by_age) {
+      if (regions_.size() <= kMaxRegions) {
+        break;
+      }
+      if (std::ranges::none_of(store_, [&](const Listing& listing) {
+            return listing.region_hashes.contains(item.second);
+          })) {
+        regions_.erase(item.second);
+      }
+    }
+  }
+  if (live_.size() <= kMaxLiveEntries) {
+    return;
+  }
+  std::vector<int> held;
+  for (const Listing& listing : store_) {
+    for (const auto& [key, stored] : listing.elements) {
+      if (stored.agent_node_id) {
+        held.push_back(stored.agent_node_id);
+      }
+    }
+  }
+  const base::flat_set<int> in_store(std::move(held));
+  // Oldest ids first. A dropped node that returns gets a new id.
+  std::vector<int> dropped;
+  for (auto it = by_id_.begin();
+       it != by_id_.end() && live_.size() > kMaxLiveEntries;) {
+    if (in_store.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    dropped.push_back(it->first);
+    live_.erase(it->second);
+    it = by_id_.erase(it);
+  }
+  dropped_.insert(dropped.begin(), dropped.end());
+  // The oldest ids out first: one that falls out of the record reads as
+  // gone (Past), as any id the space no longer holds does.
+  if (dropped_.size() > kMaxDropped) {
+    dropped_.erase(dropped_.begin(), dropped_.end() - kMaxDropped);
+  }
+}
+
+const AgentIdEntry* AgentIdSpace::Find(int agent_node_id) const {
+  auto key = by_id_.find(agent_node_id);
+  if (key == by_id_.end()) {
+    return nullptr;
+  }
+  auto entry = live_.find(key->second);
+  return entry == live_.end() ? nullptr : &entry->second;
+}
+
+const AgentIdEntry* AgentIdSpace::FindLabel(std::string_view label) const {
+  const int id = IdOfLabel(LabelNumber(label));
+  return id ? Find(id) : nullptr;
+}
+
+int AgentIdSpace::IdOfKey(const AgentNodeKey& key) const {
+  auto it = live_.find(key);
+  return it == live_.end() ? 0 : it->second.agent_node_id;
+}
+
+const AgentIdEntry* AgentIdSpace::FindChildFrameOwner(
+    std::string_view frame_id) const {
+  if (frame_id.empty()) {
+    return nullptr;
+  }
+  for (const auto& [key, entry] : live_) {
+    if (entry.agent_node_id && entry.place != AgentPlace::kGone &&
+        entry.child_frame_id == frame_id) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+AgentPastAnswer AgentIdSpace::Past(int agent_node_id) const {
+  AgentPastAnswer answer;
+  std::string label = LabelOf(agent_node_id);
+  if (label.empty()) {
+    return answer;  // never minted in this document: elsewhere
+  }
+  answer.agent_node_id = agent_node_id;
+  answer.label = std::move(label);
+  if (dropped_.contains(agent_node_id)) {
+    // Dropped past the cap: no longer tracked, so what became of it is not
+    // known.
+    answer.kind = AgentPastAnswer::Kind::kUnknown;
+    return answer;
+  }
+  // Let go of as gone, or dropped past the cap before the newest
+  // kMaxDropped: the space no longer holds it.
+  answer.kind = AgentPastAnswer::Kind::kGone;
+  for (const Pruned& pruned : pruned_) {
+    if (pruned.agent_node_id == agent_node_id) {
+      answer.role = pruned.role;
+      answer.name = pruned.name;
+      break;
+    }
+  }
+  return answer;
+}
+
+AgentPastAnswer AgentIdSpace::PastLabel(std::string_view label) const {
+  const int id = IdOfLabel(LabelNumber(label));
+  return id ? Past(id) : AgentPastAnswer();
+}
+
+std::vector<AgentIdEntry> AgentIdSpace::LatestListingEntries() const {
+  std::vector<AgentIdEntry> entries;
+  if (store_.empty()) {
+    return entries;
+  }
+  for (const auto& [key, stored] : store_.back().elements) {
+    // Listed, or among the listing's elements though held where the
+    // baseline had it (rule 1).
+    if (!stored.agent_node_id ||
+        !(IsListed(stored.place) || stored.index >= 0)) {
+      continue;
+    }
+    AgentIdEntry entry;
+    entry.key = key;
+    entry.agent_node_id = stored.agent_node_id;
+    entry.label = LabelOf(stored.agent_node_id);
+    entry.role = stored.role;
+    entry.name = stored.name;
+    entry.place = stored.place;
+    if (auto live = live_.find(key); live != live_.end()) {
+      entry.child_frame_id = live->second.child_frame_id;
+    }
+    entries.push_back(std::move(entry));
+  }
+  return entries;
+}
+
+int AgentIdSpace::RegionIdFor(const AgentNodeKey& key) {
+  if (auto it = regions_.find(key); it != regions_.end()) {
+    return it->second;
+  }
+  const int id = NextId(LastRegionId(), "regionId");
+  if (id) {
+    regions_.emplace(key, id);
+  }
+  return id;
+}
+
+std::string AgentIdSpace::LabelOf(int agent_node_id) const {
+  // The last range starting at or below the id.
+  auto it = std::ranges::upper_bound(ranges_, agent_node_id, {},
+                                     &MintRange::first_id);
+  if (agent_node_id <= 0 || it == ranges_.begin()) {
+    return std::string();
+  }
+  --it;
+  const int offset = agent_node_id - it->first_id;
+  if (offset >= it->count) {
+    return std::string();
+  }
+  return base::StrCat({"a", base::NumberToString(it->first_label + offset)});
+}
+
+int AgentIdSpace::IdOfLabel(int label_number) const {
+  auto it = std::ranges::upper_bound(ranges_, label_number, {},
+                                     &MintRange::first_label);
+  if (label_number <= 0 || it == ranges_.begin()) {
+    return 0;
+  }
+  --it;
+  const int offset = label_number - it->first_label;
+  return offset < it->count ? it->first_id + offset : 0;
+}
