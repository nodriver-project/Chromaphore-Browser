+// browser: input that can move what the compositor draws, reaching any
+// of a capture's local roots from the capture's start until its screenshot's
+// holds are released: what L drew may then not be where the frame's record
+// says. The renderer sees only the scrolls the compositor animates.
+class AgentCopyInputWatch : public RenderWidgetHost::InputEventObserver {
+ public:
+  AgentCopyInputWatch() = default;
+  AgentCopyInputWatch(const AgentCopyInputWatch&) = delete;
+  AgentCopyInputWatch& operator=(const AgentCopyInputWatch&) = delete;
+  ~AgentCopyInputWatch() override {
+    for (const base::WeakPtr<RenderWidgetHostImpl>& host : hosts_) {
+      if (host) {
+        host->RemoveInputEventObserver(this);
+      }
+    }
+  }
+
+  void Watch(RenderWidgetHostImpl* host) {
+    if (!host) {
+      return;
+    }
+    for (const base::WeakPtr<RenderWidgetHostImpl>& watched : hosts_) {
+      if (watched.get() == host) {
+        return;
+      }
+    }
+    host->AddInputEventObserver(this);
+    hosts_.push_back(host->GetWeakPtr());
+  }
+  bool moved() const { return moved_; }
+  // A new try starts clean.
+  void Reset() { moved_ = false; }
+
+  // RenderWidgetHost::InputEventObserver:
+  void OnInputEvent(const RenderWidgetHost& host,
+                    const blink::WebInputEvent& event,
+                    InputEventSource source) override {
+    moved_ = moved_ || MovesOnCompositor(event);
+  }
+
+ private:
+  std::vector<base::WeakPtr<RenderWidgetHostImpl>> hosts_;
+  bool moved_ = false;
+};
