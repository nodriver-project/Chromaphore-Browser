+  bool undrawn_ = false;
+  bool lifecycle_pending_ = false;
+  bool rendering_paused_ = false;
+  bool settled_ = false;
+
+  // The waiting call.
+  AwaitCallback callback_;
+  base::TimeTicks await_received_;
+  base::TimeDelta quiet_ = base::Milliseconds(150);
+  base::TimeDelta cap_ = base::Milliseconds(1500);
+
+  // `until`.
+  bool until_text_set_ = false;
+  Vector<UChar> until_needle_;
+  Vector<wtf_size_t> until_fail_;
+  AtomicString until_selector_;
+  // browser: an XPath in place of the selector; what either waits
