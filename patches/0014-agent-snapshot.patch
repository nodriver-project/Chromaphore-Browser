+// whatever became of the frame's own renderer or view; with `if_shown`, empty
+// when the parent last said the page shows none of it. Empty for the page's
+// own frame or one with no parent view; the whole page for a frame embedded
+// as a page of its own (a fenced frame), which has no such rect.
+gfx::RectF FrameRectInRoot(RenderFrameHostImpl& local_root, bool if_shown) {
+  if (local_root.is_main_frame()) {
+    RenderWidgetHostViewBase* page =
+        local_root.GetParentOrOuterDocument()
+            ? local_root.GetOutermostMainFrame()->GetView()
+            : nullptr;
+    return page ? gfx::RectF(gfx::SizeF(page->GetViewBounds().size()))
+                : gfx::RectF();
+  }
+  RenderFrameProxyHost* proxy = local_root.GetProxyToParent();
+  CrossProcessFrameConnector* connector =
+      proxy ? proxy->cross_process_frame_connector() : nullptr;
+  RenderWidgetHostViewBase* parent =
+      connector ? connector->GetParentRenderWidgetHostView() : nullptr;
+  if (!parent || connector->GetRectInParentViewInDip().IsEmpty() ||
+      (if_shown &&
+       connector->GetIntersectionState().viewport_intersection.IsEmpty())) {
+    return gfx::RectF();
+  }
+  gfx::RectF rect(connector->GetRectInParentViewInDip());
+  // The rect is the frame's own size at the corner of the box it is drawn
+  // in: under a scale or a rotation it can cover less than that box, so it
+  // runs on to the parent view's far edges.
+  if (!connector->GetIntersectionState()
+           .main_frame_transform.IsIdentityOr2dTranslation()) {
+    const gfx::SizeF parent_size(parent->GetViewBounds().size());
+    rect.set_width(std::max(rect.width(), parent_size.width() - rect.x()));
+    rect.set_height(std::max(rect.height(), parent_size.height() - rect.y()));
+  }
+  return RootBoxOf(*parent, rect);
+}
