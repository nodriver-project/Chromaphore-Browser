+#define THIRD_PARTY_BLINK_RENDERER_MODULES_AGENT_SNAPSHOT_AGENT_SETTLE_WATCHER_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "base/time/time.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom-blink.h"
