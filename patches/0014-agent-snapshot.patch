+constexpr wtf_size_t kMaxHeard = 8;
+constexpr wtf_size_t kMaxHeardPerRegion = 3;
+// browser: and at most this many in all, the action's and the looks'
+// after it, besides what its Arm carried on, until the next action's Arm.
+constexpr wtf_size_t kMaxHeardKept = 24;
