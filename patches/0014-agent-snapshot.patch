+// browser: Input.dispatchDragPath's carry.
+void AgentSnapshotCollectorImpl::CarryRead(int32_t local_dom_node_id,
+                                           double aim_x,
+                                           double aim_y,
+                                           double x,
+                                           double y,
+                                           int32_t axis,
+                                           CarryReadCallback callback) {
+  std::move(callback).Run(ReadCarry(local_dom_node_id, aim_x, aim_y, x, y, axis,
+                                    /*binder=*/nullptr,
+                                    /*find_wheel=*/true, /*name_veil=*/true));
