diff --git a/third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom b/third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom
new file mode 100644
index 0000000000..34e4632816
--- /dev/null
+++ b/third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom
@@ -0,0 +1,1479 @@
+// Copyright 2026 The browser Authors
