+// browser: Input.selectOptions' reading of a <select> (the mojom says what).
+void AgentSnapshotCollectorImpl::ReadSelect(int32_t local_dom_node_id,
+                                            const Vector<String>& values,
+                                            bool want_route,
+                                            ReadSelectCallback callback) {
+  auto reading = mojom::blink::AgentSelectReading::New();
+  reading->kind = "gone";
+  reading->selected_index = -1;
+  reading->select_box = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  reading->popup_option_box =
+      mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  reading->type_ahead = g_empty_string;
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  auto* select = DynamicTo<HTMLSelectElement>(element);
+  if (!select) {
+    if (element) {
+      reading->kind = "notSelect";
+    }
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  // Same layout update as the capture path; geometry only, no AX cache.
+  element->GetDocument().UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  if (!element->isConnected()) {
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+
+  const bool is_menu_list = select->UsesMenuList();
+  const bool is_picker = is_menu_list && select->PickerIsPopover();
+  reading->kind =
+      !is_menu_list ? "listBox" : (is_picker ? "basePicker" : "menuList");
+  reading->multiple = select->IsMultiple();
+  reading->select_disabled = select->IsDisabledFormControl();
+  LocalFrame* frame = select->GetDocument().GetFrame();
+  Page* page = frame ? frame->GetPage() : nullptr;
+  reading->focused = page && select->GetDocument().FocusedElement() == select &&
+                     page->GetFocusController().FocusedFrame() == frame;
+  reading->selected_index = select->SelectedListIndex();
+  const DisplayJudged display = DisplayJudgedFor(*select);
+
+  const HTMLSelectElement::ListItems& items = select->GetListItems();
+  int option_count = 0;
+  for (wtf_size_t i = 0; i < items.size(); ++i) {
+    auto* option = DynamicTo<HTMLOptionElement>(items[i].Get());
+    if (!option) {
+      continue;
+    }
+    if (reading->options.size() < 25) {
+      String shown = ShownOption(*option);
+      if (option->IsDisabledFormControl()) {
+        shown = shown + " [disabled]";
+      }
+      if (!IsDisplayed(*option, display)) {
+        shown = shown + " [hidden]";
+      }
+      reading->options.push_back(NonNull(shown));
+    }
+    if (option->Selected()) {
+      reading->selected.push_back(
+          ReadOption(option, static_cast<int>(i), display));
+    }
+    ++option_count;
+  }
+  reading->option_count = option_count;
+
+  int wanted = -1;
+  int pickable = 0;
+  for (const String& value : values) {
+    const int index = MatchOption(items, value, OptionUse::kPickable, display);
+    if (index >= 0) {
+      reading->matches.push_back(
+          ReadOption(DynamicTo<HTMLOptionElement>(
+                         items[static_cast<wtf_size_t>(index)].Get()),
+                     index, display));
+      wanted = index;
+      ++pickable;
+      continue;
+    }
+    reading->matches.push_back(ReadOption(nullptr, -1, display));
+    const int any = MatchOption(items, value, OptionUse::kAny, display);
+    auto* named = any >= 0 ? DynamicTo<HTMLOptionElement>(
+                                 items[static_cast<wtf_size_t>(any)].Get())
+                           : nullptr;
+    if (!named) {
+      reading->missing.push_back(NonNull(value));
+    } else if (named->IsDisabledFormControl()) {
+      reading->disabled_matches.push_back(NonNull(value));
+    } else {
+      reading->hidden_matches.push_back(NonNull(value));
+    }
+  }
+
+  // Whether its list shows: a base picker's popover in the page; a native
+  // list once the browser has shown its window, which it refuses in an
+  // inactive window or a hidden tab (the window then closes unshown).
+  if (is_picker) {
+    reading->popup_shown = select->PopupIsVisible();
+  } else if (is_menu_list) {
+    reading->popup_shown =
+        select->PopupIsVisible() && OpenListWindow(*select) != nullptr;
+  }
+  // A dropdown with one value naming a pickable option: where it sits in the
+  // shown list and, when asked, the key route to it.
+  if (is_menu_list && !is_picker && values.size() == 1 && pickable == 1) {
+    if (reading->popup_shown) {
+      ReadListRow(*select, wanted, *reading);
+    }
+    if (want_route) {
+      reading->arrow_steps = ArrowSteps(items, reading->selected_index, wanted);
+      const int home = EdgeKeyStop(items, 1);
+      const int end = EdgeKeyStop(items, -1);
+      reading->steps_from_home =
+          home >= 0 ? ArrowSteps(items, home, wanted) : -1;
+      reading->steps_from_end = end >= 0 ? -ArrowSteps(items, end, wanted) : -1;
+      reading->type_ahead = TypeAheadPrefix(TypeAheadLabels(items),
+                                            reading->selected_index, wanted);
+    }
+  }
+
+  // With a base-select's picker open, the picker's box, where its options
+  // show: the caller's check that an option is in its list's view (the
+  // select's own box held none of them).
+  Element* listed = select;
+  if (is_picker && select->PopupIsVisible()) {
+    if (HTMLElement* picker = select->PopoverPickerElement()) {
+      listed = picker;
+    }
+  }
+  reading->select_box = LocalRootBox(*listed);
+  std::move(callback).Run(std::move(reading));
+}
+
+// browser: Input.selectOptions' pick in a shown native list (the mojom says
+// what).
+void AgentSnapshotCollectorImpl::PickInList(int32_t local_dom_node_id,
+                                            int32_t index,
+                                            int32_t option_node_id,
+                                            PickInListCallback callback) {
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  auto* select = DynamicTo<HTMLSelectElement>(element);
+  if (!select) {
+    std::move(callback).Run(element ? "notSelect" : "gone");
+    return;
+  }
+  element->GetDocument().UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  if (!element->isConnected()) {
+    std::move(callback).Run("gone");
+    return;
+  }
+  // The option the reading named, still at that index and still pickable:
+  // the page's own code may have changed the list during the dwell.
+  const HTMLSelectElement::ListItems& items = select->GetListItems();
+  auto* option = index >= 0 && static_cast<wtf_size_t>(index) < items.size()
+                     ? DynamicTo<HTMLOptionElement>(
+                           items[static_cast<wtf_size_t>(index)].Get())
+                     : nullptr;
+  if (!option || DOMNodeIds::NodeForId(option_node_id) != option ||
+      !IsPickable(*option, DisplayJudgedFor(*select))) {
+    std::move(callback).Run("changed");
+    return;
+  }
+  String outcome = "closed";
+#if !BUILDFLAG(IS_ANDROID) && !BUILDFLAG(IS_APPLE)
+  // On these platforms the open list is an InternalPopupMenu: a page popup
+  // that input from outside cannot reach. Picking through its own client
+  // runs what a click on the row runs: SelectOptionByPopup, which fires
+  // trusted input and change; the popup closing; then the mouseup and click
+  // Chrome synthesizes on the <select>. Only in a window the browser has
+  // shown: a person cannot pick from one it refused.
+  if (select->UsesMenuList() && !select->PickerIsPopover() &&
+      select->PopupIsVisible() && OpenListWindow(*select)) {
+    if (PopupMenu* popup = select->PopupForTesting()) {
+      PagePopupClient* client = static_cast<InternalPopupMenu*>(popup);
+      client->SetValueAndClosePopup(0, String::Number(index),
+                                    /*is_keyboard_event=*/false);
+      outcome = "picked";
+    }
+  }
+#endif
+  std::move(callback).Run(outcome);
+}
