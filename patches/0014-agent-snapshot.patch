+
+class LayoutBox;
+class LayoutObject;
+class LocalFrame;
+class TextControlElement;
+class WebFrameWidgetImpl;
+
+// browser: one frozen frame of a local root, for a screenshot whose
+// secrets the browser paints out. The browser asks the local root to freeze
+// (FreezeForCopy); this forces one commit, L, and in L's post-lifecycle steps
+// pauses rendering, so L is presented and nothing after it is, then records
+// what L draws of text (every painted text run, where it shows, in which text
+// field), where the text fields and the card fields are, what moves on the
+// compositor, and what it cannot read (a throttled frame that still shows).
+// Once L is presented the record goes back, and the browser copies the frame
+// and releases the hold (AgentFreezeHold.Release), learning whether the pause
+// held. The pause also ends by itself 1 s after the freeze, when the browser
+// drops the hold, and when the document goes away.
+//
+// Never reads a card field's text: a card number or security code field is
+// boxed, and its runs are left out, so its digits never leave the renderer.
+//
+// Its timer and its hold run on a task queue a JavaScript dialog or the
+// debugger pauses; nothing renders then either.
+class AgentFreeze final : public GarbageCollected<AgentFreeze>,
+                          public mojom::blink::AgentFreezeHold,
+                          public LocalFrameView::LifecycleNotificationObserver,
+                          public ExecutionContextLifecycleObserver {
+ public:
+  using FreezeCallback =
+      mojom::blink::AgentSnapshotCollector::FreezeForCopyCallback;
+
+  AgentFreeze(LocalFrame& root,
+              int32_t max_text_chars,
+              mojo::PendingReceiver<mojom::blink::AgentFreezeHold> hold,
+              FreezeCallback callback);
+  AgentFreeze(const AgentFreeze&) = delete;
+  AgentFreeze& operator=(const AgentFreeze&) = delete;
+  ~AgentFreeze() override;
+
+  void Trace(Visitor* visitor) const override;
+
+  // Forces the commit and waits for its main frame; answers at once, not
+  // frozen, when this local root cannot freeze.
+  void Start();
+  // Ends a freeze not answered or not released yet (a newer one replaces
+  // it): rendering goes on, and an answer still owed says not frozen.
+  void End();
+
+  // mojom::blink::AgentFreezeHold:
+  void Release(ReleaseCallback callback) override;
+
+  // LocalFrameView::LifecycleNotificationObserver:
+  void DidFinishPostLifecycleSteps(const LocalFrameView& view) override;
+
+  // ExecutionContextLifecycleObserver:
+  void ContextDestroyed() override;
+  void ContextEnteredBackForwardCache() override;
+
+ private:
+  enum class State { kIdle, kWaitingForFrame, kFrozen, kEnded };
+  // Whether the pause ends because the browser released it.
+  enum class EndedBy { kRelease, kOther };
+
+  WebFrameWidgetImpl* Widget() const;
+  // The presentation of the forced commit.
+  void OnPresented(bool presented);
+  // No main frame in time, or the hold's self-release.
+  void OnTimer(TimerBase*);
+  void OnHoldGone();
+  // The answer, not frozen, and rendering on: once.
+  void Fail(const char* why);
+  void Unpause(EndedBy ended_by);
+  void Answer();
+
+  // The record of L: its text runs, fields, card fields, moving boxes and
+  // unread frames.
+  void Record();
+  void RecordFrame(LocalFrame& frame, int32_t doc);
+  int32_t FieldOf(TextControlElement& control);
+  int32_t MotionOf(const LayoutObject& object);
+  int32_t MotionOfBox(const LayoutObject& object);
+  int32_t Motion(const LayoutObject& above, const LayoutObject& object);
+  int32_t MotionBox(const LayoutBox* container);
+  // A rect in `object`'s local space as L shows it in the local root, clipped
+  // by everything around it and by the viewport, in the local root's frame
+  // (Blink space); empty when none of it shows.
+  gfx::RectF Visible(const LayoutObject& object, gfx::RectF rect) const;
+  // The local root's frame (Blink space) to its widget's DIPs.
+  mojom::blink::AgentElementBoxPtr Dips(const gfx::RectF& rect) const;
+
+  Member<LocalFrame> root_;
+  WeakMember<LocalFrameView> view_;
+  HeapMojoReceiver<mojom::blink::AgentFreezeHold, AgentFreeze> hold_;
+  FreezeCallback callback_;
+  const int32_t max_text_chars_;
+  State state_ = State::kIdle;
+  // The commit number before the forced commit: L is the one after it.
+  int commit_number_ = -1;
+  bool presented_ = false;
+  bool broke_ = false;
+  std::unique_ptr<cc::ScopedPauseRendering> pause_;
+  HeapTaskRunnerTimer<AgentFreeze> timer_;
+
+  // While recording; cleared once the record is made.
+  mojom::blink::AgentFreezeReplyPtr reply_;
+  int64_t text_chars_ = 0;
+  // The compositor was driving a scroll at L, or the visual viewport or the
+  // local root's own view was scrolling by itself: every run may move.
+  bool all_move_ = false;
+  HeapHashMap<Member<TextControlElement>, int32_t> fields_;
+  // browser: per field of the reply, whether any of it shows or something
+  // may move it: then every run of it is sent.
+  Vector<bool> field_shows_;
+  // browser: the text the walk has passed, sent or not, and when it stops
+  // reading text once that is past the cap.
+  int64_t walked_chars_ = 0;
+  base::TimeTicks text_deadline_;
+  HeapHashMap<Member<const LayoutObject>, int32_t> motion_of_;
+  HeapHashMap<Member<const LayoutBox>, int32_t> motion_boxes_;
+  // The local root's viewport among the motion boxes; -1: not yet.
+  int32_t viewport_motion_ = -1;
+};
+
+}  // namespace blink
