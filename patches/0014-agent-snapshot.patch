+// browser: the settle. While script runs (as ResourceInitiatorHelper
+// decides it), the soft-navigation context its task carries -- made for the
+// outermost main frame's trusted pointerup, click, keydown and the like, and
+// carried through promises, timers, XHR events and the rest of task
+// attribution -- gives the interaction's start: the start time of its first
+// event. One read of the continuation-preserved data; nothing runs, nothing
+// changes. Null outside script, or with no context.
+base::TimeTicks FrameFetchContext::InteractionOriginForNewRequest() const {
+  v8::Isolate* isolate = ResourceInitiatorHelper::GetIsolateIfRunningScript();
+  if (!isolate) {
+    return base::TimeTicks();
+  }
+  scheduler::TaskAttributionTracker* tracker =
+      scheduler::TaskAttributionTracker::From(isolate);
+  scheduler::TaskAttributionInfo* task_state =
+      tracker ? tracker->CurrentTaskState() : nullptr;
+  SoftNavigationContext* context =
+      task_state ? task_state->GetSoftNavigationContext() : nullptr;
+  // Task state crosses windows, and a context shut down with its window
+  // (SoftNavigationHeuristics::Shutdown) has no first event left to read.
+  return context && !context->HasBeenShutdown() ? context->TimeOrigin()
+                                                : base::TimeTicks();
+}
