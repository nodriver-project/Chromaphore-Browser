+// The protocol's `layers`, with the counts when given.
+std::unique_ptr<protocol::Array<Page::AgentLayer>> PageLayersReply(
+    const PageLayers& page,
+    const std::vector<LayerFrame>& frames,
+    const std::vector<int>* in_counts,
+    const std::vector<int>* behind_counts) {
+  auto layers = std::make_unique<protocol::Array<Page::AgentLayer>>();
+  for (size_t p = 0; p < page.entries.size(); ++p) {
+    const PageLayers::Entry& entry = page.entries[p];
+    const blink::mojom::AgentLayer& layer =
+        *frames[entry.frame].snapshot->layers[entry.local];
+    std::unique_ptr<Page::AgentLayer> reply =
+        Page::AgentLayer::Create()
+            .SetKind(layer.kind)
+            .SetName(entry.name)
+            .SetHead(entry.head)
+            .SetHow(layer.how)
+            .SetBlocking(layer.blocking)
+            .SetNodeId(layer.root_node_id)
+            .SetFrameId(frames[entry.frame].frame_id)
+            .Build();
+    if (in_counts) {
+      reply->SetElementCount((*in_counts)[p]);
+    }
+    if (behind_counts) {
+      reply->SetBehindCount((*behind_counts)[p]);
+    }
+    // Opening or closing.
+    if (layer.animating_ms > 0) {
+      reply->SetAnimatingMs(layer.animating_ms);
+    }
+    layers->emplace_back(std::move(reply));
+  }
+  return layers;
+}
