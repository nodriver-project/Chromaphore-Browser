+      NodeStates(GetSupplementable()->GetFrame(), node_ids));
+}
+
+// browser: the frozen frame of Page.captureAgentSnapshot's screenshot
+// (AgentFreeze). One at a time: a newer freeze ends the one before.
+void AgentSnapshotCollectorImpl::FreezeForCopy(
+    int32_t max_text_chars,
+    mojo::PendingReceiver<mojom::blink::AgentFreezeHold> hold,
+    FreezeForCopyCallback callback) {
+  if (freeze_) {
+    freeze_->End();
+    freeze_ = nullptr;
+  }
+  // A hold the browser has already dropped (its try given up while this
+  // renderer was busy or frozen) asks for nothing: no pause until its close
+  // is read.
+  mojo::ScopedMessagePipeHandle pipe = hold.PassPipe();
+  const bool dropped =
+      !pipe.is_valid() || pipe->QuerySignalsState().peer_closed();
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  if (dropped || !root || !root->IsLocalRoot()) {
+    auto reply = mojom::blink::AgentFreezeReply::New();
+    reply->frozen = false;
+    reply->why_not = dropped ? "the capture gave up this freeze"
+                     : root  ? "not a local root's document"
+                             : "the frame is gone";
+    std::move(callback).Run(std::move(reply));
+    return;
+  }
+  freeze_ = MakeGarbageCollected<AgentFreeze>(
+      *root, max_text_chars,
+      mojo::PendingReceiver<mojom::blink::AgentFreezeHold>(std::move(pipe)),
+      std::move(callback));
+  freeze_->Start();
+}
+
+// browser: Page.agentAnnouncements' renderer half: the live regions of this
+// local root's same-process documents, and what they said since the last
+// arm. Forces nothing: when a readable frame waits for style or layout, it
+// waits for the page's own lifecycle, at most 100 ms.
+void AgentSnapshotCollectorImpl::LiveRegions(LiveRegionsCallback callback) {
+  PollLiveRegions(base::TimeTicks::Now() + kRegionsWait, std::move(callback));
+}
+
+void AgentSnapshotCollectorImpl::PollLiveRegions(base::TimeTicks deadline,
+                                                 LiveRegionsCallback callback) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  if (!root) {
+    const Vector<mojom::blink::AgentRegionReadPtr> none;
+    std::move(callback).Run(Vector<mojom::blink::AgentRegionReadPtr>(),
+                            HeardReads(settle_watcher_.Get(), none));
+    return;
+  }
+  // The readable documents (not a throttled frame's, nor any of a local root
+  // the page does not draw), the stamp the answer is cached under, and
+  // whether any waits for a lifecycle.
+  const bool undrawn = RootUndrawn(*root);
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(root, frames);
+  HeapVector<Member<Document>> documents;
+  Vector<uint64_t> stamp;
+  bool dirty = false;
+  for (LocalFrame* frame : frames) {
+    Document* document = frame->GetDocument();
+    LocalFrameView* view = frame->View();
+    if (undrawn || !document || !view || !document->IsActive() ||
+        view->CanThrottleRendering()) {
+      continue;
+    }
+    documents.push_back(document);
+    stamp.push_back(document->DomTreeVersion());
+    stamp.push_back(document->StyleVersion());
+    dirty = dirty || RegionStyleDirty(*document) || view->NeedsLayout();
+  }
+  // A toast inserted since the last frame has no box yet: the page's next
+  // lifecycle gives it one. Never forced; a page that draws no frames is read
+  // as it stands at the deadline.
+  if (dirty && base::TimeTicks::Now() < deadline) {
+    GetSupplementable()
+        ->GetTaskRunner(TaskType::kInternalUserInteraction)
+        ->PostDelayedTask(
+            FROM_HERE,
+            blink::BindOnce(&AgentSnapshotCollectorImpl::PollLiveRegions,
+                            WrapWeakPersistent(this), deadline,
+                            std::move(callback)),
+            kRegionsLook);
+    return;
+  }
+  Vector<mojom::blink::AgentRegionReadPtr> regions;
+  if (!dirty && live_regions_cached_ && stamp == live_regions_stamp_) {
+    for (const mojom::blink::AgentRegionReadPtr& region : live_regions_cache_) {
+      regions.push_back(region.Clone());
+    }
+  } else {
+    // An assertion: nothing below runs script.
+    ScriptForbiddenScope forbid_script;
+    HeapVector<Member<Element>> roots;
+    int budget = kRegionsNodeBudget;
+    for (Document* document : documents) {
+      agent_live_regions::ForEachRegionRoot(
+          *document, budget,
+          [&roots](Element& element) { roots.push_back(&element); });
+    }
+    regions =
+        ReadRegions(*root, roots, /*skip_locked=*/false, settle_watcher_.Get());
+    // Never kept from a read made while anything was dirty.
+    live_regions_cached_ = !dirty;
+    live_regions_cache_.clear();
+    if (!dirty) {
+      live_regions_stamp_ = std::move(stamp);
+      for (const mojom::blink::AgentRegionReadPtr& region : regions) {
+        live_regions_cache_.push_back(region.Clone());
+      }
+    }
+  }
+  Vector<mojom::blink::AgentHeardReadPtr> heard =
+      HeardReads(settle_watcher_.Get(), regions);
+  CapRegions(regions);
+  std::move(callback).Run(std::move(regions), std::move(heard));
+}
+
+// browser: the report of the arm `arm_id`, unread when this renderer's
+// latest arm is another: that action is over, and what is here now is the
+// next one's.
+void AgentSnapshotCollectorImpl::ReportNow(
+    int64_t arm_id,
+    mojom::blink::AgentReportOptionsPtr options,
+    ReportNowCallback callback) {
+  if (!settle_watcher_ || settle_watcher_->arm_id() != arm_id) {
+    auto report = mojom::blink::AgentFrameReport::New();
+    report->superseded = true;
+    std::move(callback).Run(std::move(report));
+    return;
+  }
+  ReadReport(arm_id, std::move(options), std::move(callback));
+}
+
+// browser: LiveRegions' read (its lifecycle wait, cache and closing
+// pass), then, when asked, the layer stack as a layers_only capture reads it.
+void AgentSnapshotCollectorImpl::ReadReport(
+    int64_t arm_id,
+    mojom::blink::AgentReportOptionsPtr options,
+    ReportNowCallback callback) {
+  // browser: the action's span stays open while this read is in
+  // flight; read again after a closing layer's animation, it reopens.
+  if (settle_watcher_) {
+    settle_watcher_->NoteReportStart(arm_id, options && options->reread);
+  }
+  PollLiveRegions(base::TimeTicks::Now() + kRegionsWait,
+                  blink::BindOnce(&AgentSnapshotCollectorImpl::FinishReport,
+                                  WrapWeakPersistent(this), arm_id,
+                                  std::move(options), std::move(callback)));
+}
+
+void AgentSnapshotCollectorImpl::FinishReport(
+    int64_t arm_id,
+    mojom::blink::AgentReportOptionsPtr options,
+    ReportNowCallback callback,
+    Vector<mojom::blink::AgentRegionReadPtr> regions,
+    Vector<mojom::blink::AgentHeardReadPtr> heard) {
+  auto report = mojom::blink::AgentFrameReport::New();
+  report->regions = std::move(regions);
+  report->heard = std::move(heard);
+  // browser: what the page says from here on, it says by itself.
+  if (settle_watcher_) {
+    settle_watcher_->NoteReportRead(arm_id);
+  }
+  // browser: the census's deadline, from before the layer read it follows.
+  const base::TimeTicks census_by = options && options->controls
+                                        ? base::TimeTicks::Now() + kCensusTime
+                                        : base::TimeTicks();
+  // As a layers_only capture answers; `scan` holds what was found, for a later
+  // pass over the same layers (the census's). A document that cannot be read
+  // gives no stack (the browser keeps what it last held), not an empty one.
+  LayerScan scan;
+  bool scanned = false;
+  if (options && options->layers) {
+    LocalFrame* frame = GetSupplementable()->GetFrame();
+    Document* document = GetSupplementable();
+    if (frame && document->documentElement() && document->View()) {
+      auto layers = mojom::blink::AgentFrameSnapshot::New();
+      ReadLayerStack(*frame, *document, scan, *layers);
+      report->layer_snapshot = std::move(layers);
+      scanned = true;
+    }
+  }
+  // The nodes an action acted on, read as NodesAlive reads them.
+  if (options && !options->node_ids.empty()) {
+    report->nodes =
+        NodeStates(GetSupplementable()->GetFrame(), options->node_ids);
+  }
+  // browser: the control census, each control's layer from the same
+  // scan; with no layer read, every one unplaced.
+  if (options && options->controls) {
+    if (LocalFrame* frame = GetSupplementable()->GetFrame()) {
+      bool cut = false;
+      report->controls =
+          ControlCensus(*frame, scanned ? &scan : nullptr, census_by, cut);
+      report->controls_cut = cut;
+    }
+  }
+  std::move(callback).Run(std::move(report));
+}
+
+// browser: WatchDrag's look right after each frame of the local root.
+void AgentSnapshotCollectorImpl::DidFinishPostLifecycleSteps(
+    const LocalFrameView& view) {
+  if (!watch_active_ || &view != watch_view_.Get()) {
+    return;
+  }
+  SampleWatch();
+  MaybeAnswerWatch(base::TimeTicks::Now());
+}
+
+void AgentSnapshotCollectorImpl::StartWatch(LocalFrameView& view) {
+  watch_view_ = &view;
+  view.RegisterForLifecycleNotifications(this);
+  watch_active_ = true;
+  ++watch_generation_;
+  ScheduleWatchTick();
+}
+
+// A call still waiting is answered, never dropped.
+void AgentSnapshotCollectorImpl::StopWatch() {
+  AnswerWatch();
+  if (LocalFrameView* view = watch_view_.Get()) {
+    view->UnregisterFromLifecycleNotifications(this);
+  }
+  watch_view_ = nullptr;
+  watch_active_ = false;
+  ++watch_generation_;
+}
+
+// One look at the watched set: each box's offsets, the target's and the
+// grabbed element's slots, the layout count. Geometry only: it runs right
+// after a frame's lifecycle, where nothing may be invalidated, and on the
+// timer between frames; no hit test, no layout forced. Any change bumps the
+// version; a box still for three looks after moving has had its scroll end
+// (the stand-in for scrollend).
+void AgentSnapshotCollectorImpl::SampleWatch() {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    return;
+  }
+  const RootDips dips(*view, *widget);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  watch_last_sample_ = now;
+  const bool fresh = !watch_frame_;
+  bool changed = fresh;
+  auto frame = mojom::blink::AgentDragFrame::New();
+  for (wtf_size_t i = 0; i < watch_box_ids_.size(); ++i) {
+    double x = fresh ? 0 : watch_offsets_[2 * i];
+    double y = fresh ? 0 : watch_offsets_[2 * i + 1];
+    WatchedOffsets(root, watch_box_ids_[i], x, y);
+    frame->offsets.push_back(x);
+    frame->offsets.push_back(y);
+    if (fresh) {
+      watch_offsets_.push_back(x);
+      watch_offsets_.push_back(y);
+      watch_still_.push_back(0);
+      watch_moving_.push_back(false);
+    } else if (x != watch_offsets_[2 * i] || y != watch_offsets_[2 * i + 1]) {
+      watch_offsets_[2 * i] = x;
+      watch_offsets_[2 * i + 1] = y;
+      watch_moving_[i] = true;
+      watch_still_[i] = 0;
+      changed = true;
+    } else if (watch_moving_[i] && ++watch_still_[i] >= kStillLooks) {
+      watch_moving_[i] = false;
+      watch_scroll_ended_ = true;
+      changed = true;
+    }
+  }
+  Element* target = OwnedElement(root, watch_target_id_);
+  Element* grab = OwnedElement(root, watch_grab_id_);
+  FollowList(target, watch_target_holder_, watch_target_list_,
+             watch_grab_holder_.Get(), watch_grab_list_);
+  FollowList(grab, watch_grab_holder_, watch_grab_list_,
+             watch_target_holder_.Get(), watch_target_list_);
+  frame->target =
+      WatchedSlot(target, dips, {watch_target_text_, watch_target_list_},
+                  fresh ? nullptr : watch_frame_->target.get());
+  frame->grab = WatchedSlot(grab, dips, {watch_grab_text_, watch_grab_list_},
+                            fresh ? nullptr : watch_frame_->grab.get());
+  if (!fresh && (SlotMoved(*frame->target, *watch_frame_->target) ||
+                 SlotMoved(*frame->grab, *watch_frame_->grab))) {
+    changed = true;
+  }
+  const uint64_t layouts = LayoutSum(*root);
+  if (layouts != watch_layout_count_) {
+    watch_layout_count_ = layouts;
+    ++watch_layout_version_;
+    changed = true;
+  }
+  if (changed) {
+    ++watch_version_;
+  }
+  frame->version = watch_version_;
+  frame->layout_version = watch_layout_version_;
+  frame->scroll_ended = watch_scroll_ended_;
+  frame->time_ms = (now - base::TimeTicks()).InMillisecondsF();
+  watch_frame_ = std::move(frame);
+}
+
+void AgentSnapshotCollectorImpl::MaybeAnswerWatch(base::TimeTicks now) {
+  if (watch_callback_ &&
+      (watch_version_ != watch_since_ || now >= watch_deadline_)) {
+    AnswerWatch();
+  }
+}
+
+// Answers the waiting call with the last frame; a scroll end goes out once.
+void AgentSnapshotCollectorImpl::AnswerWatch() {
+  if (!watch_callback_) {
+    return;
+  }
+  auto frame = watch_frame_ ? watch_frame_.Clone() : EmptyFrame();
+  frame->version = watch_version_;
+  frame->layout_version = watch_layout_version_;
+  frame->scroll_ended = watch_scroll_ended_;
+  watch_scroll_ended_ = false;
+  watch_last_contact_ = base::TimeTicks::Now();
+  std::move(watch_callback_).Run(std::move(frame));
+}
+
+void AgentSnapshotCollectorImpl::ScheduleWatchTick() {
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostDelayedTask(
+          FROM_HERE,
+          blink::BindOnce(&AgentSnapshotCollectorImpl::WatchTick,
+                          WrapWeakPersistent(this), watch_generation_),
+          base::Milliseconds(16));
+}
+
+// The 16 ms timer: a look when no frame has come since the last one, the
+// waiting call's timeout, and the watch's end. HeapMojoReceiverSet does not
+// say when a pipe closes, so the asking is the lease: with no call waiting
+// and none, nor an answer, for 2 s, the drag that watched is over.
+void AgentSnapshotCollectorImpl::WatchTick(uint64_t generation) {
+  if (!watch_active_ || generation != watch_generation_) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  if (!root || !root->View() || root->View() != watch_view_.Get() ||
+      (!watch_callback_ && now - watch_last_contact_ >= base::Seconds(2))) {
+    StopWatch();
+    return;
+  }
+  if (now - watch_last_sample_ >= base::Milliseconds(14)) {
+    SampleWatch();
+  }
+  MaybeAnswerWatch(now);
+  ScheduleWatchTick();
+}
