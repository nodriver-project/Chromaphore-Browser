+// browser: the agent's id space of one document -- the
+// document of a tab's main frame, kept with it in the back/forward cache and
+// ended by a cross-document commit (DocumentUserData).
+//
+// Elements are keyed by (local root, DOMNodeId). An element gets its
+// agentNodeId and its label "a<n>" at its first listing and keeps both for its
+// life in the document, in view or not. agentNodeIds and regionIds come from
+// two browser-wide counters, so no handle is ever reused by another element
+// of any document; labels count per document.
+//
+// Each capture is applied here in one step (Apply): the renderer's verdicts
+// on the ids it did not list, then each element's placement, then the delta
+// against the listing named by `since` (spec sections 3b and 3c), then
+// storing the new listing (the last three are kept, least recently used
+// out), then pruning what is gone for good. So nothing is pruned before a
+// delta has told it.
+//
+// Known limits:
+// - Captures that overlap are applied in the order they finish. An element
+//   minted by the other capture was not among this one's known ids, so if
+//   this one does not list it, it reads kUnlisted here.
+// - A node that moves to another local root and back gets a new id under its
+//   old key. A delta against a listing from before the move may pair the new
+//   id with the old record, so that neither the removal nor the addition is
+//   told.
+//
+// UI thread only.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_AGENT_ID_SPACE_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_AGENT_ID_SPACE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/circular_deque.h"
+#include "base/containers/flat_map.h"
+#include "base/containers/flat_set.h"
+#include "base/time/time.h"
+#include "content/public/browser/document_user_data.h"
+#include "content/public/browser/global_routing_id.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+
+namespace content {
+
+class RenderFrameHost;
+
+namespace protocol {
+
+// Where an element stands at a capture (spec section 3a). kView, kOffscreen
+// and kCovered are listed; the others are not. kDropped ones are minted too,
+// and so are kScroller ones: the page's main scroller when it is an element
+// not listed, minted and labelled after everything listed or dropped. A
+// delta reads kScroller as kUnlisted.
+enum class AgentPlace : uint8_t {
+  kView,
+  kOffscreen,
+  kDropped,
+  kCovered,
+  kBehind,
+  kUnlisted,
+  kGone,
+  kScroller
+};
+const char* AgentPlaceName(AgentPlace place);  // "view", "offscreen", ...
+
+struct AgentNodeKey {
+  GlobalRenderFrameHostId local_root;
+  int32_t dom_node_id = 0;
+  bool operator==(const AgentNodeKey&) const = default;
+  // By local root, then DOMNodeId.
+  bool operator<(const AgentNodeKey& other) const;
+};
+
+// browser: an element's key in the document's id space, from its local
+// root and its DOMNodeId there.
+AgentNodeKey AgentKey(const GlobalRenderFrameHostId& local_root,
+                      int32_t dom_node_id);
+
+struct AgentLayerRefData {
+  std::string kind, name, frame_id;
+  int32_t node_id = 0;
+};
+
+// One element as this capture met it.
+struct AgentSeenElement {
+  AgentNodeKey key;
+  // kView/kOffscreen/kCovered: listed; kBehind: left out behind a layer;
+  // kDropped: left out off-screen (under none, or under summary when it says
+  // nothing; its key alone, or what was read of it); kScroller: the main
+  // scroller, not listed.
+  AgentPlace place = AgentPlace::kView;
+  int listing_index = -1;  // index in the reply's elements; -1: kBehind
+  bool marked = false;
+  bool reach_told = true;    // the renderer's
+  bool hit_answered = true;  // the browser's cross-process test
+  std::string role, name, value, description, href;
+  std::vector<std::string> states;
+  std::string error;  // browser: the page's words for what is wrong
+  std::string child_frame_id;
+  int behind_layer_index = -1;  // kBehind: index into the page's layers
+  std::optional<AgentLayerRefData> behind_layer;
+  std::string covered_by;  // kCovered: the cover, as coveredBy says it;
+                           // browser: kView marked: its mark
+  // browser: covered_by is told -- a cover named, a mark whose hit
+  // tests ran and that a click does not scroll it out from under; one not
+  // told is not compared, and the baseline's is kept.
+  bool cover_told = true;
+  bool shut_out = false;  // browser: AgentElement.shut_out
+};
+
+enum class AgentVerdict : uint8_t {
+  kCollected,
+  kMoved,
+  kDetached,
+  kUnlisted,
+  kOffscreen
+};
+
+struct AgentVerdictIn {
+  AgentNodeKey key;
+  AgentVerdict why;
+};
+
+struct AgentRegionIn {
+  AgentNodeKey key;
+  std::string frame_id, kind;
+  bool assertive = false;
+  uint64_t text_hash = 0;
+  std::string text;
+};
+
+struct AgentCaptureIn {
+  std::string scope;           // "off" | "on" | "all"
+  std::string offscreen_mode;  // "none" | "summary" | "full"
+  std::optional<std::string> since;
+  std::string url, title;
+  int scroll_x = 0, scroll_y = 0;         // rounded CSS pixels
+  std::optional<AgentNodeKey> focus;      // the focused listed element
+  std::vector<AgentLayerRefData> layers;  // the page's stack, bottom to top
+  std::vector<AgentSeenElement> seen;     // listed ones in listing order, then
+                                          // kBehind ones, then kDropped ones
+  std::vector<AgentVerdictIn> verdicts;   // the renderers', on ids not returned
+  std::vector<GlobalRenderFrameHostId> unanswered_roots;  // gave no answer
+  std::vector<AgentRegionIn> regions;
+  // browser: the page's main scroller, none for the page's own window,
+  // whose figures are scroll_x/y: its key (a window's: its document's); the
+  // key its id goes by (an element's own, a frame window's listed frame
+  // element's); and where it is from its start, rounded CSS px of the
+  // scroller. No key: nothing but the page scrolls, if that.
+  std::optional<AgentNodeKey> scroller;
+  std::optional<AgentNodeKey> scroller_named_by;
+  int scroller_x = 0, scroller_y = 0;
+  // browser: the page held still behind a blocking layer with nothing
+  // to scroll (the reply's lockedBehindLayer), and its document scroll
+  // locked (documentLocked) where the page is what scrolls.
+  bool held_behind_layer = false;
+  bool document_locked = false;
+};
+
+struct AgentDeltaOut {
+  struct Added {
+    int agent_node_id = 0;
+    std::string why;
+  };
+  struct Removed {
+    int agent_node_id = 0;
+    std::string label, role, name, why;
+    bool was_in_view = false;
+    // -1: not known (carried from a frame that did not answer).
+    int baseline_index = 0;
+    int behind_layer = -1;   // -1: none
+    std::string covered_by;  // empty: none
+  };
+  struct Changed {
+    int agent_node_id = 0;
+    std::string what;
+    std::optional<std::string> from, to;
+    std::optional<std::vector<std::string>> from_states, to_states;
+  };
+  bool unchanged = true;
+  std::vector<Added> added;
+  std::vector<Removed> removed;
+  std::vector<Changed> changed;
+  std::vector<int> reordered;
+  bool focus_changed = false;
+  int focus_agent_node_id = 0;  // 0: focus left every listed element
+  std::string focus_label;
+  std::optional<std::string> url, title;
+  // The document's scroll, rounded CSS px; browser: and the main
+  // scroller's agentNodeId (0: none, the page's own window among them) and
+  // label. Set when the document's offsets, the main scroller or its place
+  // changed.
+  struct Scroll {
+    int x = 0, y = 0;
+    int agent_node_id = 0;
+    std::string label;
+  };
+  std::optional<Scroll> scroll;
+  std::vector<int> layers_opened;  // indices into AgentCaptureIn.layers
+  std::vector<AgentLayerRefData> layers_closed;
+  std::vector<int> announcements;  // indices into AgentCaptureIn.regions
+  bool partial = false;
+};
+
+struct AgentCaptureOut {
+  std::string listing_id;
+  std::vector<int> agent_node_ids;  // per AgentCaptureIn.seen; 0 for kBehind
+                                    // never minted
+  std::vector<std::string> labels;  // per seen; "" likewise
+  std::vector<int> region_ids;      // per AgentCaptureIn.regions
+  std::optional<bool> baseline;     // set when since was given
+  std::optional<AgentDeltaOut> delta;
+};
+
+struct AgentIdEntry {
+  AgentNodeKey key;
+  int agent_node_id = 0;
+  std::string label, child_frame_id, role, name;
+  AgentPlace place = AgentPlace::kView;     // at the most recent capture
+  std::optional<AgentLayerRefData> behind;  // when place is kBehind
+  bool listed = false;  // browser: some listing of the document showed it
+};
+
+// browser: one layer of the page's stack as last read, for the next
+// action's report to compare with.
+struct AgentLastLayer {
+  std::string kind, name, head, how;
+  bool blocking = false;
+  int node_id = 0;
+  std::string frame_id;
+  int animating_ms = 0;
+};
+
+// browser: the page's stack as last read, and when.
+struct AgentLastLayers {
+  std::vector<AgentLastLayer> layers;
+  base::TimeTicks read_at;
+};
+
+struct AgentPastAnswer {
+  enum class Kind : uint8_t { kElsewhere, kGone, kUnknown };
+  Kind kind = Kind::kElsewhere;
+  int agent_node_id = 0;          // 0 when not known
+  std::string label, role, name;  // empty when not known
+};
+
+class AgentIdSpace : public DocumentUserData<AgentIdSpace> {
+ public:
+  ~AgentIdSpace() override;
+  // GetForCurrentDocument / GetOrCreateForCurrentDocument, plus the spec's
+  // section 1d token check: a space whose recorded DocumentToken differs from
+  // rfh's current one is deleted and (for GetOrCreate) made again.
+  static AgentIdSpace* Get(RenderFrameHost* rfh);
+  static AgentIdSpace* GetOrCreate(RenderFrameHost* rfh);
+
+  const std::string& document_id() const;
+  std::vector<int32_t> KnownNodeIds(
+      const GlobalRenderFrameHostId& local_root) const;
+  // Mints, labels (marked first, in listing order, then the rest), places,
+  // diffs against `since` when it matches, stores (LRU of 3), prunes (spec
+  // section 3d order: verdicts, places, diff, store, prune). Entries of a
+  // local root not in `live_roots` are gone.
+  AgentCaptureOut Apply(AgentCaptureIn in,
+                        const std::vector<GlobalRenderFrameHostId>& live_roots);
+  const AgentIdEntry* Find(int agent_node_id) const;
+  const AgentIdEntry* FindLabel(std::string_view label) const;
+  // browser: the agentNodeId the space holds for a key; 0 when it holds
+  // none (never minted, or let go of).
+  int IdOfKey(const AgentNodeKey& key) const;
+  // browser: the element holding the frame whose DevTools token is
+  // `frame_id` (its <iframe>), as the latest listing that listed it left it;
+  // null when the space holds none (never listed, gone, or let go of).
+  const AgentIdEntry* FindChildFrameOwner(std::string_view frame_id) const;
+  AgentPastAnswer Past(int agent_node_id) const;  // for ids not Find-able
+  AgentPastAnswer PastLabel(std::string_view label) const;
+  // The most recently made listing's entries, for the settle's names.
+  std::vector<AgentIdEntry> LatestListingEntries() const;
+  // Mints on first sight (its own counter, spec section 5a).
+  int RegionIdFor(const AgentNodeKey& key);
+  // browser: the page's layer stack as last read here (a report, a
+  // capture with layers, agentNodesAlive with layers), for the next report to
+  // diff against; absent before one.
+  const std::optional<AgentLastLayers>& last_layers() const {
+    return last_layers_;
+  }
+  void SetLastLayers(AgentLastLayers layers) {
+    last_layers_ = std::move(layers);
+  }
+
+ private:
+  // One element of a stored listing (spec section 2). Listed ones carry what
+  // was listed; kBehind ones their hiding layer; kDropped ones their id alone.
+  // A move back into reach held back by rule 1 keeps its baseline placement
+  // (place, layer and cover) over what was listed, so a later capture that
+  // tells its reach reports it once; `listed_as` keeps where it was listed,
+  // which rules 2 to 5, `changed` and `reordered` read.
+  struct StoredElement {
+    int agent_node_id = 0;  // 0: never minted (kBehind only)
+    AgentPlace place = AgentPlace::kView;
+    int index = -1;  // in the listing's elements; -1: not among them
+    std::string role, name, value, description, href;
+    std::vector<std::string> states;  // without "focused" and "visible"
+    std::string error;                // browser
+    std::optional<AgentLayerRefData> behind_layer;
+    std::string covered_by;
+    bool cover_told = true;               // browser: AgentSeenElement's
+    std::optional<AgentPlace> listed_as;  // set only when held back
+    bool shut_out = false;                // browser: AgentSeenElement's
+  };
+
+  struct Listing {
+    std::string id, scope, offscreen_mode, url, title;
+    int scroll_x = 0, scroll_y = 0;
+    // browser: the main scroller's key and place (AgentCaptureIn).
+    std::optional<AgentNodeKey> scroller;
+    int scroller_x = 0, scroller_y = 0;
+    // browser: what held the page still (AgentCaptureIn).
+    bool held_behind_layer = false;
+    bool document_locked = false;
+    std::optional<AgentNodeKey> focus_key;
+    int focus_id = 0;
+    std::vector<AgentLayerRefData> layers;
+    base::flat_map<AgentNodeKey, uint64_t> region_hashes;
+    base::flat_map<AgentNodeKey, StoredElement> elements;
+    // The last agentNodeId minted browser-wide when it was made: an id above
+    // it is `new` against this listing.
+    int mint_mark = 0;
+  };
+
+  // The ids and labels one capture minted: contiguous in both, in the same
+  // order, so each maps to the other.
+  struct MintRange {
+    int first_id = 0;
+    int first_label = 0;
+    int count = 0;
+  };
+
+  struct Pruned {
+    int agent_node_id = 0;
+    std::string role, name;
+  };
+
+  explicit AgentIdSpace(RenderFrameHost* rfh);
+  friend DocumentUserData<AgentIdSpace>;
+  DOCUMENT_USER_DATA_KEY_DECL();
+
+  // Mints ids for the listed elements of `in.seen` that have none, marked ones
+  // first, and fills `out`'s ids and labels.
+  void Mint(const AgentCaptureIn& in, AgentCaptureOut& out);
+  // Also fills `held_back` with the keys rule 1 held back.
+  // `first_listed`: the ids this capture lists for the first time.
+  AgentDeltaOut Diff(const Listing& baseline,
+                     const AgentCaptureIn& in,
+                     const std::vector<int>& ids,
+                     const std::map<AgentNodeKey, size_t>& first_seen,
+                     const base::flat_set<GlobalRenderFrameHostId>& kept_roots,
+                     const base::flat_set<int>& first_listed,
+                     int focus_id,
+                     std::vector<AgentNodeKey>& held_back) const;
+  // Past the 20 000 cap, drops the oldest entries no stored listing holds,
+  // and records the newest 10 000 ids so dropped; past 2 000 regions, the
+  // oldest regions no stored listing holds (a region that returns gets a
+  // new id).
+  void Cap();
+
+  std::string LabelOf(int agent_node_id) const;
+  int IdOfLabel(int label_number) const;
+
+  const blink::DocumentToken document_token_;
+  const std::string document_id_;
+
+  // The live map, by key and by agentNodeId; only minted elements.
+  std::map<AgentNodeKey, AgentIdEntry> live_;
+  std::map<int, AgentNodeKey> by_id_;
+
+  int label_count_ = 0;
+  std::vector<MintRange> ranges_;
+  std::map<AgentNodeKey, int> regions_;
+
+  // Least recently used first; the last is the most recently made, since
+  // only Apply touches the store and it ends by adding its own listing.
+  std::vector<Listing> store_;
+  // browser: the document's first listing's mint mark; -1 before one.
+  // An id above it was minted since (appended content).
+  int first_mint_mark_ = -1;
+
+  // Ids dropped past the cap, which Past reads as unknown: the newest
+  // 10 000, the oldest out first; one that falls out reads as gone.
+  base::flat_set<int> dropped_;
+  base::circular_deque<Pruned> pruned_;
+  // browser.
+  std::optional<AgentLastLayers> last_layers_;
+};
+
+}  // namespace protocol
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_AGENT_ID_SPACE_H_
