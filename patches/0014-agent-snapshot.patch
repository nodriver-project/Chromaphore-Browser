+// browser: Page.agentNavigateToHistoryEntry's wait. A history step can land
+// in any frame and any process, and a frame's entry is cloned from the page's
+// (its transition says nothing of a frame), so it is the controller's last
+// committed entry that says the step arrived. Only the navigations the step
+// starts (and their restarts) can fail it. Answers once.
+class PageHandler::AgentHistoryWait : public WebContentsObserver {
+ public:
+  AgentHistoryWait(
+      WebContents* contents,
+      NavigationController& controller,
+      int entry_id,
+      base::TimeDelta timeout,
+      std::unique_ptr<AgentNavigateToHistoryEntryCallback> callback)
+      : WebContentsObserver(contents),
+        controller_(&controller),
+        entry_id_(entry_id),
+        callback_(std::move(callback)) {
+    timer_.Start(
+        FROM_HERE, timeout,
+        base::BindOnce(&AgentHistoryWait::OnTimeout, base::Unretained(this)));
+  }
+  AgentHistoryWait(const AgentHistoryWait&) = delete;
+  AgentHistoryWait& operator=(const AgentHistoryWait&) = delete;
+  ~AgentHistoryWait() override = default;
+
+  // Takes the step, following the navigations it starts; one that starts
+  // none (an initial entry, a refusal, a step the page's navigation API
+  // cancels) fails at once.
+  void Start(int index) {
+    started_ = true;
+    // A frame's part cancelled while GoToIndex still starts the others is
+    // judged here, once it returns.
+    in_start_ = true;
+    const NavigationController::WeakNavigationHandleVector handles =
+        controller_->GoToIndex(index);
+    in_start_ = false;
+    for (const base::WeakPtr<NavigationHandle>& handle : handles) {
+      if (handle) {
+        Track(*handle);
+      }
+    }
+    if (tracked_.empty() && !Landed()) {
+      Answer(Page::AgentNavigateToHistoryEntry::OutcomeEnum::Failed);
+    }
+  }
+
+  // A newer step was asked before this one landed.
+  void Replace() {
+    Answer(Page::AgentNavigateToHistoryEntry::OutcomeEnum::Replaced);
+  }
+
+  // Page.disable: the wait ends unanswered by the page.
+  void Drop() {
+    if (!callback_) {
+      return;
+    }
+    timer_.Stop();
+    std::unique_ptr<AgentNavigateToHistoryEntryCallback> callback =
+        std::move(callback_);
+    callback->sendFailure(
+        Response::ServerError("Page.disable came before the step landed"));
+    Observe(nullptr);
+  }
+
+  // WebContentsObserver:
+  void DidStartNavigation(NavigationHandle* handle) override {
+    // A restarted step (same-document redone as cross-document, a cached
+    // page evicted mid-restore) goes on under a new navigation.
+    if (started_ &&
+        NavigationRequest::From(handle)->nav_entry_id() == entry_id_) {
+      Track(*handle);
+    }
+  }
+  void NavigationEntryCommitted(const LoadCommittedDetails& details) override {
+    if (Landed()) {
+      Answer(Page::AgentNavigateToHistoryEntry::OutcomeEnum::Committed);
+    } else if (details.is_main_frame && !Pending()) {
+      // The page went elsewhere; a replaceState or a fragment step meanwhile
+      // keeps the target pending.
+      Answer(Page::AgentNavigateToHistoryEntry::OutcomeEnum::Replaced);
+    }
+  }
+  void DidFinishNavigation(NavigationHandle* handle) override {
+    if (!tracked_.erase(handle->GetNavigationId()) || handle->HasCommitted()) {
+      return;
+    }
+    NavigationRequest* request = NavigationRequest::From(handle);
+    if (in_start_ || request->was_reset_for_cross_document_restart() ||
+        request->IsServedFromBackForwardCache()) {
+      return;
+    }
+    if (tracked_.empty() && !Landed()) {
+      Answer(Page::AgentNavigateToHistoryEntry::OutcomeEnum::Failed);
+    }
+  }
+  void WebContentsDestroyed() override {
+    // The session goes with the page: nothing is left to answer to, and the
+    // controller goes with it.
+    timer_.Stop();
+    callback_.reset();
+    controller_ = nullptr;
+    Observe(nullptr);
+  }
+
+ private:
+  bool Landed() const {
+    NavigationEntry* last =
+        controller_ ? controller_->GetLastCommittedEntry() : nullptr;
+    return last && last->GetUniqueID() == entry_id_;
+  }
+
+  void Track(NavigationHandle& handle) {
+    tracked_.insert(handle.GetNavigationId());
+    requests_.push_back(NavigationRequest::From(&handle)->GetWeakPtr());
+  }
+
+  // A request cancelled before it started (a person staying at a
+  // beforeunload prompt) never finishes: none of the step's left alive means
+  // it failed, not that it ran slow.
+  void OnTimeout() {
+    const bool alive = std::ranges::any_of(
+        requests_, [](const base::WeakPtr<NavigationRequest>& request) {
+          return !!request;
+        });
+    Answer(!alive && !Landed()
+               ? Page::AgentNavigateToHistoryEntry::OutcomeEnum::Failed
+               : Page::AgentNavigateToHistoryEntry::OutcomeEnum::Timeout);
+  }
+
+  // Whether the target is still the step under way.
+  bool Pending() const {
+    NavigationEntry* pending =
+        controller_ ? controller_->GetPendingEntry() : nullptr;
+    return pending && pending->GetUniqueID() == entry_id_;
+  }
+
+  void Answer(const std::string& outcome) {
+    if (!callback_) {
+      return;
+    }
+    timer_.Stop();
+    NavigationEntry* last =
+        controller_ ? controller_->GetLastCommittedEntry() : nullptr;
+    std::unique_ptr<AgentNavigateToHistoryEntryCallback> callback =
+        std::move(callback_);
+    callback->sendSuccess(outcome, last ? last->GetURL().spec() : "");
+    Observe(nullptr);
+  }
+
+  raw_ptr<NavigationController> controller_;
+  const int entry_id_;
+  std::unique_ptr<AgentNavigateToHistoryEntryCallback> callback_;
+  // Set once the step is taken, and while GoToIndex runs; the navigations
+  // the step started, by id, and the requests themselves.
+  bool started_ = false;
+  bool in_start_ = false;
+  base::flat_set<int64_t> tracked_;
+  std::vector<base::WeakPtr<NavigationRequest>> requests_;
+  base::OneShotTimer timer_;
+};
