+
+class SettleJoin : public base::RefCounted<SettleJoin> {
+ public:
+  using Callback = Page::Backend::AgentSettleCallback;
+
+  // An element of the latest listing, for naming a change: its local root
+  // and DOMNodeId there, its label ("a12") and its name.
+  struct Label {
+    GlobalRenderFrameHostId local_root;
+    int32_t node_id = 0;
+    std::string mark;
+    std::string name;
+  };
+
+  struct Params {
+    Params();
+    Params(Params&&);
+    Params& operator=(Params&&);
+    ~Params();
+
+    int arm_id = 0;
+    base::TimeDelta quiet;
+    base::TimeDelta cap;
+    // How long `until` is waited for, from the call.
+    base::TimeDelta timeout;
+    // `until`: any one met meets it.
+    bool has_until = false;
+    std::optional<std::string> text;
+    std::optional<std::string> selector;
+    // browser: an XPath in place of `selector`; what either waits
+    // for; the frame (its DevTools token) whose document alone is checked for
+    // them, every frame when none.
+    std::optional<std::string> xpath;
+    blink::mojom::AgentUntilState state =
+        blink::mojom::AgentUntilState::kVisible;
+    std::optional<std::string> frame_token;
+    // browser: until some frame shows more elements than at the arm.
+    bool appeared = false;
+    // A gone element: its local root and DOMNodeId (0: none); `gone_now`
+    // when that local root has left the page already.
+    GlobalRenderFrameHostId gone_root;
+    int32_t gone_node_id = 0;
+    bool gone_now = false;
+    bool url_changed = false;
+    std::optional<std::string> url_contains;
+    bool new_tab = false;
+    std::vector<Label> labels;
+    // browser: also the per-action report: every wait asks each
+    // renderer for its part, which `assemble_report` makes into the report.
+    bool report = false;
+    // browser: with `report`, each part carries its control census too.
+    bool controls = false;
+    SettleReportAssembler assemble_report;
+    // browser: the page was hidden and came to the front for the settle.
+    bool brought_forward = false;
+  };
+
+  // Reads agentSettle's numbers and `until` into `params` (all but the gone
+  // element's node, which the caller finds in the document's id space); an
+  // error for what is out of range or names nothing.
+  static Response ReadParams(Page::Until* until,
+                             std::optional<int> quiet_ms,
+                             std::optional<int> cap_ms,
+                             std::optional<double> timeout_ms,
+                             Params* params);
+
+  // Runs one agentSettle on `arm` (whose id is params.arm_id) over
+  // `local_roots`, the page's live, active local roots now; `callback` is
+  // answered once, whatever happens to the page, the watch or the session.
+  static void Start(Params params,
+                    SettleArm& arm,
+                    base::WeakPtr<ActionOutcomeWatch> watch,
+                    const std::vector<RenderFrameHostImpl*>& local_roots,
+                    std::unique_ptr<Callback> callback);
+
+  // Posted by SettleArm: a document committed, the URL changed, a tab opened.
+  void OnArmChanged();
+
+ private:
+  friend class base::RefCounted<SettleJoin>;
+
+  enum class Phase {
+    // Waiting for `until`.
+    kUntil,
+    // `until` not met in time: every local root is asked again, with no
+    // `until`, whether the page settled without it; their answers are coming.
+    kTimedOut,
+    // Waiting for the renderers' settle.
+    kSettle,
+    // They answered; a navigation is still pending, until it ends or the cap.
+    kNavigation,
+    kDone,
+  };
+
+  struct Participant {
+    Participant();
+    Participant(Participant&&);
+    Participant& operator=(Participant&&);
+    ~Participant();
+
+    scoped_refptr<SettleRenderer> renderer;
+    base::TimeTicks t;
+    bool committed_after_arm = false;
+    // Armed by this call, from a fresh baseline: a quiet window from now.
+    bool late = false;
+    // The gone element is in this local root.
+    bool owns_gone = false;
+    // Answers to an earlier wait than the one out now are dropped.
+    int generation = 0;
+    // The generation of its last wait with an `until`: a sighting answered
+    // after OnUntilTimeout replaced that wait still counts.
+    int until_generation = -1;
+    bool waiting = false;
+    // Its document left the page, or its pipe closed.
+    bool gone = false;
+    // Answered "not armed" once (its 10 s lease ran out), and armed again.
+    bool rearmed = false;
+    // When the browser stops waiting for it.
+    base::TimeTicks backstop;
+    blink::mojom::AgentSettleReadingPtr reading;
+  };
+
+  SettleJoin(Params params,
+             base::WeakPtr<SettleArm> arm,
+             base::WeakPtr<ActionOutcomeWatch> watch,
+             base::TimeTicks t0,
+             base::TimeTicks first_commit,
+             std::unique_ptr<Callback> callback);
+  ~SettleJoin();
+
+  void Begin(SettleArm& arm,
+             const std::vector<RenderFrameHostImpl*>& local_roots);
+  size_t AddParticipant(scoped_refptr<SettleRenderer> renderer, bool late);
+  bool HasParticipant(const SettleRenderer& renderer) const;
+  // The arm, while it is still this call's.
+  SettleArm* CurrentArm() const;
+
+  // The renderer half of `until` for one local root (null: none there).
+  blink::mojom::AgentUntilPtr UntilFor(const Participant& participant) const;
+  // When the browser's half of `until` (URL, new tab) was met, if it was.
+  std::optional<base::TimeTicks> BrowserUntilAt() const;
+  // The settle ends by then: the cap from T, from the main frame's first
+  // commit since, or from when `until` was met, whichever is latest.
