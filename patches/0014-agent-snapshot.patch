+std::unique_ptr<Page::AgentRedaction> AgentRedactionReply(
+    const std::string& capture_id,
+    const std::vector<AgentRedactionFrame>& frames) {
+  auto frames_reply =
+      std::make_unique<protocol::Array<Page::AgentRedactionFrame>>();
+  for (const AgentRedactionFrame& frame : frames) {
+    auto runs = std::make_unique<protocol::Array<Page::AgentRedactionRun>>();
+    for (size_t r = 0; r < frame.texts.size(); ++r) {
+      runs->emplace_back(Page::AgentRedactionRun::Create()
+                             .SetText(frame.texts[r])
+                             .SetInView(frame.in_view[r])
+                             .Build());
+    }
+    auto fields =
+        std::make_unique<protocol::Array<Page::AgentRedactionField>>();
+    for (const AgentRedactionFrame::Field& field : frame.fields) {
+      fields->emplace_back(Page::AgentRedactionField::Create()
+                               .SetFirstRun(field.first_run)
+                               .SetEndRun(field.end_run)
+                               .Build());
+    }
+    frames_reply->emplace_back(Page::AgentRedactionFrame::Create()
+                                   .SetRuns(std::move(runs))
+                                   .SetFields(std::move(fields))
+                                   .Build());
+  }
+  return Page::AgentRedaction::Create()
+      .SetCaptureId(capture_id)
+      .SetFrames(std::move(frames_reply))
+      .Build();
+}
