+// browser: the loads in flight, for the settle watcher (agent-snapshot).
+void ResourceFetcher::ForEachActiveLoad(
+    base::FunctionRef<void(const Resource&, base::TimeTicks, base::TimeTicks)>
+        fn) const {
+  for (const auto& loader : loaders_) {
+    if (const Resource* resource = loader->GetResource()) {
+      fn(*resource, loader->CreatedTime(), loader->InteractionOrigin());
+    }
+  }
+  for (const auto& loader : non_blocking_loaders_) {
+    if (const Resource* resource = loader->GetResource()) {
+      fn(*resource, loader->CreatedTime(), loader->InteractionOrigin());
+    }
+  }
+}
