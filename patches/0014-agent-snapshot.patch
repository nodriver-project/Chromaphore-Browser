+
+WTF_ALLOW_MOVE_AND_INIT_WITH_MEM_FUNCTIONS(blink::KeptElement)
+WTF_ALLOW_MOVE_AND_INIT_WITH_MEM_FUNCTIONS(blink::Candidate)
+
+namespace blink {
+
+namespace {
+
+// This local root plus every same-process descendant frame, depth first.
+// Remote (OOPIF) frames are separate local roots that the browser drives
+// with their own CollectFrameElements() call, so descending into them here
+// would count their elements twice.
+void CollectSameProcessFrames(LocalFrame* frame,
+                              HeapVector<Member<LocalFrame>>& out) {
+  out.push_back(frame);
+  for (Frame* child = frame->FirstChild(); child;
+       child = child->NextSibling()) {
+    if (auto* local_child = DynamicTo<LocalFrame>(child)) {
+      CollectSameProcessFrames(local_child, out);
+    }
+  }
+}
+
+// browser: whether a box that scrolls what holds `object` shows none of it --
+// scrolled out of a list, not merely past the window's edge.
+bool ScrolledOutOfABox(const LayoutObject& object) {
+  const gfx::RectF rect = object.AbsoluteBoundingBoxRectF();
+  for (const LayoutBox* box = object.ContainingScrollContainer();
+       box && !box->IsLayoutView(); box = box->ContainingScrollContainer()) {
+    const gfx::RectF shown(box->AbsoluteBoundingBoxRect());
+    if (rect.right() <= shown.x() || rect.x() >= shown.right() ||
+        rect.bottom() <= shown.y() || rect.y() >= shown.bottom()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// browser: defined below, beside the text helpers it uses.
+mojom::blink::AgentValidityPtr ReadValidity(Element& element);
+// browser: defined below, beside agentNodesAlive's other reads.
+String ReadsOf(Element& element);
+// browser: defined below, beside PressVerdict's inert reads.
+Element* InertModal(Element& element);
+String ShutOutName(Element& element, const String& role);
+bool ShutOutEditor(Element& element);
+// browser: defined below, beside the reads that use it.
+String SourceText(const Element& source);
+
+// Collects one same-process frame's document in two passes: geometry first,
+// then accessibility under a frozen AX cache. Forcing a layout update while
+// the cache is frozen violates a Blink invariant and crashes the renderer,
+// so every layout-dependent read (viewport size, bounding boxes) happens in
+// the first pass. Boxes are returned in the local root's coordinate space
+// (LocalFrameView::ConvertToRootFrame), so the browser composes all frames
+// of a local root with one view transform.
+void CollectFrameDocumentElements(
+    LocalFrame* frame,
+    mojom::blink::AgentOffscreenMode offscreen_mode,
+    Collected& out) {
+  Document* document = frame->GetDocument();
+  if (!document || !document->documentElement() || !document->View()) {
+    return;
+  }
+  LocalFrameView* view = document->View();
+  document->UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+
+  LocalDOMWindow* window = frame->DomWindow();
+  const double viewport_width = window ? window->innerWidth() : 0;
+  const double viewport_height = window ? window->innerHeight() : 0;
+
+  // Pass 1: geometry. Depth first over this document, descending into open
+  // and closed shadow trees but not into child frames.
+  //
+  // In tree order: each node before its children, and siblings first to last,
+  // because the listing keeps this order (two date fields side by side are
+  // listed From before To). A host's shadow tree still comes before its light
+  // children.
+  //
+  // A form control's user-agent shadow tree is not entered: the control itself
+  // is listed, and its internals would be extra ids (a file input's own
+  // "Choose File" button). Other user-agent trees, such as a video's controls,
+  // are still walked.
+  HeapVector<Candidate> candidates;
+  {
+    HeapVector<Member<Node>> stack;
+    auto push_children = [&stack](ContainerNode& parent) {
+      for (Node* child = parent.lastChild(); child;
+           child = child->previousSibling()) {
+        stack.push_back(child);
+      }
+    };
+    push_children(*document->documentElement());
+    while (!stack.empty()) {
+      Node* child = stack.back();
+      stack.pop_back();
+      if (auto* child_container = DynamicTo<ContainerNode>(child)) {
+        push_children(*child_container);
+      }
+      auto* element = DynamicTo<Element>(child);
+      if (!element) {
+        continue;
+      }
+      if (ShadowRoot* shadow_root = element->GetShadowRoot();
+          shadow_root &&
+          !(shadow_root->IsUserAgent() && element->IsFormControlElement())) {
+        push_children(*shadow_root);
+      }
+      // browser: a live region's root, rendered or not (a display:
+      // contents one has no box); whether it counts is read with its text,
+      // after the listing.
+      if (agent_live_regions::IsRegionRoot(*element)) {
+        out.region_roots.push_back(element);
+      }
+      // Non-rendered elements are not reported.
+      if (!element->GetLayoutObject()) {
+        continue;
+      }
+      DOMRect* rect = element->GetBoundingClientRect();
+      // Identity for the local root's own document; for a same-process
+      // subframe this adds the subframe's in-root offset, which the
+      // browser-side transform drops because such subframes share the
+      // local root's widget view.
+      const gfx::PointF root_top_left =
+          view->ConvertToRootFrame(gfx::PointF(rect->x(), rect->y()));
+      // The viewport test stays per frame: frame-local rect against the
+      // frame's own viewport.
+      Candidate candidate;
+      candidate.element = element;
+      candidate.box = {root_top_left.x(), root_top_left.y(), rect->width(),
+                       rect->height()};
+      candidate.in_frame_viewport =
+          rect->x() < viewport_width && rect->x() + rect->width() > 0 &&
+          rect->y() < viewport_height && rect->y() + rect->height() > 0;
+      // browser: scrolled out of a box that holds it, whatever the window
+      // shows: in every mode, and then not in the window's view either -- a
+      // click on it finds none of it showing. Dropped under none,
+      // listed off-screen under summary and full. Only for what the window
+      // holds, since it walks every box that holds the element.
+      // Read again: GetBoundingClientRect can lay out, and detach it.
+      const LayoutObject* laid_out = element->GetLayoutObject();
+      candidate.clipped_out = candidate.in_frame_viewport && laid_out &&
+                              ScrolledOutOfABox(*laid_out);
+      if (candidate.clipped_out) {
+        candidate.in_frame_viewport = false;
+      }
+      candidates.push_back(candidate);
+    }
+  }
+
+  // Pass 2: accessibility role and name, then classification. Every
+  // Document owns its own AXObjectCache, so accessibility is enabled and the
+  // cache frozen per document. ExistingAXObjectCache() rather than
+  // AXContext::GetAXObjectCache(): the latter has preconditions that are not
+  // met here and can crash the renderer (see InspectorAccessibilityAgent).
+  // Constructing the AXContext is what creates the cache.
+  AXContext ax_context(*document, ui::kAXModeComplete);
+  AXObjectCache* base_cache = document->ExistingAXObjectCache();
+  if (!base_cache) {
+    return;
+  }
+  auto& cache = To<AXObjectCacheImpl>(*base_cache);
+  cache.UpdateAXForAllDocuments();
+  ScopedFreezeAXCache freeze(cache);
+
+  for (const Candidate& candidate : candidates) {
+    Element* element = candidate.element;
+    String role;
+    String name;
+    String description;
+    ax::mojom::blink::NameFrom name_from = ax::mojom::blink::NameFrom::kNone;
+    if (AXObject* ax = cache.Get(element)) {
+      role = AXObject::RoleName(ax->RoleValue());
+      name = ax->ComputedName(&name_from);
+      ax::mojom::blink::DescriptionFrom description_from;
+      AXObject::AXObjectVector description_objects;
+      description =
+          ax->Description(name_from, description_from, &description_objects);
+    }
+    if (role.empty()) {
+      role = element->localName();
+    }
+    // A name of nothing but whitespace is no name, or the pruning that drops
+    // wordless parts would keep an accordion chevron named " ". Whitespace of
+    // every kind, and icon glyphs with it.
+    const bool had_name = !name.ContainsOnlyWhitespaceOrEmpty();
+    name = CleanName(name);
+    if (name.ContainsOnlyWhitespaceOrEmpty()) {
+      name = String();
+    }
+    // A name that was nothing but an icon's glyph: the page usually says what
+    // the icon means in a title, which the accessibility tree made the
+    // description because the glyph had already named it (W3Schools' "Save
+    // code" link). Only then -- an element the tree left unnamed keeps its
+    // title as a description, which is what gives an unnamed table icon its
+    // row.
+    if (had_name && name.empty()) {
+      String fallback =
+          CleanName(element->FastGetAttribute(html_names::kTitleAttr));
+      if (fallback.empty()) {
+        fallback = CleanName(
+            element->FastGetAttribute(html_names::kAriaDescriptionAttr));
+      }
+      if (!fallback.empty()) {
+        name = fallback;
+        if (CleanName(description) == name) {
+          description = String();
+        }
+      }
+    }
+
+    // A rich-text editor is a text field, whatever the tree calls it.
+    const bool editing_host = IsEditingHost(element);
+    if (editing_host && !IsInteractiveRole(role)) {
+      role = "textbox";
+    }
+
+    DragPart drag = ClassifyDrag(element);
+    // A drop listener on the whole page is a framework's delegation, not a
+    // place to let go.
+    if (drag == DragPart::kTarget &&
+        IsPageSized(candidate.box, viewport_width, viewport_height)) {
+      drag = DragPart::kNone;
+    }
+    const InteractiveReason reason = ClassifyInteractive(element, role, drag);
+    const bool interactive = reason != InteractiveReason::kNone;
+    // Non-interactive elements are kept only when they carry semantics and
+    // occupy space. With no area (0 wide or 0 high), only a named one: an
+    // empty paragraph is nothing to read. A progress bar or meter at 0 % (a
+    // fill styled width:0) stays: its value is the news.
+    const bool ranged = role == "progressbar" || role == "meter";
+    if (!interactive &&
+        (IsGenericRole(role) ||
+         (candidate.box.width == 0 && candidate.box.height == 0) ||
+         ((candidate.box.width == 0 || candidate.box.height == 0) &&
+          name.empty() && !ranged))) {
+      continue;
+    }
+    // Nothing that cannot take a pointer event. A visibility:hidden or inert
+    // control is unnamed -- the accessibility tree ignores it -- and no click
+    // reaches it (a closed mega-menu, visibility:hidden, holds dozens of
+    // named links); a click at a pointer-events:none link lands on whatever
+    // lies underneath. Inert is also how showModal() shuts off the page behind
+    // a dialog -- save a control an open modal shuts out, kept to be put
+    // behind it (see below). Form controls stay when only pointer events are
+    // off: a custom checkbox often hides its input that way and is driven
+    // through it.
+    bool behind_modal = false;
+    if (const LayoutObject* layout_object = element->GetLayoutObject()) {
+      const ComputedStyle& style = layout_object->StyleRef();
+      if (style.Visibility() != EVisibility::kVisible) {
+        continue;
+      }
+      // browser: one an open modal dialog or an element shown full
+      // screen shuts out (InertModal) is kept, for the layer pass to put
+      // behind that layer, so an id given before it opened is told as behind
+      // it. Inert is none to pointer events as well.
+      behind_modal = interactive && style.IsInert() && InertModal(*element);
+      if (interactive && style.IsInert() && !behind_modal) {
+        continue;
+      }
+      if (interactive && style.UsedPointerEvents() == EPointerEvents::kNone &&
+          !element->IsFormControlElement() && !behind_modal) {
+        continue;
+      }
+    }
+    if (behind_modal) {
+      // browser: with nothing off screen asked for, one off-screen is
+      // dropped with no id: its id would read off-screen, not behind the
+      // modal. The accessibility tree leaves it unnamed (it ignores what an
+      // active modal dialog shuts out), so named from the DOM.
+      if (offscreen_mode == mojom::blink::AgentOffscreenMode::kNone &&
+          (!candidate.in_frame_viewport || candidate.clipped_out)) {
+        continue;
+      }
+      if (name.empty()) {
+        name = ShutOutName(*element, role);
+      }
+    }
+    // Nor, with nothing off screen asked for, what a box has scrolled out of
+    // sight.
+    if (offscreen_mode == mojom::blink::AgentOffscreenMode::kNone &&
+        (!candidate.in_frame_viewport || candidate.clipped_out)) {
+      // browser: its id made and returned (offscreen_node_ids), so the
+      // browser knows it as left out off-screen (dropped) and it comes into
+      // view as into_view, or as appended when minted since the document's
+      // first listing, not new. This is the walk's last filter; the
+      // passes after the walk may still prune it, and then it reads unlisted
+      // in view, which gives no record.
+      out.offscreen_ids.push_back(
+          static_cast<int32_t>(DOMNodeIds::IdForNode(element)));
+      continue;
+    }
+
+    const bool has_accessible_name = !name.empty();
+    // An editor named by nothing takes its placeholder, as a text field's name
+    // would: Quill and Tiptap both keep theirs in data-placeholder.
+    if (editing_host && name.empty()) {
+      String placeholder = CleanName(
+          element->FastGetAttribute(html_names::kAriaPlaceholderAttr));
+      if (placeholder.empty()) {
+        placeholder =
+            CleanName(element->getAttribute(AtomicString("data-placeholder")));
+      }
+      if (placeholder.empty()) {
+        placeholder =
+            CleanName(element->FastGetAttribute(html_names::kPlaceholderAttr));
+      }
+      if (!placeholder.empty()) {
+        name = placeholder;
+        name_from = ax::mojom::blink::NameFrom::kPlaceholder;
+      }
+    }
+    // A text field named by nothing, or only by its placeholder, takes the
+    // visual label beside it; the placeholder is kept after it, since it is
+    // often the format to type in.
+    if (IsTextEntry(element, role) &&
+        (name.empty() ||
+         name_from == ax::mojom::blink::NameFrom::kPlaceholder)) {
+      if (const String label = GroupLabel(element); !label.empty()) {
+        name = name.empty() ? label : label + " (" + name + ")";
+      }
+    }
+    // browser: one a modal shuts out by its text read as a live
+    // region's is (SourceText leaves a field's and an editor's out by their
+    // attributes): Blink calls nothing inert editable, so TextName would read
+    // an inert editor's typed text. Never a text entry's: what it shows was
+    // typed.
+    if (name.empty() && NamedByText(element, reason, drag)) {
+      if (!behind_modal) {
+        name = TextName(element);
+      } else if (!IsTextEntry(element, role)) {
+        name = Capped(CleanName(SourceText(*element)));
+      }
+    }
+    // The value a typed input takes, where nothing else describes it.
+    if (description.empty()) {
+      if (const TypedInputKind* typed = TypedInputKindOf(element)) {
+        description = typed->format;
+      }
+    }
+    if (name.empty() && description.empty() && HasResizeCursor(element)) {
+      description = "resize handle";
+    }
+    // Still wordless: a guess from its icon, in the description so it never
+    // passes for a name. Not for an editor: what is inside it is the document
+    // being written, not an icon.
+    if (interactive && name.empty() && description.empty() && !editing_host) {
+      description = IconHint(element);
+    }
+    // A field nothing names, told apart by its name or id, said to be one:
+    // two bare textboxes otherwise read identically.
+    if (name.empty() && description.empty() && IsTextEntry(element, role)) {
+      const AtomicString& field_name =
+          element->FastGetAttribute(html_names::kNameAttr);
+      const AtomicString& id = element->GetIdAttribute();
+      if (!field_name.empty()) {
+        description = "name: " + field_name.GetString();
+      } else if (!id.empty()) {
+        description = "id: " + id.GetString();
+      }
+    }
+    // Which row an unnamed action belongs to: three identical "Delete" icons in
+    // a table say nothing about which row each deletes.
+    if (interactive && name.empty() && !description.empty()) {
+      if (const String row = RowLabel(element); !row.empty()) {
+        description = description + " - row: " + row;
+      }
+    }
+    // Said, so an editor is not taken for a plain field: what it holds has
+    // formatting, and its lines are not listed.
+    if (editing_host) {
+      if (description.empty()) {
+        description = "rich text";
+      } else if (description.starts_with("name: ") ||
+                 description.starts_with("id: ")) {
+        description = "rich text, " + description;
+      }
+    }
+
+    auto agent_element = mojom::blink::AgentElement::New();
+    agent_element->backend_node_id =
+        static_cast<int32_t>(DOMNodeIds::IdForNode(element));
+    // Chromium's own names for a table used for layout, which no page calls
+    // them (a <tr onclick> is a "LayoutTableRow"). Only on the way out, so
+    // classification still sees the real role.
+    if (const TypedInputKind* typed = TypedInputKindOf(element)) {
+      agent_element->role = typed->role;
+    } else if (role == "LayoutTable") {
+      agent_element->role = "table";
+    } else if (role == "LayoutTableRow") {
+      agent_element->role = "row";
+    } else if (role == "LayoutTableCell") {
+      agent_element->role = "cell";
+    } else if (role == "LayoutTableColumn") {
+      agent_element->role = "column";
+    } else {
+      agent_element->role = NonNull(role);
+    }
+    agent_element->name = NonNull(name);
+    agent_element->value = NonNull(FormControlValue(element));
+    agent_element->description = NonNull(description);
+    agent_element->tag = NonNull(element->localName());
+    agent_element->interactive = interactive;
+    agent_element->interactive_reason = InteractiveReasonName(reason);
+    agent_element->states = ElementStates(element);
+    // browser: why it is invalid, and the page's words for it.
+    agent_element->validity = ReadValidity(*element);
+    if (agent_element->validity) {
+      agent_element->states.push_back("invalid");
+    }
+    // browser: the id check's reading, as of this listing; empty when it
+    // reads nothing (a bare newline).
+    const String reads = ReadsOf(*element);
+    agent_element->reads =
+        reads.length() == 1 && reads[0] == '\n' ? String("") : reads;
+    // Said even when another signal made the element interactive: a sortable
+    // row that is also a link is still something to drag.
+    if (drag == DragPart::kSource) {
+      agent_element->states.push_back("draggable");
+      // An item of a list reordered with native drag and drop listens for the
+      // drop itself, so it is both: each item is a place to let go, not only
+      // the list.
+      if (AcceptsDrops(element)) {
+        agent_element->states.push_back("drop-target");
+      }
+    } else if (drag == DragPart::kTarget) {
+      agent_element->states.push_back("drop-target");
+    }
+    agent_element->box = mojom::blink::AgentElementBox::New(
+        candidate.box.x, candidate.box.y, candidate.box.width,
+        candidate.box.height);
+    agent_element->in_frame_viewport = candidate.in_frame_viewport;
+    // Resolved against the document base, so the agent gets the URL a click
+    // would navigate to rather than a relative fragment.
+    agent_element->href = NonNull(UrlAttribute(element, html_names::kHrefAttr));
+    agent_element->src = NonNull(UrlAttribute(element, html_names::kSrcAttr));
+    // The frame a frame element holds: a hit in that frame's own view is a
+    // hit on it.
+    if (auto* owner = DynamicTo<HTMLFrameOwnerElement>(element)) {
+      if (Frame* content = owner->ContentFrame()) {
+        agent_element->child_frame_id =
+            String(content->GetDevToolsFrameToken().ToString());
+        // What the frame shows now, not what its src first loaded: here for
+        // a frame in this process, from the browser for one
+        // in another.
+        if (auto* local = DynamicTo<LocalFrame>(content)) {
+          const Document* shown = local->GetDocument();
+          if (shown && shown->Url().ProtocolIsInHttpFamily()) {
+            agent_element->src = shown->Url().GetString();
+          }
+        }
+      }
+    }
+    Element* shadow_host = element->OwnerShadowHost();
+    agent_element->shadow_host_backend_node_id =
+        shadow_host ? static_cast<int32_t>(DOMNodeIds::IdForNode(shadow_host))
+                    : 0;
+
+    out.elements.push_back(std::move(agent_element));
+    KeptElement kept;
+    kept.element = element;
+    kept.box = candidate.box;
+    kept.reason = reason;
+    kept.has_accessible_name = has_accessible_name;
+    out.kept.push_back(kept);
+  }
+}
+
+// Drops the weaker of two coincident nested interactive elements: when an
+// interactive element nearly fills its nearest interactive ancestor, they are
+// the same click target. The stronger interactivity signal wins and a tie
+// keeps the outer element. Nested controls with dissimilar bounds are left
+// alone. Returns one flag per element.
+Vector<bool> CoincidentNestedElements(const HeapVector<KeptElement>& kept) {
+  HeapHashMap<Member<Element>, wtf_size_t> interactive_index;
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    if (kept[i].reason != InteractiveReason::kNone) {
+      interactive_index.insert(kept[i].element, i);
+    }
+  }
+  Vector<bool> removed(kept.size());
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    if (kept[i].reason == InteractiveReason::kNone) {
+      continue;
+    }
+    for (Element* ancestor = AncestorElement(kept[i].element); ancestor;
+         ancestor = AncestorElement(ancestor)) {
+      auto it = interactive_index.find(ancestor);
+      if (it == interactive_index.end()) {
+        continue;
+      }
+      const wtf_size_t j = it->value;
+      const double area_i = kept[i].box.width * kept[i].box.height;
+      const double area_j = kept[j].box.width * kept[j].box.height;
+      if (area_j > 0 && area_i >= 0.75 * area_j) {
+        if (kept[i].reason > kept[j].reason) {
+          removed[j] = true;
+        } else {
+          removed[i] = true;
+        }
+      }
+      break;  // Only the nearest interactive ancestor counts.
+    }
+  }
+  return removed;
+}
+
+bool IsGraphicsRole(const String& role) {
+  static constexpr const char* kRoles[] = {"SvgRoot", "graphics-symbol",
+                                           "graphics-document", "img", "image"};
+  return RoleIn(role, kRoles);
+}
+
+// The index in `kept` of each element listed as interactive that `removed`
+// has not dropped.
+HeapHashMap<Member<Element>, wtf_size_t> ListedIndex(
+    const HeapVector<KeptElement>& kept,
+    const Vector<bool>& removed) {
+  HeapHashMap<Member<Element>, wtf_size_t> listed;
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    if (!removed[i] && kept[i].reason != InteractiveReason::kNone) {
+      listed.insert(kept[i].element, i);
+    }
+  }
+  return listed;
+}
+
+// Drops an unnamed element that only looks interactive -- by cursor, listener
+// or tabindex -- when an element it sits inside is already listed and it has no
+// text of its own. Icons inside links and wrappers inside buttons are the bulk
+// of these: the ancestor is the thing to act on, and listing the parts as well
+// would turn one control into several nameless ids. Elements with their own
+// role, a form control or a part in drag and drop are never dropped here.
+// "Unnamed" means by the accessibility tree: a name taken from the element's
+// text is a label for the listing, not a reason to keep a part, and the text
+// test below already decides whether it has words of its own.
+void DropUnnamedParts(const HeapVector<KeptElement>& kept,
+                      const Vector<mojom::blink::AgentElementPtr>& elements,
+                      Vector<bool>& removed,
+                      double viewport_width,
+                      double viewport_height) {
+  const HeapHashMap<Member<Element>, wtf_size_t> listed =
+      ListedIndex(kept, removed);
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    if (removed[i] || !IsHeuristicReason(kept[i].reason)) {
+      continue;
+    }
+    if (kept[i].has_accessible_name) {
+      continue;
+    }
+    for (Element* ancestor = AncestorElement(kept[i].element); ancestor;
+         ancestor = AncestorElement(ancestor)) {
+      auto it = listed.find(ancestor);
+      if (it == listed.end() || removed[it->value]) {
+        continue;
+      }
+      // The whole page or app is not a control anything is a part of; nothing
+      // smaller was found below it, so this part stands on its own.
+      if (IsPageSized(kept[it->value].box, viewport_width, viewport_height)) {
+        break;
+      }
+      // An icon with a hint, inside something that is only a container -- a
+      // table row with a click handler, not a button or a link -- is an action
+      // of its own, not decoration: a row's edit and delete icons. Inside a
+      // real control the same icon is still just part of it.
+      const bool container = IsHeuristicReason(kept[it->value].reason);
+      if (container && !elements[i]->description.empty()) {
+        break;
+      }
+      // A graphic is a part whatever it says; anything else must be wordless.
+      if (IsGraphicsRole(elements[i]->role) || !HasText(kept[i].element)) {
+        removed[i] = true;
+      }
+      break;  // Only the nearest listed ancestor counts.
+    }
+  }
+}
+
+// Drops the weaker of an element and its nearest listed ancestor when both
+// carry the same name: a sidebar entry's list item, the link in it and the
+// text inside that are one action, not three ids. A real control outranks one
+// listed on a guess; between two guesses the outer stays.
+//
+// Also drops a table cell listed only for its pointer cursor inside a listed
+// row: the cursor is the row's, inherited, and the row is the thing to click.
+// Cells only -- elsewhere a pointer cursor is often all that marks a separate
+// action, since React hangs its click handlers on the root.
+void DropEchoes(const HeapVector<KeptElement>& kept,
+                const Vector<mojom::blink::AgentElementPtr>& elements,
+                Vector<bool>& removed) {
+  const HeapHashMap<Member<Element>, wtf_size_t> listed =
+      ListedIndex(kept, removed);
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    if (removed[i] || kept[i].reason == InteractiveReason::kNone) {
+      continue;
+    }
+    for (Element* ancestor = AncestorElement(kept[i].element); ancestor;
+         ancestor = AncestorElement(ancestor)) {
+      auto it = listed.find(ancestor);
+      if (it == listed.end() || removed[it->value]) {
+        continue;
+      }
+      const wtf_size_t outer = it->value;
+      const String& name = elements[i]->name;
+      if (!name.empty() && name == elements[outer]->name) {
+        if (IsHeuristicReason(kept[i].reason)) {
+          removed[i] = true;
+        } else if (IsHeuristicReason(kept[outer].reason)) {
+          removed[outer] = true;
+        }
+      } else if (kept[i].reason == InteractiveReason::kCursor &&
+                 (elements[i]->role == "cell" ||
+                  elements[i]->role == "gridcell") &&
+                 elements[outer]->role == "row") {
+        removed[i] = true;
+      }
+      break;  // Only the nearest listed ancestor counts.
+    }
+  }
+}
+
+// A native control whose contents are part of it: a click anywhere inside one
+// activates the control, and HTML allows no interactive content within it.
+bool IsNativeContainer(Element* element) {
+  return element->HasTagName(html_names::kButtonTag) ||
+         element->HasTagName(html_names::kSummaryTag) ||
+         element->HasTagName(html_names::kLabelTag) ||
+         (element->HasTagName(html_names::kATag) &&
+          element->FastHasAttribute(html_names::kHrefAttr));
+}
+
+// Drops what is listed only on a guess, or for drag and drop, inside an
+// editor: a contenteditable root or a listed textbox. Its lines and spans are
+// the document being edited, not controls (every line of a CodeMirror
+// editor). Links, buttons and other real controls inside stay.
+//
+// Also drops what is listed only on a guess -- an inherited cursor, a listener,
+// a tabindex -- inside a listed <button>, <summary>, <a href> or <label>. A
+// click on it is a click on the control, such as the shortcut letter inside
+// each of Excalidraw's tool buttons. Only when that control is itself listed,
+// so nothing becomes unreachable.
+void DropPartsOfControls(const HeapVector<KeptElement>& kept,
+                         const Vector<mojom::blink::AgentElementPtr>& elements,
+                         Vector<bool>& removed) {
+  const HeapHashMap<Member<Element>, wtf_size_t> listed =
+      ListedIndex(kept, removed);
+  for (wtf_size_t i = 0; i < kept.size(); ++i) {
+    const bool heuristic = IsHeuristicReason(kept[i].reason);
+    if (removed[i] ||
+        (!heuristic && kept[i].reason != InteractiveReason::kDrag)) {
+      continue;
+    }
+    for (Element* ancestor = AncestorElement(kept[i].element); ancestor;
+         ancestor = AncestorElement(ancestor)) {
+      auto it = listed.find(ancestor);
+      const bool ancestor_listed = it != listed.end() && !removed[it->value];
+      // browser: an editor a modal shuts out is one too, by its
+      // attribute (ShutOutEditor).
+      if (IsEditingHost(ancestor) || ShutOutEditor(*ancestor) ||
+          (ancestor_listed && elements[it->value]->role == "textbox")) {
+        removed[i] = true;
+        break;
+      }
+      if (heuristic && IsNativeContainer(ancestor)) {
+        if (ancestor_listed) {
+          removed[i] = true;
+        }
+        break;
+      }
+    }
+  }
+}
+
+// The element a process-local DOMNodeId names, if it is still in a document
+// under `root`, the local root this collector serves. DOMNodeIds are
+// process-wide, so without this an id could reach a node in another tab that
+// shares the renderer, or in a page kept in the back/forward cache.
+Element* OwnedElement(LocalFrame* root, int32_t local_dom_node_id) {
+  auto* element = DynamicTo<Element>(DOMNodeIds::NodeForId(local_dom_node_id));
+  if (!root || !element || !element->isConnected()) {
+    return nullptr;
+  }
+  LocalFrame* frame = element->GetDocument().GetFrame();
+  if (!frame || &frame->LocalFrameRoot() != root) {
+    return nullptr;
+  }
+  return element;
+}
+
+// browser: live regions: at most this many on the wire a reply, the first in
+// walk order, and at most four times as many read (this collector's own
+// bounds: heard is told against every region read, so well past those sent);
+// LiveRegions' node budget across this local root's documents, and its wait
+// for a pending lifecycle.
+constexpr wtf_size_t kMaxRegions = 64;
+constexpr wtf_size_t kMaxRegionsRead = 4 * kMaxRegions;
+constexpr int kRegionsNodeBudget = 50000;
+constexpr base::TimeDelta kRegionsWait = base::Milliseconds(100);
+constexpr base::TimeDelta kRegionsLook = base::Milliseconds(16);
+
+// browser: whether the page does not draw `root`: a frame in another
+// process whose frame element is not rendered has its widget hidden, and no
+// lifecycle ever runs in it (the settle watcher's Undrawn). Never the page's
+// main frame.
+bool RootUndrawn(LocalFrame& root) {
+  if (root.IsOutermostMainFrame()) {
+    return false;
+  }
+  const auto* widget =
+      static_cast<WebFrameWidgetImpl*>(root.GetWidgetForLocalRoot());
+  return widget && widget->IsHidden();
+}
+
+// browser: style of `document` waiting for a lifecycle, as the settle
+// watcher's StyleDirty reads it (without the animation timing, which is true
+// between frames whenever an animation runs).
+bool RegionStyleDirty(const Document& document) {
+  const StyleEngine& engine = document.GetStyleEngine();
+  return engine.NeedsFullStyleUpdate() || engine.NeedsStyleRecalc() ||
+         engine.NeedsStyleInvalidation() || document.NeedsStyleInvalidation() ||
+         document.IsSlotAssignmentDirty();
+}
+
+// browser: the live region `root` as the wire carries it, when it counts
+// now and says something; null otherwise.
+mojom::blink::AgentRegionReadPtr RegionRead(Element& root) {
+  if (!agent_live_regions::RegionCounts(root)) {
+    return nullptr;
+  }
+  String kind;
+  bool assertive = false;
+  agent_live_regions::DescribeRegion(root, kind, assertive);
+  uint64_t hash = 0;
+  String text;
+  agent_live_regions::ReadRegionText(root, kind == "log", hash, &text);
+  if (text.empty()) {
+    return nullptr;
+  }
+  return mojom::blink::AgentRegionRead::New(
+      static_cast<int32_t>(DOMNodeIds::IdForNode(&root)), kind, assertive, hash,
+      text);
+}
+
+// browser: the regions of `roots` that count and say something, skipping
+// those of a throttled frame, and all of them when the page does not draw
+// `root`; the first kMaxRegionsRead in walk order. `skip_locked`:
+// also those in a locked display lock's subtree (content-visibility), which
+// LiveRegions' walk never meets; asked only after the capture's forced
+// layout, since the lock test walks the flat tree. browser: `closing`:
+// the settle watcher each root read goes to (NoteRead), before the read's
+// heard is taken.
+Vector<mojom::blink::AgentRegionReadPtr> ReadRegions(
+    LocalFrame& root,
+    const HeapVector<Member<Element>>& roots,
+    bool skip_locked,
+    AgentSettleWatcher* closing = nullptr) {
+  Vector<mojom::blink::AgentRegionReadPtr> regions;
+  if (RootUndrawn(root)) {
+    return regions;
+  }
+  for (const Member<Element>& member : roots) {
+    if (regions.size() >= kMaxRegionsRead) {
+      break;
+    }
+    Element& element = *member;
+    const LocalFrameView* view = element.GetDocument().View();
+    if (!element.isConnected() || !view || view->CanThrottleRendering() ||
+        (skip_locked &&
+         DisplayLockUtilities::LockedInclusiveAncestorPreventingPaint(
+             element))) {
+      continue;
+    }
+    if (closing) {
+      closing->NoteRead(element);
+    }
+    if (mojom::blink::AgentRegionReadPtr region = RegionRead(element)) {
+      regions.push_back(std::move(region));
+    }
+  }
+  return regions;
+}
+
+// browser: what the regions said since the last arm, as the settle
+// watcher heard it, each gone when no region of `regions` -- every
+// one this call read (up to kMaxRegionsRead), before kMaxRegions trims the
+// reply's -- says that text (its text_hash), under any node: a page that
+// renders its region anew under a new node still shows it. Each under the
+// arm it was heard under, so one carried on keeps its key. browser:
+// each with how long before now it was heard. browser: and the
+// document that heard it, which the key carries.
+Vector<mojom::blink::AgentHeardReadPtr> HeardReads(
+    const AgentSettleWatcher* watcher,
+    const Vector<mojom::blink::AgentRegionReadPtr>& regions) {
+  Vector<mojom::blink::AgentHeardReadPtr> heard;
+  if (!watcher) {
+    return heard;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const Document* source = watcher->document();
+  const String document =
+      source ? String(source->Token().ToString()) : String("");
+  for (const AgentSettleWatcher::HeardEntry& entry : watcher->heard()) {
+    bool shown = false;
+    for (const mojom::blink::AgentRegionReadPtr& region : regions) {
+      if (region->text_hash == entry.text_hash) {
+        shown = true;
+        break;
+      }
+    }
+    heard.push_back(mojom::blink::AgentHeardRead::New(
+        entry.arm_id, entry.index,
+        mojom::blink::AgentRegionRead::New(entry.node_id, NonNull(entry.kind),
+                                           entry.assertive, entry.text_hash,
+                                           NonNull(entry.text)),
+        !shown, entry.before_action, entry.unwatched, entry.own,
+        static_cast<int32_t>(
+            std::clamp<int64_t>((now - entry.heard_at).InMilliseconds(), 0,
+                                std::numeric_limits<int32_t>::max())),
+        entry.changes, entry.replaced, document,
+        // browser.
+        entry.added.IsNull()
+            ? String()
+            : agent_live_regions::ShownStart(entry.added.StripWhiteSpace())));
+  }
+  return heard;
+}
+
+// browser: a checkbox's, switch's or radio's checked state as the page
+// holds it -- "true", "false" or "mixed" for a checkbox or radio <input>, else
+// its aria-checked as written; null when it has none. Reads no script.
+String CheckedOf(const Element& element) {
+  if (const auto* input = DynamicTo<HTMLInputElement>(element)) {
+    const mojom::blink::FormControlType type = input->FormControlType();
+    if (type == mojom::blink::FormControlType::kInputCheckbox ||
+        type == mojom::blink::FormControlType::kInputRadio) {
+      return input->indeterminate() ? "mixed"
+             : input->Checked()     ? "true"
+                                    : "false";
+    }
+  }
+  const AtomicString& aria =
+      element.FastGetAttribute(html_names::kAriaCheckedAttr);
+  return aria.IsNull() ? String() : String(aria);
+}
+
+// browser: what NodesAlive answers of each of `node_ids` under `root`:
+// whether it is there, rendered, what it reads and why it is invalid. Runs no
+// script. browser: also a report's acted-on nodes.
+Vector<mojom::blink::AgentNodeStatePtr> NodeStates(
+    LocalFrame* root,
+    const Vector<int32_t>& node_ids) {
+  Vector<mojom::blink::AgentNodeStatePtr> nodes;
+  nodes.ReserveInitialCapacity(node_ids.size());
+  // An assertion: nothing below runs script.
+  ScriptForbiddenScope forbid_script;
+  for (const int32_t id : node_ids) {
+    Element* element = id > 0 ? OwnedElement(root, id) : nullptr;
+    nodes.push_back(mojom::blink::AgentNodeState::New(
+        id, element != nullptr, element && element->GetLayoutObject(),
+        element ? ReadsOf(*element) : String(""),
+        element ? ReadValidity(*element) : nullptr,
+        element ? CheckedOf(*element) : String()));
+  }
+  return nodes;
+}
+
+// browser: the reply's regions, the first kMaxRegions of those read.
+void CapRegions(Vector<mojom::blink::AgentRegionReadPtr>& regions) {
+  if (regions.size() > kMaxRegions) {
+    regions.Shrink(kMaxRegions);
+  }
+}
+
+// browser: why each of `known` -- the DOMNodeIds the browser has ids
+// for under `root` -- is not among `returned`: no node by that id
+// (collected); not connected (detached); in no frame or under another local
+// root (moved: an old document's, or adopted elsewhere); else alive and not
+// listed. One left out off-screen under kNone (`offscreen`) is not answered:
+// the reply's offscreen_node_ids tells it. A hash lookup and a connectedness
+// test each.
+void AppendUnlisted(LocalFrame* root,
+                    const Vector<int32_t>& known,
+                    Vector<int32_t> returned,
+                    Vector<int32_t> offscreen,
+                    Vector<mojom::blink::AgentUnlistedPtr>& out) {
+  if (known.empty()) {
+    return;
+  }
+  std::ranges::sort(returned);
+  std::ranges::sort(offscreen);
+  for (const int32_t id : known) {
+    if (std::ranges::binary_search(returned, id) ||
+        std::ranges::binary_search(offscreen, id)) {
+      continue;
+    }
+    Node* node = id > 0 ? DOMNodeIds::NodeForId(id) : nullptr;
+    mojom::blink::AgentUnlistedWhy why;
+    if (!node) {
+      why = mojom::blink::AgentUnlistedWhy::kCollected;
+    } else if (!node->isConnected()) {
+      why = mojom::blink::AgentUnlistedWhy::kDetached;
+    } else if (LocalFrame* frame = node->GetDocument().GetFrame();
+               !root || !frame || &frame->LocalFrameRoot() != root) {
+      why = mojom::blink::AgentUnlistedWhy::kMoved;
+    } else {
+      why = mojom::blink::AgentUnlistedWhy::kUnlisted;
+    }
+    out.push_back(mojom::blink::AgentUnlisted::New(id, why));
+  }
+}
+
+// browser: Page.agentNodesAlive's `reads`, in characters, and its name
+// part's share, so the newline and some of the element's text always come
+// through; and the most aria-labelledby ids, and <label>s, read for it.
+constexpr wtf_size_t kReadsChars = 200;
+constexpr wtf_size_t kReadsNameChars = 120;
+constexpr wtf_size_t kReadsSources = 8;
+
+// browser: `text`'s first `max` characters, never cut between the halves
+// of a surrogate pair.
+String CutReads(const String& text, wtf_size_t max) {
+  if (text.length() <= max) {
+    return text;
+  }
+  wtf_size_t cut = max;
+  if ((text[cut - 1] & 0xFC00) == 0xD800) {
+    --cut;
+  }
+  return text.substr(0, cut);
+}
+
+// browser: an element's text as a live region's is read: rendered,
+// squashed, the first 300 characters (cut at a word and marked when longer),
+// never a text field's, a textarea's or a contenteditable host's
+// (agent_live_regions::ReadRegionText).
+String SourceText(const Element& source) {
+  uint64_t hash = 0;
+  String text;
+  // browser: read for every listed element now, so only as far as kept.
+  agent_live_regions::ReadRegionText(source, /*is_log=*/false, hash, &text,
+                                     /*hash_all=*/false);
+  return text;
+}
+
+// browser: an aria-labelledby target's text, rendered or not (the
+// accessible name takes hidden ones). A rendered target reads as SourceText
+// does, so its hidden parts stay out; an unrendered one by its text content,
+// squashed, at most kReadsChars. Never a text field's, a textarea's or a
+// contenteditable host's (by its attribute), nor a script's or a style
+// sheet's, and nothing of a target inside a field or in a design-mode
+// document.
+String LabelledByText(const Element& source) {
+  if (source.GetLayoutObject()) {
+    return SourceText(source);
+  }
+  const auto field = [](const Element& element) {
+    return IsA<TextControlElement>(element) ||
+           (!element.IsFormControlElement() && EditableByAttribute(element));
+  };
+  if (source.GetDocument().InDesignMode()) {
+    return String();
+  }
+  for (const Element* e = &source; e; e = e->ParentOrShadowHostElement()) {
+    if (field(*e)) {
+      return String();
+    }
+  }
+  StringBuilder raw;
+  int budget = kTextNameNodeBudget;
+  for (Node* node = NodeTraversal::Next(source, &source);
+       node && budget-- > 0 && raw.length() < kReadsChars * 4;) {
+    if (const auto* element = DynamicTo<Element>(node);
+        element &&
+        (field(*element) || element->HasTagName(html_names::kScriptTag) ||
+         element->HasTagName(html_names::kStyleTag))) {
+      node = NodeTraversal::NextSkippingChildren(*node, &source);
+      continue;
+    }
+    if (const auto* text = DynamicTo<Text>(node)) {
+      raw.Append(text->data());
+      raw.Append(' ');
+    }
+    node = NodeTraversal::Next(*node, &source);
+  }
+  return CutReads(CleanName(raw.ToString()), kReadsChars);
+}
+
+// browser: what `element` reads now: its name sources by
+// attribute -- aria-label, the aria-labelledby texts (LabelledByText), its
+// <label>s' texts, title, placeholder, alt, an SVG <title>, a button input's
+// value -- each cleaned as a name and joined by "; ", at most 120 characters;
+// a newline; then its own text (SourceText); 200 characters in all. No
+// layout, no accessibility tree, no script.
+String ReadsOf(Element& element) {
+  StringBuilder names;
+  const auto add = [&names](const String& raw) {
+    const String text = CleanName(raw);
+    if (text.empty()) {
+      return;
+    }
+    if (!names.empty()) {
+      names.Append("; ");
+    }
+    names.Append(text);
+  };
+  add(element.FastGetAttribute(html_names::kAriaLabelAttr).GetString());
+  const AtomicString& labelledby =
+      element.FastGetAttribute(html_names::kAriaLabelledbyAttr);
+  if (!labelledby.empty()) {
+    wtf_size_t taken = 0;
+    for (const String& id :
+         labelledby.GetString().SimplifyWhiteSpace().Split(' ')) {
+      if (taken++ >= kReadsSources) {
+        break;
+      }
+      if (Element* source =
+              element.GetTreeScope().getElementById(AtomicString(id))) {
+        add(LabelledByText(*source));
+      }
+    }
+  }
+  if (auto* html = DynamicTo<HTMLElement>(element);
+      html && html->IsLabelable()) {
+    if (LabelsNodeList* labels = html->labels()) {
+      const unsigned count = std::min(labels->length(), kReadsSources);
+      for (unsigned i = 0; i < count; ++i) {
+        if (Element* label = labels->item(i)) {
+          add(SourceText(*label));
+        }
+      }
+    }
+  }
+  add(element.FastGetAttribute(html_names::kTitleAttr).GetString());
+  add(element.FastGetAttribute(html_names::kPlaceholderAttr).GetString());
+  add(element.FastGetAttribute(html_names::kAltAttr).GetString());
+  if (element.IsSVGElement()) {
+    for (Element* child = ElementTraversal::FirstChild(element); child;
+         child = ElementTraversal::NextSibling(*child)) {
+      if (child->IsSVGElement() && child->localName() == "title") {
+        add(child->textContent());
+        break;
+      }
+    }
+  }
+  if (auto* input = DynamicTo<HTMLInputElement>(element)) {
+    const mojom::blink::FormControlType type = input->FormControlType();
+    if (type == mojom::blink::FormControlType::kInputButton ||
+        type == mojom::blink::FormControlType::kInputSubmit ||
+        type == mojom::blink::FormControlType::kInputReset) {
+      add(input->Value());
+    }
+  }
+  StringBuilder reads;
+  reads.Append(CutReads(names.ToString(), kReadsNameChars));
+  reads.Append('\n');
+  reads.Append(SourceText(element));
+  return CutReads(reads.ToString(), kReadsChars);
+}
+
+// browser: how much of the page's words for an error is kept.
+constexpr wtf_size_t kErrorChars = 160;
+
+// browser: whether a control holds nothing a user put in: an empty text
+// value or selection, an unchecked box or radio, a file input with no file.
+bool HoldsNoValue(const ListedElement& control) {
+  const HTMLElement& html = control.ToHTMLElement();
+  if (const auto* input = DynamicTo<HTMLInputElement>(html)) {
+    const mojom::blink::FormControlType type = input->FormControlType();
+    if (type == mojom::blink::FormControlType::kInputCheckbox ||
+        type == mojom::blink::FormControlType::kInputRadio) {
+      return !input->Checked();
+    }
+    return input->Value().empty();
+  }
+  if (const auto* textarea = DynamicTo<HTMLTextAreaElement>(html)) {
+    return textarea->Value().empty();
+  }
+  if (const auto* select = DynamicTo<HTMLSelectElement>(html)) {
+    return select->Value().empty();
+  }
+  return true;
+}
+
+// browser: the page's words for what is wrong with `element`: the shown
+// text of its aria-errormessage targets (a hidden one is not being said),
+// else, for a custom error, the page's own message; 160 characters. Never the
+// browser's own message, which can quote the value, and nothing for a
+// password, card number or security code field. Null for none.
+String ErrorText(const Element& element,
+                 const ListedElement* control,
+                 uint32_t reasons) {
+  using Validity = mojom::blink::AgentValidity;
+  if (const auto* input = DynamicTo<HTMLInputElement>(element)) {
+    if (input->FormControlType() ==
+            mojom::blink::FormControlType::kInputPassword ||
+        IsCardSecretInput(*input)) {
+      return String();
+    }
+  }
+  StringBuilder said;
+  const AtomicString& targets =
+      element.FastGetAttribute(html_names::kAriaErrormessageAttr);
+  if (!targets.empty()) {
+    wtf_size_t taken = 0;
+    for (const String& id :
+         targets.GetString().SimplifyWhiteSpace().Split(' ')) {
+      if (taken++ >= kReadsSources) {
+        break;
+      }
+      Element* target = element.GetTreeScope().getElementById(AtomicString(id));
+      if (!target || !target->GetLayoutObject()) {
+        continue;
+      }
+      const String text = SourceText(*target);
+      if (text.empty()) {
+        continue;
+      }
+      if (!said.empty()) {
+        said.Append("; ");
+      }
+      said.Append(text);
+    }
+  }
+  if (said.empty() && control && (reasons & Validity::kCustomError)) {
+    // Under a custom error every control's validationMessage is the page's
+    // own message (setCustomValidity), never the browser's text.
+    said.Append(CleanName(control->validationMessage()));
+  }
+  if (said.empty()) {
+    return String();
+  }
+  return CutReads(said.ToString(), kErrorChars);
+}
+
+// browser: why the page or the element's own constraints call it
+// invalid, and the page's words for it; null when neither does.
+// - aria-invalid counts unless it is "false", empty, "undefined" (what a
+//   template writes for an unset value, read as no attribute), or "spelling"
+//   or "grammar" (an editor's markup, not a verdict). Unlike the
+//   accessibility tree's reading, "false" does not hide a constraint error,
+//   which still blocks the submit.
+// - A constraint error counts once the user edited the control or tried to
+//   submit its form (the interacted state :user-invalid uses, read before the
+//   blur it waits for), or while it holds a value: a required field is
+//   invalid from load, which is no news. A form-associated custom element has
+//   no interacted state and its value is its own: its error counts unless it
+//   is only a missing value.
+// - In a novalidate form only a custom error counts: the page validates
+//   itself, and the browser does not block the submit.
+// Reads attributes and the control's cached validity: no style, no layout, no
+// event (never checkValidity, which fires `invalid`); a pattern is matched as
+// user-agent script.
+mojom::blink::AgentValidityPtr ReadValidity(Element& element) {
+  using Validity = mojom::blink::AgentValidity;
+  uint32_t reasons = 0;
+  const String aria = element.FastGetAttribute(html_names::kAriaInvalidAttr)
+                          .GetString()
+                          .StripWhiteSpace();
+  if (!aria.empty() && !EqualIgnoringAsciiCase(aria, "false") &&
+      !EqualIgnoringAsciiCase(aria, "undefined") &&
+      !EqualIgnoringAsciiCase(aria, "spelling") &&
+      !EqualIgnoringAsciiCase(aria, "grammar")) {
+    reasons |= Validity::kAria;
+  }
+  // Blink's own candidacy test (an <output> or <object> is never a candidate,
+  // whatever custom validity it was given).
+  ListedElement* control = ListedElement::From(element);
+  if (control && !control->IsNotCandidateOrValid()) {
+    uint32_t constraints = 0;
+    const auto flag = [&constraints](bool set, uint32_t bit) {
+      if (set) {
+        constraints |= bit;
+      }
+    };
+    flag(control->ValueMissing(), Validity::kValueMissing);
+    flag(control->TypeMismatch(), Validity::kTypeMismatch);
+    flag(control->PatternMismatch(), Validity::kPatternMismatch);
+    flag(control->TooLong(), Validity::kTooLong);
+    flag(control->TooShort(), Validity::kTooShort);
+    flag(control->RangeUnderflow(), Validity::kRangeUnderflow);
+    flag(control->RangeOverflow(), Validity::kRangeOverflow);
+    flag(control->StepMismatch(), Validity::kStepMismatch);
+    flag(control->HasBadInput(), Validity::kBadInput);
+    flag(control->CustomError(), Validity::kCustomError);
+    if (const HTMLFormElement* form = control->Form();
+        form && form->NoValidate()) {
+      constraints &= Validity::kCustomError;
+    }
+    bool counts = false;
+    if (auto* with_state =
+            DynamicTo<HTMLFormControlElementWithState>(element)) {
+      counts = with_state->UserHasEditedTheField() ||
+               with_state->MatchesUserInvalidPseudo() ||
+               !HoldsNoValue(*control);
+    } else {
+      counts = constraints != Validity::kValueMissing;
+    }
+    if (counts && constraints) {
+      reasons |= constraints;
+      if (control->IsValidationMessageVisible()) {
+        reasons |= Validity::kMessageShown;
+      }
+    }
+  }
+  if (!reasons) {
+    return nullptr;
+  }
+  auto validity = Validity::New();
+  validity->reasons = reasons;
+  validity->error = ErrorText(element, control, reasons);
+  return validity;
+}
+
+// An element's box in its local root's space, as ResolveNode reports it;
+// zero when it is not laid out.
+mojom::blink::AgentElementBoxPtr LocalRootBox(Element& element) {
+  LocalFrame* frame = element.GetDocument().GetFrame();
+  if (!element.GetLayoutObject() || !frame || !frame->View()) {
+    return mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  }
+  DOMRect* rect = element.GetBoundingClientRect();
+  const gfx::PointF root_top_left =
+      frame->View()->ConvertToRootFrame(gfx::PointF(rect->x(), rect->y()));
+  return mojom::blink::AgentElementBox::New(
+      root_top_left.x(), root_top_left.y(), rect->width(), rect->height());
+}
+
+// An option in the form a select's listed value takes (FormControlValue): its
+// text, and its value too when the two differ.
+String ShownOption(HTMLOptionElement& option) {
+  const String text = option.text().SimplifyWhiteSpace();
+  return option.value() == text ? text : text + " (" + option.value() + ")";
+}
+
+// Whether an option's display is judged: a closed appearance:base-select
+// picker gives its options no style, so there every option counts as
+// displayed.
+enum class DisplayJudged { kYes, kNo };
+
+DisplayJudged DisplayJudgedFor(const HTMLSelectElement& select) {
+  return select.IsAppearanceBasePicker() && !select.PopupIsVisible()
+             ? DisplayJudged::kNo
+             : DisplayJudged::kYes;
+}
+
+// Not display:none, by the style the option has now, as the dropdown's list
+// and the keys read it (SelectType::NextValidOption, InternalPopupMenu).
+bool IsDisplayed(HTMLOptionElement& option, DisplayJudged display) {
+  return display == DisplayJudged::kNo ||
+         !option.IsDisplayNone(/*ensure_style=*/false);
+}
+
+// Whether a person can pick an option: enabled (its optgroup too) and
+// displayed.
+bool IsPickable(HTMLOptionElement& option, DisplayJudged display) {
+  return !option.IsDisabledFormControl() && IsDisplayed(option, display);
+}
+
+// Which options a select's value can name: pickable ones, or any, to tell a
+// disabled or hidden match from a missing one.
+enum class OptionUse { kPickable, kAny };
+
+// The list index of the option a value names: by value, then by the text
+// shown (case and spacing aside), then as "Text (value)", the form a
+// select's listed value takes. -1 when none does.
+int MatchOption(const HTMLSelectElement::ListItems& items,
+                const String& wanted,
+                OptionUse use,
+                DisplayJudged display) {
+  for (wtf_size_t i = 0; i < items.size(); ++i) {
+    auto* option = DynamicTo<HTMLOptionElement>(items[i].Get());
+    if (option && (use == OptionUse::kAny || IsPickable(*option, display)) &&
+        option->value() == wanted) {
+      return static_cast<int>(i);
+    }
+  }
+  const String want = wanted.SimplifyWhiteSpace();
+  for (wtf_size_t i = 0; i < items.size(); ++i) {
+    auto* option = DynamicTo<HTMLOptionElement>(items[i].Get());
+    if (option && (use == OptionUse::kAny || IsPickable(*option, display)) &&
+        EqualIgnoringAsciiCase(option->text().SimplifyWhiteSpace(), want)) {
+      return static_cast<int>(i);
+    }
+  }
+  if (want.ends_with(')')) {
+    const wtf_size_t open = want.rfind(" (");
+    if (open != kNotFound) {
+      const String text_part = want.substr(0, open).SimplifyWhiteSpace();
+      const String value_part = want.substr(open + 2, want.length() - open - 3);
+      for (wtf_size_t i = 0; i < items.size(); ++i) {
+        auto* option = DynamicTo<HTMLOptionElement>(items[i].Get());
+        if (option &&
+            (use == OptionUse::kAny || IsPickable(*option, display)) &&
+            option->value() == value_part &&
+            EqualIgnoringAsciiCase(option->text().SimplifyWhiteSpace(),
+                                   text_part)) {
+          return static_cast<int>(i);
+        }
+      }
+    }
+  }
+  return -1;
+}
+
+// browser: Input.selectOptions: an option, at list index `index`, as its
+// reading gives it; index -1 and the rest empty for none.
+mojom::blink::AgentSelectOptionPtr ReadOption(HTMLOptionElement* option,
+                                              int index,
+                                              DisplayJudged display) {
+  if (!option) {
+    return mojom::blink::AgentSelectOption::New(
+        -1, 0, g_empty_string, g_empty_string, false, false, false,
+        mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0));
+  }
+  return mojom::blink::AgentSelectOption::New(
+      index, static_cast<int32_t>(DOMNodeIds::IdForNode(option)),
+      NonNull(option->text().SimplifyWhiteSpace()), NonNull(option->value()),
+      option->Selected(), option->IsDisabledFormControl(),
+      IsDisplayed(*option, display), LocalRootBox(*option));
+}
+
+// Whether the keys on a dropdown stop on list index `index`, as
+// SelectType::NextValidOption judges it: an option a person can pick, its
+// display judged by its style.
+bool IsKeyStop(const HTMLSelectElement::ListItems& items, int index) {
+  auto* option =
+      DynamicTo<HTMLOptionElement>(items[static_cast<wtf_size_t>(index)].Get());
+  return option && IsPickable(*option, DisplayJudged::kYes);
+}
+
+// The first list index the keys stop on going `direction` from the list's
+// start (1, as Home) or end (-1, as End); -1 when none.
+int EdgeKeyStop(const HTMLSelectElement::ListItems& items, int direction) {
+  const int size = static_cast<int>(items.size());
+  for (int i = direction > 0 ? 0 : size - 1; i >= 0 && i < size;
+       i += direction) {
+    if (IsKeyStop(items, i)) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+// browser: Input.selectOptions: the arrow presses on a focused dropdown from
+// list index `from` (-1: none selected) to `to`, as the keys step. Negative
+// is up; 0 when `to` is already selected or no press lands on it.
+int ArrowSteps(const HTMLSelectElement::ListItems& items, int from, int to) {
+  const int size = static_cast<int>(items.size());
+  if (to < 0 || to >= size || from == to) {
+    return 0;
+  }
+  const int direction = to > from ? 1 : -1;
+  int steps = 0;
+  for (int i = from + direction; i >= 0 && i < size; i += direction) {
+    const bool is_valid = IsKeyStop(items, i);
+    if (is_valid) {
+      ++steps;
+    }
+    if (i == to) {
+      return is_valid ? direction * steps : 0;
+    }
+  }
+  return 0;
+}
+
+// The labels type-ahead compares (HTMLSelectElement::OptionAtIndex), one per
+// list index: empty for a group label or a disabled option; leading spaces
+// dropped, as TypeAhead drops them.
+Vector<String> TypeAheadLabels(const HTMLSelectElement::ListItems& items) {
+  Vector<String> labels;
+  for (const auto& item : items) {
+    auto* option = DynamicTo<HTMLOptionElement>(item.Get());
+    if (!option || option->IsDisabledFormControl()) {
+      labels.push_back(g_empty_string);
+      continue;
+    }
+    const String label = option->DisplayLabel();
+    wtf_size_t first = 0;
+    while (first < label.length() &&
+           (label[first] == uchar::kNoBreakSpace ||
+            unicode::IsSpaceOrNewline(label[first]))) {
+      ++first;
+    }
+    labels.push_back(label.substr(first));
+  }
+  return labels;
+}
+
+// The character an unmodified key press types for `c` on a US layout,
+// letters lowercased (type-ahead ignores case); 0 when it takes Shift or no
+// key types it.
+UChar UnshiftedKey(UChar c) {
+  if (IsAsciiAlpha(c)) {
+    return ToAsciiLower(c);
+  }
+  if (IsAsciiDigit(c)) {
+    return c;
+  }
+  switch (c) {
+    case ' ':
+    case '`':
+    case '-':
+    case '=':
+    case '[':
+    case ']':
+    case 0x5C:  // backslash
+    case ';':
+    case 0x27:  // apostrophe
+    case ',':
+    case '.':
+    case '/':
+      return c;
+    default:
+      return 0;
+  }
+}
+
+// browser: Input.selectOptions: the shortest prefix of list index `to`'s
+// label, 1 to 4 characters an unmodified key press types (see UnshiftedKey),
+// that type-ahead on the focused dropdown lands on when typed from list index
+// `from` in one session (TypeAhead::HandleEvent with kMatchPrefix and
+// kCycleFirstChar, taking no earlier session), as the keys to press; empty
+// when none does.
+String TypeAheadPrefix(const Vector<String>& labels, int from, int to) {
+  const int count = static_cast<int>(labels.size());
+  if (to < 0 || to >= count) {
+    return g_empty_string;
+  }
+  const String& label = labels[static_cast<wtf_size_t>(to)];
+  for (wtf_size_t length = 1; length <= 4 && length <= label.length();
+       ++length) {
+    // A character no unmodified press types is in every longer prefix too.
+    if (!UnshiftedKey(label[length - 1])) {
+      break;
+    }
+    int selected = from;
+    UChar repeating = 0;
+    StringBuilder typed;
+    for (wtf_size_t k = 0; k < length; ++k) {
+      const UChar key = UnshiftedKey(label[k]);
+      typed.Append(key);
+      String prefix;
+      int start_offset = 1;
+      if (key == repeating) {
+        prefix = String(base::span_from_ref(key));
+      } else {
+        prefix = typed.ToString();
+        if (typed.length() > 1) {
+          repeating = 0;
+          start_offset = 0;
+        } else {
+          repeating = key;
+        }
+      }
+      int index = ((selected < 0 ? 0 : selected) + start_offset) % count;
+      for (int i = 0; i < count; ++i, index = (index + 1) % count) {
+        if (labels[static_cast<wtf_size_t>(index)]
+                .StartsWithIgnoringCaseAndAccents(prefix)) {
+          selected = index;
+          break;
+        }
+      }
+    }
+    if (selected == to) {
+      return typed.ToString();
+    }
+  }
+  return g_empty_string;
+}
+
+// The page popup `owner` has open (a native list window, a colour picker),
+// shown by the browser and not closing (with `shown_only` false, also one the
+// browser has not shown yet); null when none is, or the page's one popup
+// belongs to another element.
+WebPagePopupImpl* OpenPopupOf(Element& owner, bool shown_only = true) {
+  Page* page = owner.GetDocument().GetPage();
+  WebViewImpl* web_view = page ? page->GetChromeClient().GetWebView() : nullptr;
+  if (!web_view || !web_view->HasOpenedPopup()) {
+    return nullptr;
+  }
+  WebPagePopupImpl* popup = web_view->GetPagePopup();
+  return popup && (popup->IsShown() || !shown_only) &&
+                 &popup->OwnerElement() == &owner
+             ? popup
+             : nullptr;
+}
+
+// The native list window `select` has open (OpenPopupOf).
+WebPagePopupImpl* OpenListWindow(HTMLSelectElement& select) {
+  return OpenPopupOf(select);
+}
+
+// browser: Input.selectOptions: where list index `index` sits in the native
+// list window `select` has open: its row's box in screen DIPs, and whether
+// the row shows among the list's rows. Left as it was when the list has not
+// built that row yet (a long list builds its rows in batches).
+void ReadListRow(HTMLSelectElement& select,
+                 int index,
+                 mojom::blink::AgentSelectReading& reading) {
+  WebPagePopupImpl* popup = OpenListWindow(select);
+  LocalDOMWindow* window = popup ? popup->Window() : nullptr;
+  LocalFrame* frame = window ? window->GetFrame() : nullptr;
+  Document* document = window ? window->document() : nullptr;
+  if (!frame || !frame->View() || !document) {
+    return;
+  }
+  // The list window's own page, laid out for its rows; nothing of the
+  // opener's document is touched.
+  document->UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  auto* list = Traversal<HTMLSelectElement>::FirstWithin(*document);
+  if (!list || !list->GetLayoutObject()) {
+    return;
+  }
+  // The window's rows carry the opener's list index as their value.
+  const String wanted = String::Number(index);
+  for (const auto& item : list->GetListItems()) {
+    auto* row = DynamicTo<HTMLOptionElement>(item.Get());
+    if (!row || row->value() != wanted || !row->GetLayoutObject()) {
+      continue;
+    }
+    const gfx::Rect in_list = row->GetLayoutObject()->AbsoluteBoundingBoxRect();
+    const gfx::Rect shown = list->GetLayoutObject()->AbsoluteBoundingBoxRect();
+    const gfx::Rect on_screen = frame->View()->FrameToScreen(in_list);
+    reading.popup_option_found = true;
+    reading.popup_option_box = mojom::blink::AgentElementBox::New(
+        on_screen.x(), on_screen.y(), on_screen.width(), on_screen.height());
+    reading.popup_option_in_view = shown.Contains(in_list.CenterPoint());
+    return;
+  }
+}
+
+// What a press reached, for a refusal to name: the tag, its id or first
+// class, and its text when that is short. browser: a part a browser
+// draws inside a control -- in its user-agent shadow tree, which no selector
+// reaches -- by that control, without the text its parts make (a video's
+// time): "input#when's own picker button" for a date, time or list field's
+// picker indicator, else the control alone.
+String DescribeHit(Element& hit) {
+  Element* named = &hit;
+  bool picker = false;
+  if (hit.IsInUserAgentShadowRoot()) {
+    Element* host = hit.OwnerShadowHost();
+    while (host && host->IsInUserAgentShadowRoot()) {
+      host = host->OwnerShadowHost();
+    }
+    if (host) {
+      named = host;
+      picker = hit.ShadowPseudoId() ==
+               shadow_element_names::kPseudoCalendarPickerIndicator;
+    }
+  }
+  StringBuilder description;
+  description.Append(named->localName());
+  const AtomicString& id = named->GetIdAttribute();
+  if (!id.empty()) {
+    description.Append('#');
+    description.Append(id);
+  } else if (named->HasClass() && named->ClassNames().size()) {
+    description.Append('.');
+    description.Append(named->ClassNames()[0]);
+  }
+  if (named == &hit) {
+    const String text = TextName(&hit);
+    if (!text.empty() && text.length() <= 40) {
+      description.Append(" \"");
+      description.Append(text);
+      description.Append('"');
+    }
+  }
+  if (picker) {
+    description.Append("'s own picker button");
+  }
+  return description.ToString();
+}
+
+// Defined below.
+Element* CoverLayer(Element& hit, const Element* element, const char*& kind);
+String CoverLayerName(Element& layer, const char* kind);
+String VeilLayerName(LocalFrame& root,
+                     Element& hit,
+                     const Element& element,
+                     const char*& kind);
+
+// browser: `what`, the name of `hit` that a press met instead of `element`,
+// with where it is when it is not in the element's own document -- "the
+// page's X" in the main frame, "X in another frame" otherwise -- as the
+// browser's CoverName says a cover in another process.
+String CoverWhere(const Element& hit,
+                  const Element& element,
+                  const String& what) {
+  if (&hit.GetDocument() == &element.GetDocument()) {
+    return what;
+  }
+  const LocalFrame* frame = hit.GetDocument().GetFrame();
+  if (frame && frame->IsOutermostMainFrame()) {
+    return "the page's " + what;
+  }
+  return what + " in another frame";
+}
+
+// browser: what a press met instead of `element`, named as the press check
+// names it, with where it is (CoverWhere). browser: in an
+// open layer the element is not in, by that layer (listbox "City"), its kind
+// in `kind` when asked; empty for a hit named by itself.
+String CoverFrom(Element& hit, const Element& element, String* kind = nullptr) {
+  const char* layer_kind = nullptr;
+  Element* layer = CoverLayer(hit, &element, layer_kind);
+  if (kind) {
+    *kind = layer ? String(layer_kind) : g_empty_string;
+  }
+  return CoverWhere(
+      hit, element,
+      layer ? CoverLayerName(*layer, layer_kind) : DescribeHit(hit));
+}
+
+// browser: a drag carry's margins, in Blink's px. Every scroller and the
+// window autoscroll a drag held within 20 px of their edges (LayoutBox::
+// CalculateAutoscrollDirection); a carried element is brought up to 16 px
+// further in -- less in a small box -- so the hand lands on it clear of that
+// belt.
+constexpr float kCarryBelt = 20.f;
+constexpr float kCarryMargin = 16.f;
+
+// The calm inset along a stretch `length` long: the belt and a margin that
+// shrinks with the box, so a small box keeps a calm part.
+float CarryInset(float length) {
+  return kCarryBelt +
+         std::clamp((length - 2 * kCarryBelt) / 4, 2.f, kCarryMargin);
+}
+
+// The boxes that scroll what `object` is in, innermost first, each frame's
+// window included, up through same-process frames to the local root.
+void CarryChain(const LayoutObject& object,
+                HeapVector<Member<const LayoutBox>>& chain) {
+  const LayoutObject* from = &object;
+  while (from) {
+    LocalFrame* frame = from->GetFrame();
+    for (const LayoutBox* box = from->ContainingScrollContainer(); box;
+         box = box->ContainingScrollContainer()) {
+      if (!box->IsLayoutView()) {
+        chain.push_back(box);
+      }
+    }
+    if (!frame) {
+      return;
+    }
+    if (const LayoutView* window = frame->ContentLayoutObject()) {
+      chain.push_back(window);
+    }
+    from = frame->IsLocalRoot() ? nullptr : frame->OwnerLayoutObject();
+  }
+}
+
+// What a scroller shows, and the calm part of that clear of its autoscroll
+// belt, in the local root's frame. Empty when it cannot be read.
+struct CarryPort {
+  gfx::RectF shown;
+  gfx::RectF calm;
+  // browser: what its autoscroll belt is measured from, and its border box --
+  // the box a point over its scrollbars counts for -- for a scroller in a
+  // frame; the same as `outer` for a window.
+  gfx::RectF outer;
+  gfx::RectF border;
+};
+
+CarryPort PortOf(const LayoutBox& box) {
+  CarryPort port;
+  LocalFrameView* view = box.GetFrame() ? box.GetFrame()->View() : nullptr;
+  PaintLayerScrollableArea* area = box.GetScrollableArea();
+  if (!view || !area) {
+    return port;
+  }
+  gfx::Rect outer;
+  gfx::Rect shown;
+  if (box.IsLayoutView()) {
+    // The window: what it shows, less its scrollbars.
+    outer = gfx::Rect(area->VisibleContentRect(kExcludeScrollbars).size());
+    shown = outer;
+  } else {
+    // A box: its border box less its scrollbars, which the belt is measured
+    // from; and less its borders as well, which is what shows.
+    outer = box.AbsoluteBoundingBoxRect();
+    const int bar_width = area->VerticalScrollbarWidth();
+    const int bar_height = area->HorizontalScrollbarHeight();
+    outer.Inset(area->ShouldPlaceVerticalScrollbarOnLeft()
+                    ? gfx::Insets::TLBR(0, bar_width, bar_height, 0)
+                    : gfx::Insets::TLBR(0, 0, bar_height, bar_width));
+    shown = outer;
+    const PhysicalBoxStrut border = box.BorderOutsets();
+    shown.Inset(gfx::Insets::TLBR(border.top.ToInt(), border.left.ToInt(),
+                                  border.bottom.ToInt(), border.right.ToInt()));
+  }
+  port.shown = gfx::RectF(view->ConvertToRootFrame(shown));
+  port.calm = gfx::RectF(view->ConvertToRootFrame(outer));
+  port.outer = port.calm;
+  port.border =
+      box.IsLayoutView()
+          ? port.outer
+          : gfx::RectF(view->ConvertToRootFrame(box.AbsoluteBoundingBoxRect()));
+  const float inset_x = CarryInset(port.calm.width());
+  const float inset_y = CarryInset(port.calm.height());
+  port.calm.Inset(gfx::InsetsF::VH(inset_y, inset_x));
+  // Narrowed to what shows along each axis apart, by CarryNeed: an empty one
+  // across would collapse the one along.
+  return port;
+}
+
+// Whether the wheel could still move a box's content along an axis: forward
+// (up or left, as the wheel turned down or right moves it) or back.
+bool CarryCanScroll(const LayoutBox& box, bool vertical, bool forward) {
+  PaintLayerScrollableArea* area = box.GetScrollableArea();
+  if (!area || !area->UserInputScrollable(vertical ? kVerticalScrollbar
+                                                   : kHorizontalScrollbar)) {
+    return false;
+  }
+  const ScrollOffset offset = area->GetScrollOffset();
+  const ScrollOffset end =
+      forward ? area->MaximumScrollOffset() : area->MinimumScrollOffset();
+  const float room = vertical ? end.y() - offset.y() : end.x() - offset.x();
+  return forward ? room >= 1 : room <= -1;
+}
+
+LayoutObject* UpAcrossFrames(const LayoutObject& object);
+
+// browser: whether `object` is a box fixed to the view, or sticky.
+bool IsPinned(const LayoutObject& object) {
+  const auto* box = DynamicTo<LayoutBox>(object);
+  return (box && box->IsFixedToView()) ||
+         object.StyleRef().GetPosition() == EPosition::kSticky;
+}
+
+// browser: whether something fixed to the view or sticky lies on
+// the way up from `inner`, itself included, to `outer`, a box of the chain
+// further out (across frames): turning `outer` then leaves `inner` where it
+// is.
+bool PinnedBetween(const LayoutBox& inner, const LayoutBox& outer) {
+  for (const LayoutObject* o = &inner; o && o != &outer;
+       o = UpAcrossFrames(*o)) {
+    if (IsPinned(*o)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// browser: the first box fixed to the view, or sticky, that holds
+// `object`, itself included, across frames: what the scroll beyond it leaves
+// where it is. Null when none.
+const LayoutObject* PinnedAbove(const LayoutObject& object) {
+  for (const LayoutObject* o = &object; o; o = UpAcrossFrames(*o)) {
+    if (IsPinned(*o)) {
+      return o;
+    }
+  }
+  return nullptr;
+}
+
+// browser: whether a box fixed to `window`'s view holds `object`,
+// itself included, up across frames to that view: turning `window` leaves
+// `object` where it is. Only a box in the view's own frame counts: one fixed
+// in a frame inside it is fixed to that frame's view, which `window` moves.
+bool FixedAgainst(const LayoutObject& object, const LayoutBox& window) {
+  if (!window.IsLayoutView()) {
+    return false;
+  }
+  for (const LayoutObject* o = &object; o && o != &window;
+       o = UpAcrossFrames(*o)) {
+    const auto* box = DynamicTo<LayoutBox>(o);
+    if (box && box->IsFixedToView() && box->View() == &window) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// How far `at`, a coordinate in the local root's frame, must move along an
+// axis to sit in the calm part of every scroller that holds it -- or, for a
+// scroller that cannot move it further that way, merely in what it shows.
+// Positive when it must move up or left. Worked from the window in: a box that
+// lies wholly out of the calm part of what holds it is brought into it first,
+// by what holds it -- wholly, at the nearer side, when it fits -- and what is
+// inside it moves with it; `need` is then that first move. Only the scrollers
+// [movers_from, movers_to] (innermost first) can reduce the need: the one
+// whose calm part binds it, and those inside it -- turning one outside it
+// moves the point and that bound together. `rest` is where the point comes to
+// rest once everything has moved; the calm and shown stretches are as things
+// stand, when nothing is to be brought in first; `firm_length` is the calm
+// stretch as it will be once each box has moved off the end it may be at.
+// A box that cannot move the point along the axis either way, while it shows
+// the point there and a box further out can move both, is passed over: it
+// moves with that one, so it bounds nothing. browser: a
+// frame's view that `object`, when given, is fixed against (FixedAgainst)
+// cannot move the point either way: it bounds it only to what it shows, and
+// is never the box that moves it.
+struct CarryNeedOf {
+  float need = 0;
+  float rest = 0;
+  float calm_length = 0;
+  float firm_length = 0;
+  float calm_lo = std::numeric_limits<float>::lowest();
+  float calm_hi = std::numeric_limits<float>::max();
+  float shown_lo = std::numeric_limits<float>::lowest();
+  float shown_hi = std::numeric_limits<float>::max();
+  bool gapped = false;
+  wtf_size_t movers_from = 0;
+  wtf_size_t movers_to = std::numeric_limits<wtf_size_t>::max();
+  // browser: the innermost box that bounds the axis -- what a
+  // cover over the stretch is judged against (CarryStretchClear); 0 unless
+  // boxes inside it were passed over.
+  wtf_size_t holder = 0;
+  // browser: no box in the chain can move the point along the axis --
+  // none can scroll that way, or the one that could is a view the element is
+  // fixed against: what lies over it there stays over it.
+  bool unmoved = false;
+};
+
+CarryNeedOf CarryNeed(const HeapVector<Member<const LayoutBox>>& chain,
+                      bool vertical,
+                      float at,
+                      const LayoutObject* object = nullptr) {
+  CarryNeedOf result;
+  result.rest = at;
+  float lo = std::numeric_limits<float>::lowest();
+  float hi = std::numeric_limits<float>::max();
+  float firm_lo = std::numeric_limits<float>::lowest();
+  float firm_hi = std::numeric_limits<float>::max();
+  float shown_lo = std::numeric_limits<float>::lowest();
+  float shown_hi = std::numeric_limits<float>::max();
+  // The scrollers whose calm parts bound it from either side.
+  wtf_size_t lo_by = 0;
+  wtf_size_t hi_by = 0;
+  float shift = 0;
+  bool held = false;
+  // Whether a box further out can still move the point along this axis, with
+  // nothing fixed or sticky between that would leave the one at hand where it
+  // is; and the innermost box that can move it: those inside it move with it,
+  // nothing inside them moving the point.
+  bool outer_moves = false;
+  wtf_size_t first_mover = chain.size();
+  for (wtf_size_t i = 0; i < chain.size(); ++i) {
+    // browser: never a view `object` is fixed against.
+    if (object && FixedAgainst(*object, *chain[i])) {
+      continue;
+    }
+    if (CarryCanScroll(*chain[i], vertical, /*forward=*/true) ||
+        CarryCanScroll(*chain[i], vertical, /*forward=*/false)) {
+      first_mover = i;
+      break;
+    }
+  }
+  for (wtf_size_t i = chain.size(); i-- > 0;) {
+    const LayoutBox& box = *chain[i];
+    if (i + 1 < chain.size() && PinnedBetween(box, *chain[i + 1])) {
+      outer_moves = false;
+    }
+    // browser: which ways it can move the point: neither for a view
+    // `object` is fixed against.
+    const bool fixed_against = object && FixedAgainst(*object, box);
+    const bool can_fwd =
+        !fixed_against && CarryCanScroll(box, vertical, /*forward=*/true);
+    const bool can_back =
+        !fixed_against && CarryCanScroll(box, vertical, /*forward=*/false);
+    const bool moves = can_fwd || can_back;
+    const CarryPort port = PortOf(box);
+    if (port.shown.IsEmpty()) {
+      outer_moves = outer_moves || moves;
+      result.holder = i;
+      continue;
+    }
+    const float raw_s0 = vertical ? port.shown.y() : port.shown.x();
+    const float raw_s1 = vertical ? port.shown.bottom() : port.shown.right();
+    // Its calm part along this axis, within what shows; its middle when too
+    // small for one.
+    float c0 = std::max(vertical ? port.calm.y() : port.calm.x(), raw_s0);
+    float c1 =
+        std::min(vertical ? port.calm.bottom() : port.calm.right(), raw_s1);
+    if (c1 - c0 < 2) {
+      c0 = c1 = (raw_s0 + raw_s1) / 2;
+    }
+    float s0 = raw_s0 - shift;
+    float s1 = raw_s1 - shift;
+    // A row that scrolls only across, under a fixed bar, the page able to
+    // scroll it clear: whatever the page turns, the point stays in what the row
+    // shows.
+    if (i < first_mover && outer_moves && at - shift >= s0 &&
+        at - shift <= s1) {
+      shown_lo = std::max(shown_lo, s0);
+      shown_hi = std::min(shown_hi, s1);
+      continue;
+    }
+    c0 -= shift;
+    c1 -= shift;
+    float f0 = c0;
+    float f1 = c1;
+    if (!can_fwd) {
+      c1 = std::max(c1, s1 - 2);
+    }
+    if (!can_back) {
+      c0 = std::min(c0, s0 + 2);
+    }
+    if (held && !result.gapped && (c0 > hi || c1 < lo)) {
+      const bool fits = c1 - c0 <= hi - lo;
+      const float gap =
+          c0 > hi ? (fits ? c1 - hi : c0 - lo) : (fits ? c0 - lo : c1 - hi);
+      result.gapped = true;
+      result.need = gap;
+      result.movers_from = i + 1;
+      result.movers_to = c0 > hi ? hi_by : lo_by;
+      shift += gap;
+      s0 -= gap;
+      s1 -= gap;
+      c0 -= gap;
+      c1 -= gap;
+      f0 -= gap;
+      f1 -= gap;
+    }
+    // A tie binds the inner one: turning the outer moves both bounds together.
+    if (c0 >= lo) {
+      lo = c0;
+      lo_by = i;
+    }
+    if (c1 <= hi) {
+      hi = c1;
+      hi_by = i;
+    }
+    firm_lo = std::max(firm_lo, f0);
+    firm_hi = std::min(firm_hi, f1);
+    shown_lo = std::max(shown_lo, s0);
+    shown_hi = std::min(shown_hi, s1);
+    held = true;
+    outer_moves = outer_moves || moves;
+    result.holder = i;
+  }
+  if (!held) {
+    return result;
+  }
+  result.unmoved = first_mover == chain.size();
+  // A box deeper in, out of view as well: its middle.
+  if (lo > hi) {
+    lo = hi = (lo + hi) / 2;
+  }
+  const float at_now = at - shift;
+  result.rest = std::clamp(at_now, lo, hi);
+  if (!result.gapped) {
+    result.need = at - result.rest;
+    if (at_now > hi) {
+      result.movers_to = hi_by;
+    } else if (at_now < lo) {
+      result.movers_to = lo_by;
+    }
+    result.calm_lo = lo;
+    result.calm_hi = hi;
+    result.shown_lo = shown_lo;
+    result.shown_hi = shown_hi;
+  }
+  result.calm_length = hi - lo;
+  result.firm_length = std::max(0.f, firm_hi - firm_lo);
+  return result;
+}
+
+// browser: whether a sticky box sticks to a scroller strictly
+// inside `holder`: it moves with `holder` as that turns, so it covers nothing
+// `holder` scrolls -- a table's sticky first column, once the table's wrapper
+// is passed over for the window.
+bool StuckInside(const LayoutObject& sticky, const LayoutBox& holder) {
+  if (sticky.StyleRef().GetPosition() != EPosition::kSticky) {
+    return false;
+  }
+  const LayoutBox* to = sticky.ContainingScrollContainer();
+  return to && to != &holder &&
+         (holder.IsLayoutView() ? !to->IsLayoutView()
+                                : to->IsDescendantOf(&holder));
+}
+
+bool Hittable(const LayoutObject& object);
+
+// browser: whether what a hit test finds at a root-frame point lies over the
+// scroller `holder` that holds the carried element `target`, rather than being
+// part of it: anything outside it, or a fixed or sticky box within it that the
+// element is not itself inside (for the window, anything fixed or sticky so),
+// unless a sticky box sticks to a scroller inside `holder` (StuckInside).
+// Names it in `what` when it does and `what` is given (a cover's layer
+// is named by walking its text, so a caller names only what it keeps);
+// `pinned`, when given, is set to what stays put there, if it was a fixed or
+// sticky box: the outermost box from the hit up to it that takes hits -- a
+// static box in a click-through fixed wrapper is itself, not the wrapper.
+bool CarryCovered(LocalFrame& root,
+                  const gfx::PointF& at,
+                  const LayoutBox& holder,
+                  const LayoutObject& target,
+                  String* what,
+                  const LayoutObject** pinned = nullptr) {
+  LocalFrameView* view = root.View();
+  if (!view) {
+    return false;
+  }
+  HitTestLocation location(view->ConvertFromRootFrame(at));
+  HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+      location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                    HitTestRequest::kAllowChildFrameContent);
+  Element* hit = result.InnerElement();
+  if (!hit || !hit->GetLayoutObject()) {
+    return false;
+  }
+  // Into the holder's frame, by the frames' owners.
+  const LayoutObject* object = hit->GetLayoutObject();
+  LocalFrame* holder_frame = holder.GetFrame();
+  while (object && object->GetFrame() != holder_frame) {
+    LocalFrame* frame = object->GetFrame();
+    object =
+        frame && !frame->IsLocalRoot() ? frame->OwnerLayoutObject() : nullptr;
+  }
+  bool over = !object;
+  if (object && !holder.IsLayoutView() && object != &holder &&
+      !object->IsDescendantOf(&holder)) {
+    over = true;
+  }
+  const LayoutObject* part = nullptr;
+  for (const LayoutObject* o = object; o && !over && o != &holder;
+       o = o->Parent()) {
+    if (Hittable(*o)) {
+      part = o;
+    }
+    const EPosition position = o->StyleRef().GetPosition();
+    if ((position == EPosition::kFixed || position == EPosition::kSticky) &&
+        !target.IsDescendantOf(o) && !StuckInside(*o, holder)) {
+      over = true;
+      if (pinned) {
+        *pinned = part ? part : o;
+      }
+    }
+  }
+  if (over && what) {
+    // With where it is when it is not in the target's own document, as the
+    // press check says it.
+    const auto* target_element = DynamicTo<Element>(target.GetNode());
+    *what =
+        target_element ? CoverFrom(*hit, *target_element) : DescribeHit(*hit);
+  }
+  return over;
+}
+
+// browser: the calm stretch [lo, hi] along an axis less what lies over it, at
+// `across` on the other axis (root-frame px): the uncovered run nearest
+// `rest`. False, with the cover named, when all of it is covered. A point in
+// `pinned_box` -- what stays put over the element where it is now -- is
+// covered (by `pinned_name`) whatever moves with the page over it there: it
+// moves away as the page scrolls. Every run found goes in `runs`.
+// browser: where the cover named was met, in `cover_at`, unless it
+// was the pinned box's.
+bool CarryUncovered(LocalFrame& root,
+                    const LayoutBox& holder,
+                    const LayoutObject& target,
+                    bool vertical,
+                    float across,
+                    float rest,
+                    float& lo,
+                    float& hi,
+                    String* what,
+                    const gfx::RectF* pinned_box = nullptr,
+                    const String* pinned_name = nullptr,
+                    Vector<std::pair<float, float>>* runs = nullptr,
+                    std::optional<gfx::PointF>* cover_at = nullptr) {
+  if (!(hi >= lo)) {
+    return true;
+  }
+  const float length = hi - lo;
+  const int samples = std::clamp(static_cast<int>(length / 6) + 1, 2, 60);
+  const float step = length / (samples - 1);
+  bool found = false;
+  bool in_run = false;
+  float run_lo = 0;
+  float best_lo = lo;
+  float best_hi = hi;
+  float best_distance = 0;
+  String cover;
+  // One look past the end closes the last run. The last look is `hi` itself:
+  // a stretch all clear reads back as itself, which ReadCarry, and
+  // StaysPutOver's mirror of it, compare by value (in float32,
+  // lo + step * (samples - 1) can miss it by an ulp).
+  for (int k = 0; k <= samples; ++k) {
+    const float along = k == samples - 1 ? hi : lo + step * k;
+    bool free = false;
+    if (k < samples) {
+      String named;
+      const gfx::PointF point =
+          vertical ? gfx::PointF(across, along) : gfx::PointF(along, across);
+      // Only the first cover is kept: only it is named.
+      free = !CarryCovered(root, point, holder, target,
+                           cover.empty() ? &named : nullptr);
+      bool pinned_here = false;
+      if (free && pinned_box && pinned_box->Contains(point)) {
+        free = false;
+        pinned_here = true;
+        named = pinned_name ? *pinned_name : String();
+      }
+      if (!free && cover.empty()) {
+        cover = named;
+        if (cover_at && pinned_here) {
+          cover_at->reset();
+        } else if (cover_at) {
+          *cover_at = point;
+        }
+      }
+    }
+    if (free && !in_run) {
+      in_run = true;
+      run_lo = along;
+    } else if (!free && in_run) {
+      in_run = false;
+      const float run_hi = k == samples ? hi : lo + step * (k - 1);
+      if (runs) {
+        runs->push_back(std::make_pair(run_lo, run_hi));
+      }
+      const float distance = rest < run_lo   ? run_lo - rest
+                             : rest > run_hi ? rest - run_hi
+                                             : 0;
+      if (!found || distance < best_distance) {
+        found = true;
+        best_distance = distance;
+        best_lo = run_lo;
+        best_hi = run_hi;
+      }
+    }
+  }
+  if (!found) {
+    *what = cover;
+    return false;
+  }
+  lo = best_lo;
+  hi = best_hi;
+  return true;
+}
+
+bool StaysPutRoom(const HeapVector<Member<const LayoutBox>>& chain,
+                  const LayoutObject* pinned,
+                  bool vertical,
+                  float b0,
+                  float b1,
+                  float lo,
+                  float hi);
+
+// browser: what lies over the stretch along the main axis where an element
+// aimed at `aim` (the local root's frame) would be brought to rest, as
+// ReadCarry reads it: false, with the cover named in `what`, when all of it is
+// covered; else true, with [lo, hi] the uncovered run nearest its rest -- the
+// calm stretch itself when nothing lies over it, or when there is no stretch to
+// read (gapped, or unbounded), which `read` tells. Covers are judged against
+// the box that bounds the axis (CarryNeedOf.holder); what stays put
+// over the element where it is now covers its own box; and the run
+// taken is the nearest the scroll left can bring the element into, when there
+// is one. `runs` and `pinned`, when given, get every uncovered run
+// read and what stays put over the element there, if anything (CarryCovered):
+// no runs when the stretch is not read or is all covered. browser:
+// `cover_at`, when given, where the cover named was met (CarryUncovered).
+// browser: for an unmoved main axis, with the element in the stretch,
+// only a run it already overlaps; with none, false, the cover named.
+bool CarryStretchClear(LocalFrame& root,
+                       const HeapVector<Member<const LayoutBox>>& chain,
+                       const LayoutObject& object,
+                       const gfx::PointF& aim,
+                       bool main_vertical,
+                       const CarryNeedOf& primary,
+                       const CarryNeedOf& secondary,
+                       float& lo,
+                       float& hi,
+                       bool& read,
+                       String* what,
+                       Vector<std::pair<float, float>>* runs_out = nullptr,
+                       const LayoutObject** pinned_out = nullptr,
+                       std::optional<gfx::PointF>* cover_at = nullptr) {
+  if (runs_out) {
+    runs_out->clear();
+  }
+  if (pinned_out) {
+    *pinned_out = nullptr;
+  }
+  lo = primary.calm_lo;
+  hi = primary.calm_hi;
+  read = !primary.gapped && !chain.empty() &&
+         primary.calm_lo > std::numeric_limits<float>::lowest() &&
+         primary.calm_hi < std::numeric_limits<float>::max();
+  if (!read) {
+    return true;
+  }
+  const float cross_at = std::clamp(main_vertical ? aim.x() : aim.y(),
+                                    secondary.calm_lo, secondary.calm_hi);
+  const LayoutBox& holder =
+      *chain[std::min<wtf_size_t>(primary.holder, chain.size() - 1)];
+  // What is fixed or sticky over the element where it is now: its box, which
+  // stays where it is as the page scrolls.
+  const LayoutObject* pinned = nullptr;
+  String pinned_name;
+  std::optional<gfx::RectF> pinned_box;
+  if (CarryCovered(root, aim, holder, object, &pinned_name, &pinned) &&
+      pinned) {
+    if (LocalFrameView* pinned_view =
+            pinned->GetFrame() ? pinned->GetFrame()->View() : nullptr) {
+      pinned_box = gfx::RectF(
+          pinned_view->ConvertToRootFrame(pinned->AbsoluteBoundingBoxRect()));
+    }
+  }
+  if (pinned_out) {
+    *pinned_out = pinned;
+  }
+  Vector<std::pair<float, float>> runs;
+  // browser: where the first cover was met, for `cover_at`.
+  std::optional<gfx::PointF> met;
+  const bool uncovered = CarryUncovered(
+      root, holder, object, main_vertical, cross_at, primary.rest, lo, hi, what,
+      pinned_box ? &*pinned_box : nullptr, &pinned_name, &runs, &met);
+  if (cover_at) {
+    *cover_at = met;
+  }
+  if (!uncovered) {
+    return false;
+  }
+  if (runs_out) {
+    *runs_out = runs;
+  }
+  // Of the runs, the nearest the scroll left can carry the element into: one
+  // past the end the page is at is none it can be brought to. The nearest
+  // (CarryUncovered's pick) when none can be. browser: one run alone is
+  // weighed too: it is the one taken already, unless an unmoved axis turns it
+  // down.
+  LocalFrameView* element_view = object.GetDocument().View();
+  if (!runs.empty() && element_view) {
+    const gfx::RectF box(
+        element_view->ConvertToRootFrame(object.AbsoluteBoundingBoxRect()));
+    const float b0 = main_vertical ? box.y() : box.x();
+    const float b1 = main_vertical ? box.bottom() : box.right();
+    // browser: nothing moves the element along this axis, and it lies
+    // in the stretch: only a run it already overlaps will do, by StaysPutRoom's
+    // inside test, the nearest its rest. With none, all of it there is
+    // covered, named by what covers its aim (never empty: an empty name reads
+    // as not covered); with nothing over its aim -- a small element between
+    // two samples beside a cover -- it lands at its aim, which is clear.
+    const auto overlaps = [b0, b1](float run_lo, float run_hi) {
+      const float inside = std::min(
+          {4.f, std::max(0.f, b1 - b0), std::max(0.f, run_hi - run_lo)});
+      return std::min(b1, run_hi) - std::max(b0, run_lo) >= inside;
+    };
+    if (primary.unmoved && overlaps(primary.calm_lo, primary.calm_hi)) {
+      bool overlapped = false;
+      float nearest = 0;
+      for (const auto& run : runs) {
+        if (!overlaps(run.first, run.second)) {
+          continue;
+        }
+        const float distance =
+            primary.rest < run.first    ? run.first - primary.rest
+            : primary.rest > run.second ? primary.rest - run.second
+                                        : 0;
+        if (!overlapped || distance < nearest) {
+          overlapped = true;
+          nearest = distance;
+          lo = run.first;
+          hi = run.second;
+        }
+      }
+      if (overlapped) {
+        return true;
+      }
+      if (pinned_name.empty()) {
+        lo = hi = primary.rest;
+        return true;
+      }
+      *what = pinned_name;
+      if (cover_at) {
+        cover_at->reset();
+      }
+      if (runs_out) {
+        runs_out->clear();
+      }
+      return false;
+    }
+    const LayoutObject* pin = PinnedAbove(object);
+    bool found = false;
+    float best = 0;
+    for (const auto& run : runs) {
+      if (!StaysPutRoom(chain, pin, main_vertical, b0, b1, run.first,
+                        run.second)) {
+        continue;
+      }
+      const float distance = primary.rest < run.first ? run.first - primary.rest
+                             : primary.rest > run.second
+                                 ? primary.rest - run.second
+                                 : 0;
+      if (!found || distance < best) {
+        found = true;
+        best = distance;
+        lo = run.first;
+        hi = run.second;
+      }
+    }
+  }
+  return true;
+}
+
+// browser: an uncovered run [lo, hi] (CarryStretchClear) taken as an axis's
+// calm stretch: its rest the point in it nearest `at`. browser: for an
+// unmoved axis, only the stretch the hand lands in: nothing moves the
+// element, so its need and rest stay as CarryNeed left them -- none, and the
+// aim, while the aim shows.
+void TakeUncovered(CarryNeedOf& of, float at, float lo, float hi) {
+  if (!of.unmoved) {
+    of.rest = std::clamp(at, lo, hi);
+    of.need = at - of.rest;
+  }
+  of.calm_lo = lo;
+  of.calm_hi = hi;
+  of.calm_length = hi - lo;
+  of.firm_length = std::min(of.firm_length, hi - lo);
+}
+
+// browser: whether the line across the axis that the stretch along
+// `of` is read on -- `at` (the aim across) clamped into `other`'s calm stretch,
+// as CarryStretchClear reads it -- misses the box that scrolls `of`'s axis (its
+// holder): what it shows, cut by what each box around it shows. A wide box
+// below the fold, or showing only in the window's belt.
+bool OutOfViewAcross(const HeapVector<Member<const LayoutBox>>& chain,
+                     const CarryNeedOf& of,
+                     const CarryNeedOf& other,
+                     float at,
+                     bool vertical) {
+  if (chain.empty()) {
+    return false;
+  }
+  const wtf_size_t holder = std::min<wtf_size_t>(of.holder, chain.size() - 1);
+  const CarryPort own = PortOf(*chain[holder]);
+  if (own.shown.IsEmpty()) {
+    return false;
+  }
+  float lo = vertical ? own.shown.x() : own.shown.y();
+  float hi = vertical ? own.shown.right() : own.shown.bottom();
+  for (wtf_size_t i = holder + 1; i < chain.size(); ++i) {
+    const CarryPort port = PortOf(*chain[i]);
+    if (port.shown.IsEmpty()) {
+      continue;
+    }
+    lo = std::max(lo, vertical ? port.shown.x() : port.shown.y());
+    hi = std::min(hi, vertical ? port.shown.right() : port.shown.bottom());
+  }
+  const float line = std::min(std::max(at, other.calm_lo), other.calm_hi);
+  return hi <= lo || line < lo + 1 || line > hi - 1;
+}
+
+// Where along an axis a hand lands on an element spanning [b0, b1]: the point
+// nearest `aim` in the calm stretch [c0, c1], else in what shows [s0, s1],
+// else the aim; a couple of px in from the element's own edges. `calm` is
+// cleared when it is not in the calm stretch.
+float CarryLandAlong(float aim,
+                     float b0,
+                     float b1,
+                     float c0,
+                     float c1,
+                     float s0,
+                     float s1,
+                     bool* calm) {
+  const float in = std::min(2.f, (b1 - b0) / 4);
+  b0 += in;
+  b1 -= in;
+  if (std::max(b0, c0) <= std::min(b1, c1)) {
+    return std::clamp(aim, std::max(b0, c0), std::min(b1, c1));
+  }
+  *calm = false;
+  // Kept off what shows' own edges: a point snapped onto a box's last pixel
+  // row hits what lies beyond it.
+  if (s1 - s0 > 4) {
+    s0 += 2;
+    s1 -= 2;
+  }
+  if (std::max(b0, s0) <= std::min(b1, s1)) {
+    return std::clamp(aim, std::max(b0, s0), std::min(b1, s1));
+  }
+  return aim;
+}
+
+// browser: whether 24 px of an element spanning [b0, b1] along an axis show,
+// or all of it, with `landed` on that part: a hand scrolls a sliver further in
+// before it clicks it.
+bool LandShows(float b0, float b1, const CarryNeedOf& of, float landed) {
+  if (of.gapped) {
+    return false;
+  }
+  const float lo = std::max(b0, of.shown_lo);
+  const float hi = std::min(b1, of.shown_hi);
+  return hi - lo >= std::min(24.f, b1 - b0) && landed >= lo && landed <= hi;
+}
+
+// browser: Input.scrollBy's terms: the axis a wheel turns along; the
+// way it turns (forward: content up or left, as the wheel turned down or
+// right moves it); whether a frame of another process at the point stands for
+// what holds it; whether a read asks again if the wheel still latches its
+// scroller; and whether a read brings layout clean first.
+enum class WheelAxis { kAcross, kDown };
+enum class WheelWay { kBack, kForward };
+enum class WheelPastFrame { kStop, kPass };
+enum class WheelLatchCheck { kSkip, kCheck };
+enum class WheelLayout { kAsIs, kBringClean };
+
+// browser: what a wheel turned at a root-frame point latches along `axis`, the
+// way asked, as Blink and the compositor latch a wheel: the innermost box
+// under the point with room that way (`can_move` set); else the box where
+// overscroll-behavior other than auto or chain keeps the wheel from going
+// further; else the local root's window. Null when nothing under the point is
+// this frame's own, or when it is a frame of another process and `past` is
+// kStop: the wheel goes to that frame first. With kPass, the frame element
+// stands for what it holds, as the wheel chains out of a frame with nothing
+// left to scroll. That frame's DevTools token goes in `remote_frame`,
+// when given. `pinned`, when given, is set when the point is over something
+// fixed or sticky.
+const LayoutBox* LatchOrStop(LocalFrame& root,
+                             const gfx::PointF& at,
+                             WheelAxis axis,
+                             WheelWay way,
+                             WheelPastFrame past,
+                             bool* pinned,
+                             bool& can_move,
+                             String* remote_frame) {
+  can_move = false;
+  const bool vertical = axis == WheelAxis::kDown;
+  const bool forward = way == WheelWay::kForward;
+  LocalFrameView* view = root.View();
+  if (!view) {
+    return nullptr;
+  }
+  // Only a point in this frame's own view, and not as an active hit test,
+  // which falls back to the document for a point outside it: an iframe's
+  // renderer would take the main page's wheel for its own.
+  const gfx::PointF in_frame = view->ConvertFromRootFrame(at);
+  if (!gfx::RectF(gfx::Rect(view->Size())).Contains(in_frame)) {
+    return nullptr;
+  }
+  HitTestLocation location(in_frame);
+  HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+      location,
+      HitTestRequest::kReadOnly | HitTestRequest::kAllowChildFrameContent);
+  const Node* under = result.InnerNode();
+  while (under && !under->GetLayoutObject()) {
+    under = FlatTreeTraversal::Parent(*under);
+  }
+  if (!under) {
+    return nullptr;
+  }
+  // Over a frame of another process: the wheel goes to that frame first, and
+  // on to this one only once that frame has nothing left to scroll that way,
+  // which this renderer cannot see. No place to judge from, unless
+  // asked past it.
+  if (const auto* owner = DynamicTo<HTMLFrameOwnerElement>(under);
+      owner && IsA<RemoteFrame>(owner->ContentFrame())) {
+    if (remote_frame) {
+      *remote_frame =
+          String(owner->ContentFrame()->GetDevToolsFrameToken().ToString());
+    }
+    if (past == WheelPastFrame::kStop) {
+      return nullptr;
+    }
+  }
+  const LayoutObject* hit_object = under->GetLayoutObject();
+  if (pinned) {
+    for (const LayoutObject* o = hit_object; o; o = o->Parent()) {
+      const EPosition position = o->StyleRef().GetPosition();
+      if (position == EPosition::kFixed || position == EPosition::kSticky) {
+        *pinned = true;
+        break;
+      }
+    }
+  }
+  HeapVector<Member<const LayoutBox>> wheel_chain;
+  if (hit_object->IsBox() && hit_object->IsScrollContainer() &&
+      !hit_object->IsLayoutView()) {
+    wheel_chain.push_back(To<LayoutBox>(hit_object));
+  }
+  CarryChain(*hit_object, wheel_chain);
+  for (const auto& scroller : wheel_chain) {
+    if (CarryCanScroll(*scroller, vertical, forward)) {
+      can_move = true;
+      return scroller.Get();
+    }
+    const EOverscrollBehavior stop =
+        vertical ? scroller->StyleRef().OverscrollBehaviorY()
+                 : scroller->StyleRef().OverscrollBehaviorX();
+    if (stop != EOverscrollBehavior::kAuto &&
+        stop != EOverscrollBehavior::kChain) {
+      return scroller.Get();
+    }
+  }
+  return wheel_chain.empty() ? nullptr : wheel_chain.back().Get();
+}
+
+// browser: what a wheel turned at a root-frame point scrolls along an axis,
+// `forward`: LatchOrStop's box when it has room that way. Null when nothing
+// moves. `pinned`, when given, is set when the point is over something fixed
+// or sticky.
+const LayoutBox* WheelLatch(LocalFrame& root,
+                            const gfx::PointF& at,
+                            bool vertical,
+                            bool forward,
+                            bool* pinned) {
+  bool can_move = false;
+  const LayoutBox* latched = LatchOrStop(
+      root, at, vertical ? WheelAxis::kDown : WheelAxis::kAcross,
+      forward ? WheelWay::kForward : WheelWay::kBack, WheelPastFrame::kStop,
+      pinned, can_move, /*remote_frame=*/nullptr);
+  return can_move ? latched : nullptr;
+}
+
+// browser: the nearest place to `asked` of a grid over `area` (8 columns, 6
+// rows) where `reaches(at, &pinned)` says the wheel latches what it should,
+// over nothing fixed or sticky when any place is; in the local root's frame.
+// Each place lies anywhere in its cell, not its middle: a wheel turned at the
+// same fractions of a box on every visit is a pattern no hand makes. False
+// when none qualifies.
+template <typename Reaches>
+bool NearestWheelPlace(const gfx::RectF& area,
+                       const gfx::PointF& asked,
+                       Reaches reaches,
+                       gfx::PointF& place) {
+  constexpr int kColumns = 8;
+  constexpr int kRows = 6;
+  bool found = false;
+  bool found_pinned = false;
+  float best = 0;
+  for (int row = 0; row < kRows && !area.IsEmpty(); ++row) {
+    for (int column = 0; column < kColumns; ++column) {
+      const float jitter_x =
+          (static_cast<float>(base::RandDouble()) - 0.5f) * 0.6f;
+      const float jitter_y =
+          (static_cast<float>(base::RandDouble()) - 0.5f) * 0.6f;
+      const gfx::PointF at(
+          area.x() + area.width() * (column + 0.5f + jitter_x) / kColumns,
+          area.y() + area.height() * (row + 0.5f + jitter_y) / kRows);
+      bool pinned = false;
+      if (!reaches(at, &pinned)) {
+        continue;
+      }
+      const float distance = (at - asked).Length();
+      if (!found || (found_pinned && !pinned) ||
+          (pinned == found_pinned && distance < best)) {
+        found = true;
+        found_pinned = pinned;
+        best = distance;
+        place = at;
+      }
+    }
+  }
+  return found;
+}
+
+// browser: whether `object` sits in a sticky box held along an axis to
+// `scroller`: that scroller's scroll does not move it there while it is
+// stuck, as a sticky table header at the top of its box.
+bool StuckTo(const LayoutObject& object,
+             const LayoutBox& scroller,
+             bool vertical) {
+  for (const LayoutObject* o = &object; o && o != &scroller; o = o->Parent()) {
+    if (!o->IsStickyPositioned()) {
+      continue;
+    }
+    const ComputedStyle& style = o->StyleRef();
+    const bool held = vertical
+                          ? !style.Top().IsAuto() || !style.Bottom().IsAuto()
+                          : !style.Left().IsAuto() || !style.Right().IsAuto();
+    if (!held || o->ContainingScrollContainer() != &scroller) {
+      continue;
+    }
+    // Stuck now, off where it would lie: at its own place the wheel still
+    // moves it.
+    const PhysicalOffset offset =
+        To<LayoutBoxModelObject>(o)->StickyPositionOffset();
+    if (vertical ? offset.top != LayoutUnit() : offset.left != LayoutUnit()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// browser: a target stuck to the scroller that binds it along an axis has no
+// need there once it shows: turning that scroller leaves it where it is, and
+// a carry would stall on it. Its rest along the axis is then where a hand
+// waits beside it -- in the calm stretch, out of the autoscroll belt it sits
+// in -- and the landing on it, outside that stretch, is a quick one.
+void UnstickNeed(CarryNeedOf& of,
+                 const HeapVector<Member<const LayoutBox>>& chain,
+                 const LayoutObject& object,
+                 bool vertical,
+                 float at) {
+  if (of.gapped || std::abs(of.need) < 0.5f || chain.empty()) {
+    return;
+  }
+  const wtf_size_t binder =
+      std::min<wtf_size_t>(of.movers_to, chain.size() - 1);
+  if (!StuckTo(object, *chain[binder], vertical) || at < of.shown_lo ||
+      at > of.shown_hi) {
+    return;
+  }
+  of.need = 0;
+  of.rest = std::clamp(at, of.calm_lo, of.calm_hi);
+}
+
+// ---------------------------------------------------------------------------
+// browser: Input.performDrag's reads -- DragSurvey, ProbeBands, WheelStation,
+// WatchDrag, DescribePoint, ReadSlot and ValueAtPoint. Read-only: nothing
+// here scrolls, dispatches an event or runs script. A hit test brings the
+// lifecycle up to date before it tests, as HitCheck's does.
+
+// How many band boxes and fixed boxes a survey lists, points ProbeBands
+// takes, boxes a watch reads, and paint layers a survey walks per frame
+// looking for fixed boxes.
+constexpr wtf_size_t kSurveyBands = 128;
+constexpr wtf_size_t kSurveyFixed = 64;
+constexpr wtf_size_t kProbePoints = 64;
+constexpr wtf_size_t kWatchBoxes = 128;
+constexpr int kFixedLayerBudget = 4000;
+// Layout objects looked at inside a fixed wrapper a hit test passes through.
+constexpr int kFixedWrapperBudget = 256;
+// How far in from a box's edges a pointer library scrolls it: SortableJS's
+// 30 px, react-beautiful-dnd's 25 % of what shows (dnd-kit's 20 % within it).
+constexpr float kLibraryBelt = 30.f;
+constexpr float kLibraryShare = 0.25f;
+
+mojom::blink::AgentElementBoxPtr BoxOf(const gfx::RectF& rect) {
+  return mojom::blink::AgentElementBox::New(rect.x(), rect.y(), rect.width(),
+                                            rect.height());
+}
+
+gfx::RectF RectOf(const mojom::blink::AgentElementBox& box) {
+  return gfx::RectF(box.x, box.y, box.width, box.height);
+}
+
+// Whether a point (DIPs) in a band box's visible part is in the zone a
+// pointer library scrolls the box from, as the route's pointer BandAt judges
+// it: beyond lib_inner on a side the box can still scroll toward -- a library
+// scrolls a box only toward room (dnd-kit tests !isTop and the like) -- or,
+// for the binder, the box the wheel will scroll, beyond it at either end of
+// an axis it can scroll on, since its other end comes alive as it moves.
+bool InLibraryZone(const mojom::blink::AgentBandBox& band,
+                   const gfx::PointF& p,
+                   bool binder) {
+  const gfx::RectF zone = RectOf(*band.lib_inner);
+  const bool above = p.y() < zone.y();
+  const bool below = p.y() >= zone.bottom();
+  const bool before = p.x() < zone.x();
+  const bool after = p.x() >= zone.right();
+  if (binder) {
+    return ((band.up || band.down) && (above || below)) ||
+           ((band.left || band.right) && (before || after));
+  }
+  return (band.up && above) || (band.down && below) || (band.left && before) ||
+         (band.right && after);
+}
+
+// The local root's frame (Blink space) to its widget's DIPs and back, as
+// HitCheck's point conversion does it.
+class RootDips {
+  STACK_ALLOCATED();
+
+ public:
+  RootDips(LocalFrameView& view, WebFrameWidgetImpl& widget)
+      : view_(view), widget_(widget) {}
+
+  gfx::PointF Dips(const gfx::PointF& at) const {
+    return widget_
+        .BlinkSpaceToDIPs(gfx::RectF(view_.FrameToViewport(at), gfx::SizeF()))
+        .origin();
+  }
+  gfx::RectF Rect(const gfx::RectF& rect) const {
+    const gfx::PointF from = Dips(rect.origin());
+    const gfx::PointF to = Dips(rect.bottom_right());
+    return gfx::RectF(from.x(), from.y(), to.x() - from.x(), to.y() - from.y());
+  }
+  mojom::blink::AgentElementBoxPtr Box(const gfx::RectF& rect) const {
+    return BoxOf(Rect(rect));
+  }
+  // A point in the widget, in DIPs, in the local root's frame.
+  gfx::PointF Root(double x, double y) const {
+    return view_.ViewportToFrame(widget_.DIPsToBlinkSpace(gfx::PointF(x, y)));
+  }
+
+ private:
+  LocalFrameView& view_;
+  WebFrameWidgetImpl& widget_;
+};
+
+// A rect in an object's frame's absolute space, in the local root's frame.
+gfx::RectF RootRectOf(const LayoutObject& object, const gfx::RectF& absolute) {
+  LocalFrameView* view =
+      object.GetFrame() ? object.GetFrame()->View() : nullptr;
+  if (!view) {
+    return absolute;
+  }
+  const gfx::PointF from = view->ConvertToRootFrame(absolute.origin());
+  const gfx::PointF to = view->ConvertToRootFrame(absolute.bottom_right());
+  return gfx::RectF(from.x(), from.y(), to.x() - from.x(), to.y() - from.y());
+}
+
+// The element a drag's events go to for what a hit test reached
+// (EventHandler::UpdateDragAndDrop): a pseudo-element without activation
+// behaviour stands for its originating element, anything in a user-agent
+// shadow tree for its host.
+Element* DragTargetOf(Element* hit) {
+  if (auto* pseudo = DynamicTo<PseudoElement>(hit);
+      pseudo && !pseudo->HasActivationBehavior()) {
+    hit = &pseudo->UltimateOriginatingElement();
+  }
+  ShadowRoot* shadow = hit ? hit->ContainingShadowRoot() : nullptr;
+  while (shadow && shadow->IsUserAgent()) {
+    hit = &shadow->host();
+    shadow = hit->ContainingShadowRoot();
+  }
+  return hit;
+}
+
+// One step up the layout tree, from a document's view on to its frame's owner
+// in the frame around it, as LayoutBox::FindAutoscrollable walks.
+LayoutObject* UpAcrossFrames(const LayoutObject& object) {
+  if (LayoutObject* parent = object.Parent()) {
+    return parent;
+  }
+  if (object.GetNode() != &object.GetDocument()) {
+    return nullptr;
+  }
+  HTMLFrameOwnerElement* owner = object.GetDocument().LocalOwner();
+  return owner ? owner->GetLayoutObject() : nullptr;
+}
+
+// The DOMNodeId a band box or a fixed box goes by: its element's, or for a
+// frame's view its document's. An anonymous box goes by the nearest node
+// around it, never 0: a fieldset's anonymous content box, which scrolls for
+// it, by the fieldset, through which a watch reads it again
+// (GetLayoutBoxForScrolling); another anonymous scroller may share its id
+// with a band box around it.
+int32_t NodeIdOf(const LayoutObject& object) {
+  for (const LayoutObject* o = &object; o; o = UpAcrossFrames(*o)) {
+    if (Node* node = o->GetNode()) {
+      return static_cast<int32_t>(DOMNodeIds::IdForNode(node));
+    }
+  }
+  return 0;
+}
+
+// "div#L"; "the page" for the main document's view, "the frame" for another.
+String BandName(const LayoutBox& box) {
+  if (box.IsLayoutView()) {
+    const LocalFrame* frame = box.GetFrame();
+    return frame && frame->IsOutermostMainFrame() ? "the page" : "the frame";
+  }
+  if (auto* element = DynamicTo<Element>(box.GetNode())) {
+    return DescribeHit(*element);
+  }
+  return "a box";
+}
+
+// The nearest band box holding `box`: where Blink's walk for the band under
+// the pointer goes on to once past it. None for a fixed-to-view box, which
+// the walk never leaves, nor for one inside such a box.
+const LayoutBox* BandParent(const LayoutBox& box) {
+  if (box.IsFixedToView()) {
+    return nullptr;
+  }
+  LayoutObject* up = UpAcrossFrames(box);
+  return up ? LayoutBox::FindAutoscrollable(
+                  up, /*is_middle_click_autoscroll=*/false)
+            : nullptr;
+}
+
+// The fixed-to-view box an object lies inside, itself included: a band box
+// that is fixed itself (a modal with overflow: auto) names its own id.
+const LayoutBox* FixedHolder(const LayoutObject& object) {
+  for (const LayoutObject* o = &object; o; o = UpAcrossFrames(*o)) {
+    const auto* box = DynamicTo<LayoutBox>(o);
+    if (box && box->IsFixedToView()) {
+      return box;
+    }
+  }
+  return nullptr;
+}
+
+// Whether `inner` is `outer` or lies inside it, across same-process frames.
+bool InsideObject(const LayoutObject& inner, const LayoutObject& outer) {
+  for (const LayoutObject* o = &inner; o; o = UpAcrossFrames(*o)) {
+    if (o == &outer) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The border box a band box's band lies in, scrollbars included, in the local
+// root's frame: for a frame's view, its whole viewport.
+gfx::RectF BorderOf(const LayoutBox& box, const CarryPort& port) {
+  LocalFrameView* view = box.GetFrame() ? box.GetFrame()->View() : nullptr;
+  PaintLayerScrollableArea* area = box.GetScrollableArea();
+  if (!box.IsLayoutView() || !view || !area) {
+    return port.border;
+  }
+  return gfx::RectF(view->ConvertToRootFrame(
+      gfx::Rect(area->VisibleContentRect(kIncludeScrollbars).size())));
+}
+
+// The local root's viewport less its scrollbars, in its frame.
+gfx::RectF ViewportRect(const LocalFrameView& view) {
+  if (PaintLayerScrollableArea* area = view.LayoutViewport()) {
+    return gfx::RectF(
+        gfx::Rect(area->VisibleContentRect(kExcludeScrollbars).size()));
+  }
+  return gfx::RectF(gfx::Rect(view.Size()));
+}
+
+// What shows of a box: `border` clipped by every box around it and by the
+// viewport, in the local root's frame; empty when none of it shows. Blink's
+// own visual-rect mapping when this local root is the page's main frame;
+// under another process's frame that mapping goes on into the main frame's
+// space, so there the scrollers that hold the box clip it instead, and then
+// the part of the frame the page shows.
+gfx::RectF VisibleInRoot(const LayoutBox& box,
+                         const LocalFrame& root,
+                         const gfx::RectF& border) {
+  LocalFrameView* view = box.GetFrame() ? box.GetFrame()->View() : nullptr;
+  if (!view) {
+    return gfx::RectF();
+  }
+  gfx::RectF visible = border;
+  if (root.IsOutermostMainFrame()) {
+    PhysicalRect rect =
+        box.IsLayoutView()
+            ? PhysicalRect(PhysicalOffset(), PhysicalSize(view->Size()))
+            : box.PhysicalBorderBoxRect();
+    if (!box.MapToVisualRectInAncestorSpace(nullptr, rect)) {
+      return gfx::RectF();
+    }
+    visible.Intersect(gfx::RectF(rect));
+    return visible;
+  }
+  const LayoutObject* from = &box;
+  if (box.IsLayoutView()) {
+    from = view->GetFrame().OwnerLayoutObject();
+  }
+  if (from) {
+    HeapVector<Member<const LayoutBox>> chain;
+    CarryChain(*from, chain);
+    for (const auto& holder : chain) {
+      visible.Intersect(PortOf(*holder).shown);
+    }
+  }
+  // What the page shows of this frame: clipped by every frame and scroller
+  // around it and by the page's viewport, in this local root's frame (Blink
+  // space), as the parent last sent it.
+  if (root.IsLocalRoot()) {
+    visible.Intersect(gfx::RectF(root.RemoteViewportIntersection()));
+  }
+  return visible;
+}
+
+// A blocking wheel listener on the box's node or above it, on its document or
+// on its window: the main thread then takes the wheel, and while a native
+// drag is held it drops it. Best effort: listeners in the frames around the
+// box's are not counted.
+bool WheelBlocked(const LayoutBox& box) {
+  LocalFrame* frame = box.GetFrame();
+  const EventTargetSet* blocking =
+      frame ? frame->GetEventHandlerRegistry().EventHandlerTargets(
+                  EventHandlerRegistry::kWheelEventBlocking)
+            : nullptr;
+  if (!blocking) {
+    return false;
+  }
+  if (EventTarget* window = frame->DomWindow();
+      window && blocking->Contains(window)) {
+    return true;
+  }
+  for (Node* node = box.GetNode(); node;
+       node = node->ParentOrShadowHostNode()) {
+    if (blocking->Contains(node)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// What a band box's entry needs before anything of it is named: its port,
+// its border and what shows of it, in the local root's frame.
+struct BandShape {
+  CarryPort port;
+  gfx::RectF border;
+  gfx::RectF visible;
+};
+
+// False when none of the box shows.
+bool ShapeOf(const LayoutBox& box, const LocalFrame& root, BandShape& shape) {
+  shape.port = PortOf(box);
+  if (shape.port.outer.IsEmpty()) {
+    return false;
+  }
+  shape.border = BorderOf(box, shape.port);
+  shape.visible = VisibleInRoot(box, root, shape.border);
+  return !shape.visible.IsEmpty();
+}
+
+// A band box as the survey reports it.
+mojom::blink::AgentBandBoxPtr BandOf(const LayoutBox& box,
+                                     const BandShape& shape,
+                                     const RootDips& dips) {
+  auto band = mojom::blink::AgentBandBox::New();
+  band->id = NodeIdOf(box);
+  const LayoutBox* parent = BandParent(box);
+  band->parent = parent ? NodeIdOf(*parent) : 0;
+  const LayoutBox* fixed = FixedHolder(box);
+  band->fixed = fixed ? NodeIdOf(*fixed) : 0;
+  band->name = NonNull(BandName(box));
+  band->is_document = box.IsLayoutView();
+  band->border = dips.Box(shape.border);
+  band->outer = dips.Box(shape.port.outer);
+  // Blink's belt: 20 root-frame layout units (physical px) in from the edges
+  // less the scrollbars, whatever the device scale factor.
+  gfx::RectF inner = shape.port.outer;
+  inner.Inset(gfx::InsetsF(kCarryBelt));
+  band->inner = dips.Box(inner);
+  const gfx::RectF shown = dips.Rect(shape.visible);
+  band->visible = BoxOf(shown);
+  gfx::RectF library = dips.Rect(shape.port.outer);
+  library.Inset(
+      gfx::InsetsF::VH(std::max(kLibraryBelt, shown.height() * kLibraryShare),
+                       std::max(kLibraryBelt, shown.width() * kLibraryShare)));
+  band->lib_inner = BoxOf(library);
+  band->up = CarryCanScroll(box, /*vertical=*/true, /*forward=*/false);
+  band->down = CarryCanScroll(box, /*vertical=*/true, /*forward=*/true);
+  band->left = CarryCanScroll(box, /*vertical=*/false, /*forward=*/false);
+  band->right = CarryCanScroll(box, /*vertical=*/false, /*forward=*/true);
+  band->wheel_blocked = WheelBlocked(box);
+  if (PaintLayerScrollableArea* area = box.GetScrollableArea()) {
+    const float zoom = box.StyleRef().EffectiveZoom();
+    band->scroll_x = area->GetScrollOffset().x() / zoom;
+    band->scroll_y = area->GetScrollOffset().y() / zoom;
+  }
+  return band;
+}
+
+// The survey's terrain: the band boxes that show, largest first, and the
+// fixed-to-view boxes that show, with the latter's layout objects.
+struct Terrain {
+  STACK_ALLOCATED();
+
+ public:
+  Vector<mojom::blink::AgentBandBoxPtr> bands;
+  Vector<mojom::blink::AgentFixedBoxPtr> fixed;
+  HeapVector<Member<const LayoutBox>> fixed_objects;
+};
+
+// Whether a hit test can land on an object: pointer events not none (inert
+// included) and visible.
+bool Hittable(const LayoutObject& object) {
+  const ComputedStyle& style = object.StyleRef();
+  return style.UsedPointerEvents() != EPointerEvents::kNone &&
+         style.Visibility() == EVisibility::kVisible;
+}
+
+// Lists what shows of `shown` as a fixed box under `holder`'s id: the
+// fixed-to-view box a band walk from it meets.
+void AddFixed(const LayoutBox& shown,
+              const LayoutBox& holder,
+              const LocalFrame& root,
+              const RootDips& dips,
+              Terrain& out) {
+  const gfx::RectF visible = VisibleInRoot(
+      shown, root, RootRectOf(shown, shown.AbsoluteBoundingBoxRectF()));
+  if (visible.IsEmpty()) {
+    return;
+  }
+  out.fixed.push_back(mojom::blink::AgentFixedBox::New(
+      NodeIdOf(holder), NonNull(BandName(shown)), dips.Box(visible)));
+  out.fixed_objects.push_back(&holder);
+}
+
+// Every box a held drag's autoscroll can pick in this local root and its
+// same-process frames that are not throttled: the user-scrollable ones among
+// each frame's scrollable areas, and each frame's view when it can scroll;
+// and every fixed-to-view box, found on the paint layers (each has one).
+// Geometry only, on layout as it is.
+void CollectTerrain(LocalFrame& root, const RootDips& dips, Terrain& out) {
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(&root, frames);
+  HeapVector<Member<const LayoutBox>> boxes;
+  HeapVector<Member<const LayoutBox>> fixed;
+  for (LocalFrame* frame : frames) {
+    LocalFrameView* view = frame->View();
+    LayoutView* layout_view = frame->ContentLayoutObject();
+    if (!view || !layout_view || view->ShouldThrottleRendering() ||
+        frame->GetDocument()->Lifecycle().GetState() <
+            DocumentLifecycle::kLayoutClean) {
+      continue;
+    }
+    if (layout_view->IsUserScrollable()) {
+      boxes.push_back(layout_view);
+    }
+    for (const auto& entry : view->ScrollableAreas()) {
+      const LayoutBox* box = entry.value->GetLayoutBox();
+      if (box && !box->IsLayoutView() && box->IsUserScrollable()) {
+        boxes.push_back(box);
+      }
+    }
+    HeapVector<Member<PaintLayer>> layers;
+    if (PaintLayer* layer = layout_view->Layer()) {
+      layers.push_back(layer);
+    }
+    for (int budget = kFixedLayerBudget; !layers.empty() && budget > 0;
+         --budget) {
+      PaintLayer* layer = layers.back();
+      layers.pop_back();
+      for (PaintLayer* child = layer->FirstChild(); child;
+           child = child->NextSibling()) {
+        layers.push_back(child);
+      }
+      const auto* box = DynamicTo<LayoutBox>(&layer->GetLayoutObject());
+      if (box && box->IsFixedToView()) {
+        fixed.push_back(box);
+      }
+    }
+  }
+
+  // What shows of each first; then the largest first -- every one listed
+  // shows, so all are as near the viewport, and a box comes before the ones
+  // inside it -- and only those kept are named and read further.
+  HeapVector<Member<const LayoutBox>> shown;
+  Vector<BandShape> shapes;
+  for (const auto& box : boxes) {
+    BandShape shape;
+    if (ShapeOf(*box, root, shape)) {
+      shown.push_back(box);
+      shapes.push_back(shape);
+    }
+  }
+  Vector<wtf_size_t> order;
+  for (wtf_size_t i = 0; i < shapes.size(); ++i) {
+    order.push_back(i);
+  }
+  std::stable_sort(
+      order.begin(), order.end(), [&shapes](wtf_size_t a, wtf_size_t b) {
+        return shapes[a].visible.width() * shapes[a].visible.height() >
+               shapes[b].visible.width() * shapes[b].visible.height();
+      });
+  for (wtf_size_t i = 0; i < order.size() && i < kSurveyBands; ++i) {
+    out.bands.push_back(BandOf(*shown[order[i]], shapes[order[i]], dips));
+  }
+
+  for (const auto& box : fixed) {
+    if (out.fixed.size() >= kSurveyFixed) {
+      break;
+    }
+    const LayoutBox* wrapper = box.Get();
+    if (Hittable(*wrapper)) {
+      AddFixed(*wrapper, *wrapper, root, dips, out);
+      continue;
+    }
+    // A wrapper a hit test passes through (pointer-events: none, inert, not
+    // visible) shields nothing where it is bare: listed whole it would read
+    // calm where Blink autoscrolls. But Blink's walk from a box inside it
+    // that a hit test does land in (a toast, a cookie bar) still meets it and
+    // stops, so each such box shields, under the wrapper's id. Nothing below
+    // such a box is looked at, nor inside a fixed box of its own (listed
+    // itself).
+    int budget = kFixedWrapperBudget;
+    for (const LayoutObject* o = wrapper->NextInPreOrder(wrapper);
+         o && budget-- > 0 && out.fixed.size() < kSurveyFixed;) {
+      const auto* inner = DynamicTo<LayoutBox>(o);
+      if (inner && inner->IsFixedToView()) {
+        o = o->NextInPreOrderAfterChildren(wrapper);
+      } else if (inner && Hittable(*inner)) {
+        AddFixed(*inner, *wrapper, root, dips, out);
+        o = o->NextInPreOrderAfterChildren(wrapper);
+      } else {
+        o = o->NextInPreOrder(wrapper);
+      }
+    }
+  }
+}
+
+// Blink's own band answer at a point in the local root's frame: the box a
+// held drag's autoscroll picks there (its DOMNodeId, 0 none) and the side of
+// it whose band the point is in (0 none, 1 top, 2 bottom, 3 left, 4 right; a
+// corner counts as its vertical side).
+struct BandProbe {
+  int32_t box = 0;
+  int32_t side = 0;
+};
+
+int32_t SideOf(const PhysicalOffset& offset) {
+  if (offset.top < LayoutUnit()) {
+    return 1;
+  }
+  if (offset.top > LayoutUnit()) {
+    return 2;
+  }
+  if (offset.left < LayoutUnit()) {
+    return 3;
+  }
+  return offset.left > LayoutUnit() ? 4 : 0;
+}
+
+// As a dragover finds it: the read-only hit test EventHandler::
+// UpdateDragAndDrop runs (each frame's own, not into child frames), the
+// element it reaches, LayoutBox::FindAutoscrollable from there and
+// LayoutBox::CalculateAutoscrollDirection. Over a same-process frame the
+// frame around it is judged first and its band wins, as the page's single
+// AutoscrollController takes the first box it is given; then inside it.
+// Outside the view, none.
+BandProbe ProbeAt(LocalFrame& root, const gfx::PointF& at) {
+  BandProbe probe;
+  LocalFrame* frame = &root;
+  for (int depth = 0; frame && depth < 8; ++depth) {
+    probe = BandProbe();
+    LocalFrameView* view = frame->View();
+    LayoutView* layout_view = frame->ContentLayoutObject();
+    if (!view || !layout_view || !view->DidFirstLayout()) {
+      break;
+    }
+    const gfx::PointF in_frame = view->ConvertFromRootFrame(at);
+    if (depth == 0 && !gfx::RectF(gfx::Rect(view->Size())).Contains(in_frame)) {
+      break;
+    }
+    // Rounded to layout units as ContentPointFromRootFrame rounds a
+    // dragover's point.
+    HitTestLocation location(PhysicalOffset::FromPointFRound(in_frame));
+    const HitTestRequest request(HitTestRequest::kReadOnly);
+    HitTestResult result(request, location);
+    layout_view->HitTest(location, result);
+    Element* target = DragTargetOf(result.InnerElement());
+    LayoutObject* object = target ? target->GetLayoutObject() : nullptr;
+    if (!object) {
+      break;
+    }
+    if (LayoutBox* box = LayoutBox::FindAutoscrollable(
+            object, /*is_middle_click_autoscroll=*/false)) {
+      probe.box = NodeIdOf(*box);
+      probe.side = SideOf(box->CalculateAutoscrollDirection(at));
+      if (probe.side) {
+        break;
+      }
+    }
+    auto* owner = DynamicTo<HTMLFrameOwnerElement>(target);
+    frame = owner ? DynamicTo<LocalFrame>(owner->ContentFrame()) : nullptr;
+  }
+  return probe;
+}
+
+// Roles of a part of an element that a press acts on instead of the element:
+// controls, not what holds them (a list, a menu, a grid's cells).
+bool IsControlRole(const String& role) {
+  static constexpr const char* kRoles[] = {
+      "button",        "link",    "checkbox",  "radio",
+      "switch",        "tab",     "menuitem",  "menuitemcheckbox",
+      "menuitemradio", "option",  "treeitem",  "slider",
+      "spinbutton",    "textbox", "searchbox", "combobox"};
+  return RoleIn(role, kRoles);
+}
+
+// Roles of an element that is itself a field: pressed on its own input or
+// editable region, which is then no part acting on its own.
+bool IsFieldRole(const String& role) {
+  static constexpr const char* kRoles[] = {
+      "combobox", "checkbox",  "radio",      "switch",
+      "textbox",  "searchbox", "spinbutton", "slider"};
+  return RoleIn(role, kRoles);
+}
+
+// The first token of an element's role attribute, lower-cased; empty for
+// none.
+String FirstRole(const Element& element) {
+  const AtomicString& role = element.FastGetAttribute(html_names::kRoleAttr);
+  if (role.empty()) {
+    return String();
+  }
+  const Vector<String> tokens =
+      role.GetString().SimplifyWhiteSpace().ToAsciiLower().Split(' ');
+  return tokens.empty() ? String() : tokens[0];
+}
+
+// What a field is typed or set in: an input other than a button, a
+// textarea, a select, an editable region.
+bool IsEntryControl(Element& part) {
+  if (auto* input = DynamicTo<HTMLInputElement>(part)) {
+    return !input->IsTextButton();
+  }
+  return IsA<HTMLTextAreaElement>(part) || IsA<HTMLSelectElement>(part) ||
+         IsEditingHost(&part);
+}
+
+// Whether `part`, inside `element`, is a control of its own that a press on
+// it acts on instead of `element`: a link, a button or other form
+// control, a summary, an editable region, a frame or plugin, a media element
+// showing its controls, a form-associated custom element, a control's role, a
+// click or press listener of its own. Not:
+// - a label's own control, nor a label of `element`: pressing either acts on
+//   the same thing; nor a <details>'s own main summary;
+// - the entry control of an element that is itself a field (a combobox's own
+//   input: its clear button is a part of its own), nor a <select>'s own parts;
+// - a link in an editable region, which does not follow (a button there
+//   still acts);
+// - a tab stop alone (a <video> is one, and a grid's roving cell), nor a
+//   pointer cursor, which a card's children inherit.
+bool ActsOnItsOwn(Element& part, Element& element) {
+  if (auto* label = DynamicTo<HTMLLabelElement>(element);
+      label && label->Control() == &part) {
+    return false;
+  }
+  if (auto* summary = DynamicTo<HTMLSummaryElement>(part);
+      summary && summary->IsMainSummary() && part.parentElement() == &element) {
+    return false;
+  }
+  if (IsA<HTMLSelectElement>(element) ||
+      (IsFieldRole(FirstRole(element)) && IsEntryControl(part))) {
+    return false;
+  }
+  if (auto* label = DynamicTo<HTMLLabelElement>(part)) {
+    HTMLElement* control = label->Control();
+    return control && control != &element;
+  }
+  if (part.IsLink()) {
+    return !IsEditable(part);
+  }
+  if (part.IsFormControlElement()) {
+    return !part.HasTagName(html_names::kFieldsetTag) &&
+           !part.HasTagName(html_names::kOutputTag);
+  }
+  if (part.HasTagName(html_names::kSummaryTag) || IsEditingHost(&part) ||
+      IsA<HTMLFrameOwnerElement>(part)) {
+    return true;
+  }
+  if ((part.HasTagName(html_names::kVideoTag) ||
+       part.HasTagName(html_names::kAudioTag)) &&
+      part.FastHasAttribute(html_names::kControlsAttr)) {
+    return true;
+  }
+  if (auto* html = DynamicTo<HTMLElement>(part);
+      html && html->IsFormAssociatedCustomElement()) {
+    return true;
+  }
+  return IsControlRole(FirstRole(part)) ||
+         part.HasEventListeners(event_type_names::kClick) ||
+         part.HasEventListeners(event_type_names::kMouseup) ||
+         HasPressListener(&part);
+}
+
+// The parts of an element a press acts on instead of it: this many rects as
+// they are, the rest as one more; found among at most this many of its
+// elements.
+constexpr wtf_size_t kMaxHoles = 8;
+constexpr int kHoleScan = 2000;
+
+// Whether `hit` is in a document `element` holds, in this process: its
+// document's owner -- or that one's, and on up -- is the element. A press on a
+// frame element lands in what it holds.
+bool InFrameOf(const Element& hit, const Element& element) {
+  for (const HTMLFrameOwnerElement* owner = hit.GetDocument().LocalOwner();
+       owner; owner = owner->GetDocument().LocalOwner()) {
+    if (owner == &element) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Defined below.
+bool HoldsAcross(const Element& holder, const Element& element);
+bool LayerRoleIs(const Element& element, const char* role);
+
+// browser: the element whose own style is inert: `element`, or else
+// the nearest frame element above it in this process that is -- a frame its
+// owner shuts out takes no press, though nothing in it is inert by its own
+// style (LocalFrame::IsInert); null when neither is.
+Element* InertHolder(Element& element) {
+  for (Element* up = &element; up; up = up->GetDocument().LocalOwner()) {
+    const ComputedStyle* style = up->GetComputedStyle();
+    if (style && style->IsInert()) {
+      return up;
+    }
+  }
+  return nullptr;
+}
+
+// browser: what shuts out the rest of `document`, as ApplyInertness
+// takes it: its open modal dialog, else an element it shows full screen --
+// with its kind in `kind`, as the layer stack's (dialog, alert or
+// fullscreen); null when neither is open.
+Element* ModalOf(Document& document, const char** kind) {
+  if (Element* dialog = document.ActiveModalDialog()) {
+    *kind = LayerRoleIs(*dialog, "alertdialog") ? "alert" : "dialog";
+    return dialog;
+  }
+  *kind = "fullscreen";
+  return Fullscreen::FullscreenElementFrom(document);
+}
+
+// browser: what switched off an inert `element`, for a refusal to say
+// rather than guess, as Blink's ApplyInertness inerts its holder
+// (InertHolder): a modal dialog open outside it -- else an element shown full
+// screen outside it -- named as its layer is (dialog "Choose a plan"), its
+// kind in `kind` (dialog, alert or fullscreen, as the layer stack's); else
+// the nearest element whose inert attribute holds it (div#main) -- for a
+// frame, the frame element itself counts -- with no kind. Said with where it
+// is (CoverWhere). Empty when none of those is the cause: the attribute on
+// `element` itself, CSS interactivity: inert, or a transition to display:
+// none; an inert attribute above a modal or full-screen element holding it
+// is not one, since that element escapes it.
+String InertCause(Element& element, String& kind) {
+  kind = g_empty_string;
+  Element* holder = InertHolder(element);
+  if (!holder) {
+    return g_empty_string;
+  }
+  const char* modal_kind = nullptr;
+  Element* modal = ModalOf(holder->GetDocument(), &modal_kind);
+  if (modal && !HoldsAcross(*modal, *holder)) {
+    kind = String(modal_kind);
+    return CoverWhere(*modal, element, CoverLayerName(*modal, modal_kind));
+  }
+  // `modal`, here, holds it: the walk stops there.
+  for (Element* up = holder == &element
+                         ? FlatTreeTraversal::ParentElement(*holder)
+                         : holder;
+       up; up = FlatTreeTraversal::ParentElement(*up)) {
+    if (up->IsHTMLElement() && up->FastHasAttribute(html_names::kInertAttr)) {
+      return CoverWhere(*up, element, DescribeHit(*up));
+    }
+    if (up == modal) {
+      break;
+    }
+  }
+  return g_empty_string;
+}
+
+// browser: the open modal dialog or full-screen element that shuts out
+// `element` -- what InertCause names as its cause -- or null when none does:
+// inert by an attribute, not inert, or holding the modal itself (a wrapper
+// around the dialog is inert, but nothing of it is behind the dialog).
+Element* InertModal(Element& element) {
+  Element* holder = InertHolder(element);
+  if (!holder) {
+    return nullptr;
+  }
+  const char* kind = nullptr;
+  Element* modal = ModalOf(holder->GetDocument(), &kind);
+  if (!modal || HoldsAcross(*modal, *holder) || element.contains(modal) ||
+      HoldsAcross(element, *modal)) {
+    return nullptr;
+  }
+  // browser: inert by an attribute as well -- its own or an
+  // ancestor's, out through the frames holding it -- it stays switched off
+  // when the modal closes, so it is not behind the modal alone.
+  for (Element* in = &element; in; in = in->GetDocument().LocalOwner()) {
+    for (Element* up = in; up; up = FlatTreeTraversal::ParentElement(*up)) {
+      if (up->IsHTMLElement() && up->FastHasAttribute(html_names::kInertAttr)) {
+        return nullptr;
+      }
+    }
+  }
+  return modal;
+}
+
+// browser: a name for a control a modal shuts out, which the
+// accessibility tree leaves unnamed: its aria-label, its first label's text,
+// its title; else a text button's label (its value), or -- a button or a
+// link, by tag or role, named by what it shows as the tree names one -- its
+// own text. Never from a text field, a select or an editor: SourceText leaves
+// a field's and an editor's text out by their attributes, which an inert one
+// keeps, where Blink calls nothing inert editable.
+String ShutOutName(Element& element, const String& role) {
+  if (String name =
+          CleanName(element.FastGetAttribute(html_names::kAriaLabelAttr));
+      !name.empty()) {
+    return Capped(name);
+  }
+  if (auto* html = DynamicTo<HTMLElement>(element);
+      html && html->IsLabelable()) {
+    LabelsNodeList* labels = html->labels();
+    if (Element* label = labels ? labels->item(0) : nullptr) {
+      if (String name = CleanName(SourceText(*label)); !name.empty()) {
+        return Capped(name);
+      }
+    }
+  }
+  if (String name = CleanName(element.FastGetAttribute(html_names::kTitleAttr));
+      !name.empty()) {
+    return Capped(name);
+  }
+  if (IsTextEntry(&element, role) || IsA<HTMLSelectElement>(element)) {
+    return String();
+  }
+  if (auto* input = DynamicTo<HTMLInputElement>(element);
+      input && input->IsTextButton()) {
+    return Capped(CleanName(input->Value()));
+  }
+  bool by_contents =
+      element.HasTagName(html_names::kButtonTag) || element.IsLink();
+  for (const char* named_by_contents :
+       {"button", "link", "menuitem", "tab", "option", "checkbox", "radio",
+        "switch", "treeitem"}) {
+    by_contents = by_contents || LayerRoleIs(element, named_by_contents);
+  }
+  return by_contents ? Capped(CleanName(SourceText(element))) : String();
+}
+
+// browser: an editor an open modal shuts out, which Blink calls no
+// editing host (nothing inert is editable): taken by its contenteditable
+// attribute, as agent_live_regions' IsField takes one.
+bool ShutOutEditor(Element& element) {
+  if (element.IsFormControlElement() || !EditableByAttribute(element)) {
+    return false;
+  }
+  return InertModal(element) != nullptr;
+}
+
+// Whether a mouse press at (x, y), a point in the local root's widget in
+// DIPs, would reach `element`, decided by the hit test a real press runs:
+// HitCheck's verdict, with what the press reaches instead in `hit` (empty when
+// there is nothing to name). browser: `hit_kind`, when asked, the kind
+// of the open layer `hit` names (CoverFrom); empty when it names a hit itself.
+// browser: with `name_inert`, an inert element's `hit` and `hit_kind`
+// are what switched it off (InertCause).
+String PressVerdict(LocalFrame* root,
+                    Element* element,
+                    double x,
+                    double y,
+                    String& hit,
+                    String* hit_kind = nullptr,
+                    bool name_inert = false) {
+  hit = g_empty_string;
+  if (hit_kind) {
+    *hit_kind = g_empty_string;
+  }
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  if (!element || !widget) {
+    return "gone";
+  }
+
+  // The hit test a press runs: the point taken into the local root's frame as
+  // CoreHitTestResultAt takes it, then tested read-only -- so :hover and
+  // :active stay as they are -- and into same-process child frames, as a
+  // press reaches them. It brings layout up to date first, which can run
+  // script.
+  LocalFrameView* view = root->View();
+  if (!view) {
+    return "gone";
+  }
+  const gfx::PointF root_frame_point =
+      view->ViewportToFrame(widget->DIPsToBlinkSpace(gfx::PointF(x, y)));
+  HitTestLocation location(view->ConvertFromRootFrame(root_frame_point));
+  HitTestResult result = root->GetEventHandler().HitTestResultAtLocation(
+      location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                    HitTestRequest::kAllowChildFrameContent);
+  if (!element->isConnected()) {
+    return "gone";
+  }
+
+  // A disabled form control cuts a trusted press's event path at itself, so
+  // nothing at or inside it answers.
+  for (const Node* node = element; node;
+       node = FlatTreeTraversal::Parent(*node)) {
+    if (IsDisabledFormControl(node)) {
+      return "disabled";
+    }
+  }
+
+  Element* reached = result.InnerElement();
+  if (result.GetScrollbar()) {
+    hit = "a scrollbar";
+    return "covered";
+  }
+  // The element or anything in its flat tree: what the click event's own
+  // target rule (ParentForClickEvent) counts as inside it, closed shadow
+  // roots included.
+  if (reached && (reached == element ||
+                  FlatTreeTraversal::IsDescendantOf(*reached, *element) ||
+                  InFrameOf(*reached, *element))) {
+    // A part of it with a control of its own takes the press first: named,
+    // for the reply to say. Its own elements, not a component's
+    // insides.
+    for (Node* node = reached; node && node != element;
+         node = FlatTreeTraversal::Parent(*node)) {
+      auto* part = DynamicTo<Element>(node);
+      if (part && &part->GetTreeScope() == &element->GetTreeScope() &&
+          ActsOnItsOwn(*part, *element)) {
+        hit = DescribeHit(*part);
+        break;
+      }
+    }
+    return "reached";
+  }
+  // A label passes a click on to its control.
+  if (reached) {
+    HTMLLabelElement* label =
+        Traversal<HTMLLabelElement>::FirstAncestorOrSelf(*reached);
+    if (label && label->Control() == element) {
+      return "label";
+    }
+  }
+
+  // Why the press misses. Inert and pointer-events: none are one rule to the
+  // hit test (UsedPointerEvents is none for inert), so the cause is read from
+  // the element's own style.
+  const ComputedStyle* style = element->GetComputedStyle();
+  if (!element->GetLayoutObject() || !style) {
+    return "hidden";
+  }
+  // browser: or in a frame its owner shuts out, which no press reaches
+  // whatever lies over it there (InertHolder).
+  if (InertHolder(*element)) {
+    if (name_inert) {
+      String cause_kind;
+      hit = InertCause(*element, cause_kind);
+      if (hit_kind) {
+        *hit_kind = cause_kind;
+      }
+    }
+    return "inert";
+  }
+  if (style->Visibility() != EVisibility::kVisible) {
+    return "hidden";
+  }
+  if (!reached) {
+    return "nothing";
+  }
+  String cover_kind;
+  hit = CoverFrom(*reached, *element, &cover_kind);
+  // browser: a layer's veil -- its backdrop, beside its box -- named
+  // by its layer, as a cover inside the layer is.
+  if (cover_kind.empty()) {
+    const char* veil_kind = nullptr;
+    const String layer = VeilLayerName(*root, *reached, *element, veil_kind);
+    if (!layer.empty()) {
+      hit = CoverWhere(*reached, *element, layer);
+      cover_kind = String(veil_kind);
+    }
+  }
+  if (hit_kind) {
+    *hit_kind = cover_kind;
+  }
+  return style->UsedPointerEvents() == EPointerEvents::kNone ? "noPointer"
+                                                             : "covered";
+}
+
+// The reachable part of an aim piece is read from hit tests at most this far
+// apart, and at most this many each way; a probe of 3 x 3 comes first.
+constexpr float kReachCellPx = 12;
+constexpr int kReachGrid = 12;
+constexpr int kReachProbe = 3;
+
+// Of `piece` (in the local root's frame), the largest axis-aligned part where
+// a press reaches `element` or something inside it, read from read-only hit
+// tests run as PressVerdict runs a press's: first a 3 x 3 probe -- all nine
+// reaching, as for almost every element, the piece is kept -- then a grid of
+// points about 12 px apart. A side that meets something else is held back to
+// the last points that reached the element; a part held back to one line of
+// points is `min_extent` across (Blink-space px), centred on it. Reached
+// nowhere, or everywhere, it is the piece as it was: the press's own check
+// says what lies over it. A sticky header over the top of a button is no
+// place to aim.
+gfx::RectF ReachablePart(LocalFrame& root,
+                         LocalFrameView& view,
+                         Element& element,
+                         const gfx::RectF& piece,
+                         float min_extent) {
+  // The first test brings the lifecycle up to date; read-only tests dirty
+  // nothing, so the rest do not ask again -- once it is up to date (an update
+  // throttled or postponed leaves it short, and each test asks again).
+  bool lifecycle_clean = false;
+  const auto reaches = [&](float x, float y) {
+    HitTestLocation location(view.ConvertFromRootFrame(gfx::PointF(x, y)));
+    HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+        location,
+        HitTestRequest::kReadOnly | HitTestRequest::kActive |
+            HitTestRequest::kAllowChildFrameContent,
+        /*stop_node=*/nullptr, /*no_lifecycle_update=*/lifecycle_clean);
+    const Document* document = root.GetDocument();
+    lifecycle_clean = document && document->Lifecycle().GetState() >=
+                                      DocumentLifecycle::kPrePaintClean;
+    const Element* hit = result.InnerElement();
+    return !result.GetScrollbar() && hit &&
+           (hit == &element ||
+            FlatTreeTraversal::IsDescendantOf(*hit, element) ||
+            InFrameOf(*hit, element));
+  };
+  bool all = true;
+  for (int i = 0; all && i < kReachProbe * kReachProbe; ++i) {
+    all = reaches(
+        piece.x() + (i % kReachProbe + 0.5f) * piece.width() / kReachProbe,
+        piece.y() + (i / kReachProbe + 0.5f) * piece.height() / kReachProbe);
+  }
+  if (all) {
+    return piece;
+  }
+  const int cols = std::clamp(
+      static_cast<int>(std::ceil(piece.width() / kReachCellPx)), 1, kReachGrid);
+  const int rows =
+      std::clamp(static_cast<int>(std::ceil(piece.height() / kReachCellPx)), 1,
+                 kReachGrid);
+  const float cell_w = piece.width() / cols;
+  const float cell_h = piece.height() / rows;
+  Vector<bool> reached_at(static_cast<wtf_size_t>(rows * cols));
+  int reached = 0;
+  for (int row = 0; row < rows; ++row) {
+    for (int col = 0; col < cols; ++col) {
+      const bool here = reaches(piece.x() + (col + 0.5f) * cell_w,
+                                piece.y() + (row + 0.5f) * cell_h);
+      reached_at[row * cols + col] = here;
+      reached += here ? 1 : 0;
+    }
+  }
+  if (reached == 0 || reached == rows * cols) {
+    return piece;
+  }
+  // What a hand may aim at of a rectangle of reaching cells: from the cells'
+  // edges in to the points tested, on each side that is not the piece's own
+  // edge; held back to one line of points, `min_extent` across (at most a
+  // cell), centred on it.
+  const float across_x = std::min(min_extent, cell_w);
+  const float across_y = std::min(min_extent, cell_h);
+  const auto usable = [&](int top, int bottom, int left, int right) {
+    float x0 = piece.x() + left * cell_w;
+    float x1 = piece.x() + (right + 1) * cell_w;
+    float y0 = piece.y() + top * cell_h;
+    float y1 = piece.y() + (bottom + 1) * cell_h;
+    if (left > 0) {
+      x0 += cell_w / 2;
+    }
+    if (right < cols - 1) {
+      x1 -= cell_w / 2;
+    }
+    if (top > 0) {
+      y0 += cell_h / 2;
+    }
+    if (bottom < rows - 1) {
+      y1 -= cell_h / 2;
+    }
+    if (x1 - x0 < across_x) {
+      const float middle = (x0 + x1) / 2;
+      x0 = middle - across_x / 2;
+      x1 = middle + across_x / 2;
+    }
+    if (y1 - y0 < across_y) {
+      const float middle = (y0 + y1) / 2;
+      y0 = middle - across_y / 2;
+      y1 = middle + across_y / 2;
+    }
+    return gfx::RectF(x0, y0, x1 - x0, y1 - y0);
+  };
+  // The largest such part over every rectangle of reaching cells: per row,
+  // how many reaching cells stand in each column down to it, then every run
+  // of columns at its tallest (a taller one is never held back more).
+  Vector<int> depth(static_cast<wtf_size_t>(cols), 0);
+  gfx::RectF best = piece;
+  float best_area = -1;
+  for (int row = 0; row < rows; ++row) {
+    for (int col = 0; col < cols; ++col) {
+      depth[col] = reached_at[row * cols + col] ? depth[col] + 1 : 0;
+    }
+    for (int from = 0; from < cols; ++from) {
+      int least = rows;
+      for (int to = from; to < cols && depth[to] > 0; ++to) {
+        least = std::min(least, depth[to]);
+        const gfx::RectF part = usable(row - least + 1, row, from, to);
+        const float area = part.width() * part.height();
+        if (area > best_area) {
+          best_area = area;
+          best = part;
+        }
+      }
+    }
+  }
+  // Within the piece: a line beside its edge, made 2 DIPs across, can reach
+  // past it.
+  best.Intersect(piece);
+  return best;
+}
+
+// browser: at most this many hit tests a capture spends on UnderCover.
+constexpr int kUnderBudget = 2000;
+
+// browser: whether `holder` is `element` or one of its ancestors, in its flat
+// tree or across the frames that hold it.
+bool HoldsAcross(const Element& holder, const Element& element) {
+  for (const Element* e = &element; e; e = e->GetDocument().LocalOwner()) {
+    if (e == &holder || FlatTreeTraversal::IsDescendantOf(*e, holder)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// ------------------------------------------------- browser: the layer
+// The layer the user deals with on this local
+// root -- Blink's top layer, or an overlay drawn over the page with no role in
+// it (a cart drawer, a consent wall) -- found read-only before the listing's
+// accessibility pass: getters, ComputedStyle reads and read-only hit tests (no
+// hover or active state), on the lifecycle the capture's own hit tests bring
+// up anyway. Reported as the layers open, bottom to top (LayerStack).
+
+// Of 13 probe points: blocking when an overlay is met at this many and lies
+// over page content at that many; a candidate from kLayerCandidateHits (and
+// over content at one at least).
+constexpr int kLayerBlockingHits = 11;
+// Over the page (LayerIsPage) at this many points: anything but an app
+// shell's fixed root, which lies over nothing but <body>.
+constexpr int kLayerBlockingCovering = 2;
+constexpr int kLayerCandidateHits = 3;
+// The walk that asks whether a box beneath an overlay holds content.
+constexpr int kLayerBeneathBudget = 100;
+// A part beside the layer (a <body> child, or one beside a box holding it)
+// counts for the inert hints only when it shows this much of the viewport
+// (0x0 and 1x1 helpers beside an inert page).
+constexpr double kLayerSiblingShare = 0.01;
+// A frame showing under this share of the page is no page's layer.
+constexpr double kLayerFrameShare = 0.1;
+// A layer's head, and the hit tests a capture spends on text behind a cover
+// that hid a control.
+constexpr wtf_size_t kLayerHeadLength = 600;
+constexpr int kHiddenTextBudget = 300;
+// A veil (a backdrop holding nothing) spans the viewport's width and covers
+// at least this share of its height down to its bottom: a page's backdrop
+// under its site header.
+constexpr double kLayerVeilShare = 0.5;
+// A veil that met every probe inside what shows of it, at least this many,
+// shuts off what it covers: blocking though a header above it took the rest.
+constexpr int kLayerVeilShutHits = 8;
+// The scan for a panel over a veil no probe met: two rows, a point every
+// ~160 px across, at most 16 a row: a menu column can lie between the
+// probes' columns.
+constexpr float kLayerScanStep = 160;
+constexpr int kLayerScanColumns = 16;
+// A heading names its layer only when no more text than this comes before it
+// there (a close button, "Step 1 of 2"): a section's heading inside a cart is
+// no name for the cart.
+constexpr wtf_size_t kLayerTitleLead = 12;
+constexpr wtf_size_t kLayerNameLength = 60;
+constexpr int kLayerWalkBudget = 500;
+constexpr int kLayerSiblingBudget = 200;
+constexpr wtf_size_t kLayerCandidates = 3;
+// The overlays a probe keeps from beneath its top one.
+constexpr wtf_size_t kLayerBeneath = 3;
+constexpr wtf_size_t kLayerAriaBudget = 50;
+// A manual popover under this share of the viewport is a toast or a tooltip;
+// an ARIA candidate needs this much of it.
+constexpr double kLayerSmallShare = 0.25;
+constexpr double kLayerAriaShare = 0.01;
+// browser: a combobox's or menu button's open popup needs this much: a
+// list of one suggestion shows less than an ARIA dialog must. At most this
+// many expanded elements are looked at for one.
+constexpr double kLayerPopupShare = 0.002;
+constexpr wtf_size_t kLayerPopupOpeners = 200;
+// AgentLayer.hints.
+constexpr uint32_t kLayerHintAriaModal = 1;
+constexpr uint32_t kLayerHintRole = 2;
+constexpr uint32_t kLayerHintFocusInside = 4;
+constexpr uint32_t kLayerHintScrollLock = 8;
+constexpr uint32_t kLayerHintSiblingsShut = 16;
+constexpr uint32_t kLayerHintVeilClick = 32;
+constexpr uint32_t kLayerHintSiblingsInert = 64;
+// The page inert beside the layer's own boxes below <body>'s level,
+// set only when 64 is not -- standing for content beneath only where no probe
+// met any, which an inert page cannot show.
+constexpr uint32_t kLayerHintChainInert = 128;
+// browser: a modal's signs, one of which a veil over a page with little
+// on it needs before it counts as lying over the page.
+constexpr uint32_t kLayerModalHints = kLayerHintAriaModal | kLayerHintRole |
+                                      kLayerHintScrollLock |
+                                      kLayerHintVeilClick;
+
+// A layer or a candidate; its root element is kept beside it (LayerScan).
+struct LayerFacts {
+  const char* kind = "panel";
+  const char* how = "probe";
+  bool blocking = false;
+  int points_hit = 0;
+  int points_covering = 0;
+  uint32_t hints = 0;
+  String name;
+  // Its veil's DOMNodeId (0: none), whether it shuts the page off, and
+  // whether the page behind it is inert (a modal <dialog>, hint 64).
+  int32_t veil_node_id = 0;
+  bool shuts_page = false;
+  bool page_inert = false;
+};
+
+// A local root's detection: roots[i] with facts[i], the first the layer when
+// `has_layer`, the rest candidates.
+struct LayerScan {
+  STACK_ALLOCATED();
+
+ public:
+  HeapVector<Member<Element>> roots;
+  Vector<LayerFacts> facts;
+  bool has_layer = false;
+  // False: a frame the page has not placed (DetectLayer), with no document
+  // name to read either.
+  bool placed = true;
+  // The pairs some probe met stacked, `above[i]` over `below[i]` (LayerProbe).
+  HeapVector<Member<Element>> above;
+  HeapVector<Member<Element>> below;
+  // The layers open on this local root, bottom to top, as indices into
+  // `roots` (LayerStack).
+  Vector<wtf_size_t> stack;
+};
+
+// What shows of `element` in the local root's frame, clipped as the page
+// shows it and by the local root's viewport; empty when nothing does.
+gfx::RectF LayerShownOf(const Element& element, const LocalFrame& root) {
+  const LayoutObject* object = element.GetLayoutObject();
+  const LayoutBox* enclosing = object ? object->EnclosingBox() : nullptr;
+  LocalFrameView* view = element.GetDocument().View();
+  LocalFrameView* root_view = root.View();
+  if (!enclosing || !view || !root_view) {
+    return gfx::RectF();
+  }
+  const gfx::RectF box = object->AbsoluteBoundingBoxRectF();
+  const gfx::PointF start = view->ConvertToRootFrame(box.origin());
+  const gfx::PointF end = view->ConvertToRootFrame(box.bottom_right());
+  gfx::RectF shown = VisibleInRoot(
+      *enclosing, root,
+      gfx::RectF(start, gfx::SizeF(end.x() - start.x(), end.y() - start.y())));
+  shown.Intersect(ViewportRect(*root_view));
+  return shown;
+}
+
+// Whether `shown` is nearly the whole local root viewport (IsPageSized's 90 %).
+bool LayerPageSized(const gfx::RectF& shown, const LocalFrame& root) {
+  const gfx::RectF viewport = ViewportRect(*root.View());
+  return viewport.width() > 0 && viewport.height() > 0 &&
+         shown.width() >= viewport.width() * kPageSizedShare &&
+         shown.height() >= viewport.height() * kPageSizedShare;
+}
+
+// Whether `shown` is a veil's size: across the whole local root viewport
+// (IsPageSized's 90 %), and either nearly all of its height or over half of
+// it down to its bottom edge -- a backdrop under a site header.
+// Never a side panel: a split screen's empty, fixed half is no veil.
+bool LayerVeilSized(const gfx::RectF& shown, const LocalFrame& root) {
+  const gfx::RectF viewport = ViewportRect(*root.View());
+  if (viewport.width() <= 0 || viewport.height() <= 0 ||
+      shown.width() < viewport.width() * kPageSizedShare) {
+    return false;
+  }
+  constexpr float kEdge = 2;
+  return shown.height() >= viewport.height() * kPageSizedShare ||
+         (shown.height() >= viewport.height() * kLayerVeilShare &&
+          shown.bottom() >= viewport.bottom() - kEdge);
+}
+
+double LayerShare(const gfx::RectF& shown, const LocalFrame& root) {
+  const gfx::RectF viewport = ViewportRect(*root.View());
+  const double area = viewport.width() * viewport.height();
+  return area > 0 ? shown.width() * shown.height() / area : 0;
+}
+
+// Whether `element` lies over the whole view and stays there as the page
+// scrolls (fixed to it, or over the whole document), so what is off-screen
+// behind it is out of reach too: a wrapper holding its dialog, as a full veil.
+bool LayerShutsView(const Element& element,
+                    const LocalFrame& root,
+                    const Document& document) {
+  const auto* box = DynamicTo<LayoutBox>(element.GetLayoutObject());
+  if (!box || !LayerPageSized(LayerShownOf(element, root), root)) {
+    return false;
+  }
+  if (box->IsFixedToView()) {
+    return true;
+  }
+  const LayoutView* view = document.GetLayoutView();
+  if (!view) {
+    return false;
+  }
+  const PhysicalRect whole = view->DocumentRect();
+  const gfx::RectF covered = box->AbsoluteBoundingBoxRectF();
+  return covered.width() >= whole.Width().ToFloat() * 0.9f &&
+         covered.height() >= whole.Height().ToFloat() - 1;
+}
+
+// browser: whether the veil `veil` stays over the view as the page
+// scrolls -- fixed to it, or as tall as the document -- so what is off-screen
+// behind it is out of reach too: LayerShutsView's test, without its own size
+// (a veil below a site header passes).
+bool LayerVeilStays(const Element& veil, const Document& document) {
+  const auto* box = DynamicTo<LayoutBox>(veil.GetLayoutObject());
+  if (!box) {
+    return false;
+  }
+  if (box->IsFixedToView()) {
+    return true;
+  }
+  const LayoutView* view = document.GetLayoutView();
+  return view && box->AbsoluteBoundingBoxRectF().height() >=
+                     view->DocumentRect().Height().ToFloat() - 1;
+}
+
+// The role attribute's first token is `role`; tokens are split, and may be
+// led, by any HTML whitespace.
+bool LayerRoleIs(const Element& element, const char* role) {
+  const AtomicString& value = element.FastGetAttribute(html_names::kRoleAttr);
+  wtf_size_t start = 0;
+  while (start < value.length() && IsHTMLSpace<UChar>(value[start])) {
+    ++start;
+  }
+  wtf_size_t end = start;
+  while (end < value.length() && !IsHTMLSpace<UChar>(value[end])) {
+    ++end;
+  }
+  return end > start &&
+         EqualIgnoringAsciiCase(StringView(value, start, end - start),
+                                StringView(role));
+}
+
+// The kind an element's own semantics give, or null.
+const char* LayerKindOf(const Element& element) {
+  // The fixed set: dialog, alert, menu, listbox, popover, fullscreen,
+  // picker, panel.
+  if (LayerRoleIs(element, "alertdialog")) {
+    return "alert";
+  }
+  if (IsA<HTMLDialogElement>(element) || LayerRoleIs(element, "dialog")) {
+    return "dialog";
+  }
+  if (LayerRoleIs(element, "menu") || LayerRoleIs(element, "menubar")) {
+    return "menu";
+  }
+  if (LayerRoleIs(element, "listbox")) {
+    return "listbox";
+  }
+  return nullptr;
+}
+
+// Whether `element` is a button or a link: its text is what it does, not
+// what holds it.
+bool LayerIsControl(const Element& element) {
+  return element.IsLink() || element.HasTagName(html_names::kButtonTag) ||
+         LayerRoleIs(element, "button") || LayerRoleIs(element, "link");
+}
+
+// Whether `root` shows text outside `inside` and outside its buttons and
+// links: a drawer's own title around the menu list in it.
+bool LayerTextOutside(Element& root, const Element& inside) {
+  int budget = kLayerWalkBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(root);
+       node && budget-- > 0;) {
+    auto* element = DynamicTo<Element>(node);
+    if (node == &inside || (element && LayerIsControl(*element))) {
+      node = FlatTreeTraversal::NextSkippingChildren(*node, &root);
+      continue;
+    }
+    if (auto* text = DynamicTo<Text>(node);
+        text && text->GetLayoutObject() && !CleanName(text->data()).empty()) {
+      Element* host = text->OwnerShadowHost();
+      if (!host || !IsA<TextControlElement>(host)) {
+        return true;
+      }
+    }
+    node = FlatTreeTraversal::Next(*node, &root);
+  }
+  return false;
+}
+
+// The element giving a layer its kind and name: the root when it has
+// semantics, else the first rendered element inside it that has (a library's
+// wrapper around its role=dialog panel), else the root.
+Element& LayerSemanticRoot(Element& root, const char*& kind) {
+  kind = LayerKindOf(root);
+  if (kind) {
+    return root;
+  }
+  int budget = kLayerWalkBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(root); node && budget-- > 0;
+       node = FlatTreeTraversal::Next(*node, &root)) {
+    auto* element = DynamicTo<Element>(node);
+    if (!element || !element->GetLayoutObject()) {
+      continue;
+    }
+    if (const char* found = LayerKindOf(*element)) {
+      // A library's wrapper shows nothing of its own; a drawer with a title
+      // around a role=menu list is the drawer, a panel, not its list's
+      // items.
+      if (LayerTextOutside(root, *element)) {
+        return root;
+      }
+      kind = found;
+      return *element;
+    }
+  }
+  return root;
+}
+
+bool LayerIsHeading(const Element& element) {
+  return IsHeadingTag(element) || LayerRoleIs(element, "heading");
+}
+
+// A name cut to a layer's 60 characters, with an ellipsis when cut.
+String LayerNameCut(const String& name) {
+  return Capped(name, kLayerNameLength);
+}
+
+// Whether an author's label only says what kind of thing it is: no name
+// (a modal labelled aria-label="dialog").
+bool LayerLabelIsKind(const String& label) {
+  static constexpr const char* kKinds[] = {
+      "dialog", "modal",   "modal dialog", "dialog box", "popup",
+      "pop-up", "popover", "overlay",      "drawer",     "panel",
+      "menu",   "sheet",   "lightbox"};
+  for (const char* kind : kKinds) {
+    if (EqualIgnoringAsciiCase(label, StringView(kind))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The first rendered <h1> in `element` with a name, outside `skip`.
+String LayerH1(Element& element, const Node* skip) {
+  int budget = kLayerWalkBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(element);
+       node && budget-- > 0;) {
+    if (node == skip) {
+      node = FlatTreeTraversal::NextSkippingChildren(*node, &element);
+      continue;
+    }
+    if (auto* heading = DynamicTo<Element>(node);
+        heading && heading->GetLayoutObject() &&
+        heading->HasTagName(html_names::kH1Tag)) {
+      const String name = TextName(heading);
+      if (!name.empty()) {
+        return name;
+      }
+    }
+    node = FlatTreeTraversal::Next(*node, &element);
+  }
+  return String();
+}
+
+// `element`'s title: its first heading with a name, when no more than
+// kLayerTitleLead characters of text come before it there (for example
+// a cart section's heading after the store's name, or a menu section's
+// heading after a sign-in greeting).
+String LayerTitle(Element& element, const Node* skip) {
+  wtf_size_t lead = 0;
+  int budget = kLayerWalkBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(element);
+       node && budget-- > 0;) {
+    if (node == skip) {
+      node = FlatTreeTraversal::NextSkippingChildren(*node, &element);
+      continue;
+    }
+    if (auto* heading = DynamicTo<Element>(node);
+        heading && heading->GetLayoutObject() && LayerIsHeading(*heading)) {
+      const String name = TextName(heading);
+      if (!name.empty()) {
+        return name;
+      }
+      node = FlatTreeTraversal::NextSkippingChildren(*node, &element);
+      continue;
+    }
+    if (auto* text = DynamicTo<Text>(node); text && text->GetLayoutObject()) {
+      Element* host = text->OwnerShadowHost();
+      if (!host || !IsA<TextControlElement>(host)) {
+        lead += CleanName(text->data()).length();
+        if (lead > kLayerTitleLead) {
+          return String();
+        }
+      }
+    }
+    node = FlatTreeTraversal::Next(*node, &element);
+  }
+  return String();
+}
+
+// `element`'s text as TextName reads it, outside `skip`, with a run that
+// repeats the one just before it left out (a cart drawer whose title and
+// store link say the same words). Cut to `limit` characters: a name's 80, or
+// a layer's head.
+String LayerTextName(Element& element,
+                     const Node* skip,
+                     wtf_size_t limit = kTextNameLength) {
+  StringBuilder raw;
+  String last;
+  int budget = kTextNameNodeBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(element);
+       node && budget-- > 0 && raw.length() < limit * 4;) {
+    if (node == skip) {
+      node = FlatTreeTraversal::NextSkippingChildren(*node, &element);
+      continue;
+    }
+    auto* text = DynamicTo<Text>(node);
+    if (text && text->GetLayoutObject()) {
+      // Never a text field's own value (TextName).
+      if (Element* host = text->OwnerShadowHost();
+          !host || !IsA<TextControlElement>(host)) {
+        const String run = CleanName(text->data());
+        if (!run.empty() && run != last) {
+          raw.Append(run);
+          raw.Append(' ');
+          last = run;
+        }
+      }
+    }
+    node = FlatTreeTraversal::Next(*node, &element);
+  }
+  return Capped(CleanName(raw.ToString()), limit);
+}
+
+// The first id of an id list such as aria-labelledby, whatever whitespace
+// leads or follows it; empty for none.
+AtomicString FirstIdIn(const AtomicString& ids) {
+  const String spaced = ids.GetString().SimplifyWhiteSpace();
+  const wtf_size_t space = spaced.find(static_cast<UChar>(' '));
+  return AtomicString(
+      spaced.substr(0, space == kNotFound ? spaced.length() : space));
+}
+
+// A layer's name: its author's name (aria-label, then aria-labelledby's first
+// id) unless it only names the kind, else an <h1> in it, else its title, else
+// its text -- and a layer with no text of its own around a frame in this
+// process (a consent dialog's frame) takes that frame's document's name.
+// `skip`'s subtree is left out. Without the accessibility tree (not built yet
+// here), and never from a field's value (TextName).
+String LayerName(Element& element,
+                 const Element* skip = nullptr,
+                 bool in_frame = false) {
+  String name = CleanName(element.FastGetAttribute(html_names::kAriaLabelAttr));
+  if (name.empty()) {
+    const AtomicString& ids =
+        element.FastGetAttribute(html_names::kAriaLabelledbyAttr);
+    if (!ids.empty()) {
+      if (Element* label =
+              element.GetTreeScope().getElementById(FirstIdIn(ids))) {
+        name = TextName(label);
+      }
+    }
+  }
+  if (LayerLabelIsKind(name)) {
+    name = String();
+  }
+  if (name.empty()) {
+    name = LayerH1(element, skip);
+  }
+  if (name.empty()) {
+    name = LayerTitle(element, skip);
+  }
+  if (name.empty()) {
+    name = LayerTextName(element, skip);
+  }
+  if (name.empty() && !in_frame) {
+    int budget = kLayerWalkBudget;
+    for (Node* node = &element; node && budget-- > 0;) {
+      if (node == skip) {
+        node = FlatTreeTraversal::NextSkippingChildren(*node, &element);
+        continue;
+      }
+      auto* owner = DynamicTo<HTMLFrameOwnerElement>(node);
+      auto* frame = owner && owner->GetLayoutObject()
+                        ? DynamicTo<LocalFrame>(owner->ContentFrame())
+                        : nullptr;
+      Document* inner = frame ? frame->GetDocument() : nullptr;
+      if (inner && inner->body()) {
+        name = LayerName(*inner->body(), nullptr, /*in_frame=*/true);
+        break;
+      }
+      node = FlatTreeTraversal::Next(*node, &element);
+    }
+  }
+  return LayerNameCut(name);
+}
+
+// browser: the kind `element` has as a layer by its own
+// semantics -- a dialog, alertdialog, menu or listbox by role or tag
+// (LayerKindOf; not a menubar on the page), or an open popover or a select's
+// picker in the top layer -- null when none.
+const char* CoverLayerKind(const Element& element) {
+  const bool top = element.IsInTopLayer();
+  if (!top && LayerRoleIs(element, "menubar")) {
+    return nullptr;
+  }
+  if (const char* kind = LayerKindOf(element)) {
+    return kind;
+  }
+  if (!top) {
+    return nullptr;
+  }
+  if (HTMLSelectElement::IsPopoverPickerElement(&element)) {
+    return "picker";
+  }
+  const auto* html = DynamicTo<HTMLElement>(element);
+  return html && html->popoverOpen() ? "popover" : nullptr;
+}
+
+// browser: the open layer a cover lies in. Of the
+// ancestors of `hit` in its flat tree, itself included, that are layers by
+// their own semantics (CoverLayerKind), up to the first that holds `element`:
+// the innermost one drawn over the page -- in the top layer or out of flow,
+// itself or a box above it below the next such layer and not holding
+// `element` too (an app shell fixed over the whole viewport draws
+// its static menus and the element alike) -- its kind in `kind`.
+// So an absolute suggestion list is the list, a static list in a fixed
+// dialog is the dialog, and a menu open in the element's own dialog is the
+// menu. Null when none is: the nearest holds `element` (a dialog's own bar
+// over its field is a cover, not the dialog), or none is drawn over the page
+// (a sticky nav marked menu): the hit is then named by itself.
+Element* CoverLayer(Element& hit, const Element* element, const char*& kind) {
+  Element* candidate = nullptr;
+  const char* candidate_kind = nullptr;
+  bool over = false;
+  for (Element* up = &hit; up; up = FlatTreeTraversal::ParentElement(*up)) {
+    if (const char* found = CoverLayerKind(*up)) {
+      if (candidate && over) {
+        break;
+      }
+      if (element && HoldsAcross(*up, *element)) {
+        return nullptr;
+      }
+      candidate = up;
+      candidate_kind = found;
+      over = false;
+    }
+    if (candidate && !over) {
+      // browser: a box holding the element too draws both, so it
+      // says nothing of the candidate lying over it, nor does anything above.
+      if (element && up != candidate && HoldsAcross(*up, *element)) {
+        break;
+      }
+      const LayoutObject* object = up->GetLayoutObject();
+      over = up->IsInTopLayer() || (object && object->IsOutOfFlowPositioned());
+    }
+  }
+  if (!candidate || !over) {
+    return nullptr;
+  }
+  kind = candidate_kind;
+  return candidate;
+}
+
+// browser: a layer named as layers are: its kind, then its name
+// in quotes when it has one.
+String LayerKindName(const char* kind, const String& name) {
+  if (name.empty()) {
+    return String(kind);
+  }
+  return String(kind) + " \"" + name + "\"";
+}
+
+// browser: a cover's layer named as layers are (LayerKindName); a
+// picker by its select.
+String CoverLayerName(Element& layer, const char* kind) {
+  Element* named = &layer;
+  if (HTMLSelectElement::IsPopoverPickerElement(&layer)) {
+    if (Element* host = layer.OwnerShadowHost()) {
+      named = host;
+    }
+  }
+  return LayerKindName(kind, LayerName(*named));
+}
+
+// Defined below.
+bool LayerHasContent(Element& element, int budget = kLayerWalkBudget);
+bool LayerIsPage(Node& node,
+                 const Element& overlay,
+                 const Document& document,
+                 const LocalFrame& root);
+
+// Whether a node is page content an overlay can lie over: rendered text, or an
+// element a user acts on or knows by a name. Not a picture, a video or a
+// canvas (a hero's image under its title), nor a bare box.
+bool LayerIsContent(Node& node) {
+  if (auto* text = DynamicTo<Text>(node)) {
+    return text->GetLayoutObject() &&
+           !text->data().ContainsOnlyWhitespaceOrEmpty();
+  }
+  auto* element = DynamicTo<Element>(node);
+  if (!element || !element->GetLayoutObject() ||
+      IsA<HTMLImageElement>(*element) || IsA<HTMLVideoElement>(*element) ||
+      IsA<HTMLCanvasElement>(*element)) {
+    return false;
+  }
+  return element->IsFormControlElement() || element->IsLink() ||
+         HasClickListener(element) ||
+         !element->FastGetAttribute(html_names::kAriaLabelAttr).empty();
+}
+
+// `node`, or the frame element holding it in `document` when it is in a
+// same-process frame inside it; null when it is in neither.
+Node* LayerInDocument(Node* node, const Document& document) {
+  while (node && &node->GetDocument() != &document) {
+    node = node->GetDocument().LocalOwner();
+  }
+  return node;
+}
+
+// Whether, beneath a probe's top hit (list[from]), page content outside
+// `holder` lies there: not inside it, not one of its ancestors, nor <html>,
+// <body> or the document.
+bool LayerCovers(const HeapVector<Member<Node>>& list,
+                 wtf_size_t from,
+                 const Element& holder,
+                 const Document& document,
+                 const LocalFrame& root) {
+  for (wtf_size_t i = from + 1; i < list.size(); ++i) {
+    Node* node = list[i].Get();
+    Node* here = LayerInDocument(node, document);
+    if (!here || here->IsDocumentNode() || here == document.body() ||
+        here == document.documentElement()) {
+      continue;
+    }
+    if (here == &holder || FlatTreeTraversal::IsDescendantOf(*here, holder)) {
+      continue;
+    }
+    if (auto* element = DynamicTo<Element>(here);
+        element && FlatTreeTraversal::IsDescendantOf(holder, *element)) {
+      continue;
+    }
+    if (LayerIsPage(*node, holder, document, root)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Whether an out-of-flow box is placed against the page itself: its
+// containing block is the view, or <body> or <html> made the containing block
+// (`position: relative` on them).
+bool LayerPlacedOnPage(const LayoutBox& box, const Document& document) {
+  const LayoutBox* block = box.ContainingBlock();
+  if (!block) {
+    return false;
+  }
+  const Node* node = block->GetNode();
+  return block->IsLayoutView() ||
+         (node &&
+          (node == document.body() || node == document.documentElement()));
+}
+
+// Whether `element`'s box `box` is a layer of its own on the page: fixed to
+// the view, or out of flow, positively z-indexed, placed against the page
+// itself and page-sized (a modal appended to <body>, not a slide or an
+// overlay inside a hero carousel).
+bool LayerOwnBox(const LayoutBox& box,
+                 const Element& element,
+                 const Document& document,
+                 const LocalFrame& root) {
+  return box.IsFixedToView() ||
+         (box.IsOutOfFlowPositioned() && box.StyleRef().EffectiveZIndex() > 0 &&
+          LayerPlacedOnPage(box, document) &&
+          LayerPageSized(LayerShownOf(element, root), root));
+}
+
+// Whether `element` lies in a fixed (or page-placed, page-sized) box that is
+// neither `overlay` nor one of its ancestors: another layer of its own, such as
+// a fixed background under a fixed hero.
+bool LayerInOtherLayer(Element& element,
+                       const Element& overlay,
+                       const Document& document,
+                       const LocalFrame& root) {
+  const Element* body = document.body();
+  const Element* html = document.documentElement();
+  for (Element* e = &element; e && e != body && e != html;
+       e = FlatTreeTraversal::ParentElement(*e)) {
+    const auto* box = DynamicTo<LayoutBox>(e->GetLayoutObject());
+    if (!box) {
+      continue;
+    }
+    if (LayerOwnBox(*box, *e, document, root)) {
+      return !(e == &overlay || FlatTreeTraversal::IsDescendantOf(overlay, *e));
+    }
+  }
+  return false;
+}
+
+// Whether a node beneath `overlay` is part of the page: content, a frame, a
+// box holding content -- a column whose white space the probe met -- or a
+// picture, a video or a canvas of the page itself, not of another fixed
+// layer.
+bool LayerIsPage(Node& node,
+                 const Element& overlay,
+                 const Document& document,
+                 const LocalFrame& root) {
+  if (LayerIsContent(node)) {
+    return true;
+  }
+  auto* element = DynamicTo<Element>(node);
+  if (!element || !element->GetLayoutObject()) {
+    return false;
+  }
+  if (IsA<HTMLFrameOwnerElement>(*element)) {
+    return true;
+  }
+  if (IsA<HTMLImageElement>(*element) || IsA<HTMLVideoElement>(*element) ||
+      IsA<HTMLCanvasElement>(*element)) {
+    return !LayerInOtherLayer(*element, overlay, document, root);
+  }
+  return LayerHasContent(*element, kLayerBeneathBudget);
+}
+
+// Whether a box holds anything to read or act on: content inside it, or a
+// frame (a page-sized <iframe> wall is no empty veil).
+bool LayerHolds(Element& element) {
+  return IsA<HTMLFrameOwnerElement>(element) || LayerHasContent(element);
+}
+
+// The overlay a probe's top hit belongs to. Of the boxes holding it below
+// <body> that are fixed to the view (or out of flow, positively z-indexed and
+// page-sized: an absolutely placed modal), from the outermost in, the first
+// that lies over page content at this point -- an app shell's fixed root lies
+// over nothing, a modal inside it does; else the outermost, over nothing.
+// Null: the page itself. `covers`: whether the one returned lies over content.
+Element* LayerOverlayAt(Element& hit,
+                        const HeapVector<Member<Node>>& list,
+                        wtf_size_t from,
+                        const Document& document,
+                        const LocalFrame& root,
+                        bool& covers) {
+  HeapVector<Member<Element>> holders;  // innermost first
+  const Element* body = document.body();
+  const Element* html = document.documentElement();
+  for (Element* e = &hit; e && e != body && e != html;
+       e = FlatTreeTraversal::ParentElement(*e)) {
+    const auto* box = DynamicTo<LayoutBox>(e->GetLayoutObject());
+    if (!box) {
+      continue;
+    }
+    if (LayerOwnBox(*box, *e, document, root)) {
+      holders.push_back(e);
+    }
+  }
+  covers = false;
+  for (wtf_size_t i = holders.size(); i-- > 0;) {
+    if (LayerCovers(list, from, *holders[i], document, root)) {
+      covers = true;
+      return holders[i].Get();
+    }
+  }
+  return holders.empty() ? nullptr : holders.back().Get();
+}
+
+// Whether anything a user reads or acts on is inside `element` -- a veil holds
+// nothing -- within a walk's budget (past it: as if there were).
+bool LayerHasContent(Element& element, int budget) {
+  for (Node* node = FlatTreeTraversal::FirstChild(element); node;
+       node = FlatTreeTraversal::Next(*node, &element)) {
+    if (budget-- <= 0 || LayerIsContent(*node)) {
+      return true;
+    }
+    if (auto* owner = DynamicTo<HTMLFrameOwnerElement>(node);
+        owner && owner->GetLayoutObject()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The panel a veil lies under: a sibling of it, rendered, out of flow,
+// painted over it (a higher z-index, or the same and later), showing in the
+// viewport and holding content -- a drawer beside its backdrop. Of several
+// (a fixed site header painted over the veil too), the one most probes met,
+// else the one painted highest (the later of equals).
+Element* LayerPanelAbove(Element& veil,
+                         const LocalFrame& root,
+                         const HeapVector<Member<Element>>& groups,
+                         const Vector<int>& hits) {
+  const LayoutObject* veil_object = veil.GetLayoutObject();
+  const int veil_z =
+      veil_object ? veil_object->StyleRef().EffectiveZIndex() : 0;
+  const gfx::RectF veil_shown = LayerShownOf(veil, root);
+  Element* parent = FlatTreeTraversal::ParentElement(veil);
+  if (!parent) {
+    return nullptr;
+  }
+  Element* best = nullptr;
+  int best_hits = 0;
+  int best_z = 0;
+  bool after = false;
+  int budget = kLayerSiblingBudget;
+  for (Node* child = FlatTreeTraversal::FirstChild(*parent);
+       child && budget-- > 0; child = FlatTreeTraversal::NextSibling(*child)) {
+    if (child == &veil) {
+      after = true;
+      continue;
+    }
+    auto* element = DynamicTo<Element>(child);
+    const LayoutObject* object = element ? element->GetLayoutObject() : nullptr;
+    if (!object || !object->IsOutOfFlowPositioned()) {
+      continue;
+    }
+    const int z = object->StyleRef().EffectiveZIndex();
+    if (z < veil_z || (z == veil_z && !after)) {
+      continue;
+    }
+    // Over the veil where it shows, not elsewhere on the page (a header
+    // whose edge meets a band veil's by a pixel is not over it).
+    const gfx::RectF overlap =
+        gfx::IntersectRects(LayerShownOf(*element, root), veil_shown);
+    if (overlap.width() <= 2 || overlap.height() <= 2 ||
+        !LayerHolds(*element)) {
+      continue;
+    }
+    const wtf_size_t g = groups.Find(element);
+    const int met = g == kNotFound ? 0 : hits[g];
+    if (!best || met > best_hits || (met == best_hits && z >= best_z)) {
+      best = element;
+      best_hits = met;
+      best_z = z;
+    }
+  }
+  return best;
+}
+
+// Whether `shown` is a band along the top of the local root viewport: across
+// its width, from its top edge, under 30 % of its height -- a site header.
+bool LayerTopBand(const gfx::RectF& shown, const LocalFrame& root) {
+  const gfx::RectF viewport = ViewportRect(*root.View());
+  return !shown.IsEmpty() &&
+         shown.width() >= viewport.width() * kPageSizedShare &&
+         shown.y() <= viewport.y() + 2 &&
+         shown.height() < viewport.height() * 0.3;
+}
+
+// The panel a veil lies just under -- of its
+// out-of-flow siblings painted over it, showing over it and holding content,
+// the lowest painted: a lower z-index, else the first in order; never a site
+// header (a band along the view's top). A backdrop sits just under its own
+// panel (Bootstrap's .modal-backdrop under .modal, an offcanvas's under it),
+// and a chat launcher high above both is no one's panel. Null when none.
+Element* LayerVeilPanel(Element& veil, const LocalFrame& root) {
+  const LayoutObject* veil_object = veil.GetLayoutObject();
+  const int veil_z =
+      veil_object ? veil_object->StyleRef().EffectiveZIndex() : 0;
+  const gfx::RectF veil_shown = LayerShownOf(veil, root);
+  Element* parent = FlatTreeTraversal::ParentElement(veil);
+  if (!parent) {
+    return nullptr;
+  }
+  Element* best = nullptr;
+  int best_z = 0;
+  bool after = false;
+  int budget = kLayerSiblingBudget;
+  for (Node* child = FlatTreeTraversal::FirstChild(*parent);
+       child && budget-- > 0; child = FlatTreeTraversal::NextSibling(*child)) {
+    if (child == &veil) {
+      after = true;
+      continue;
+    }
+    auto* element = DynamicTo<Element>(child);
+    const LayoutObject* object = element ? element->GetLayoutObject() : nullptr;
+    if (!object || !object->IsOutOfFlowPositioned()) {
+      continue;
+    }
+    const int z = object->StyleRef().EffectiveZIndex();
+    if (z < veil_z || (z == veil_z && !after) || (best && z >= best_z)) {
+      continue;
+    }
+    const gfx::RectF shown = LayerShownOf(*element, root);
+    const gfx::RectF overlap = gfx::IntersectRects(shown, veil_shown);
+    if (overlap.width() <= 2 || overlap.height() <= 2 ||
+        LayerTopBand(shown, root) || !LayerHolds(*element)) {
+      continue;
+    }
+    best = element;
+    best_z = z;
+  }
+  return best;
+}
+
+// Whether `element` can be a veil's panel (LayerPanelScan): it holds content
+// and shows 1 % of the viewport, and is neither veil-sized nor around the
+// veil (a page wrapper), nor a band along the viewport's top (a site header
+// painted over a page-sized veil, which the scan's top row would meet).
+bool LayerPanelFits(Element& element,
+                    const gfx::RectF& veil_shown,
+                    const LocalFrame& root) {
+  const gfx::RectF shown = LayerShownOf(element, root);
+  if (LayerShare(shown, root) < kLayerAriaShare ||
+      LayerVeilSized(shown, root) || shown.Contains(veil_shown) ||
+      LayerTopBand(shown, root)) {
+    return false;
+  }
+  return LayerHolds(element);
+}
+
+// The panel over a veil that no probe met (a menu column can lie
+// between the probes' columns): read-only hit tests along two rows of
+// what shows of the veil -- near its top, where a menu drops, and across its
+// middle -- one every ~160 px. What one meets that is not the veil is painted
+// over it; its panel is the nearest out-of-flow box holding it that fits
+// (LayerPanelFits), or -- when the veil and it share a box below <body> --
+// the part on its side of that box (never a page wrapper beside a veil on
+// <body>). The one most points met.
+Element* LayerPanelScan(Element& veil,
+                        const gfx::RectF& shown,
+                        LocalFrame& root,
+                        Document& document) {
+  LocalFrameView* view = root.View();
+  const Element* body = document.body();
+  const Element* html = document.documentElement();
+  const int columns =
+      std::clamp(static_cast<int>(std::ceil(shown.width() / kLayerScanStep)), 4,
+                 kLayerScanColumns);
+  const float rows[2] = {shown.y() + std::min(shown.height() / 6, 120.f),
+                         shown.y() + shown.height() / 2};
+  HeapVector<Member<Element>> panels;
+  Vector<int> met;
+  bool lifecycle_clean =
+      document.Lifecycle().GetState() >= DocumentLifecycle::kPrePaintClean;
+  for (const float y : rows) {
+    for (int c = 0; c < columns; ++c) {
+      const gfx::PointF point(shown.x() + shown.width() * (c + 0.5f) / columns,
+                              y);
+      HitTestLocation location(view->ConvertFromRootFrame(point));
+      HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+          location, HitTestRequest::kReadOnly | HitTestRequest::kActive,
+          /*stop_node=*/nullptr, /*no_lifecycle_update=*/lifecycle_clean);
+      lifecycle_clean =
+          document.Lifecycle().GetState() >= DocumentLifecycle::kPrePaintClean;
+      auto* hit = DynamicTo<Element>(
+          LayerInDocument(DragTargetOf(result.InnerElement()), document));
+      if (!hit || hit == &veil || hit == body || hit == html ||
+          FlatTreeTraversal::IsDescendantOf(*hit, veil) ||
+          FlatTreeTraversal::IsDescendantOf(veil, *hit)) {
+        continue;
+      }
+      // Up past an out-of-flow box too small to be one (a badge, an icon).
+      Element* panel = nullptr;
+      Element* beside = hit;
+      for (Element* e = hit; e && e != body && e != html;
+           e = FlatTreeTraversal::ParentElement(*e)) {
+        if (FlatTreeTraversal::IsDescendantOf(veil, *e)) {
+          panel = beside;  // the box they share: the part on its side
+          break;
+        }
+        const LayoutObject* object = e->GetLayoutObject();
+        if (object && object->IsOutOfFlowPositioned() &&
+            (panels.Contains(e) || LayerPanelFits(*e, shown, root))) {
+          panel = e;
+          break;
+        }
+        beside = e;
+      }
+      if (!panel) {
+        continue;
+      }
+      const wtf_size_t i = panels.Find(panel);
+      if (i != kNotFound) {
+        ++met[i];
+        continue;
+      }
+      if (!LayerPanelFits(*panel, shown, root)) {
+        continue;
+      }
+      panels.push_back(panel);
+      met.push_back(1);
+    }
+  }
+  Element* best = nullptr;
+  int best_met = 0;
+  for (wtf_size_t i = 0; i < panels.size(); ++i) {
+    if (met[i] > best_met) {
+      best = panels[i].Get();
+      best_met = met[i];
+    }
+  }
+  return best;
+}
+
+// Scroll locked: overflow hidden or clipped on <html> or <body>, or either
+// fixed on a window that cannot scroll -- the lock that holds the page where
+// it was with `top: -Ypx` (Corriere's wall). browser:
+// the capture's documentLocked too.
+bool DocumentScrollLocked(const Document& document) {
+  const LocalFrameView* frame_view = document.View();
+  const PaintLayerScrollableArea* window =
+      frame_view ? frame_view->LayoutViewport() : nullptr;
+  const bool window_still = window && window->MaximumScrollOffset().y() <=
+                                          window->MinimumScrollOffset().y();
+  for (const Element* e :
+       {static_cast<const Element*>(document.documentElement()),
+        static_cast<const Element*>(document.body())}) {
+    const ComputedStyle* style = e ? e->GetComputedStyle() : nullptr;
+    if (style &&
+        (style->OverflowY() == EOverflow::kHidden ||
+         style->OverflowY() == EOverflow::kClip ||
+         (window_still && style->GetPosition() == EPosition::kFixed))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// What else says `layer` is one: confidence and the kind, never a verdict.
+uint32_t LayerHints(const Element& layer,
+                    const Element& semantic,
+                    const Document& document,
+                    const LocalFrame& root,
+                    const Element* veil) {
+  uint32_t hints = 0;
+  if (AriaTrue(semantic, html_names::kAriaModalAttr) ||
+      AriaTrue(layer, html_names::kAriaModalAttr)) {
+    hints |= kLayerHintAriaModal;
+  }
+  if (LayerKindOf(semantic)) {
+    hints |= kLayerHintRole;
+  }
+  if (const Element* focused = document.FocusedElement();
+      focused && HoldsAcross(layer, *focused)) {
+    hints |= kLayerHintFocusInside;
+  }
+  // Scroll locked (DocumentScrollLocked).
+  if (DocumentScrollLocked(document)) {
+    hints |= kLayerHintScrollLock;
+  }
+  // The page's other parts shut off: every other rendered child of <body> is
+  // inert or aria-hidden (Radix, MUI, React Aria and Headless UI do this).
+  // Or, the page living in the layer's own app root, every part beside the
+  // layer and beside each box holding it, up to <body> (a page's header,
+  // main and footer inert beside its dialog's container).
+  const Element* body = document.body();
+  const Element* top = &layer;
+  while (top && FlatTreeTraversal::ParentElement(*top) != body) {
+    top = FlatTreeTraversal::ParentElement(*top);
+  }
+  if (top && body) {
+    struct SiblingTally {
+      int others = 0;
+      int shown_inert = 0;
+      bool all_shut = true;
+      bool all_inert = true;
+      int budget = kLayerSiblingBudget;
+    };
+    // The parts of `parent` beside `on`, into `tally`.
+    const auto read_beside = [&root](const Element& parent, const Element& on,
+                                     SiblingTally& tally) {
+      for (Node* child = FlatTreeTraversal::FirstChild(parent);
+           child && tally.all_shut && tally.budget-- > 0;
+           child = FlatTreeTraversal::NextSibling(*child)) {
+        auto* element = DynamicTo<Element>(child);
+        const LayoutObject* object =
+            element ? element->GetLayoutObject() : nullptr;
+        if (!object || element == &on ||
+            object->StyleRef().Visibility() != EVisibility::kVisible) {
+          continue;
+        }
+        // Only parts showing 1 % of the viewport count (0x0 and
+        // 1x1 helpers beside an inert page).
+        if (LayerShare(LayerShownOf(*element, root), root) <
+            kLayerSiblingShare) {
+          continue;
+        }
+        // A backdrop beside the page holds nothing to read or act on: no
+        // part of the page left open (a lightbox beside its inert page).
+        if (!LayerHolds(*element)) {
+          continue;
+        }
+        ++tally.others;
+        const bool inert = object->StyleRef().IsInert();
+        const bool shut =
+            inert || AriaTrue(*element, html_names::kAriaHiddenAttr);
+        if (!shut) {
+          // A shown part of the page still open: neither hint.
+          tally.all_shut = false;
+          tally.all_inert = false;
+          return;
+        }
+        if (inert) {
+          ++tally.shown_inert;
+        } else {
+          tally.all_inert = false;
+        }
+      }
+    };
+    SiblingTally page;  // <body>'s other children
+    read_beside(*body, *top, page);
+    // Beside the layer and each box holding it below <body>'s level (`page`
+    // read that).
+    SiblingTally chain;
+    for (const Element* on = &layer;
+         page.all_shut && chain.all_shut && chain.budget >= 0 && on != top;) {
+      const Element* parent = FlatTreeTraversal::ParentElement(*on);
+      if (!parent) {
+        break;
+      }
+      read_beside(*parent, *on, chain);
+      on = parent;
+    }
+    const auto shut_off = [](const SiblingTally& tally) {
+      return tally.others > 0 && tally.all_shut;
+    };
+    // Inert, not only aria-hidden (which a click still reaches), and some of
+    // it with a box: the page is behind it, and no hit test can say so.
+    const auto made_inert = [](const SiblingTally& tally) {
+      return tally.others > 0 && tally.all_inert && tally.shown_inert > 0;
+    };
+    // The chain only read whole, <body>'s level too (their budgets left), and
+    // with <body>'s level shut -- an open part anywhere on the way up refuses
+    // it.
+    const bool chain_shut = chain.budget >= 0 && page.budget >= 0 &&
+                            shut_off(chain) && page.all_shut;
+    const bool chain_inert = chain_shut && made_inert(chain) && page.all_inert;
+    if (shut_off(page) || chain_shut) {
+      hints |= kLayerHintSiblingsShut;
+    }
+    if (made_inert(page)) {
+      hints |= kLayerHintSiblingsInert;
+    } else if (chain_inert) {
+      hints |= kLayerHintChainInert;
+    }
+  }
+  if (veil && HasClickListener(veil)) {
+    hints |= kLayerHintVeilClick;
+  }
+  return hints;
+}
+
+// The scan's layer becomes `root`; one found before goes on as a candidate.
+void LayerSet(LayerScan& scan, Element& root, const LayerFacts& facts) {
+  for (wtf_size_t i = 0; i < scan.roots.size(); ++i) {
+    if (scan.roots[i] == &root) {
+      scan.roots.EraseAt(i);
+      scan.facts.EraseAt(i);
+      if (i == 0) {
+        scan.has_layer = false;
+      }
+      break;
+    }
+  }
+  scan.roots.insert(0, &root);
+  scan.facts.insert(0, facts);
+  scan.has_layer = true;
+  while (scan.roots.size() > kLayerCandidates + 1) {
+    scan.roots.pop_back();
+    scan.facts.pop_back();
+  }
+}
+
+void LayerAddCandidate(LayerScan& scan,
+                       Element& root,
+                       const LayerFacts& facts) {
+  if (scan.roots.Contains(&root) ||
+      scan.roots.size() >= kLayerCandidates + (scan.has_layer ? 1 : 0)) {
+    return;
+  }
+  scan.roots.push_back(&root);
+  scan.facts.push_back(facts);
+}
+
+// Step 1: the topmost entry of the local root document's top layer
+// that the user deals with. Returns whether it is blocking (no probe then).
+bool LayerFromTopLayer(Document& document,
+                       const LocalFrame& root,
+                       LayerScan& scan) {
+  const HeapVector<Member<Element>>& entries = document.TopLayerElements();
+  for (wtf_size_t i = entries.size(); i-- > 0;) {
+    Element* entry = entries[i].Get();
+    if (!entry || entry->IsPseudoElement() ||
+        document.IsScheduledForTopLayerRemoval(entry)) {
+      continue;
+    }
+    const LayoutObject* object = entry->GetLayoutObject();
+    const gfx::RectF shown =
+        object && !object->StyleRef().IsInert() &&
+                object->StyleRef().Visibility() == EVisibility::kVisible
+            ? LayerShownOf(*entry, root)
+            : gfx::RectF();
+    if (shown.IsEmpty()) {
+      continue;
+    }
+    LayerFacts facts;
+    facts.how = "top-layer";
+    bool candidate_only = false;
+    Element* named = entry;
+    auto* html = DynamicTo<HTMLElement>(entry);
+    if (auto* dialog = DynamicTo<HTMLDialogElement>(entry);
+        dialog && dialog->IsModal()) {
+      facts.kind = LayerRoleIs(*entry, "alertdialog") ? "alert" : "dialog";
+      facts.blocking = true;
+      facts.shuts_page = true;  // the page behind a modal is inert
+      facts.page_inert = true;
+    } else if (Fullscreen::FullscreenElementFrom(document) == entry) {
+      facts.kind = "fullscreen";
+      facts.blocking = true;
+      facts.shuts_page = true;
+    } else if (HTMLSelectElement::IsPopoverPickerElement(entry)) {
+      facts.kind = "picker";
+      if (Element* host = entry->OwnerShadowHost()) {
+        named = host;
+      }
+    } else if (html && html->popoverOpen()) {
+      const char* kind = LayerKindOf(*entry);
+      facts.kind = kind ? kind : "popover";
+      switch (html->PopoverType()) {
+        case PopoverValueType::kAuto:
+          facts.blocking = LayerPageSized(shown, root);
+          break;
+        case PopoverValueType::kManual:
+          candidate_only = LayerShare(shown, root) < kLayerSmallShare;
+          break;
+        case PopoverValueType::kHint:
+        case PopoverValueType::kNone:
+          candidate_only = true;
+          break;
+      }
+    } else {
+      candidate_only = true;
+    }
+    facts.name = LayerName(*named);
+    facts.hints = LayerHints(*entry, *entry, document, root, nullptr);
+    if (candidate_only) {
+      LayerAddCandidate(scan, *entry, facts);
+      continue;
+    }
+    if (facts.blocking) {
+      // A transient one above it (a picker, a menu in a modal) stays a
+      // candidate: the modal is what shuts the page off. The page behind a
+      // modal is inert, so no probe would find the modal again.
+      LayerSet(scan, *entry, facts);
+      return true;
+    }
+    // A transient one: the layer for now; a blocking one below it, here or
+    // by the probes, takes over.
+    if (!scan.has_layer) {
+      LayerSet(scan, *entry, facts);
+    } else {
+      LayerAddCandidate(scan, *entry, facts);
+    }
+  }
+  return false;
+}
+
+// Whether `element` is what a press at the middle of its shown part meets:
+// visible, not inert, taking pointer events and on top there (one read-only
+// hit test) -- a dialog the page shows over its veil, not one under it or one
+// kept hidden.
+bool LayerOnTop(Element& element, LocalFrame& root) {
+  const LayoutObject* object = element.GetLayoutObject();
+  LocalFrameView* view = root.View();
+  Document* document = root.GetDocument();
+  if (!object || !view || !document) {
+    return false;
+  }
+  const ComputedStyle& style = object->StyleRef();
+  if (style.Visibility() != EVisibility::kVisible || style.IsInert() ||
+      style.UsedPointerEvents() == EPointerEvents::kNone) {
+    return false;
+  }
+  const gfx::RectF shown = LayerShownOf(element, root);
+  if (shown.IsEmpty()) {
+    return false;
+  }
+  HitTestLocation location(view->ConvertFromRootFrame(shown.CenterPoint()));
+  HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+      location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                    HitTestRequest::kAllowChildFrameContent);
+  auto* here = DynamicTo<Element>(
+      LayerInDocument(DragTargetOf(result.InnerElement()), *document));
+  return here && (here == &element ||
+                  FlatTreeTraversal::IsDescendantOf(*here, element));
+}
+
+// The points LayerProbe reads over what this local root shows.
+constexpr int kLayerProbes = 13;
+
+// browser: the facts of an overlay the probes grouped -- `group`, over its
+// veil `veil` (null: none) -- met at `hits` points, over page content at
+// `covering` of them; `veil_shuts`: its veil met every probe inside it.
+// None when nothing says it lies over the page -- no page content met
+// beneath it, no page behind it made inert, no veil that shuts what it
+// covers -- nor, with `blocking_only`, when it does not block.
+std::optional<LayerFacts> LayerGroupFacts(Element& group,
+                                          Element* veil,
+                                          int hits,
+                                          int covering,
+                                          bool veil_shuts,
+                                          bool blocking_only,
+                                          Document& document,
+                                          LocalFrame& root) {
+  const char* kind = nullptr;
+  Element& semantic = LayerSemanticRoot(group, kind);
+  const uint32_t hints = LayerHints(group, semantic, document, root, veil);
+  // The page behind made inert (`inert` on its other parts) cannot be hit,
+  // so no probe sees content beneath: the inert parts stand for it. Or
+  // found beside its own boxes below <body>'s level (an address dialog)
+  // when no probe met page content beneath.
+  const bool shut_behind = (hints & kLayerHintSiblingsInert) ||
+                           ((hints & kLayerHintChainInert) && covering < 1);
+  // browser: a veil that met every probe inside it, stays over the view
+  // and backs a modal lies over the page whatever is beneath it: holding
+  // nothing, it is no app shell (a test page's dialog over its veil on a
+  // page with little on it).
+  const bool veil_shut = veil && veil_shuts && (hints & kLayerModalHints) &&
+                         LayerVeilStays(*veil, document);
+  if (covering < 1 && !shut_behind && !veil_shut) {
+    return std::nullopt;
+  }
+  LayerFacts facts;
+  facts.kind = kind ? kind : "panel";
+  facts.how = veil ? "veil" : "probe";
+  facts.points_hit = std::min(hits, kLayerProbes);
+  facts.points_covering = std::min(covering, kLayerProbes);
+  facts.blocking = (facts.points_hit >= kLayerBlockingHits || veil_shuts) &&
+                   (facts.points_covering >= kLayerBlockingCovering ||
+                    shut_behind || veil_shut);
+  if (facts.blocking && !veil_shut &&
+      facts.points_covering < kLayerBlockingCovering) {
+    facts.how = "inert";
+  }
+  facts.name = LayerName(semantic);
+  facts.hints = hints;
+  if (blocking_only && !facts.blocking) {
+    return std::nullopt;
+  }
+  if (veil) {
+    facts.veil_node_id = static_cast<int32_t>(DOMNodeIds::IdForNode(veil));
+  }
+  // The page behind it shut off -- its scroll locked or its other parts
+  // inert, or a veil over the whole view -- so what is off-screen behind it
+  // is out of reach too. Or the layer itself over the whole view, staying
+  // there.
+  facts.shuts_page =
+      facts.blocking &&
+      ((hints & kLayerHintScrollLock) || shut_behind ||
+       (veil && LayerPageSized(LayerShownOf(*veil, root), root)) ||
+       LayerShutsView(group, root, document));
+  facts.page_inert = facts.blocking && shut_behind;
+  return facts;
+}
+
+// browser: the veil `facts` names; null when it has none, or that one is
+// gone.
+Element* LayerVeilOf(const LayerFacts& facts) {
+  return facts.veil_node_id ? DynamicTo<Element>(DOMNodeIds::NodeForId(
+                                  static_cast<DOMNodeId>(facts.veil_node_id)))
+                            : nullptr;
+}
+
+// Step 3: 13 read-only probes over what this local root shows; the
+// overlay most of them meet, and how many lie over page content.
+void LayerProbe(LocalFrame& root, LayerScan& scan) {
+  Document* document = root.GetDocument();
+  LocalFrameView* view = root.View();
+  if (!document || !view || !view->DidFirstLayout() ||
+      !view->LifecycleUpdatesActive()) {
+    return;
+  }
+  LayoutView* layout_view = root.ContentLayoutObject();
+  if (!layout_view) {
+    return;
+  }
+  gfx::RectF area = ViewportRect(*view);
+  if (!root.IsOutermostMainFrame()) {
+    area.Intersect(gfx::RectF(root.RemoteViewportIntersection()));
+  }
+  if (area.IsEmpty()) {
+    return;
+  }
+  static constexpr float kPoints[kLayerProbes][2] = {
+      {1.f / 6, 1.f / 6}, {0.5f, 1.f / 6},   {5.f / 6, 1.f / 6},
+      {1.f / 6, 0.5f},    {0.5f, 0.5f},      {5.f / 6, 0.5f},
+      {1.f / 6, 5.f / 6}, {0.5f, 5.f / 6},   {5.f / 6, 5.f / 6},
+      {1.f / 12, 0.5f},   {11.f / 12, 0.5f}, {0.5f, 1.f / 12},
+      {0.5f, 11.f / 12}};
+  HeapVector<Member<Element>> groups;
+  HeapVector<Member<Element>> veils;
+  Vector<int> hits;
+  Vector<int> covering;
+  // Each probe's point, its top hit, and the group its overlay went to
+  // (kNotFound: none).
+  Vector<gfx::PointF> points;
+  HeapVector<Member<Element>> probe_tops;
+  Vector<wtf_size_t> probe_groups;
+  // Pairs of overlays one probe met stacked: `above[i]` over `below[i]`.
+  HeapVector<Member<Element>> above;
+  HeapVector<Member<Element>> below;
+  // Each probe's kLayerBeneath places for the overlays met
+  // beneath its top one, in order (null: none), the element met in each, and
+  // whether page content lay beneath it; and where its walk met the page
+  // itself (null: it did not).
+  HeapVector<Member<Element>> beneath;
+  HeapVector<Member<Element>> beneath_hits;
+  Vector<bool> beneath_over;
+  HeapVector<Member<Element>> beneath_stops;
+  bool lifecycle_clean =
+      document->Lifecycle().GetState() >= DocumentLifecycle::kPrePaintClean;
+  for (const auto& p : kPoints) {
+    const gfx::PointF point(area.x() + area.width() * p[0],
+                            area.y() + area.height() * p[1]);
+    HitTestLocation location(view->ConvertFromRootFrame(point));
+    // Not into child frames: a point in a frame in this process ends the
+    // list there (LayoutEmbeddedContent::NodeAtPoint), and nothing beneath
+    // the frame would be met (a same-site consent frame would lie over
+    // nothing). A frame is a box of the page, as a frame in another process
+    // is. On the LayoutView itself, as ProbeAt does:
+    // EventHandler::HitTestResultAtLocation always adds
+    // kAllowChildFrameContent.
+    const HitTestRequest request(
+        HitTestRequest::kReadOnly | HitTestRequest::kActive |
+        HitTestRequest::kListBased | HitTestRequest::kPenetratingList);
+    HitTestResult result(request, location);
+    if (lifecycle_clean) {
+      layout_view->HitTestNoLifecycleUpdate(location, result);
+    } else {
+      layout_view->HitTest(location, result);
+    }
+    lifecycle_clean =
+        document->Lifecycle().GetState() >= DocumentLifecycle::kPrePaintClean;
+    HeapVector<Member<Node>> list;
+    for (const auto& node : result.ListBasedTestResult()) {
+      list.push_back(node);
+    }
+    Element* top = nullptr;
+    wtf_size_t from = 0;
+    for (wtf_size_t i = 0; i < list.size(); ++i) {
+      Node* node = list[i].Get();
+      auto* element = DynamicTo<Element>(node);
+      if (!element) {
+        element = FlatTreeTraversal::ParentElement(*node);
+      }
+      Node* here = LayerInDocument(DragTargetOf(element), *document);
+      if (auto* in_document = DynamicTo<Element>(here)) {
+        top = in_document;
+        from = i;
+        break;
+      }
+    }
+    bool covers = false;
+    Element* overlay =
+        top ? LayerOverlayAt(*top, list, from, *document, root, covers)
+            : nullptr;
+    // The overlays beneath it at this point, by the rule the probes group
+    // by: the panel above a veil is the overlay a probe meets with the veil
+    // under it. The first makes a pair; up to kLayerBeneath are
+    // kept, each apart from the ones before, for the layer beneath (a
+    // drawer under its confirm dialog).
+    wtf_size_t chained = 0;
+    Element* stop = nullptr;  // where the walk met the page itself
+    if (overlay) {
+      // Whether `e` is one kept here already, or inside or around one.
+      const auto kept_here = [&](const Element& e) {
+        for (wtf_size_t c = beneath.size() - chained; c < beneath.size(); ++c) {
+          const Element& held = *beneath[c];
+          if (&e == &held || FlatTreeTraversal::IsDescendantOf(e, held) ||
+              FlatTreeTraversal::IsDescendantOf(held, e)) {
+            return true;
+          }
+        }
+        return false;
+      };
+      for (wtf_size_t i = from + 1; i < list.size() && chained < kLayerBeneath;
+           ++i) {
+        Node* node = list[i].Get();
+        auto* element = DynamicTo<Element>(node);
+        if (!element) {
+          element = FlatTreeTraversal::ParentElement(*node);
+        }
+        auto* here = DynamicTo<Element>(LayerInDocument(element, *document));
+        if (!here || here == overlay ||
+            FlatTreeTraversal::IsDescendantOf(*here, *overlay) ||
+            FlatTreeTraversal::IsDescendantOf(*overlay, *here) ||
+            kept_here(*here)) {
+          continue;
+        }
+        bool beneath_covers = false;
+        Element* holder =
+            LayerOverlayAt(*here, list, i, *document, root, beneath_covers);
+        if (!holder && here != document->body() &&
+            here != document->documentElement()) {
+          // The page itself lies here: no other overlay between.
+          stop = here;
+          break;
+        }
+        if (holder && holder != overlay &&
+            !FlatTreeTraversal::IsDescendantOf(*holder, *overlay) &&
+            !FlatTreeTraversal::IsDescendantOf(*overlay, *holder) &&
+            !kept_here(*holder)) {
+          if (chained == 0) {
+            above.push_back(overlay);
+            below.push_back(holder);
+          }
+          beneath.push_back(holder);
+          beneath_hits.push_back(here);
+          beneath_over.push_back(beneath_covers);
+          ++chained;
+        }
+      }
+    }
+    for (; chained < kLayerBeneath; ++chained) {
+      beneath.push_back(nullptr);
+      beneath_hits.push_back(nullptr);
+      beneath_over.push_back(false);
+    }
+    beneath_stops.push_back(stop);
+    points.push_back(point);
+    probe_tops.push_back(top);
+    if (!overlay) {
+      probe_groups.push_back(kNotFound);
+      continue;
+    }
+    wtf_size_t g = groups.Find(overlay);
+    if (g == kNotFound) {
+      groups.push_back(overlay);
+      veils.push_back(nullptr);
+      hits.push_back(0);
+      covering.push_back(0);
+      g = groups.size() - 1;
+    }
+    probe_groups.push_back(g);
+    ++hits[g];
+    if (covers) {
+      ++covering[g];
+    }
+  }
+  // An overlay inside another that the probes met over the page is part of
+  // it: its hits are the outer one's (a backdrop inside its drawer is no box
+  // of its own). Not its "over the page" points: what lay beneath was the
+  // outer overlay's own content. The outer one must lie over the page at
+  // kLayerBlockingCovering points, so one stray point under an app shell's
+  // root never takes a modal in it.
+  Vector<wtf_size_t> joined_into(groups.size(), kNotFound);
+  for (wtf_size_t g = 0; g < groups.size(); ++g) {
+    if (hits[g] == 0) {
+      continue;
+    }
+    for (wtf_size_t o = 0; o < groups.size(); ++o) {
+      if (o == g || hits[o] == 0 || covering[o] < kLayerBlockingCovering ||
+          !FlatTreeTraversal::IsDescendantOf(*groups[g], *groups[o])) {
+        continue;
+      }
+      hits[o] += hits[g];
+      for (wtf_size_t k = 0; k < probe_groups.size(); ++k) {
+        if (probe_groups[k] == g) {
+          probe_groups[k] = o;
+        }
+      }
+      // A pair a probe met stacked names the outer one now.
+      for (wtf_size_t k = 0; k < above.size(); ++k) {
+        if (above[k] == groups[g]) {
+          above[k] = groups[o];
+        }
+        if (below[k] == groups[g]) {
+          below[k] = groups[o];
+        }
+      }
+      hits[g] = 0;
+      covering[g] = 0;
+      joined_into[g] = o;
+      break;
+    }
+  }
+  // Whether `e` lies in a site header -- a band along the view's top --
+  // which is no layer beneath, and whose probes are not a veil's.
+  const auto in_band = [&](const Element* e) {
+    for (; e && e != document->body() && e != document->documentElement();
+         e = FlatTreeTraversal::ParentElement(*e)) {
+      if (LayerTopBand(LayerShownOf(*e, root), root)) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // A veil -- holding nothing, across the viewport one way and over half of
+  // it the other -- gives way to the panel painted above it; its points are
+  // the panel's. One that met every probe inside it shuts off what it covers.
+  Vector<bool> veil_shuts(groups.size(), false);
+  for (wtf_size_t g = 0; g < groups.size(); ++g) {
+    if (hits[g] == 0) {
+      continue;  // joined another
+    }
+    Element& root_element = *groups[g];
+    const gfx::RectF veil_shown = LayerShownOf(root_element, root);
+    if (veils[g] || !LayerVeilSized(veil_shown, root) ||
+        LayerHolds(root_element)) {
+      continue;
+    }
+    // The panel: an overlay holding something that some probe met above this
+    // veil (most hits); else a sibling painted over it; else an ARIA dialog,
+    // aria-modal first, on top at its own middle.
+    Element* panel = nullptr;
+    int panel_hits = -1;
+    for (wtf_size_t k = 0; k < above.size(); ++k) {
+      if (below[k] != &root_element) {
+        continue;
+      }
+      Element* candidate = above[k].Get();
+      const wtf_size_t c = groups.Find(candidate);
+      const int met = c == kNotFound ? 0 : hits[c];
+      if (met > panel_hits && LayerHolds(*candidate)) {
+        panel = candidate;
+        panel_hits = met;
+      }
+    }
+    if (!panel) {
+      panel = LayerPanelAbove(root_element, root, groups, hits);
+    }
+    if (!panel) {
+      if (StaticElementList* marked = document->QuerySelectorAll(AtomicString(
+              "[aria-modal=true i],[role=dialog i],[role=alertdialog i]"))) {
+        for (int pass = 0; pass < 2 && !panel; ++pass) {
+          for (wtf_size_t m = 0; m < marked->length() && m < kLayerAriaBudget;
+               ++m) {
+            Element* dialog = marked->item(m);
+            if (!dialog) {
+              continue;
+            }
+            const bool modal = AriaTrue(*dialog, html_names::kAriaModalAttr);
+            if ((pass == 0) != modal || HoldsAcross(root_element, *dialog) ||
+                LayerShare(LayerShownOf(*dialog, root), root) <
+                    kLayerAriaShare ||
+                !LayerOnTop(*dialog, root)) {
+              continue;
+            }
+            panel = dialog;
+            break;
+          }
+        }
+      }
+    }
+    // Over the page somewhere, met enough to be a candidate, and no panel
+    // found so far: what the probes passed by.
+    if (!panel && covering[g] > 0 && hits[g] >= kLayerCandidateHits) {
+      panel = LayerPanelScan(root_element, veil_shown, root, *document);
+    }
+    wtf_size_t p = panel ? groups.Find(panel) : kNotFound;
+    while (p != kNotFound && joined_into[p] != kNotFound) {
+      p = joined_into[p];
+    }
+    // Every probe inside the veil met it, or met its panel -- an overlay of
+    // its own, or (a menu column inside a header, no overlay) anything in it.
+    // A probe a site header painted over the veil took is not inside it.
+    int inside = 0;
+    bool all_met = true;
+    for (wtf_size_t k = 0; k < points.size(); ++k) {
+      if (!veil_shown.Contains(points[k])) {
+        continue;
+      }
+      Element* top = probe_tops[k].Get();
+      // browser: or met it beneath the overlay on top there -- a second
+      // dialog over the same veil -- where the veil covers still.
+      bool beneath_it = false;
+      for (wtf_size_t c = 0; c < kLayerBeneath; ++c) {
+        beneath_it =
+            beneath_it || beneath[k * kLayerBeneath + c].Get() == &root_element;
+      }
+      const bool met =
+          probe_groups[k] == g || (p != kNotFound && probe_groups[k] == p) ||
+          (panel && top && HoldsAcross(*panel, *top)) || beneath_it;
+      if (met) {
+        ++inside;
+        continue;
+      }
+      if (!in_band(top)) {
+        ++inside;
+        all_met = false;
+      }
+    }
+    const bool shuts = all_met && inside >= kLayerVeilShutHits;
+    if (!panel) {
+      veil_shuts[g] = shuts;
+      continue;
+    }
+    if (p != kNotFound && p != g) {
+      hits[p] += hits[g];
+      covering[p] += covering[g];
+      veils[p] = &root_element;
+      veil_shuts[p] = shuts;
+      hits[g] = 0;
+      covering[g] = 0;
+    } else {
+      veils[g] = &root_element;
+      groups[g] = panel;
+      veil_shuts[g] = shuts;
+    }
+  }
+  for (wtf_size_t g = 0; g < groups.size(); ++g) {
+    if (hits[g] < kLayerCandidateHits) {
+      continue;
+    }
+    const std::optional<LayerFacts> facts = LayerGroupFacts(
+        *groups[g], veils[g].Get(), hits[g], covering[g], veil_shuts[g],
+        /*blocking_only=*/false, *document, root);
+    if (!facts) {
+      continue;
+    }
+    if (facts->blocking) {
+      LayerSet(scan, *groups[g], *facts);
+    } else {
+      LayerAddCandidate(scan, *groups[g], *facts);
+    }
+  }
+
+  // The blocking layer beneath the top one -- a drawer under
+  // the confirm dialog it opened -- from the overlay each probe met beneath
+  // its top one (the first neither the top one's own nor a site header),
+  // grouped as above: one inside another joins it, a veil gives way to the
+  // panel just over it, and it is blocking by the same counts. One level
+  // down, and only a blocking one, so a site header or an app shell's root
+  // beneath a modal never is.
+  const auto known_group = [&](const Element& e) {
+    for (wtf_size_t g = 0; g < groups.size(); ++g) {
+      if (groups[g].Get() == &e || veils[g].Get() == &e ||
+          (hits[g] > 0 &&
+           (HoldsAcross(*groups[g], e) || HoldsAcross(e, *groups[g])))) {
+        return true;
+      }
+    }
+    for (const auto& kept : scan.roots) {
+      if (HoldsAcross(*kept, e) || HoldsAcross(e, *kept)) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // Whether some probe met `panel`, or something in it, beneath its top one.
+  const auto met_beneath = [&](const Element& panel) {
+    for (const auto& held : beneath) {
+      if (held && HoldsAcross(panel, *held)) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // The top one's own: a part of it, or a backdrop (veil-sized, holding
+  // nothing) that is no layer beneath's -- its panel is the top one's
+  // (Bootstrap's .modal-backdrop beside its .modal), it has none (a nested
+  // modal's backdrop), or no probe met that panel beneath (a chat launcher
+  // over the backdrop). A veil alone beneath the top one holds nothing to act
+  // on, and the top one blocks there anyway. Read once each.
+  HeapVector<Member<Element>> known_seen;
+  Vector<bool> known_was;
+  const auto known = [&](Element& holder) {
+    const wtf_size_t seen = known_seen.Find(&holder);
+    if (seen != kNotFound) {
+      return known_was[seen];
+    }
+    bool is = known_group(holder);
+    if (!is && LayerVeilSized(LayerShownOf(holder, root), root) &&
+        !LayerHolds(holder)) {
+      Element* panel = LayerVeilPanel(holder, root);
+      is = !panel || known_group(*panel) || !met_beneath(*panel);
+    }
+    known_seen.push_back(&holder);
+    known_was.push_back(is);
+    return is;
+  };
+  HeapVector<Member<Element>> deep;
+  HeapVector<Member<Element>> deep_veils;
+  Vector<int> deep_hits;
+  Vector<int> deep_covering;
+  Vector<bool> deep_shuts;
+  Vector<wtf_size_t> deep_joined;
+  const auto add_deep = [&](Element* e) {
+    deep.push_back(e);
+    deep_veils.push_back(nullptr);
+    deep_hits.push_back(0);
+    deep_covering.push_back(0);
+    deep_shuts.push_back(false);
+    deep_joined.push_back(kNotFound);
+    return deep.size() - 1;
+  };
+  Vector<wtf_size_t> probe_deep(points.size(), kNotFound);
+  HeapVector<Member<Element>> probe_deep_hits;
+  Vector<bool> probe_banded(points.size(), false);
+  for (wtf_size_t k = 0; k < points.size(); ++k) {
+    Element* holder = nullptr;
+    Element* met_at = nullptr;
+    bool over = false;
+    for (wtf_size_t c = k * kLayerBeneath;
+         c < (k + 1) * kLayerBeneath && c < beneath.size(); ++c) {
+      Element* candidate = beneath[c].Get();
+      if (!candidate) {
+        break;
+      }
+      if (in_band(candidate)) {
+        probe_banded[k] = true;
+        continue;
+      }
+      if (!known(*candidate)) {
+        holder = candidate;
+        met_at = beneath_hits[c].Get();
+        over = beneath_over[c];
+        break;
+      }
+    }
+    probe_deep_hits.push_back(met_at);
+    if (!holder) {
+      continue;
+    }
+    wtf_size_t d = deep.Find(holder);
+    if (d == kNotFound) {
+      d = add_deep(holder);
+    }
+    probe_deep[k] = d;
+    ++deep_hits[d];
+    if (over) {
+      ++deep_covering[d];
+    }
+  }
+  // One inside another that lies over the page is part of it.
+  for (wtf_size_t d = 0; d < deep.size(); ++d) {
+    for (wtf_size_t o = 0; deep_hits[d] > 0 && o < deep.size(); ++o) {
+      if (o == d || deep_hits[o] == 0 ||
+          deep_covering[o] < kLayerBlockingCovering ||
+          !FlatTreeTraversal::IsDescendantOf(*deep[d], *deep[o])) {
+        continue;
+      }
+      deep_hits[o] += deep_hits[d];
+      for (wtf_size_t& at : probe_deep) {
+        if (at == d) {
+          at = o;
+        }
+      }
+      deep_hits[d] = 0;
+      deep_covering[d] = 0;
+      deep_joined[d] = o;
+    }
+  }
+  // A veil gives way to the panel just over it. It shuts what it covers when
+  // every probe inside it, but a site header's, met it or its panel beneath
+  // the top one; a veil alone says so for itself.
+  const wtf_size_t deep_met = deep.size();
+  for (wtf_size_t d = 0; d < deep_met; ++d) {
+    if (deep_hits[d] == 0) {
+      continue;
+    }
+    Element& veil = *deep[d];
+    const gfx::RectF veil_shown = LayerShownOf(veil, root);
+    if (!LayerVeilSized(veil_shown, root) || LayerHolds(veil)) {
+      continue;
+    }
+    Element* panel = LayerVeilPanel(veil, root);
+    wtf_size_t p = panel ? deep.Find(panel) : kNotFound;
+    while (p != kNotFound && deep_joined[p] != kNotFound) {
+      p = deep_joined[p];
+    }
+    if (panel && p == kNotFound) {
+      p = add_deep(panel);
+    }
+    int inside = 0;
+    bool all_met = true;
+    for (wtf_size_t k = 0; k < points.size(); ++k) {
+      if (!veil_shown.Contains(points[k]) || probe_banded[k] ||
+          in_band(beneath_stops[k].Get()) || in_band(probe_tops[k].Get())) {
+        continue;
+      }
+      ++inside;
+      const Element* met_at = probe_deep_hits[k].Get();
+      if (probe_deep[k] != d && (p == kNotFound || probe_deep[k] != p) &&
+          !(panel && met_at && HoldsAcross(*panel, *met_at))) {
+        all_met = false;
+      }
+    }
+    const bool shuts = all_met && inside >= kLayerVeilShutHits;
+    if (p == kNotFound) {
+      deep_shuts[d] = shuts;
+      continue;
+    }
+    deep_hits[p] += deep_hits[d];
+    deep_covering[p] += deep_covering[d];
+    deep_veils[p] = &veil;
+    deep_shuts[p] = shuts;
+    for (wtf_size_t& at : probe_deep) {
+      if (at == d) {
+        at = p;
+      }
+    }
+    deep_hits[d] = 0;
+    deep_covering[d] = 0;
+    deep_joined[d] = p;
+  }
+  for (wtf_size_t d = 0; d < deep.size(); ++d) {
+    if (deep_hits[d] < kLayerCandidateHits) {
+      continue;
+    }
+    // browser: as the top overlays' loop, the blocking ones alone.
+    const std::optional<LayerFacts> facts = LayerGroupFacts(
+        *deep[d], deep_veils[d].Get(), deep_hits[d], deep_covering[d],
+        deep_shuts[d], /*blocking_only=*/true, *document, root);
+    if (!facts) {
+      continue;
+    }
+    // Over a candidate that does not block, when the scan is full:
+    // the layer beneath that blocks is what the user deals with.
+    const wtf_size_t kept_from = scan.has_layer ? 1 : 0;
+    if (scan.roots.size() >= kLayerCandidates + kept_from) {
+      for (wtf_size_t r = scan.roots.size(); r-- > kept_from;) {
+        if (!scan.facts[r].blocking) {
+          scan.roots.EraseAt(r);
+          scan.facts.EraseAt(r);
+          break;
+        }
+      }
+    }
+    LayerAddCandidate(scan, *deep[d], *facts);
+  }
+  // The stack's order (LayerAbove).
+  scan.above = std::move(above);
+  scan.below = std::move(below);
+}
+
+// Step 4: ARIA dialogs and modals shown on the page that no probe
+// met -- candidates only: a hint never makes a layer by itself.
+void LayerFromAria(Document& document, LocalFrame& root, LayerScan& scan) {
+  // Light DOM only: a dialog in a shadow tree is the probes' to find.
+  StaticElementList* marked = document.QuerySelectorAll(
+      AtomicString("[aria-modal=true i],[role=dialog i],[role=alertdialog i],"
+                   "dialog[open]"));
+  if (!marked) {
+    return;
+  }
+  for (wtf_size_t i = 0; i < marked->length() && i < kLayerAriaBudget; ++i) {
+    if (scan.roots.size() >= kLayerCandidates + (scan.has_layer ? 1 : 0)) {
+      break;
+    }
+    Element* element = marked->item(i);
+    if (!element || scan.roots.Contains(element)) {
+      continue;
+    }
+    // Inside one kept already, or around one (a role=dialog wrapper around
+    // the fixed root the probes found): the same layer.
+    bool inside = false;
+    for (const auto& kept : scan.roots) {
+      if (HoldsAcross(*kept, *element) || HoldsAcross(*element, *kept)) {
+        inside = true;
+        break;
+      }
+    }
+    if (inside ||
+        LayerShare(LayerShownOf(*element, root), root) < kLayerAriaShare) {
+      continue;
+    }
+    LayerFacts facts;
+    const char* kind = LayerKindOf(*element);
+    facts.kind = kind ? kind : "dialog";
+    facts.how = "aria";
+    facts.name = LayerName(*element);
+    facts.hints = LayerHints(*element, *element, document, root, nullptr);
+    // browser: a modal one shown on top over the veil of a layer that
+    // blocks -- two dialogs over one veil -- blocks with it, under
+    // that veil: what lies behind it lies behind the veil. Over that layer
+    // where it shows, it is the higher of the two (LayerAbove's pairs).
+    const bool modal = (facts.hints & kLayerHintAriaModal) ||
+                       LayerRoleIs(*element, "alertdialog");
+    for (wtf_size_t k = 0; modal && k < scan.roots.size(); ++k) {
+      const LayerFacts& kept = scan.facts[k];
+      Element* veil = kept.blocking ? LayerVeilOf(kept) : nullptr;
+      const gfx::PointF middle = LayerShownOf(*element, root).CenterPoint();
+      if (veil && LayerShownOf(*veil, root).Contains(middle) &&
+          LayerOnTop(*element, root)) {
+        facts.how = "veil";
+        facts.blocking = true;
+        facts.veil_node_id = kept.veil_node_id;
+        facts.shuts_page = kept.shuts_page;
+        if (LayerShownOf(*scan.roots[k], root).Contains(middle)) {
+          scan.above.insert(0, element);
+          scan.below.insert(0, scan.roots[k].Get());
+        }
+        break;
+      }
+    }
+    LayerAddCandidate(scan, *element, facts);
+  }
+}
+
+// browser: whether `popup` is drawn over the page: a box out of flow, or
+// one in the top layer, from it up to (not including) what holds `opener`. A
+// list or menu in the page's flow overlays nothing.
+bool LayerPopupOverlays(const Element& popup, const Element& opener) {
+  for (const Element* element = &popup;
+       element && !HoldsAcross(*element, opener);
+       element = FlatTreeTraversal::ParentElement(*element)) {
+    const LayoutObject* object = element->GetLayoutObject();
+    if (element->IsInTopLayer() ||
+        (object && object->IsOutOfFlowPositioned())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// browser: a layer that comes and goes with what the user does -- a
+// menu, a list, a popover, a picker -- and blocks nothing.
+bool LayerPassing(const LayerFacts& facts) {
+  if (facts.blocking) {
+    return false;
+  }
+  for (const char* kind : {"menu", "listbox", "popover", "picker"}) {
+    if (EqualIgnoringAsciiCase(StringView(facts.kind), StringView(kind))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// browser: the WAI-ARIA popup pattern -- the listbox or menu
+// a rendered element shown expanded (aria-expanded=true) names in
+// aria-controls or aria-owns -- drawn over the page and on top at its middle:
+// a candidate the probes may miss (a 300 x 200 suggestion list under its
+// field), never blocking. The same layer as a kept root inside it, or one
+// holding it that does not hold its opener (a library's wrapper the probes
+// found) or that passes as it does (a searchable select's popover); a dialog
+// holding the field and its list leaves the list a layer of its own, over the
+// dialog (LayerAbove). After LayerFromAria: a dialog no probe met that holds
+// both is kept first.
+void LayerFromPopups(Document& document, LocalFrame& root, LayerScan& scan) {
+  // Light DOM only, as LayerFromAria: one in a shadow tree is the probes'.
+  StaticElementList* openers = document.QuerySelectorAll(
+      AtomicString("[aria-expanded=true i][aria-controls],"
+                   "[aria-expanded=true i][aria-owns]"));
+  if (!openers) {
+    return;
+  }
+  for (wtf_size_t i = 0; i < openers->length() && i < kLayerPopupOpeners; ++i) {
+    Element* opener = openers->item(i);
+    if (!opener || !opener->GetLayoutObject()) {
+      continue;
+    }
+    for (const QualifiedName* attribute :
+         {&html_names::kAriaControlsAttr, &html_names::kAriaOwnsAttr}) {
+      const AtomicString& ids = opener->FastGetAttribute(*attribute);
+      if (ids.empty()) {
+        continue;
+      }
+      for (const String& id : ids.GetString().SimplifyWhiteSpace().Split(' ')) {
+        if (scan.roots.size() >= kLayerCandidates + (scan.has_layer ? 1 : 0)) {
+          return;
+        }
+        Element* popup =
+            opener->GetTreeScope().getElementById(AtomicString(id));
+        if (!popup || scan.roots.Contains(popup) ||
+            (!LayerRoleIs(*popup, "listbox") && !LayerRoleIs(*popup, "menu")) ||
+            !LayerPopupOverlays(*popup, *opener) ||
+            LayerShare(LayerShownOf(*popup, root), root) < kLayerPopupShare ||
+            !LayerOnTop(*popup, root)) {
+          continue;
+        }
+        bool same = false;
+        for (wtf_size_t k = 0; k < scan.roots.size(); ++k) {
+          const Element& kept = *scan.roots[k];
+          if (HoldsAcross(*popup, kept) ||
+              (HoldsAcross(kept, *popup) &&
+               (!HoldsAcross(kept, *opener) || LayerPassing(scan.facts[k])))) {
+            same = true;
+            break;
+          }
+        }
+        if (same) {
+          continue;
+        }
+        LayerFacts facts;
+        facts.kind = LayerKindOf(*popup);
+        facts.how = "aria";
+        facts.name = LayerName(*popup);
+        facts.hints = LayerHints(*popup, *popup, document, root, nullptr);
+        LayerAddCandidate(scan, *popup, facts);
+      }
+    }
+  }
+}
+
+// Whether the scan's root `a` lies over its root `b`: a top-layer entry over
+// anything else, the later one higher; else a pair some probe met stacked;
+// else one inside the other (the inner over it); else the higher z-index;
+// else the later in the document.
+bool LayerAbove(const LayerScan& scan,
+                wtf_size_t a,
+                wtf_size_t b,
+                const Document& document) {
+  const Element& ea = *scan.roots[a];
+  const Element& eb = *scan.roots[b];
+  // An entry holds what is in it, and its veil (a pair a probe met names the
+  // veil it met, not the panel that took its points). browser: not a veil
+  // both lie over: a pair over it says nothing between them.
+  const bool one_veil =
+      scan.facts[a].veil_node_id &&
+      scan.facts[a].veil_node_id == scan.facts[b].veil_node_id;
+  const auto holds = [&scan, one_veil](wtf_size_t i, const Element& element) {
+    const int32_t veil = one_veil ? 0 : scan.facts[i].veil_node_id;
+    return HoldsAcross(*scan.roots[i], element) ||
+           (veil && static_cast<int32_t>(
+                        DOMNodeIds::ExistingIdForNode(&element)) == veil);
+  };
+  const HeapVector<Member<Element>>& top = document.TopLayerElements();
+  const wtf_size_t ta = top.Find(&ea);
+  const wtf_size_t tb = top.Find(&eb);
+  // browser: one held by a top-layer entry and not in the top layer
+  // itself lies over it: an open list in a showModal() dialog.
+  if (ta != kNotFound && tb == kNotFound && HoldsAcross(ea, eb)) {
+    return false;
+  }
+  if (tb != kNotFound && ta == kNotFound && HoldsAcross(eb, ea)) {
+    return true;
+  }
+  if (ta != kNotFound || tb != kNotFound) {
+    if (ta == kNotFound) {
+      return false;
+    }
+    if (tb == kNotFound) {
+      return true;
+    }
+    return ta > tb;
+  }
+  for (wtf_size_t k = 0; k < scan.above.size(); ++k) {
+    const Element& up = *scan.above[k];
+    const Element& down = *scan.below[k];
+    if (holds(a, up) && holds(b, down)) {
+      return true;
+    }
+    if (holds(b, up) && holds(a, down)) {
+      return false;
+    }
+  }
+  if (HoldsAcross(eb, ea)) {
+    return true;  // `a` inside `b`
+  }
+  if (HoldsAcross(ea, eb)) {
+    return false;
+  }
+  const LayoutObject* la = ea.GetLayoutObject();
+  const LayoutObject* lb = eb.GetLayoutObject();
+  const int za = la ? la->StyleRef().EffectiveZIndex() : 0;
+  const int zb = lb ? lb->StyleRef().EffectiveZIndex() : 0;
+  if (za != zb) {
+    return za > zb;
+  }
+  return eb.compareDocumentPosition(&ea, Node::kTreatShadowTreesAsComposed) &
+         Node::kDocumentPositionFollowing;
+}
+
+// The layers open on `root`, bottom to top (scan.stack): every root the
+// scan kept -- an ARIA dialog only where it is on top at its middle: one under
+// another layer, or kept hidden, is not open.
+void LayerStack(LocalFrame& root, LayerScan& scan) {
+  Document* document = root.GetDocument();
+  if (!document) {
+    return;
+  }
+  for (wtf_size_t i = 0; i < scan.roots.size(); ++i) {
+    if (EqualIgnoringAsciiCase(StringView(scan.facts[i].how),
+                               StringView("aria")) &&
+        !LayerOnTop(*scan.roots[i], root)) {
+      continue;
+    }
+    scan.stack.push_back(i);
+    for (wtf_size_t k = scan.stack.size() - 1;
+         k > 0 && LayerAbove(scan, scan.stack[k - 1], scan.stack[k], *document);
+         --k) {
+      std::swap(scan.stack[k - 1], scan.stack[k]);
+    }
+  }
+}
+
+// The layer and the candidates on `root`'s own document. A child
+// document's own top layer is not read here.
+void DetectLayer(LocalFrame& root, LayerScan& scan) {
+  Document* document = root.GetDocument();
+  if (!document || !root.View()) {
+    return;
+  }
+  // Not in a frame that shows under a tenth of the page -- an ad, a widget:
+  // no page's layer, and fifty of them cost more than the page.
+  // Its document name is still read (a small consent frame in a container
+  // names the wall), unless the page never placed it.
+  if (!root.IsOutermostMainFrame()) {
+    const gfx::Size page = root.GetOutermostMainFrameSize();
+    const gfx::Rect shown = root.RemoteViewportIntersection();
+    const double page_area = static_cast<double>(page.width()) * page.height();
+    // A frame nested in one the page does not draw is never told the page's
+    // size, nor shown (an ad's sync frames: a page may hold hundreds).
+    const double share = page_area > 0 ? static_cast<double>(shown.width()) *
+                                             shown.height() / page_area
+                                       : 0;
+    if (share < kLayerFrameShare) {
+      if (page_area <= 0) {
+        scan.placed = false;
+      }
+      return;
+    }
+  }
+  // The style and layout the capture brings up moments later anyway
+  // (CollectFrameDocumentElements): a dialog opened in this task has a box,
+  // and nothing below reads a dirty tree.
+  document->UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  const bool top_blocking = LayerFromTopLayer(*document, root, scan);
+  if (!top_blocking) {
+    LayerProbe(root, scan);
+  }
+  LayerFromAria(*document, root, scan);
+  LayerFromPopups(*document, root, scan);
+  LayerStack(root, scan);
+}
+
+// browser: when `hit` lies in the veil of a layer open on `root` -- its
+// backdrop, beside its box -- that `element` is not in, that layer named as
+// the listing's layers are, its kind in `kind`; empty when none does. The top
+// layer's veil first; a veil whose layer holds `element` names nothing. Every
+// veil is a box fixed to the view or out of flow (LayerOverlayAt's holders),
+// of a veil's size (LayerVeilSized), holding nothing, so the layer detection
+// runs only when `hit` or a box above it in its document, below its <body>,
+// is such a box.
+String VeilLayerName(LocalFrame& root,
+                     Element& hit,
+                     const Element& element,
+                     const char*& kind) {
+  const Document& document = hit.GetDocument();
+  bool sized = false;
+  for (const Element* e = &hit;
+       e && e != document.body() && e != document.documentElement();
+       e = FlatTreeTraversal::ParentElement(*e)) {
+    const auto* box = DynamicTo<LayoutBox>(e->GetLayoutObject());
+    if (box && (box->IsFixedToView() || box->IsOutOfFlowPositioned()) &&
+        LayerVeilSized(LayerShownOf(*e, root), root)) {
+      sized = true;
+      break;
+    }
+  }
+  if (!sized) {
+    return String();
+  }
+  LayerScan scan;
+  DetectLayer(root, scan);
+  for (wtf_size_t k = scan.stack.size(); k-- > 0;) {
+    const wtf_size_t s = scan.stack[k];
+    Element* veil_element = LayerVeilOf(scan.facts[s]);
+    if (veil_element && HoldsAcross(*veil_element, hit)) {
+      if (HoldsAcross(*scan.roots[s], element)) {
+        return String();
+      }
+      kind = scan.facts[s].kind;
+      return LayerKindName(scan.facts[s].kind, scan.facts[s].name);
+    }
+  }
+  return String();
+}
+
+// How long a running finite animation has left, from its
+// specified timing and current time, at its playback rate -- as the settle
+// reads it (AgentSettleWatcher's SecondsLeft).
+double LayerSecondsLeft(const Animation& animation, const Timing& timing) {
+  const std::optional<AnimationTimeDelta> current =
+      animation.CurrentTimeInternal();
+  if (!current) {
+    return 0;
+  }
+  const double duration =
+      timing.iteration_duration ? timing.iteration_duration->InSecondsF() : 0;
+  const double end = timing.start_delay.AsTimeValue().InSecondsF() +
+                     duration * timing.iteration_count +
+                     timing.end_delay.AsTimeValue().InSecondsF();
+  const double rate = animation.playbackRate();
+  if (rate > 0) {
+    return std::max(0.0, (end - current->InSecondsF()) / rate);
+  }
+  if (rate < 0) {
+    return std::max(0.0, current->InSecondsF() / -rate);
+  }
+  return 0;  // paused: not opening or closing
+}
+
+// The longest time left, in ms, of a finite animation or transition running
+// on the layer `root` -- on it, on what holds it, on its veil, or on a box
+// inside it showing half of what it shows (a drawer sliding in its wrapper);
+// 0 when none. A layer fading or sliding out is met until it ends, so a read
+// just after an action finds it still open: a caller reads again after this
+// to wait out the exit.
+int32_t LayerAnimatingMs(const Element& root,
+                         int32_t veil_node_id,
+                         const LocalFrame& frame) {
+  const double root_share = LayerShare(LayerShownOf(root, frame), frame);
+  const Document& document = root.GetDocument();
+  double longest = 0;
+  for (const auto& member : document.Timeline().GetAnimations()) {
+    const Animation* animation = member.Get();
+    if (!animation || !animation->Playing()) {
+      continue;
+    }
+    const auto* effect = DynamicTo<KeyframeEffect>(animation->effect());
+    const Element* target = effect ? effect->target() : nullptr;
+    if (!target || !target->GetLayoutObject()) {
+      continue;
+    }
+    const Timing& timing = effect->SpecifiedTiming();
+    if (!std::isfinite(timing.iteration_count)) {
+      continue;
+    }
+    // What holds it, below <body>: a page's own fade on <html> or <body> is
+    // no layer's.
+    const bool on =
+        target == &root ||
+        (target != document.body() && target != document.documentElement() &&
+         HoldsAcross(*target, root)) ||
+        (veil_node_id && static_cast<int32_t>(DOMNodeIds::ExistingIdForNode(
+                             target)) == veil_node_id) ||
+        (root_share > 0 && HoldsAcross(root, *target) &&
+         LayerShare(LayerShownOf(*target, frame), frame) >= root_share * 0.5);
+    // Not an endless one either: an infinite duration.
+    const double left = on ? LayerSecondsLeft(*animation, timing) : 0;
+    if (std::isfinite(left)) {
+      longest = std::max(longest, left);
+    }
+  }
+  return static_cast<int32_t>(std::lround(std::min(longest, 60.0) * 1000));
+}
+
+// browser: one found layer as the reply carries it.
+mojom::blink::AgentLayerPtr LayerReply(const Element& root,
+                                       const LayerFacts& facts) {
+  auto layer = mojom::blink::AgentLayer::New();
+  layer->kind = facts.kind;
+  layer->name = NonNull(facts.name);
+  layer->how = facts.how;
+  layer->blocking = facts.blocking;
+  layer->points_hit = facts.points_hit;
+  layer->points_covering = facts.points_covering;
+  layer->hints = facts.hints;
+  layer->root_node_id =
+      static_cast<int32_t>(DOMNodeIds::IdForNode(const_cast<Element*>(&root)));
+  // browser.
+  layer->veil_node_id = facts.veil_node_id;
+  layer->head = NonNull(
+      LayerTextName(const_cast<Element&>(root), nullptr, kLayerHeadLength));
+  layer->shuts_page = facts.shuts_page;
+  return layer;
+}
+
+// The DevTools tokens of the frames, in this process or another, whose
+// element `root` holds.
+Vector<String> LayerFrameIds(const Element& root,
+                             const HeapVector<Member<LocalFrame>>& frames) {
+  Vector<String> ids;
+  for (LocalFrame* frame : frames) {
+    for (Frame* child = frame->FirstChild(); child;
+         child = child->NextSibling()) {
+      auto* owner = DynamicTo<HTMLFrameOwnerElement>(child->Owner());
+      if (owner && owner->isConnected() && HoldsAcross(root, *owner)) {
+        ids.push_back(String(child->GetDevToolsFrameToken().ToString()));
+      }
+    }
+  }
+  return ids;
+}
+
+// browser: `scan`'s stack as the reply carries it, into `result`, and the
+// document's head and name (an iframe wall's, when the frame is all layer);
+// `frames`: the local root's same-process frames.
+void AppendLayerStack(const LayerScan& scan,
+                      const HeapVector<Member<LocalFrame>>& frames,
+                      LocalFrame& root_frame,
+                      Document& root_document,
+                      mojom::blink::AgentFrameSnapshot& result) {
+  for (const wtf_size_t i : scan.stack) {
+    mojom::blink::AgentLayerPtr layer =
+        LayerReply(*scan.roots[i], scan.facts[i]);
+    layer->frame_ids = LayerFrameIds(*scan.roots[i], frames);
+    // Whether it is opening or closing.
+    layer->animating_ms = LayerAnimatingMs(
+        *scan.roots[i], scan.facts[i].veil_node_id, root_frame);
+    result.layers.push_back(std::move(layer));
+  }
+  if (Element* body = root_document.body(); body && scan.placed) {
+    result.document_head =
+        NonNull(LayerTextName(*body, nullptr, kLayerHeadLength));
+    // Not its open layer's name; a frame that is all layer (an iframe
+    // wall's) keeps it.
+    Element* layer_root = scan.has_layer ? scan.roots[0].Get() : nullptr;
+    String name = LayerName(*body, layer_root);
+    if (name.empty() && layer_root) {
+      name = LayerName(*body);
+    }
+    result.document_name = NonNull(name);
+  }
+}
+
+// browser: the layer stack of `root_frame`, a local root, as a
+// layers_only capture answers it, into `result`, with the document's name;
+// `scan` keeps what was found, for a later pass over the same layers.
+void ReadLayerStack(LocalFrame& root_frame,
+                    Document& root_document,
+                    LayerScan& scan,
+                    mojom::blink::AgentFrameSnapshot& result) {
+  DetectLayer(root_frame, scan);
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(&root_frame, frames);
+  AppendLayerStack(scan, frames, root_frame, root_document, result);
+}
+
+// browser: the innermost entry of `scan`'s stack whose root holds
+// `element`; -1 when none does.
+int32_t InnermostEntry(const LayerScan& scan, const Element& element) {
+  for (wtf_size_t k = scan.stack.size(); k-- > 0;) {
+    if (HoldsAcross(*scan.roots[scan.stack[k]], element)) {
+      return static_cast<int32_t>(k);
+    }
+  }
+  return -1;
+}
+
+// ------------------------------------------ browser: the control census
+
+// The most controls one local root's census lists; past it the census says it
+// stopped short.
+constexpr wtf_size_t kCensusMax = 400;
+// The most nodes it walks on one local root.
+constexpr wtf_size_t kCensusNodeBudget = 50000;
+// Its time on one local root, from the report's read, at most: past it the
+// census stops short, so it never makes the part late -- the browser waits
+// 400 ms for a part and drops one that comes after, its regions and layers
+// with it.
+constexpr base::TimeDelta kCensusTime = base::Milliseconds(150);
+// How many nodes the walk takes between looks at the clock.
+constexpr wtf_size_t kCensusClockEvery = 256;
+// A control's label, at most.
+constexpr wtf_size_t kCensusLabelChars = 80;
+
+// A control's first label in tree order, by the control: one naming it with
+// `for`, or one holding it.
+using CensusLabels = HeapHashMap<Member<Element>, Member<Element>>;
+
+// The role the census gives `element`, empty for one that is none of its
+// controls: a field role or button from its role attribute, else from what it
+// is -- an input by its type, a select, a textarea, a button, an editable
+// region. Links are not controls here, nor a list a field opens (role
+// listbox: an autocomplete's suggestions are its field's popup). `button` says
+// which kind it is.
+String CensusRole(Element& element, bool& button) {
+  button = false;
+  const String aria = FirstRole(element);
+  if (aria == "button") {
+    button = true;
+    return aria;
+  }
+  if (IsFieldRole(aria)) {
+    return aria;
+  }
+  if (auto* input = DynamicTo<HTMLInputElement>(element)) {
+    using Type = mojom::blink::FormControlType;
+    switch (input->FormControlType()) {
+      case Type::kInputHidden:
+        return String();
+      case Type::kInputButton:
+      case Type::kInputImage:
+      case Type::kInputReset:
+      case Type::kInputSubmit:
+        button = true;
+        return "button";
+      case Type::kInputCheckbox:
+        return "checkbox";
+      case Type::kInputRadio:
+        return "radio";
+      case Type::kInputRange:
+        return "slider";
+      case Type::kInputNumber:
+        return "spinbutton";
+      case Type::kInputSearch:
+        return "searchbox";
+      case Type::kInputColor:
+      case Type::kInputDate:
+      case Type::kInputDatetimeLocal:
+      case Type::kInputFile:
+      case Type::kInputMonth:
+      case Type::kInputTime:
+      case Type::kInputWeek:
+        return input->type();
+      default:
+        return "textbox";
+    }
+  }
+  if (IsA<HTMLTextAreaElement>(element)) {
+    return "textbox";
+  }
+  if (auto* select = DynamicTo<HTMLSelectElement>(element)) {
+    return select->UsesMenuList() ? "combobox" : "listbox";
+  }
+  if (element.HasTagName(html_names::kButtonTag)) {
+    button = true;
+    return "button";
+  }
+  if (IsEditingHost(&element)) {
+    return "textbox";
+  }
+  return String();
+}
+
+// A control's label as the census reads it: the first that says something of
+// its first label naming it with `for` (`named_by`), its first label holding
+// it (`held_by`), its aria-labelledby targets' text, aria-label, placeholder
+// and title; for a button then its own text or value; last its name
+// attribute. A DOM rule, the same in two reads of one page, which the census's
+// comparison needs; it can differ from the accessible name a listing gives.
+String CensusLabel(Element& element,
+                   bool button,
+                   const CensusLabels& named_by,
+                   const CensusLabels& held_by) {
+  const auto said = [](const String& raw) {
+    return CutReads(CleanName(raw), kCensusLabelChars);
+  };
+  for (const CensusLabels* labels : {&named_by, &held_by}) {
+    if (auto it = labels->find(&element); it != labels->end()) {
+      if (String text = said(SourceText(*it->value)); !text.empty()) {
+        return text;
+      }
+    }
+  }
+  const AtomicString& labelledby =
+      element.FastGetAttribute(html_names::kAriaLabelledbyAttr);
+  if (!labelledby.empty()) {
+    StringBuilder joined;
+    wtf_size_t taken = 0;
+    for (const String& id :
+         labelledby.GetString().SimplifyWhiteSpace().Split(' ')) {
+      if (taken++ >= kReadsSources) {
+        break;
+      }
+      Element* source = element.GetTreeScope().getElementById(AtomicString(id));
+      const String text =
+          source ? CleanName(LabelledByText(*source)) : String();
+      if (!text.empty()) {
+        if (!joined.empty()) {
+          joined.Append(' ');
+        }
+        joined.Append(text);
+      }
+    }
+    if (String text = said(joined.ToString()); !text.empty()) {
+      return text;
+    }
+  }
+  for (const QualifiedName* name :
+       {&html_names::kAriaLabelAttr, &html_names::kPlaceholderAttr,
+        &html_names::kTitleAttr}) {
+    if (String text = said(element.FastGetAttribute(*name).GetString());
+        !text.empty()) {
+      return text;
+    }
+  }
+  if (button) {
+    // Never a field's value: an input's own words only when it is a button.
+    auto* input = DynamicTo<HTMLInputElement>(element);
+    const String own = !input                  ? SourceText(element)
+                       : input->IsTextButton() ? input->Value()
+                                               : String();
+    if (String text = said(own); !text.empty()) {
+      return text;
+    }
+  }
+  return said(element.FastGetAttribute(html_names::kNameAttr).GetString());
+}
+
+// The controls of `document`, appended to `out` in tree order, walked as the
+// capture's first pass walks it: into open and closed shadow trees, not into a
+// form control's own one, nor into child frames. One counts when it has a
+// layout object, visibility visible, no display lock hiding it and a box;
+// inert and pointer-events count for nothing, so the page behind a modal
+// keeps its controls. Each label met on the way is kept for the control it
+// names, so no control asks for its labels (a walk of its whole tree scope
+// each). `scan`: the report's own layer read, whose innermost layer holding a
+// control is its `layer`; null when none was made. `nodes` and `cut`: the
+// walk's count across the local root, and whether it stopped short (the
+// budget, the cap, or `deadline`).
+void CensusDocument(Document& document,
+                    const LayerScan* scan,
+                    base::TimeTicks deadline,
+                    Vector<mojom::blink::AgentControlReadPtr>& out,
+                    wtf_size_t& nodes,
+                    bool& cut) {
+  HeapVector<Member<Element>> controls;
+  CensusLabels named_by;
+  CensusLabels held_by;
+  HeapVector<Member<Node>> stack;
+  const auto push_children = [&stack](ContainerNode& parent) {
+    for (Node* child = parent.lastChild(); child;
+         child = child->previousSibling()) {
+      stack.push_back(child);
+    }
+  };
+  push_children(*document.documentElement());
+  while (!stack.empty()) {
+    if (++nodes > kCensusNodeBudget ||
+        (nodes % kCensusClockEvery == 0 && base::TimeTicks::Now() > deadline)) {
+      cut = true;
+      break;
+    }
+    Node* node = stack.back();
+    stack.pop_back();
+    if (auto* container = DynamicTo<ContainerNode>(node)) {
+      push_children(*container);
+    }
+    auto* element = DynamicTo<Element>(node);
+    if (!element) {
+      continue;
+    }
+    if (ShadowRoot* shadow_root = element->GetShadowRoot();
+        shadow_root &&
+        !(shadow_root->IsUserAgent() && element->IsFormControlElement())) {
+      push_children(*shadow_root);
+    }
+    if (auto* label = DynamicTo<HTMLLabelElement>(element)) {
+      if (HTMLElement* labelled = label->Control()) {
+        // The first in tree order of each kind stays.
+        (label->FastHasAttribute(html_names::kForAttr) ? named_by : held_by)
+            .insert(labelled, label);
+      }
+    }
+    const LayoutObject* layout_object = element->GetLayoutObject();
+    if (!layout_object ||
+        layout_object->StyleRef().Visibility() != EVisibility::kVisible) {
+      continue;
+    }
+    bool button = false;
+    if (CensusRole(*element, button).empty()) {
+      continue;
+    }
+    // A section the page skips drawing while it is off-screen
+    // (content-visibility: auto) still holds its controls, whatever its stale
+    // boxes say; a lock that hides what it holds (content-visibility: hidden, a
+    // closed <details>) does not.
+    bool offscreen = false;
+    bool hidden = false;
+    for (const Element* lock =
+             DisplayLockUtilities::LockedInclusiveAncestorPreventingPaint(
+                 *element);
+         lock;
+         lock = DisplayLockUtilities::LockedAncestorPreventingPaint(*lock)) {
+      const DisplayLockContext* context = lock->GetDisplayLockContext();
+      if (!context || !context->IsAuto()) {
+        hidden = true;
+        break;
+      }
+      offscreen = true;
+    }
+    if (hidden ||
+        (!offscreen &&
+         element->GetBoundingClientRectNoLifecycleUpdate().IsEmpty())) {
+      continue;
+    }
+    if (out.size() + controls.size() >= kCensusMax) {
+      cut = true;
+      break;
+    }
+    controls.push_back(element);
+  }
+  for (Element* element : controls) {
+    bool button = false;
+    const String role = CensusRole(*element, button);
+    auto control = mojom::blink::AgentControlRead::New();
+    control->node_id = static_cast<int32_t>(DOMNodeIds::IdForNode(element));
+    // Its box in the local root's coordinates, as the capture's first pass
+    // places an element.
+    const gfx::RectF rect = element->GetBoundingClientRectNoLifecycleUpdate();
+    const gfx::PointF top_left =
+        document.View()->ConvertToRootFrame(rect.origin());
+    control->x = top_left.x();
+    control->y = top_left.y();
+    control->width = rect.width();
+    control->height = rect.height();
+    control->button = button;
+    control->role = role;
+    control->label = NonNull(CensusLabel(*element, button, named_by, held_by));
+    // As ElementStates reads them.
+    control->disabled = element->IsDisabledFormControl() ||
+                        AriaTrue(*element, html_names::kAriaDisabledAttr);
+    control->readonly = element->FastHasAttribute(html_names::kReadonlyAttr) ||
+                        AriaTrue(*element, html_names::kAriaReadonlyAttr);
+    control->required = element->FastHasAttribute(html_names::kRequiredAttr) ||
+                        AriaTrue(*element, html_names::kAriaRequiredAttr);
+    const auto* input = DynamicTo<HTMLInputElement>(element);
+    control->checked = (input && input->IsCheckable())
+                           ? input->Checked()
+                           : AriaTrue(*element, html_names::kAriaCheckedAttr);
+    control->secret = input && IsCardSecretInput(*input);
+    if (scan) {
+      control->layer = InnermostEntry(*scan, *element);
+    }
+    if (!button) {
+      control->validity = ReadValidity(*element);
+    }
+    out.push_back(std::move(control));
+  }
+}
+
+// The control census of local root `root`: every rendered, visible field and
+// button of its documents, frame by frame as CollectSameProcessFrames orders
+// them, with the innermost layer of `scan` holding each (CensusDocument), by
+// `deadline`. An undrawn local root gives none. `cut`: the census stopped
+// short.
+Vector<mojom::blink::AgentControlReadPtr> ControlCensus(
+    LocalFrame& root,
+    const LayerScan* scan,
+    base::TimeTicks deadline,
+    bool& cut) {
+  Vector<mojom::blink::AgentControlReadPtr> out;
+  // An undrawn local root shows none of what it holds, but holds it still: its
+  // census is not known, not empty -- an iframe made display:none included.
+  if (RootUndrawn(root)) {
+    cut = true;
+    return out;
+  }
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(&root, frames);
+  wtf_size_t nodes = 0;
+  for (LocalFrame* frame : frames) {
+    if (base::TimeTicks::Now() > deadline) {
+      cut = true;
+      break;
+    }
+    // A throttled frame (scrolled out of view) is read too: the forced update
+    // lays it out, and a frame that left the view still holds its fields.
+    Document* document = frame->GetDocument();
+    if (!document || !document->View() || !document->IsActive() ||
+        !document->documentElement()) {
+      continue;
+    }
+    document->UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+    // An assertion: nothing below runs script.
+    ScriptForbiddenScope forbid_script;
+    CensusDocument(*document, scan, deadline, out, nodes, cut);
+    if (cut) {
+      break;
+    }
+  }
+  return out;
+}
+
+// browser: whether `cover` stops hits all over its box -- a plain box, not
+// cut by a clip-path or mask, rounded or turned, nor an SVG shape; moved or
+// scaled is plain still (a veil promoted with translateZ(0)) -- and its box,
+// as the page shows it, holds `piece` (the local root's frame).
+bool PlainBoxOver(const Element& cover,
+                  const LocalFrame& root,
+                  const gfx::RectF& piece) {
+  const LayoutObject* object = cover.GetLayoutObject();
+  const ComputedStyle* style = cover.GetComputedStyle();
+  if (!object || !style || !object->IsBox() || object->IsSVG() ||
+      object->IsSVGChild() || style->ClipPath() || style->HasMask() ||
+      style->HasBorderRadius()) {
+    return false;
+  }
+  Vector<gfx::QuadF> quads;
+  object->AbsoluteQuads(quads);
+  if (quads.size() != 1 || !quads[0].IsRectilinear()) {
+    return false;  // turned, or in pieces
+  }
+  return VisibleInRoot(To<LayoutBox>(*object), root,
+                       RootRectOf(*object, object->AbsoluteBoundingBoxRectF()))
+      .Contains(piece);
+}
+
+// browser: the most hit tests one stretch's reading takes
+// (CarryStretchClear: one for what stays put over the element where it is,
+// and up to 60 along the stretch).
+constexpr int kStretchReadCost = 61;
+
+// browser: StaysPutOver's hit tests in one capture: a budget of their own, so
+// the mark never takes from UnderCover's, and the reveal's readings of a
+// stretch already taken -- the rows of a table under one sticky header share
+// one.
+struct StaysPutReads {
+  struct Read {
+    uintptr_t holder;  // the box covers are judged against, as a key only
+    bool vertical;
+    int across;
+    int lo;
+    int hi;
+    bool clear;
+    // What stays put over the element read first, at its aim, as a key
+    // (CarryStretchClear leaves its box out of the runs); every uncovered run
+    // read; whether all of the stretch was covered; and the calm stretch it
+    // was read on, exactly -- a run is the whole of it only against these
+    // (the key's bounds are rounded).
+    uintptr_t pinned = 0;
+    Vector<std::pair<float, float>> runs;
+    bool covered = false;
+    float calm_lo = 0;
+    float calm_hi = 0;
+  };
+  int budget = 1200;
+  Vector<Read> reads;
+};
+
+// browser: whether the scroll left can carry `object`, spanning [b0, b1]
+// along the axis (the local root's frame), into the uncovered run
+// [lo, hi] -- min(4 px, its length, the run's) of it inside -- by the boxes
+// that move it, from the innermost out to `pinned` (what stays put with it),
+// as far as each can still go that way: the reveal stops where the scroll
+// runs out ("as far as the wheel can bring it into view"). Their room is
+// summed; one that moves the cover as well errs toward a click that tries.
+bool StaysPutRoom(const HeapVector<Member<const LayoutBox>>& chain,
+                  const LayoutObject* pinned,
+                  bool vertical,
+                  float b0,
+                  float b1,
+                  float lo,
+                  float hi) {
+  const float inside =
+      std::min({4.f, std::max(0.f, b1 - b0), std::max(0.f, hi - lo)});
+  if (std::min(b1, hi) - std::max(b0, lo) >= inside) {
+    return true;
+  }
+  // Positive: its content must move up or left.
+  const float need = b0 + b1 > lo + hi ? b0 + inside - hi : b1 - inside - lo;
+  float room = 0;
+  for (const auto& box : chain) {
+    if (pinned && !InsideObject(*box, *pinned)) {
+      break;
+    }
+    PaintLayerScrollableArea* area = box->GetScrollableArea();
+    LocalFrameView* view = box->GetFrame() ? box->GetFrame()->View() : nullptr;
+    if (!area || !view ||
+        !area->UserInputScrollable(vertical ? kVerticalScrollbar
+                                            : kHorizontalScrollbar)) {
+      continue;
+    }
+    const ScrollOffset offset = area->GetScrollOffset();
+    const ScrollOffset end =
+        need > 0 ? area->MaximumScrollOffset() : area->MinimumScrollOffset();
+    const float left =
+        std::abs(vertical ? end.y() - offset.y() : end.x() - offset.x());
+    // As the box's frame maps a length into the local root's.
+    const gfx::PointF from = view->ConvertToRootFrame(gfx::PointF());
+    const gfx::PointF to = view->ConvertToRootFrame(
+        vertical ? gfx::PointF(0, left) : gfx::PointF(left, 0));
+    room += std::abs(vertical ? to.y() - from.y() : to.x() - from.x());
+    if (room >= std::abs(need)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// browser: whether a click's reveal would try to bring `object` out from
+// under the cover met over it at `at` (the local root's frame), rather than
+// answer covered at once: a box that holds it can scroll, inside
+// anything fixed to the view or sticky that holds it, across frames (a fixed
+// sheet's own scrolling body: what scrolls outside that moves neither); the
+// cover stays put as the innermost such box scrolls (CarryCovered with it as
+// the holder: a fixed bar or banner, a sticky header); and the reveal's own
+// reading finds part of the stretch it would be brought to uncovered
+// (CarryStretchClear, as ReadCarry); and the scroll left can carry it there
+// (StaysPutRoom -- the mark says a click brings it out). Along the other
+// axis as ReadCarry brings it out first: when all of the main stretch is
+// covered, or what covers it where it is lies in the box that scrolls the
+// other axis (a sticky column over a row's cell); and with the axes swapped
+// as ReadCarry defers the main one. One hit test; one more when a box was
+// passed over (the judge), and for the other axis's box; and for each
+// stretch, one at the element's aim, plus up to kStretchReadCost for one
+// not read yet; from `reads`. False with too few left, which `untold` then
+// says.
+bool StaysPutOver(LocalFrame& root,
+                  const LayoutObject& object,
+                  const gfx::PointF& at,
+                  StaysPutReads& reads,
+                  bool* untold = nullptr) {
+  // A refusal for want of hit tests, said as such: a drained budget does not
+  // tell which refusal was for want of one.
+  const auto short_of = [untold]() {
+    if (untold) {
+      *untold = true;
+    }
+    return false;
+  };
+  LocalFrameView* element_view = object.GetDocument().View();
+  if (!element_view) {
+    return false;
+  }
+  // What stays put with it, as ReadCarry and CarryStretchClear take it.
+  const LayoutObject* pinned = PinnedAbove(object);
+  HeapVector<Member<const LayoutBox>> chain;
+  CarryChain(object, chain);
+  const LayoutBox* scrolling = nullptr;
+  for (const auto& box : chain) {
+    if (pinned && !InsideObject(*box, *pinned)) {
+      break;  // it stays put, with what holds it, as this scrolls
+    }
+    if (CarryCanScroll(*box, /*vertical=*/true, /*forward=*/true) ||
+        CarryCanScroll(*box, /*vertical=*/true, /*forward=*/false) ||
+        CarryCanScroll(*box, /*vertical=*/false, /*forward=*/true) ||
+        CarryCanScroll(*box, /*vertical=*/false, /*forward=*/false)) {
+      scrolling = box.Get();
+      break;
+    }
+  }
+  if (!scrolling) {
+    return false;
+  }
+  // Short only of a hit test it needs: nothing to scroll is known without
+  // one, so a scroll-locked page's controls are told with none left.
+  if (reads.budget <= 0) {
+    return short_of();
+  }
+  --reads.budget;
+  String what;
+  if (!CarryCovered(root, at, *scrolling, object, &what)) {
+    return false;  // it moves with what scrolls
+  }
+  // The reveal's first reading, aimed at its middle as ReadCarry is by
+  // default.
+  const gfx::RectF box(
+      element_view->ConvertToRootFrame(object.AbsoluteBoundingBoxRect()));
+  const gfx::PointF aim = box.CenterPoint();
+  CarryNeedOf across = CarryNeed(chain, /*vertical=*/false, aim.x(), &object);
+  CarryNeedOf down = CarryNeed(chain, /*vertical=*/true, aim.y(), &object);
+  UnstickNeed(across, chain, object, /*vertical=*/false, aim.x());
+  UnstickNeed(down, chain, object, /*vertical=*/true, aim.y());
+  // What a root-frame px is in DIPs along each axis, as ReadCarry weighs its
+  // needs: what neither the drive nor a drag's stages turn for is under a DIP.
+  gfx::Vector2dF dips_per_px(1, 1);
+  if (auto* widget =
+          static_cast<WebFrameWidgetImpl*>(root.GetWidgetForLocalRoot())) {
+    if (LocalFrameView* root_view = root.View()) {
+      const RootDips dips(*root_view, *widget);
+      dips_per_px = dips.Dips(aim + gfx::Vector2dF(1, 1)) - dips.Dips(aim);
+    }
+  }
+  bool main_vertical = std::abs(down.need) >= std::abs(across.need);
+  // The box that scrolls the main axis out of view across it -- a wide box
+  // below the fold: the other axis first, its main need waiting, and no
+  // fallback (ReadCarry).
+  bool deferred = false;
+  {
+    CarryNeedOf& along = main_vertical ? down : across;
+    const CarryNeedOf& other = main_vertical ? across : down;
+    const float other_dips =
+        std::abs(other.need) *
+        std::abs(main_vertical ? dips_per_px.x() : dips_per_px.y());
+    if (other_dips >= 1.f &&
+        OutOfViewAcross(chain, along, other, main_vertical ? aim.x() : aim.y(),
+                        main_vertical)) {
+      along.need = 0;
+      main_vertical = !main_vertical;
+      deferred = true;
+    }
+  }
+  const CarryNeedOf& primary = main_vertical ? down : across;
+  const CarryNeedOf& secondary = main_vertical ? across : down;
+  const float main_dips =
+      std::abs(main_vertical ? dips_per_px.y() : dips_per_px.x());
+  if (primary.gapped || chain.empty() ||
+      primary.calm_lo <= std::numeric_limits<float>::lowest() ||
+      primary.calm_hi >= std::numeric_limits<float>::max()) {
+    return false;  // no stretch the reveal reads: it goes by its looks
+  }
+  // A stretch's reading along `vertical` (`along` its axis's need, `other`
+  // the other's), as CarryStretchClear reads it for the reveal: from `reads`
+  // when one on the same line, judged against the same box, was read with the
+  // same box staying put over its element at the aim -- this element's own,
+  // one hit test -- else read now (up to kStretchReadCost). False with too
+  // few left.
+  const auto read_stretch = [&](bool vertical, const CarryNeedOf& along,
+                                const CarryNeedOf& other,
+                                StaysPutReads::Read& got) {
+    const LayoutBox& holder_box =
+        *chain[std::min<wtf_size_t>(along.holder, chain.size() - 1)];
+    const StaysPutReads::Read wanted{
+        reinterpret_cast<uintptr_t>(&holder_box),
+        vertical,
+        static_cast<int>(std::lround(std::clamp(vertical ? aim.x() : aim.y(),
+                                                other.calm_lo, other.calm_hi))),
+        static_cast<int>(std::lround(along.calm_lo)),
+        static_cast<int>(std::lround(along.calm_hi)),
+        false};
+    const auto same_line = [&wanted](const StaysPutReads::Read& read) {
+      return read.holder == wanted.holder && read.vertical == wanted.vertical &&
+             read.across == wanted.across && read.lo == wanted.lo &&
+             read.hi == wanted.hi;
+    };
+    // browser: an unmoved axis's reading turns on this element's own
+    // box (CarryStretchClear), so it is neither taken from another's nor kept.
+    bool any = false;
+    for (const StaysPutReads::Read& read : reads.reads) {
+      any = any || (!along.unmoved && same_line(read));
+    }
+    if (any) {
+      if (reads.budget <= 0) {
+        return short_of();
+      }
+      --reads.budget;
+      const LayoutObject* own = nullptr;
+      String own_name;
+      CarryCovered(root, aim, holder_box, object, &own_name, &own);
+      for (const StaysPutReads::Read& read : reads.reads) {
+        if (same_line(read) &&
+            read.pinned == reinterpret_cast<uintptr_t>(own)) {
+          got = read;
+          return true;
+        }
+      }
+    }
+    if (reads.budget < kStretchReadCost) {
+      return short_of();
+    }
+    reads.budget -= kStretchReadCost;
+    float lo = 0;
+    float hi = 0;
+    bool read = false;
+    const LayoutObject* pinned_read = nullptr;
+    got = wanted;
+    const bool clear =
+        CarryStretchClear(root, chain, object, aim, vertical, along, other, lo,
+                          hi, read, &what, &got.runs, &pinned_read);
+    got.clear = clear && read;
+    got.covered = !clear;
+    got.pinned = reinterpret_cast<uintptr_t>(pinned_read);
+    got.calm_lo = along.calm_lo;
+    got.calm_hi = along.calm_hi;
+    if (!along.unmoved) {
+      reads.reads.push_back(got);
+    }
+    return true;
+  };
+  // The run of a reading the reveal takes for this element, as
+  // CarryStretchClear takes it: the nearest its rest that the scroll left can
+  // bring it into; else the nearest.
+  const auto take_run = [&](const StaysPutReads::Read& got, bool vertical,
+                            const CarryNeedOf& along, float& lo, float& hi) {
+    const float b0 = vertical ? box.y() : box.x();
+    const float b1 = vertical ? box.bottom() : box.right();
+    bool found = false;
+    bool found_can = false;
+    float best = 0;
+    for (const auto& run : got.runs) {
+      const bool can =
+          StaysPutRoom(chain, pinned, vertical, b0, b1, run.first, run.second);
+      const float distance = along.rest < run.first    ? run.first - along.rest
+                             : along.rest > run.second ? along.rest - run.second
+                                                       : 0;
+      if (!found || (can && !found_can) ||
+          (can == found_can && distance < best)) {
+        found = true;
+        found_can = can;
+        best = distance;
+        lo = run.first;
+        hi = run.second;
+      }
+    }
+    return found;
+  };
+  // Along the other axis first, as ReadCarry's fallback, on the line where
+  // the main axis leaves it (`main_axis`): an uncovered run there the element
+  // must move to, and the scroll left to move it there -- only when a box
+  // that moves it, inside what stays put, can scroll that way at all (else
+  // the read would spend the mark's hit tests on every control behind a
+  // full-view veil). Never with the axes swapped (`deferred`): ReadCarry
+  // takes no fallback then.
+  const auto other_first = [&](const CarryNeedOf& main_axis) {
+    if (deferred) {
+      return false;
+    }
+    bool other_moves = false;
+    for (const auto& mover : chain) {
+      if (pinned && !InsideObject(*mover, *pinned)) {
+        break;
+      }
+      if (CarryCanScroll(*mover, !main_vertical, /*forward=*/true) ||
+          CarryCanScroll(*mover, !main_vertical, /*forward=*/false)) {
+        other_moves = true;
+        break;
+      }
+    }
+    if (!other_moves || secondary.gapped ||
+        secondary.calm_lo <= std::numeric_limits<float>::lowest() ||
+        secondary.calm_hi >= std::numeric_limits<float>::max()) {
+      return false;
+    }
+    StaysPutReads::Read other_read{};
+    float lo2 = 0;
+    float hi2 = 0;
+    if (!read_stretch(!main_vertical, secondary, main_axis, other_read) ||
+        !other_read.clear ||
+        !take_run(other_read, !main_vertical, secondary, lo2, hi2) ||
+        (lo2 == other_read.calm_lo && hi2 == other_read.calm_hi)) {
+      return false;
+    }
+    const float at2 = main_vertical ? aim.x() : aim.y();
+    CarryNeedOf out = secondary;
+    TakeUncovered(out, at2, lo2, hi2);
+    UnstickNeed(out, chain, object, !main_vertical, at2);
+    return std::abs(out.need) >= 0.5f &&
+           StaysPutRoom(chain, pinned, !main_vertical,
+                        main_vertical ? box.x() : box.y(),
+                        main_vertical ? box.right() : box.bottom(), lo2, hi2);
+  };
+  // What covers it where it is lies in the box that scrolls the other axis
+  // (ReadCarry's trigger: a sticky column in a row that scrolls across, the
+  // row passed over for the window).
+  bool cover_untold = false;  // its hit test refused for want of budget
+  const auto other_holds_cover = [&]() {
+    if (deferred || secondary.holder == primary.holder) {
+      return false;
+    }
+    if (reads.budget <= 0) {
+      cover_untold = true;
+      return short_of();
+    }
+    --reads.budget;
+    String own;
+    return CarryCovered(
+        root, aim,
+        *chain[std::min<wtf_size_t>(secondary.holder, chain.size() - 1)],
+        object, &own);
+  };
+  // The main reading, and the main need it leaves: the run the reveal takes,
+  // as ReadCarry takes it out of the stretch. False when covered all along
+  // (`covered` then), or with too few hit tests left.
+  bool covered = false;
+  float lo = 0;
+  float hi = 0;
+  CarryNeedOf main_need = primary;
+  const auto read_main = [&]() {
+    StaysPutReads::Read main_read{};
+    if (!read_stretch(main_vertical, primary, secondary, main_read)) {
+      return false;
+    }
+    if (main_read.covered) {
+      covered = true;
+      return false;
+    }
+    if (!main_read.clear ||
+        !take_run(main_read, main_vertical, primary, lo, hi)) {
+      return false;
+    }
+    // Against the calm stretch it was read on: a reading shared by the
+    // rounded key may have been read on bounds a fraction apart.
+    if (lo != main_read.calm_lo || hi != main_read.calm_hi) {
+      TakeUncovered(main_need, main_vertical ? aim.y() : aim.x(), lo, hi);
+    }
+    return true;
+  };
+  // The box that bounds the main axis, when a box was passed over (a row
+  // passed over for the window): a cover that moves with it is none the main
+  // axis takes the element from under. Where the main axis leaves it, the
+  // other axis's box may hold that cover (the trigger).
+  const LayoutBox& judge =
+      *chain[std::min<wtf_size_t>(primary.holder, chain.size() - 1)];
+  if (primary.holder > 0 && &judge != scrolling) {
+    if (reads.budget <= 0) {
+      return short_of();
+    }
+    --reads.budget;
+    if (!CarryCovered(root, at, judge, object, &what)) {
+      if (std::abs(primary.need) * main_dips < 1.f) {
+        return other_holds_cover() && other_first(primary);
+      }
+      // Not in place: the main axis moves it first, and its cover with it.
+      // All of the main stretch covered: the other axis, as below. Else the
+      // reveal's next reading, after that move, takes the other axis on the
+      // element's own line -- here its aim's, the cover and its row moving
+      // with it (a run's rest lies in another row of a page whose rows each
+      // scroll across).
+      if (!read_main()) {
+        return covered && other_first(primary);
+      }
+      CarryNeedOf own_line = main_need;
+      own_line.calm_lo = own_line.calm_hi = main_vertical ? aim.y() : aim.x();
+      return other_holds_cover() && other_first(own_line);
+    }
+  }
+  if (!read_main()) {
+    // All of it covered: the other axis, or none.
+    return covered && other_first(primary);
+  }
+  // In place along the main axis yet covered by what the other axis's box
+  // holds: the other axis, or none -- a click there stays covered. Not told
+  // for want of the hit test: not said to stay put either.
+  if (std::abs(main_need.need) * main_dips < 1.f) {
+    if (other_holds_cover()) {
+      return other_first(main_need);
+    }
+    if (cover_untold) {
+      return false;
+    }
+  }
+  return StaysPutRoom(chain, pinned, main_vertical,
+                      main_vertical ? box.y() : box.x(),
+                      main_vertical ? box.bottom() : box.right(), lo, hi);
+}
+
+// browser: what a press at the middle of `element`'s box in
+// view -- clipped by the view alone, as the browser lists it -- meets, as the
+// text pass reads it: not the element, nor what holds it or what it holds.
+// Null when none of its box is in view, or with no hit test left in `budget`,
+// which it takes from.
+Element* AtBoxMiddle(LocalFrame& root, const Element& element, int& budget) {
+  LocalFrameView* view = root.View();
+  LocalFrameView* element_view = element.GetDocument().View();
+  const LayoutObject* object = element.GetLayoutObject();
+  if (!view || !element_view || !object || budget <= 0) {
+    return nullptr;
+  }
+  gfx::RectF box(
+      element_view->ConvertToRootFrame(object->AbsoluteBoundingBoxRect()));
+  box.Intersect(ViewportRect(*view));
+  if (box.IsEmpty()) {
+    return nullptr;
+  }
+  --budget;
+  HitTestLocation location(view->ConvertFromRootFrame(box.CenterPoint()));
+  HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+      location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                    HitTestRequest::kAllowChildFrameContent);
+  Element* hit = DragTargetOf(result.InnerElement());
+  if (hit && (HoldsAcross(element, *hit) || HoldsAcross(*hit, element))) {
+    return nullptr;
+  }
+  return hit;
+}
+
+// browser: what a press lands on wherever it is aimed at the part of
+// `element` the page shows -- the largest of its pieces in view, as the aim
+// takes it -- when every part of it is covered in this process: its own
+// document's content, or the page's over a frame in this process.
+// Said as the press check names it, with where it is, as the browser's
+// CoverName says it. Empty when some part is reachable; when nothing lies
+// over it (a point between its pieces lands on its own ancestors: no cover);
+// when it takes no press (pointer-events: none, the press check's noPointer);
+// while the page does not render yet (hit tests then find nothing); or when it
+// could not be told within `budget` hit tests, which it takes from.
+// Read-only hit tests, as ReachablePart's and PressVerdict's: the middle
+// (almost every element ends there), then four points a sixth in from the
+// corners; one plain box over all five that holds the whole piece is the
+// whole story (a full-window veil); otherwise ReachablePart's grid. Named by
+// the first cover any point met, with " (stays put)" after it when a click
+// would scroll the element out from under that first (StaysPutOver; its
+// hit tests from `stays_put`). An SVG shape, or one taking no press,
+// is told by the five points alone, and only when `look_five` (a layer is
+// open), which `five_only` says it is. Five points inside
+// one of `blocking_boxes` (the open blocking layers' roots and veils) that is
+// a plain box over the whole piece are the whole story too; `unshown` says
+// nothing of it shows. A cover in one of `shut_boxes` -- the
+// open layers' roots and veils that shut the page, each beside its layer's
+// root in `shut_roots` -- reads no mark when the element lies outside that
+// layer. browser: a cover on one of `veil_boxes` --
+// the open layers' veils, each beside its layer's root in `veil_roots` and
+// that layer's name in `veil_names` -- is named by that layer when the
+// element lies outside it and no layer of the cover's own names it.
+String UnderCover(LocalFrame& root,
+                  Element& element,
+                  int& budget,
+                  StaysPutReads& stays_put,
+                  Element** cover = nullptr,
+                  bool* untold = nullptr,
+                  bool look_five = false,
+                  bool* five_only = nullptr,
+                  const HeapVector<Member<Element>>* blocking_boxes = nullptr,
+                  bool* unshown = nullptr,
+                  const HeapVector<Member<Element>>* shut_boxes = nullptr,
+                  const HeapVector<Member<Element>>* shut_roots = nullptr,
+                  const HeapVector<Member<Element>>* veil_boxes = nullptr,
+                  const HeapVector<Member<Element>>* veil_roots = nullptr,
+                  const Vector<String>* veil_names = nullptr) {
+  if (five_only) {
+    *five_only = false;
+  }
+  if (unshown) {
+    *unshown = false;
+  }
+  LocalFrameView* view = root.View();
+  LocalFrameView* element_view = element.GetDocument().View();
+  const LayoutObject* object = element.GetLayoutObject();
+  const LayoutBox* enclosing = object ? object->EnclosingBox() : nullptr;
+  const ComputedStyle* style = element.GetComputedStyle();
+  if (!view || !element_view || !enclosing || !style ||
+      !element.isConnected() || !view->DidFirstLayout() ||
+      !view->LifecycleUpdatesActive()) {
+    return String();
+  }
+  if (budget <= 0) {
+    return String();
+  }
+  // An SVG shape (a thin or curved path with a listener) can slip between the
+  // grid's points, and one taking no press is never met by them: either is
+  // covered only when all five points below meet a cover -- for a shape, one
+  // plain box over the whole of its box (a chevron under a consent wall, a
+  // disabled slide button under a drawer).
+  const bool shape = object->IsSVGChild();
+  const bool no_press = style->UsedPointerEvents() == EPointerEvents::kNone;
+  if (five_only) {
+    *five_only = shape || no_press;
+  }
+  if ((shape || no_press) && !look_five) {
+    return String();
+  }
+  // The largest of its pieces in view, in the local root's frame (AimPiece).
+  const gfx::RectF viewport = ViewportRect(*view);
+  Vector<gfx::QuadF> quads;
+  object->AbsoluteQuads(quads);
+  gfx::RectF piece;
+  for (const gfx::QuadF& quad : quads) {
+    const gfx::RectF box = quad.BoundingBox();
+    const gfx::PointF start = element_view->ConvertToRootFrame(box.origin());
+    const gfx::PointF end =
+        element_view->ConvertToRootFrame(box.bottom_right());
+    gfx::RectF part = VisibleInRoot(
+        *enclosing, root,
+        gfx::RectF(start,
+                   gfx::SizeF(end.x() - start.x(), end.y() - start.y())));
+    part.Intersect(viewport);
+    if (part.width() * part.height() > piece.width() * piece.height()) {
+      piece = part;
+    }
+  }
+  if (piece.IsEmpty()) {
+    if (unshown) {
+      *unshown = true;
+    }
+    return String();
+  }
+
+  const Document* document = root.GetDocument();
+  bool lifecycle_clean = document && document->Lifecycle().GetState() >=
+                                         DocumentLifecycle::kPrePaintClean;
+  Element* named = nullptr;  // the first cover any point met
+  gfx::PointF named_at;      // where
+  bool scrollbar = false;
+  int covered_points = 0;
+  enum class At { kReached, kGap, kCovered };
+  // What a press at (x, y) meets: the element, as the press check counts it
+  // (it, anything in its flat tree, its frame's content, or its own label);
+  // a gap (nothing, or its own ancestor or a frame holding it: nothing lies
+  // over it there); or a cover, in `hit` (null for a scrollbar).
+  const auto at = [&](float x, float y, Element*& hit) {
+    --budget;
+    HitTestLocation location(view->ConvertFromRootFrame(gfx::PointF(x, y)));
+    HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+        location,
+        HitTestRequest::kReadOnly | HitTestRequest::kActive |
+            HitTestRequest::kAllowChildFrameContent,
+        /*stop_node=*/nullptr, /*no_lifecycle_update=*/lifecycle_clean);
+    lifecycle_clean = document && document->Lifecycle().GetState() >=
+                                      DocumentLifecycle::kPrePaintClean;
+    hit = result.InnerElement();
+    if (result.GetScrollbar()) {
+      hit = nullptr;
+      scrollbar = true;
+      ++covered_points;
+      return At::kCovered;
+    }
+    if (!hit) {
+      return At::kGap;
+    }
+    if (hit == &element || FlatTreeTraversal::IsDescendantOf(*hit, element) ||
+        InFrameOf(*hit, element)) {
+      return At::kReached;
+    }
+    HTMLLabelElement* label =
+        Traversal<HTMLLabelElement>::FirstAncestorOrSelf(*hit);
+    if (label && label->Control() == &element) {
+      return At::kReached;
+    }
+    if (HoldsAcross(*hit, element)) {
+      hit = nullptr;
+      return At::kGap;
+    }
+    if (!named) {
+      named = hit;
+      named_at = gfx::PointF(x, y);
+    }
+    ++covered_points;
+    return At::kCovered;
+  };
+
+  Element* middle = nullptr;
+  const At first = at(piece.CenterPoint().x(), piece.CenterPoint().y(), middle);
+  if (first == At::kReached) {
+    return String();
+  }
+  constexpr float kSixths[] = {1.f / 6, 5.f / 6};
+  bool one_cover = first == At::kCovered && middle;
+  bool five_covered = first == At::kCovered;
+  // For a shape, each point's cover as the element's own document holds it:
+  // a same-process frame over it is met by its content, and the frame
+  // element is the box (a consent wall in a frame).
+  const auto owned = [&element](Element* e) -> Element* {
+    return e ? DynamicTo<Element>(LayerInDocument(e, element.GetDocument()))
+             : nullptr;
+  };
+  Element* middle_owner = owned(middle);
+  bool one_owner = first == At::kCovered && middle_owner;
+  // The five points' covers, for the one-layer test (null: a gap or a
+  // scrollbar).
+  Element* five_hits[5] = {first == At::kCovered ? middle : nullptr};
+  int five_at = 1;
+  for (const float fx : kSixths) {
+    for (const float fy : kSixths) {
+      Element* hit = nullptr;
+      const At here = at(piece.x() + fx * piece.width(),
+                         piece.y() + fy * piece.height(), hit);
+      if (here == At::kReached) {
+        return String();
+      }
+      five_hits[five_at++] = here == At::kCovered ? hit : nullptr;
+      five_covered = five_covered && here == At::kCovered;
+      one_cover =
+          one_cover && here == At::kCovered && hit &&
+          (hit == middle || FlatTreeTraversal::IsDescendantOf(*hit, *middle));
+      Element* owner = owned(hit);
+      one_owner = one_owner && here == At::kCovered && owner &&
+                  (owner == middle_owner ||
+                   FlatTreeTraversal::IsDescendantOf(*owner, *middle_owner));
+    }
+  }
+  // One plain cover over all five; or all five inside one open blocking
+  // layer whose root or veil is a plain box over the whole piece: that layer
+  // covers all of it, and no grid is read (a modal whose points meet
+  // different boxes of it would spend the capture's hit tests on its grid).
+  const bool one_plain = one_cover && PlainBoxOver(*middle, root, piece);
+  bool one_layer = false;
+  if (five_covered && !one_plain && blocking_boxes) {
+    for (const auto& layer_box : *blocking_boxes) {
+      bool inside = !HoldsAcross(*layer_box, element);
+      for (Element* hit : five_hits) {
+        inside = inside && hit && HoldsAcross(*layer_box, *hit);
+      }
+      // A box that takes hits all over itself: not a wrapper with holes
+      // between its parts (pointer-events none, hidden).
+      const LayoutObject* layer_object = layer_box->GetLayoutObject();
+      if (inside && layer_object && Hittable(*layer_object) &&
+          PlainBoxOver(*layer_box, root, piece)) {
+        one_layer = true;
+        break;
+      }
+    }
+  }
+  if (shape || no_press) {
+    if (!five_covered ||
+        (shape && !(one_owner && PlainBoxOver(*middle_owner, root, piece)))) {
+      return String();
+    }
+  } else if (!one_plain && !one_layer) {
+    // Pieces of covers, gaps, or a cover that may not stop hits all over
+    // its box: every point of the grid ReachablePart reads.
+    const int cols =
+        std::clamp(static_cast<int>(std::ceil(piece.width() / kReachCellPx)), 1,
+                   kReachGrid);
+    const int rows =
+        std::clamp(static_cast<int>(std::ceil(piece.height() / kReachCellPx)),
+                   1, kReachGrid);
+    for (int row = 0; row < rows; ++row) {
+      for (int col = 0; col < cols; ++col) {
+        if (budget <= 0) {
+          // Not told: nothing said.
+          return String();
+        }
+        Element* hit = nullptr;
+        if (at(piece.x() + (col + 0.5f) * piece.width() / cols,
+               piece.y() + (row + 0.5f) * piece.height() / rows,
+               hit) == At::kReached) {
+          return String();
+        }
+      }
+    }
+  }
+  if (covered_points == 0) {
+    return String();  // only gaps
+  }
+
+  if (!named) {
+    return scrollbar ? String("a scrollbar") : String();
+  }
+  // Which element it was, for the caller to group by.
+  if (cover) {
+    *cover = named;
+  }
+  // One a click scrolls the element out from under first. Not under a layer
+  // that shuts the page -- the cover in one of `shut_boxes`, the element
+  // outside that layer -- which no scroll takes it out from under: the page
+  // is locked, or covered wherever it could go, and the mark's hit tests are
+  // kept for that layer's own elements.
+  String cover_kind;
+  String name = CoverFrom(*named, element, &cover_kind);
+  // browser: a cover on a layer's veil, named by that layer.
+  if (cover_kind.empty() && veil_boxes && veil_roots && veil_names) {
+    for (wtf_size_t k = 0; k < veil_boxes->size(); ++k) {
+      if (HoldsAcross(*(*veil_boxes)[k], *named)) {
+        if (!HoldsAcross(*(*veil_roots)[k], element)) {
+          name = CoverWhere(*named, element, (*veil_names)[k]);
+        }
+        break;
+      }
+    }
+  }
+  if (shut_boxes && shut_roots) {
+    for (wtf_size_t k = 0; k < shut_boxes->size(); ++k) {
+      if (HoldsAcross(*(*shut_boxes)[k], *named) &&
+          !HoldsAcross(*(*shut_roots)[k], element)) {
+        return name;
+      }
+    }
+  }
+  bool short_of = false;
+  if (StaysPutOver(root, *object, named_at, stays_put, &short_of)) {
+    return name + " (stays put)";
+  }
+  // StaysPutOver says no with too few hit tests left to tell, as it says
+  // itself: not known to be out of reach.
+  if (untold && short_of) {
+    *untold = true;
+  }
+  return name;
+}
+
+// The element a press at (x, y), a point in the local root's widget in DIPs,
+// reaches, as a drag's own events would name it.
+Element* ElementAt(LocalFrame& root, const RootDips& dips, double x, double y) {
+  LocalFrameView* view = root.View();
+  if (!view) {
+    return nullptr;
+  }
+  HitTestLocation location(view->ConvertFromRootFrame(dips.Root(x, y)));
+  HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+      location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                    HitTestRequest::kAllowChildFrameContent);
+  return DragTargetOf(result.InnerElement());
+}
+
+// The most boxes a hover region is said with.
+constexpr wtf_size_t kMaxHoverBoxes = 12;
+
+// browser: the hover region a hand at `at`, a point in the local root's frame,
+// is in on its way to `target`: what shows of the border boxes of every
+// element from the one under the hand, and from `target`, up to their nearest
+// common ancestor in the flat tree, and of that ancestor -- the boxes a
+// pointer can stay over without leaving the ancestor, which fires its
+// mouseleave. Only when that matters: a leave or out listener where a pointer
+// leaving fires one, or a :hover rule that shows or holds a menu. None for the
+// document's own element or its body as the ancestor, or when the hand is not
+// over the target's document. Read-only: the hit test changes no hover state.
+void HoverRegion(LocalFrame& root,
+                 Element& target,
+                 const gfx::PointF& at,
+                 Vector<gfx::RectF>& boxes) {
+  LocalFrameView* view = root.View();
+  if (!view) {
+    return;
+  }
+  HitTestLocation location(view->ConvertFromRootFrame(at));
+  HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+      location,
+      HitTestRequest::kReadOnly | HitTestRequest::kAllowChildFrameContent);
+  Element* under = result.InnerElement();
+  Document& document = target.GetDocument();
+  if (!under || &under->GetDocument() != &document) {
+    return;
+  }
+  auto* ancestor =
+      DynamicTo<Element>(FlatTreeTraversal::CommonAncestor(*under, target));
+  if (!ancestor || ancestor == document.documentElement() ||
+      ancestor == document.body()) {
+    return;
+  }
+  // Each chain from its element up to the ancestor, both included.
+  HeapVector<Member<Element>> elements;
+  for (Element* from : {under, &target}) {
+    for (Element* e = from; e; e = FlatTreeTraversal::ParentElement(*e)) {
+      elements.push_back(e);
+      if (e == ancestor) {
+        break;
+      }
+    }
+  }
+  // A :hover rule a menu is shown or held open by: one styling what lies in or
+  // beside an element of the chains (.menu:hover .sub, :has(:hover)), or one
+  // whose subject lies between the chains' ends and the ancestor (.sub:hover)
+  // -- not the ends' own :hover look, a link's colour, which most pages have.
+  bool depends = false;
+  for (const auto& e : elements) {
+    const ComputedStyle* style = e->GetComputedStyle();
+    const bool end = e.Get() == under || e.Get() == &target;
+    if ((!end && style && style->AffectedByHover()) ||
+        e->ChildrenOrSiblingsAffectedByHover() ||
+        e->AncestorsOrSiblingsAffectedByHoverInHas()) {
+      depends = true;
+      break;
+    }
+  }
+  // Above the ancestor too, to the body: a move between two items of an open
+  // submenu has its ancestor inside it, and what holds the submenu open
+  // (.menu:hover .sub) lies above. Only rules styling what lies in or beside
+  // an element there -- not its own :hover look, a card's.
+  for (Element* e = FlatTreeTraversal::ParentElement(*ancestor);
+       e && !depends && e != document.body() && e != document.documentElement();
+       e = FlatTreeTraversal::ParentElement(*e)) {
+    depends = e->ChildrenOrSiblingsAffectedByHover() ||
+              e->AncestorsOrSiblingsAffectedByHoverInHas();
+  }
+  // Or a leave or out listener where a pointer leaving fires one: on either
+  // chain and everything above it to the document (frameworks attach theirs
+  // at their root), on the shadow roots on the way, and on the window.
+  const auto listens = [](EventTarget& node) {
+    return node.HasEventListeners(event_type_names::kMouseleave) ||
+           node.HasEventListeners(event_type_names::kMouseout) ||
+           node.HasEventListeners(event_type_names::kPointerleave) ||
+           node.HasEventListeners(event_type_names::kPointerout);
+  };
+  for (Element* from : {under, &target}) {
+    for (Node* n = from; n && !depends; n = FlatTreeTraversal::Parent(*n)) {
+      ShadowRoot* shadow = n->ContainingShadowRoot();
+      depends = listens(*n) || (shadow && listens(*shadow));
+    }
+  }
+  if (!depends && document.domWindow()) {
+    depends = listens(*document.domWindow());
+  }
+  if (!depends) {
+    return;
+  }
+  // Outermost first -- the ancestor, then each chain down to its end -- and
+  // only what no box already kept holds: the union is the same, and the cap
+  // keeps the boxes that matter, not a deep stack of wrappers under the hand.
+  // Not a box the pointer falls through (pointer-events: none, or not
+  // visible): over it, the pointer is not over the ancestor.
+  for (wtf_size_t i = elements.size();
+       i-- > 0 && boxes.size() < kMaxHoverBoxes;) {
+    Element* e = elements[i].Get();
+    const LayoutObject* object = e->GetLayoutObject();
+    const LayoutBox* enclosing = object ? object->EnclosingBox() : nullptr;
+    const ComputedStyle* style = e->GetComputedStyle();
+    if (!enclosing || !style ||
+        style->UsedPointerEvents() == EPointerEvents::kNone ||
+        style->Visibility() != EVisibility::kVisible) {
+      continue;
+    }
+    const gfx::RectF shown =
+        VisibleInRoot(*enclosing, root,
+                      RootRectOf(*object, object->AbsoluteBoundingBoxRectF()));
+    bool held = shown.IsEmpty();
+    for (const gfx::RectF& b : boxes) {
+      held = held || b.Contains(shown);
+    }
+    if (!held) {
+      boxes.push_back(shown);
+    }
+  }
+}
+
+// The list an element sits in: the element, or its nearest ancestor up to six
+// generations up, whose parent holds two or more children of its tag; its
+// place among them and how many there are.
+struct SlotList {
+  STACK_ALLOCATED();
+
+ public:
+  Element* item = nullptr;
+  ContainerNode* holder = nullptr;
+  int index = -1;
+  int count = 0;
+};
+
+SlotList ListOf(Element& element) {
+  SlotList list;
+  Element* item = &element;
+  for (int generation = 0; generation < 6 && item; ++generation) {
+    ContainerNode* parent = item->parentNode();
+    if (!parent || parent->IsDocumentNode()) {
+      break;
+    }
+    int same = 0;
+    int index = -1;
+    for (Element* sibling = ElementTraversal::FirstChild(*parent); sibling;
+         sibling = ElementTraversal::NextSibling(*sibling)) {
+      if (sibling->TagQName() != item->TagQName()) {
+        continue;
+      }
+      if (sibling == item) {
+        index = same;
+      }
+      ++same;
+    }
+    if (same >= 2) {
+      list.item = item;
+      list.holder = parent;
+      list.index = index;
+      list.count = same;
+      return list;
+    }
+    auto* up = DynamicTo<Element>(parent);
+    if (!up || IsDocumentRoot(up)) {
+      break;
+    }
+    item = up;
+  }
+  return list;
+}
+
+// The element that names and places a list: its holder, or a shadow root's
+// host.
+Element* ListElement(const SlotList& list) {
+  if (auto* element = DynamicTo<Element>(list.holder)) {
+    return element;
+  }
+  auto* shadow = DynamicTo<ShadowRoot>(list.holder);
+  return shadow ? &shadow->host() : nullptr;
+}
+
+// An object's border box with the CSS transforms on it, and on its ancestors
+// below `list`, left out -- where a sortable list laid it out before a drag
+// moved anything -- in its frame's absolute space. Transforms on `list` and
+// above still apply; without a list, or with one off its containing-block
+// chain, only its own transform is left out.
+gfx::RectF UntransformedRect(const LayoutObject& object,
+                             const LayoutObject* list) {
+  const auto* box = DynamicTo<LayoutBox>(&object);
+  if (!box) {
+    // Text and inline boxes take no transform of their own: where the box
+    // they sit in is laid out, less what transforms moved it by.
+    const gfx::RectF now = object.AbsoluteBoundingBoxRectF();
+    const LayoutBox* holder = object.EnclosingBox();
+    if (!holder) {
+      return now;
+    }
+    const gfx::RectF laid = UntransformedRect(*holder, list);
+    return now + (laid.origin() - holder->LocalToAbsolutePoint(gfx::PointF()));
+  }
+  const LayoutBoxModelObject* under = nullptr;
+  for (const LayoutObject* up = box->Container(); up && list;
+       up = up->Container()) {
+    if (up == list) {
+      under = DynamicTo<LayoutBoxModelObject>(up);
+      break;
+    }
+  }
+  if (!under) {
+    under = DynamicTo<LayoutBoxModelObject>(box->Container());
+  }
+  if (!under) {
+    return box->AbsoluteBoundingBoxRectF();
+  }
+  const gfx::PointF origin = box->LocalToAncestorPoint(
+      gfx::PointF(), under, {MapCoordinatesMode::kIgnoreTransforms});
+  const PhysicalSize size = box->StitchedSize();
+  const gfx::RectF in_under(
+      origin, gfx::SizeF(size.width.ToFloat(), size.height.ToFloat()));
+  return under->LocalToAbsoluteQuad(gfx::QuadF(in_under)).BoundingBox();
+}
+
+// Whether a list's items advance down rather than across: its first two
+// items' slots differ more in y than in x.
+bool ListVertical(const SlotList& list, const LayoutObject* list_object) {
+  const Element* first = nullptr;
+  const Element* second = nullptr;
+  for (Element* sibling = ElementTraversal::FirstChild(*list.holder);
+       sibling && !second; sibling = ElementTraversal::NextSibling(*sibling)) {
+    if (sibling->TagQName() != list.item->TagQName()) {
+      continue;
+    }
+    if (first) {
+      second = sibling;
+    } else {
+      first = sibling;
+    }
+  }
+  const LayoutObject* a = first ? first->GetLayoutObject() : nullptr;
+  const LayoutObject* b = second ? second->GetLayoutObject() : nullptr;
+  if (!a || !b) {
+    return false;
+  }
+  const gfx::RectF from = UntransformedRect(*a, list_object);
+  const gfx::RectF to = UntransformedRect(*b, list_object);
+  return std::abs(to.y() - from.y()) > std::abs(to.x() - from.x());
+}
+
+// An element's rendered text, whitespace collapsed, cut to 40 characters.
+// Empty for a form control: what it holds is its value.
+String SlotText(Element& element) {
+  if (element.IsFormControlElement()) {
+    return g_empty_string;
+  }
+  StringBuilder raw;
+  int budget = kTextNameNodeBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(element);
+       node && budget-- > 0 && raw.length() < 160;
+       node = FlatTreeTraversal::Next(*node, &element)) {
+    auto* text = DynamicTo<Text>(node);
+    if (!text || !text->GetLayoutObject()) {
+      continue;
+    }
+    // A text field's own shadow text is its value (a password's in clear):
+    // never part of a name. FormControlValue reports it, masked as it must be.
+    if (Element* host = text->OwnerShadowHost();
+        host && IsA<TextControlElement>(host)) {
+      continue;
+    }
+    raw.Append(text->data());
+    raw.Append(' ');
+  }
+  String clean = CleanName(raw.ToString());
+  if (clean.length() > 40) {
+    wtf_size_t cut = 40;
+    // Never between the halves of a surrogate pair.
+    if ((clean[cut - 1] & 0xFC00) == 0xD800) {
+      --cut;
+    }
+    clean = clean.substr(0, cut).StripWhiteSpace();
+  }
+  return NonNull(clean);
+}
+
+// What an element holds: a form control's value (a password's as bullets),
+// else its aria-valuenow; empty when it has neither.
+String SlotValue(Element& element) {
+  if (element.IsFormControlElement()) {
+    return NonNull(FormControlValue(&element));
+  }
+  return NonNull(element.FastGetAttribute(html_names::kAriaValuenowAttr));
+}
+
+mojom::blink::AgentSlotPtr EmptySlot() {
+  auto slot = mojom::blink::AgentSlot::New();
+  slot->box = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  slot->layout_box = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  slot->index = -1;
+  slot->list_name = g_empty_string;
+  slot->text = g_empty_string;
+  slot->value = g_empty_string;
+  return slot;
+}
+
+// The words a slot carries that a look after a frame must not walk the page
+// for: its text, read once when a watch begins, and its list's name, read
+// again only when its list is another element (FollowList).
+struct SlotNames {
+  String text;
+  String list_name;
+};
+
+// The text a slot carries: its list item's, else its own.
+String ItemText(Element* element) {
+  if (!element) {
+    return g_empty_string;
+  }
+  const SlotList list = ListOf(*element);
+  return SlotText(list.item ? *list.item : *element);
+}
+
+// Keeps `name` the name of the list `element` sits in, read again only when
+// that list is another element than `holder`, the one it was read for (or
+// when it was never read), and only on a laid-out page: while its document
+// waits for layout, a name it has stands until a later look. When the list
+// is `other_holder`, the other watched slot's, its name is `other_name`. DOM
+// only -- DescribeHit reads text already laid out -- so a look right after a
+// frame may call it.
+void FollowList(Element* element,
+                WeakMember<Element>& holder,
+                String& name,
+                const Element* other_holder,
+                const String& other_name) {
+  Element* now = element ? ListElement(ListOf(*element)) : nullptr;
+  if (now == holder.Get() && !name.IsNull()) {
+    return;
+  }
+  if (!name.IsNull() && element &&
+      element->GetDocument().Lifecycle().GetState() <
+          DocumentLifecycle::kLayoutClean) {
+    return;
+  }
+  holder = now;
+  if (!now) {
+    name = g_empty_string;
+  } else if (now == other_holder && !other_name.IsNull()) {
+    name = other_name;
+  } else {
+    name = NonNull(DescribeHit(*now));
+  }
+}
+
+// An element's AgentSlot on layout as it is: nothing here brings layout up to
+// date. With `names`, those stand in for reading its text and its list's
+// name. The text is the list item's when the element sits inside one (a
+// handle in a row).
+mojom::blink::AgentSlotPtr SlotOf(Element* element,
+                                  const RootDips& dips,
+                                  const SlotNames* names) {
+  auto slot = EmptySlot();
+  const LayoutObject* object = element ? element->GetLayoutObject() : nullptr;
+  if (!object || !object->GetFrame() || !object->GetFrame()->View()) {
+    return slot;
+  }
+  slot->found = true;
+  slot->id = static_cast<int32_t>(DOMNodeIds::IdForNode(element));
+  slot->box = dips.Box(RootRectOf(*object, object->AbsoluteBoundingBoxRectF()));
+  const SlotList list = ListOf(*element);
+  Element* list_element = ListElement(list);
+  const LayoutObject* list_object =
+      list_element ? list_element->GetLayoutObject() : nullptr;
+  slot->layout_box =
+      dips.Box(RootRectOf(*object, UntransformedRect(*object, list_object)));
+  if (list.item && list_element) {
+    slot->index = list.index;
+    slot->count = list.count;
+    slot->list_name =
+        names ? NonNull(names->list_name) : NonNull(DescribeHit(*list_element));
+    slot->list_vertical = ListVertical(list, list_object);
+  }
+  slot->text =
+      names ? names->text : SlotText(list.item ? *list.item : *element);
+  slot->value = SlotValue(*element);
+  return slot;
+}
+
+bool BoxMoved(const mojom::blink::AgentElementBox& a,
+              const mojom::blink::AgentElementBox& b) {
+  return std::abs(a.x - b.x) > 0.01 || std::abs(a.y - b.y) > 0.01 ||
+         std::abs(a.width - b.width) > 0.01 ||
+         std::abs(a.height - b.height) > 0.01;
+}
+
+bool SlotMoved(const mojom::blink::AgentSlot& a,
+               const mojom::blink::AgentSlot& b) {
+  return a.found != b.found || a.index != b.index || a.count != b.count ||
+         a.list_name != b.list_name || a.value != b.value ||
+         BoxMoved(*a.box, *b.box) || BoxMoved(*a.layout_box, *b.layout_box);
+}
+
+// A watched element's slot now -- or, while its document's layout is not
+// clean, its last one: a look between frames never forces layout.
+mojom::blink::AgentSlotPtr WatchedSlot(Element* element,
+                                       const RootDips& dips,
+                                       const SlotNames& names,
+                                       const mojom::blink::AgentSlot* last) {
+  const LayoutObject* object = element ? element->GetLayoutObject() : nullptr;
+  if (object && (element->GetDocument().Lifecycle().GetState() <
+                     DocumentLifecycle::kLayoutClean ||
+                 object->NeedsLayout())) {
+    return last ? last->Clone() : EmptySlot();
+  }
+  return SlotOf(element, dips, &names);
+}
+
+// What SliderThumbElement::SetPositionFromPoint reads of a range input: its
+// track and thumb and, along the axis in the track's layout units, the room
+// the thumb's middle moves in, half the thumb, the thumb's margin before it,
+// the track's length, and the track's middle across.
+struct SliderParts {
+  STACK_ALLOCATED();
+
+ public:
+  const LayoutBox* track = nullptr;
+  const LayoutBox* thumb = nullptr;
+  bool vertical = false;
+  bool flipped = false;
+  LayoutUnit track_size;
+  LayoutUnit half_thumb;
+  LayoutUnit margin;
+  LayoutUnit length;
+  LayoutUnit across;
+};
+
+// Reads its user-agent shadow tree without creating it (SetPositionFromPoint
+// ensures it); false when the input is not a laid-out range input.
+bool ReadSliderParts(HTMLInputElement& input, SliderParts& parts) {
+  ShadowRoot* shadow = input.UserAgentShadowRoot();
+  if (input.FormControlType() != mojom::blink::FormControlType::kInputRange ||
+      !shadow || !input.GetLayoutObject()) {
+    return false;
+  }
+  Element* thumb = shadow->getElementById(shadow_element_names::kIdSliderThumb);
+  Element* track = shadow->getElementById(shadow_element_names::kIdSliderTrack);
+  parts.thumb = thumb ? thumb->GetLayoutBox() : nullptr;
+  parts.track = track ? track->GetLayoutBox() : nullptr;
+  if (!parts.thumb || !parts.track) {
+    return false;
+  }
+  const WritingDirectionMode direction =
+      parts.thumb->StyleRef().GetWritingDirection();
+  parts.vertical = !direction.IsHorizontal();
+  parts.flipped = direction.IsFlippedInlines();
+  const PhysicalSize thumb_size = parts.thumb->StitchedSize();
+  const PhysicalBoxStrut margins = parts.thumb->MarginOutsets();
+  const PhysicalSize content = parts.track->PhysicalContentBoxRect().size;
+  const PhysicalSize border = parts.track->StitchedSize();
+  if (parts.vertical) {
+    parts.track_size = content.height - thumb_size.height;
+    parts.half_thumb = thumb_size.height / 2;
+    parts.margin = parts.flipped ? margins.bottom : margins.top;
+    parts.length = border.height;
+    parts.across = border.width / 2;
+  } else {
+    parts.track_size = content.width - thumb_size.width;
+    parts.half_thumb = thumb_size.width / 2;
+    parts.margin = parts.flipped ? margins.right : margins.left;
+    parts.length = border.width;
+    parts.across = border.height / 2;
+  }
+  return true;
+}
+
+// The value SetPositionFromPoint sets for the track-local coordinate `along`,
+// its datalist's 5 px snapping included, set nowhere.
+Decimal SliderValueAt(HTMLInputElement& input,
+                      const SliderParts& parts,
+                      const StepRange& range,
+                      LayoutUnit along) {
+  LayoutUnit position = along - parts.half_thumb - parts.margin;
+  position = std::min(position, parts.track_size).ClampNegativeToZero();
+  const Decimal ratio = Decimal::FromDouble(
+      parts.track_size > LayoutUnit()
+          ? position.ToDouble() / parts.track_size.ToDouble()
+          : 0);
+  const Decimal fraction = parts.flipped ? Decimal(1) - ratio : ratio;
+  Decimal value = range.ClampValue(range.ValueFromProportion(fraction));
+  const Decimal closest = input.FindClosestTickMarkValue(value);
+  if (closest.IsFinite()) {
+    const double closest_fraction =
+        range.ProportionFromValue(closest).ToDouble();
+    const double closest_ratio =
+        parts.flipped ? 1.0 - closest_fraction : closest_fraction;
+    const LayoutUnit closest_position(parts.track_size.ToDouble() *
+                                      closest_ratio);
+    if ((closest_position - position).Abs() <= LayoutUnit(5)) {
+      value = closest;
+    }
+  }
+  return value;
+}
+
+// A point in the local root's frame as a coordinate along the track, as
+// SetPositionFromPoint takes the pointer's.
+LayoutUnit AlongTrack(const SliderParts& parts, const gfx::PointF& at) {
+  LocalFrameView* view =
+      parts.track->GetFrame() ? parts.track->GetFrame()->View() : nullptr;
+  if (!view) {
+    return LayoutUnit();
+  }
+  // Floored to layout units, as RangeInputType and SliderThumbElement take
+  // a mouse event's absolute location.
+  const PhysicalOffset local = parts.track->AbsoluteToLocalPoint(
+      PhysicalOffset::FromPointFFloor(view->ConvertFromRootFrame(at)));
+  return parts.vertical ? local.top : local.left;
+}
+
+// The point on the track's middle line at `along`, in the local root's frame.
+gfx::PointF TrackPoint(const SliderParts& parts, LayoutUnit along) {
+  const gfx::PointF local =
+      parts.vertical ? gfx::PointF(parts.across.ToFloat(), along.ToFloat())
+                     : gfx::PointF(along.ToFloat(), parts.across.ToFloat());
+  const gfx::PointF absolute = parts.track->LocalToAbsolutePoint(local);
+  LocalFrameView* view =
+      parts.track->GetFrame() ? parts.track->GetFrame()->View() : nullptr;
+  return view ? view->ConvertToRootFrame(absolute) : absolute;
+}
+
+// Where along the track a value is given: the middle of the run of track
+// positions (layout units, 1/64 px) that give `asked` -- already stepped and
+// clamped as the input takes it -- or, when no position gives it, the run of
+// the nearer of the values on either side; and the value at that middle,
+// read there. The value only grows along the track (only shrinks, flipped),
+// so each run's ends are bisected: a few dozen looks at the value.
+bool SliderPointFor(HTMLInputElement& input,
+                    const SliderParts& parts,
+                    const StepRange& range,
+                    const Decimal& asked,
+                    LayoutUnit& along,
+                    Decimal& reached) {
+  // In 64 bits, so length + 1 cannot overflow; every position read is in
+  // [0, length], an int32_t.
+  const int64_t length = parts.length.RawValue();
+  if (length <= 0) {
+    return false;
+  }
+  const auto value_at = [&](int64_t raw) {
+    return SliderValueAt(input, parts, range,
+                         LayoutUnit::FromRawValue(static_cast<int32_t>(raw)));
+  };
+  // Whether value `a` comes before value `b` along the track.
+  const auto before = [&parts](const Decimal& a, const Decimal& b) {
+    return parts.flipped ? a > b : a < b;
+  };
+  // The positions [from, to] that give `target`; when none does, from is
+  // to + 1, `to` giving the value just before it and `from` the one past it.
+  const auto run_of = [&](const Decimal& target, int64_t& from, int64_t& to) {
+    int64_t lo = 0;
+    int64_t hi = length + 1;
+    while (lo < hi) {
+      const int64_t mid = lo + (hi - lo) / 2;
+      if (before(value_at(mid), target)) {
+        lo = mid + 1;
+      } else {
+        hi = mid;
+      }
+    }
+    from = lo;
+    hi = length + 1;
+    while (lo < hi) {
+      const int64_t mid = lo + (hi - lo) / 2;
+      if (before(target, value_at(mid))) {
+        hi = mid;
+      } else {
+        lo = mid + 1;
+      }
+    }
+    to = lo - 1;
+  };
+  int64_t from = 0;
+  int64_t to = -1;
+  run_of(asked, from, to);
+  if (from > to) {
+    const bool has_before = to >= 0;
+    const bool has_past = from <= length;
+    if (!has_before && !has_past) {
+      return false;
+    }
+    Decimal nearer;
+    if (has_before && has_past) {
+      const Decimal below = value_at(to);
+      const Decimal above = value_at(from);
+      nearer = (asked - below).Abs() <= (asked - above).Abs() ? below : above;
+    } else {
+      nearer = value_at(has_before ? to : from);
+    }
+    run_of(nearer, from, to);
+    if (from > to) {
+      return false;
+    }
+  }
+  // The upper middle: a point that comes back floored (as a pointer's does)
+  // stays in the run.
+  const int64_t middle = from + (to - from + 1) / 2;
+  along = LayoutUnit::FromRawValue(static_cast<int32_t>(middle));
+  reached = value_at(middle);
+  return true;
+}
+
+mojom::blink::AgentSliderPtr EmptySlider() {
+  auto slider = mojom::blink::AgentSlider::New();
+  slider->track = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  slider->thumb = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  return slider;
+}
+
+// A range input's AgentSlider.
+mojom::blink::AgentSliderPtr SliderOf(HTMLInputElement& input,
+                                      const SliderParts& parts,
+                                      const StepRange& range,
+                                      const RootDips& dips) {
+  auto slider = EmptySlider();
+  slider->is_range = true;
+  const PhysicalRect content = parts.track->PhysicalContentBoxRect();
+  const gfx::RectF track =
+      parts.track->LocalRectToAbsoluteQuad(content).BoundingBox();
+  slider->track = dips.Box(RootRectOf(*parts.track, track));
+  slider->thumb = dips.Box(
+      RootRectOf(*parts.thumb, parts.thumb->AbsoluteBoundingBoxRectF()));
+  // A layout unit along the axis, in DIPs.
+  const gfx::Vector2dF unit =
+      dips.Dips(gfx::PointF(1, 1)) - dips.Dips(gfx::PointF());
+  slider->thumb_margin_start =
+      parts.margin.ToDouble() * (parts.vertical ? unit.y() : unit.x());
+  slider->vertical = parts.vertical;
+  slider->flipped = parts.flipped;
+  slider->min = range.Minimum().ToDouble();
+  slider->max = range.Maximum().ToDouble();
+  slider->step = range.HasStep() ? range.Step().ToDouble() : 0;
+  slider->step_base = range.StepBase().ToDouble();
+  const double value = input.valueAsNumber();
+  slider->value =
+      std::isfinite(value) ? value : range.DefaultValue().ToDouble();
+  // Its datalist's options, as RangeInputType takes them for tick marks.
+  if (HTMLDataListElement* data_list = input.DataList()) {
+    HTMLDataListOptionsCollection* options = data_list->options();
+    for (unsigned i = 0; i < options->length() && slider->ticks.size() < 256;
+         ++i) {
+      HTMLOptionElement* option = options->Item(i);
+      const String option_value = option ? option->value() : String();
+      if (!option || option->IsDisabledFormControl() || option_value.empty() ||
+          !input.IsValidValue(option_value)) {
+        continue;
+      }
+      const double tick = ParseToDoubleForNumberType(option_value);
+      if (std::isfinite(tick)) {
+        slider->ticks.push_back(tick);
+      }
+    }
+  }
+  return slider;
+}
+
+mojom::blink::AgentDragFramePtr EmptyFrame() {
+  auto frame = mojom::blink::AgentDragFrame::New();
+  frame->target = EmptySlot();
+  frame->grab = EmptySlot();
+  return frame;
+}
+
+// The node a DOMNodeId names -- an element or a document -- if it is still in
+// a document under `root`, the local root this collector serves.
+Node* OwnedNode(LocalFrame* root, int32_t id) {
+  Node* node = DOMNodeIds::NodeForId(id);
+  if (!root || !node || !node->isConnected() ||
+      !(IsA<Element>(node) || IsA<Document>(node))) {
+    return nullptr;
+  }
+  LocalFrame* frame = node->GetDocument().GetFrame();
+  return frame && &frame->LocalFrameRoot() == root ? node : nullptr;
+}
+
+// A watched box's scroll offsets in CSS px, as scrollLeft and scrollTop give
+// them; false, with x and y left alone, when it is gone.
+bool WatchedOffsets(LocalFrame* root, int32_t id, double& x, double& y) {
+  Node* node = OwnedNode(root, id);
+  const LayoutBox* box = nullptr;
+  if (auto* document = DynamicTo<Document>(node)) {
+    box = document->GetLayoutView();
+  } else if (auto* element = DynamicTo<Element>(node)) {
+    // The box that scrolls for it, as scrollTop reads it: a fieldset's
+    // anonymous content box.
+    box = element->GetLayoutBoxForScrolling();
+  }
+  PaintLayerScrollableArea* area = box ? box->GetScrollableArea() : nullptr;
+  if (!area) {
+    return false;
+  }
+  const float zoom = box->StyleRef().EffectiveZoom();
+  x = area->GetScrollOffset().x() / zoom;
+  y = area->GetScrollOffset().y() / zoom;
+  return true;
+}
+
+// browser: a scroll's settle, a carry's and Input.scrollBy's: a look every
+// 16 ms; still across three looks, about 50 ms, it has run out; never waited
+// on past 10 s.
+constexpr base::TimeDelta kSettleLook = base::Milliseconds(16);
+constexpr int kStillLooks = 3;
+constexpr int kSettleMaxMs = 10000;
+
+// browser: Input.scrollBy's reads. The box a DOMNodeId names as the box
+// that scrolls for it -- a document's view, an element's scrolling box (a
+// fieldset's anonymous content box) -- as WatchedOffsets reads it; null when
+// it is gone or not under `root`.
+const LayoutBox* ScrollBoxOfId(LocalFrame* root, int32_t id) {
+  Node* node = OwnedNode(root, id);
+  if (auto* document = DynamicTo<Document>(node)) {
+    return document->GetLayoutView();
+  }
+  if (auto* element = DynamicTo<Element>(node)) {
+    return element->GetLayoutBoxForScrolling();
+  }
+  return nullptr;
+}
+
+// A scroller's place along an axis, in CSS px: from its visual start (a box
+// laid out in reverse counts from where it begins on screen, as Blink's
+// scroll origin has it); as scrollTop or scrollLeft gives it; as far as a user
+// can scroll it (none when overflow is hidden or clip that way, wherever
+// script left it, as CarryCanScroll judges room); and how long its port is.
+struct WheelFigures {
+  double position = 0;
+  double raw = 0;
+  double max = 0;
+  double length = 0;
+};
+
+std::optional<WheelFigures> GetWheelFigures(const LayoutBox& box,
+                                            WheelAxis axis) {
+  PaintLayerScrollableArea* area = box.GetScrollableArea();
+  if (!area) {
+    return std::nullopt;
+  }
+  const bool vertical = axis == WheelAxis::kDown;
+  const float zoom = box.StyleRef().EffectiveZoom();
+  const ScrollOffset offset = area->GetScrollOffset();
+  const ScrollOffset low = area->MinimumScrollOffset();
+  const ScrollOffset high = area->MaximumScrollOffset();
+  const gfx::Rect port = area->VisibleContentRect(kExcludeScrollbars);
+  WheelFigures figures;
+  figures.raw = (vertical ? offset.y() : offset.x()) / zoom;
+  figures.position =
+      (vertical ? offset.y() - low.y() : offset.x() - low.x()) / zoom;
+  if (area->UserInputScrollable(vertical ? kVerticalScrollbar
+                                         : kHorizontalScrollbar)) {
+    figures.max =
+        std::max(0.f, vertical ? high.y() - low.y() : high.x() - low.x()) /
+        zoom;
+  }
+  figures.length = (vertical ? port.height() : port.width()) / zoom;
+  return figures;
+}
+
+// A scroller named as covers are: the element (tag#id or tag.class, then its
+// text when short); empty for the main frame's window; a same-process
+// frame's window by its frame element, and empty for a frame of another
+// process, whose element is not here (the browser names it).
+String WheelScrollerName(const LayoutBox& box) {
+  if (box.IsLayoutView()) {
+    const LocalFrame* frame = box.GetFrame();
+    if (!frame || frame->IsOutermostMainFrame()) {
+      return String();
+    }
+    HTMLFrameOwnerElement* owner = box.GetDocument().LocalOwner();
+    return owner ? DescribeHit(*owner) : String();
+  }
+  for (const LayoutObject* o = &box; o; o = o->Parent()) {
+    if (auto* element = DynamicTo<Element>(o->GetNode())) {
+      return DescribeHit(*element);
+    }
+  }
+  return String();
+}
+
+mojom::blink::AgentWheelScrollerPtr EmptyWheelScroller() {
+  auto out = mojom::blink::AgentWheelScroller::New();
+  out->name = g_empty_string;
+  out->alt_name = g_empty_string;
+  return out;
+}
+
+// A scroller shows at least this much each way, in CSS px, to be one a hand
+// goes to (FindAltScroller) or the main scroller (MainScrollerOf).
+constexpr double kScrollerMinShownPx = 20;
+
+// When nothing at the point scrolls that way and the window cannot be
+// scrolled that way at all: of the boxes a user can scroll that way with
+// 20 x 20 CSS px or more showing, the one with the most room that way -- not
+// the largest: one at its end that way would only turn the wheel for nothing
+// -- at the middle of what shows, where Input.scrollBy's hand goes with
+// findScroller.
+void FindAltScroller(LocalFrame& root,
+                     const RootDips& dips,
+                     WheelAxis axis,
+                     WheelWay way,
+                     mojom::blink::AgentWheelScroller& out) {
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(&root, frames);
+  const bool vertical = axis == WheelAxis::kDown;
+  const LayoutBox* best = nullptr;
+  double best_room = 0;
+  gfx::RectF best_shown;
+  for (LocalFrame* frame : frames) {
+    LocalFrameView* view = frame->View();
+    if (!view || view->ShouldThrottleRendering() ||
+        frame->GetDocument()->Lifecycle().GetState() <
+            DocumentLifecycle::kLayoutClean) {
+      continue;
+    }
+    for (const auto& entry : view->ScrollableAreas()) {
+      const LayoutBox* box = entry.value->GetLayoutBox();
+      if (!box || box->IsLayoutView() || !box->IsUserScrollable() ||
+          !entry.value->UserInputScrollable(vertical ? kVerticalScrollbar
+                                                     : kHorizontalScrollbar)) {
+        continue;
+      }
+      BandShape shape;
+      if (!ShapeOf(*box, root, shape)) {
+        continue;
+      }
+      const float zoom = box->StyleRef().EffectiveZoom();
+      const std::optional<WheelFigures> figures = GetWheelFigures(*box, axis);
+      if (shape.visible.width() / zoom < kScrollerMinShownPx ||
+          shape.visible.height() / zoom < kScrollerMinShownPx || !figures) {
+        continue;
+      }
+      const double room = way == WheelWay::kForward
+                              ? figures->max - figures->position
+                              : figures->position;
+      if (room >= 1 && room > best_room) {
+        best = box;
+        best_room = room;
+        best_shown = shape.visible;
+      }
+    }
+  }
+  if (!best) {
+    return;
+  }
+  const gfx::PointF place = dips.Dips(best_shown.CenterPoint());
+  out.alt_found = true;
+  out.alt_x = place.x();
+  out.alt_y = place.y();
+  out.alt_name = NonNull(WheelScrollerName(*best));
+}
+
+// Input.scrollBy's read at `at`, a point in the local root's frame, along an
+// axis: the scroller the wheel latches there, or `asked` again (with
+// kCheck, whether the wheel there still latches it, and the nearest place
+// over it where it would). Reads layout as it is: the caller brings it clean
+// where a hit test needs it (`layout`), and only then is the name read.
+mojom::blink::AgentWheelScrollerPtr ReadWheelScroller(
+    LocalFrame& root,
+    const RootDips& dips,
+    const gfx::PointF& at,
+    WheelAxis axis,
+    WheelWay way,
+    const LayoutBox* asked,
+    WheelLatchCheck latch_check,
+    WheelPastFrame past,
+    WheelLayout layout) {
+  mojom::blink::AgentWheelScrollerPtr out = EmptyWheelScroller();
+  // In a frame of another process, only where the page shows that frame: a
+  // wheel turned anywhere else goes to the page, as ReadCarry judges
+  // it.
+  const bool remote = root.IsLocalRoot() && !root.IsOutermostMainFrame();
+  const gfx::RectF shows(root.RemoteViewportIntersection());
+  const auto in_frame = [&](const gfx::PointF& p) {
+    return !remote || shows.Contains(p);
+  };
+  const LayoutBox* box = asked;
+  bool can_move = false;
+  out->latched = true;
+  if (!asked) {
+    String remote_token;
+    box = in_frame(at)
+              ? LatchOrStop(root, at, axis, way, past, /*pinned=*/nullptr,
+                            can_move, &remote_token)
+              : nullptr;
+    if (!remote_token.IsNull()) {
+      out->remote_frame = remote_token;
+    }
+  } else {
+    can_move = CarryCanScroll(*asked, axis == WheelAxis::kDown,
+                              way == WheelWay::kForward);
+    if (latch_check == WheelLatchCheck::kCheck) {
+      bool moves = false;
+      out->latched = in_frame(at) &&
+                     LatchOrStop(root, at, axis, way, past, /*pinned=*/nullptr,
+                                 moves, /*remote_frame=*/nullptr) == asked;
+    }
+    if (!out->latched) {
+      // The nearest place over it, in the window and where the page shows
+      // this frame, a little in from the edges, where the wheel latches it
+      // again: the reveal's grid.
+      gfx::RectF area = PortOf(*asked).shown;
+      if (const LayoutView* window = root.ContentLayoutObject()) {
+        area.Intersect(PortOf(*window).shown);
+      }
+      if (remote) {
+        area.Intersect(shows);
+      }
+      area.Inset(gfx::InsetsF::VH(
+          std::min(kCarryBelt + 4, std::max(0.f, area.height() / 2 - 1)),
+          std::min(kCarryBelt + 4, std::max(0.f, area.width() / 2 - 1))));
+      gfx::PointF place;
+      if (NearestWheelPlace(
+              area, at,
+              [&](const gfx::PointF& p, bool* pinned) {
+                bool moves_there = false;
+                return in_frame(p) &&
+                       LatchOrStop(root, p, axis, way, past, pinned,
+                                   moves_there,
+                                   /*remote_frame=*/nullptr) == asked;
+              },
+              place)) {
+        const gfx::PointF in_dips = dips.Dips(place);
+        out->place_found = true;
+        out->place_x = in_dips.x();
+        out->place_y = in_dips.y();
+      }
+    }
+  }
+  if (const std::optional<WheelFigures> figures =
+          box ? GetWheelFigures(*box, axis) : std::nullopt) {
+    out->found = true;
+    out->scroller_id = NodeIdOf(*box);
+    out->is_window = box->IsLayoutView();
+    const LocalFrame* frame = box->GetFrame();
+    out->is_top_window =
+        out->is_window && frame && frame->IsOutermostMainFrame();
+    out->can_move = can_move;
+    out->position = figures->position;
+    out->raw = figures->raw;
+    out->max = figures->max;
+    out->length = figures->length;
+    if (layout == WheelLayout::kBringClean) {
+      out->name = NonNull(WheelScrollerName(*box));
+    }
+  }
+  const LayoutView* window = root.ContentLayoutObject();
+  if (const std::optional<WheelFigures> window_figures =
+          window ? GetWheelFigures(*window, axis) : std::nullopt) {
+    out->window_position = window_figures->position;
+    if (!asked && box && !can_move &&
+        (out->remote_frame.IsNull() || past == WheelPastFrame::kPass) &&
+        window_figures->max < 1) {
+      FindAltScroller(root, dips, axis, way, *out);
+    }
+  }
+  return out;
+}
+
+// How many layouts the local root's same-process frames have run: a change
+// is a layout since the last look.
+uint64_t LayoutSum(LocalFrame& root) {
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(&root, frames);
+  uint64_t sum = 0;
+  for (LocalFrame* frame : frames) {
+    if (LocalFrameView* view = frame->View()) {
+      sum += view->LayoutCountForTesting();
+    }
+  }
+  return sum;
+}
+
+// Whether a node is one of `excluded` or lies inside one, across shadow trees
+// and same-process frames.
+bool Excluded(Node* node, const HeapHashSet<Member<Node>>& excluded) {
+  for (int depth = 0; node && depth < 4096; ++depth) {
+    if (excluded.Contains(node)) {
+      return true;
+    }
+    if (ContainerNode* parent = FlatTreeTraversal::Parent(*node)) {
+      node = parent;
+      continue;
+    }
+    auto* document = DynamicTo<Document>(node);
+    node = document ? document->LocalOwner() : nullptr;
+  }
+  return false;
+}
+
+// ------------------------------------------ browser: the main scroller
+// The box a scroll of the page means, as the capture reports it:
+// judged here per local root, and across local roots in the browser. Read
+// only, on layout as the capture left it: geometry, ComputedStyle reads and
+// one read-only hit test (WheelLatch). Its figures and name are
+// Input.scrollBy's (GetWheelFigures, WheelScrollerName), so both read a
+// scroller alike.
+
+// A window counts only when its document scrolls at least kDocumentScrollsPx,
+// or kDocumentScrollsShare of how tall it shows, whichever is more; a local
+// root's own then wins.
+constexpr double kDocumentScrollsPx = 16;
+constexpr double kDocumentScrollsShare = 0.02;
+
+// The element a scroller stands for: its own, the nearest around an
+// anonymous one (a fieldset's content box), a window's document element.
+const Element* ScrollerElementOf(const LayoutBox& box) {
+  if (box.IsLayoutView()) {
+    return box.GetDocument().documentElement();
+  }
+  for (const LayoutObject* o = &box; o; o = o->Parent()) {
+    if (auto* element = DynamicTo<Element>(o->GetNode())) {
+      return element;
+    }
+  }
+  return nullptr;
+}
+
+// browser: the label an element's author gave it --
+// aria-label, else its first aria-labelledby target's text (LabelledByText:
+// never a field's), else its title -- cut as a layer's name; empty when none.
+String ScrollerLabel(const Element& element) {
+  String name = CleanName(element.FastGetAttribute(html_names::kAriaLabelAttr));
+  if (name.empty()) {
+    const AtomicString& ids =
+        element.FastGetAttribute(html_names::kAriaLabelledbyAttr);
+    if (!ids.empty()) {
+      if (Element* label =
+              element.GetTreeScope().getElementById(FirstIdIn(ids))) {
+        name = CleanName(LabelledByText(*label));
+      }
+    }
+  }
+  if (name.empty()) {
+    name = CleanName(element.FastGetAttribute(html_names::kTitleAttr));
+  }
+  return LayerNameCut(name);
+}
+
+// This local root's main scroller (AgentScrollerCandidate), null when none:
+// of the boxes CollectTerrain would survey -- each frame's window when it can
+// scroll, and every user-scrollable box of its scrollable areas, in frames
+// not throttled -- those with room up or down that show 20 x 20 CSS px or
+// more and are open to a hit test; a window only when its document really
+// scrolls, and the local root's own then wins. `layers`, when they were asked
+// for: only what the top blocking layer holds counts, and the entry holding
+// the scroller is told.
+mojom::blink::AgentScrollerCandidatePtr MainScrollerOf(
+    LocalFrame& root,
+    const RootDips& dips,
+    const LayerScan* layers) {
+  const Element* top_blocking = nullptr;
+  if (layers) {
+    for (wtf_size_t k = layers->stack.size(); k-- > 0;) {
+      const wtf_size_t s = layers->stack[k];
+      if (layers->facts[s].blocking) {
+        top_blocking = layers->roots[s].Get();
+        break;
+      }
+    }
+  }
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(&root, frames);
+  const LayoutBox* best = nullptr;
+  gfx::RectF best_shown;
+  bool document_scrolls = false;
+  for (LocalFrame* frame : frames) {
+    LocalFrameView* view = frame->View();
+    LayoutView* layout_view = frame->ContentLayoutObject();
+    if (!view || !layout_view || view->ShouldThrottleRendering() ||
+        frame->GetDocument()->Lifecycle().GetState() <
+            DocumentLifecycle::kLayoutClean) {
+      continue;
+    }
+    HeapVector<Member<const LayoutBox>> boxes;
+    if (layout_view->IsUserScrollable()) {
+      boxes.push_back(layout_view);
+    }
+    for (const auto& entry : view->ScrollableAreas()) {
+      const LayoutBox* box = entry.value->GetLayoutBox();
+      if (box && !box->IsLayoutView() && box->IsUserScrollable()) {
+        boxes.push_back(box);
+      }
+    }
+    for (const auto& box : boxes) {
+      const std::optional<WheelFigures> down =
+          GetWheelFigures(*box, WheelAxis::kDown);
+      BandShape shape;
+      if (!down || down->max < 1 || !Hittable(*box) ||
+          !ShapeOf(*box, root, shape)) {
+        continue;
+      }
+      const float zoom = box->StyleRef().EffectiveZoom();
+      const Element* element = ScrollerElementOf(*box);
+      if (shape.visible.width() / zoom < kScrollerMinShownPx ||
+          shape.visible.height() / zoom < kScrollerMinShownPx ||
+          (top_blocking &&
+           (!element || !HoldsAcross(*top_blocking, *element)))) {
+        continue;
+      }
+      // A window counts only when its document really scrolls: one that
+      // scrolls less (a stray pixel or two of overflow) is passed over, so
+      // the pane it holds reads. The local root's own comes first, and then
+      // wins: a page with room to scroll reads as the page, a pane in it or
+      // not.
+      if (box->IsLayoutView()) {
+        if (down->max < std::max(kDocumentScrollsPx,
+                                 kDocumentScrollsShare * down->length)) {
+          continue;
+        }
+        if (frame == &root) {
+          best = box.Get();
+          best_shown = shape.visible;
+          document_scrolls = true;
+          break;
+        }
+      }
+      // Else what shows the most of itself; of two alike the first met (a
+      // frame's window before what it holds).
+      if (!best || shape.visible.width() * shape.visible.height() >
+                       best_shown.width() * best_shown.height()) {
+        best = box.Get();
+        best_shown = shape.visible;
+      }
+    }
+    if (document_scrolls) {
+      break;
+    }
+  }
+  if (!best) {
+    return nullptr;
+  }
+  auto out = mojom::blink::AgentScrollerCandidate::New();
+  out->node_id = NodeIdOf(*best);
+  out->is_window = best->IsLayoutView();
+  out->document_scrolls = document_scrolls;
+  if (const LocalFrame* frame = best->GetFrame(); frame && out->is_window) {
+    out->frame_id = String(frame->GetDevToolsFrameToken().ToString());
+  }
+  const WheelFigures down =
+      GetWheelFigures(*best, WheelAxis::kDown).value_or(WheelFigures());
+  const WheelFigures across =
+      GetWheelFigures(*best, WheelAxis::kAcross).value_or(WheelFigures());
+  out->position_x = across.position;
+  out->position_y = down.position;
+  out->max_x = across.max;
+  out->max_y = down.max;
+  out->length_x = across.length;
+  out->length_y = down.length;
+  out->visible = dips.Box(best_shown);
+  const Element* element = ScrollerElementOf(*best);
+  // browser: an element's own label, as a person names it;
+  // else as covers are (tag#id). A listed one takes the listing's name in the
+  // browser.
+  const String label =
+      element && !out->is_window ? ScrollerLabel(*element) : String();
+  out->name = NonNull(label.empty() ? WheelScrollerName(*best) : label);
+  out->role = g_empty_string;
+  if (element && !out->is_window) {
+    const String first = FirstRole(*element);
+    out->role = first.empty() ? String(element->localName()) : first;
+  }
+  // Turned the way it has room: one at its end down has room up.
+  out->wheel_reaches =
+      WheelLatch(root, best_shown.CenterPoint(), /*vertical=*/true,
+                 CarryCanScroll(*best, /*vertical=*/true, /*forward=*/true),
+                 /*pinned=*/nullptr) == best;
+  if (layers && element) {
+    out->layer = InnermostEntry(*layers, *element);
+  }
+  // browser: no wheel reaching it, the topmost entry over its middle
+  // above the one holding it -- a list open over the pane -- by the hit there,
+  // or that entry's veil.
+  if (layers && !out->wheel_reaches && root.View()) {
+    HitTestLocation location(
+        root.View()->ConvertFromRootFrame(best_shown.CenterPoint()));
+    HitTestResult result = root.GetEventHandler().HitTestResultAtLocation(
+        location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                      HitTestRequest::kAllowChildFrameContent);
+    if (const Element* hit = result.InnerElement()) {
+      for (wtf_size_t k = layers->stack.size();
+           k-- > 0 && static_cast<int32_t>(k) > out->layer;) {
+        const wtf_size_t s = layers->stack[k];
+        const Element* veil_element = LayerVeilOf(layers->facts[s]);
+        if (HoldsAcross(*layers->roots[s], *hit) ||
+            (veil_element && HoldsAcross(*veil_element, *hit) &&
+             !(element && HoldsAcross(*veil_element, *element)))) {
+          out->under_layer = static_cast<int32_t>(k);
+          break;
+        }
+      }
+    }
+  }
+  return out;
+}
+
+// Whether a document is about:blank with nothing in its body: no element (an
+// image, a canvas, a video or an svg would be one) and no text.
+bool DocumentBlank(const Document& document) {
+  if (!document.Url().IsAboutBlankUrl()) {
+    return false;
+  }
+  const HTMLElement* body = document.body();
+  return !body || (!ElementTraversal::FirstChild(*body) &&
+                   body->textContent().StripWhiteSpace().empty());
+}
