+void ResourceFetcher::ForEachRecentCountedLoad(
+    base::FunctionRef<void(base::TimeTicks, base::TimeTicks)> fn) const {
+  const uint64_t kept =
+      std::min<uint64_t>(counted_loads_started_, kRecentCountedLoads);
+  for (uint64_t i = counted_loads_started_ - kept; i < counted_loads_started_;
+       ++i) {
+    const RecentCountedLoad& load =
+        recent_counted_loads_[i % kRecentCountedLoads];
+    fn(load.created, load.interaction_origin);
+  }
+}
