+// browser: Input.moveTo's aim. Every client rect of the element (as
+// getClientRects gives them), each clipped as VisibleInRoot clips a box --
+// by what shows of the box that encloses it -- and by the viewport; of the
+// largest piece, the part a press reaches it at (ReachablePart) is where a
+// hand aims. In this local root's widget DIPs.
+void AgentSnapshotCollectorImpl::AimPiece(int32_t local_dom_node_id,
+                                          double hand_x,
+                                          double hand_y,
+                                          bool with_hand,
+                                          AimPieceCallback callback) {
+  auto aim = mojom::blink::AgentAimPiece::New();
+  aim->box = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  aim->piece = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    std::move(callback).Run(std::move(aim));
+    return;
+  }
+  view->UpdateLifecycleToLayoutClean(DocumentUpdateReason::kInspector);
+  Element* element = OwnedElement(root, local_dom_node_id);
+  if (!element) {
+    std::move(callback).Run(std::move(aim));
+    return;
+  }
+  // In the page, though nothing of it may be laid out (display: none): found,
+  // and not in view.
+  aim->found = true;
+  // A frame element: the frame it holds, whose own content takes a press on
+  // it.
+  if (auto* owner = DynamicTo<HTMLFrameOwnerElement>(element)) {
+    if (Frame* content = owner->ContentFrame()) {
+      aim->child_frame_id = String(content->GetDevToolsFrameToken().ToString());
+    }
+  }
+  const LayoutObject* object = element->GetLayoutObject();
+  LocalFrameView* element_view = element->GetDocument().View();
+  const LayoutBox* enclosing = object ? object->EnclosingBox() : nullptr;
+  if (!object || !element_view || !enclosing) {
+    std::move(callback).Run(std::move(aim));
+    return;
+  }
+  // From the local root's frame to its widget's DIPs.
+  const RootDips dips(*view, *widget);
+  // The element's frame to the local root's.
+  const auto in_root = [&](const gfx::RectF& r) {
+    const gfx::PointF start = element_view->ConvertToRootFrame(r.origin());
+    const gfx::PointF end = element_view->ConvertToRootFrame(r.bottom_right());
+    return gfx::RectF(start,
+                      gfx::SizeF(end.x() - start.x(), end.y() - start.y()));
+  };
+  aim->box = dips.Box(in_root(gfx::RectF(object->AbsoluteBoundingBoxRect())));
+  const gfx::RectF viewport = ViewportRect(*view);
+  Vector<gfx::QuadF> quads;
+  object->AbsoluteQuads(quads);
+  gfx::RectF best;
+  for (const gfx::QuadF& quad : quads) {
+    gfx::RectF piece =
+        VisibleInRoot(*enclosing, *root, in_root(quad.BoundingBox()));
+    piece.Intersect(viewport);
+    if (piece.width() * piece.height() > best.width() * best.height()) {
+      best = piece;
+    }
+  }
+  if (!best.IsEmpty()) {
+    // At least 2 DIPs across where it is held back to a line of points:
+    // in_view needs 1.
+    best = ReachablePart(*root, *view, *element, best,
+                         widget->DIPsToBlinkSpace(2.0f));
+    aim->piece = dips.Box(best);
+    aim->in_view = aim->piece->width >= 1 && aim->piece->height >= 1;
+    // The parts of it a press would act on instead of it -- its own links,
+    // buttons, controls: a hand aiming at a card keeps off the link on it.
+    // Its own elements, not a component's insides; what shows and takes a
+    // pointer, clipped as the piece is (links scrolled out of a list in it
+    // make none), and cut to the piece. Past the first kMaxHoles rects the
+    // rest go as one, so none is pressed unseen: kept off, or -- being much
+    // of it -- the element pressed as a whole.
+    int scanned = 0;
+    gfx::RectF more;
+    Element* part = ElementTraversal::FirstWithin(*element);
+    while (part && scanned++ < kHoleScan) {
+      const LayoutObject* part_object = part->GetLayoutObject();
+      const ComputedStyle* part_style = part->GetComputedStyle();
+      if (!part_object || !part_style ||
+          part_style->Visibility() != EVisibility::kVisible ||
+          part_style->IsInert() ||
+          part_style->UsedPointerEvents() == EPointerEvents::kNone ||
+          !ActsOnItsOwn(*part, *element)) {
+        part = ElementTraversal::Next(*part, element);
+        continue;
+      }
+      Vector<gfx::QuadF> part_quads;
+      part_object->AbsoluteQuads(part_quads);
+      const LayoutBox* part_box = part_object->EnclosingBox();
+      // An inline part directly in a scroller: VisibleInRoot clips by the
+      // boxes around its enclosing box, not by that box's own overflow.
+      gfx::RectF own_port;
+      if (!part_object->IsBox() && part_box && part_box->IsScrollContainer()) {
+        own_port = PortOf(*part_box).shown;
+      }
+      for (const gfx::QuadF& quad : part_quads) {
+        gfx::RectF hole = part_box ? VisibleInRoot(*part_box, *root,
+                                                   in_root(quad.BoundingBox()))
+                                   : gfx::RectF();
+        if (!own_port.IsEmpty()) {
+          hole.Intersect(own_port);
+        }
+        hole.Intersect(best);
+        if (hole.IsEmpty()) {
+          continue;
+        }
+        if (aim->holes.size() < kMaxHoles) {
+          aim->holes.push_back(dips.Box(hole));
+        } else {
+          more.Union(hole);
+        }
+      }
+      part = ElementTraversal::NextSkippingChildren(*part, element);
+    }
+    if (!more.IsEmpty()) {
+      aim->holes.push_back(dips.Box(more));
+    }
+  }
+  // The hover region the hand is in on its way to it.
+  if (with_hand && std::isfinite(hand_x) && std::isfinite(hand_y)) {
+    Vector<gfx::RectF> region;
+    HoverRegion(*root, *element, dips.Root(hand_x, hand_y), region);
+    for (const gfx::RectF& r : region) {
+      aim->hover_boxes.push_back(dips.Box(r));
+    }
+  }
+  std::move(callback).Run(std::move(aim));
+}
