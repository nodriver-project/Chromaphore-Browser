+// Whether `layer` holds the frame `rfh` or a frame around it.
+bool LayerHoldsFrame(const blink::mojom::AgentLayer& layer,
+                     RenderFrameHostImpl* rfh) {
+  for (RenderFrameHostImpl* f = rfh; f; f = f->GetParentOrOuterDocument()) {
+    if (std::ranges::find(layer.frame_ids,
