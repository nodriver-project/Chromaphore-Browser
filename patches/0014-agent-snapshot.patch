+namespace content::protocol {
+
+namespace {
+
+// agentSettle's numbers, and the renderer's own bounds on
+// them (AgentSettleWatcher::Await clamps quiet to 5 s and cap to 91 s; an
+// `until` waits 60 s at most there).
+constexpr int kDefaultQuietMs = 150;
+constexpr int kDefaultCapMs = 1500;
+constexpr int kDefaultTimeoutMs = 10000;
+constexpr int kMaxQuietMs = 5000;
+constexpr int kMaxCapMs = 30000;
+constexpr int kMaxTimeoutMs = 60000;
+// The longest deadline from a renderer's T a wait may carry: an `until` of
+// 60 s, then the cap, + 1 s. The agent's own capMs is checked against
+// kMaxCapMs; a no-until wait's cap is the deadline less T, more than 30 s
+// after a long `until` (it was clamped to 30 s, and the renderer answered at
+// once).
+constexpr int kMaxDeadlineMs = kMaxTimeoutMs + kMaxCapMs + 1000;
+// A renderer reading from a fresh baseline (armed by the call itself, or a
+// watch that had stopped looking and resumes) answers by its await + max(quiet,
+// 300 ms) + 100 ms (AgentSettleWatcher::Deadline).
+constexpr base::TimeDelta kFreshRead = base::Milliseconds(300);
+constexpr base::TimeDelta kAwaitGrace = base::Milliseconds(100);
+// Past a renderer's own deadline, how long the browser still waits for its
+// answer: a frozen frame never sends one.
+constexpr base::TimeDelta kSlack = base::Milliseconds(500);
+// A document armed this long after its action reads from now: its action's
+// requests are long done.
+constexpr base::TimeDelta kStaleArm = base::Seconds(20);
+constexpr size_t kMaxUrlChanges = 32;
+constexpr size_t kMaxChanging = 5;
+// An element's name in a change's label, at most (UTF-8 bytes).
+constexpr size_t kLabelNameBytes = 60;
+
+// A local root the settle can watch: live, in the page, not leaving it or in
+// the back-forward cache (frozen: it never answers).
+bool Armable(RenderFrameHostImpl& frame) {
+  return frame.IsRenderFrameLive() && frame.is_local_root() && frame.IsActive();
+}
+
+std::string FrameName(RenderFrameHostImpl& frame) {
+  if (!frame.GetParentOrOuterDocument()) {
+    return "main";
+  }
+  const GURL& url = frame.GetLastCommittedURL();
+  return base::StrCat(
+      {"frame ", url.has_host() ? url.host() : std::string_view("(no host)")});
+}
+
+int32_t CapMs(base::TimeDelta cap) {
+  return static_cast<int32_t>(
+      std::clamp<int64_t>(cap.InMillisecondsRoundedUp(), 0, kMaxDeadlineMs));
+}
+
+// The renderer's answer for an arm it no longer holds (its 10 s lease ran
+// out, or a navigation ended it): AgentSettleWatcher::Await.
+bool NotArmed(const blink::mojom::AgentSettleReading& reading) {
+  return !reading.settled && reading.changing.size() == 1 &&
+         reading.changing[0]->kind == "lifecycle" &&
+         reading.changing[0]->what == "not armed";
+}
+
+// A reading's milliseconds since its T, held to the time that has passed
+// since T by `now`: the renderer's figure is not trusted.
+int64_t ReadingMs(int64_t ms, base::TimeTicks t, base::TimeTicks now) {
+  const int64_t passed = std::max<int64_t>(0, (now - t).InMilliseconds());
+  return std::clamp<int64_t>(ms, 0, passed);
+}
+
+std::string PendingWhat(const GURL& url) {
+  std::string what = "navigation pending";
+  if (url.has_host()) {
+    what += ": ";
+    what += url.host();
+    what += url.path();
+  }
+  return what.size() > 160 ? what.substr(0, 160) : what;
+}
+
+// The agent's label for an element: a12 "Save".
+std::string LabelText(const SettleJoin::Label& label) {
+  if (label.name.empty()) {
+    return label.mark;
+  }
+  return base::StrCat(
+      {label.mark, " \"",
+       base::TruncateUTF8ToByteSize(label.name, kLabelNameBytes), "\""});
+}
+
+// The renderer's tag#id.class in `what` gives way to the agent's label:
+// "div#x (gone)" -> a12 "Save" (gone); "transition opacity on div#x (0.4s
+// left)" -> transition opacity on a12 "Save" (0.4s left). A changed element
+// is given its mark alone (Name): "div#x (changed)" -> a12 (changed).
+std::string Relabel(const std::string& what,
+                    const std::string& label,
+                    bool animation) {
+  const std::string_view text(what);
+  const size_t note = text.rfind(" (");
+  const bool has_note = note != std::string_view::npos && text.ends_with(')');
+  if (animation) {
+    const size_t on = text.find(" on ");
+    if (on == std::string_view::npos) {
+      return base::StrCat({text, " (", label, ")"});
+    }
+    const size_t end = has_note && note > on ? note : text.size();
+    return base::StrCat({text.substr(0, on + 4), label, text.substr(end)});
+  }
+  return has_note ? base::StrCat({label, text.substr(note)}) : label;
+}
+
+}  // namespace
+
+// ============================================================ the renderer
+
+SettleRenderer::SettleRenderer() = default;
+SettleRenderer::~SettleRenderer() = default;
+
+bool SettleRenderer::Current() const {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(frame);
+  return rfh && Armable(*rfh) && rfh->GetDocumentToken() == document;
+}
+
+// ================================================================= the arm
+
+SettleArm::SettleArm() = default;
+
+SettleArm::~SettleArm() {
+  DisarmAll();
+  // A call waiting on this arm goes on with what it has.
+  NotifyJoins();
+}
+
+void SettleArm::Arm(WebContents* contents,
+                    int arm_id,
+                    base::TimeTicks t,
+                    bool look) {
+  // The renderers of the arm before get this one, which answers a wait still
+  // out there first; their pipes close with the last call holding them.
+  renderers_.clear();
+  url_changes_.clear();
+  first_commit_ = base::TimeTicks();
+  first_new_tab_ = base::TimeTicks();
+  first_print_ = base::TimeTicks();
+  url_at_arm_ = GURL();
+  id_ = contents ? arm_id : 0;
+  t_ = t;
+  look_ = look;
+  contents_ = contents ? contents->GetWeakPtr() : nullptr;
+  // A call still waiting on the arm before goes on with what it has (an
+  // `until` it waits for ends now).
+  NotifyJoins();
+  if (id_ == 0) {
+    return;
+  }
+  RenderFrameHostImpl* main_frame =
+      static_cast<WebContentsImpl*>(contents)->GetPrimaryMainFrame();
+  url_at_arm_ = main_frame->GetLastCommittedURL();
+  // Every live local root, as captureAgentSnapshot enumerates them.
+  main_frame->ForEachRenderFrameHostImpl([this](RenderFrameHostImpl* frame) {
+    if (!Armable(*frame)) {
+      return;
+    }
+    if (scoped_refptr<SettleRenderer> renderer =
+            Bind(*frame, t_, /*committed_after_arm=*/false)) {
+      renderers_.push_back(std::move(renderer));
+    }
+  });
+}
+
+void SettleArm::Drop(int arm_id) {
+  if (arm_id != 0 && arm_id == id_) {
+    Clear();
+  }
+}
+
+void SettleArm::Clear() {
+  DisarmAll();
+  renderers_.clear();
+  url_changes_.clear();
+  first_commit_ = base::TimeTicks();
+  first_new_tab_ = base::TimeTicks();
+  first_print_ = base::TimeTicks();
+  url_at_arm_ = GURL();
+  id_ = 0;
+  t_ = base::TimeTicks();
+  look_ = false;
+  contents_ = nullptr;
+  NotifyJoins();
+}
+
+std::optional<base::TimeTicks> SettleArm::UrlChangedAt() const {
+  for (const UrlChange& change : url_changes_) {
+    if (change.url != url_at_arm_) {
+      return change.at;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<base::TimeTicks> SettleArm::UrlContainsAt(
+    const std::string& needle) const {
+  if (url_at_arm_.possibly_invalid_spec().find(needle) != std::string::npos) {
+    return t_;
+  }
+  for (const UrlChange& change : url_changes_) {
+    if (change.url.possibly_invalid_spec().find(needle) != std::string::npos) {
+      return change.at;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<base::TimeTicks> SettleArm::NewTabAt() const {
+  if (first_new_tab_.is_null()) {
+    return std::nullopt;
+  }
+  return first_new_tab_;
+}
+
+std::optional<base::TimeTicks> SettleArm::PrintAt() const {
+  if (first_print_.is_null()) {
+    return std::nullopt;
+  }
+  return first_print_;
+}
+
+scoped_refptr<SettleRenderer> SettleArm::RendererFor(
+    RenderFrameHostImpl* local_root,
+    bool* late) {
+  *late = false;
+  if (id_ == 0 || !local_root) {
+    return nullptr;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  for (const scoped_refptr<SettleRenderer>& renderer : renderers_) {
+    if (renderer->frame != local_root->GetGlobalId() ||
+        renderer->document != local_root->GetDocumentToken()) {
+      continue;
+    }
+    if (renderer->armed && renderer->collector.is_connected()) {
+      return renderer;
+    }
+    // Disarmed (an `until` was answered) or its pipe closed: armed again at
+    // its T, from a fresh baseline.
+    if (!renderer->collector.is_connected()) {
+      service_manager::InterfaceProvider* remotes =
+          local_root->GetRemoteInterfaces();
+      if (!remotes) {
+        return nullptr;
+      }
+      renderer->collector.reset();
+      remotes->GetInterface(renderer->collector.BindNewPipeAndPassReceiver());
+    }
+    if (now - renderer->t > kStaleArm) {
+      renderer->t = now;
+      renderer->committed_after_arm = false;
+    }
+    renderer->collector->ArmSettle(id_, renderer->t, look_);
+    renderer->armed = true;
+    *late = true;
+    return renderer;
+  }
+  // Not reached by the arm (it was not live then): armed now, at T -- or at
+  // now, long after T.
+  scoped_refptr<SettleRenderer> renderer =
+      Bind(*local_root, now - t_ > kStaleArm ? now : t_,
+           /*committed_after_arm=*/false);
+  if (renderer) {
+    renderers_.push_back(renderer);
+    *late = true;
+  }
+  return renderer;
+}
+
+scoped_refptr<SettleRenderer> SettleArm::RendererToRead(
+    RenderFrameHostImpl* local_root) {
+  if (id_ == 0 || !local_root) {
+    return nullptr;
+  }
+  for (const scoped_refptr<SettleRenderer>& renderer : renderers_) {
+    if (renderer->frame == local_root->GetGlobalId() &&
+        renderer->document == local_root->GetDocumentToken() &&
+        renderer->collector.is_connected()) {
+      return renderer;
+    }
+  }
+  bool late = false;
+  return RendererFor(local_root, &late);
+}
+
+void SettleArm::AddJoin(base::WeakPtr<SettleJoin> join) {
+  std::erase_if(joins_,
+                [](const base::WeakPtr<SettleJoin>& kept) { return !kept; });
+  joins_.push_back(std::move(join));
+}
+
+void SettleArm::DidFinishNavigation(NavigationHandle* handle) {
+  if (id_ == 0) {
+    return;
+  }
+  if (!handle->HasCommitted()) {
+    // A download, a 204, a navigation cancelled or replaced: no document,
+    // but a call waiting for it to end hears that it has.
+    NotifyJoins();
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // A new document's T is when the browser sent its commit, before it could
+  // start anything -- not before the arm's T, nor after now.
+  base::TimeTicks at = now;
+  if (!handle->IsSameDocument()) {
+    const base::TimeTicks sent =
+        handle->GetNavigationHandleTiming().navigation_commit_sent_time;
+    if (!sent.is_null()) {
+      at = std::max(std::min(sent, now), std::min(t_, now));
+    }
+  }
+  if (handle->IsInPrimaryMainFrame()) {
+    if (url_changes_.size() < kMaxUrlChanges) {
+      url_changes_.push_back(UrlChange{at, handle->GetURL()});
+    }
+    if (!handle->IsSameDocument() && first_commit_.is_null()) {
+      first_commit_ = at;
+    }
+  }
+  if (!handle->IsSameDocument()) {
+    // Documents gone from the page are forgotten; a local root's new one is
+    // armed at its commit (spec 1).
+    std::erase_if(renderers_, [](const scoped_refptr<SettleRenderer>& kept) {
+      return !kept->Current();
+    });
+    auto* frame =
+        static_cast<RenderFrameHostImpl*>(handle->GetRenderFrameHost());
+    const bool known =
+        frame &&
+        std::ranges::any_of(
+            renderers_, [frame](const scoped_refptr<SettleRenderer>& kept) {
+              return kept->frame == frame->GetGlobalId() &&
+                     kept->document == frame->GetDocumentToken();
+            });
+    // Long after the action, with no call waiting, a commit is not armed: a
+    // later call arms it then (RendererFor).
+    std::erase_if(joins_,
+                  [](const base::WeakPtr<SettleJoin>& kept) { return !kept; });
+    const bool stale = now - t_ > kStaleArm && joins_.empty();
+    if (frame && !known && !stale && Armable(*frame)) {
+      if (scoped_refptr<SettleRenderer> renderer =
+              Bind(*frame, at, /*committed_after_arm=*/true)) {
+        renderers_.push_back(std::move(renderer));
+      }
+    }
+  }
+  NotifyJoins();
+}
+
+void SettleArm::DidOpenTab(WebContents* new_contents) {
+  if (id_ == 0 || !new_contents || new_contents == contents_.get() ||
+      !first_new_tab_.is_null()) {
+    return;
+  }
+  first_new_tab_ = base::TimeTicks::Now();
+  NotifyJoins();
+}
+
+void SettleArm::DidRequestPrint() {
+  if (id_ == 0 || !first_print_.is_null()) {
+    return;
+  }
+  first_print_ = base::TimeTicks::Now();
+}
+
+scoped_refptr<SettleRenderer> SettleArm::Bind(RenderFrameHostImpl& frame,
+                                              base::TimeTicks t,
+                                              bool committed_after_arm) {
+  service_manager::InterfaceProvider* remotes = frame.GetRemoteInterfaces();
+  if (!remotes) {
+    return nullptr;
+  }
+  auto renderer = base::MakeRefCounted<SettleRenderer>();
+  renderer->frame = frame.GetGlobalId();
+  renderer->document = frame.GetDocumentToken();
+  renderer->t = t;
+  renderer->committed_after_arm = committed_after_arm;
+  renderer->name = FrameName(frame);
+  remotes->GetInterface(renderer->collector.BindNewPipeAndPassReceiver());
+  // A message: the press, key, pick or drop never waits for it.
+  renderer->collector->ArmSettle(id_, t, look_);
+  renderer->armed = true;
+  return renderer;
+}
+
+void SettleArm::DisarmAll() {
+  for (const scoped_refptr<SettleRenderer>& renderer : renderers_) {
+    if (renderer->armed && renderer->collector.is_connected()) {
+      renderer->collector->DisarmSettle(id_);
+    }
+    renderer->armed = false;
+  }
+}
+
+// Posted: the watch is inside its WebContentsObserver call, and its own
+// bookkeeping of the navigation comes after this.
+void SettleArm::NotifyJoins() {
+  std::erase_if(joins_,
+                [](const base::WeakPtr<SettleJoin>& kept) { return !kept; });
+  if (joins_.empty() || !base::SequencedTaskRunner::HasCurrentDefault()) {
+    return;
+  }
+  for (const base::WeakPtr<SettleJoin>& join : joins_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SettleJoin::OnArmChanged, join));
+  }
+}
