+  bool until_seen_ = false;
+  bool until_invalid_ = false;
+  base::TimeTicks until_met_at_;
+  base::TimeTicks until_checked_at_;
+  uint64_t until_checked_stamp_ = 0;
+  base::TimeTicks until_limit_;
