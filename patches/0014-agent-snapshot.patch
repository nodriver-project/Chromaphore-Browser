+
+void AgentSnapshotCollectorImpl::CarrySettled(int32_t local_dom_node_id,
+                                              double aim_x,
+                                              double aim_y,
+                                              double x,
+                                              double y,
+                                              int32_t axis,
+                                              int32_t timeout_ms,
+                                              CarrySettledCallback callback) {
+  PollCarrySettled(local_dom_node_id, aim_x, aim_y, x, y, axis,
+                   base::TimeTicks::Now() + base::Milliseconds(std::clamp(
+                                                timeout_ms, 0, kSettleMaxMs)),
+                   Vector<double>(), 0, std::move(callback));
+}
+
+void AgentSnapshotCollectorImpl::PollCarrySettled(
+    int32_t local_dom_node_id,
+    double aim_x,
+    double aim_y,
+    double x,
+    double y,
+    int32_t axis,
+    base::TimeTicks deadline,
+    Vector<double> last,
+    int still,
+    CarrySettledCallback callback) {
+  // The offsets of every scroller that holds the element, as they are now:
+  // the wheel's smooth scroll moves them a frame at a time.
+  Vector<double> now;
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  const LayoutObject* object = element ? element->GetLayoutObject() : nullptr;
+  if (object) {
+    HeapVector<Member<const LayoutBox>> chain;
+    CarryChain(*object, chain);
+    for (const auto& box : chain) {
+      if (PaintLayerScrollableArea* area = box->GetScrollableArea()) {
+        now.push_back(area->GetScrollOffset().x());
+        now.push_back(area->GetScrollOffset().y());
+      }
+    }
+  }
+  still = !last.empty() && now == last ? still + 1 : 0;
+  // Still across three looks, about 50 ms: the scroll has run out.
+  if (!object || still >= kStillLooks || base::TimeTicks::Now() >= deadline) {
+    std::move(callback).Run(ReadCarry(local_dom_node_id, aim_x, aim_y, x, y,
+                                      axis, /*binder=*/nullptr,
+                                      /*find_wheel=*/true, /*name_veil=*/true));
+    return;
+  }
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostDelayedTask(
+          FROM_HERE,
+          blink::BindOnce(&AgentSnapshotCollectorImpl::PollCarrySettled,
+                          WrapWeakPersistent(this), local_dom_node_id, aim_x,
+                          aim_y, x, y, axis, deadline, std::move(now), still,
+                          std::move(callback)),
+          kSettleLook);
+}
+
+// browser: Input.scrollBy's read.
+void AgentSnapshotCollectorImpl::WheelScrollerAt(
+    double x,
+    double y,
+    int32_t axis,
+    bool forward,
+    int32_t scroller_id,
+    bool check_latch,
+    bool past_remote_frame,
+    int32_t settle_ms,
+    WheelScrollerAtCallback callback) {
+  WheelAsk ask;
+  ask.x = x;
+  ask.y = y;
+  ask.axis = axis == 2 ? WheelAxis::kAcross : WheelAxis::kDown;
+  ask.way = forward ? WheelWay::kForward : WheelWay::kBack;
+  ask.scroller_id = scroller_id;
+  ask.latch_check =
+      check_latch ? WheelLatchCheck::kCheck : WheelLatchCheck::kSkip;
+  ask.past = past_remote_frame ? WheelPastFrame::kPass : WheelPastFrame::kStop;
+  if (scroller_id != 0 && settle_ms > 0) {
+    ask.layout = WheelLayout::kBringClean;
+    PollWheelSettled(ask,
+                     base::TimeTicks::Now() + base::Milliseconds(std::clamp(
+                                                  settle_ms, 0, kSettleMaxMs)),
+                     Vector<double>(), 0, std::move(callback));
+    return;
+  }
+  // A read of the scroller a scroll under way turns: contact for the action
+  // the settle watcher is armed for, so it goes on looking to the scroll's
+  // end.
+  if (scroller_id != 0 && settle_watcher_) {
+    settle_watcher_->KeepLooking();
+  }
+  // A hit test needs layout as it is now: the first read and a latch check.
+  // A progress read takes the offsets as they are.
+  ask.layout = scroller_id == 0 || check_latch ? WheelLayout::kBringClean
+                                               : WheelLayout::kAsIs;
+  std::move(callback).Run(ReadWheelScrollerNow(ask));
+}
+
+void AgentSnapshotCollectorImpl::PollWheelSettled(
+    WheelAsk ask,
+    base::TimeTicks deadline,
+    Vector<double> last,
+    int still,
+    WheelScrollerAtCallback callback) {
+  // Contact on every look: the watch armed for the scroll keeps looking, and
+  // its lease stays fresh, for as long as the scroll runs.
+  if (settle_watcher_) {
+    settle_watcher_->KeepLooking();
+  }
+  // The scroller's offset and the window's along the axis, as they are now:
+  // the wheel's smooth scroll moves them a frame at a time.
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  const LayoutBox* box = ScrollBoxOfId(root, ask.scroller_id);
+  const LayoutBox* window = root ? root->ContentLayoutObject() : nullptr;
+  Vector<double> now;
+  for (const LayoutBox* watched : {box, window}) {
+    if (PaintLayerScrollableArea* area =
+            watched ? watched->GetScrollableArea() : nullptr) {
+      now.push_back(ask.axis == WheelAxis::kDown ? area->GetScrollOffset().y()
+                                                 : area->GetScrollOffset().x());
+    }
+  }
+  still = !last.empty() && now == last ? still + 1 : 0;
+  // Nothing to watch, or still across three looks: the scroll has run out.
+  if (!box || now.empty() || still >= kStillLooks ||
+      base::TimeTicks::Now() >= deadline) {
+    std::move(callback).Run(ReadWheelScrollerNow(ask));
+    return;
+  }
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kInternalUserInteraction)
+      ->PostDelayedTask(
+          FROM_HERE,
+          blink::BindOnce(&AgentSnapshotCollectorImpl::PollWheelSettled,
+                          WrapWeakPersistent(this), ask, deadline,
+                          std::move(now), still, std::move(callback)),
+          kSettleLook);
+}
+
+mojom::blink::AgentWheelScrollerPtr
+AgentSnapshotCollectorImpl::ReadWheelScrollerNow(const WheelAsk& ask) {
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    return EmptyWheelScroller();
+  }
+  // Layout only, as ReadCarry brings it, and only where a hit test or the
+  // settled read needs it.
+  if (ask.layout == WheelLayout::kBringClean) {
+    view->UpdateLifecycleToLayoutClean(DocumentUpdateReason::kInspector);
+  }
+  const LayoutBox* asked = nullptr;
+  if (ask.scroller_id != 0) {
+    asked = ScrollBoxOfId(root, ask.scroller_id);
+    if (!asked) {
+      return EmptyWheelScroller();
+    }
+  }
+  const RootDips dips(*view, *widget);
+  return ReadWheelScroller(*root, dips, dips.Root(ask.x, ask.y), ask.axis,
+                           ask.way, asked, ask.latch_check, ask.past,
+                           ask.layout);
+}
+
+mojom::blink::AgentCarryReadingPtr AgentSnapshotCollectorImpl::ReadCarry(
+    int32_t local_dom_node_id,
+    double aim_x,
+    double aim_y,
+    double x,
+    double y,
+    int32_t axis,
+    WheelBinder* binder,
+    bool find_wheel,
+    bool name_veil) {
+  auto reading = mojom::blink::AgentCarryReading::New();
+  reading->box = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  reading->box_name = g_empty_string;
+  reading->covering = g_empty_string;
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    return reading;
+  }
+  // Laid out as it is now, as the hit test below would bring it anyway: layout
+  // only, nothing further, as often as a carry asks.
+  view->UpdateLifecycleToLayoutClean(DocumentUpdateReason::kInspector);
+  Element* element = OwnedElement(root, local_dom_node_id);
+  const LayoutObject* object = element ? element->GetLayoutObject() : nullptr;
+  LocalFrameView* element_view =
+      element ? element->GetDocument().View() : nullptr;
+  if (!object || !element_view) {
+    return reading;
+  }
+  HeapVector<Member<const LayoutBox>> chain;
+  CarryChain(*object, chain);
+
+  // From the local root's frame to its widget's DIPs.
+  const RootDips dips(*view, *widget);
+  const gfx::RectF box(
+      element_view->ConvertToRootFrame(object->AbsoluteBoundingBoxRect()));
+  const gfx::PointF aim(box.x() + box.width() * std::clamp(aim_x, 0.0, 1.0),
+                        box.y() + box.height() * std::clamp(aim_y, 0.0, 1.0));
+  CarryNeedOf across = CarryNeed(chain, /*vertical=*/false, aim.x(), object);
+  CarryNeedOf down = CarryNeed(chain, /*vertical=*/true, aim.y(), object);
+  UnstickNeed(across, chain, *object, /*vertical=*/false, aim.x());
+  UnstickNeed(down, chain, *object, /*vertical=*/true, aim.y());
+  // What lies over the box where the element would come to rest -- a fixed
+  // bar, a sticky header -- is taken out of that stretch: the element is
+  // brought to the uncovered part nearest, and when there is none, the carry
+  // is told what covers it.
+  String covering;
+  bool main_vertical = std::abs(down.need) >= std::abs(across.need);
+  // What a root-frame px is in DIPs along each axis: the drive takes a need
+  // under half a DIP as arrived.
+  const gfx::Vector2dF dips_per_px =
+      dips.Dips(aim + gfx::Vector2dF(1, 1)) - dips.Dips(aim);
+  // The box that scrolls the main axis out of view across it, where the
+  // stretch along it is read -- a wide box below the fold: no wheel
+  // reaches it there, and the stretch cannot be read for covers yet. The other
+  // axis brings it into view first -- a need of a DIP or more, one the drive
+  // turns for -- and the main axis's need waits for the next reading (its rest
+  // kept, in view, where a drag's hand waits).
+  bool deferred = false;
+  {
+    CarryNeedOf& along = main_vertical ? down : across;
+    const CarryNeedOf& other = main_vertical ? across : down;
+    const float other_dips =
+        std::abs(other.need) *
+        std::abs(main_vertical ? dips_per_px.x() : dips_per_px.y());
+    if (other_dips >= 1.f &&
+        OutOfViewAcross(chain, along, other, main_vertical ? aim.x() : aim.y(),
+                        main_vertical)) {
+      along.need = 0;
+      main_vertical = !main_vertical;
+      deferred = true;
+    }
+  }
+  CarryNeedOf& primary = main_vertical ? down : across;
+  CarryNeedOf& secondary = main_vertical ? across : down;
+  float lo = 0;
+  float hi = 0;
+  bool read = false;
+  bool other_first = !deferred;
+  // browser: where the cover named was met, for the veil's naming.
+  std::optional<gfx::PointF> cover_at;
+  if (CarryStretchClear(*root, chain, *object, aim, main_vertical, primary,
+                        secondary, lo, hi, read, &covering,
+                        /*runs_out=*/nullptr, /*pinned_out=*/nullptr,
+                        &cover_at)) {
+    if (read && (lo != primary.calm_lo || hi != primary.calm_hi)) {
+      TakeUncovered(primary, main_vertical ? aim.y() : aim.x(), lo, hi);
+    }
+    // The main stretch clear and the element in place along it, yet covered
+    // where it is by what stays put in the box that scrolls the other axis --
+    // a sticky column in a row that scrolls across, on a page that scrolls
+    // down, the row passed over: along the other axis it may be brought out
+    // from under. In place: under a DIP, what neither the drive nor a drag's
+    // stages turn for.
+    String own;
+    other_first =
+        other_first &&
+        std::abs(primary.need) *
+                std::abs(main_vertical ? dips_per_px.y() : dips_per_px.x()) <
+            1.f &&
+        !chain.empty() && secondary.holder != primary.holder &&
+        CarryCovered(
+            *root, aim,
+            *chain[std::min<wtf_size_t>(secondary.holder, chain.size() - 1)],
+            *object, &own);
+  }
+  if (other_first) {
+    // All of the main stretch covered where the element is, or the element
+    // covered where it is by what the other axis's box holds: along the other
+    // axis it may be brought out from under first -- a link far along a row
+    // that scrolls only across, under a fixed bar. The main axis waits for
+    // the next reading; nothing uncovered that way, the main read stands.
+    float lo2 = 0;
+    float hi2 = 0;
+    bool read2 = false;
+    String under;
+    if (CarryStretchClear(*root, chain, *object, aim, !main_vertical, secondary,
+                          primary, lo2, hi2, read2, &under) &&
+        read2 && (lo2 != secondary.calm_lo || hi2 != secondary.calm_hi)) {
+      const float at2 = main_vertical ? aim.x() : aim.y();
+      CarryNeedOf out = secondary;
+      TakeUncovered(out, at2, lo2, hi2);
+      UnstickNeed(out, chain, *object, !main_vertical, at2);
+      // Only where the scroll left can bring it there: a page that cannot
+      // scroll that way, or a fixed sheet's row, stays covered.
+      if (std::abs(out.need) >= 0.5f &&
+          StaysPutRoom(chain, PinnedAbove(*object), !main_vertical,
+                       main_vertical ? box.x() : box.y(),
+                       main_vertical ? box.right() : box.bottom(), lo2, hi2)) {
+        secondary = out;
+        primary.need = 0;
+        primary.rest = main_vertical ? aim.y() : aim.x();
+        covering = String();
+      }
+    }
+  }
+  // The sticky rule once more: taking what covers the stretch out of it set
+  // the need afresh.
+  UnstickNeed(primary, chain, *object, main_vertical,
+              main_vertical ? aim.y() : aim.x());
+  // browser: for a reading a session answers with, a cover on a
+  // layer's veil -- its backdrop, beside its box -- named by its layer, as the
+  // press check names it: when a read-only hit test where that cover was met
+  // (else at the aim, for what stays put over it there) meets it again, with
+  // no layer of its own.
+  if (name_veil && !covering.empty()) {
+    HitTestLocation location(
+        view->ConvertFromRootFrame(cover_at.value_or(aim)));
+    HitTestResult result = root->GetEventHandler().HitTestResultAtLocation(
+        location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                      HitTestRequest::kAllowChildFrameContent);
+    Element* hit = result.InnerElement();
+    String hit_kind;
+    if (hit && hit != element &&
+        !FlatTreeTraversal::IsDescendantOf(*hit, *element) &&
+        CoverFrom(*hit, *element, &hit_kind) == covering && hit_kind.empty()) {
+      const char* veil_kind = nullptr;
+      const String layer = VeilLayerName(*root, *hit, *element, veil_kind);
+      if (!layer.empty()) {
+        covering = CoverWhere(*hit, *element, layer);
+      }
+    }
+  }
+  reading->covering = NonNull(covering);
+  const gfx::Vector2dF need(across.need, down.need);
+  const gfx::PointF aim_dips = dips.Dips(aim);
+  const gfx::PointF short_of = dips.Dips(aim - need);
+  const gfx::PointF box_start = dips.Dips(box.origin());
+  const gfx::PointF box_end = dips.Dips(box.bottom_right());
+  const gfx::PointF rest = dips.Dips(gfx::PointF(across.rest, down.rest));
+  reading->rest_x = rest.x();
+  reading->rest_y = rest.y();
+  bool land_calm = !across.gapped && !down.gapped;
+  // The calm stretch within what shows: a box passed over (CarryNeed)
+  // shows less than the stretch around it; elsewhere it lies within.
+  const gfx::PointF landing(
+      CarryLandAlong(aim.x(), box.x(), box.right(),
+                     std::max(across.calm_lo, across.shown_lo),
+                     std::min(across.calm_hi, across.shown_hi), across.shown_lo,
+                     across.shown_hi, &land_calm),
+      CarryLandAlong(aim.y(), box.y(), box.bottom(),
+                     std::max(down.calm_lo, down.shown_lo),
+                     std::min(down.calm_hi, down.shown_hi), down.shown_lo,
+                     down.shown_hi, &land_calm));
+  const gfx::PointF land = dips.Dips(landing);
+  reading->land_x = land.x();
+  reading->land_y = land.y();
+  reading->land_calm = land_calm;
+  // browser: whether it shows where it is now, with the landing on that part:
+  // Input.revealElement leaves such an element where it is, as a hand clicks
+  // what it can see.
+  reading->land_shown = LandShows(box.x(), box.right(), across, landing.x()) &&
+                        LandShows(box.y(), box.bottom(), down, landing.y());
+  reading->found = true;
+  if (auto* owner = DynamicTo<HTMLFrameOwnerElement>(element)) {
+    if (Frame* content = owner->ContentFrame()) {
+      reading->child_frame_id =
+          String(content->GetDevToolsFrameToken().ToString());
+    }
+  }
+  reading->aim_x = aim_dips.x();
+  reading->aim_y = aim_dips.y();
+  reading->box = mojom::blink::AgentElementBox::New(
+      box_start.x(), box_start.y(), box_end.x() - box_start.x(),
+      box_end.y() - box_start.y());
+  reading->need_x = aim_dips.x() - short_of.x();
+  reading->need_y = aim_dips.y() - short_of.y();
+  reading->calm_x = across.calm_length * dips_per_px.x();
+  reading->calm_y = down.calm_length * dips_per_px.y();
+  reading->firm_x = across.firm_length * dips_per_px.x();
+  reading->firm_y = down.firm_length * dips_per_px.y();
+
+  // Scroll offsets, in CSS px as scrollLeft and scrollTop give them.
+  if (PaintLayerScrollableArea* window = view->LayoutViewport()) {
+    const LayoutView* layout_view = root->ContentLayoutObject();
+    const float zoom =
+        layout_view ? layout_view->StyleRef().EffectiveZoom() : 1.f;
+    reading->window_x = window->GetScrollOffset().x() / zoom;
+    reading->window_y = window->GetScrollOffset().y() / zoom;
+  }
+  // The nearest box that holds it and that a wheel scrolls -- not a wrapper
+  // that only clips.
+  for (const auto& scroller : chain) {
+    if (scroller->IsLayoutView()) {
+      continue;
+    }
+    PaintLayerScrollableArea* area = scroller->GetScrollableArea();
+    if (!area || (!area->UserInputScrollable(kVerticalScrollbar) &&
+                  !area->UserInputScrollable(kHorizontalScrollbar))) {
+      continue;
+    }
+    const float zoom = scroller->StyleRef().EffectiveZoom();
+    reading->box_x = area->GetScrollOffset().x() / zoom;
+    reading->box_y = area->GetScrollOffset().y() / zoom;
+    if (auto* named = DynamicTo<Element>(scroller->GetNode())) {
+      reading->box_name = DescribeHit(*named);
+    }
+    break;
+  }
+
+  // browser: the bands a held drag scrolls in -- within 20 px of the edges of
+  // each scroller a user can scroll, on any side: Blink's 200 ms runs there
+  // whether or not it can scroll that way (LayoutBox::FindAutoscrollable,
+  // CalculateAutoscrollDirection; AutoscrollController) -- for the hand to
+  // cross quickly.
+  for (const auto& scroller : chain) {
+    if (!scroller->IsUserScrollable()) {
+      continue;  // passed over, as Blink passes over it to the next one out
+    }
+    const CarryPort port = PortOf(*scroller);
+    if (port.outer.IsEmpty()) {
+      continue;
+    }
+    gfx::RectF inner = port.outer;
+    inner.Inset(gfx::InsetsF(kCarryBelt));
+    auto belt = mojom::blink::AgentScrollBelt::New();
+    belt->outer = dips.Box(port.border);
+    belt->inner = dips.Box(inner);
+    belt->up = CarryCanScroll(*scroller, /*vertical=*/true, /*forward=*/false);
+    belt->down = CarryCanScroll(*scroller, /*vertical=*/true, /*forward=*/true);
+    belt->left =
+        CarryCanScroll(*scroller, /*vertical=*/false, /*forward=*/false);
+    belt->right =
+        CarryCanScroll(*scroller, /*vertical=*/false, /*forward=*/true);
+    reading->belts.push_back(std::move(belt));
+  }
+
+  // The wheel at (x, y), turned along the axis asked about toward the need:
+  // whether what it scrolls there (WheelLatch) holds the element and may move
+  // it there.
+  const bool vertical =
+      axis == 1   ? true
+      : axis == 2 ? false
+                  : std::abs(reading->need_y) >= std::abs(reading->need_x);
+  const double toward = vertical ? reading->need_y : reading->need_x;
+  const wtf_size_t movers_from =
+      vertical ? down.movers_from : across.movers_from;
+  const wtf_size_t movers_to = vertical ? down.movers_to : across.movers_to;
+  const auto moves_it = [&](const LayoutBox* latched) {
+    for (wtf_size_t i = movers_from;
+         latched && i < chain.size() && i <= movers_to; ++i) {
+      if (chain[i] == latched) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // browser: WheelStation's question stops here, with what it needs to find
+  // a station of its own; no wheel is judged at (x, y).
+  if (binder) {
+    binder->chain = chain;
+    binder->vertical = vertical;
+    binder->toward = toward;
+    binder->movers_from = movers_from;
+    binder->movers_to = movers_to;
+    return reading;
+  }
+  if (std::abs(toward) >= 0.5) {
+    const gfx::PointF asked = dips.Root(x, y);
+    // In a frame of another process, only where the page shows that frame: a
+    // turn anywhere else goes to the page.
+    const bool remote = root->IsLocalRoot() && !root->IsOutermostMainFrame();
+    const gfx::RectF shows(root->RemoteViewportIntersection());
+    reading->wheel_ok =
+        (!remote || shows.Contains(asked)) &&
+        moves_it(WheelLatch(*root, asked, vertical, toward > 0, nullptr));
+    // browser: not for DragSurvey (find_wheel false): there WheelStation
+    // finds the wheel's place. At a frame of another process the reveal asks
+    // WheelPlaces for places of its own, when it needs them.
+    if (find_wheel && !reading->wheel_ok && !chain.empty()) {
+      // Where it would: the nearest of a grid of places over the
+      // scroller that binds the need, in the window, a little in from their
+      // edges -- not over something fixed or sticky when anywhere else will
+      // do.
+      const wtf_size_t bind_at =
+          std::min<wtf_size_t>(movers_to, chain.size() - 1);
+      gfx::RectF area = PortOf(*chain[bind_at]).shown;
+      area.Intersect(PortOf(*chain.back()).shown);
+      if (remote) {
+        area.Intersect(shows);
+      }
+      // Clear of the autoscroll belt, which a held drag sets going, where the
+      // area is big enough to have a part clear of it.
+      area.Inset(gfx::InsetsF::VH(
+          std::min(kCarryBelt + 4, std::max(0.f, area.height() / 2 - 1)),
+          std::min(kCarryBelt + 4, std::max(0.f, area.width() / 2 - 1))));
+      gfx::PointF best_at;
+      const bool found = NearestWheelPlace(
+          area, asked,
+          [&](const gfx::PointF& at, bool* pinned) {
+            return moves_it(
+                WheelLatch(*root, at, vertical, toward > 0, pinned));
+          },
+          best_at);
+      if (found) {
+        const gfx::PointF place = dips.Dips(best_at);
+        reading->wheel_found = true;
+        reading->wheel_x = place.x();
+        reading->wheel_y = place.y();
+      }
+    }
+  }
+  return reading;
+}
+
+// browser: Input.revealElement at a frame of another process. What the page
+// lays over this frame is not seen here, and the browser routes every place in
+// turn until one reaches the frame: so they lie in lines each way, close enough
+// that any band of the frame about kStepDips across -- a strip a bar leaves
+// clear -- holds some (on a frame up to kMaxRows lines tall and kMaxColumns
+// wide; wider apart past that, the cost held to some 400 hit tests), at one
+// random offset a call and anywhere along a line within its cell, so no two
+// visits lay them alike; each where the wheel moves what holds the element
+// toward its need (WheelLatch), unpinned first, then nearest the pointer.
+void AgentSnapshotCollectorImpl::WheelPlaces(int32_t local_dom_node_id,
+                                             double aim_x,
+                                             double aim_y,
+                                             double x,
+                                             double y,
+                                             int32_t axis,
+                                             WheelPlacesCallback callback) {
+  Vector<mojom::blink::AgentWheelPlacePtr> out;
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view || !root->IsLocalRoot() ||
+      root->IsOutermostMainFrame()) {
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  // The carry's reading along the axis: the scrollers that hold the element,
+  // and which of them move it toward its need.
+  WheelBinder binder;
+  ReadCarry(local_dom_node_id, aim_x, aim_y, x, y, axis, &binder);
+  if (binder.chain.empty() || std::abs(binder.toward) < 0.5) {
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  const bool vertical = binder.vertical;
+  const bool forward = binder.toward > 0;
+  const auto moves_it = [&binder](const LayoutBox* latched) {
+    for (wtf_size_t i = binder.movers_from;
+         latched && i < binder.chain.size() && i <= binder.movers_to; ++i) {
+      if (binder.chain[i] == latched) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // Over what shows of the scroller that binds the need, in the window and
+  // where the page shows this frame, as ReadCarry's grid -- a pixel or two in
+  // from its edges, but not clear of the autoscroll belt: only a held drag
+  // sets that going, and a reveal is refused while one is held.
+  const wtf_size_t bound =
+      std::min<wtf_size_t>(binder.movers_to, binder.chain.size() - 1);
+  gfx::RectF area = PortOf(*binder.chain[bound]).shown;
+  area.Intersect(PortOf(*binder.chain.back()).shown);
+  area.Intersect(gfx::RectF(root->RemoteViewportIntersection()));
+  area.Inset(
+      gfx::InsetsF::VH(std::min(2.f, std::max(0.f, area.height() / 2 - 1)),
+                       std::min(2.f, std::max(0.f, area.width() / 2 - 1))));
+  if (area.IsEmpty()) {
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  constexpr float kStepDips = 16;
+  constexpr int kMaxRows = 48;
+  constexpr int kMaxColumns = 32;
+  constexpr int kPerRow = 6;
+  constexpr int kPerColumn = 4;
+  const float step = std::max(1.f, widget->DIPsToBlinkSpace(kStepDips));
+  const int rows = std::clamp(static_cast<int>(std::ceil(area.height() / step)),
+                              1, kMaxRows);
+  const int columns = std::clamp(
+      static_cast<int>(std::ceil(area.width() / step)), 1, kMaxColumns);
+  const float row_offset = static_cast<float>(base::RandDouble());
+  const float column_offset = static_cast<float>(base::RandDouble());
+  Vector<gfx::PointF> lattice;
+  for (int row = 0; row < rows; ++row) {
+    const float along = area.y() + area.height() * (row + row_offset) / rows;
+    for (int cell = 0; cell < kPerRow; ++cell) {
+      lattice.push_back(gfx::PointF(
+          area.x() + area.width() *
+                         (cell + static_cast<float>(base::RandDouble())) /
+                         kPerRow,
+          along));
+    }
+  }
+  for (int column = 0; column < columns; ++column) {
+    const float along =
+        area.x() + area.width() * (column + column_offset) / columns;
+    for (int cell = 0; cell < kPerColumn; ++cell) {
+      lattice.push_back(gfx::PointF(
+          along,
+          area.y() + area.height() *
+                         (cell + static_cast<float>(base::RandDouble())) /
+                         kPerColumn));
+    }
+  }
+  const RootDips dips(*view, *widget);
+  const gfx::PointF asked = dips.Root(x, y);
+  struct Place {
+    bool pinned;
+    float distance;
+    gfx::PointF at;
+  };
+  Vector<Place> places;
+  for (const gfx::PointF& at : lattice) {
+    bool pinned = false;
+    if (moves_it(WheelLatch(*root, at, vertical, forward, &pinned))) {
+      places.push_back(Place{pinned, (at - asked).Length(), at});
+    }
+  }
+  std::stable_sort(
+      places.begin(), places.end(), [](const Place& a, const Place& b) {
+        return a.pinned != b.pinned ? !a.pinned : a.distance < b.distance;
+      });
+  for (const Place& place : places) {
+    const gfx::PointF in_dips = dips.Dips(place.at);
+    out.push_back(mojom::blink::AgentWheelPlace::New(in_dips.x(), in_dips.y()));
+  }
+  std::move(callback).Run(std::move(out));
+}
+
+// browser: Input.performDrag's survey.
+void AgentSnapshotCollectorImpl::DragSurvey(
+    mojom::blink::AgentDragSurveyParamsPtr params,
+    DragSurveyCallback callback) {
+  auto survey = mojom::blink::AgentDragSurvey::New();
+  survey->viewport = mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0);
+  survey->device_scale_factor = 1;
+  survey->page_zoom = 1;
+  survey->frame_interval_ms = 16.67;
+  survey->grab = EmptySlot();
+  survey->grab_hit = g_empty_string;
+  survey->grab_hit_kind = g_empty_string;
+  survey->grab_verdict = g_empty_string;
+  survey->target = EmptySlot();
+  survey->slider = EmptySlider();
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  if (!widget || !view) {
+    survey->target_reading = ReadCarry(0, 0, 0, 0, 0, 0);
+    std::move(callback).Run(std::move(survey));
+    return;
+  }
+  // Laid out once; the hit tests further down bring the rest of the
+  // lifecycle up to date, as HitCheck's does.
+  view->UpdateLifecycleToLayoutClean(DocumentUpdateReason::kInspector);
+  const RootDips dips(*view, *widget);
+  survey->viewport = dips.Box(ViewportRect(*view));
+  const double scale = widget->DIPsToBlinkSpace(1.f);
+  survey->device_scale_factor = scale;
+  if (const LayoutView* layout_view = root->ContentLayoutObject();
+      layout_view && scale > 0) {
+    survey->page_zoom = layout_view->StyleRef().EffectiveZoom() / scale;
+  }
+  const float frequency = widget->GetScreenInfo().display_frequency;
+  if (frequency > 0) {
+    survey->frame_interval_ms = 1000.0 / frequency;
+  }
+  Terrain terrain;
+  CollectTerrain(*root, dips, terrain);
+  survey->bands = std::move(terrain.bands);
+  survey->fixed_boxes = std::move(terrain.fixed);
+
+  // The grabbed element, or what a press at the grab point reaches; whether
+  // a press there reaches it -- and when not, what it reaches instead or why
+  // nothing does; and Blink's own band at that point.
+  Element* grab = params->grab_node_id
+                      ? OwnedElement(root, params->grab_node_id)
+                      : ElementAt(*root, dips, params->grab_x, params->grab_y);
+  if (grab) {
+    survey->grab = SlotOf(grab, dips, nullptr);
+    String hit;
+    String hit_kind;
+    // browser: an inert grab with what switched it off.
+    const String verdict =
+        PressVerdict(root, grab, params->grab_x, params->grab_y, hit, &hit_kind,
+                     /*name_inert=*/true);
+    survey->grab_reached = verdict == "reached" || verdict == "label";
+    if (!survey->grab_reached) {
+      survey->grab_verdict = verdict;
+      // browser: for inert, the cause alone -- empty when nothing
+      // names it -- with its kind; else the hit, or the verdict itself when
+      // nothing is named.
+      const bool named = verdict == "inert" || !hit.empty();
+      survey->grab_hit = named ? hit : verdict;
+      survey->grab_hit_kind = named ? hit_kind : g_empty_string;
+    }
+  }
+  const BandProbe probe =
+      ProbeAt(*root, dips.Root(params->grab_x, params->grab_y));
+  survey->grab_band = probe.side ? probe.box : 0;
+
+  // The target, and the carry's reading of it with the survey's aim and hand.
+  if (Element* target = OwnedElement(root, params->target_node_id)) {
+    survey->target = SlotOf(target, dips, nullptr);
+  }
+  // Its wheel_found stays false: WheelStation finds the wheel's place.
+  survey->target_reading =
+      ReadCarry(params->target_node_id, params->aim_x, params->aim_y,
+                params->hand_x, params->hand_y, 0, /*binder=*/nullptr,
+                /*find_wheel=*/false, /*name_veil=*/true);
+
+  // A range input's geometry, and the point that gives the value asked for.
+  SliderParts parts;
+  auto* input = DynamicTo<HTMLInputElement>(grab);
+  if (input && input->isConnected() && ReadSliderParts(*input, parts)) {
+    const StepRange range(input->CreateStepRange(kRejectAny));
+    survey->slider = SliderOf(*input, parts, range, dips);
+    LayoutUnit along;
+    Decimal reached;
+    if (params->want_value &&
+        SliderPointFor(*input, parts, range,
+                       range.ClampValue(Decimal::FromDouble(params->value)),
+                       along, reached)) {
+      const gfx::PointF place = dips.Dips(TrackPoint(parts, along));
+      survey->value_found = true;
+      survey->value_x = place.x();
+      survey->value_y = place.y();
+      survey->value_reached = reached.ToDouble();
+    }
+  }
+  std::move(callback).Run(std::move(survey));
+}
+
+// browser: Blink's own band answer at each point.
+void AgentSnapshotCollectorImpl::ProbeBands(const Vector<double>& points,
+                                            ProbeBandsCallback callback) {
+  Vector<mojom::blink::AgentBandProbePtr> probes;
+  LocalFrame* root = GetSupplementable()->GetFrame();
+  auto* widget =
+      root ? static_cast<WebFrameWidgetImpl*>(root->GetWidgetForLocalRoot())
+           : nullptr;
+  LocalFrameView* view = root ? root->View() : nullptr;
+  const wtf_size_t count =
+      std::min<wtf_size_t>(points.size() / 2, kProbePoints);
+  for (wtf_size_t i = 0; i < count; ++i) {
+    BandProbe probe;
+    if (widget && view) {
+      const RootDips dips(*view, *widget);
+      probe = ProbeAt(*root, dips.Root(points[2 * i], points[2 * i + 1]));
+    }
+    probes.push_back(mojom::blink::AgentBandProbe::New(probe.box, probe.side));
+  }
+  std::move(callback).Run(std::move(probes));
+}
