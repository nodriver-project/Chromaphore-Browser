+// How much of a region's text is hashed, and how much is shown.
+constexpr size_t kHashChars = 20000;
+constexpr size_t kShownChars = 300;
+// browser: a shown text cut is cut at a word within this
+// many characters of the cut.
+constexpr size_t kCutSlack = 24;
+// browser: a log's text kept at each end; the anchor looked for; the
+// least overlap an anchor cut into counts by.
+constexpr size_t kEndChars = 8000;
+constexpr wtf_size_t kAnchorChars = 4000;
+constexpr wtf_size_t kMinOverlap = 32;
+// Bounds one region's text walk; a log of thousands of lines stays well
+// inside it.
+constexpr int kTextNodeBudget = 20000;
+// Bounds the look for a display: contents root's rendered child.
+constexpr int kChildBudget = 64;
+
+constexpr uint64_t kFnvBasis = 0xcbf29ce484222325ULL;
+constexpr uint64_t kFnvPrime = 0x100000001b3ULL;
+
+enum class RegionRole : uint8_t { kNone, kAlert, kStatus, kLog };
+
+// The first token of the role attribute, as a live region's role.
+RegionRole RoleOf(const Element& element) {
+  const AtomicString& role = element.FastGetAttribute(html_names::kRoleAttr);
+  if (role.empty()) {
+    return RegionRole::kNone;
+  }
+  wtf_size_t start = 0;
+  while (start < role.length() && IsAsciiSpace(role[start])) {
+    ++start;
+  }
+  wtf_size_t end = start;
+  while (end < role.length() && !IsAsciiSpace(role[end])) {
+    ++end;
+  }
+  const StringView first(role, start, end - start);
+  if (EqualIgnoringAsciiCase(first, StringView("alert"))) {
+    return RegionRole::kAlert;
+  }
+  if (EqualIgnoringAsciiCase(first, StringView("status"))) {
+    return RegionRole::kStatus;
+  }
+  if (EqualIgnoringAsciiCase(first, StringView("log"))) {
+    return RegionRole::kLog;
+  }
+  return RegionRole::kNone;
+}
+
+bool IsAriaHidden(const Element& element) {
+  return EqualIgnoringAsciiCase(
+      element.FastGetAttribute(html_names::kAriaHiddenAttr), "true");
+}
+
+// Text a person types: a text field or a textarea (every <input>, whose
+// shown text is its value or its button label in a user-agent tree the walks
+// never enter), or a contenteditable host by its attribute.
+bool IsField(const Element& element) {
+  if (IsA<TextControlElement>(element)) {
+    return true;
+  }
+  if (element.IsFormControlElement() ||
+      !element.FastHasAttribute(html_names::kContenteditableAttr)) {
+    return false;
+  }
+  return !EqualIgnoringAsciiCase(
+      element.FastGetAttribute(html_names::kContenteditableAttr), "false");
+}
+
+// Whitespace of any kind, Unicode's included (as the collector's IsAnySpace).
+bool IsAnySpace(UChar c) {
+  return IsAsciiSpace(c) || c == 0x0085 || c == 0x00A0 || c == 0x1680 ||
+         (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 ||
+         c == 0x202F || c == 0x205F || c == 0x3000;
+}
+
+// What no one reads: an icon font's private-use glyph, a zero-width space, a
+// byte-order mark (as the collector's CleanName).
+bool IsDropped(UChar c) {
+  return (c >= 0xE000 && c <= 0xF8FF) || c == 0x200B || c == 0xFEFF;
+}
+
+// The node's parent in the flat tree as the last slot assignment left it
+// (never recalculated, which a FlatTreeTraversal may do): a shadow tree's top
+// is its host's, and a host's light child is its slot's (null when it has
+// none: it is not shown).
+const ContainerNode* FlatParent(const Node& node) {
+  ContainerNode* parent = node.parentNode();
+  if (!parent) {
+    return nullptr;
+  }
+  if (auto* shadow = DynamicTo<ShadowRoot>(parent)) {
+    return &shadow->host();
+  }
+  if (const auto* host = DynamicTo<Element>(parent);
+      host && host->GetShadowRoot()) {
+    return node.AssignedSlotWithoutRecalc();
+  }
+  return parent;
+}
+
+// Whether `root` or a flat-tree ancestor is a field (IsField), or its
+// document is in design mode (an editor frame of the older kind).
+bool InField(const Element& root) {
+  if (root.GetDocument().InDesignMode()) {
+    return true;
+  }
+  for (const Node* node = &root; node; node = FlatParent(*node)) {
+    if (const auto* element = DynamicTo<Element>(node);
+        element && IsField(*element)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+Node* NextInWalk(const Node& node, const Node* root, bool skip_children) {
+  if (!skip_children) {
+    if (const auto* element = DynamicTo<Element>(node)) {
+      const ShadowRoot* shadow = element->GetShadowRoot();
+      if (shadow &&
+          !(shadow->IsUserAgent() && element->IsFormControlElement())) {
+        if (Node* first = shadow->firstChild()) {
+          return first;
+        }
+      }
+    }
+    if (const auto* container = DynamicTo<ContainerNode>(node)) {
+      if (Node* first = container->firstChild()) {
+        return first;
+      }
+    }
+  }
+  const Node* current = &node;
+  while (current && current != root) {
+    if (Node* next = current->nextSibling()) {
+      return next;
+    }
+    const ContainerNode* parent = current->parentNode();
+    if (!parent || parent->IsDocumentNode()) {
+      return nullptr;
+    }
+    if (const auto* shadow = DynamicTo<ShadowRoot>(parent)) {
+      // The host's shadow tree is done: its light children come next.
+      const Element& host = shadow->host();
+      if (Node* light = host.firstChild()) {
+        return light;
+      }
+      current = &host;
+      continue;
+    }
+    current = parent;
+  }
+  return nullptr;
+}
+
+namespace {
+
+// Whether a display: contents element shows something: a child of its own or
+// of its shadow tree with a LayoutObject.
+bool HasRenderedChild(const Element& element) {
+  int budget = kChildBudget;
+  const auto any_rendered = [&budget](const ContainerNode& parent) {
+    for (const Node* child = parent.firstChild(); child && budget-- > 0;
+         child = child->nextSibling()) {
+      if (child->GetLayoutObject()) {
+        return true;
+      }
+    }
+    return false;
+  };
+  if (const ShadowRoot* shadow = element.GetShadowRoot();
+      shadow && any_rendered(*shadow)) {
+    return true;
+  }
+  return any_rendered(element);
+}
+
+// Calls `emit(c)` for each character of `root`'s text as ReadRegionText reads
+// it, until `emit` returns false or the node budget runs out. Allocates
+// nothing.
+template <typename Emit>
+void WalkText(const Element& root, Emit&& emit) {
+  // The block the last text was in: text in another block, or past a <br>,
+  // is a word apart.
+  const LayoutObject* last_block = nullptr;
+  bool space = false;
+  bool any = false;
+  int budget = kTextNodeBudget;
+  // browser: a box laid out bottom up -- a chat in a
+  // column-reverse flexbox, newest first in the document -- is read in the
+  // order it shows: its last child first, each child's own subtree in tree
+  // order. A log's newest is then its end, as in any other log.
+  // Its items its child elements only: text loose in it would be read out of
+  // its run.
+  const LayoutObject* root_layout = root.GetLayoutObject();
+  bool bottom_up = root_layout && !root.GetShadowRoot() && root.lastChild() &&
+                   root_layout->IsFlexibleBox() &&
+                   root_layout->StyleRef().ResolvedIsColumnFlexDirection() &&
+                   root_layout->StyleRef().ResolvedIsReverseFlexDirection();
+  for (const Node* child = bottom_up ? root.firstChild() : nullptr; child;
+       child = child->nextSibling()) {
+    const auto* loose = DynamicTo<Text>(child);
+    if (loose && !loose->ContainsOnlyWhitespaceOrEmpty()) {
+      bottom_up = false;
+      break;
+    }
+  }
+  // The child being read (bottom up only), and the subtree the walk keeps to.
+  const Node* part = bottom_up ? root.lastChild() : nullptr;
+  const Node* within = bottom_up ? part : &root;
+  for (const Node* node = bottom_up ? part : NextInWalk(root, &root, false);
+       node && budget-- > 0;) {
+    bool skip = false;
+    if (const auto* element = DynamicTo<Element>(node)) {
+      if (IsRegionRoot(*element) || IsAriaHidden(*element) ||
+          IsField(*element)) {
+        skip = true;
+      } else if (const LayoutObject* layout = element->GetLayoutObject()) {
+        const DisplayLockContext* lock = element->GetDisplayLockContext();
+        skip = lock && lock->IsLocked();
+        space = space || layout->IsBR();
+      } else {
+        skip = !element->HasDisplayContentsStyle();
+      }
+    } else if (const auto* text = DynamicTo<Text>(node)) {
+      // Shown text only: a toast faded out to visibility: hidden keeps its
+      // box but says nothing. The walk goes on below a hidden element, whose
+      // descendants may be visible again.
+      if (const LayoutObject* layout = text->GetLayoutObject();
+          layout && layout->StyleRef().Visibility() == EVisibility::kVisible) {
+        const LayoutObject* block = layout->ContainingBlock();
+        if (block != last_block) {
+          space = true;
+          last_block = block;
+        }
+        const String& data = text->data();
+        for (wtf_size_t i = 0; i < data.length(); ++i) {
+          const UChar c = data[i];
+          if (IsAnySpace(c)) {
+            space = true;
+            continue;
+          }
+          if (IsDropped(c)) {
+            continue;
+          }
+          if (space && any && !emit(static_cast<UChar>(' '))) {
+            return;
+          }
+          space = false;
+          any = true;
+          if (!emit(c)) {
+            return;
+          }
+        }
+      }
+    }
+    node = NextInWalk(*node, within, skip);
+    // Bottom up: that child is read; the one shown above it is next.
+    if (!node && part && (part = part->previousSibling())) {
+      node = within = part;
+    }
+  }
+}
+
+}  // namespace
+
+bool IsRegionRoot(const Element& element) {
+  const AtomicString& live =
+      element.FastGetAttribute(html_names::kAriaLiveAttr);
+  if (!live.IsNull()) {
+    if (EqualIgnoringAsciiCase(live, "polite") ||
+        EqualIgnoringAsciiCase(live, "assertive")) {
+      return true;
+    }
+    if (EqualIgnoringAsciiCase(live, "off")) {
+      return false;
+    }
+  }
+  return RoleOf(element) != RegionRole::kNone ||
+         element.HasTagName(html_names::kOutputTag);
+}
+
+void DescribeRegion(const Element& root, String& kind, bool& assertive) {
+  const AtomicString& live = root.FastGetAttribute(html_names::kAriaLiveAttr);
+  const RegionRole role = RoleOf(root);
+  switch (role) {
+    case RegionRole::kAlert:
+      kind = "alert";
+      break;
+    case RegionRole::kStatus:
+      kind = "status";
+      break;
+    case RegionRole::kLog:
+      kind = "log";
+      break;
+    case RegionRole::kNone:
+      kind = root.HasTagName(html_names::kOutputTag) ? "output" : "live";
+      break;
+  }
+  // An alert is assertive by its role; aria-live, when it says, wins.
+  assertive =
+      EqualIgnoringAsciiCase(live, "assertive") ||
+      (role == RegionRole::kAlert && !EqualIgnoringAsciiCase(live, "polite"));
+}
+
+bool RegionCounts(const Element& root) {
+  if (EqualIgnoringAsciiCase(root.FastGetAttribute(html_names::kAriaBusyAttr),
+                             "true")) {
+    return false;
+  }
+  for (const Node* node = &root; node; node = FlatParent(*node)) {
+    if (const auto* element = DynamicTo<Element>(node);
+        element && IsAriaHidden(*element)) {
+      return false;
+    }
+  }
+  const ComputedStyle* style = nullptr;
+  if (const LayoutObject* layout = root.GetLayoutObject()) {
+    style = &layout->StyleRef();
+  } else if (root.HasDisplayContentsStyle() && HasRenderedChild(root)) {
+    style = root.GetComputedStyle();
+  }
+  return style && style->Visibility() == EVisibility::kVisible;
+}
+
+void ReadRegionText(const Element& root,
+                    bool is_log,
+                    uint64_t& hash,
+                    String* shown,
+                    bool hash_all) {
+  uint64_t fnv = kFnvBasis;
+  size_t hashed = 0;
+  // Every character met; the kept ones are the first 300, or, for a log, the
+  // last 300 as a ring (the next one goes at total % 300).
+  size_t total = 0;
+  const bool keep_last = shown && is_log;
+  std::array<UChar, kShownChars> kept{};
+  if (!InField(root)) {
+    WalkText(root, [&](UChar c) {
+      if (hashed < kHashChars) {
+        fnv = (fnv ^ c) * kFnvPrime;
+        ++hashed;
+      }
+      if (keep_last) {
+        kept[total % kShownChars] = c;
+      } else if (shown && total < kShownChars) {
+        kept[total] = c;
+      }
+      ++total;
+      // A log's last characters are read past the hash's; nothing else is.
+      // Without the whole hash, one past the kept ones, so a cut there is
+      // still seen and never splits a surrogate pair.
+      return (hash_all ? hashed < kHashChars : total <= kShownChars) ||
+             keep_last;
+    });
+  }
+  hash = hashed == 0 ? 0 : (fnv == 0 ? 1 : fnv);
+  if (!shown) {
+    return;
+  }
+  const size_t count = std::min(total, kShownChars);
+  const size_t origin =
+      keep_last && total > kShownChars ? total % kShownChars : 0;
+  const auto at = [&](size_t j) { return kept[(origin + j) % kShownChars]; };
+  size_t from = 0;
+  size_t to = count;
+  // Never half a surrogate pair where the text was cut.
+  if (total > kShownChars && from < to) {
+    if (keep_last && (at(from) & 0xFC00) == 0xDC00) {
+      ++from;
+    } else if (!keep_last && (at(to - 1) & 0xFC00) == 0xD800) {
+      --to;
+    }
+  }
+  // browser: cut at a word, and marked where it was cut.
+  const bool cut = total > kShownChars && from < to;
+  if (cut && keep_last) {
+    for (size_t j = from; j < to && j < from + kCutSlack; ++j) {
+      if (at(j) == ' ') {
+        from = j + 1;
+        break;
+      }
+    }
+  } else if (cut) {
+    for (size_t j = to; j > from && j + kCutSlack > to; --j) {
+      if (at(j - 1) == ' ') {
+        to = j - 1;
+        break;
+      }
+    }
+  }
+  StringBuilder text;
+  text.ReserveCapacity(static_cast<wtf_size_t>(to - from + 1));
+  if (cut && keep_last) {
+    text.Append(static_cast<UChar>(0x2026));
+  }
+  for (size_t j = from; j < to; ++j) {
+    text.Append(at(j));
+  }
+  if (cut && !keep_last) {
+    text.Append(static_cast<UChar>(0x2026));
+  }
+  *shown = text.ToString();
+}
+
+bool IsLogRoot(const Element& root) {
+  return RoleOf(root) == RegionRole::kLog;
+}
+
+RegionEnds ReadRegionEnds(const Element& root) {
+  RegionEnds ends;
+  if (InField(root)) {
+    return ends;
+  }
+  StringBuilder head;
+  Vector<UChar> ring(static_cast<wtf_size_t>(kEndChars));
+  size_t total = 0;
+  WalkText(root, [&](UChar c) {
+    if (total < 2 * kEndChars) {
+      head.Append(c);
+    }
+    ring[static_cast<wtf_size_t>(total % kEndChars)] = c;
+    ++total;
+    return true;
+  });
+  ends.length = total;
+  if (total <= 2 * kEndChars) {
+    ends.head = head.ToString();
+    return ends;
+  }
+  ends.head = head.ToString().substr(0, static_cast<wtf_size_t>(kEndChars));
+  StringBuilder tail;
+  tail.ReserveCapacity(static_cast<wtf_size_t>(kEndChars));
+  for (size_t j = 0; j < kEndChars; ++j) {
+    tail.Append(ring[static_cast<wtf_size_t>((total + j) % kEndChars)]);
+  }
+  ends.tail = tail.ToString();
+  return ends;
+}
+
+namespace {
+
+// browser: KMP's failure function of `pattern`.
+Vector<wtf_size_t> Failure(const String& pattern) {
+  Vector<wtf_size_t> failure(pattern.length());
+  wtf_size_t k = 0;
+  for (wtf_size_t i = 1; i < pattern.length(); ++i) {
+    while (k > 0 && pattern[i] != pattern[k]) {
+      k = failure[k - 1];
+    }
+    if (pattern[i] == pattern[k]) {
+      ++k;
+    }
+    failure[i] = k;
+  }
+  return failure;
+}
+
+// browser: `pattern` (not empty) run over `text`: where its first and
+// its last whole match end (kNotFound: none), and how much of it the end of
+// `text` matches.
+struct Matched {
+  wtf_size_t first_end = kNotFound;
+  wtf_size_t last_end = kNotFound;
+  wtf_size_t at_end = 0;
+};
+
+Matched Match(const String& pattern, const String& text) {
+  const Vector<wtf_size_t> failure = Failure(pattern);
+  Matched matched;
+  wtf_size_t k = 0;
+  for (wtf_size_t i = 0; i < text.length(); ++i) {
+    if (k == pattern.length()) {
+      k = failure[k - 1];
+    }
+    while (k > 0 && text[i] != pattern[k]) {
+      k = failure[k - 1];
+    }
+    if (text[i] == pattern[k]) {
+      ++k;
+    }
+    if (k == pattern.length()) {
+      if (matched.first_end == kNotFound) {
+        matched.first_end = i + 1;
+      }
+      matched.last_end = i + 1;
+    }
+  }
+  matched.at_end = k;
+  return matched;
+}
+
+// browser: `added` kept from its start, as read (its edge space too,
+// so streamed pieces join as they stood); null when it holds no text.
+String Kept(const String& added) {
+  return added.StripWhiteSpace().empty() ? String()
+                                         : added.substr(0, kAddedChars);
+}
+
+}  // namespace
+
+// A log of one line said over and over (a poll's "Waiting...") past the
+// anchor's length matches early: some of its old lines read as added.
+String AddedText(const RegionEnds& was,
+                 const RegionEnds& now,
+                 bool* prepended) {
+  *prepended = false;
+  if (now.length == 0) {
+    return String();
+  }
+  const bool whole = now.tail.IsNull();
+  if (was.length == 0) {
+    return Kept(now.head);
+  }
+  const bool was_whole = was.tail.IsNull();
+  // An old text this short is the new one's start or end, or nothing; its
+  // start first (a newest-first entry that begins with it reads appended).
+  if (was_whole && was.head.length() < kMinOverlap) {
+    if (whole && now.head.starts_with(was.head)) {
+      return Kept(now.head.substr(was.head.length()));
+    }
+    if (whole && now.head.ends_with(was.head)) {
+      *prepended = true;
+      return Kept(now.head.substr(0, now.head.length() - was.head.length()));
+    }
+    return String();
+  }
+  // Appended: where its last characters stand first in the new text's last.
+  const String& last = was.Last();
+  const String anchor =
+      last.substr(last.length() - std::min(last.length(), kAnchorChars));
+  const Matched appended = Match(anchor, now.Last());
+  String added;
+  if (appended.first_end != kNotFound) {
+    added = Kept(now.Last().substr(appended.first_end));
+  } else if (whole) {
+    // Its oldest lines dropped into the anchor itself: the longest end of it
+    // the new text begins with.
+    const wtf_size_t k = Match(now.head, anchor).at_end;
+    if (k >= kMinOverlap) {
+      added = Kept(now.head.substr(k));
+    }
+  }
+  if (!added.IsNull()) {
+    return added;
+  }
+  // Prepended: where its first characters stand last in the new text's first.
+  const String start = was.head.substr(0, kAnchorChars);
+  const Matched before = Match(start, now.head);
+  if (before.last_end != kNotFound) {
+    added = Kept(now.head.substr(0, before.last_end - start.length()));
+  } else if (whole && before.at_end >= kMinOverlap) {
+    // Its newest lines dropped into the anchor: the longest start of it the
+    // new text ends with.
+    added = Kept(now.head.substr(0, now.head.length() - before.at_end));
+  }
+  if (!added.IsNull()) {
+    *prepended = true;
+  }
+  return added;
+}
+
+String ShownStart(const String& text) {
+  if (text.length() <= kShownChars) {
+    return text;
+  }
+  wtf_size_t to = static_cast<wtf_size_t>(kShownChars);
+  // Never half a surrogate pair where the text was cut.
+  if ((text[to - 1] & 0xFC00) == 0xD800) {
+    --to;
+  }
+  for (wtf_size_t j = to; j > 0 && j + kCutSlack > to; --j) {
+    if (text[j - 1] == ' ') {
+      to = j - 1;
+      break;
+    }
+  }
+  StringBuilder shown;
+  shown.Append(StringView(text, 0, to));
+  shown.Append(static_cast<UChar>(0x2026));
+  return shown.ToString();
+}
+
+void ForEachRegionRoot(Document& document,
+                       int& budget,
+                       base::FunctionRef<void(Element&)> visit) {
+  for (Node* node = document.documentElement(); node && budget > 0;) {
+    --budget;
+    bool skip = false;
+    if (auto* element = DynamicTo<Element>(node)) {
+      if (!element->GetLayoutObject()) {
+        skip = !element->HasDisplayContentsStyle();
+      } else {
+        const DisplayLockContext* lock = element->GetDisplayLockContext();
+        skip = lock && lock->IsLocked();
+      }
+      if (!skip && IsRegionRoot(*element)) {
+        visit(*element);
+      }
+    }
+    node = NextInWalk(*node, nullptr, skip);
+  }
+}
+
+}  // namespace agent_live_regions
+
+}  // namespace blink
