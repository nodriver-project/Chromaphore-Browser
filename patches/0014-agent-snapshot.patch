+// found in the LICENSE file.
+
+// Per-frame interactive-element collection for Page.captureAgentSnapshot.
+//
+// Implemented in the renderer and bound per local root frame. The browser
+// calls it once per local root (main frame and every OOPIF) while assembling
+// one snapshot. Each frame reports its elements in its own local CSS-pixel
+// space, as getBoundingClientRect() would; the browser composes those boxes
+// into the root viewport and runs the cross-context occlusion test.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/time.mojom";
+
+// How elements outside the frame's own layout viewport are reported.
+enum AgentOffscreenMode {
+  kNone,     // drop off-viewport elements
+  kSummary,  // include, but the caller may cap the count
+  kFull,     // include all
+};
+
+// browser: whether a capture reports the layers open on the page.
+enum AgentLayerScope {
+  kOff,     // as before
+  kOn,      // report the layers, and leave out what a click cannot reach
+  kAll,     // report the layers, everything listed
+};
+
+struct AgentSnapshotOptions {
+  AgentOffscreenMode offscreen_mode = kSummary;
+  AgentLayerScope layer_scope = kOff;
+  // browser: the layers only, no listing (agentNodesAlive's layers).
+  bool layers_only = false;
+  // browser: the DOMNodeIds the browser has ids for under this local
+  // root; each one not returned comes back in AgentFrameSnapshot.unlisted.
+  array<int32> known_node_ids;
+};
+
+// browser: a layer found on a local root's own document.
+struct AgentLayer {
+  // dialog | alert | menu | listbox | popover | fullscreen | picker | panel
+  string kind;
+  // Its author's name, else its first heading, else its first text (60
+  // characters).
+  string name;
+  // top-layer | probe | veil | inert | aria
+  string how;
+  // Whether it shuts off the page behind it: a modal dialog, the fullscreen
+  // element, or an overlay met at most probe points over page content.
+  bool blocking;
+  // Of 13 probe points: where it was met, and where page content lay beneath
+  // it (0 when not probed).
+  int32 points_hit;
+  int32 points_covering;
+  // Hint flags: 1 aria-modal, 2 a dialog/menu/listbox role, 4 focus inside,
+  // 8 scroll locked, 16 the page's other parts inert or aria-hidden, 32 its
+  // veil takes clicks, 64 those parts inert (not only aria-hidden), 128 the
+  // parts beside the layer's own boxes inert, below <body>'s level (set
+  // only when 64 is not).
+  uint32 hints;
+  // Its root element's DOMNodeId.
+  int32 root_node_id;
+  // browser: its veil's DOMNodeId -- the backdrop beside it, met where
+  // the page lies under it -- 0 when it has none.
+  int32 veil_node_id = 0;
+  // DevTools tokens of the frames whose element is inside it.
+  array<string> frame_ids;
+  // browser: its text, ~600 characters, never a field's value. Its kind
+  // (above) is one of dialog, alert, menu, listbox, popover, fullscreen,
+  // picker, panel.
+  string head;
+  // browser: blocking, and the page behind it shut off -- its scroll
+  // locked, its other parts inert, or a page-sized veil -- so what is
+  // off-screen behind it is out of reach too.
+  bool shuts_page = false;
+  // browser: the longest time left, in ms, of a finite animation or
+  // transition running on it, on what holds it, on its veil or on a large
+  // part of it -- it may be opening or closing; 0 when none.
+  int32 animating_ms = 0;
+};
+
+// Border-box in the frame's LOCAL CSS-pixel space, viewport-relative
+// (i.e. matching Element.getBoundingClientRect()).
+struct AgentElementBox {
+  double x;
+  double y;
+  double width;
+  double height;
+};
+
+// browser: Input.moveTo's aim, in this local root's widget DIPs. `box` is the
+// element's bounding box; `piece` the largest of its client rects as much of
+// it shows (clipped by every box around it and by the viewport), cut to the
+// largest part of it a press reaches the element at when something lies over
+// the rest; `in_view` when that piece is at least 1 x 1. `holes`: the parts of
+// the piece a press would act on instead of the element -- its own links,
+// buttons and other controls, a link inside a card -- each cut to the piece:
+// the first 8 rects as they are, the rest as one more (their union).
+struct AgentAimPiece {
+  bool found;
+  AgentElementBox box;
+  AgentElementBox piece;
+  bool in_view;
+  array<AgentElementBox> holes;
+  // A frame element: the DevTools token of the frame it holds, whose own
+  // content takes a press on it; null otherwise.
+  string? child_frame_id;
+  // browser: the hover region the hand is in on its way to the node, when it
+  // depends on hover: what shows of the border boxes from the element
+  // under the hand, and from the node, up to their nearest common ancestor,
+  // and of it -- a pointer over them has not left the ancestor. Empty when
+  // there is none, or no hand was given.
+  array<AgentElementBox> hover_boxes;
+};
+
+// browser: a scroller that holds a carried element and a user can scroll, as
+// a held drag's autoscroll sees it: a point in `outer` (its border box) but
+// not in `inner` (20 px in from its edges, less its scrollbars) is in its band,
+// on any side, and Blink scrolls it once the pointer has stayed in the band
+// 200 ms. up/down/left/right: whether it can still scroll that way. In the
+// local root's widget, in DIPs.
+struct AgentScrollBelt {
+  AgentElementBox outer;
+  AgentElementBox inner;
+  bool up;
+  bool down;
+  bool left;
+  bool right;
+};
+
+// browser: a place in a local root's widget, in DIPs.
+struct AgentWheelPlace {
+  double x;
+  double y;
+};
+
+// browser: a drag carry's view of the element it takes a drag to. Points and
+// lengths are in the local root's widget, in DIPs.
+struct AgentCarryReading {
+  // The element is still there and laid out.
+  bool found;
+  // The point on it the drag is taken to, and its box.
+  double aim_x;
+  double aim_y;
+  AgentElementBox box;
+  // How far that point still has to move to sit clear of every scroller's
+  // autoscroll belt and of the window's -- or merely in view, for a scroller
+  // that cannot move it further. Positive when the content has to move up or
+  // left, as turning the wheel down or right moves it.
+  double need_x;
+  double need_y;
+  // How long the calm stretch it is to land in is, along each axis; and how
+  // long it will be once every box has moved off the end it may be at now.
+  double calm_x;
+  double calm_y;
+  double firm_x;
+  double firm_y;
+  // Where the aimed point comes to rest once everything has scrolled as
+  // needed, a box wholly out of view brought in first.
+  double rest_x;
+  double rest_y;
+  // Where on the element a hand can land as things are now: the point nearest
+  // the aim in the calm stretch (land_calm), else in what shows.
+  double land_x;
+  double land_y;
+  bool land_calm;
+  // Whether the element shows where it is now -- 24 px of it each way, or all
+  // of it -- with land_x/land_y on that part.
+  bool land_shown;
+  // What lies over every place along the axis the element could be brought to
+  // rest, or empty: a fixed or sticky bar over the box, or anything outside it.
+  string covering;
+  // Whether the wheel turned at the asked point, toward the need along the
+  // axis asked about, would scroll something that holds the element and may
+  // move it there.
+  bool wheel_ok;
+  // When it would not: the nearest place where it would, over what is to
+  // scroll and in the window, if there is one.
+  bool wheel_found;
+  double wheel_x;
+  double wheel_y;
+  // Scroll offsets now, in CSS px: the window's, and those of the nearest
+  // scrolling box that holds the element (zero without one), named in
+  // box_name.
+  double window_x;
+  double window_y;
+  double box_x;
+  double box_y;
+  string box_name;
+  // The scrollers that hold the element, innermost first, each window
+  // included: the bands a hand crosses quickly.
+  array<AgentScrollBelt> belts;
+  // A frame element: the DevTools token of the frame it holds, whose own
+  // content a look at it may meet; null otherwise.
+  string? child_frame_id;
+};
+
+// browser: Input.scrollBy's view of the scroller a wheel turned at a point
+// moves, along one axis. Lengths in CSS px; points in the local root's
+// widget, in DIPs.
+struct AgentWheelScroller {
+  // Something at the point, or the scroller asked for is still there.
+  bool found;
+  // Its DOMNodeId (the document's for a window), to read it again by: with
+  // the local root's frame, the key it goes by in a listing.
+  int32 scroller_id;
+  bool is_window;
+  // The main frame's own window.
+  bool is_top_window;
+  // Room that way: the wheel there moves it. This, not max - position, says
+  // a scroller is at its end.
+  bool can_move;
+  // Along the axis: from its visual start (a reversed box counts from where
+  // it begins on screen); as scrollTop or scrollLeft gives it (distances are
+  // taken from this); as far as a user can scroll it -- 0 when overflow is
+  // hidden or clip that way, wherever script left it; and how long its port
+  // is.
+  double position;
+  double raw;
+  double max;
+  double length;
+  // Named as covers are (tag#id or tag.class, then its text when short);
+  // empty for the main frame's window; a frame's window by its frame
+  // element, and empty for a frame of another process, which the browser
+  // names. Filled on reads that bring layout up to date (the first, a latch
+  // check, the settled read); empty on a progress read.
+  string name;
+  // This local root's window along the axis, from its visual start.
+  double window_position;
+  // With a scroller asked for and check_latch: whether the wheel at the
+  // point still latches it; when not, the nearest place over it, in view,
+  // where it would. Also false once the scroller is at its end that way (the
+  // wheel then goes past it): the browser tells the end by can_move. True
+  // when not checked.
+  bool latched;
+  bool place_found;
+  double place_x;
+  double place_y;
+  // The point is over a frame of another process: its DevTools token.
+  string? remote_frame;
+  // With nothing asked for, when nothing at the point can move that way and
+  // the window cannot be scrolled that way at all: the box with the most
+  // room that way, its middle in view.
+  bool alt_found;
+  double alt_x;
+  double alt_y;
+  string alt_name;
+};
+
+// browser: a local root's main scroller, the box a scroll of the page
+// means: of the boxes and windows a user can scroll, with room to,
+// in this local root and its same-process frames, each showing 20 x 20 CSS px
+// or more and open to a hit test, a window only when its document scrolls
+// 16 px or 2 % of how tall it shows or more -- and, with layers asked and a
+// blocking layer open, held by the top one -- the local root's own window
+// when it counts, else the one that shows the most of itself.
+struct AgentScrollerCandidate {
+  // Its DOMNodeId (a window's: its document's): with the local root's frame,
+  // the key it goes by in a listing.
+  int32 node_id;
+  bool is_window;
+  // A window: its frame's DevTools token, by which the browser finds the
+  // frame element listed for it; null for a box.
+  string? frame_id;
+  // The local root's own window, its document scrolling as far as the rule
+  // above asks. When this local root is the main frame's, that is the page's
+  // own window, and it then wins over every other local root's scroller.
+  bool document_scrolls;
+  // Along each axis, in CSS px of the scroller (over its zoom), as
+  // Input.scrollBy reads them (GetWheelFigures): where it is, its offset less
+  // its minimum, so counted from its visual top-left and growing down and
+  // right (a reversed pane at its visual bottom reads max); as far as a user
+  // can scroll it; and how long it shows.
+  double position_x;
+  double position_y;
+  double max_x;
+  double max_y;
+  double length_x;
+  double length_y;
+  // What shows of it, in the local root's widget, in DIPs.
+  AgentElementBox visible;
+  // Named as covers are (tag#id or tag.class, then its text when short);
+  // empty for the main frame's window and for the window of a frame in
+  // another process.
+  string name;
+  // Its role attribute's first token, lower-cased, else its tag; empty for a
+  // window.
+  string role;
+  // A wheel turned at the middle of what shows would scroll it: false under a
+  // veil, a fixed bar or a scroller inside it. This process's hit test: what
+  // another process lays over it is not seen.
+  bool wheel_reaches;
+  // With layers: the innermost entry of `layers` holding it; -1: none.
+  int32 layer = -1;
+  // browser: with layers and no wheel reaching it, the topmost entry
+  // of `layers` over its middle above `layer` -- by the hit there, or that
+  // entry's veil; -1: none.
+  int32 under_layer = -1;
+};
+
+// browser: why the page or an element's own constraints call it
+// invalid, and the page's words for it. A constraint counts once the user
+// edited the control or tried to submit its form, or while it holds a value;
+// aria-invalid always.
+struct AgentValidity {
+  // Bits of `reasons`. kAria: aria-invalid set to anything but empty, false,
+  // undefined, spelling or grammar.
+  const uint32 kAria = 1;
+  const uint32 kValueMissing = 2;
+  const uint32 kTypeMismatch = 4;
+  const uint32 kPatternMismatch = 8;
+  const uint32 kTooLong = 16;
+  const uint32 kTooShort = 32;
+  const uint32 kRangeUnderflow = 64;
+  const uint32 kRangeOverflow = 128;
+  const uint32 kStepMismatch = 256;
+  const uint32 kBadInput = 512;
+  const uint32 kCustomError = 1024;
+  const uint32 kMessageShown = 2048;  // the browser's own bubble shows for it
+  uint32 reasons;  // never 0
+  // The shown text of its aria-errormessage targets, else its custom validity
+  // message; 160 characters. Null for none, and always for a password, card
+  // number or security code field.
+  string? error;
+};
+
+struct AgentElement {
+  // DevTools backend node id (== Blink DOMNodeId), stable and browser-visible.
+  int32 backend_node_id;
+
+  // Computed accessibility role, or a tag-derived role when no ARIA role.
+  string role;
+  // Accessible name, current value and accessible description; empty when
+  // absent.
+  string name;
+  string value;
+  string description;
+  // Lowercased tag name (e.g. "div", "button", "input").
+  string tag;
+
+  // Whether the element is classified interactive/actionable.
+  bool interactive;
+  // Why: "role" | "form-control" | "listener" | "cursor" | "tabindex"
+  // (empty when not interactive).
+  string interactive_reason;
+
+  // Active state flags: visible, enabled, focusable, focused, editable,
+  // checked, expanded, selected, disabled, readonly, required, secret;
+  // invalid with `validity`.
+  array<string> states;
+
+  // Local (frame) CSS-pixel border-box.
+  AgentElementBox box;
+  // Whether the box intersects this frame's own layout viewport.
+  bool in_frame_viewport;
+
+  // Backend node id of the shadow host when this element lives inside a
+  // shadow tree (open or closed), else 0.
+  int32 shadow_host_backend_node_id;
+
+  // Where this element points, resolved against the document base URL. An
+  // agent cannot learn a link's destination from its accessible name, and
+  // clicking to find out follows redirects and destroys the page state it
+  // was inspecting. Empty when the element has no such attribute.
+  // href: <a>, <area>, <link>. src: <img>, <iframe>, <video>, <audio>,
+  // <source>, <embed>, <script>.
+  string href;
+  string src;
+
+  // browser: for a frame element, the DevTools token of the frame it holds,
+  // so a hit in that frame's own view reaches it; null otherwise.
+  string? child_frame_id;
+
+  // browser: for an interactive element in its frame's view, what a press
+  // lands on wherever it is aimed at the part the page shows, when every
+  // part of it is covered in this process -- its own document's content, or
+  // the page's over a frame in this process; null when some part
+  // is reachable, or when it was not told. A cover in another process is the
+  // browser's cross-context test.
+  string? under;
+
+  // browser, scope on or all: the innermost entry of `layers` holding
+  // it; -1 when none does.
+  int32 layer = -1;
+  // browser, scope on or all: with `under`, the innermost entry of
+  // `layers` holding what lies over it -- the cover, or that entry's veil --
+  // its own entry included; -1 when none does.
+  int32 under_layer = -1;
+  // browser: shut out by an open modal dialog or an element shown
+  // full screen, and put behind it by the collector: its name and
+  // description are read from the DOM (the accessibility tree ignores it),
+  // and being inert takes "focusable" from its states, so these are not
+  // compared across the shutting out; its other states are.
+  bool shut_out = false;
+  // browser, scope on: a click cannot reach it -- covered where a press
+  // would land with no reveal that helps, text behind such a cover, or
+  // off-screen behind a layer that shuts the page off -- so the listing
+  // leaves it out. Behind the entry `hidden_layer` of `layers` (-1: none),
+  // and `hidden_behind` says it: that entry's name, or the cover as `under`
+  // says it.
+  bool hidden = false;
+  int32 hidden_layer = -1;
+  string? hidden_behind;
+  // browser: every reach test that could decide `hidden` or `under`
+  // ran within its budget (UnderCover, the box-middle test, the hidden-text
+  // test); true when none applies.
+  bool reach_told = true;
+  // browser: why it is invalid; null when nothing calls it so.
+  AgentValidity? validity;
+  // browser: what the element reads as agentNodesAlive reads it (its
+  // aria-label, labelled-by and label texts, title, placeholder, text), so a
+  // later id check compares like with like.
+  string reads;
+};
+
+// browser: why a node the browser knows was not returned.
+enum AgentUnlistedWhy {
+  kCollected,  // no node by that id any more
+  kMoved,      // the node is under another local root now
+  kDetached,   // the node exists but is not connected
+  kUnlisted,   // connected, but not listed
+  kOffscreen,  // left out as off-screen by AgentOffscreenMode.kNone
+};
+
+struct AgentUnlisted {
+  int32 node_id;
+  AgentUnlistedWhy why;
+};
+
+// browser: a live region of this local root's documents.
+struct AgentRegionRead {
+  int32 node_id;     // the region root's DOMNodeId
+  string kind;       // alert | status | log | output | live
+  bool assertive;
+  uint64 text_hash;  // over its whole text, up to 20 000 characters
+  string text;       // 300 characters: the last for log, else the first
+};
+
+// browser: what a region said since the last action's ArmSettle, or
+// in the 30 s before it, carried on at that ArmSettle (before_action).
+struct AgentHeardRead {
+  int64 arm_id;      // the action's arm it was heard under
+  int32 index;       // its number, unique under that arm_id
+  AgentRegionRead region;
+  bool gone;         // that text is not shown by any region at this read
+  bool before_action;  // heard before the last action's ArmSettle: carried on
+  // browser: recorded by a read's closing pass while no watch looked, or
+  // by a paused watch's read of the regions alone between calls; not by the
+  // watch.
+  bool unwatched = false;
+  // browser: heard while no action's own span was open -- an action's
+  // span runs from its Arm until its report's last read of the page, or 30 s
+  // when none reads it: the page said it by itself.
+  bool own = false;
+  // browser: how long before this read it was heard (a closing pass's
+  // entry: when that pass found it).
+  int32 ago_ms = 0;
+  // browser: how many changes of its region it stands for: 1, or, when
+  // it took the place of its region's latest entry past the allowance, that
+  // entry's count plus one (a clock between calls).
+  int32 changes = 1;
+  // browser: the text of the entry its newest change took the place of
+  // (with `changes` 2 or more), as `region.text` reads; null otherwise.
+  string? replaced;
+  // browser: the token of the document that heard it: with the arm id
+  // and `index`, its key, unique across the documents of its frame.
+  string document;
+  // browser: for a log, the text its change added -- after where its
+  // text ended, or before where it began for a log adding at the top -- and
+  // for an entry standing for several changes, what they all added one way;
+  // 300 characters from its start, cut at a word and marked "..."; null when
+  // none could be told (rewritten, removed, too large to place, a log first
+  // seen since the arm, or past 32 logs in its local root).
+  string? added;
+};
+
+// browser: one node's liveness.
+struct AgentNodeState {
+  int32 node_id;
+  bool alive;        // connected and under this local root
+  bool rendered;     // has a layout box as of the last layout
+  string reads;      // name sources, a newline, subtree text; 200 chars
+  AgentValidity? validity;  // browser: as on AgentElement
+  // browser: a checkbox or radio <input>'s state, "true", "false" or
+  // "mixed" (indeterminate), else its aria-checked; null when it has none.
+  string? checked;
+};
+
+// browser: one painted text run of a frozen frame: one line of one text
+// node, as drawn (password bullets stay bullets).
+struct AgentFrozenRun {
+  string text;
+  // Whether any of it shows; `box`, what shows, in the widget's DIPs (zero
+  // when nothing does).
+  bool in_view;
+  AgentElementBox box;
+  // The same-process frame it is in, by its place in the local root's walk.
+  int32 doc;
+  // Its text field, an index into AgentFreezeReply.fields; -1 for none.
+  int32 field = -1;
+  // What may move it on the compositor, an index into AgentFreezeReply.motion;
+  // -1 for nothing.
+  int32 motion = -1;
+};
+
+// browser: a text field of a frozen frame, with what shows of its border
+// box in the widget's DIPs. A card number or security code field (`card`) is
+// always blacked, and its runs are never read.
+struct AgentFrozenField {
+  int32 node_id;
+  bool card;
+  AgentElementBox box;
+  // What may move it on the compositor, an index into AgentFreezeReply.motion;
+  // -1 for nothing. Given whether or not text was asked for.
+  int32 motion = -1;
+};
+
+// browser: a box of a frozen frame that is blacked whatever it holds,
+// with what may move it (an index into AgentFreezeReply.motion; -1: nothing).
+struct AgentFrozenBox {
+  AgentElementBox box;
+  int32 motion = -1;
+};
+
+// browser: FreezeForCopy's answer: the frame L the local root drew, held
+// still until AgentFreezeHold.Release, or why it could not be.
+struct AgentFreezeReply {
+  bool frozen;
+  string? why_not;
+  // browser: the runs a secret could show in (they show, something may
+  // move them, or their text field shows or may move), each with the runs next
+  // to it in its document up to 65 536 letters and digits each way, those cut
+  // to the letters and digits nearest it.
+  array<AgentFrozenRun> runs;
+  // The text it would send, or hold back as a possible neighbour, was over
+  // max_text_chars, or the walk past it ran out of time: the runs past it are
+  // left out.
+  bool runs_cut;
+  array<AgentFrozenField> fields;
+  // The visible rects to black for runs, fields and boxes that something may
+  // move.
+  array<AgentElementBox> motion;
+  // What shows of frames L did not draw anew (throttled), whose text was not
+  // read: blacked whatever matches.
+  array<AgentFrozenBox> unread;
+};
+
+// browser: a frozen frame's hold. Release lets it render again and says
+// whether the pause held from the freeze until now; dropping the pipe, a newer
+// freeze or 1 s past the freeze ends it too.
+interface AgentFreezeHold {
+  Release() => (bool held);
+};
+
+struct AgentFrameSnapshot {
+  array<AgentElement> elements;
+
+  // browser, when layers were asked for: its first heading or text, the
+  // name of a frame that is a layer by itself (an iframe consent wall).
+  string? document_name;
+  // browser, when layers were asked for: the layers open on this local
+  // root's own documents, bottom to top; and its text, ~600 characters, the
+  // head of a frame that is a layer by itself.
+  array<AgentLayer> layers;
+  string? document_head;
+  // browser: the known nodes not returned (known_node_ids), the live
+  // regions, and what they said since the last action's ArmSettle.
+  array<AgentUnlisted> unlisted;
+  array<AgentRegionRead> regions;
+  array<AgentHeardRead> heard;
+  // browser: this local root's own document scroll offset (its layout
+  // viewport), in CSS pixels, as window.scrollX/scrollY say it.
+  double scroll_x = 0;
+  double scroll_y = 0;
+  // browser: this local root's document size (its layout viewport's
+  // contents), in CSS pixels.
+  double content_width = 0;
+  double content_height = 0;
+  // browser: under offscreenMode none, the DOMNodeId of every element
+  // this local root left out off-screen, made for it: the browser keeps it as
+  // dropped, so it comes into view as into_view, not new.
+  array<int32> offscreen_node_ids;
+  // browser: this local root's main scroller (AgentScrollerCandidate);
+  // null when nothing here scrolls, or, with layers asked and a blocking layer
+  // open, nothing it holds does.
+  AgentScrollerCandidate? main_scroller;
+  // browser: its own document is about:blank with nothing in its body (no
+  // element, no text): there is nothing to see.
+  bool document_blank = false;
+  // browser: its own document is scroll locked, as a layer's hints judge
+  // it: overflow hidden or clip on <html> or <body>, or either fixed on a
+  // window that cannot scroll.
+  bool document_locked = false;
+};
+
+// browser: Input.selectOptions' reading of one option of a <select>.
+struct AgentSelectOption {
+  // Its index in the select's list (optgroups counted), as the dropdown and
+  // its list window count; -1 for a value that names no pickable option.
+  int32 index;
+  // Its DOMNodeId: for a click by identity (a list box's or an open base
+  // picker's option), and for PickInList to check it is still the one at
+  // `index`; 0 with index -1.
+  int32 node_id;
+  string text;
+  string value;
+  bool selected;
+  // Disabled, itself or by its optgroup.
+  bool disabled;
+  // Not display:none, by the style it has now, as the list and the keys read
+  // it (an option in a subtree never styled reads as not displayed: the
+  // session reads again after its reveal). A closed appearance:base-select
+  // picker gives its options no style: display is not judged there, and they
+  // count as displayed.
+  bool displayed;
+  // Local-root space, as AgentElement.box; zero when not laid out (a closed
+  // dropdown's options).
+  AgentElementBox box;
+};
+
+// browser: Input.selectOptions' reading of a <select> against the values
+// asked for.
+struct AgentSelectReading {
+  // menuList | basePicker (appearance: base-select: its list is a popover in
+  // the page) | listBox | notSelect | gone.
+  string kind;
+  bool multiple;
+  bool select_disabled;
+  // The select is its document's focused element, in the focused frame: keys
+  // reach it.
+  bool focused;
+  // menuList: the browser has shown its native list window (a window the
+  // browser refuses closes without being shown); basePicker: its picker is
+  // open.
+  bool popup_shown;
+  // The first selected option's list index; -1 for none.
+  int32 selected_index;
+  // Every selected option, in list order.
+  array<AgentSelectOption> selected;
+  // One per value asked, in order: the pickable option it names, or index -1.
+  array<AgentSelectOption> matches;
+  // Values naming no option.
+  array<string> missing;
+  // Values naming only a disabled option.
+  array<string> disabled_matches;
+  // Values naming only an option that is not displayed (display:none: the
+  // list does not show it and the keys skip it; not judged while a base
+  // picker is closed).
+  array<string> hidden_matches;
+  // The first 25 options as "Text (value)", " [disabled]" and " [hidden]"
+  // marked.
+  array<string> options;
+  int32 option_count;
+  // The select's box, or an open base picker's, where its options show
+  // (local-root space).
+  AgentElementBox select_box;
+  // menuList with its window shown and one value naming a pickable option:
+  // that option's row in the window, in screen DIPs, and whether the row is
+  // among those the list shows. popup_option_found is false otherwise: the
+  // window is not shown, several values were given, or the list has not built
+  // that row yet (a long list builds its rows in batches: read again).
+  bool popup_option_found;
+  AgentElementBox popup_option_box;
+  bool popup_option_in_view;
+  // With want_route, a menuList and one value naming a pickable option: the
+  // key route to it. arrow_steps: the arrow presses from selected_index, as
+  // the keys step (negative is up; 0 when it is selected or no press lands on
+  // it). steps_from_home / steps_from_end: how many arrow presses after Home
+  // (down) / End (up), counted from the first / last option the keys reach;
+  // -1 when the keys reach none. type_ahead: the shortest prefix of its
+  // label, 1 to 4 characters an unmodified key press types on a US layout
+  // (letters lowercased), that type-ahead typed from here lands on; empty for
+  // none.
+  int32 arrow_steps;
+  int32 steps_from_home;
+  int32 steps_from_end;
+  string type_ahead;
+};
+
+// browser: one box a held native drag's autoscroll can pick under the
+// pointer (LayoutBox::IsUserScrollable, or a frame's document when it can
+// scroll), from Input.performDrag's survey. Ids are DOMNodeIds (a document's:
+// its Document's), stable across surveys. Rects in the local root's widget,
+// in DIPs.
+struct AgentBandBox {
+  // An anonymous scroller takes its nearest element's id, so two boxes may
+  // share one.
+  int32 id;
+  // The nearest band box holding it (its layout ancestor), 0 none.
+  int32 parent;
+  // The fixed-to-view box it lies inside (AgentFixedBox.id), 0 none.
+  int32 fixed;
+  // "div#L", or "the page" for the main document, "the frame" for another.
+  string name;
+  bool is_document;
+  // Its border box, scrollbars included (a document: its viewport).
+  AgentElementBox border;
+  // Less classic scrollbars: Blink measures the belt from it.
+  AgentElementBox outer;
+  // outer inset 20 root-frame px on every side (kAutoscrollBeltSize: 20
+  // physical px, 20 / device scale factor in DIPs). A point in border but not
+  // in inner is in its band.
+  AgentElementBox inner;
+  // border clipped by every ancestor's clip and the viewport; empty when none
+  // of it shows.
+  AgentElementBox visible;
+  // outer inset max(30 px, 25 % of its visible length) per axis: the zone a
+  // pointer library (dnd-kit 20 %, react-beautiful-dnd 25 %, SortableJS
+  // 30 px) scrolls it from.
+  AgentElementBox lib_inner;
+  // Whether it can still scroll that way (a user-scrollable axis, >= 1 px).
+  bool up;
+  bool down;
+  bool left;
+  bool right;
+  // A blocking (non-passive) wheel listener on it or an ancestor, best
+  // effort: the wheel during a native drag does nothing there.
+  bool wheel_blocked;
+  // Its scroll offsets now, in CSS px.
+  double scroll_x;
+  double scroll_y;
+};
+
+// browser: a fixed-to-view box (LayoutBox::IsFixedToView) -- or, for a fixed
+// box a hit test cannot land in (pointer-events: none, hidden), each hittable
+// box inside it, under that fixed box's id: ids may repeat. No band of any
+// box outside it reaches a point under it; a band box inside it says so in
+// AgentBandBox.fixed.
+struct AgentFixedBox {
+  int32 id;
+  string name;
+  AgentElementBox box;
+};
+
+// browser: an element as a drag sees it: where it is, where its slot in a
+// list is, and what it holds. Rects in the local root's widget, in DIPs.
+struct AgentSlot {
+  bool found;
+  int32 id;
+  // Its border box now (transforms applied).
+  AgentElementBox box;
+  // Its border box ignoring CSS transforms on it and on its ancestors up to
+  // its list: the slot a sortable list opened or kept for it before a drag
+  // moved anything.
+  AgentElementBox layout_box;
+  // Its place (0-based) among the same-tag siblings of the nearest ancestor
+  // that holds two or more of them, and how many there are; -1 / 0 without
+  // one. list_name names that ancestor ("ul#list"); list_vertical: the
+  // siblings' layout boxes advance down rather than across.
+  int32 index;
+  int32 count;
+  string list_name;
+  bool list_vertical;
+  // Its text, trimmed to 40 characters, and its value (an input's value, else
+  // aria-valuenow), empty when it has none.
+  string text;
+  string value;
+};
+
+// browser: the rule a typing call sends for fields where a wrong
+// character costs something: an input whose type is one of input_types, one
+// of whose autocomplete tokens is one of autocomplete_tokens or starts with
+// one of autocomplete_prefixes, whose inputmode is one of input_modes, or
+// whose maxlength is 1 to max_length_at_most. Compared ignoring ASCII case.
+struct AgentNoTypos {
+  array<string> input_types;
+  array<string> autocomplete_tokens;
+  array<string> autocomplete_prefixes;
+  array<string> input_modes;
+  int32 max_length_at_most = 0;
+};
+
+// browser: what the focused field holds, as facts: never its value.
+struct AgentFieldReading {
+  // value, editable, editor, temporal, other or none.
+  string kind;
+  // Its DOMNodeId, and its frame's DevTools token; 0 and empty for none.
+  int32 node_id = 0;
+  string frame_id;
+  // value and editable: characters it holds, and characters selected in it.
+  int32 length = -1;
+  int32 selected = 0;
+  // value: as the field says; its maxlength, -1 for none.
+  bool readonly = false;
+  bool disabled = false;
+  int32 max_length = -1;
+  // editor: CodeMirror, Ace or Monaco.
+  string editor;
+  // other: what has focus, as DescribeHit names it, its tag, and an input's
+  // type; empty otherwise.
+  string what;
+  string tag;
+  string input_type;
+  // The no-typos rule the call sent holds for it.
+  bool strict = false;
+  // With expect: whether the text is in it, line breaks as \n; null when it
+  // was not looked for.
+  bool? contains;
+  // With before_node_id: the field that names is still in the page and no
+  // longer the focused one.
+  bool moved = false;
+  // browser: temporal (a date or time field: an input of type date,
+  // time, datetime-local, month or week): whether it holds a whole value;
+  // whether a part holds one while the whole is none (validity.badInput);
+  // and the part that has focus (year, month, day, hour, minute, second,
+  // millisecond, ampm or week), empty for none. Never a value.
+  bool complete = false;
+  bool bad_input = false;
+  string part;
+};
+
+// browser: one part of a date or time field, as its user-agent shadow
+// tree draws it.
+struct AgentTemporalPart {
+  // year, month, day, hour, minute, second, millisecond, ampm or week.
+  string kind;
+  // Its DOMNodeId in this local root, for the hand's click on it.
+  int32 node_id;
+  // The range it takes now (min and max narrowed), as its aria-valuemin and
+  // aria-valuemax say; for a month by name or AM/PM, 1-based. max below min:
+  // none known.
+  int32 min;
+  int32 max;
+  // As its aria-valuenow says (AM 1, PM 2); -1 when it holds none.
+  int32 value = -1;
+  // Pinned by step, min or max: focus skips it, and it takes no keys.
+  bool disabled;
+  bool focused;
+};
+
+// browser: Input.fillDateTime's read of a date or time field. Its parts'
+// values stay in the browser: the command's answer carries none.
+struct AgentTemporalReading {
+  // gone; notTemporal (no such input); else its type: date, time,
+  // datetime-local, month or week. One drawn without parts has none.
+  string kind;
+  bool disabled;
+  bool readonly;
+  // The pattern its parts are drawn from (Unicode LDML, as its edit's
+  // datetimeformat attribute holds it), empty when unknown; whether it reads
+  // right to left.
+  string format;
+  bool rtl;
+  // Its parts, in the order it draws them.
+  array<AgentTemporalPart> parts;
+  // Whether it holds a whole value; whether a part holds one while the whole
+  // is none (validity.badInput); its validity's range and step flags.
+  bool complete;
+  bool bad_input;
+  bool range_underflow;
+  bool range_overflow;
+  bool step_mismatch;
+  // Whether one of its parts has focus.
+  bool focused;
+  // The field's value as a number (valueAsNumber: NaN with none), for the
+  // browser to compare with the one asked; it stays in the browser.
+  double number;
+  // With a `want`: how the field would take it, by Blink's own rules for its
+  // type, min, max and step (and its value attribute, a step's base without a
+  // min): whether it is one of its type at all; whether it is below its min,
+  // above its max, or off its step; and its value as a number (NaN when not
+  // valid). All false and NaN without one.
+  bool want_valid;
+  bool want_underflow;
+  bool want_overflow;
+  bool want_step_mismatch;
+  double want_number;
+};
+
+// browser: Input.chooseFiles' read of an element: a file input, a label
+// of one, or anything else, with the field's state when it names one.
+struct AgentFileReading {
+  // gone; file (an input of type file); label (a label whose control is
+  // one); other.
+  string kind;
+  // The field: its DOMNodeId in this local root (0 for none), described as a
+  // hit is (input#avatar), and its state.
+  int32 field_node_id;
+  string field;
+  bool disabled;
+  bool multiple;
+  // webkitdirectory: it takes a folder.
+  bool folder;
+  // How many files it holds; with names asked for, whether its files are
+  // those, by name, in order (the names stay in this renderer).
+  int32 count;
+  bool matches;
+  // Whether its chooser is open (open).
+  bool open;
+  // Whether it shows a box to press: laid out, visible, at least 4 by 4 px,
+  // and not clipped away by `clip`.
+  bool rendered;
+  // The first of its labels that shows a box, as a person clicks it in its
+  // place; 0 for none; and that label described as a hit is (label
+  // "Upload resume"), empty for none.
+  int32 label_node_id;
+  string label;
+  // Its accept attribute as written; empty for none.
+  string accept;
+  // For a field that shows no box and no label that does: the nearest
+  // element around it that shows one and listens for a press, which may
+  // open it, described as a hit is; empty for none.
+  string opener;
+};
+
+// browser: Input.pickColor's read of a colour field.
+struct AgentColorReading {
+  // gone; notColor (no input of type color); else color.
+  string kind;
+  bool disabled;
+  // With a `want`: whether the field holds that colour, as it would take it
+  // (in its own form for its alpha and colorspace attributes).
+  bool matches;
+  // Whether its picker -- the page popup the browser shows for it -- shows,
+  // not closing.
+  bool picker_shown;
+};
+
+// browser: an <input type=range>'s geometry: everything
+// SliderThumbElement::SetPositionFromPoint uses. Rects in the local root's
+// widget, in DIPs.
+struct AgentSlider {
+  bool is_range;
+  // The track's content box, and the thumb's box now.
+  AgentElementBox track;
+  AgentElementBox thumb;
+  // The thumb's margin at the start of the axis, in DIPs.
+  double thumb_margin_start;
+  bool vertical;
+  // The value grows right to left (or bottom to top).
+  bool flipped;
+  double min;
+  double max;
+  // 0 for step="any".
+  double step;
+  double step_base;
+  double value;
+  // The values of its datalist's options.
+  array<double> ticks;
+};
+
+// browser: what Input.performDrag asks the survey for. Ids are DOMNodeIds,
+// 0 for none; points in the local root's widget, in DIPs.
+struct AgentDragSurveyParams {
+  // The grabbed element (0: whatever lies at the grab point), and the point a
+  // hand presses on it.
+  int32 grab_node_id;
+  double grab_x;
+  double grab_y;
+  // The target element (0: none), the point aimed at on it as fractions of
+  // its box, and the hand's place (for the target reading's wheel_ok).
+  int32 target_node_id;
+  double aim_x;
+  double aim_y;
+  double hand_x;
+  double hand_y;
+  // A range input's value asked for (the grabbed element).
+  bool want_value;
+  double value;
+};
+
+// browser: the terrain of a drag, read-only, before anything is pressed and
+// again whenever the drag needs it. Rects and points in the local root's
+// widget, in DIPs.
+struct AgentDragSurvey {
+  // The visible viewport, the device scale factor, the page zoom and the
+  // display's frame interval in ms.
+  AgentElementBox viewport;
+  double device_scale_factor;
+  double page_zoom;
+  double frame_interval_ms;
+  // Every band box with a visible part, in this local root and its
+  // same-process frames, and every fixed-to-view box.
+  array<AgentBandBox> bands;
+  array<AgentFixedBox> fixed_boxes;
+  // The grabbed element (with grab_node_id 0: the element at the grab
+  // point), and the band box whose band the grab point is in by Blink's own
+  // walk (0: calm).
+  AgentSlot grab;
+  int32 grab_band;
+  // Whether a press at the grab point reaches the grabbed element (or its
+  // label), and what it reaches instead when not.
+  bool grab_reached;
+  string grab_hit;
+  // browser: when grab_hit names an open layer the grabbed element is
+  // not in (as HitCheck's hit_kind), that layer's kind; empty otherwise.
+  string grab_hit_kind;
+  // browser: the press check's verdict when grab_reached is false
+  // (covered, noPointer, nothing, inert, disabled, hidden, gone);
+  // empty when it is reached, or with no grabbed element. For inert, grab_hit
+  // is what switched it off -- empty when nothing names it -- and
+  // grab_hit_kind its kind, as HitCheck's.
+  string grab_verdict;
+  // The target element (found false without one), and the carry reading for
+  // it with the survey's aim and hand (found false without one).
+  // Its wheel_found is always false: WheelStation finds the wheel's place.
+  AgentSlot target;
+  AgentCarryReading target_reading;
+  // A range input's geometry when the grabbed element is one; with
+  // want_value, the point whose value is the one asked for (the middle of the
+  // pixels that give it), the value it gives (the nearest reachable step),
+  // and whether there is one.
+  AgentSlider slider;
+  bool value_found;
+  double value_x;
+  double value_y;
+  double value_reached;
+};
+
+// browser: Blink's own band answer at one point: the box a held drag would
+// autoscroll there (AgentBandBox.id, 0 none) and the side whose band the
+// point is in (0 none, 1 top, 2 bottom, 3 left, 4 right; a corner: the
+// vertical side).
+struct AgentBandProbe {
+  int32 box;
+  int32 side;
+};
+
+// browser: what a drag watches every frame.
+struct AgentDragWatch {
+  array<int32> box_node_ids;
+  int32 target_node_id;
+  int32 grab_node_id;
+};
+
+// browser: one frame of a watched drag.
+struct AgentDragFrame {
+  // Bumps whenever anything below changed.
+  uint32 version;
+  // scroll_x, scroll_y (CSS px) of each watched box, in AgentDragWatch order;
+  // NaN-free: a box gone reads its last offsets.
+  array<double> offsets;
+  // The target and the grabbed element now.
+  AgentSlot target;
+  AgentSlot grab;
+  // Bumps on any layout since the watch began: the survey's bands may have
+  // moved.
+  uint32 layout_version;
+  // A scrollend fired on a watched box since the last answer.
+  bool scroll_ended;
+  // The renderer's monotonic time of the frame, in ms.
+  double time_ms;
+};
+
+// browser: what an until's selector or xpath waits for, on the first
+// match in each checked document: it exists; it has a box of positive size;
+// that, visibility visible and its own opacity above 0; or not that (no
+// match, or the first is not visible), in every document checked.
+enum AgentUntilState {
+  kAttached,
+  kBox,
+  kVisible,
+  kHidden,
+};
+
+// browser: the settle. What AwaitSettle waits for first; any one
+// met meets it. text: a case-insensitive, space-collapsed substring of the
+// rendered text (or of an interactive element's aria-label, title, alt or
+// placeholder) in any frame of this local root. selector: a CSS selector
+// whose first match per same-process document is as `state` says
+// (QuerySelector; one that does not parse answers until_invalid). gone_node_id:
+// a DOMNodeId of this local root's own (0: none), met once the node is
+// detached, not rendered or display: none -- send it only to the local root
+// that owns the node, DOMNodeIds being per process. xpath: in place of
+// selector, its first node in document order (one that does not parse
+// answers until_invalid). frame_token: a frame's DevTools token; only that
+// frame's document is checked for selector or xpath (null: every one).
+struct AgentUntil {
+  string? text;
+  string? selector;
+  int32 gone_node_id = 0;
+  string? xpath;
+  AgentUntilState state = kVisible;
+  string? frame_token;
+  // browser: met once this local root shows more elements than at
+  // the arm (rendered, visibility visible, no opacity 0 on them or above
+  // them), counted since the waiting call came.
+  bool appeared = false;
+};
+
+// browser: one thing still changing (or, never blocking, still running) when
+// a settle answered.
+struct AgentChanging {
+  // request | request-ended | animation | mutation | navigation | lifecycle
+  string kind;
+  // A request's path without its query (with its host when not the
+  // document's), tag#id.class with (new) / (changed) / (gone), an animation
+  // or transition and its target with the time it has left, a navigation
+  // state, "rendering paused" ...
+  string what;
+  // A DOMNodeId for an element item (0 otherwise), for the browser's label.
+  int32 node_id;
+  // A request not tied to the action: started after T with no interaction.
+  bool meanwhile;
+};
+
+// browser: what a per-action report asks of a local root besides its
+// live regions.
+struct AgentReportOptions {
+  // Its layer stack too, read as a layers_only CollectFrameElements reads it.
+  bool layers = false;
+  // browser: these DOMNodeIds of this local root too, read as NodesAlive
+  // reads them (the elements an action acted on).
+  array<int32> node_ids;
+  // browser: the browser reads this report again, after a closing
+  // layer's animation: what was heard since its first read is the action's
+  // too.
+  bool reread = false;
+  // browser: its control census too (AgentControlRead), each control
+  // placed in the layer stack read with it.
+  bool controls = false;
+};
+
+// browser: one control of a local root's census, read with its report: a
+// field or a button, rendered, with a box and visibility visible. No value.
+struct AgentControlRead {
+  // Its DOMNodeId.
+  int32 node_id;
+  // Its box in the local root's coordinates, CSS px.
+  double x;
+  double y;
+  double width;
+  double height;
+  // A button; else a field.
+  bool button;
+  // As Page.pdl's AgentControl.role.
+  string role;
+  // By the census's DOM rule; empty for none.
+  string label;
+  bool disabled;
+  bool readonly;
+  bool required;
+  bool checked;
+  // A card number or security code field.
+  bool secret;
+  // The innermost entry of the report's layer stack holding it; -1 when none
+  // does, or the stack was not read.
+  int32 layer = -1;
+  // A field's, as NodesAlive reads it.
+  AgentValidity? validity;
+};
+
+// browser: one local root's part of the per-action report, read after
+// its settle answered (AwaitSettle) or at once (ReportNow): its live regions
+// now and what they said since the last action's ArmSettle, the closing pass
+// run; with `layers`, its layer stack as a layers_only CollectFrameElements
+// answers it.
+struct AgentFrameReport {
+  array<AgentRegionRead> regions;
+  array<AgentHeardRead> heard;
+  AgentFrameSnapshot? layer_snapshot;
+  // ReportNow's arm is not this renderer's latest: nothing was read.
+  bool superseded = false;
+  // The nodes of `node_ids`, in their order.
+  array<AgentNodeState> nodes;
+  // browser: with `controls`, its control census; null when not asked.
+  array<AgentControlRead>? controls;
+  // browser: the census stopped short: past 400 controls, its walk's
+  // budget or its time.
+  bool controls_cut = false;
+};
+
+// browser: one local root's settle.
+struct AgentSettleReading {
+  bool settled;
+  bool until_seen;
+  // No frames came while the lifecycle waited for one: never "settled".
+  bool rendering_paused;
+  // Past the 50 000-node budget the stamp alone stood for the page.
+  bool budget_exceeded;
+  // The latest change, request end, navigation clearing or waited-for
+  // animation's end, in ms since T (0: none since the arm).
+  int64 last_change_ms;
+  array<AgentChanging> changing;
+  // When `until` was met, in ms since T (0 when not seen).
+  int64 until_ms;
+  // `until.selector` or `until.xpath` does not parse.
+  bool until_invalid;
+  // browser: the elements shown now less at the arm (rendered,
+  // visibility visible, no opacity 0 on them or above them), when both were
+  // counted within the walk's budget over the same frames (shown_counted);
+  // whether the DOM or the focus moved since the arm.
+  int32 shown_change = 0;
+  bool shown_counted = false;
+  bool dom_changed = false;
+  // browser: its part of the per-action report, when AwaitSettle asked
+  // and the browser still waits for this answer: none for an `until` wait
+  // answered unmet, one replaced or answered by a Disarm or the next Arm, or
+  // a document with no frame.
+  AgentFrameReport? report;
+};
+
+interface AgentSnapshotCollector {
+  // Gathers the interactive elements of this local root and of its
+  // same-process descendant frames, open and closed shadow DOM included.
+  // Remote (OOPIF) children are left to their own call.
+  CollectFrameElements(AgentSnapshotOptions options)
+      => (AgentFrameSnapshot result);
+
+  // Resolves a process-local DOMNodeId (as returned in
+  // AgentElement.backend_node_id) to the element's current local-root-space
+  // box. found is false when the node is gone or is not a laid-out element.
+  ResolveNode(int32 local_dom_node_id) => (bool found, AgentElementBox box);
+
+  // browser: marks the element `local_dom_node_id` names as holding a
+  // secret, for as long as the element lives: while a redacted video
+  // recording runs, it is one black box and nothing in it is drawn
+  // (AgentRedactionMarks). The reply comes once the mark is stored and,
+  // while a recording is armed, the document's paint invalidated. outcome:
+  // marked; gone (the id names no element still in a document under this
+  // local root); frame (a frame element, whose content a mark here would
+  // not hide: nothing is marked).
+  MarkSecretField(int32 local_dom_node_id) => (string outcome);
+
+  // browser: the same for the element that has focus in this local root's
+  // focused frame, as ReadField finds it before the first key (the
+  // innermost one, inside shadow trees; a part of a control's own
+  // user-agent shadow tree is the control). outcome: marked; nothing (the
+  // document's body or root has focus, or nothing); frame.
+  MarkFocusedField() => (string outcome);
+
+  // Whether a mouse press at (x, y) would reach the node, decided by the hit
+  // test a real press runs. The point is in this local root's widget, in
+  // DIPs, as the browser's input routing hands it over. verdict is one of
+  // reached, label, covered, noPointer, inert, hidden, disabled, nothing,
+  // gone; hit describes what the press would reach instead -- for reached,
+  // the part of the node with a control of its own it lands on, a link inside
+  // a card -- or is empty. A cover in an open layer the node is not in is
+  // named by that layer (listbox "City"), and hit_kind is its kind (listbox,
+  // menu, dialog, alert, popover, picker, or panel for a veil's layer with no
+  // role); empty when hit names what was met itself. For inert, hit names
+  // what switched the node off, when it can be named -- a modal dialog or a
+  // full-screen element open outside it, named as its layer is (dialog
+  // "Choose a plan"), hit_kind dialog, alert or fullscreen; else the element
+  // whose inert attribute holds it (div#main), hit_kind empty. A node in a
+  // frame whose frame element is inert is inert too, named by that element's
+  // cause with where it is (the page's div#main).
+  HitCheck(int32 local_dom_node_id, double x, double y)
+      => (string verdict, string hit, string hit_kind);
+
+  // Where on the node a hand would aim: its box and the reachable part of its
+  // largest visible client-rect piece (AgentAimPiece). Read-only (its hit
+  // tests change no hover or active state). With `with_hand`, the hand at
+  // (hand_x, hand_y), in this local root's widget DIPs, for the hover region.
+  AimPiece(int32 local_dom_node_id, double hand_x, double hand_y,
+           bool with_hand) => (AgentAimPiece piece);
+
+  // browser: Input.selectOptions' read of a <select>: what it is, what is
+  // selected, what the values name and, with its native list window shown,
+  // where the wanted option sits in it; with `want_route`, the key route to
+  // it (false on the session's per-frame polls). Read-only: brings style and
+  // layout clean in the select's document, and in the list window's.
+  ReadSelect(int32 local_dom_node_id, array<string> values, bool want_route)
+      => (AgentSelectReading reading);
+
+  // browser: Input.selectOptions' pick, in a dropdown's native list window
+  // the browser has shown and is not closing, of the option `option_node_id`
+  // at list index `index`, through the list's own commit, as a click on the
+  // row: input and change, the list closing, then the mouseup and click
+  // Chrome synthesizes on the select. outcome: picked | closed (no such window)
+  // | changed (that index no longer holds that option, or it can no longer be
+  // picked: the list changed under the dwell) | notSelect | gone.
+  PickInList(int32 local_dom_node_id, int32 index, int32 option_node_id)
+      => (string outcome);
+
+  // browser: Input.revealElement's reading. Reads the element, the point
+  // aimed at on it (fractions of its box) and the wheel at (x, y), a point in
+  // this local root's widget in DIPs, judged along `axis`: 1 vertical, 2
+  // horizontal, 0 the one the element is further off on.
+  CarryRead(int32 local_dom_node_id, double aim_x, double aim_y, double x,
+            double y, int32 axis) => (AgentCarryReading reading);
+
+  // browser: the same, once the scrollers that hold the element have held
+  // still for about 50 ms, or after timeout_ms.
+  CarrySettled(int32 local_dom_node_id, double aim_x, double aim_y, double x,
+               double y, int32 axis, int32 timeout_ms)
+      => (AgentCarryReading reading);
+
+  // browser: Input.revealElement at a frame of another process, asked when a
+  // notch at the pointer would not reach the frame: places over the frame
+  // where the wheel, turned along `axis` toward the element's need, moves what
+  // holds it -- in lines each way close enough that any band of the frame
+  // about 16 px across holds some (up to 48 rows, on a frame 768 px tall, and
+  // 32 columns, 512 px wide; wider apart past that) -- unpinned first, then
+  // nearest (x, y). In this local root's widget, in DIPs. What the page lays
+  // over this frame is not seen here: the browser routes them in turn. Empty
+  // in the main frame.
+  WheelPlaces(int32 local_dom_node_id, double aim_x, double aim_y, double x,
+              double y, int32 axis) => (array<AgentWheelPlace> places);
+
+  // browser: Input.scrollBy. With scroller_id 0: the scroller a wheel
+  // turned at (x, y) along `axis` (1 vertical, 2 horizontal) `forward` (down
+  // or right) latches, as WheelLatch picks it, else the box where
+  // overscroll-behavior stops the chain, else the window; with `alt_*` when
+  // nothing can move that way and the window cannot be scrolled that way at
+  // all. With `past_remote_frame`, a frame of another process at the point
+  // stands for what holds its frame element. With a scroller_id: that one
+  // again, its offsets as they are with nothing brought up to date, and with
+  // `check_latch` whether the wheel at (x, y) still latches it. `settle_ms`
+  // > 0, with a scroller_id only: once it and this local root's window have
+  // held still along the axis for about 50 ms, or after that long. A read
+  // with a scroller_id, and every look while a settled read waits, is
+  // contact for the action the settle watcher is armed for: send one only
+  // once that action is armed.
+  WheelScrollerAt(double x, double y, int32 axis, bool forward,
+                  int32 scroller_id, bool check_latch, bool past_remote_frame,
+                  int32 settle_ms) => (AgentWheelScroller scroller);
+
+  // browser: Input.performDrag's survey: read-only geometry and a handful of
+  // hit tests; see AgentDragSurvey.
+  DragSurvey(AgentDragSurveyParams params) => (AgentDragSurvey survey);
+
+  // browser: Blink's own band answer for each point (x0, y0, x1, y1, ...):
+  // the read-only hit test a dragover runs, then
+  // LayoutBox::FindAutoscrollable and CalculateAutoscrollDirection. At most
+  // 64 points; the rest go unanswered.
+  ProbeBands(array<double> points) => (array<AgentBandProbe> probes);
+
+  // browser: where the wheel would scroll what holds the target toward its
+  // need along `axis` (1 vertical, 2 horizontal) from a calm place: a grid
+  // over that scroller's visible part, the middle 40-60 % along the axis,
+  // each point checked with the wheel's latch and with Blink's own band walk
+  // (in no box's band, under no fixed box) and, for a pointer drag, outside
+  // every box's lib_inner band. found: the point nearest the hand; region:
+  // the bounding box of the qualifying points around it, for the hand to
+  // move in while the wheel turns. In the local root's widget, in DIPs.
+  WheelStation(int32 target_node_id, double aim_x, double aim_y, int32 axis,
+               double hand_x, double hand_y, bool pointer)
+      => (bool found, double x, double y, AgentElementBox region,
+          int32 box_node_id, string box_name);
+
+  // browser: a hanging get. Answers at the first frame on which anything
+  // watched changed since since_version (a watched box's scroll offsets, the
+  // target's or the grabbed element's slot, the layout), or after timeout_ms
+  // with the frame as it is. Read after the frame's lifecycle, geometry only;
+  // a 16 ms timer stands in when no frames come. A new call replaces the
+  // watched set.
+  WatchDrag(AgentDragWatch watch, uint32 since_version, int32 timeout_ms)
+      => (AgentDragFrame frame);
+
+  // browser: what a press at (x, y) would reach, leaving out the elements
+  // named (a dragged item's overlay), described as HitCheck's hit is, with
+  // its id and its value (an input's value, else aria-valuenow). In the local
+  // root's widget, in DIPs.
+  //
+  // browser: `place`, for naming what covers an element of another process,
+  // says a hit in a frame below this local root's own document is "in
+  // another frame"; without it, the hit is named as it is. With it, a hit in
+  // an open layer is named by that layer, as HitCheck's is, unless a frame
+  // element under the point lies in the layer.
+  DescribePoint(double x, double y, array<int32> exclude_node_ids, bool place)
+      => (string hit, int32 hit_node_id, string value);
+
+  // browser: of the layers given -- a capture's `layers` of this local
+  // root, bottom to top, by their roots' and veils' DOMNodeIds (0: none) --
+  // the index of the innermost whose root or veil holds the node (a hit
