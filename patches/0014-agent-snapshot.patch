+// browser: blacks out `boxes` (root DIPs) on a bitmap of the root view
+// at `dsf` px per DIP, each widened by 2 DIPs and rounded outward.
+void PaintAgentRedaction(SkBitmap& bitmap,
+                         const std::vector<gfx::RectF>& boxes,
+                         double dsf) {
+  if (boxes.empty() || bitmap.drawsNothing()) {
+    return;
+  }
+  cc::SkiaPaintCanvas paint_canvas(bitmap);
+  gfx::Canvas canvas(&paint_canvas, 1.0f);
+  const gfx::Rect image(bitmap.width(), bitmap.height());
+  for (const gfx::RectF& box : boxes) {
+    if (box.IsEmpty()) {
+      continue;
+    }
+    gfx::RectF px = gfx::ScaleRect(box, dsf);
+    px.Outset(static_cast<float>(2 * dsf));
+    gfx::Rect out = gfx::ToEnclosingRect(px);
+    out.Intersect(image);
+    if (!out.IsEmpty()) {
+      canvas.FillRect(out, SK_ColorBLACK);
+    }
+  }
+}
+
+// browser: the screenshot brought from the device's px down to `scale`
+// px per CSS px, before the marks are drawn so the badges keep their size; at
+// the device's resolution, `scale` set to `dsf`, when it cannot be resized
+// (the resizer takes only N32 pixels, and needs memory).
+void ScaleAgentScreenshot(SkBitmap& bitmap, double dsf, double& scale) {
+  if (scale >= dsf) {
+    return;
+  }
+  const int w = std::max(1, base::ClampRound(bitmap.width() * scale / dsf));
+  const int h = std::max(1, base::ClampRound(bitmap.height() * scale / dsf));
+  SkBitmap scaled = skia::ImageOperations::Resize(
+      bitmap, skia::ImageOperations::RESIZE_BEST, w, h);
+  if (scaled.drawsNothing()) {
+    scale = dsf;
+    return;
+  }
+  bitmap = std::move(scaled);
+}
+
+// browser: keeps `clip` (root DIPs) of the full-resolution copy and
+// cuts the rest away; `kept` is the part of it the copy held, in DIPs. False,
+// the bitmap untouched, when the clip meets none of it.
+bool CropAgentScreenshot(SkBitmap& bitmap,
+                         const gfx::RectF& clip,
+                         double px_per_dip,
+                         gfx::RectF* kept) {
+  gfx::Rect device = gfx::ToEnclosingRect(gfx::ScaleRect(clip, px_per_dip));
+  device.Intersect(gfx::Rect(bitmap.width(), bitmap.height()));
+  if (device.IsEmpty()) {
+    return false;
+  }
+  SkBitmap part;
+  if (!bitmap.extractSubset(
+          &part, SkIRect::MakeXYWH(device.x(), device.y(), device.width(),
+                                   device.height()))) {
+    return false;
+  }
+  // A copy of its own: a subset shares the pixels it was cut from, and the
+  // paint and the scale below write.
+  SkBitmap own;
+  if (!own.tryAllocPixels(part.info()) ||
+      !part.readPixels(own.pixmap(), 0, 0)) {
+    return false;
+  }
+  bitmap = std::move(own);
+  *kept = gfx::ScaleRect(gfx::RectF(device), 1 / px_per_dip);
+  return true;
+}
