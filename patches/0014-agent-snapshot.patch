+  Vector<uint64_t> nav_pending_at_arm_;
+
+  // Animations, as the last frame read them.
+  uint8_t blocking_animations_ = 0;
+  base::TimeTicks blocking_until_;
+  // The frame that read the animations below: their time left counts down
