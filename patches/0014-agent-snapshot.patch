+// browser: whether an input event can move what the compositor draws
+// without the main thread: a wheel turn, a scroll, fling or pinch gesture, a
+// touch move, or a mouse button pressed or held (a scrollbar's arrow, or its
+// thumb dragged, scrolls on the compositor). A wheel's phase end, a
+// gesture's end and a plain mouse move cannot. Keys are left out: a key's
+// scroll runs on the main thread and shows only in a commit, which the pause
+// holds back, and a smooth one under way at L is the renderer's to see.
+bool MovesOnCompositor(const blink::WebInputEvent& event) {
+  using Type = blink::WebInputEvent::Type;
+  const Type type = event.GetType();
+  if (type == Type::kMouseWheel) {
+    const auto& wheel = static_cast<const blink::WebMouseWheelEvent&>(event);
+    return wheel.delta_x != 0 || wheel.delta_y != 0;
+  }
+  if (type == Type::kGestureScrollUpdate || type == Type::kGestureFlingStart ||
+      type == Type::kGesturePinchUpdate || type == Type::kTouchMove ||
+      type == Type::kMouseDown) {
+    return true;
+  }
+  constexpr int kButtons = blink::WebInputEvent::kLeftButtonDown |
+                           blink::WebInputEvent::kMiddleButtonDown |
+                           blink::WebInputEvent::kRightButtonDown;
+  return type == Type::kMouseMove && (event.GetModifiers() & kButtons) != 0;
+}
