+// browser: one same-process document of one frozen local root, in root
+// DIPs: its painted runs (empty where they do not show) and what moves them,
+// and its text fields by the runs they hold, with what moves them (empty for
+// nothing), for the client's matcher and the paint after it.
+struct AgentRedactionFrame {
+  struct Field {
+    int first_run = 0;
+    int end_run = 0;
+    gfx::RectF box;
+    gfx::RectF motion;
+  };
+  std::vector<std::string> texts;
+  std::vector<bool> in_view;
+  std::vector<gfx::RectF> runs;
+  // What moves each run; empty for nothing.
+  std::vector<gfx::RectF> run_motion;
+  std::vector<Field> fields;
+};
