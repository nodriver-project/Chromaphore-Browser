+class SettleArm {
+ public:
+  SettleArm();
+  SettleArm(const SettleArm&) = delete;
+  SettleArm& operator=(const SettleArm&) = delete;
+  // The renderers still armed are disarmed.
+  ~SettleArm();
+
+  // A new arm, the one before replaced: every live local root of `contents`'
+  // primary page gets ArmSettle(arm_id, t, look) on a pipe of its own.
+  // browser: `look`: armed by a look (Page.agentSettle with no armId),
+  // not by an action.
+  void Arm(WebContents* contents, int arm_id, base::TimeTicks t, bool look);
+  // The arm `arm_id` ends, if it is the current one (its action was dropped).
+  void Drop(int arm_id);
+  // No arm: every renderer still armed gets DisarmSettle.
+  void Clear();
+
+  // 0: none.
+  int id() const { return id_; }
+  base::TimeTicks t() const { return t_; }
+  // browser: armed by a look; every ArmSettle of this arm says so, its
+  // re-arms included, so a re-arm of a look's id stays a look.
+  bool look() const { return look_; }
+  // The main frame's first cross-document commit since T (null: none).
+  base::TimeTicks first_commit() const { return first_commit_; }
+  // When the main frame's URL first differed from the one at T.
+  std::optional<base::TimeTicks> UrlChangedAt() const;
+  // When the main frame's URL first contained `needle` (T if it did then).
+  std::optional<base::TimeTicks> UrlContainsAt(const std::string& needle) const;
+  // When the page first opened a tab or window since T.
+  std::optional<base::TimeTicks> NewTabAt() const;
+  // browser: when a frame of the page first asked to print since T.
+  std::optional<base::TimeTicks> PrintAt() const;
+
+  // The arm's renderer for `local_root`'s document: the one armed already,
+  // or one armed now (`late`: from a fresh baseline). Null with no arm, or
+  // when the frame takes no interfaces.
+  scoped_refptr<SettleRenderer> RendererFor(RenderFrameHostImpl* local_root,
+                                            bool* late);
+  // browser: the arm's renderer for `local_root`'s document to read a
+  // report from, armed or not -- a read needs no re-arm, which would restart
+  // its watch -- or, with none on an open pipe, RendererFor's.
+  scoped_refptr<SettleRenderer> RendererToRead(RenderFrameHostImpl* local_root);
+  // Every renderer of the arm, those armed at a commit included.
+  const std::vector<scoped_refptr<SettleRenderer>>& renderers() const {
+    return renderers_;
+  }
+  // `join` hears (posted, never from inside the watch's observer calls)
+  // whenever a commit, a URL change or a new tab happened.
+  void AddJoin(base::WeakPtr<SettleJoin> join);
+
+  // From the watch's WebContentsObserver.
+  void DidFinishNavigation(NavigationHandle* handle);
+  void DidOpenTab(WebContents* new_contents);
+  // browser: the print manager took a frame's print(). It wakes no
+  // join: no `until` waits for a print.
+  void DidRequestPrint();
+
+  base::WeakPtr<SettleArm> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+
+ private:
+  struct UrlChange {
+    base::TimeTicks at;
+    GURL url;
+  };
+
+  // Binds a pipe to `frame`'s collector and sends ArmSettle(id_, t, look_) on
+  // it.
+  scoped_refptr<SettleRenderer> Bind(RenderFrameHostImpl& frame,
+                                     base::TimeTicks t,
+                                     bool committed_after_arm);
+  void DisarmAll();
+  void NotifyJoins();
+
+  int id_ = 0;
+  base::TimeTicks t_;
+  bool look_ = false;
+  base::WeakPtr<WebContents> contents_;
+  std::vector<scoped_refptr<SettleRenderer>> renderers_;
+  GURL url_at_arm_;
+  std::vector<UrlChange> url_changes_;
+  base::TimeTicks first_commit_;
+  base::TimeTicks first_new_tab_;
+  base::TimeTicks first_print_;
+  std::vector<base::WeakPtr<SettleJoin>> joins_;
+  base::WeakPtrFactory<SettleArm> weak_factory_{this};
+};
