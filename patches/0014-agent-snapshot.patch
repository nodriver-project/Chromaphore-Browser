+namespace {
+
+// How long the forced commit may take to reach its main frame.
+constexpr base::TimeDelta kFrameWait = base::Seconds(1);
+// How long the pause may last without the browser's Release: its copy takes
+// one frame of the display compositor.
+constexpr base::TimeDelta kHoldLimit = base::Seconds(1);
+
+// The local root's viewport less its scrollbars, in its frame, as the
+// collector's ViewportRect.
+gfx::RectF ViewportOf(const LocalFrameView& view) {
+  if (PaintLayerScrollableArea* area = view.LayoutViewport()) {
+    return gfx::RectF(
+        gfx::Rect(area->VisibleContentRect(kExcludeScrollbars).size()));
+  }
+  return gfx::RectF(gfx::Rect(view.Size()));
+}
+
+// Whether a scroller is scrolling by itself: a smooth scroll the page or the
+// browser started and that is still running.
+bool Scrolling(const ScrollableArea& area) {
+  const ScrollAnimatorBase* animator = area.ExistingScrollAnimator();
+  const ProgrammaticScrollAnimator* programmatic =
+      area.ExistingProgrammaticScrollAnimator();
+  return (animator && animator->HasRunningAnimation()) ||
+         (programmatic && programmatic->HasRunningAnimation());
+}
+
+// Whether a frame's own view is scrolling by itself.
+bool ViewScrolling(const LocalFrameView* view) {
+  PaintLayerScrollableArea* area = view ? view->LayoutViewport() : nullptr;
+  return area && Scrolling(*area);
+}
+
+// This local root and every same-process frame below it, depth first, as the
+// collector's CollectSameProcessFrames.
+void FramesOf(LocalFrame& frame, HeapVector<Member<LocalFrame>>& out) {
+  out.push_back(&frame);
+  for (Frame* child = frame.FirstChild(); child; child = child->NextSibling()) {
+    if (auto* local_child = DynamicTo<LocalFrame>(child)) {
+      FramesOf(*local_child, out);
+    }
+  }
+}
+
+// The box that holds a frame's view in its parent's document; null at the
+// local root, whose owner is in another process or none.
+const LayoutObject* OwnerOf(const LayoutObject& view) {
+  const LocalFrame* frame = view.GetFrame();
+  return frame && !frame->IsLocalRoot() ? frame->OwnerLayoutObject() : nullptr;
+}
+
+// browser: how far, in letters and digits, the runs next to one a secret
+// could show in are sent on each side, so a secret crossing into it is found
+// whole. A client may look for a longer secret in pieces of half the longest
+// it matches whole, which it keeps below this, with room for a letter two
+// Unicode tables count differently: a piece that holds what shows lies
+// within what is sent.
+constexpr int64_t kNeighbourLetters = 65536;
+
+// browser: how long from the start of the record the walk may go on
+// reading text once it has passed the text the cap counts: then it reads no
+// more (runs_cut), as past the cap, while the hold (kHoldLimit) still lasts.
+constexpr base::TimeDelta kTextWalkBudget = base::Milliseconds(500);
+
+// browser: a run that cannot show, held back in case one that can follows
+// within kNeighbourLetters: its text in the layout, what of it is sent then
+// (from `from` on), its letters and digits, and its text field.
+struct HeldRun {
+  StringView text;
+  wtf_size_t from = 0;
+  int64_t letters = 0;
+  int32_t field = -1;
+};
+
+// browser: the letters and digits of a run, unit by unit (u_isalnum's
+// categories), as a client's secret matcher is to count them; a client on
+// another Unicode table may differ by a character one table knows and the
+// other not.
+int64_t LettersAndDigits(const StringView& text) {
+  int64_t count = 0;
+  if (text.Is8Bit()) {
+    for (LChar c : text.Span8()) {
+      count += unicode::IsAlphanumeric(c) ? 1 : 0;
+    }
+  } else {
+    for (UChar c : text.Span16()) {
+      count += unicode::IsAlphanumeric(c) ? 1 : 0;
+    }
+  }
+  return count;
+}
+
+template <typename Char>
+wtf_size_t CutOf(base::span<const Char> chars, int64_t keep, bool tail) {
+  int64_t seen = 0;
+  if (tail) {
+    for (size_t i = chars.size(); i > 0; --i) {
+      if (unicode::IsAlphanumeric(chars[i - 1]) && ++seen == keep) {
+        return static_cast<wtf_size_t>(i - 1);
+      }
+    }
+    return 0;
+  }
+  for (size_t i = 0; i < chars.size(); ++i) {
+    if (unicode::IsAlphanumeric(chars[i]) && ++seen == keep) {
+      return static_cast<wtf_size_t>(i + 1);
+    }
+  }
+  return static_cast<wtf_size_t>(chars.size());
+}
+
+// browser: with `tail`, where the part of a run holding its last `keep`
+// letters and digits starts; else where the part holding its first `keep`
+// ends. All of it when it holds no more than `keep`.
+wtf_size_t NeighbourCut(const StringView& text, int64_t keep, bool tail) {
+  return text.Is8Bit() ? CutOf(text.Span8(), keep, tail)
+                       : CutOf(text.Span16(), keep, tail);
+}
+
+}  // namespace
+
+AgentFreeze::AgentFreeze(
+    LocalFrame& root,
+    int32_t max_text_chars,
+    mojo::PendingReceiver<mojom::blink::AgentFreezeHold> hold,
+    FreezeCallback callback)
+    : ExecutionContextLifecycleObserver(root.DomWindow()),
+      root_(&root),
+      view_(root.View()),
+      hold_(this, root.DomWindow()),
+      callback_(std::move(callback)),
+      max_text_chars_(std::max(max_text_chars, 0)),
+      timer_(root.GetTaskRunner(TaskType::kInternalUserInteraction),
+             this,
+             &AgentFreeze::OnTimer) {
+  hold_.Bind(std::move(hold),
+             root.GetTaskRunner(TaskType::kInternalUserInteraction));
+  hold_.set_disconnect_handler(
+      blink::BindOnce(&AgentFreeze::OnHoldGone, WrapWeakPersistent(this)));
+}
+
+AgentFreeze::~AgentFreeze() = default;
+
+void AgentFreeze::Trace(Visitor* visitor) const {
+  visitor->Trace(root_);
+  visitor->Trace(view_);
+  visitor->Trace(hold_);
+  visitor->Trace(timer_);
+  visitor->Trace(fields_);
+  visitor->Trace(motion_of_);
+  visitor->Trace(motion_boxes_);
+  LocalFrameView::LifecycleNotificationObserver::Trace(visitor);
+  ExecutionContextLifecycleObserver::Trace(visitor);
+}
+
+WebFrameWidgetImpl* AgentFreeze::Widget() const {
+  return static_cast<WebFrameWidgetImpl*>(root_->GetWidgetForLocalRoot());
+}
+
+void AgentFreeze::Start() {
+  WebFrameWidgetImpl* widget = Widget();
+  LocalFrameView* view = view_.Get();
+  if (!widget || !view) {
+    Fail("the frame has no widget");
+    return;
+  }
+  // The commit forced here is L: its presentation is asked for now, before
+  // its main frame, so that it is L's and not the commit after it.
+  commit_number_ = widget->ForceCommitForCopy(
+      blink::BindOnce(&AgentFreeze::OnPresented, WrapWeakPersistent(this)));
+  if (commit_number_ < 0) {
+    Fail("rendering cannot be held");
+    return;
+  }
+  state_ = State::kWaitingForFrame;
+  view->RegisterForLifecycleNotifications(this);
+  timer_.StartOneShot(kFrameWait, FROM_HERE);
+}
+
+void AgentFreeze::DidFinishPostLifecycleSteps(const LocalFrameView& view) {
+  if (state_ != State::kWaitingForFrame || &view != view_.Get()) {
+    return;
+  }
+  WebFrameWidgetImpl* widget = Widget();
+  if (!widget) {
+    Fail("the frame has no widget");
+    return;
+  }
+  // L is the commit right after the forced one was asked for. A main frame
+  // that has not committed yet is not L; one past L means L's steps were
+  // missed (they ran before its commit was counted), and what is drawn now
+  // may already be a later frame: not frozen.
+  const int committed = widget->CommitSourceFrameNumber();
+  if (committed <= commit_number_) {
+    return;
+  }
+  if (committed != commit_number_ + 1) {
+    Fail("the frame was missed");
+    return;
+  }
+  view_->UnregisterFromLifecycleNotifications(this);
+  // A local root L does not draw anew shows what it drew before, which the
+  // walk cannot read.
+  if (view.ShouldThrottleRendering()) {
+    Fail("the frame is throttled");
+    return;
+  }
+  // L's commit is posted to the compositor already: the pause, taken before
+  // the walk, keeps any later frame from being drawn while it runs, and what
+  // is recorded is what L draws.
+  pause_ = widget->PauseRendering();
+  if (!pause_) {
+    Fail("rendering cannot be held");
+    return;
+  }
+  state_ = State::kFrozen;
+  timer_.StartOneShot(kHoldLimit, FROM_HERE);
+  Record();
+  if (presented_) {
+    Answer();
+  }
+}
+
+void AgentFreeze::OnPresented(bool presented) {
+  if (!presented) {
+    Fail("the frame was not presented");
+    return;
+  }
+  if (state_ == State::kWaitingForFrame) {
+    // Presented before its main frame was recorded: missed.
+    Fail("the frame was presented before it was recorded");
+    return;
+  }
+  presented_ = true;
+  if (state_ == State::kFrozen) {
+    Answer();
+  }
+}
+
+void AgentFreeze::Answer() {
+  if (!callback_ || !reply_) {
+    return;
+  }
+  reply_->frozen = true;
+  std::move(callback_).Run(std::move(reply_));
+}
+
+void AgentFreeze::OnTimer(TimerBase*) {
+  if (state_ == State::kWaitingForFrame) {
+    Fail("no frame came in time");
+  } else if (state_ == State::kFrozen) {
+    // The browser did not release it: rendering goes on, and Release will
+    // say the pause did not hold.
+    Unpause(EndedBy::kOther);
+    if (callback_) {
+      Fail("the hold ended before the frame was presented");
+    }
+  }
+}
+
+void AgentFreeze::OnHoldGone() {
+  End();
+}
+
+void AgentFreeze::ContextDestroyed() {
+  End();
+}
+
+void AgentFreeze::ContextEnteredBackForwardCache() {
+  // The timer and the hold would wait there until the page came back.
+  End();
+}
+
+void AgentFreeze::End() {
+  if (callback_) {
+    Fail("a newer freeze, the document going or the hold's end ended it");
+    return;
+  }
+  Unpause(EndedBy::kOther);
+  state_ = State::kEnded;
+}
+
+void AgentFreeze::Release(ReleaseCallback callback) {
+  if (callback_) {
+    // Released before the frame was answered for: it did not hold.
+    Fail("released before the frame was answered");
+    std::move(callback).Run(false);
+    return;
+  }
+  const bool held = state_ == State::kFrozen && !broke_;
+  Unpause(EndedBy::kRelease);
+  state_ = State::kEnded;
+  std::move(callback).Run(held);
+}
+
+void AgentFreeze::Fail(const char* why) {
+  if (state_ == State::kWaitingForFrame && view_) {
+    view_->UnregisterFromLifecycleNotifications(this);
+  }
+  Unpause(EndedBy::kOther);
+  state_ = State::kEnded;
+  reply_.reset();
+  if (callback_) {
+    auto reply = mojom::blink::AgentFreezeReply::New();
+    reply->frozen = false;
+    reply->why_not = String(why);
+    std::move(callback_).Run(std::move(reply));
+  }
+}
+
+void AgentFreeze::Unpause(EndedBy ended_by) {
+  timer_.Stop();
+  if (pause_) {
+    broke_ = broke_ || ended_by != EndedBy::kRelease;
+    pause_.reset();
+  }
+}
+
+// ========================================================== the frame record
+
+void AgentFreeze::Record() {
+  reply_ = mojom::blink::AgentFreezeReply::New();
+  text_chars_ = 0;
+  walked_chars_ = 0;
+  text_deadline_ = base::TimeTicks::Now() + kTextWalkBudget;
+  viewport_motion_ = -1;
+  // What moves the whole local root's drawing: a scroll the compositor drives
+  // (a smooth wheel or key scroll), the visual viewport, or the root's own
+  // view scrolling by itself.
+  WebFrameWidgetImpl* widget = Widget();
+  all_move_ = (widget && widget->CompositorScrollAnimating()) ||
+              ViewScrolling(view_.Get());
+  if (root_->IsOutermostMainFrame()) {
+    if (Page* page = root_->GetPage()) {
+      all_move_ = all_move_ || Scrolling(page->GetVisualViewport());
+    }
+  }
+  HeapVector<Member<LocalFrame>> frames;
+  FramesOf(*root_, frames);
+  for (wtf_size_t doc = 0; doc < frames.size(); ++doc) {
+    RecordFrame(*frames[doc], static_cast<int32_t>(doc));
+  }
+  // Nothing of the layout trees is kept past the record.
+  fields_.clear();
+  field_shows_.clear();
+  motion_of_.clear();
+  motion_boxes_.clear();
+}
+
+// The painted text runs of one same-process frame, in layout pre-order (the
+// flat tree, open, closed and user-agent shadow content included; the top
+// layer last), as L draws it: password bullets stay bullets. A subtree a
+// display lock keeps from painting is skipped. A frame L does not draw anew
+// (throttled) is not read; what shows of it is boxed as unread, since what it
+// drew before can still show.
+//
+// browser: only the runs a secret could show in are sent: those that
+// show, those something may move (into view, before L is drawn), and every
+// run of a text field that shows or may move; with each, the runs next to it
+// in this document, up to kNeighbourLetters letters and digits each way, cut
+// to the letters and digits nearest it. A run with no letter or digit that
+// cannot show is never sent. The cap counts what is sent, and what is held
+// back as a possible neighbour.
+void AgentFreeze::RecordFrame(LocalFrame& frame, int32_t doc) {
+  LocalFrameView* view = frame.View();
+  LayoutView* layout_view = frame.ContentLayoutObject();
+  if (!view || !layout_view) {
+    return;
+  }
+  if (view->ShouldThrottleRendering()) {
+    // A frame inside a throttled one is covered by that one's box, and its
+    // owner's geometry may be stale.
+    const auto* parent = DynamicTo<LocalFrame>(frame.Tree().Parent());
+    if (parent && parent->View() && parent->View()->ShouldThrottleRendering()) {
+      return;
+    }
+    if (const LayoutEmbeddedContent* owner = frame.OwnerLayoutObject()) {
+      const gfx::RectF shown =
+          Visible(*owner, gfx::RectF(owner->PhysicalBorderBoxRect()));
+      // What moves it too, even when none of it shows at L: a compositor
+      // scroll can bring it in before L is drawn.
+      const int32_t motion = MotionOfBox(*owner);
+      if (!shown.IsEmpty() || motion >= 0) {
+        reply_->unread.push_back(
+            mojom::blink::AgentFrozenBox::New(Dips(shown), motion));
+      }
+    }
+    return;
+  }
+  // browser: the runs held back since the last that can show, oldest
+  // first, and how many letters and digits after it are still sent.
+  Deque<HeldRun> held;
+  int64_t held_letters = 0;
+  int64_t held_chars = 0;
+  int64_t after_letters = 0;
+  // A run sent, counted against the cap; past it, none is.
+  const auto send = [this, doc](const StringView& text,
+                                const gfx::RectF& visible, int32_t field,
+                                int32_t motion) {
+    text_chars_ += text.length();
+    if (text_chars_ > max_text_chars_) {
+      reply_->runs_cut = true;
+      return;
+    }
+    auto run = mojom::blink::AgentFrozenRun::New();
+    run->text = text.ToString();
+    run->in_view = !visible.IsEmpty();
+    run->box = Dips(visible);
+    run->doc = doc;
+    run->field = field;
+    run->motion = motion;
+    reply_->runs.push_back(std::move(run));
+  };
+  // A run that cannot show, held back as much of its end as the margin wants;
+  // the oldest goes once the rest still hold the margin.
+  const auto hold = [&](const StringView& text, int64_t letters,
+                        int32_t field) {
+    HeldRun run;
+    run.text = text;
+    run.from = NeighbourCut(text, kNeighbourLetters, /*tail=*/true);
+    run.letters = letters;
+    run.field = field;
+    held_chars += text.length() - run.from;
+    held_letters += letters;
+    held.push_back(std::move(run));
+    while (held_letters - held.front().letters >= kNeighbourLetters) {
+      held_letters -= held.front().letters;
+      held_chars -= held.front().text.length() - held.front().from;
+      held.pop_front();
+    }
+    // More held back than could be sent: fails closed, as the cap does.
+    if (text_chars_ + held_chars > max_text_chars_) {
+      reply_->runs_cut = true;
+      held.clear();
+      held_letters = 0;
+      held_chars = 0;
+    }
+  };
+  // Past the text the cap counts, the walk is held to its time.
+  const auto out_of_time = [this]() {
+    return walked_chars_ > max_text_chars_ &&
+           base::TimeTicks::Now() > text_deadline_;
+  };
+  int64_t fragments = 0;
+  for (LayoutObject* object = layout_view; object;) {
+    if (object->ChildPaintBlockedByDisplayLock()) {
+      object = object->NextInPreOrderAfterChildren(layout_view);
+      continue;
+    }
+    auto* text = DynamicTo<LayoutText>(object);
+    object = object->NextInPreOrder(layout_view);
+    if (!text) {
+      continue;
+    }
+    // In a text field: its runs are the field's; a card field is boxed, and
+    // its runs are never read. A ::first-letter part has no node of its own.
+    Node* node = text->GetNode();
+    if (!node) {
+      if (const auto* fragment = DynamicTo<LayoutTextFragment>(text)) {
+        node = fragment->AssociatedTextNode();
+      }
+    }
+    int32_t field = -1;
+    if (node) {
+      if (TextControlElement* control = EnclosingTextControl(node)) {
+        field = FieldOf(*control);
+        if (reply_->fields[field]->card) {
+          continue;
+        }
+      }
+    }
+    // With no text asked for (a session holding no secrets), only the card
+    // fields are wanted, and they are found above. Over the cap, no more
+    // text, but the walk goes on for the fields.
+    if (max_text_chars_ == 0 || reply_->runs_cut) {
+      continue;
+    }
+    // browser: out of the walk's time, no more text is read, as past the
+    // cap.
+    if (out_of_time()) {
+      reply_->runs_cut = true;
+      continue;
+    }
+    const int32_t motion = MotionOf(*text);
+    const bool field_shows = field >= 0 && field_shows_[field];
+    InlineCursor cursor;
+    for (cursor.MoveTo(*text); cursor && !reply_->runs_cut;
+         cursor.MoveToNextForSameLayoutObject()) {
+      const InlineCursorPosition& at = cursor.Current();
+      if (!at.IsText() || at.IsHiddenForPaint() || at.IsLayoutGeneratedText() ||
+          at.IsLineBreak()) {
+        continue;
+      }
+      const StringView painted = cursor.CurrentText();
+      if (painted.empty()) {
+        continue;
+      }
+      walked_chars_ += painted.length();
+      // One text node can hold a whole log: its lines are timed too.
+      if ((++fragments & 255) == 0 && out_of_time()) {
+        reply_->runs_cut = true;
+        break;
+      }
+      gfx::RectF local;
+      const LayoutObject* from = text;
+      if (at.Item()->IsSvgText()) {
+        local = at.ObjectBoundingBox(cursor);
+        from = cursor.GetLayoutBlockFlow();
+      } else {
+        local = gfx::RectF(cursor.CurrentRectInFirstContainerFragment());
+      }
+      const gfx::RectF visible = from ? Visible(*from, local) : gfx::RectF();
+      const bool can_show = !visible.IsEmpty() || motion >= 0 || field_shows;
+      const int64_t letters = LettersAndDigits(painted);
+      if (!can_show && letters == 0) {
+        continue;
+      }
+      if (can_show) {
+        // The runs held back before it, then it.
+        while (!held.empty()) {
+          const HeldRun& kept = held.front();
+          send(StringView(kept.text, kept.from), gfx::RectF(), kept.field, -1);
+          held.pop_front();
+        }
+        held_letters = 0;
+        held_chars = 0;
+        send(painted, visible, field, motion);
+        after_letters = kNeighbourLetters;
+      } else if (after_letters > 0) {
+        // Its first letters and digits, as many as the margin still wants;
+        // when that leaves out its end, the end is held, for a run that can
+        // show close after it.
+        const wtf_size_t end =
+            NeighbourCut(painted, after_letters, /*tail=*/false);
+        const wtf_size_t tail_from =
+            NeighbourCut(painted, kNeighbourLetters, /*tail=*/true);
+        const bool whole = letters <= after_letters || tail_from <= end;
+        after_letters -= letters;
+        send(whole ? painted : StringView(painted, 0, end), visible, field,
+             motion);
+        if (!whole) {
+          hold(painted, letters, field);
+        }
+      } else {
+        hold(painted, letters, field);
+      }
+    }
+  }
+}
+
+// The field record of a text field, made at its first run; a card number or
+// security code field is recorded as a card, whose runs are never read.
+int32_t AgentFreeze::FieldOf(TextControlElement& control) {
+  auto it = fields_.find(&control);
+  if (it != fields_.end()) {
+    return it->value;
+  }
+  auto field = mojom::blink::AgentFrozenField::New();
+  field->node_id = static_cast<int32_t>(DOMNodeIds::IdForNode(&control));
+  const auto* input = DynamicTo<HTMLInputElement>(control);
+  field->card = input && IsCardSecretInput(*input);
+  gfx::RectF visible;
+  if (const auto* box = DynamicTo<LayoutBox>(control.GetLayoutObject())) {
+    visible = Visible(*box, gfx::RectF(box->PhysicalBorderBoxRect()));
+    field->motion = MotionOfBox(*box);
+  }
+  field->box = Dips(visible);
+  field_shows_.push_back(!visible.IsEmpty() || field->motion >= 0);
+  const int32_t index = static_cast<int32_t>(reply_->fields.size());
+  reply_->fields.push_back(std::move(field));
+  fields_.insert(&control, index);
+  return index;
+}
+
+// What may move `object`'s drawing on the compositor between L's layout and
+// its draw, through the frames that hold it: a transform-related animation
+// above it, which moves everything below it (it contains its fixed and
+// absolute boxes too), or, out from the outermost such box (or from the text
+// when there is none) along its scroll containers, one scrolling by itself.
+// A scroller the text is only inside by layout (a fixed or absolute box
+// placed outside it) does not move it. The outermost mover is the one that
+// matters: a scrolling box with nothing moving around it stays put, and is
+// blacked itself; an animated box is drawn where the compositor puts it, so
+// the scroller or viewport around it is what is blacked. The index of that
+// rect among the reply's motion boxes; -1: none. By the text's parent: the
+// text's scroll containers are its parent's, with the parent itself when it
+// is one.
+int32_t AgentFreeze::MotionOf(const LayoutObject& object) {
+  if (all_move_) {
+    return MotionBox(nullptr);
+  }
+  const LayoutObject* parent = object.Parent();
+  if (!parent) {
+    return -1;
+  }
+  auto cached = motion_of_.find(parent);
+  if (cached != motion_of_.end()) {
+    return cached->value;
+  }
+  const int32_t motion = Motion(*parent, object);
+  motion_of_.insert(parent, motion);
+  return motion;
+}
+
+// As MotionOf, for a box (a field, a frame's owner): its own animation
+// counts, and its scroll containers are its own, so nothing is cached by its
+// parent.
+int32_t AgentFreeze::MotionOfBox(const LayoutObject& object) {
+  if (all_move_) {
+    return MotionBox(nullptr);
+  }
+  return Motion(object, object);
+}
+
+// MotionOf's walk: the animations from `above` out, the scroll containers
+// from `object` (or from the outermost animated box) out.
+int32_t AgentFreeze::Motion(const LayoutObject& above,
+                            const LayoutObject& object) {
+  const LayoutObject* animated = nullptr;
+  for (const LayoutObject* up = &above; up;) {
+    if (up->StyleRef().HasCurrentTransformRelatedAnimation()) {
+      animated = up;
+    }
+    up = up->IsLayoutView() ? OwnerOf(*up) : up->Parent();
+  }
+  const LayoutBox* scrolling = nullptr;
+  bool view_moves = false;
+  const LayoutObject& from = animated ? *animated : object;
+  for (const LayoutBox* box = from.ContainingScrollContainer(); box;) {
+    if (box->IsLayoutView()) {
+      // On into the frame that holds this one, through its owner's box.
+      view_moves = view_moves || ViewScrolling(box->GetFrameView());
+      const LayoutObject* owner = OwnerOf(*box);
+      box = owner ? owner->ContainingScrollContainer() : nullptr;
+      continue;
+    }
+    if (box->GetScrollableArea() && Scrolling(*box->GetScrollableArea())) {
+      scrolling = box;
+    }
+    box = box->ContainingScrollContainer();
+  }
+  if (view_moves) {
+    return MotionBox(nullptr);
+  }
+  if (scrolling) {
+    return MotionBox(scrolling);
+  }
+  if (animated) {
+    return MotionBox(animated->ContainingScrollContainer());
+  }
+  return -1;
+}
+
+// A moving container's visible rect among the reply's motion boxes: the
+// box's, or for a frame's view or none, the local root's viewport.
+int32_t AgentFreeze::MotionBox(const LayoutBox* container) {
+  if (!container || container->IsLayoutView()) {
+    if (viewport_motion_ < 0 && view_) {
+      viewport_motion_ = static_cast<int32_t>(reply_->motion.size());
+      reply_->motion.push_back(Dips(ViewportOf(*view_)));
+    }
+    return viewport_motion_;
+  }
+  auto it = motion_boxes_.find(container);
+  if (it != motion_boxes_.end()) {
+    return it->value;
+  }
+  const int32_t index = static_cast<int32_t>(reply_->motion.size());
+  reply_->motion.push_back(Dips(
+      Visible(*container, gfx::RectF(container->PhysicalBorderBoxRect()))));
+  motion_boxes_.insert(container, index);
+  return index;
+}
+
+gfx::RectF AgentFreeze::Visible(const LayoutObject& object,
+                                gfx::RectF rect) const {
+  LayoutView* root_view = root_->ContentLayoutObject();
+  LocalFrameView* view = view_.Get();
+  if (!root_view || !view) {
+    return gfx::RectF();
+  }
+  // Into the local root's document space, every clip in between applied, the
+  // root's own scroll and clip not: then into its frame, cut to its viewport,
+  // and under another process's frame to the part the page shows of it.
+  if (!object.MapToVisualRectInAncestorSpace(
+          root_view, rect, {VisualRectFlag::kUseGeometryMapper})) {
+    return gfx::RectF();
+  }
+  if (PaintLayerScrollableArea* area = view->LayoutViewport()) {
+    rect.Offset(-area->GetScrollOffset());
+  }
+  rect.Intersect(ViewportOf(*view));
+  if (!root_->IsOutermostMainFrame()) {
+    rect.Intersect(gfx::RectF(root_->RemoteViewportIntersection()));
+  }
+  return rect;
+}
+
+mojom::blink::AgentElementBoxPtr AgentFreeze::Dips(
+    const gfx::RectF& rect) const {
+  WebFrameWidgetImpl* widget = Widget();
+  LocalFrameView* view = view_.Get();
+  if (rect.IsEmpty() || !widget || !view) {
+    return mojom::blink::AgentElementBox::New(0, 0, 0, 0);
+  }
+  const auto dips = [&](const gfx::PointF& at) {
+    return widget
+        ->BlinkSpaceToDIPs(gfx::RectF(view->FrameToViewport(at), gfx::SizeF()))
+        .origin();
+  };
+  const gfx::PointF from = dips(rect.origin());
+  const gfx::PointF to = dips(rect.bottom_right());
+  return mojom::blink::AgentElementBox::New(
+      from.x(), from.y(), to.x() - from.x(), to.y() - from.y());
+}
+
+}  // namespace blink
