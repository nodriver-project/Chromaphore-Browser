+bool RoleIn(const String& role, base::span<const char* const> roles) {
+  for (const char* candidate : roles) {
+    if (role == candidate) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Roles (as produced by AXObject::RoleName) that are actionable by
+// themselves.
+bool IsInteractiveRole(const String& role) {
+  static constexpr const char* kRoles[] = {
+      "button",        "link",         "textbox",   "checkbox",
+      "radio",         "combobox",     "menuitem",  "menuitemcheckbox",
+      "menuitemradio", "tab",          "switch",    "slider",
+      "searchbox",     "spinbutton",   "option",    "listbox",
+      "menu",          "radiogroup",   "scrollbar", "treeitem",
+      "gridcell",      "columnheader", "rowheader"};
+  return RoleIn(role, kRoles);
+}
+
+// Roles with no semantics of their own; a non-interactive element with one
+// of these is dropped to keep the snapshot small.
+bool IsGenericRole(const String& role) {
+  static constexpr const char* kRoles[] = {
+      "generic", "GenericContainer", "none", "presentation", "IgnoredGeneric",
+      // A <br>: nothing of its own to read or act on. "LineBreak" is its
+      // accessibility role; "br" when it has no accessibility object and the
+      // role falls back to its tag.
+      "LineBreak", "br"};
+  return role.empty() || RoleIn(role, kRoles);
+}
+
+bool HasClickListener(const Node* node) {
+  return node->HasEventListeners(event_type_names::kClick) ||
+         node->HasEventListeners(event_type_names::kMousedown) ||
+         node->HasEventListeners(event_type_names::kMouseup) ||
+         node->HasEventListeners(event_type_names::kKeydown) ||
+         node->HasEventListeners(event_type_names::kPointerdown);
+}
+
+bool HasPointerCursor(Element* element) {
+  const LayoutObject* layout_object = element->GetLayoutObject();
+  return layout_object &&
+         layout_object->StyleRef().Cursor() == ECursor::kPointer;
+}
+
+// Current value for form controls; empty for everything else. A password
+// input reports bullets of the same length: whether it holds something is
+// what an agent needs, and what it holds must never reach a transcript --
+// matching it against stored secrets downstream misses any password typed by
+// hand or split by a second fill. A card number or security code field is
+// masked the same way (IsCardSecretInput): a three-digit code is too short
+// for any downstream match to catch.
+String FormControlValue(Element* element) {
+  if (auto* input = DynamicTo<HTMLInputElement>(element)) {
+    if (input->FormControlType() ==
+            mojom::blink::FormControlType::kInputPassword ||
+        IsCardSecretInput(*input)) {
+      const String value = input->Value();
+      StringBuilder masked;
+      masked.ReserveCapacity(value.length());
+      for (wtf_size_t i = 0; i < value.length(); ++i) {
+        masked.Append(static_cast<UChar>(0x2022));
+      }
+      return masked.ToString();
+    }
+    return input->Value();
+  }
+  if (auto* textarea = DynamicTo<HTMLTextAreaElement>(element)) {
+    return textarea->Value();
+  }
+  if (auto* select = DynamicTo<HTMLSelectElement>(element)) {
+    // Every chosen option of a list that takes several, each as the single
+    // case below shows one, joined by ", ".
+    if (select->IsMultiple()) {
+      StringBuilder chosen;
+      for (auto& option : select->GetOptionList()) {
+        if (!option.Selected()) {
+          continue;
+        }
+        const String option_code = option.value();
+        const String option_shown = option.DisplayLabel().SimplifyWhiteSpace();
+        if (!chosen.empty()) {
+          chosen.Append(", ");
+        }
+        if (option_shown.empty() || option_shown == option_code) {
+          chosen.Append(option_code);
+        } else {
+          chosen.Append(option_shown);
+          chosen.Append(" (");
+          chosen.Append(option_code);
+          chosen.Append(")");
+        }
+      }
+      return chosen.ToString();
+    }
+    // What the select shows, with its code after when that differs. The code
+    // alone -- value="g" -- would leave an agent to guess that g means Green.
+    const String code = select->Value();
+    const HTMLOptionElement* option = select->SelectedOption();
+    if (!option) {
+      return code;
+    }
+    const String shown = option->DisplayLabel().SimplifyWhiteSpace();
+    if (shown.empty() || shown == code) {
+      return code;
+    }
+    StringBuilder both;
+    both.Append(shown);
+    both.Append(" (");
+    both.Append(code);
+    both.Append(")");
+    return both.ToString();
+  }
+  return String();
+}
+
+// <html> and <body> carry drop listeners on every page that accepts a file
+// dropped anywhere, and neither is ever what an agent means to drag onto.
+bool IsDocumentRoot(const Element* element) {
+  return element->HasTagName(html_names::kHTMLTag) ||
+         element->HasTagName(html_names::kBodyTag);
+}
+
+bool AcceptsDrops(Node* node) {
+  if (!node->HasEventListeners(event_type_names::kDragover) &&
+      !node->HasEventListeners(event_type_names::kDragenter) &&
+      !node->HasEventListeners(event_type_names::kDrop)) {
+    return false;
+  }
+  // A drop only comes where a dragover was cancelled. An element that listens
+  // for the drop alone, with nothing on the way up listening for dragover,
+  // never gets one, so it is no drop target. A listener on the window, the
+  // document, <html> or <body> says nothing about this element -- it logs,
+  // guards against file drops, or is a framework's root -- so the walk stops
+  // below <body>, crossing shadow roots.
+  for (Node* n = node; n; n = n->ParentOrShadowHostNode()) {
+    const auto* element = DynamicTo<Element>(n);
+    if (!element) {
+      if (n->IsShadowRoot()) {
+        continue;
+      }
+      break;
+    }
+    if (IsDocumentRoot(element)) {
+      break;
+    }
+    if (n->HasEventListeners(event_type_names::kDragover)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The root of a contenteditable region: where a rich-text editor takes its
+// typing. Quill, ProseMirror/Tiptap, Lexical and Notion-style editors mount a
+// bare contenteditable <div> with no role, which nothing else here lists. A
+// form control's own editable internals are not this.
+bool IsEditingHost(Element* element) {
+  return !element->IsFormControlElement() && IsRootEditableElement(*element);
+}
+
+// How an element takes part in drag and drop, if it does.
+enum class DragPart {
+  kNone,
+  // Something to pick up.
+  kSource,
+  // Somewhere to let go.
+  kTarget,
+};
+
+bool HasPressListener(Node* node) {
+  return node->HasEventListeners(event_type_names::kPointerdown) ||
+         node->HasEventListeners(event_type_names::kMousedown) ||
+         node->HasEventListeners(event_type_names::kTouchstart);
+}
+
+bool HasText(Element* element) {
+  return !element->textContent().StripWhiteSpace().empty();
+}
+
+// An item of a sortable list: a child with text, in a container that both
+// accepts drops and listens for a press, alongside at least one sibling of the
+// same tag and class. Libraries such as SortableJS listen on the container and
+// set draggable only on mousedown, so the items themselves carry no signal at
+// all. The press listener and the text are what keep this from firing on a
+// file-drop zone, which accepts drops but is never pressed to pick up its
+// children, and whose children are often empty layout wrappers.
+bool IsSortableItem(Element* element) {
+  Element* parent = element->parentElement();
+  // An editor's lines look exactly like this -- CodeMirror's .cm-content takes
+  // drops and presses, and every .cm-line is a same-class sibling with text --
+  // and none is something to drag.
+  if (!parent || IsDocumentRoot(parent) || IsEditable(*parent) ||
+      !AcceptsDrops(parent) || !HasPressListener(parent) || !HasText(element)) {
+    return false;
+  }
+  const AtomicString& tag = element->localName();
+  const AtomicString& klass = element->FastGetAttribute(html_names::kClassAttr);
+  int alike = 0;
+  for (Element* sibling = ElementTraversal::FirstChild(*parent); sibling;
+       sibling = ElementTraversal::NextSibling(*sibling)) {
+    if (sibling->localName() == tag &&
+        sibling->FastGetAttribute(html_names::kClassAttr) == klass &&
+        ++alike >= 2) {
+      return true;
+    }
+  }
+  return false;
+}
+
+DragPart ClassifyDrag(Element* element) {
+  // Text being edited is not a thing to pick up, nor an editor somewhere to
+  // let go, whatever drag listeners an editor such as Quill hangs on its
+  // editing area.
+  if (IsDocumentRoot(element) || IsEditable(*element)) {
+    return DragPart::kNone;
+  }
+  if (EqualIgnoringAsciiCase(
+          element->FastGetAttribute(html_names::kDraggableAttr), "true") ||
+      element->HasEventListeners(event_type_names::kDragstart) ||
+      IsSortableItem(element)) {
+    return DragPart::kSource;
+  }
+  if (AcceptsDrops(element)) {
+    return DragPart::kTarget;
+  }
+  return DragPart::kNone;
+}
+
+// Why an element counts as interactive, strongest signal first. The string
+// form goes on the wire; the enum order ranks coincident nested elements.
+enum class InteractiveReason {
+  kNone,
+  kTabIndex,
+  kCursor,
+  kListener,
+  kDrag,
+  kFormControl,
+  kRole,
+};
+
+InteractiveReason ClassifyInteractive(Element* element,
+                                      const String& role,
+                                      DragPart drag) {
+  if (IsInteractiveRole(role)) {
+    return InteractiveReason::kRole;
+  }
+  if (element->IsFormControlElement()) {
+    return InteractiveReason::kFormControl;
+  }
+  if (drag != DragPart::kNone) {
+    return InteractiveReason::kDrag;
+  }
+  if (HasClickListener(element)) {
+    return InteractiveReason::kListener;
+  }
+  if (HasPointerCursor(element)) {
+    return InteractiveReason::kCursor;
+  }
+  if (element->tabIndex() >= 0) {
+    return InteractiveReason::kTabIndex;
+  }
+  return InteractiveReason::kNone;
+}
+
+// Whether a reason is only a guess (a listener, a pointer cursor, a tabindex)
+// rather than a role, a form control or a part in drag and drop.
+bool IsHeuristicReason(InteractiveReason reason) {
+  return reason == InteractiveReason::kCursor ||
+         reason == InteractiveReason::kListener ||
+         reason == InteractiveReason::kTabIndex;
+}
+
+// Whether an element the accessibility tree leaves unnamed should be named by
+// its text. Only for elements listed on a heuristic (IsHeuristicReason) or
+// for a part in drag and drop: a list item or a generic div has no name of
+// its own, and neither role takes one from its contents, so without this a
+// sortable list's items would be identical nameless rows. Form controls are
+// left alone: their text content is not what they are called.
+bool NamedByText(Element* element, InteractiveReason reason, DragPart drag) {
+  if (element->IsFormControlElement()) {
+    return false;
+  }
+  return drag != DragPart::kNone || IsHeuristicReason(reason);
+}
+
+// Whitespace of any kind, Unicode's included: a lone U+00A0, which no
+// ASCII-only test calls a space, is a blank name too.
+bool IsAnySpace(UChar c) {
+  return IsAsciiSpace(c) || c == 0x0085 || c == 0x00A0 || c == 0x1680 ||
+         (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 ||
+         c == 0x202F || c == 0x205F || c == 0x3000;
+}
+
+// A name as an agent should read it: every kind of space a plain one, runs
+// collapsed, ends trimmed, so " " and a lone U+00A0 are both no name and
+// "Forms" followed by U+00A0 is "Forms" -- the same name as its header-text,
+// as the dedup needs. Icon-font glyphs go too: the Private Use Areas
+// are where Font Awesome, Bootstrap Icons and their like draw from, and a name
+// made of one is a character no one can read. So do zero-width
+// spaces and byte-order marks.
+String CleanName(const String& raw) {
+  if (raw.empty()) {
+    return raw;
+  }
+  StringBuilder out;
+  out.ReserveCapacity(raw.length());
+  for (wtf_size_t i = 0; i < raw.length(); ++i) {
+    const UChar c = raw[i];
+    // Planes 15 and 16 are private use too: a surrogate pair whose high half
+    // is U+DB80..U+DBFF.
+    if (c >= 0xDB80 && c <= 0xDBFF && i + 1 < raw.length() &&
+        (raw[i + 1] & 0xFC00) == 0xDC00) {
+      ++i;
+      continue;
+    }
+    if ((c >= 0xE000 && c <= 0xF8FF) || c == 0x200B || c == 0xFEFF) {
+      continue;
+    }
+    out.Append(IsAnySpace(c) ? static_cast<UChar>(' ') : c);
+  }
+  return out.ToString().SimplifyWhiteSpace();
+}
+
+constexpr wtf_size_t kTextNameLength = 80;
+// Bounds the walk under a large container -- a drop zone wrapping a whole
+// panel -- since only the first few words are ever kept.
+constexpr int kTextNameNodeBudget = 2000;
+
+// Collapsed text cut to `limit` characters (a name's length unless given),
+// with an ellipsis when it was cut.
+String Capped(const String& collapsed, wtf_size_t limit = kTextNameLength) {
+  if (collapsed.length() <= limit) {
+    return collapsed;
+  }
+  wtf_size_t cut = limit - 1;
+  // Never between the halves of a surrogate pair.
+  if ((collapsed[cut - 1] & 0xFC00) == 0xD800) {
+    --cut;
+  }
+  StringBuilder shortened;
+  shortened.Append(collapsed.substr(0, cut));
+  shortened.Append(static_cast<UChar>(0x2026));
+  return shortened.ToString();
+}
+
+// The element's rendered text, whitespace collapsed and cut to a name's
+// length. The flat tree, so text in shadow trees and slots counts; only text
+// with a layout object, which keeps script, style and display:none content
+// out. Reads existing layout without updating it, so it is safe while the AX
+// cache is frozen.
+String TextName(Element* element, const Node* skip = nullptr) {
+  StringBuilder raw;
+  int budget = kTextNameNodeBudget;
+  for (Node* node = FlatTreeTraversal::FirstChild(*element);
+       node && budget-- > 0 && raw.length() < kTextNameLength * 4;) {
+    // `skip`'s subtree is left out (a document's name is not its open
+    // layer's).
+    if (node == skip) {
+      node = FlatTreeTraversal::NextSkippingChildren(*node, element);
+      continue;
+    }
+    auto* text = DynamicTo<Text>(node);
+    // A text field's own shadow text is its value (a password's in clear):
+    // never part of a name. FormControlValue reports it, masked as it must be.
+    if (text && text->GetLayoutObject()) {
+      if (Element* host = text->OwnerShadowHost();
+          !host || !IsA<TextControlElement>(host)) {
+        raw.Append(text->data());
+        raw.Append(' ');
+      }
+    }
+    node = FlatTreeTraversal::Next(*node, element);
+  }
+  return Capped(CleanName(raw.ToString()));
+}
+
+// Whether `element`'s own contenteditable attribute makes it editable: there,
+// and anything but "false" (an empty value and "plaintext-only" both edit).
+bool EditableByAttribute(const Element& element) {
+  const AtomicString& value =
+      element.FastGetAttribute(html_names::kContenteditableAttr);
+  return !value.IsNull() && !EqualIgnoringAsciiCase(value, "false");
+}
+
+// A control a value is typed into, where the visual label beside it is what a
+// person reads as its name. `role` may be empty when only the element is known.
+bool IsTextEntry(Element* element, const String& role) {
+  if (auto* input = DynamicTo<HTMLInputElement>(element)) {
+    return input->IsTextField();
+  }
+  return IsA<HTMLTextAreaElement>(element) || EditableByAttribute(*element) ||
+         role == "textbox" || role == "searchbox" || role == "combobox";
+}
+
+// Whether an element reads as a label: a <label>, or anything whose class says
+// label -- design systems draw theirs with a styled div as often as not.
+bool LooksLikeLabel(Element* element) {
+  if (IsA<HTMLLabelElement>(element)) {
+    return true;
+  }
+  const AtomicString& klass = element->FastGetAttribute(html_names::kClassAttr);
+  return !klass.empty() &&
+         klass.GetString().FindIgnoringAsciiCase("label") != kNotFound;
+}
+
+// An <h1> to <h6>.
+bool IsHeadingTag(const Element& element) {
+  return element.HasTagName(html_names::kH1Tag) ||
+         element.HasTagName(html_names::kH2Tag) ||
+         element.HasTagName(html_names::kH3Tag) ||
+         element.HasTagName(html_names::kH4Tag) ||
+         element.HasTagName(html_names::kH5Tag) ||
+         element.HasTagName(html_names::kH6Tag);
+}
+
+// Short plain text standing just before a field, which is how many apps label
+// one: <span>To Date</span><input>, with no <label> and no "label" in any
+// class (LooksLikeLabel). Not a heading, which names a section rather than a
+// field, and nothing that holds a control or a link of its own. Cheap checks
+// only; the text itself is read once, for the one that wins.
+bool LooksLikeCaption(Element* element) {
+  if (!element->GetLayoutObject() || element->IsFormControlElement() ||
+      element->HasTagName(html_names::kATag) ||
+      element->HasTagName(html_names::kButtonTag)) {
+    return false;
+  }
+  // A fixed box -- a banner, a bar, an overlay -- and anything in one is no
+  // field's caption, though it may stand just before one in the page.
+  for (const LayoutObject* box = element->GetLayoutObject(); box;
+       box = box->Container()) {
+    if (box->StyleRef().GetPosition() == EPosition::kFixed) {
+      return false;
+    }
+  }
+  if (IsHeadingTag(*element)) {
+    return false;
+  }
+  int budget = 20;
+  for (Element* inner = ElementTraversal::FirstWithin(*element);
+       inner && budget-- > 0; inner = ElementTraversal::Next(*inner, element)) {
+    if (inner->IsFormControlElement() || inner->HasTagName(html_names::kATag) ||
+        inner->HasTagName(html_names::kButtonTag)) {
+      return false;
+    }
+  }
+  // Text of its own, not only text further down.
+  for (Node* child = element->firstChild(); child;
+       child = child->nextSibling()) {
+    auto* text = DynamicTo<Text>(child);
+    if (text && !text->data().ContainsOnlyWhitespaceOrEmpty()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The text of the first cell of the table row an element sits in -- the row's
+// own name, in effect -- or empty when it is in no row, or in that first cell.
+String RowLabel(Element* element) {
+  int depth = 0;
+  for (Element* row = element->parentElement(); row && depth < 8;
+       row = row->parentElement(), ++depth) {
+    if (!row->HasTagName(html_names::kTrTag) &&
+        row->FastGetAttribute(html_names::kRoleAttr) != "row") {
+      continue;
+    }
+    for (Element* cell = ElementTraversal::FirstChild(*row); cell;
+         cell = ElementTraversal::NextSibling(*cell)) {
+      const AtomicString& cell_role =
+          cell->FastGetAttribute(html_names::kRoleAttr);
+      if (cell->HasTagName(html_names::kTdTag) ||
+          cell->HasTagName(html_names::kThTag) || cell_role == "cell" ||
+          cell_role == "gridcell" || cell_role == "rowheader") {
+        return cell->contains(element) ? String() : TextName(cell);
+      }
+    }
+    return String();
+  }
+  return String();
+}
+
+// The longest caption taken for a name. Anything longer is instructions or
+// prose, not a label.
+constexpr wtf_size_t kCaptionMaxLength = 40;
+
+// How far up a visual label is looked for, and how much of each ancestor is
+// read while looking.
+constexpr int kGroupLabelDepth = 3;
+constexpr int kGroupLabelNodeBudget = 300;
+
+// The visual label of a text field that the accessibility tree could not
+// name: the nearest group around it that holds no other text field and does
+// hold a label before it. OrangeHRM draws "From Date" and "To Date" as
+// <label>s with no `for`, next to inputs whose only name is the placeholder
+// "yyyy-dd-mm", so without this the two dates read alike. A label already
+// tied to a control is someone else's and is skipped. Empty when there is
+// none.
+String GroupLabel(Element* control) {
+  Element* group = control;
+  for (int depth = 0; depth < kGroupLabelDepth; ++depth) {
+    group = group->parentElement();
+    if (!group || IsDocumentRoot(group)) {
+      return String();
+    }
+    int fields = 0;
+    Element* label = nullptr;
+    Element* caption = nullptr;
+    bool before_control = true;
+    int budget = kGroupLabelNodeBudget;
+    Element* node = ElementTraversal::FirstWithin(*group);
+    for (; node && budget-- > 0; node = ElementTraversal::Next(*node, group)) {
+      if (node == control) {
+        before_control = false;
+        ++fields;
+        continue;
+      }
+      if (IsTextEntry(node, g_empty_string)) {
+        ++fields;
+      }
+      if (before_control && !label && LooksLikeLabel(node) &&
+          !node->contains(control)) {
+        auto* html_label = DynamicTo<HTMLLabelElement>(node);
+        if (!html_label || !html_label->Control()) {
+          label = node;
+        }
+      }
+      // The nearest one before the field; one inside the current candidate
+      // (the <b> in <span><b>To</b> Date</span>) does not displace it.
+      if (before_control && !node->contains(control) &&
+          !(caption && caption->contains(node)) && LooksLikeCaption(node)) {
+        caption = node;
+      }
+    }
+    // Too large to judge, or shared with another field: going higher only
+    // takes in more fields, so stop here either way.
+    if (node || fields > 1) {
+      return String();
+    }
+    if (label) {
+      String text = TextName(label);
+      if (!text.empty()) {
+        return text;
+      }
+    }
+    if (caption) {
+      String text = TextName(caption);
+      if (!text.empty() && text.length() <= kCaptionMaxLength) {
+        return text;
+      }
+    }
+  }
+  return String();
+}
+
+// Icon-font, sprite and id words that say what an unnamed control does. A
+// class like "bi-chevron-down" or an id like "delete-record-1" is split on
+// anything not a letter or digit before matching, so library prefixes (bi-,
+// fa-, mdi-, icon-) fall away as tokens of their own. "show" and "view" are
+// left out: Bootstrap puts them on containers for state and layout.
+bool IsIconWord(const String& word) {
+  static constexpr const char* kWords[] = {
+      "edit",      "pencil", "delete",   "trash",    "remove",    "bin",
+      "close",     "x",      "cancel",   "times",    "plus",      "add",
+      "minus",     "search", "menu",     "bars",     "hamburger", "more",
+      "ellipsis",  "kebab",  "dots",     "settings", "gear",      "cog",
+      "download",  "upload", "copy",     "share",    "info",      "help",
+      "question",  "check",  "save",     "refresh",  "reload",    "sync",
+      "filter",    "sort",   "eye",      "hide",     "heart",     "star",
+      "cart",      "user",   "person",   "logout",   "login",     "home",
+      "calendar",  "clock",  "lock",     "unlock",   "arrow",     "chevron",
+      "caret",     "play",   "pause",    "stop",     "send",      "attach",
+      "paperclip", "link",   "external", "print",    "mail",      "envelope",
+      "phone",     "bell",   "flag",     "bookmark", "pin",       "map",
+      "location",  "camera", "image",    "video",    "mic"};
+  return RoleIn(word, kWords);
+}
+
+// The first icon word in a class name, id or sprite reference, with the
+// direction that follows an arrow, chevron or caret. Empty when there is none.
+String IconWordIn(const String& value) {
+  Vector<String> tokens;
+  StringBuilder current;
+  for (wtf_size_t i = 0; i <= value.length(); ++i) {
+    const UChar c = i < value.length() ? value[i] : ' ';
+    if (IsAsciiAlphanumeric(c)) {
+      current.Append(ToAsciiLower(c));
+    } else if (!current.empty()) {
+      tokens.push_back(current.ToString());
+      current.Clear();
+    }
+  }
+  for (wtf_size_t i = 0; i < tokens.size(); ++i) {
+    if (!IsIconWord(tokens[i])) {
+      continue;
+    }
+    if ((tokens[i] == "arrow" || tokens[i] == "chevron" ||
+         tokens[i] == "caret") &&
+        i + 1 < tokens.size()) {
+      static constexpr const char* kDirections[] = {"left", "right", "up",
+                                                    "down"};
+      if (RoleIn(tokens[i + 1], kDirections)) {
+        return tokens[i] + " " + tokens[i + 1];
+      }
+    }
+    return tokens[i];
+  }
+  return String();
+}
+
+// Bounds the look inside a control for its icon: the element, then this many
+// nodes of its flat tree.
+constexpr int kIconHintNodeBudget = 40;
+
+// A guess at what an unnamed control does, from its icon, said as a guess and
+// with its source: "icon: trash (from class "bi-trash")". Goes in the
+// description, never the name. A table row's edit and delete icons often have
+// no accessible name while the page says which is which in a title attribute
+// or an icon class. Words written for people come first -- a title, an SVG
+// <title>, aria-description -- then names given to the icon itself: an SVG
+// <use> reference, then ids and classes on the element and on the <i>,
+// <span>, <svg> and <use> inside it.
+String IconHint(Element* element) {
+  int budget = kIconHintNodeBudget;
+  for (Node* node = element; node && budget-- > 0;
+       node = FlatTreeTraversal::Next(*node, element)) {
+    auto* candidate = DynamicTo<Element>(node);
+    if (!candidate) {
+      continue;
+    }
+    const String title = candidate->FastGetAttribute(html_names::kTitleAttr)
+                             .GetString()
+                             .SimplifyWhiteSpace();
+    if (!title.empty()) {
+      return "icon: " + Capped(title) + " (from title)";
+    }
+    const String described =
+        candidate->FastGetAttribute(html_names::kAriaDescriptionAttr)
+            .GetString()
+            .SimplifyWhiteSpace();
+    if (!described.empty()) {
+      return "icon: " + Capped(described) + " (from aria-description)";
+    }
+    if (candidate->IsSVGElement() && candidate->localName() == "title") {
+      const String text = candidate->textContent().SimplifyWhiteSpace();
+      if (!text.empty()) {
+        return "icon: " + Capped(text) + " (from svg title)";
+      }
+    }
+  }
+
+  budget = kIconHintNodeBudget;
+  for (Node* node = element; node && budget-- > 0;
+       node = FlatTreeTraversal::Next(*node, element)) {
+    auto* candidate = DynamicTo<Element>(node);
+    if (!candidate || (candidate != element && !candidate->IsSVGElement() &&
+                       !candidate->HasTagName(html_names::kITag) &&
+                       !candidate->HasTagName(html_names::kSpanTag))) {
+      continue;
+    }
+    if (candidate->IsSVGElement() && candidate->localName() == "use") {
+      String href = candidate->getAttribute(AtomicString("href"));
+      if (href.empty()) {
+        href = candidate->getAttribute(AtomicString("xlink:href"));
+      }
+      const wtf_size_t hash = href.find(static_cast<UChar>('#'));
+      const String fragment = hash == kNotFound ? href : href.substr(hash + 1);
+      const String word = IconWordIn(fragment);
+      if (!word.empty()) {
+        return "icon: " + word + " (from svg use \"#" + Capped(fragment) +
+               "\")";
+      }
+    }
+    const String id = candidate->GetIdAttribute().GetString();
+    if (const String word = IconWordIn(id); !word.empty()) {
+      return "icon: " + word + " (from id \"" + Capped(id) + "\")";
+    }
+    const String klass = candidate->FastGetAttribute(html_names::kClassAttr)
+                             .GetString()
+                             .SimplifyWhiteSpace();
+    if (klass.empty()) {
+      continue;
+    }
+    for (const String& class_name : klass.Split(" ")) {
+      if (const String word = IconWordIn(class_name); !word.empty()) {
+        return "icon: " + word + " (from class \"" + Capped(class_name) + "\")";
+      }
+    }
+  }
+  return String();
+}
+
+// What an <input> that picks a date, a time or a color is called, and the
+// value it takes. Chromium's own roles for these -- Date, InputTime, DateTime
+// (for a month as well), ColorWell -- are internal names no page or tool uses.
+struct TypedInputKind {
+  const char* role;
+  const char* format;
+};
+
+// browser: whether a date or time field draws the part `part`
+// ("second", "millisecond") -- Blink adds them when the step or the value
+// asks for them -- read from its edit's fields, as ReadTemporal reads them.
+bool TemporalDraws(HTMLInputElement& input, const char* part) {
+  ShadowRoot* shadow = input.UserAgentShadowRoot();
+  Element* edit =
+      shadow ? shadow->getElementById(shadow_element_names::kIdDateTimeEdit)
+             : nullptr;
+  Element* fields = edit ? ElementTraversal::FirstChild(*edit) : nullptr;
+  const AtomicString pseudo(String("-webkit-datetime-edit-") + part + "-field");
+  for (Element* drawn = fields ? ElementTraversal::FirstChild(*fields)
+                               : nullptr;
+       drawn; drawn = ElementTraversal::NextSibling(*drawn)) {
+    if (drawn->ShadowPseudoId() == pseudo) {
+      return true;
+    }
+  }
+  return false;
+}
+
+const TypedInputKind* TypedInputKindOf(Element* element) {
+  auto* input = DynamicTo<HTMLInputElement>(element);
+  if (!input) {
+    return nullptr;
+  }
+  static constexpr TypedInputKind kDate = {"date input", "YYYY-MM-DD"};
+  static constexpr TypedInputKind kTime = {"time input", "HH:MM"};
+  static constexpr TypedInputKind kTimeSeconds = {"time input", "HH:MM:SS"};
+  static constexpr TypedInputKind kTimeMillis = {"time input", "HH:MM:SS.mmm"};
+  static constexpr TypedInputKind kDateTime = {"datetime-local input",
+                                               "YYYY-MM-DDTHH:MM"};
+  static constexpr TypedInputKind kDateTimeSeconds = {"datetime-local input",
+                                                      "YYYY-MM-DDTHH:MM:SS"};
+  static constexpr TypedInputKind kDateTimeMillis = {"datetime-local input",
+                                                     "YYYY-MM-DDTHH:MM:SS.mmm"};
+  static constexpr TypedInputKind kMonth = {"month input", "YYYY-MM"};
+  static constexpr TypedInputKind kWeek = {"week input", "YYYY-Www"};
+  static constexpr TypedInputKind kColor = {"color input", "#rrggbb"};
+  switch (input->FormControlType()) {
+    case mojom::blink::FormControlType::kInputDate:
+      return &kDate;
+    case mojom::blink::FormControlType::kInputTime:
+      return TemporalDraws(*input, "millisecond") ? &kTimeMillis
+             : TemporalDraws(*input, "second")    ? &kTimeSeconds
+                                                  : &kTime;
+    case mojom::blink::FormControlType::kInputDatetimeLocal:
+      return TemporalDraws(*input, "millisecond") ? &kDateTimeMillis
+             : TemporalDraws(*input, "second")    ? &kDateTimeSeconds
+                                                  : &kDateTime;
+    case mojom::blink::FormControlType::kInputMonth:
+      return &kMonth;
+    case mojom::blink::FormControlType::kInputWeek:
+      return &kWeek;
+    case mojom::blink::FormControlType::kInputColor:
+      return &kColor;
+    default:
+      return nullptr;
+  }
+}
+
+// A splitter's handle, such as W3Schools' editor divider: a bare <a> with
+// cursor: col-resize and nothing else to say what it is.
+bool HasResizeCursor(Element* element) {
+  const LayoutObject* layout_object = element->GetLayoutObject();
+  if (!layout_object) {
+    return false;
+  }
+  const ECursor cursor = layout_object->StyleRef().Cursor();
+  return cursor == ECursor::kColResize || cursor == ECursor::kRowResize ||
+         cursor == ECursor::kEwResize || cursor == ECursor::kNsResize;
+}
+
+String InteractiveReasonName(InteractiveReason reason) {
+  switch (reason) {
+    case InteractiveReason::kNone:
+      return "";
+    case InteractiveReason::kTabIndex:
+      return "tabindex";
+    case InteractiveReason::kCursor:
+      return "cursor";
+    case InteractiveReason::kListener:
+      return "listener";
+    case InteractiveReason::kDrag:
+      return "drag";
+    case InteractiveReason::kFormControl:
+      return "form-control";
+    case InteractiveReason::kRole:
+      return "role";
+  }
+  NOTREACHED();
+}
+
+// browser: whether an aria state attribute says true.
+bool AriaTrue(const Element& element, const QualifiedName& name) {
+  return EqualIgnoringAsciiCase(element.FastGetAttribute(name), "true");
+}
+
+// browser: aria-disabled, -checked, -readonly and -required count as the
+// native states do, on any element, since an ARIA widget says them so; a
+// native checkbox's or radio's own checkedness wins over aria-checked.
+Vector<String> ElementStates(Element* element) {
+  Vector<String> states;
+  states.push_back("visible");
+
+  if (element->IsDisabledFormControl() ||
+      AriaTrue(*element, html_names::kAriaDisabledAttr)) {
+    states.push_back("disabled");
+  } else if (element->IsFormControlElement()) {
+    states.push_back("enabled");
+  }
+  if (element->IsFocusable(Element::UpdateBehavior::kNoneForAccessibility)) {
+    states.push_back("focusable");
+  }
+  if (element->IsFocusedElementInDocument()) {
+    states.push_back("focused");
+  }
+  if (EditableByAttribute(*element) || IsA<TextControlElement>(element)) {
+    states.push_back("editable");
+  }
+  const auto* as_input = DynamicTo<HTMLInputElement>(element);
+  if ((as_input && as_input->IsCheckable())
+          ? as_input->Checked()
+          : AriaTrue(*element, html_names::kAriaCheckedAttr)) {
+    states.push_back("checked");
+  }
+  if (auto* option = DynamicTo<HTMLOptionElement>(element)) {
+    if (option->Selected()) {
+      states.push_back("selected");
+    }
+  } else if (AriaTrue(*element, html_names::kAriaSelectedAttr)) {
+    states.push_back("selected");
+  }
+  if (AriaTrue(*element, html_names::kAriaExpandedAttr)) {
+    states.push_back("expanded");
+  }
+  if (element->FastHasAttribute(html_names::kReadonlyAttr) ||
+      AriaTrue(*element, html_names::kAriaReadonlyAttr)) {
+    states.push_back("readonly");
+  }
+  if (element->FastHasAttribute(html_names::kRequiredAttr) ||
+      AriaTrue(*element, html_names::kAriaRequiredAttr)) {
+    states.push_back("required");
+  }
+  // A card field masked by FormControlValue. The bridge blacks out its box in
+  // screenshots, inside a payment frame too, and nothing else of the frame.
+  if (auto* input = DynamicTo<HTMLInputElement>(element);
+      input && IsCardSecretInput(*input)) {
+    states.push_back("secret");
+  }
+  return states;
+}
+
+// Mojo rejects a null WTF::String in a non-nullable string field
+// (RESULT_CODE_KILLED_BAD_MESSAGE), and both String() and several AX getters
+// produce null strings, so every wire value goes through here.
+String NonNull(const String& s) {
+  return s.IsNull() ? String("") : s;
+}
+
+// Next ancestor element, crossing shadow boundaries into the shadow host.
+Element* AncestorElement(Element* element) {
+  if (Element* parent = element->parentElement()) {
+    return parent;
+  }
+  return element->OwnerShadowHost();
+}
+
+// Local-root CSS-pixel border-box, captured before the AX cache is frozen.
+struct ElementBox {
+  double x = 0;
+  double y = 0;
+  double width = 0;
+  double height = 0;
+};
+
+// What the dedup pass needs to know about each emitted element.
+struct KeptElement {
+  DISALLOW_NEW();
+
+ public:
+  void Trace(Visitor* visitor) const { visitor->Trace(element); }
+
+  Member<Element> element;
+  ElementBox box;
+  InteractiveReason reason = InteractiveReason::kNone;
+  // Whether the accessibility tree named it, as opposed to a name taken from
+  // its text on the way out.
+  bool has_accessible_name = false;
+};
+
+// The share of the viewport's width, or height, a box spans to count as
+// spanning all of it.
+constexpr double kPageSizedShare = 0.9;
+
+// Whether a box covers (nearly) the whole viewport: a page or app root, which
+// is where a framework hangs its delegated listeners. React 17+ registers every
+// event it handles on its root, drag and drop among them, so without this the
+// whole app would be one drop target and one clickable ancestor, and every
+// unnamed icon inside it would be pruned as that ancestor's decoration.
+bool IsPageSized(const ElementBox& box,
+                 double viewport_width,
+                 double viewport_height) {
+  return viewport_width > 0 && viewport_height > 0 &&
+         box.width >= viewport_width * kPageSizedShare &&
+         box.height >= viewport_height * kPageSizedShare;
+}
+
+// A candidate from the geometry pass.
+struct Candidate {
+  DISALLOW_NEW();
+
+ public:
+  void Trace(Visitor* visitor) const { visitor->Trace(element); }
+
+  Member<Element> element;
+  ElementBox box;
+  bool in_frame_viewport = false;
+  // browser: scrolled out of a box that holds it, whatever the window shows.
+  bool clipped_out = false;
+};
+
+struct Collected {
+  STACK_ALLOCATED();
+
+ public:
+  Vector<mojom::blink::AgentElementPtr> elements;
+  HeapVector<KeptElement> kept;
+  // browser: the live regions' roots pass 1 met, read after the
+  // listing; and the DOMNodeIds, made for them, of the elements the
+  // off-screen filter left out under AgentOffscreenMode.kNone.
+  HeapVector<Member<Element>> region_roots;
+  Vector<int32_t> offscreen_ids;
+};
