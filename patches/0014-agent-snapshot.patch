+constexpr wtf_size_t kNodeBudget = 50000;
+constexpr base::TimeDelta kTick = base::Milliseconds(50);
+constexpr base::TimeDelta kLease = base::Seconds(10);
+constexpr base::TimeDelta kGateRate = base::Milliseconds(100);
+constexpr base::TimeDelta kForcedRecompute = base::Milliseconds(300);
+constexpr base::TimeDelta kPausedAfter = base::Milliseconds(200);
