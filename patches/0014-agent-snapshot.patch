+// browser: a commit forced for a capture (agent-snapshot).
+int WebFrameWidgetImpl::ForceCommitForCopy(
+    base::OnceCallback<void(bool)> presented) {
+  if (!View()->does_composite()) {
+    return -1;
+  }
+  cc::LayerTreeHost* host = widget_base_->LayerTreeHost();
+  if (!host || host->IsRenderingPaused()) {
+    return -1;
+  }
+  const int before = host->SourceFrameNumber();
+  // Asked before the commit's main frame, so the presentation is this
+  // commit's.
+  host->RequestPresentationTimeForNextFrame(blink::BindOnce(
+      [](base::OnceCallback<void(bool)> presented,
+         const gfx::PresentationFeedback& feedback) {
+        std::move(presented).Run(!feedback.failed());
+      },
+      std::move(presented)));
+  host->SetNeedsCommitWithForcedRedraw();
+  return before;
+}
+
+int WebFrameWidgetImpl::CommitSourceFrameNumber() const {
+  const cc::LayerTreeHost* host = widget_base_->LayerTreeHost();
+  return host ? host->SourceFrameNumber() : std::numeric_limits<int>::min();
+}
+
+bool WebFrameWidgetImpl::CompositorScrollAnimating() const {
+  const cc::LayerTreeHost* host = widget_base_->LayerTreeHost();
+  // A plain read of cc's scroll animation state, despite its name.
+  return host && host->HasCompositorDrivenScrollAnimationForTesting();
+}
 
