+
+// splitmix64's finalizer over the two values: order-sensitive, no state.
+uint64_t Mix(uint64_t h, uint64_t v) {
+  uint64_t x = h ^ (v + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2));
+  x ^= x >> 30;
+  x *= 0xbf58476d1ce4e5b9ULL;
+  x ^= x >> 27;
+  x *= 0x94d049bb133111ebULL;
+  x ^= x >> 31;
+  return x;
+}
+
+uint64_t Key(const void* pointer) {
+  return static_cast<uint64_t>(reinterpret_cast<uintptr_t>(pointer));
+}
+
+// An attribute's value, by the hash it already has (atomic strings keep one).
+uint64_t MixAtom(uint64_t h, const AtomicString& value) {
+  if (value.IsNull()) {
+    return Mix(h, 1);
+  }
+  if (value.empty()) {
+    return Mix(h, 2);
+  }
+  return Mix(h, (static_cast<uint64_t>(value.Hash()) << 32) | value.length());
+}
+
+// A string's first `max_chars` characters and its length, folded (FNV-1a);
+// nothing of it is kept.
+uint64_t MixText(uint64_t h, const String& text, wtf_size_t max_chars) {
+  if (text.IsNull()) {
+    return Mix(h, 3);
+  }
+  uint64_t f = 0xcbf29ce484222325ULL;
+  const wtf_size_t n = std::min(text.length(), max_chars);
+  for (wtf_size_t i = 0; i < n; ++i) {
+    f = (f ^ text[i]) * 0x100000001b3ULL;
+  }
+  return Mix(Mix(h, f), text.length());
+}
+
+uint64_t MixOffset(uint64_t h, const ScrollOffset& offset) {
+  const auto quantize = [](float v) -> uint64_t {
+    if (!std::isfinite(v)) {
+      return 0;
+    }
+    return static_cast<uint64_t>(
+        static_cast<int64_t>(std::round(std::clamp<double>(v, -1e9, 1e9) * 4)));
+  };
+  return Mix(Mix(h, quantize(offset.x())), quantize(offset.y()));
+}
+
+// A box edge rounded to 4 CSS px.
+uint64_t Round4(float v) {
+  if (!std::isfinite(v)) {
+    return 0;
+  }
+  return static_cast<uint64_t>(
+      static_cast<int64_t>(std::round(std::clamp<double>(v, -1e9, 1e9) / 4)));
+}
+
+// Whitespace of any kind, Unicode's included (as the collector's IsAnySpace).
+bool IsAnySpace(UChar c) {
+  return IsAsciiSpace(c) || c == 0x0085 || c == 0x00A0 || c == 0x1680 ||
+         (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 ||
+         c == 0x202F || c == 0x205F || c == 0x3000;
+}
+
+// One character as `until.text` compares it: case folded, every space one.
+UChar Fold(UChar c) {
+  if (IsAnySpace(c)) {
+    return ' ';
+  }
+  if (c < 0x80) {
+    return ToAsciiLower(c);
+  }
+  if (c >= 0xD800 && c <= 0xDFFF) {
+    return c;
+  }
+  const UChar32 folded = unicode::FoldCase(static_cast<UChar32>(c));
+  return folded >= 0 && folded <= 0xFFFF ? static_cast<UChar>(folded) : c;
+}
+
+// browser: whether a selector's or an XPath's first match in a
+// document -- `first`, null for none -- is as `state` asks: attached, it
+// exists (a text or attribute node an XPath selects too); box, an element
+// with a box of positive size; visible, that and visibility visible (not
+// hidden or collapse) and its own opacity above 0; hidden, not visible.
+bool UntilHolds(const Node* first, mojom::blink::AgentUntilState state) {
+  using State = mojom::blink::AgentUntilState;
+  if (state == State::kAttached) {
+    return first;
+  }
+  const auto* element = DynamicTo<Element>(first);
+  const LayoutObject* layout = element ? element->GetLayoutObject() : nullptr;
+  bool box = false;
+  if (layout) {
+    const gfx::RectF rect = element->GetBoundingClientRectNoLifecycleUpdate();
+    box = rect.width() > 0 && rect.height() > 0;
+  }
+  if (state == State::kBox) {
+    return box;
+  }
+  const bool visible =
+      box && layout->StyleRef().Visibility() == EVisibility::kVisible &&
+      layout->StyleRef().Opacity() > 0;
+  return state == State::kHidden ? !visible : visible;
+}
+
+// Every live same-process frame of `root`'s local frame tree, root first, in
+// tree order, with its document and view.
+template <typename Fn>
+void ForEachFrame(LocalFrame& root, Fn&& fn) {
+  for (Frame* frame = &root; frame; frame = frame->Tree().TraverseNext(&root)) {
+    auto* local = DynamicTo<LocalFrame>(frame);
+    if (!local || &local->LocalFrameRoot() != &root) {
+      continue;
+    }
+    Document* document = local->GetDocument();
+    LocalFrameView* view = local->View();
+    if (!document || !view || !document->IsActive()) {
+      continue;
+    }
+    fn(*local, *document, *view);
+  }
+}
+
+// Whether the page does not draw `root`: a frame in another process whose
+// frame element is not rendered (display: none, or inside a frame that is
+// not) has its widget hidden, and no lifecycle ever runs in it. Like a
+// throttled view, nothing of it is in view (hidden ad-sync frames
+// read "rendering paused", and the tab "drew nothing" though the page had
+// settled). Never the page's main frame: a hidden tab is paused.
+bool Undrawn(LocalFrame& root) {
+  if (root.IsOutermostMainFrame()) {
+    return false;
+  }
+  const auto* widget =
+      static_cast<WebFrameWidgetImpl*>(root.GetWidgetForLocalRoot());
+  return widget && widget->IsHidden();
+}
+
+// Calls `visit(node)` for every rendered node of the document's walk (a text
+// node or an element with a LayoutObject) until it returns false. A subtree
+// whose root has no LayoutObject (and is not display: contents) is left out,
+// and so are the contents of a locked display lock (content-visibility):
+// nothing there is rendered, and their layout may be stale. Returns false when
+// `nodes` passed the budget. `contents(element)` is called for
+// each display: contents element the walk goes through (no LayoutObject of
+// its own, so `visit` never sees it).
+template <typename Visit, typename Contents>
+bool WalkRendered(Document& document,
+                  wtf_size_t& nodes,
+                  Visit&& visit,
+                  Contents&& contents) {
+  Node* node = document.documentElement();
+  while (node) {
+    if (++nodes > kNodeBudget) {
+      return false;
+    }
+    bool skip = false;
+    bool rendered = false;
+    if (auto* element = DynamicTo<Element>(node)) {
+      if (!element->GetLayoutObject()) {
+        skip = !element->HasDisplayContentsStyle();
+        if (!skip) {
+          contents(*element);
+        }
+      } else {
+        rendered = true;
+        const DisplayLockContext* lock = element->GetDisplayLockContext();
+        skip = lock && lock->IsLocked();
+      }
+    } else {
+      rendered = node->IsTextNode() && node->GetLayoutObject();
+    }
+    if (rendered && !visit(*node)) {
+      return true;
+    }
+    node = agent_live_regions::NextInWalk(*node, nullptr, skip);
+  }
+  return true;
+}
+
+template <typename Visit>
+bool WalkRendered(Document& document, wtf_size_t& nodes, Visit&& visit) {
+  return WalkRendered(document, nodes, std::forward<Visit>(visit),
+                      [](Element&) {});
+}
+
+// The collector's IsInteractiveRole list, as role attribute tokens.
+bool HasInteractiveRole(const Element& element) {
+  static constexpr const char* kRoles[] = {
+      "button",        "link",         "textbox",   "checkbox",
+      "radio",         "combobox",     "menuitem",  "menuitemcheckbox",
+      "menuitemradio", "tab",          "switch",    "slider",
+      "searchbox",     "spinbutton",   "option",    "listbox",
+      "menu",          "radiogroup",   "scrollbar", "treeitem",
+      "gridcell",      "columnheader", "rowheader"};
+  const AtomicString& role = element.FastGetAttribute(html_names::kRoleAttr);
+  if (role.empty()) {
+    return false;
+  }
+  const wtf_size_t space = role.find(static_cast<UChar>(' '));
+  const StringView first(role, 0, space == kNotFound ? role.length() : space);
+  for (const char* candidate : kRoles) {
+    if (EqualIgnoringAsciiCase(first, StringView(candidate))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool RoleIsButtonOrLink(const Element& element) {
+  const AtomicString& role = element.FastGetAttribute(html_names::kRoleAttr);
+  return EqualIgnoringAsciiCase(role, "button") ||
+         EqualIgnoringAsciiCase(role, "link");
+}
+
+// The collector's HasClickListener.
+bool HasClickListener(Element& element) {
+  return element.HasEventListeners(event_type_names::kClick) ||
+         element.HasEventListeners(event_type_names::kMousedown) ||
+         element.HasEventListeners(event_type_names::kMouseup) ||
+         element.HasEventListeners(event_type_names::kKeydown) ||
+         element.HasEventListeners(event_type_names::kPointerdown);
+}
+
+// A contenteditable region's root, by its attribute: IsRootEditableElement
+// walks every ancestor, too dear for every element of every pass.
+bool IsEditingHostByAttribute(const Element& element) {
+  if (element.IsFormControlElement() ||
+      !element.FastHasAttribute(html_names::kContenteditableAttr)) {
+    return false;
+  }
+  return !EqualIgnoringAsciiCase(
+      element.FastGetAttribute(html_names::kContenteditableAttr), "false");
+}
+
+// The collector's interactive test without accessibility: a form
+// control, a link, a summary, an editing host, an interactive role attribute,
+// a non-negative tabIndex, a click listener, draggable or a dragstart
+// listener, or a pointer cursor its parent does not have; then visible, not
+// inert, and taking pointer events (a form control may not).
+bool IsCandidate(Element& element, const LayoutObject& layout) {
+  bool interactive =
+      element.IsFormControlElement() || element.IsLink() ||
+      IsA<HTMLSummaryElement>(element) || IsEditingHostByAttribute(element) ||
+      HasInteractiveRole(element) || HasClickListener(element) ||
+      EqualIgnoringAsciiCase(
+          element.FastGetAttribute(html_names::kDraggableAttr), "true") ||
+      element.HasEventListeners(event_type_names::kDragstart) ||
+      element.tabIndex() >= 0;
+  const ComputedStyle& style = layout.StyleRef();
+  if (!interactive && style.Cursor() == ECursor::kPointer) {
+    const Element* parent = element.ParentOrShadowHostElement();
+    const ComputedStyle* parent_style =
+        parent ? parent->GetComputedStyle() : nullptr;
+    interactive = !parent_style || parent_style->Cursor() != ECursor::kPointer;
+  }
+  if (!interactive) {
+    return false;
+  }
+  if (style.Visibility() != EVisibility::kVisible || style.IsInert()) {
+    return false;
+  }
+  return style.UsedPointerEvents() != EPointerEvents::kNone ||
+         element.IsFormControlElement();
+}
+
+// A frame-local box against the frame's viewport, in CSS px (what innerWidth
+// would say, without the layout innerWidth may force).
+bool InView(const gfx::RectF& rect, double width, double height) {
+  return rect.x() < width && rect.right() > 0 && rect.y() < height &&
+         rect.bottom() > 0;
+}
+
+void ViewportOf(LocalFrame& frame,
+                LocalFrameView& view,
+                double& width,
+                double& height) {
+  const float zoom =
+      frame.LayoutZoomFactor() > 0 ? frame.LayoutZoomFactor() : 1;
+  width = view.Size().width() / zoom;
+  height = view.Size().height() / zoom;
+}
+
+// Style of `document` waiting for a lifecycle: what Document::
+// CalculateStyleAndLayoutTreeUpdate tests, but the animation timing. That test
+// (NeedsAnimationTimingUpdate, never called here) is true between
+// frames whenever an animation runs, and a composited fade or a spinner draws
+// no main frame: a visible tab read as paused.
+bool StyleDirty(const Document& document) {
+  const StyleEngine& engine = document.GetStyleEngine();
+  return engine.NeedsFullStyleUpdate() || engine.NeedsStyleRecalc() ||
+         engine.NeedsStyleInvalidation() || document.NeedsStyleInvalidation() ||
+         document.IsSlotAssignmentDirty();
+}
+
+// Whether an animation on the element never ends (a spinner, a shimmer): its
+// box is then left out of the hash. Read from the effect's specified timing,
+// without the play state, whose reading may advance the animation clock.
+bool HasInfiniteAnimation(const Element& element) {
+  ElementAnimations* animations = element.GetElementAnimations();
+  if (!animations) {
+    return false;
+  }
+  for (const auto& entry : animations->Animations()) {
+    const Animation* animation = entry.key.Get();
+    const AnimationEffect* effect = animation ? animation->effect() : nullptr;
+    if (effect && std::isinf(effect->SpecifiedTiming().iteration_count)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// A button's or link's text: the first 64 text nodes or 256 characters of its
+// light subtree, folded.
+uint64_t MixSubtreeText(uint64_t h, const Element& element) {
+  uint64_t f = 0xcbf29ce484222325ULL;
+  wtf_size_t chars = 0;
+  wtf_size_t texts = 0;
+  wtf_size_t visits = 0;
+  for (Node* node = NodeTraversal::Next(element, &element);
+       node && visits < kButtonTextVisits;
+       node = NodeTraversal::Next(*node, &element)) {
+    ++visits;
+    auto* text = DynamicTo<Text>(node);
+    if (!text) {
+      continue;
+    }
+    const String& data = text->data();
+    for (wtf_size_t i = 0; i < data.length() && chars < kButtonTextChars;
+         ++i, ++chars) {
+      f = (f ^ data[i]) * 0x100000001b3ULL;
+    }
+    if (++texts >= kButtonTextNodes || chars >= kButtonTextChars) {
+      break;
+    }
+  }
+  return Mix(h, f);
+}
+
+// What the agent reads of one in-view candidate, as 64 bits: its
+// name proxy (aria-label, title, alt, placeholder, a hash of its value -- never
+// the value -- and a button's or link's text), its states, and its box rounded
+// to 4 px unless an infinite animation runs on it.
+uint64_t HashCandidate(Element& element, const gfx::RectF& rect) {
+  uint64_t h = kSeed;
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaLabelAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kTitleAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAltAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kPlaceholderAttr));
+  uint64_t states = 0;
+  if (auto* input = DynamicTo<HTMLInputElement>(element)) {
+    h = MixText(h, input->Value(), kValueChars);
+    states |= input->Checked() ? 1 : 0;
+  } else if (auto* textarea = DynamicTo<HTMLTextAreaElement>(element)) {
+    h = MixText(h, textarea->Value(), kValueChars);
+  } else if (auto* select = DynamicTo<HTMLSelectElement>(element)) {
+    if (select->IsMultiple()) {
+      uint64_t index = 0;
+      for (auto& option : select->GetOptionList()) {
+        if (index >= 256) {
+          break;
+        }
+        if (option.Selected()) {
+          h = Mix(h, index + 7);
+        }
+        ++index;
+      }
+    } else {
+      h = Mix(h, static_cast<uint64_t>(select->selectedIndex() + 7));
+    }
+  } else if (auto* option = DynamicTo<HTMLOptionElement>(element)) {
+    states |= option->Selected() ? 2 : 0;
+  }
+  if (IsA<HTMLButtonElement>(element) || element.IsLink() ||
+      RoleIsButtonOrLink(element)) {
+    h = MixSubtreeText(h, element);
+  }
+  // A native control's own test; for anything else the attribute
+  // (HTMLElement::IsDisabledFormControl makes a form-associated custom
+  // element's ElementInternals).
+  const bool disabled =
+      element.IsFormControlElement()
+          ? element.IsDisabledFormControl()
+          : element.FastHasAttribute(html_names::kDisabledAttr);
+  states |= disabled ? 4 : 0;
+  states |= element.IsFocusedElementInDocument() ? 8 : 0;
+  states |= element.FastHasAttribute(html_names::kReadonlyAttr) ? 16 : 0;
+  states |= element.FastHasAttribute(html_names::kRequiredAttr) ? 32 : 0;
+  // browser: invalid by its own constraints, from the control's validity
+  // (cached, recomputed once dirty); with aria-invalid below, a validity flip
+  // holds the quiet window.
+  if (ListedElement* control = ListedElement::From(element)) {
+    states |= control->IsNotCandidateOrValid() ? 0 : 64;
+  }
+  h = Mix(h, states);
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaInvalidAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaRequiredAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaReadonlyAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaDisabledAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaSelectedAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaExpandedAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaCheckedAttr));
+  h = MixAtom(h, element.FastGetAttribute(html_names::kAriaPressedAttr));
+  if (!HasInfiniteAnimation(element)) {
+    h = Mix(h, Round4(rect.x()));
+    h = Mix(h, Round4(rect.y()));
+    h = Mix(h, Round4(rect.width()));
+    h = Mix(h, Round4(rect.height()));
+  }
+  return h;
+}
+
+// tag#id.class, for a name the browser falls back on.
+String Describe(const Element& element) {
+  StringBuilder name;
+  name.Append(element.localName());
+  const AtomicString& id = element.GetIdAttribute();
+  if (!id.empty()) {
+    name.Append("#");
+    name.Append(id);
+  }
+  const AtomicString& klass = element.FastGetAttribute(html_names::kClassAttr);
+  wtf_size_t start = 0;
+  while (start < klass.length() && IsAsciiSpace(klass[start])) {
+    ++start;
+  }
+  wtf_size_t end = start;
+  while (end < klass.length() && !IsAsciiSpace(klass[end])) {
+    ++end;
+  }
+  if (end > start) {
+    name.Append(".");
+    name.Append(StringView(klass, start, end - start));
+  }
+  const String result = name.ToString();
+  return result.length() > 80 ? result.substr(0, 80) : result;
+}
+
+// A load nobody waits on: the platform's own test, which StartLoad
+// also counts loads by.
+bool Uncounted(const Resource& resource) {
+  return !ResourceFetcher::IsSettleCountedLoad(resource);
+}
+
+// A request's path without its query, with its host when that is not the
+// document's.
+String RequestName(const Resource& resource, const Document& document) {
+  const KURL& url = resource.Url();
+  if (url.ProtocolIsData()) {
+    return "a data: URL";
+  }
+  StringBuilder name;
+  const StringView host = url.Host();
+  if (!(host == document.Url().Host())) {
+    name.Append(host);
+  }
+  const StringView path = url.GetPath();
+  name.Append(path.empty() ? StringView("/") : path);
+  const String result = name.ToString();
+  return result.length() > 120 ? result.substr(0, 120) : result;
+}
+
+// How long a running finite animation has left, from its specified timing and
+// current time, at its playback rate.
+double SecondsLeft(const Animation& animation, const Timing& timing) {
+  const std::optional<AnimationTimeDelta> current =
+      animation.CurrentTimeInternal();
+  if (!current) {
+    return 0;
+  }
+  const double duration =
+      timing.iteration_duration ? timing.iteration_duration->InSecondsF() : 0;
+  const double end = timing.start_delay.AsTimeValue().InSecondsF() +
+                     duration * timing.iteration_count +
+                     timing.end_delay.AsTimeValue().InSecondsF();
+  const double rate = animation.playbackRate();
+  if (rate > 0) {
+    return std::max(0.0, (end - current->InSecondsF()) / rate);
+  }
+  if (rate < 0) {
+    return std::max(0.0, current->InSecondsF() / -rate);
+  }
+  return std::numeric_limits<double>::infinity();
+}
+
+Element* AnimationTarget(const Animation& animation) {
+  const auto* effect = DynamicTo<KeyframeEffect>(animation.effect());
+  return effect ? effect->target() : nullptr;
+}
+
+// "animation fade on div#toast (0.4s left)", "transition opacity on ...".
+// `left`: as of now (infinite: no time); `blocks`: whether it was waited
+// for, by its time left when it was read.
+String DescribeAnimation(const Animation& animation, double left, bool blocks) {
+  StringBuilder what;
+  if (const auto* css = DynamicTo<CSSAnimation>(animation)) {
+    what.Append("animation ");
+    what.Append(css->animationName());
+  } else if (const auto* transition = DynamicTo<CSSTransition>(animation)) {
+    what.Append("transition ");
+    what.Append(transition->transitionProperty());
+  } else {
+    what.Append("animation");
+    if (!animation.id().empty()) {
+      what.Append(" ");
+      what.Append(animation.id());
+    }
+  }
+  if (const Element* target = AnimationTarget(animation)) {
+    what.Append(" on ");
+    what.Append(Describe(*target));
+  }
+  if (std::isfinite(left)) {
+    what.Append(" (");
+    what.AppendNumber(std::round(left * 10) / 10, 6);
+    what.Append(blocks ? "s left)" : "s left, not waited for)");
+  }
+  return what.ToString();
+}
+
+// An animation's time left as of `now`, from its reading at `read_at`: a
+// composited one draws no frame after its first, so no later reading comes.
+double LeftAt(double left, base::TimeTicks read_at, base::TimeTicks now) {
+  if (!std::isfinite(left) || read_at.is_null()) {
+    return left;
+  }
+  return std::max(0.0, left - (now - read_at).InSecondsF());
+}
+
+String NavigationWhat(uint8_t flags) {
+  if (flags & kNavProvisional) {
+    return "navigation pending";
+  }
+  if (flags & kNavForm) {
+    return "form submission pending";
+  }
+  if (flags & kNavSameDocument) {
+    return "same-document navigation pending";
+  }
+  if (flags & kNavRefresh) {
+    return "refresh scheduled";
+  }
+  return "navigation pending in a frame";
+}
+
+String NonNull(const String& value) {
+  return value.IsNull() ? g_empty_string : value;
+}
+
+// Matches `until.text` as a stream: case folded, spaces collapsed, across
+// text nodes (Knuth-Morris-Pratt over the folded needle).
+class TextMatcher {
+  STACK_ALLOCATED();
+
+ public:
+  TextMatcher(const Vector<UChar>& needle, const Vector<wtf_size_t>& fail)
+      : needle_(needle), fail_(fail), found_(needle.empty()) {}
+
+  // Reads at most `room` characters; returns how many it read.
+  wtf_size_t Feed(const String& text, wtf_size_t room) {
+    const wtf_size_t n = std::min(text.length(), room);
+    for (wtf_size_t i = 0; i < n && !found_; ++i) {
+      Push(Fold(text[i]));
+    }
+    return n;
+  }
+  // A boundary between blocks reads as a space.
+  void Break() { Push(' '); }
+  void Reset() {
+    state_ = 0;
+    last_space_ = true;
+  }
+  bool found() const { return found_; }
+
+ private:
+  void Push(UChar c) {
+    if (found_) {
+      return;
+    }
+    if (c == ' ') {
+      if (last_space_) {
+        return;
+      }
+      last_space_ = true;
+    } else {
+      last_space_ = false;
+    }
+    while (state_ > 0 && needle_[state_] != c) {
+      state_ = fail_[state_ - 1];
+    }
+    if (needle_[state_] == c) {
+      ++state_;
+    }
+    if (state_ == needle_.size()) {
+      found_ = true;
+    }
+  }
+
+  const Vector<UChar>& needle_;
+  const Vector<wtf_size_t>& fail_;
+  wtf_size_t state_ = 0;
+  bool last_space_ = true;
+  bool found_;
+};
+
+}  // namespace
+
+AgentSettleWatcher::AgentSettleWatcher(Document& local_root_document)
+    : document_(&local_root_document),
+      timer_(
+          local_root_document.GetTaskRunner(TaskType::kInternalUserInteraction),
+          this,
+          &AgentSettleWatcher::OnTimer) {}
+
+void AgentSettleWatcher::Trace(Visitor* visitor) const {
+  visitor->Trace(document_);
+  visitor->Trace(view_);
+  visitor->Trace(timer_);
+  visitor->Trace(animation_a_);
+  visitor->Trace(animation_b_);
+  LocalFrameView::LifecycleNotificationObserver::Trace(visitor);
+}
+
+LocalFrame* AgentSettleWatcher::Root() const {
+  Document* document = document_.Get();
+  LocalFrame* frame = document ? document->GetFrame() : nullptr;
+  if (!frame || !frame->View() || !document->IsActive()) {
+    return nullptr;
+  }
+  return frame;
+}
+
+// ------------------------------------------------------------------ the calls
+
+void AgentSettleWatcher::Arm(int64_t arm_id, base::TimeTicks t, bool look) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // A call still waiting on the arm this one replaces answers as things are.
+  Answer(now);
+  // browser: what the regions say from here is this arm's. The browser
+  // re-arms with the same id (after DisarmSettle, a closed pipe or the lease):
+  // that arm's entries, their numbers and the texts already seen carry on, so
+  // only an Arm for a new action clears them. A look (Page.agentSettle with
+  // no armId) is not one: it keeps them and their arm id and owes no
+  // baseline, so what the last action heard is still there for the capture
+  // after it -- unless nothing armed this watcher before (heard_arm_id_ 0),
+  // when it takes the baseline, so regions already speaking are not heard.
+  // An action's Arm carries on the newest 8 entries heard in the last
+  // kCarryFor, under their own keys, marked as heard before it: what a watch
+  // heard while it still looked, after the agent's last read (a quick next
+  // press's approach, an earlier step of the same call, a read that never
+  // reached the agent), is still told, and what was told is known by its
+  // key. heard_ is in the order heard, so they are its end. This arm's own
+  // limits, and the ceiling, count from after them.
+  if (arm_id != heard_arm_id_ && (!look || heard_arm_id_ == 0)) {
+    // browser: the last watch's last read, under its own arm, so a toast
+    // laid out since its last pass is carried on below rather than going into
+    // this arm's baseline as said before it; a paused watch's too, as a
+    // closing pass.
+    ReadRegionsLast(/*at_arm=*/true);
+    wtf_size_t from = 0;
+    while (from < heard_.size() && now - heard_[from].heard_at > kCarryFor) {
+      ++from;
+    }
+    if (heard_.size() - from > kMaxHeard) {
+      from = heard_.size() - kMaxHeard;
+    }
+    heard_.EraseAt(0, from);
+    for (HeardEntry& entry : heard_) {
+      entry.before_action = true;
+    }
+    heard_arm_id_ = arm_id;
+    region_said_.clear();
+    log_text_.clear();
+    // browser: an action's own span begins (a look opens none). The
+    // closing pass above was the last span's.
+    if (!look) {
+      span_arm_id_ = arm_id;
+      action_armed_at_ = now;
+      report_read_ = false;
+      reads_in_flight_ = 0;
+    }
+    regions_baseline_ = true;
+    heard_since_ = heard_.size();
+    heard_carried_ = heard_.size();
+  }
+  // The limits count this arm's entries, an action's or a look's: a waiting
+  // agent's looks each hear their 8. A re-arm with the current id (arm_id_,
+  // which only Arm sets) carries on.
+  if (arm_id != arm_id_) {
+    heard_since_ = heard_.size();
+  }
+  regions_content_ = 0;
+  LocalFrame* root = Root();
+  if (!root) {
+    Stop();
+    return;
+  }
+  Start(*root->View());
+  armed_ = true;
+  // browser: a progress read's hold is its own arm's.
+  if (arm_id != arm_id_) {
+    kept_looking_at_ = base::TimeTicks();
+  }
+  arm_id_ = arm_id;
+  // T is the browser's TimeTicks of the action, before this message could
+  // arrive; never later than now.
+  t_ = t.is_null() || t > now ? now : t;
+  arm_received_ = now;
+  last_contact_ = now;
+  Sample(SampleKind::kArm);
+  ScheduleTick(now);
+}
+
+void AgentSettleWatcher::Register(LocalFrameView& view) {
+  if (view_.Get() != &view) {
+    if (LocalFrameView* old = view_.Get()) {
+      old->UnregisterFromLifecycleNotifications(this);
+    }
+    view_ = &view;
+  }
+  // A set: registering again (after Pause) is harmless.
+  view.RegisterForLifecycleNotifications(this);
+  watching_ = true;
+}
+
+// No call waiting and the action long past: nothing is read until a call
+// comes but the regions, for which it stays registered (IdleRegions), from
+// the page's next frame. Still armed, for that call. What it has not read of
+// the regions yet is read first (ReadRegionsLast).
+void AgentSettleWatcher::Pause() {
+  ReadRegionsLast();
+  timer_.Stop();
+  watching_ = false;
+  idle_read_at_ = base::TimeTicks::Now();
+  idle_content_ = 0;
+}
+
+// A call after Pause. What changed while nothing looked is not known: a fresh
+// baseline, a quiet window from now, and a deadline of quiet + 100 ms
+// (Deadline, Anchor).
+void AgentSettleWatcher::Resume(LocalFrameView& view, base::TimeTicks now) {
+  Register(view);
+  rebaseline_ = true;
+  resumed_at_ = now;
+  sig_valid_ = false;
+  sig_at_ = base::TimeTicks();
+  gate_changed_at_ = base::TimeTicks();
+  stamp_moved_at_ = base::TimeTicks();
+  base_changed_at_ = base::TimeTicks();
+  entries_.Shrink(0);
+  next_entries_.Shrink(0);
+  counted_.Shrink(0);
+  counted_names_.Shrink(0);
+  // browser: heard_ and region_said_ stay: a region that changed while
+  // nothing looked, and still says so, is heard at the next read.
+  last_frame_at_ = base::TimeTicks();
+  last_sample_at_ = base::TimeTicks();
+  lifecycle_started_at_ = base::TimeTicks();
+  dirty_since_ = base::TimeTicks();
+  lifecycle_pending_ = false;
+  rendering_paused_ = false;
+  blocking_animations_ = 0;
+  animation_a_ = nullptr;
+  animation_b_ = nullptr;
+}
+
+void AgentSettleWatcher::Await(int64_t arm_id,
+                               int32_t quiet_ms,
+                               int32_t cap_ms,
+                               mojom::blink::AgentUntilPtr until,
+                               AwaitCallback callback) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // A paused watch has no timer to end it: its lease is judged here.
+  if (armed_ && !watching_ && now - last_contact_ >= kLease) {
+    Stop();
+  }
+  if (!armed_ || arm_id != arm_id_ || !Root()) {
+    // Not this renderer's current arm (never armed, superseded, ended by its
+    // lease or a navigation): answered at once, never settled.
+    const char* why = !armed_             ? "not armed"
+                      : arm_id != arm_id_ ? "not the current arm"
+                                          : "the document is gone";
+    auto reading = mojom::blink::AgentSettleReading::New();
+    reading->changing.push_back(
+        mojom::blink::AgentChanging::New("lifecycle", why, 0, false));
+    std::move(callback).Run(std::move(reading));
+    return;
+  }
+  // A call already waiting answers first.
+  Answer(now);
+  callback_ = std::move(callback);
+  await_received_ = now;
+  last_contact_ = now;
+  // browser: the call holds the watch now; the action's hold is over.
+  kept_looking_at_ = base::TimeTicks();
+  quiet_ = base::Milliseconds(std::clamp(quiet_ms, 0, 5000));
+  cap_ = base::Milliseconds(std::clamp(cap_ms, 0, kMaxCapMs));
+  SetUntil(until);
+  until_limit_ = now + kUntilLimit;
+  if (!watching_) {
+    Resume(*Root()->View(), now);
+  }
+  Sample(SampleKind::kAwait);
+  ScheduleTick(now);
+}
+
+void AgentSettleWatcher::KeepLooking() {
+  if (armed_ && watching_) {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    kept_looking_at_ = now;
+    last_contact_ = now;
+  }
+}
+
+void AgentSettleWatcher::Disarm(int64_t arm_id) {
+  if (armed_ && arm_id == arm_id_) {
+    // browser: the regions' last read first (ReadRegionsLast; none once
+    // the watch has paused).
+    ReadRegionsLast();
+    Stop();
+  }
+}
+
+// ------------------------------------------------------------- the lifecycle
+
+void AgentSettleWatcher::WillStartLifecycleUpdate(const LocalFrameView& view) {
+  if (armed_ && watching_ && &view == view_.Get()) {
+    lifecycle_started_at_ = base::TimeTicks::Now();
+  }
+}
+
+// Right after a frame's lifecycle (paint and push done, the animation clock
+// held at the frame's time, nothing may be invalidated): the primary sample.
+void AgentSettleWatcher::DidFinishPostLifecycleSteps(
+    const LocalFrameView& view) {
+  if (!armed_ || &view != view_.Get()) {
+    return;
+  }
+  // browser: paused, the regions alone.
+  if (!watching_) {
+    IdleRegions(base::TimeTicks::Now());
+    return;
+  }
+  Sample(SampleKind::kFrame);
+}
+
+void AgentSettleWatcher::Start(LocalFrameView& view) {
+  Register(view);
+  // Everything of the arm before, forgotten.
+  rebaseline_ = true;
+  resumed_at_ = base::TimeTicks();
+  base_content_ = 0;
+  base_changed_at_ = base::TimeTicks();
+  dirty_since_ = base::TimeTicks();
+  // browser: counted and stamped again from this arm.
+  shown_now_.reset();
+  shown_base_.reset();
+  shown_base_tried_ = false;
+  arm_content_.reset();
+  next_long_.Shrink(0);
+  sig_valid_ = false;
+  sig_ = 0;
+  sig_stamp_ = 0;
+  sig_at_ = base::TimeTicks();
+  last_stamp_ = 0;
+  gate_changed_at_ = base::TimeTicks();
+  stamp_moved_at_ = base::TimeTicks();
+  last_change_ = base::TimeTicks();
+  budget_exceeded_ = false;
+  entries_.Shrink(0);
+  next_entries_.Shrink(0);
+  entries_.reserve(256);
+  next_entries_.reserve(256);
+  change_what_ = String();
+  change_node_id_ = 0;
+  pending_what_ = String();
+  pending_node_id_ = 0;
+  loads_started_ = 0;
+  counted_.Shrink(0);
+  next_counted_.Shrink(0);
+  last_request_end_ = base::TimeTicks();
+  counted_names_.Shrink(0);
+  ended_request_what_ = String();
+  ended_request_meanwhile_ = false;
+  requests_ = RequestTally();
+  nav_flags_ = 0;
+  nav_cleared_at_ = base::TimeTicks();
+  nav_pending_at_arm_.Shrink(0);
+  blocking_animations_ = 0;
+  blocking_until_ = base::TimeTicks();
+  animations_ended_at_ = base::TimeTicks();
+  animations_read_at_ = base::TimeTicks();
+  animation_a_ = nullptr;
+  animation_b_ = nullptr;
+  animation_a_left_ = 0;
+  animation_b_left_ = 0;
+  lifecycle_pending_ = false;
+  rendering_paused_ = false;
+  settled_ = false;
+  last_frame_at_ = base::TimeTicks();
+  last_sample_at_ = base::TimeTicks();
+  lifecycle_started_at_ = base::TimeTicks();
+  await_received_ = base::TimeTicks();
+  ClearUntil();
+  // The last call's numbers are not this arm's: Pause measures from the cap.
+  quiet_ = kDefaultQuiet;
+  cap_ = kDefaultCap;
+}
+
+// A waiting call is answered, never dropped.
+void AgentSettleWatcher::Stop() {
+  Answer(base::TimeTicks::Now());
+  if (LocalFrameView* view = view_.Get()) {
+    view->UnregisterFromLifecycleNotifications(this);
+  }
+  view_ = nullptr;
+  timer_.Stop();
+  armed_ = false;
+  watching_ = false;
+  animation_a_ = nullptr;
+  animation_b_ = nullptr;
+  ClearUntil();
+  entries_.clear();
+  next_entries_.clear();
+  counted_.clear();
+  next_counted_.clear();
+  next_long_.clear();
+  counted_names_.clear();
+  nav_pending_at_arm_.clear();
+  // browser: heard_ and region_said_ stay: the collector reads heard_
+  // until an Arm for a new action, and a re-arm with this id carries on.
+}
+
+// The 50 ms timer, only while armed: a sample when no frame came in the last
+// 50 ms, `until`'s checks, the waiting call's deadline, and the watch's end.
+// HeapMojoReceiverSet does not say when a pipe closes, so the asking is the
+// lease: with no call waiting and none, nor an answer, for 10 s, the watch is
+// over. Paused, it runs only the regions' read a gap held back.
+void AgentSettleWatcher::OnTimer(TimerBase*) {
+  if (!armed_) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!watching_) {
+    IdleRegions(now);
+    return;
+  }
+  LocalFrame* root = Root();
+  if (!root || root->View() != view_.Get() ||
+      (!callback_ && now - last_contact_ >= kLease)) {
+    Stop();
+    return;
+  }
+  // With no call waiting, nothing is read longer than the action needs.
+  if (!callback_ && now > std::max(CapEnd(), last_contact_) + kIdleAfter) {
+    Pause();
+    return;
+  }
+  // No frame in the last 50 ms (and no sample just now, as at an early wake
+  // for a quiet window's end right after a timer sample).
+  if (now - last_frame_at_ >= kTick &&
+      now - last_sample_at_ >= base::Milliseconds(8)) {
+    Sample(SampleKind::kTimer);
+  } else if (callback_ && HasUntil() && !until_seen_) {
+    // Frames are coming, but `until` is checked outside them.
+    ScriptForbiddenScope forbid_script;
+    undrawn_ = Undrawn(*root);
+    bool dirty = false;
+    uint64_t content = 0;
+    const uint64_t stamp = ComputeStamp(*root, dirty, content);
+    MaybeCheckUntil(*root, now, stamp, dirty);
+    MaybeAnswer(now);
+  } else {
+    MaybeAnswer(now);
+  }
+  ScheduleTick(base::TimeTicks::Now());
+}
+
+void AgentSettleWatcher::ScheduleTick(base::TimeTicks now) {
+  if (!armed_ || !watching_) {
+    return;
+  }
+  base::TimeDelta delay = kTick;
+  if (callback_ && (!HasUntil() || until_seen_)) {
+    // Wake at the quiet window's end or the deadline when either is sooner.
+    for (const base::TimeTicks at : {Anchor() + quiet_, Deadline()}) {
+      if (at > now) {
+        delay = std::min(delay, at - now);
+      }
+    }
+  }
+  timer_.StartOneShot(std::max(delay, base::Milliseconds(1)), FROM_HERE);
+}
+
+// ---------------------------------------------------------------- the sample
+
+void AgentSettleWatcher::Sample(SampleKind kind) {
+  LocalFrame* root = Root();
+  if (!root) {
+    return;
+  }
+  // An assertion: nothing below runs script.
+  ScriptForbiddenScope forbid_script;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  undrawn_ = Undrawn(*root);
+
+  // 1. The stamp: cheap, and whether any readable frame awaits style or
+  // layout.
+  bool dirty = false;
+  uint64_t content = 0;
+  const uint64_t stamp = ComputeStamp(*root, dirty, content);
+  const bool baseline = rebaseline_;
+  rebaseline_ = false;
+  if (!baseline && stamp != last_stamp_) {
+    stamp_moved_at_ = now;
+  }
+  last_stamp_ = stamp;
+  if (sig_valid_ && stamp != sig_stamp_ && gate_changed_at_.is_null()) {
+    gate_changed_at_ = now;
+  }
+  // Before a first baseline can be read (the arm came while style or layout
+  // was pending), the content stamp notes when the page last changed: the
+  // quiet window runs from the latest change the first baseline holds.
+  if (baseline) {
+    base_content_ = content;
+    base_changed_at_ = base::TimeTicks();
+  } else if (!sig_valid_ && content != base_content_) {
+    base_content_ = content;
+    base_changed_at_ = now;
+  }
+  // browser: what domChanged compares.
+  if (!arm_content_) {
+    arm_content_ = content;
+  }
+  last_content_ = content;
+  // browser: the regions' baseline, in the arm's own sample whether or
+  // not style or layout is pending (BaselineRegions). Read clean, it stands
+  // for this content; read dirty, the first clean pass reads them again.
+  if (kind == SampleKind::kArm && regions_baseline_) {
+    BaselineRegions(*root);
+    if (!dirty) {
+      regions_content_ = content;
+    }
+  }
+
+  // The lifecycle: a frame proves rendering runs; style or layout pending for
+  // 200 ms with no frame in between means it does not.
+  if (kind == SampleKind::kFrame || !dirty) {
+    dirty_since_ = base::TimeTicks();
+  } else if (dirty_since_.is_null()) {
+    dirty_since_ = now;
+  }
+  if (kind == SampleKind::kFrame) {
+    last_frame_at_ = now;
+    lifecycle_pending_ = false;
+    rendering_paused_ = false;
+  } else {
+    lifecycle_pending_ = dirty;
+    rendering_paused_ = dirty && now - dirty_since_ >= kPausedAfter;
+  }
+
+  // 2. The requests.
+  RequestTally tally;
+  ClassifyRequests(*root, now, tally, baseline);
+  requests_ = tally;
+
+  // 3. The renderer's navigation flags.
+  const uint8_t nav = NavigationFlags(*root, kind == SampleKind::kArm);
+  if (nav_flags_ && !nav) {
+    nav_cleared_at_ = now;
+  }
+  nav_flags_ = nav;
+
+  // 4. Animations, on frames only: elsewhere their reading may advance the
+  // animation clock. A blocking one seen last frame stops blocking once its
+  // time is up, frames or not.
+  if (kind == SampleKind::kFrame) {
+    ReadAnimations(*root, now);
+  } else if (blocking_animations_ && now > blocking_until_ + kTick) {
+    blocking_animations_ = 0;
+    animations_ended_at_ = blocking_until_;
+  }
+
+  // 5. `until`, outside the frame's own steps.
+  if (kind != SampleKind::kFrame) {
+    MaybeCheckUntil(*root, now, stamp, dirty);
+  }
+
+  // 6. The signature, and the judgement. A frame that already ran long gets
+  // no gate pass -- unless the last one is 300 ms old: on a page whose every
+  // frame runs long (no timer samples come while frames do), the signature
+  // would otherwise never be read again. A confirming pass reads through one
+  // (Judge).
+  const bool long_frame = kind == SampleKind::kFrame &&
+                          !lifecycle_started_at_.is_null() &&
+                          now - lifecycle_started_at_ > kLongFrame &&
+                          now - sig_at_ < kForcedRecompute;
+  Judge(*root, now, stamp, content, dirty, long_frame);
+
+  last_sample_at_ = now;
+  MaybeAnswer(now);
+}
+
+uint64_t AgentSettleWatcher::ComputeStamp(LocalFrame& root,
+                                          bool& dirty,
+                                          uint64_t& content) const {
+  uint64_t stamp = kSeed;
+  content = kSeed;
+  dirty = false;
+  ForEachFrame(
+      root, [&](LocalFrame&, Document& document, LocalFrameView& view) {
+        // The content stamp is the DOM tree version and the focus only: a frame
+        // laying out an earlier change (or ticking an animation) moves the
+        // style version, the layout count and even the scroll offsets (a new
+        // scroller registering, scroll anchoring), not the page.
+        content = Mix(content, document.DomTreeVersion());
+        content = Mix(content, Key(document.FocusedElement()));
+        stamp = Mix(stamp, content);
+        if (const PaintLayerScrollableArea* viewport = view.LayoutViewport()) {
+          stamp = MixOffset(stamp, viewport->GetScrollOffset());
+        }
+        for (const auto& entry : view.ScrollableAreas()) {
+          stamp = MixOffset(stamp, entry.value->GetScrollOffset());
+        }
+        stamp = Mix(stamp, document.StyleVersion());
+        stamp = Mix(stamp, view.LayoutCountForTesting());
+        // A throttled view gets no lifecycle, and nothing of it is in view; nor
+        // does an undrawn local root.
+        if (!undrawn_ && !view.CanThrottleRendering() &&
+            (StyleDirty(document) || view.NeedsLayout())) {
+          dirty = true;
+        }
+      });
+  return stamp;
+}
+
+// Each load in flight in every same-process frame, tagged by its
+// interaction's time origin and by when it started. `caused` and `meanwhile`
+// count; an earlier interaction's and anything that started before T do not;
+// a counted load past 2 s is a long-poll or a stream, named but not counted
+// (and its passing 2 s is no end). A counted load that ends marks a request
+// end the quiet window runs from; so do loads of counted kinds, not an
+// earlier interaction's, that started and ended between two samples, as the
+// fetcher's record of its last few such starts tells (more than it keeps: an
+// end).
+void AgentSettleWatcher::ClassifyRequests(LocalFrame& root,
+                                          base::TimeTicks now,
+                                          RequestTally& tally,
+                                          bool baseline) {
+  next_counted_.Shrink(0);
+  next_long_.Shrink(0);
+  uint64_t started = 0;
+  // Since the last sample, loads of counted kinds not an earlier
+  // interaction's: started (as recorded), and still running; and every
+  // recorded start, whatever its origin.
+  wtf_size_t fresh_started = 0;
+  wtf_size_t fresh_running = 0;
+  wtf_size_t fresh_recorded = 0;
+  const base::TimeTicks t = t_;
+  const base::TimeTicks previous = last_sample_at_;
+  ForEachFrame(root, [&](LocalFrame&, Document& document, LocalFrameView&) {
+    const ResourceFetcher* fetcher = document.Fetcher();
+    if (!fetcher) {
+      return;
+    }
+    started += fetcher->CountedLoadsStarted();
+    fetcher->ForEachRecentCountedLoad(
+        [&](base::TimeTicks created, base::TimeTicks origin) {
+          if (previous.is_null() || created <= previous) {
+            return;
+          }
+          ++fresh_recorded;
+          if (origin.is_null() || origin >= t) {
+            ++fresh_started;
+          }
+        });
+    fetcher->ForEachActiveLoad([&](const Resource& resource,
+                                   base::TimeTicks created,
+                                   base::TimeTicks origin) {
+      if (Uncounted(resource)) {
+        return;
+      }
+      bool meanwhile = false;
+      if (!origin.is_null()) {
+        if (origin < t) {
+          return;
+        }
+      } else if (created < t) {
+        return;
+      } else {
+        meanwhile = true;
+      }
+      if (!previous.is_null() && created > previous) {
+        ++fresh_running;
+      }
+      if (now - created > kLongLoad) {
+        next_long_.push_back(Key(&resource));
+        return;
+      }
+      if (meanwhile) {
+        ++tally.meanwhile;
+      } else {
+        ++tally.caused;
+      }
+      next_counted_.push_back(Key(&resource));
+      // Named once, as it is first counted: what to name if its end is all
+      // that kept a reading from settling.
+      // By its pointer and start: a load freed and another made at the same
+      // address within one sample must not inherit the name.
+      const uint64_t load = Key(&resource);
+      bool named_already = false;
+      for (const CountedName& name : counted_names_) {
+        if (name.key == load && name.created == created) {
+          named_already = true;
+          break;
+        }
+      }
+      if (!named_already) {
+        counted_names_.push_back(CountedName{
+            load, created, RequestName(resource, document), meanwhile});
+      }
+    });
+  });
+  if (!baseline) {
+    // What ended, by name when a counted load seen running left; one that
+    // started and ended between two samples has none.
+    const CountedName* ended = nullptr;
+    for (uint64_t key : counted_) {
+      if (!next_counted_.Contains(key) && !next_long_.Contains(key)) {
+        tally.ended = true;
+        for (const CountedName& name : counted_names_) {
+          if (name.key == key) {
+            ended = &name;
+            break;
+          }
+        }
+        break;
+      }
+    }
+    if (fresh_started > fresh_running) {
+      tally.ended = true;
+    }
+    // More started than the fetchers' records still hold: some went unseen.
+    // (A frame that appeared brings its whole count: read as an end.)
+    if (started > loads_started_ && started - loads_started_ > fresh_recorded) {
+      tally.ended = true;
+    }
+    if (tally.ended) {
+      ended_request_what_ = ended ? ended->what : String();
+      ended_request_meanwhile_ = ended && ended->meanwhile;
+    }
+  }
+  // Names only of the loads still counted (a key is a pointer: one freed and
+  // reused must not inherit a name).
+  EraseIf(counted_names_, [this](const CountedName& name) {
+    return !next_counted_.Contains(name.key);
+  });
+  loads_started_ = started;
+  counted_.swap(next_counted_);
+  if (tally.ended) {
+    last_request_end_ = now;
+  }
+}
+
+// The counted loads by name for an answer (at most 3), then the long ones.
+void AgentSettleWatcher::NameRequests(
+    LocalFrame& root,
+    base::TimeTicks now,
+    Vector<mojom::blink::AgentChangingPtr>& changing) {
+  Vector<mojom::blink::AgentChangingPtr> long_ones;
+  wtf_size_t named = 0;
+  const base::TimeTicks t = t_;
+  ForEachFrame(root, [&](LocalFrame&, Document& document, LocalFrameView&) {
+    const ResourceFetcher* fetcher = document.Fetcher();
+    if (!fetcher) {
+      return;
+    }
+    fetcher->ForEachActiveLoad([&](const Resource& resource,
+                                   base::TimeTicks created,
+                                   base::TimeTicks origin) {
+      if (Uncounted(resource) || (!origin.is_null() && origin < t) ||
+          (origin.is_null() && created < t)) {
+        return;
+      }
+      const bool meanwhile = origin.is_null();
+      if (now - created > kLongLoad) {
+        if (long_ones.size() < kMaxRequestNames) {
+          long_ones.push_back(mojom::blink::AgentChanging::New(
+              "request", RequestName(resource, document) + " (running over 2s)",
+              0, meanwhile));
+        }
+        return;
+      }
+      if (named < kMaxRequestNames && changing.size() < kMaxChanging) {
+        ++named;
+        changing.push_back(mojom::blink::AgentChanging::New(
+            "request", RequestName(resource, document), 0, meanwhile));
+      }
+    });
+  });
+  for (auto& item : long_ones) {
+    if (changing.size() >= kMaxChanging) {
+      break;
+    }
+    changing.push_back(std::move(item));
+  }
+}
+
+// What the renderer knows of a navigation the browser may not have
+// heard of yet. The local root's own flags count; a subframe's count only when
+// they were not already up at the arm (an earlier load's, not the action's).
+uint8_t AgentSettleWatcher::NavigationFlags(LocalFrame& root, bool at_arm) {
+  uint8_t flags = 0;
+  if (at_arm) {
+    nav_pending_at_arm_.Shrink(0);
+  }
+  ForEachFrame(root,
+               [&](LocalFrame& frame, Document& document, LocalFrameView&) {
+                 uint8_t own = 0;
+                 if (frame.Loader().HasProvisionalNavigation()) {
+                   own |= kNavProvisional;
+                 }
+                 if (frame.IsFormSubmissionPending()) {
+                   own |= kNavForm;
+                 }
+                 if (LocalDOMWindow* window = frame.DomWindow()) {
+                   // navigation() exists once a document has loaded
+                   // (FrameLoader:: DidFinishNavigation makes it); otherwise
+                   // this makes it, once.
+                   if (window->navigation()->HasNonDroppedOngoingNavigation()) {
+                     own |= kNavSameDocument;
+                   }
+                 }
+                 if (document.IsHttpRefreshScheduledWithin(kRefreshWithin)) {
+                   own |= kNavRefresh;
+                 }
+                 if (!own) {
+                   return;
+                 }
+                 if (&frame == &root) {
+                   flags |= own;
+                   return;
+                 }
+                 if (at_arm) {
+                   nav_pending_at_arm_.push_back(Key(&frame));
+                 } else if (!nav_pending_at_arm_.Contains(Key(&frame))) {
+                   flags |= kNavSubframe;
+                 }
+               });
+  return flags;
+}
+
+// From DidFinishPostLifecycleSteps only: the running finite
+// animations on in-view elements of every unthrottled frame. One with 1.5 s or
+// less to run blocks; a longer one is only named; an infinite one is ignored.
+// Reads Playing(), the specified timing, the kind, the name and the target,
+// nothing that writes; never DocumentAnimations::getAnimations() (it forces a
+// style update) nor NeedsAnimationTimingUpdate() (it writes).
+void AgentSettleWatcher::ReadAnimations(LocalFrame& root, base::TimeTicks now) {
+  uint8_t blocking = 0;
+  double longest_blocking = 0;
+  Animation* first = nullptr;
+  Animation* second = nullptr;
+  double first_left = 0;
+  double second_left = 0;
+  bool first_blocks = false;
+  ForEachFrame(
+      root, [&](LocalFrame& frame, Document& document, LocalFrameView& view) {
+        if (undrawn_ || view.CanThrottleRendering()) {
+          return;
+        }
+        double width = 0;
+        double height = 0;
+        ViewportOf(frame, view, width, height);
+        for (const auto& member : document.Timeline().GetAnimations()) {
+          Animation* animation = member.Get();
+          if (!animation || !animation->Playing()) {
+            continue;
+          }
+          const AnimationEffect* effect = animation->effect();
+          if (!effect) {
+            continue;
+          }
+          const Timing& timing = effect->SpecifiedTiming();
+          if (!std::isfinite(timing.iteration_count)) {
+            continue;
+          }
+          Element* target = AnimationTarget(*animation);
+          if (!target || !target->GetLayoutObject() ||
+              !InView(target->GetBoundingClientRectNoLifecycleUpdate(), width,
+                      height)) {
+            continue;
+          }
+          const double left = SecondsLeft(*animation, timing);
+          const bool blocks = left <= kAnimationBlockSeconds;
+          if (blocks) {
+            blocking = static_cast<uint8_t>(std::min(blocking + 1, 255));
+            longest_blocking = std::max(longest_blocking, left);
+          }
+          // Keep two to name, blocking ones first.
+          if (!first || (blocks && !first_blocks)) {
+            second = first;
+            second_left = first_left;
+            first = animation;
+            first_left = left;
+            first_blocks = blocks;
+          } else if (!second) {
+            second = animation;
+            second_left = left;
+          }
+        }
+      });
+  // The last blocking one ended since the last frame: when the page stopped
+  // moving, for afterMs.
+  if (blocking_animations_ && !blocking) {
+    animations_ended_at_ = now;
+  }
+  blocking_animations_ = blocking;
+  blocking_until_ = now + base::Seconds(std::min(longest_blocking, 60.0));
+  animation_a_ = first;
+  animation_b_ = second;
+  animation_a_left_ = first_left;
+  animations_read_at_ = now;
+  animation_b_left_ = second_left;
+}
+
+// The walk over every unthrottled same-process frame, hashing the
+// in-view candidates in walk order. Past the node budget the stamp alone
+// stands for the page. The first element added, removed or changed since the
+// last pass is named as it is met; DOMNodeIds::IdForNode only then.
+// browser: with `read_regions`, every live region root the walk meets --
+// rendered or display: contents, in view or not, interactive or not -- goes
+// to NoteRegion.
+uint64_t AgentSettleWatcher::ComputeSignature(LocalFrame& root,
+                                              uint64_t stamp,
+                                              bool read_regions) {
+  next_entries_.Shrink(0);
+  pending_what_ = String();
+  pending_node_id_ = 0;
+  uint64_t sig = kSeed;
+  wtf_size_t nodes = 0;
+  bool exceeded = false;
+  bool named = !sig_valid_;
+  // browser: the elements shown, in the same walk, and the frames
+  // it went over.
+  int32_t shown = 0;
+  uint64_t shown_frames = kSeed;
+  ForEachFrame(root, [&](LocalFrame& frame, Document& document,
+                         LocalFrameView& view) {
+    if (exceeded || undrawn_ || view.CanThrottleRendering()) {
+      return;
+    }
+    double width = 0;
+    double height = 0;
+    ViewportOf(frame, view, width, height);
+    // browser: this frame is counted; an element with opacity 0
+    // hides what it holds (checkVisibility's checkOpacity) -- by shadow-
+    // including tree order, the walk's own, which keeps a subtree together
+    // (light children slotted under a transparent slot still count).
+    shown_frames = Mix(shown_frames, Key(&frame));
+    const Element* transparent = nullptr;
+    const auto note_region = [&](Element& element) {
+      if (read_regions && agent_live_regions::IsRegionRoot(element)) {
+        NoteRegion(element);
+      }
+    };
+    exceeded = !WalkRendered(
+        document, nodes,
+        [&](Node& node) {
+          auto* element = DynamicTo<Element>(node);
+          if (element) {
+            note_region(*element);
+            if (transparent &&
+                !transparent->IsShadowIncludingInclusiveAncestorOf(*element)) {
+              transparent = nullptr;
+            }
+            if (const LayoutObject* layout = element->GetLayoutObject()) {
+              const ComputedStyle& style = layout->StyleRef();
+              if (!transparent && style.Opacity() <= 0) {
+                transparent = element;
+              }
+              if (!transparent && style.Visibility() == EVisibility::kVisible) {
+                ++shown;
+              }
+            }
+          }
+          if (!element || !IsCandidate(*element, *element->GetLayoutObject())) {
+            return true;
+          }
+          const gfx::RectF rect =
+              element->GetBoundingClientRectNoLifecycleUpdate();
+          if (!InView(rect, width, height)) {
+            return true;
+          }
+          const uint64_t key = Key(element);
+          const uint64_t hash = HashCandidate(*element, rect);
+          const wtf_size_t index = next_entries_.size();
+          next_entries_.push_back(SigEntry{
+              key, hash,
+              static_cast<int32_t>(DOMNodeIds::ExistingIdForNode(element))});
+          sig = Mix(Mix(sig, key), hash);
+          if (!named &&
+              (index >= entries_.size() || entries_[index].key != key ||
+               entries_[index].hash != hash)) {
+            named = true;
+            bool was_there = false;
+            for (const SigEntry& entry : entries_) {
+              if (entry.key == key) {
+                was_there = true;
+                break;
+              }
+            }
+            if (index < entries_.size() && entries_[index].key == key) {
+              pending_what_ = String(Describe(*element) + " (changed)");
+              pending_node_id_ = DOMNodeIds::IdForNode(element);
+            } else if (!was_there || index >= entries_.size()) {
+              pending_what_ = String(Describe(*element) + " (new)");
+              pending_node_id_ = DOMNodeIds::IdForNode(element);
+            } else {
+              // It moved up: what stood here before is gone from view.
+              NameGone(entries_[index]);
+            }
+          }
+          return true;
+        },
+        note_region);
+  });
+  if (!named && next_entries_.size() < entries_.size()) {
+    NameGone(entries_[next_entries_.size()]);
+  }
+  budget_exceeded_ = exceeded;
+  shown_now_.reset();
+  if (!exceeded) {
+    shown_now_ = shown;
+  }
+  shown_frames_now_ = shown_frames;
+  if (exceeded) {
+    pending_what_ = "the page (past the node budget)";
+    pending_node_id_ = 0;
+    return Mix(kSeed ^ 1, stamp);
+  }
+  return sig;
+}
+
+// An element of the last pass that is not in this one: by its DOMNodeId, when
+// it had one, and while it lives.
+void AgentSettleWatcher::NameGone(const SigEntry& entry) {
+  Node* node = entry.id ? DOMNodeIds::NodeForId(entry.id) : nullptr;
+  auto* element = DynamicTo<Element>(node);
+  pending_what_ = element ? String(Describe(*element) + " (gone)")
+                          : String("an element (gone)");
+  pending_node_id_ = entry.id;
+}
+
+// browser: every live region root of the readable frames, to NoteRegion.
+// The signature walk's frames and nodes, read even while
+// style or layout is pending: it reads only LayoutObject presence and the
+// style elements already have, forcing neither, so a node inserted since the
+// last style recalc reads as silent, which is what it said before.
+void AgentSettleWatcher::WalkRegions(LocalFrame& root, NoteMode mode) {
+  wtf_size_t nodes = 0;
+  bool exceeded = false;
+  const auto note_region = [this, mode](Element& element) {
+    if (agent_live_regions::IsRegionRoot(element)) {
+      NoteRegion(element, mode);
+    }
+  };
+  ForEachFrame(root,
+               [&](LocalFrame&, Document& document, LocalFrameView& view) {
+                 if (exceeded || undrawn_ || view.CanThrottleRendering()) {
+                   return;
+                 }
+                 exceeded = !WalkRendered(
+                     document, nodes,
+                     [&](Node& node) {
+                       if (auto* element = DynamicTo<Element>(node)) {
+                         note_region(*element);
+                       }
+                       return true;
+                     },
+                     note_region);
+               });
+}
+
+// browser: what every live region root says at the arm, in the arm's
+// sample even while style or layout is pending: the baseline, which records
+// nothing.
+void AgentSettleWatcher::BaselineRegions(LocalFrame& root) {
+  WalkRegions(root);
+  regions_baseline_ = false;
+}
+
+// browser: the watch's last read before it gives way. A paused or stopped
+// watch does not read: what changed while nothing looked is not its -- but an
+// action's Arm reads it all the same, as a closing pass (unwatched), so it is
+// carried on rather than taken into the new baseline. Read while style or
+// layout may be pending, as the baseline is.
+void AgentSettleWatcher::ReadRegionsLast(bool at_arm) {
+  if ((!watching_ && !at_arm) || heard_arm_id_ == 0 || regions_baseline_) {
+    return;
+  }
+  LocalFrame* root = Root();
+  if (!root) {
+    return;
+  }
+  ScriptForbiddenScope forbid_script;
+  undrawn_ = Undrawn(*root);
+  WalkRegions(*root, watching_ ? NoteMode::kWatched : NoteMode::kUnwatched);
+}
+
+// browser: see the header. When what the regions read may have changed
+// (the content stamp, which gates the watch's own read) and kIdleGap past the
+// last read: every live region root, recorded as unwatched, a region's newest
+// text in one place (NoteRegion). A change inside the gap is read at its end,
+// by the timer, so a toast a page timer showed and removed between calls is
+// heard. Read clean, as the watch's own read is: with style or
+// layout pending, or nothing drawn, the next frame reads (a toast inserted
+// since the last frame has no box yet). After a frame the page drew anyway;
+// forces nothing and runs no script. A view no longer the root's reads
+// nothing until a call resumes the watch on the new one; kIdleFor after the
+// last call or answer, it stops reading, as a paused watch did before.
+void AgentSettleWatcher::IdleRegions(base::TimeTicks now) {
+  if (timer_.IsActive()) {
+    return;  // a held-back read is due anyway
+  }
+  if (now - last_contact_ >= kIdleFor) {
+    if (LocalFrameView* view = view_.Get()) {
+      view->UnregisterFromLifecycleNotifications(this);
+    }
+    return;
+  }
+  LocalFrame* root = Root();
+  if (!root || root->View() != view_.Get() || heard_arm_id_ == 0 ||
+      regions_baseline_) {
+    return;
+  }
+  ScriptForbiddenScope forbid_script;
+  undrawn_ = Undrawn(*root);
+  bool dirty = false;
+  uint64_t content = 0;
+  ComputeStamp(*root, dirty, content);
+  if (dirty || undrawn_ || content == idle_content_) {
+    return;
+  }
+  if (now - idle_read_at_ < kIdleGap) {
+    if (!timer_.IsActive()) {
+      timer_.StartOneShot(idle_read_at_ + kIdleGap - now, FROM_HERE);
+    }
+    return;
+  }
+  idle_content_ = content;
+  idle_read_at_ = now;
+  WalkRegions(*root, NoteMode::kUnwatched);
+}
+
+// browser: see the header.
+void AgentSettleWatcher::NoteRead(Element& element) {
+  if (heard_arm_id_ == 0 || regions_baseline_) {
+    return;
+  }
+  NoteRegion(element, watching_ ? NoteMode::kWatched : NoteMode::kUnwatched);
+}
+
+// browser: see the header. A reread while the first read is still in
+// flight (a slow renderer) has nothing to reopen: the span stays open until
+// both are done.
+void AgentSettleWatcher::NoteReportStart(int64_t arm_id, bool reread) {
+  if (arm_id != span_arm_id_) {
+    return;
+  }
+  ++reads_in_flight_;
+  if (!reread || !report_read_) {
+    return;
+  }
+  // Only the entries heard since that read are judged again, as they would
+  // have been with the span open.
+  report_read_ = false;
+  for (HeardEntry& entry : heard_) {
+    if (entry.heard_at >= report_read_at_) {
+      entry.own = !InActionWindow(entry.heard_at);
+    }
+  }
+}
+
+// browser: see the header.
+bool AgentSettleWatcher::LogTextRoom(uint64_t key) const {
+  constexpr wtf_size_t kMaxLogTexts = 32;
+  return log_text_.Contains(key) || log_text_.size() < kMaxLogTexts;
+}
+
+void AgentSettleWatcher::KeepLogText(uint64_t key,
+                                     agent_live_regions::RegionEnds ends) {
+  if (LogTextRoom(key)) {
+    log_text_.Set(key, std::move(ends));
+  }
+}
+
+// browser: see the header.
+void AgentSettleWatcher::NoteReportRead(int64_t arm_id) {
+  if (arm_id != span_arm_id_ || reads_in_flight_ == 0 ||
+      --reads_in_flight_ > 0) {
+    return;
+  }
+  report_read_ = true;
+  report_read_at_ = base::TimeTicks::Now();
+}
+
+// browser: see the header.
+bool AgentSettleWatcher::InActionWindow(base::TimeTicks now) const {
+  return !action_armed_at_.is_null() && !report_read_ &&
+         now - action_armed_at_ < kActionWindow;
+}
+
+// browser: a live region root met in a signature pass. Its text is hashed
+// only when it counts, with nothing of it kept (nothing allocated); 0 when it
+// does not count. A hash unlike the last one seen for it, past the baseline,
+// is a change: its text is read then, and unless it is empty it is what the
+// region said, recorded while the arm has fewer than 8 (and heard_ fewer than
+// 24 past what the action's Arm carried on), its kind read only then. "This
+// arm" is the latest Arm, an action's or a look's (heard_since_). kUnwatched,
+// the closing pass of a read made while no watch looked, has its own
+// allowance (UnwatchedFull) instead of the arm's 8, and its entries flagged.
+// A text the caps refuse is left unrecorded (region_said_), so a later read
+// still finds it changed. Each entry carries whether the page said it by
+// itself (InActionWindow). A root that said 3 this arm (1 unwatched) has its
+// newest change take the place of its latest entry, under a number of its
+// own, the arm's allowance spent or not: the newest text always has an entry
+// (a reply streamed in word by word; a clock between calls holds one place).
+void AgentSettleWatcher::NoteRegion(Element& element, NoteMode mode) {
+  const bool unwatched = mode == NoteMode::kUnwatched;
+  uint64_t said = 0;
+  const bool counts = agent_live_regions::RegionCounts(element);
+  if (counts) {
+    agent_live_regions::ReadRegionText(element, /*is_log=*/false, said,
+                                       nullptr);
+  }
+  // browser: at the arm's baseline every log root's text is kept,
+  // counting or not (aria-busy, hidden), so a log with none kept is one that
+  // came after it -- save one that does not count and reads empty (hidden by
+  // visibility: its text is not walked), whose history would read as added.
+  const bool log = agent_live_regions::IsLogRoot(element);
+  if (log && regions_baseline_) {
+    const uint64_t log_key =
+        static_cast<uint64_t>(DOMNodeIds::IdForNode(&element));
+    if (LogTextRoom(log_key)) {
+      agent_live_regions::RegionEnds ends =
+          agent_live_regions::ReadRegionEnds(element);
+      if (counts || ends.length > 0) {
+        KeepLogText(log_key, std::move(ends));
+      }
+    }
+  }
+  // browser: a kept log past its baseline that says nothing while it
+  // counts is kept empty, so its next text is all added -- before the hash
+  // check, which a log emptied while it did not count never passes. One that
+  // stopped counting keeps what it had.
+  if (log && counts && !said && !regions_baseline_) {
+    if (const DOMNodeId id = DOMNodeIds::ExistingIdForNode(&element)) {
+      const uint64_t log_key = static_cast<uint64_t>(id);
+      if (log_text_.Contains(log_key)) {
+        KeepLogText(log_key, agent_live_regions::RegionEnds());
+      }
+    }
+  }
+  // browser: keyed by the root's DOMNodeId, never reused: a toast made
+  // where a collected one was is a new root, though it says the same. A root
+  // that never said anything has none made (save a log root, given one at the
+  // baseline above), and was never stored.
+  if (!said && !DOMNodeIds::ExistingIdForNode(&element)) {
+    return;
+  }
+  const uint64_t key = static_cast<uint64_t>(DOMNodeIds::IdForNode(&element));
+  auto it = region_said_.find(key);
+  if (it != region_said_.end() ? it->value == said : !said) {
+    return;
+  }
+  if (regions_baseline_ || !said) {
+    region_said_.Set(key, said);
+    return;
+  }
+  // What the root said this arm, by its DOMNodeId (the key), the watch's and
+  // the closing passes' apart, and the latest of it.
+  const int32_t node_id = static_cast<int32_t>(key);
+  wtf_size_t told = 0;
+  wtf_size_t latest = kNotFound;
+  for (wtf_size_t i = heard_since_; i < heard_.size(); ++i) {
+    if (heard_[i].node_id == node_id && heard_[i].unwatched == unwatched) {
+      ++told;
+      latest = i;
+    }
+  }
+  const bool replaces =
+      told >= (unwatched ? kMaxUnwatchedPerRegion : kMaxHeardPerRegion);
+  if (!replaces && (unwatched ? UnwatchedFull() : HeardFull())) {
+    return;
+  }
+  region_said_.Set(key, said);
+  // A log shows its last 300 characters, where its newest lines are. A
+  // region that went quiet says nothing: its hash stays stored, so the next
+  // text it says is a change.
+  HeardEntry entry;
+  agent_live_regions::DescribeRegion(element, entry.kind, entry.assertive);
+  agent_live_regions::ReadRegionText(element, entry.kind == "log",
+                                     entry.text_hash, &entry.text);
+  if (entry.text.empty()) {
+    return;
+  }
+  // browser: what a log's change added, against its text as last
+  // kept; a log with none kept (it came after the arm's baseline, a page
+  // remade it, or past 32 log roots) has none: what it holds was not seen
+  // added.
+  if (log && LogTextRoom(key)) {
+    agent_live_regions::RegionEnds now_ends =
+        agent_live_regions::ReadRegionEnds(element);
+    if (auto was = log_text_.find(key); was != log_text_.end()) {
+      entry.added = agent_live_regions::AddedText(was->value, now_ends,
+                                                  &entry.added_prepended);
+    }
+    KeepLogText(key, std::move(now_ends));
+  }
+  if (replaces) {
+    // browser: the changes the one it takes the place of stood for,
+    // and that one's text.
+    entry.changes = heard_[latest].changes + 1;
+    entry.replaced = heard_[latest].text;
+    // browser: with what that one added, the same way, joined as read:
+    // the newest first at the top, last at the end; else none.
+    const HeardEntry& prior = heard_[latest];
+    if (!entry.added.IsNull() && !prior.added.IsNull() &&
+        entry.added_prepended == prior.added_prepended) {
+      const String both = entry.added_prepended
+                              ? String(entry.added + prior.added)
+                              : String(prior.added + entry.added);
+      entry.added = both.substr(0, agent_live_regions::kAddedChars);
+    } else {
+      entry.added = String();
+    }
+    heard_.EraseAt(latest);
+  }
+  entry.node_id = static_cast<int32_t>(key);
+  entry.index = next_index_++;
+  entry.arm_id = heard_arm_id_;
+  entry.heard_at = base::TimeTicks::Now();
+  entry.unwatched = unwatched;
+  entry.own = !InActionWindow(entry.heard_at);
+  heard_.push_back(std::move(entry));
+}
+
+bool AgentSettleWatcher::HeardFull() const {
+  return heard_.size() - heard_since_ >= kMaxHeard ||
+         heard_.size() - heard_carried_ >= kMaxHeardKept;
+}
+
+bool AgentSettleWatcher::UnwatchedFull() const {
+  wtf_size_t unwatched = 0;
+  for (wtf_size_t i = heard_since_; i < heard_.size(); ++i) {
+    unwatched += heard_[i].unwatched ? 1 : 0;
+  }
+  return unwatched >= kMaxUnwatched ||
+         heard_.size() - heard_carried_ >= kMaxHeardKept + kMaxUnwatched;
+}
+
+// Recomputes the signature when the gate says so (the stamp moved and 100 ms
+// passed, or 300 ms passed) or to confirm a quiet window's end; never while
+// style or layout is pending, and a gate pass never on a frame that ran long
+// (a confirming one reads through it: a resumed call's short deadline must not
+// pass waiting for a short frame). Settled when the window held -- nothing
+// counted, rendering running, `until` met -- and the confirming pass equals
+// the window's start.
+void AgentSettleWatcher::Judge(LocalFrame& root,
+                               base::TimeTicks now,
+                               uint64_t stamp,
+                               uint64_t content,
+                               bool dirty,
+                               bool long_frame) {
+  settled_ = false;
+  const bool counted = requests_.caused || requests_.meanwhile || nav_flags_ ||
+                       blocking_animations_;
+  const bool awaiting = callback_ && (!HasUntil() || until_seen_);
+  const bool due =
+      !sig_valid_ ||
+      (!gate_changed_at_.is_null() && now - sig_at_ >= kGateRate) ||
+      now - sig_at_ >= kForcedRecompute;
+  const bool candidate = awaiting && !counted && !rendering_paused_ &&
+                         sig_valid_ && now - Anchor() >= quiet_;
+  const bool can_read = !dirty && (!long_frame || candidate);
+  if (!(due || candidate) || !can_read) {
+    return;
+  }
+  const bool had = sig_valid_;
+  // browser: the live regions ride this walk whenever the DOM moved since
+  // they were last read (an Arm asks for the first pass), the arm's 8 heard
+  // or not: a region at its own cap still takes its newest change
+  // (NoteRegion). Their baseline was the arm's sample's.
+  const bool read_regions = content != regions_content_;
+  const uint64_t sig = ComputeSignature(root, stamp, read_regions);
+  if (read_regions) {
+    regions_content_ = content;
+  }
+  // browser: the arm's count, from its first walk: over the budget
+  // there, nothing is counted this arm; and `appeared` tested where it is
+  // counted, not a gate later.
+  shown_at_ = now;
+  if (!shown_base_tried_) {
+    shown_base_tried_ = true;
+    shown_base_ = shown_now_;
+    shown_frames_base_ = shown_frames_now_;
+  }
+  if (until_appeared_ && callback_ && !until_seen_ && ShownMore()) {
+    until_seen_ = true;
+    until_met_at_ = now;
+  }
+  // This pass read a change: no settle on it.
+  bool changed = false;
+  if (had && sig != sig_) {
+    // Dated to the last stamp move since the last pass, not the first: the
+    // page may have changed again in between, and the quiet window runs from
+    // its latest change (a button ticking every 100 ms was dated a
+    // tick early and read as settled). No stamp move since (a change only the
+    // forced pass saw): now.
+    last_change_ = stamp_moved_at_ > sig_at_ ? stamp_moved_at_ : now;
+    change_what_ = pending_what_;
+    change_node_id_ = pending_node_id_;
+    changed = true;
+  } else if (!had && !base_changed_at_.is_null()) {
+    // The first baseline, read after the page changed since the arm (or the
+    // resume): that change is in it, unnamed, but it still moves the window.
+    last_change_ = base_changed_at_;
+    change_what_ = "the page (changed before its first clean read)";
+    change_node_id_ = 0;
+    changed = true;
+  }
+  sig_ = sig;
+  sig_valid_ = true;
+  sig_stamp_ = stamp;
+  sig_at_ = now;
+  gate_changed_at_ = base::TimeTicks();
+  entries_.swap(next_entries_);
+  settled_ = candidate && had && !changed;
+}
+
+// ------------------------------------------------------------------ `until`
+
+void AgentSettleWatcher::ClearUntil() {
+  until_text_set_ = false;
+  until_needle_.Shrink(0);
+  until_fail_.Shrink(0);
+  until_selector_ = g_null_atom;
+  until_xpath_ = String();
+  until_state_ = mojom::blink::AgentUntilState::kVisible;
+  until_frame_token_ = String();
+  until_appeared_ = false;
+  until_gone_id_ = 0;
+  until_seen_ = false;
+  until_invalid_ = false;
+  until_met_at_ = base::TimeTicks();
+  until_checked_at_ = base::TimeTicks();
+  until_checked_stamp_ = 0;
+}
+
+void AgentSettleWatcher::SetUntil(const mojom::blink::AgentUntilPtr& until) {
+  ClearUntil();
+  if (!until) {
+    return;
+  }
+  if (!until->text.IsNull()) {
+    // Folded and collapsed as the page's text will be, ends trimmed.
+    until_text_set_ = true;
+    bool space = true;
+    for (wtf_size_t i = 0;
+         i < until->text.length() && until_needle_.size() < kNeedleMax; ++i) {
+      const UChar c = Fold(until->text[i]);
+      if (c == ' ') {
+        if (!space) {
+          until_needle_.push_back(' ');
+        }
+        space = true;
+        continue;
+      }
+      until_needle_.push_back(c);
+      space = false;
+    }
+    while (!until_needle_.empty() && until_needle_.back() == ' ') {
+      until_needle_.pop_back();
+    }
+    until_fail_.resize(until_needle_.size());
+    wtf_size_t k = 0;
+    for (wtf_size_t i = 1; i < until_needle_.size(); ++i) {
+      while (k > 0 && until_needle_[i] != until_needle_[k]) {
+        k = until_fail_[k - 1];
+      }
+      if (until_needle_[i] == until_needle_[k]) {
+        ++k;
+      }
+      until_fail_[i] = k;
+    }
+    if (!until_fail_.empty()) {
+      until_fail_[0] = 0;
+    }
+  }
+  if (!until->selector.IsNull()) {
+    // An empty selector does not parse either: QuerySelector says so.
+    until_selector_ = AtomicString(until->selector);
+  }
+  until_xpath_ = until->xpath;
+  until_state_ = until->state;
+  until_frame_token_ = until->frame_token;
+  until_appeared_ = until->appeared;
+  until_gone_id_ = until->gone_node_id;
+}
+
+bool AgentSettleWatcher::HasUntil() const {
+  return until_text_set_ || !until_selector_.IsNull() ||
+         !until_xpath_.IsNull() || until_appeared_ || until_gone_id_ != 0;
+}
+
+// browser: see the header. A count from before the call (a menu the
+// path crossed, closed since) does not meet it.
+bool AgentSettleWatcher::ShownMore() const {
+  return shown_base_ && shown_now_ && shown_frames_now_ == shown_frames_base_ &&
+         *shown_now_ > *shown_base_ && shown_at_ >= await_received_;
+}
+
+// `until`'s checks run when the stamp moved and 100 ms passed, or 300 ms
+// passed, and only on a laid-out page.
+void AgentSettleWatcher::MaybeCheckUntil(LocalFrame& root,
+                                         base::TimeTicks now,
+                                         uint64_t stamp,
+                                         bool dirty) {
+  if (!callback_ || !HasUntil() || until_seen_ || until_invalid_ || dirty) {
+    return;
+  }
+  const bool due =
+      until_checked_at_.is_null() ||
+      (stamp != until_checked_stamp_ && now - until_checked_at_ >= kGateRate) ||
+      now - until_checked_at_ >= kForcedRecompute;
+  if (!due) {
+    return;
+  }
+  until_checked_at_ = now;
+  until_checked_stamp_ = stamp;
+  CheckUntil(root, now);
+}
+
+// text: a case-insensitive, space-collapsed substring of the rendered
+// text (laid-out text nodes in walk order, joined; a block boundary reads as a
+// space) or of a candidate's name proxy, in any readable frame. selector:
+// QuerySelector per same-process document (C++, no script), its first match
+// as `state` asks (UntilHolds; visible by default); one that does not parse is
+// an error. xpath: the same way (DocumentXPathEvaluator,
+// no resolver: no script), its first node in document order; with a frame
+// token, only that frame's document is checked; hidden is met once every
+// document checked has it so, and only when one was. A frame not drawn, or
+// whose rendering is throttled, has no current layout: it is checked only for
+// what the query alone tells -- attached; hidden once nothing matches or its
+// frame element is not rendered.
+// gone: the node is detached, not rendered, or display: none. Any one met
+// meets `until`.
+void AgentSettleWatcher::CheckUntil(LocalFrame& root, base::TimeTicks now) {
+  bool met = false;
+  if (until_gone_id_) {
+    Node* node = DOMNodeIds::NodeForId(until_gone_id_);
+    LocalFrame* frame = node ? node->GetDocument().GetFrame() : nullptr;
+    if (!node || !frame) {
+      met = true;
+    } else if (&frame->LocalFrameRoot() == &root) {
+      // Detached, or not rendered. A display: contents element has no box of
+      // its own but is there (its stored style says so; nothing is
+      // computed): present, whether or not anything inside it renders.
+      const auto* element = DynamicTo<Element>(node);
+      met = !node->isConnected() ||
+            (!node->GetLayoutObject() &&
+             !(element && element->HasDisplayContentsStyle() &&
+               element->GetComputedStyle() &&
+               !element->GetComputedStyle()->IsEnsuredInDisplayNone()));
+    }
+    // A node of another local root in this process is that root's to judge.
+  }
+  if (!met && (!until_selector_.IsNull() || !until_xpath_.IsNull())) {
+    const bool hidden = until_state_ == mojom::blink::AgentUntilState::kHidden;
+    bool checked = false;
+    bool holds_everywhere = true;
+    ForEachFrame(root, [&](LocalFrame& frame, Document& document,
+                           LocalFrameView& view) {
+      if (met || until_invalid_) {
+        return;
+      }
+      if (!until_frame_token_.IsNull() &&
+          String(frame.GetDevToolsFrameToken().ToString()) !=
+              until_frame_token_) {
+        return;
+      }
+      // A null isolate: the error is noted here, never thrown into the page.
+      ExceptionState exception_state(nullptr);
+      Node* first = nullptr;
+      if (!until_selector_.IsNull()) {
+        first = document.QuerySelector(until_selector_, exception_state);
+      } else if (XPathResult* result = DocumentXPathEvaluator::evaluate(
+                     document, until_xpath_, &document, nullptr,
+                     XPathResult::kFirstOrderedNodeType, ScriptValue(),
+                     exception_state);
+                 result && !exception_state.HadException()) {
+        first = result->singleNodeValue(exception_state);
+      }
+      if (exception_state.HadException()) {
+        until_invalid_ = true;
+        return;
+      }
+      // Its query told whether it parses; a box or visibility it cannot tell.
+      const bool stale = undrawn_ || view.CanThrottleRendering();
+      if (stale && (until_state_ == mojom::blink::AgentUntilState::kBox ||
+                    until_state_ == mojom::blink::AgentUntilState::kVisible)) {
+        return;
+      }
+      checked = true;
+      bool holds = UntilHolds(first, until_state_);
+      if (stale && hidden) {
+        const HTMLFrameOwnerElement* owner = frame.DeprecatedLocalOwner();
+        holds = !first || undrawn_ || (owner && !owner->GetLayoutObject());
+      }
+      if (hidden) {
+        holds_everywhere = holds_everywhere && holds;
+      } else if (holds) {
+        met = true;
+      }
+    });
+    if (hidden && checked && holds_everywhere && !until_invalid_) {
+      met = true;
+    }
+  }
+  if (!met && until_text_set_) {
+    TextMatcher text(until_needle_, until_fail_);
+    TextMatcher proxy(until_needle_, until_fail_);
+    wtf_size_t nodes = 0;
+    wtf_size_t chars = 0;
+    met = text.found();
+    ForEachFrame(
+        root, [&](LocalFrame&, Document& document, LocalFrameView& view) {
+          if (met || undrawn_ || view.CanThrottleRendering() ||
+              nodes > kNodeBudget) {
+            return;
+          }
+          text.Break();
+          const void* block = nullptr;
+          WalkRendered(document, nodes, [&](Node& node) {
+            if (auto* data = DynamicTo<Text>(node)) {
+              // Node's own accessor: Text's returns a LayoutText, not included.
+              const void* here = node.GetLayoutObject()->ContainingBlock();
+              if (here != block) {
+                text.Break();
+                block = here;
+              }
+              chars += text.Feed(data->data(), kTextBudget - chars);
+              met = text.found();
+            } else {
+              auto& element = To<Element>(node);
+              if (IsCandidate(element, *element.GetLayoutObject())) {
+                for (const QualifiedName* name :
+                     {&html_names::kAriaLabelAttr, &html_names::kTitleAttr,
+                      &html_names::kAltAttr, &html_names::kPlaceholderAttr}) {
+                  const AtomicString& value = element.FastGetAttribute(*name);
+                  if (value.empty()) {
+                    continue;
+                  }
+                  proxy.Reset();
+                  proxy.Feed(value.GetString(), kNeedleMax * 4);
+                  if (proxy.found()) {
+                    met = true;
+                    break;
+                  }
+                }
+              }
+            }
+            return !met && chars < kTextBudget;
+          });
+        });
+  }
+  // browser: more shown than at the arm, by the signature walk's
+  // last count.
+  if (!met && until_appeared_ && ShownMore()) {
+    met = true;
+  }
+  if (met) {
+    until_seen_ = true;
+    until_met_at_ = now;
+  }
+}
+
+// ---------------------------------------------------------------- the answer
+
+base::TimeTicks AgentSettleWatcher::Anchor() const {
+  return std::max({last_change_, last_request_end_, nav_cleared_at_,
+                   arm_received_, until_met_at_, resumed_at_});
+}
+
+base::TimeTicks AgentSettleWatcher::CapEnd() const {
+  return std::max(t_, kept_looking_at_) + cap_;
+}
+
+base::TimeTicks AgentSettleWatcher::Deadline() const {
+  if (HasUntil() && !until_seen_) {
+    return until_limit_;
+  }
+  if (HasUntil()) {
+    return std::max(until_met_at_ + cap_, await_received_ + kAwaitGrace);
+  }
+  // A call that restarted a paused watch: one quiet window from a fresh
+  // baseline, and no sooner than the call's own cap from T (the browser may
+  // count T from the end of a long action).
+  if (!resumed_at_.is_null()) {
+    return std::max(
+        await_received_ + std::max(quiet_, kForcedRecompute) + kAwaitGrace,
+        t_ + cap_);
+  }
+  return std::max(t_ + cap_, await_received_ + kAwaitGrace);
+}
+
+void AgentSettleWatcher::MaybeAnswer(base::TimeTicks now) {
+  if (!callback_) {
+    return;
+  }
+  if (until_invalid_ || rendering_paused_) {
+    Answer(now);
+    return;
+  }
+  if (HasUntil() && !until_seen_) {
+    if (now >= until_limit_) {
+      Answer(now);
+    }
+    return;
+  }
+  if (settled_ || now >= Deadline()) {
+    Answer(now);
+  }
+}
+
+void AgentSettleWatcher::Answer(base::TimeTicks now) {
+  if (!callback_) {
+    return;
+  }
+  mojom::blink::AgentSettleReadingPtr reading = Reading(now);
+  AwaitCallback callback = std::move(callback_);
+  last_contact_ = now;
+  // The `until`, the resume and the cap were that call's: a long call's cap
+  // must not keep an idle watch sampling until T + cap.
+  ClearUntil();
+  resumed_at_ = base::TimeTicks();
+  cap_ = kDefaultCap;
+  std::move(callback).Run(std::move(reading));
+}
+
+mojom::blink::AgentSettleReadingPtr AgentSettleWatcher::Reading(
+    base::TimeTicks now) {
+  auto reading = mojom::blink::AgentSettleReading::New();
+  reading->until_seen = until_seen_;
+  reading->until_invalid = until_invalid_;
+  reading->shown_counted =
+      shown_base_ && shown_now_ && shown_frames_now_ == shown_frames_base_;
+  reading->shown_change =
+      reading->shown_counted ? *shown_now_ - *shown_base_ : 0;
+  reading->dom_changed = arm_content_ && last_content_ != *arm_content_;
+  reading->settled = settled_ && !rendering_paused_ && !until_invalid_ &&
+                     (!HasUntil() || until_seen_);
+  reading->rendering_paused = rendering_paused_;
+  reading->budget_exceeded = budget_exceeded_;
+  // The page's last change: the listing, a request's end, a cleared
+  // navigation, or a waited-for animation's end (a 400 ms fade read
+  // "settled after 0.1s").
+  const base::TimeTicks latest = std::max(
+      {last_change_, last_request_end_, nav_cleared_at_, animations_ended_at_});
+  reading->last_change_ms =
+      latest.is_null() ? 0
+                       : std::max<int64_t>(0, (latest - t_).InMilliseconds());
+  reading->until_ms =
+      until_seen_ ? std::max<int64_t>(0, (until_met_at_ - t_).InMilliseconds())
+                  : 0;
+  AddChanging(reading->changing, now, reading->settled);
+  return reading;
+}
+
+// What was still changing, named (at most 5): a pending navigation, the
+// last change if it is recent, the counted requests, the animations (a long
+// one even when settled: named, not waited for), and the lifecycle.
+void AgentSettleWatcher::AddChanging(
+    Vector<mojom::blink::AgentChangingPtr>& changing,
+    base::TimeTicks now,
+    bool settled) {
+  auto add = [&changing](const char* kind, const String& what, int32_t node_id,
+                         bool meanwhile) {
+    if (changing.size() < kMaxChanging) {
+      changing.push_back(mojom::blink::AgentChanging::New(kind, NonNull(what),
+                                                          node_id, meanwhile));
+    }
+  };
+  if (nav_flags_) {
+    add("navigation", NavigationWhat(nav_flags_), 0, false);
+  }
+  const bool mutation_named = !settled && !last_change_.is_null() &&
+                              now - last_change_ < quiet_ + kGateRate * 2 &&
+                              !change_what_.IsNull();
+  if (mutation_named) {
+    add("mutation", change_what_, change_node_id_, false);
+  }
+  // Not settled, with nothing that blocks a settle to name: a request's end
+  // that restarted the quiet window ("something on the page").
+  // Ahead of the request names, which may name only ones that never block.
+  if (!settled && (!HasUntil() || until_seen_) && !until_invalid_ &&
+      !mutation_named && !nav_flags_ && !requests_.caused &&
+      !requests_.meanwhile && !blocking_animations_ && !lifecycle_pending_ &&
+      !rendering_paused_ && !last_request_end_.is_null() &&
+      now - last_request_end_ < quiet_ + kGateRate) {
+    add("request-ended", ended_request_what_, 0, ended_request_meanwhile_);
+  }
+  if (LocalFrame* root = Root()) {
+    NameRequests(*root, now, changing);
+  }
+  // Its time left as of now; waited for or not by its reading.
+  const base::TimeTicks read_at = animations_read_at_;
+  const auto add_animation = [&add, settled, read_at, now](Animation* animation,
+                                                           double left) {
+    const bool blocks = left <= kAnimationBlockSeconds;
+    if (!animation || (settled && blocks)) {
+      return;
+    }
+    Element* target = AnimationTarget(*animation);
+    add("animation",
+        DescribeAnimation(*animation, LeftAt(left, read_at, now), blocks),
+        target ? static_cast<int32_t>(DOMNodeIds::IdForNode(target)) : 0,
+        false);
+  };
+  add_animation(animation_a_.Get(), animation_a_left_);
+  add_animation(animation_b_.Get(), animation_b_left_);
+  if (rendering_paused_) {
+    add("lifecycle", "rendering paused", 0, false);
+  } else if (lifecycle_pending_ && !settled) {
+    add("lifecycle", "lifecycle pending", 0, false);
+  }
+}
+
+}  // namespace blink
