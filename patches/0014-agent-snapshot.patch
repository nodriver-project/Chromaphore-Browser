+// static
+Response SettleJoin::ReadParams(Page::Until* until,
+                                std::optional<int> quiet_ms,
+                                std::optional<int> cap_ms,
+                                std::optional<double> timeout_ms,
+                                Params* params) {
+  const int quiet = quiet_ms.value_or(kDefaultQuietMs);
+  const int cap = cap_ms.value_or(kDefaultCapMs);
+  const int timeout =
+      base::saturated_cast<int>(timeout_ms.value_or(kDefaultTimeoutMs));
+  if (quiet < 0 || quiet > kMaxQuietMs) {
+    return Response::InvalidParams("quietMs is from 0 to 5000");
+  }
+  if (cap < 0 || cap > kMaxCapMs) {
+    return Response::InvalidParams("capMs is from 0 to 30000");
+  }
+  if (timeout < 0) {
+    return Response::InvalidParams("timeoutMs must not be negative");
+  }
+  params->quiet = base::Milliseconds(quiet);
+  params->cap = base::Milliseconds(cap);
+  // The renderer gives up on an `until` after 60 s: the browser's own
+  // deadline must come first.
+  params->timeout = base::Milliseconds(std::min(timeout, kMaxTimeoutMs));
+  if (!until) {
+    return Response::Success();
+  }
+  if (const std::optional<std::string>& text = until->GetText()) {
+    if (text->empty()) {
+      return Response::InvalidParams("until.text is empty");
+    }
+    params->text = *text;
+  }
+  if (const std::optional<std::string>& selector = until->GetSelector()) {
+    if (selector->empty()) {
+      return Response::InvalidParams("until.selector is empty");
+    }
+    params->selector = *selector;
+  }
+  // browser: an XPath, a state and a frame for either.
+  if (const std::optional<std::string>& xpath = until->GetXpath()) {
+    if (xpath->empty()) {
+      return Response::InvalidParams("until.xpath is empty");
+    }
+    if (params->selector) {
+      return Response::InvalidParams(
+          "until takes a selector or an xpath, not both");
+    }
+    params->xpath = *xpath;
+  }
+  const bool css_or_xpath = params->selector || params->xpath;
+  if (const std::optional<std::string>& state = until->GetState()) {
+    if (!css_or_xpath) {
+      return Response::InvalidParams(
+          "until.state needs a selector or an xpath");
+    }
+    using State = blink::mojom::AgentUntilState;
+    if (*state == Page::Until::StateEnum::Attached) {
+      params->state = State::kAttached;
+    } else if (*state == Page::Until::StateEnum::Box) {
+      params->state = State::kBox;
+    } else if (*state == Page::Until::StateEnum::Visible) {
+      params->state = State::kVisible;
+    } else if (*state == Page::Until::StateEnum::Hidden) {
+      params->state = State::kHidden;
+    } else {
+      return Response::InvalidParams(
+          "until.state is attached, box, visible or hidden");
+    }
+  }
+  if (const std::optional<std::string>& frame = until->GetFrameId()) {
+    if (!css_or_xpath) {
+      return Response::InvalidParams(
+          "until.frameId needs a selector or an xpath");
+    }
+    params->frame_token = *frame;
+  }
+  // Every frame of the page hidden would need every local root's answer at
+  // once: a hidden wait is held to one frame.
+  if (params->state == blink::mojom::AgentUntilState::kHidden &&
+      !params->frame_token) {
+    return Response::InvalidParams("until.state hidden needs a frameId");
+  }
+  if (const std::optional<std::string>& contains = until->GetUrlContains()) {
+    if (contains->empty()) {
+      return Response::InvalidParams("until.urlContains is empty");
+    }
+    params->url_contains = *contains;
+  }
+  params->url_changed = until->GetUrlChanged(false);
+  params->new_tab = until->GetNewTab(false);
+  // browser.
+  params->appeared = until->GetAppeared(false);
+  params->has_until =
+      params->text || params->selector || params->xpath || params->appeared ||
+      until->GetGoneAgentNodeId().has_value() || params->url_changed ||
+      params->url_contains || params->new_tab;
+  if (!params->has_until) {
+    return Response::InvalidParams("until names nothing to wait for");
+  }
+  return Response::Success();
+}
+
+// static
+void SettleJoin::Start(Params params,
+                       SettleArm& arm,
+                       base::WeakPtr<ActionOutcomeWatch> watch,
+                       const std::vector<RenderFrameHostImpl*>& local_roots,
+                       std::unique_ptr<Callback> callback) {
+  scoped_refptr<SettleJoin> join = base::WrapRefCounted(
+      new SettleJoin(std::move(params), arm.GetWeakPtr(), std::move(watch),
+                     arm.t(), arm.first_commit(), std::move(callback)));
+  join->self_ = join;
+  arm.AddJoin(join->weak_factory_.GetWeakPtr());
+  join->Begin(arm, local_roots);
+}
+
+SettleJoin::SettleJoin(Params params,
+                       base::WeakPtr<SettleArm> arm,
+                       base::WeakPtr<ActionOutcomeWatch> watch,
+                       base::TimeTicks t0,
+                       base::TimeTicks first_commit,
+                       std::unique_ptr<Callback> callback)
+    : params_(std::move(params)),
+      arm_(std::move(arm)),
+      watch_(std::move(watch)),
+      t0_(t0),
+      first_commit_(first_commit),
+      callback_(std::move(callback)) {
+  // browser: one lookup per change instead of a scan of the listing; the
+  // first label of a node wins, as the scan's first match did.
+  std::vector<std::pair<std::pair<GlobalRenderFrameHostId, int32_t>, size_t>>
+      index;
+  index.reserve(params_.labels.size());
+  for (size_t i = 0; i < params_.labels.size(); ++i) {
+    index.emplace_back(
+        std::make_pair(params_.labels[i].local_root, params_.labels[i].node_id),
+        i);
+  }
+  label_index_ =
+      base::flat_map<std::pair<GlobalRenderFrameHostId, int32_t>, size_t>(
+          std::move(index));
+}
+
+SettleJoin::~SettleJoin() = default;
+
+void SettleJoin::Begin(SettleArm& arm,
+                       const std::vector<RenderFrameHostImpl*>& local_roots) {
+  started_ = base::TimeTicks::Now();
+  for (RenderFrameHostImpl* frame : local_roots) {
+    bool late = false;
+    if (scoped_refptr<SettleRenderer> renderer =
+            arm.RendererFor(frame, &late)) {
+      AddParticipant(std::move(renderer), late);
+    }
+  }
+  if (!params_.has_until) {
+    StartSettle();
+    return;
+  }
+  if (params_.gone_now || GoneOwnerLeft()) {
+    UntilMet(started_, std::nullopt);
+    return;
+  }
+  if (std::optional<base::TimeTicks> at = BrowserUntilAt()) {
+    UntilMet(*at, std::nullopt);
+    return;
+  }
+  phase_ = Phase::kUntil;
+  for (size_t i = 0; i < participants_.size(); ++i) {
+    if (blink::mojom::AgentUntilPtr until = UntilFor(participants_[i])) {
+      Await(i, std::move(until), base::TimeTicks());
+    }
+  }
+  until_timer_.Start(
+      FROM_HERE, params_.timeout,
+      base::BindOnce(&SettleJoin::OnUntilTimeout, base::Unretained(this)));
+}
+
+size_t SettleJoin::AddParticipant(scoped_refptr<SettleRenderer> renderer,
+                                  bool late) {
+  Participant participant;
+  participant.t = renderer->t;
+  participant.committed_after_arm = renderer->committed_after_arm;
+  participant.late = late;
+  participant.owns_gone =
+      params_.gone_node_id != 0 && renderer->frame == params_.gone_root;
+  participant.renderer = std::move(renderer);
+  participants_.push_back(std::move(participant));
+  return participants_.size() - 1;
+}
+
+bool SettleJoin::HasParticipant(const SettleRenderer& renderer) const {
+  return std::ranges::any_of(participants_,
+                             [&renderer](const Participant& participant) {
+                               return participant.renderer.get() == &renderer;
+                             });
+}
+
+SettleArm* SettleJoin::CurrentArm() const {
+  return arm_ && arm_->id() == params_.arm_id ? arm_.get() : nullptr;
+}
+
+blink::mojom::AgentUntilPtr SettleJoin::UntilFor(
+    const Participant& participant) const {
+  // DOMNodeIds are per process: the gone element goes to its own local root.
+  const int32_t gone = participant.owns_gone ? params_.gone_node_id : 0;
+  if (!params_.text && !params_.selector && !params_.xpath &&
+      !params_.appeared && gone == 0) {
+    return nullptr;
+  }
+  return blink::mojom::AgentUntil::New(params_.text, params_.selector, gone,
+                                       params_.xpath, params_.state,
+                                       params_.frame_token, params_.appeared);
+}
+
+std::optional<base::TimeTicks> SettleJoin::BrowserUntilAt() const {
+  SettleArm* arm = CurrentArm();
+  if (!arm) {
+    return std::nullopt;
+  }
+  std::optional<base::TimeTicks> first;
+  const auto take = [&first](std::optional<base::TimeTicks> at) {
+    if (at && (!first || *at < *first)) {
+      first = at;
+    }
+  };
+  if (params_.url_changed) {
+    take(arm->UrlChangedAt());
+  }
+  if (params_.url_contains) {
+    take(arm->UrlContainsAt(*params_.url_contains));
+  }
+  if (params_.new_tab) {
+    take(arm->NewTabAt());
+  }
+  return first;
+}
+
+// The cap runs from T; from this call, which comes after the action's
+// events have all been sent (its command answered first), so a long typing
+// session or path leaves the whole cap after its last event; from the main
+// frame's first commit since, once (spec 4); and from when `until` was met
+// (spec 7).
+base::TimeTicks SettleJoin::SettleDeadline() const {
+  base::TimeTicks from = std::max(t0_, started_);
+  if (until_met_) {
+    from = std::max(from, until_at_);
+  }
+  if (!first_commit_.is_null()) {
+    from = std::max(from, first_commit_);
+  }
+  return from + params_.cap;
+}
+
+std::optional<GURL> SettleJoin::PendingNavigation() const {
+  return watch_ ? watch_->PendingNavigation(params_.arm_id) : std::nullopt;
+}
+
+bool SettleJoin::GoneOwnerLeft() const {
+  return params_.gone_node_id != 0 &&
+         std::ranges::none_of(participants_, [](const Participant& p) {
+           return p.owns_gone && !p.gone;
+         });
+}
+
+void SettleJoin::Await(size_t index,
+                       blink::mojom::AgentUntilPtr until,
+                       base::TimeTicks deadline) {
+  Participant& participant = participants_[index];
+  ++participant.generation;
+  if (until) {
+    participant.until_generation = participant.generation;
+  }
+  participant.reading.reset();
+  if (participant.gone || !participant.renderer->collector.is_connected()) {
+    participant.gone = true;
+    participant.waiting = false;
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeTicks fresh =
+      now + std::max(params_.quiet, kFreshRead) + kAwaitGrace;
+  int32_t cap_ms = CapMs(params_.cap);
+  participant.backstop = base::TimeTicks();
+  if (!until) {
+    // The renderer answers by T(there) + cap(there): the browser's deadline.
+    // One armed by this call needs a quiet window from now.
+    if (participant.late) {
+      deadline = std::max(deadline, fresh);
+    }
+    cap_ms = CapMs(deadline - participant.t);
+    participant.backstop =
+        std::max(deadline, fresh) + kSlack +
+        (params_.report ? kSettleReportWait : base::TimeDelta());
+  }
+  participant.waiting = true;
+  // browser: every wait asks for the report: the frame that meets
+  // `until` answers in that wait, settled after it. The renderer reads none
+  // for an answer this no longer waits for (one replaced, or an `until` wait
+  // answered unmet).
+  blink::mojom::AgentReportOptionsPtr report =
+      params_.report ? SettleReportOptions(/*layers=*/true) : nullptr;
+  // browser: the control census, when the settle asked for it.
+  if (report) {
+    report->controls = params_.controls;
+  }
+  participant.renderer->collector->AwaitSettle(
+      params_.arm_id, static_cast<int32_t>(params_.quiet.InMilliseconds()),
+      cap_ms, std::move(until), std::move(report),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&SettleJoin::OnReading, weak_factory_.GetWeakPtr(),
+                         index, participant.generation),
+          blink::mojom::AgentSettleReadingPtr()));
+}
+
+void SettleJoin::OnReading(size_t index,
+                           int generation,
+                           blink::mojom::AgentSettleReadingPtr reading) {
+  if (phase_ == Phase::kDone || index >= participants_.size()) {
+    return;
+  }
+  Participant& participant = participants_[index];
+  // An `until` wait's sighting counts after the timeout too: the renderer
+  // holds a seen `until` until the page settles after it, so one seen in the
+  // last cap before the timeout, on a page still changing, answers only when
+  // OnUntilTimeout replaced its wait (a stale answer, dropped below) or the
+  // arm's end disarmed it (the current one).
+  if (phase_ == Phase::kTimedOut && reading && reading->until_seen &&
+      !until_met_ && !participant.gone &&
+      generation == participant.until_generation) {
+    until_met_ = true;
+    const int64_t until_ms =
+        ReadingMs(reading->until_ms, participant.t, base::TimeTicks::Now());
+    until_at_ = participant.t + base::Milliseconds(until_ms);
+  }
+  if (generation != participant.generation || !participant.waiting) {
+    // An answer to a wait replaced since (the new one answers it first).
+    return;
+  }
+  participant.waiting = false;
+  if (!reading) {
+    // Its pipe closed: its document, or its renderer, went away.
+    participant.gone = true;
+    if (phase_ == Phase::kUntil && GoneOwnerLeft()) {
+      UntilMet(base::TimeTicks::Now(), std::nullopt);
+      return;
+    }
+    Evaluate();
+    return;
+  }
+  if (reading->until_invalid) {
+    Fail(Response::InvalidParams(
+        params_.xpath
+            ? "until.xpath does not parse, or selects no nodes (a number, a "
+              "string or a boolean)"
+            : "until.selector is not a valid selector"));
+    return;
+  }
+  // At an `until`'s timeout too (a URL or tab wait longer than the
+  // renderer's 10 s lease outlives its arm), but never for an arm that has
+  // ended: ArmSettle with its id would take over a later arm's watcher.
+  if (NotArmed(*reading) && !participant.rearmed && CurrentArm()) {
+    // Its 10 s lease ran out between the arm and this call: armed again at
+    // its T, from a fresh baseline. Once.
+    participant.rearmed = true;
+    participant.late = true;
+    // Long after the action, it reads from now (RendererFor's rule).
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (now - participant.t > kStaleArm) {
+      participant.t = now;
+      participant.committed_after_arm = false;
+      participant.renderer->t = now;
+      participant.renderer->committed_after_arm = false;
+    }
+    // browser: a look's arm re-armed stays a look.
+    participant.renderer->collector->ArmSettle(params_.arm_id, participant.t,
+                                               CurrentArm()->look());
+    participant.renderer->armed = true;
+    if (phase_ == Phase::kUntil) {
+      Await(index, UntilFor(participant), base::TimeTicks());
+    } else {
+      // After an `until`'s timeout, one quiet window from now, not the cap.
+      Await(index, nullptr,
+            phase_ == Phase::kTimedOut ? base::TimeTicks::Now()
+                                       : SettleDeadline());
+      RestartDeadline();
+      // Await may have found it gone: nothing else would finish the call.
+      Evaluate();
+    }
+    return;
+  }
+  participant.reading = std::move(reading);
+  switch (phase_) {
+    case Phase::kUntil:
+      if (participant.reading->until_seen) {
+        // It has settled after it, in this same wait.
+        const int64_t until_ms =
+            ReadingMs(participant.reading->until_ms, participant.t,
+                      base::TimeTicks::Now());
+        UntilMet(participant.t + base::Milliseconds(until_ms), index);
+      }
+      // Not seen there (its rendering paused, a later arm took it): it waits
+      // no more. Another local root, a document still to come or the
+      // browser may still meet it before the timeout.
+      return;
+    case Phase::kTimedOut:
+      // The waits asked at the timeout carry no `until`; a sighting in an
+      // `until` wait is taken above.
+      Evaluate();
+      return;
+    case Phase::kSettle:
+    case Phase::kNavigation:
+      Evaluate();
+      return;
+    case Phase::kDone:
+      return;
+  }
+}
+
+// `until` is met: every local root that has not settled after it already is
+// awaited again, with no `until` (a wait still out answers first), the cap
+// from the moment it was met.
+void SettleJoin::UntilMet(base::TimeTicks at, std::optional<size_t> by) {
+  until_met_ = true;
+  until_at_ = at;
+  until_timer_.Stop();
+  phase_ = Phase::kSettle;
+  const base::TimeTicks deadline = SettleDeadline();
+  for (size_t i = 0; i < participants_.size(); ++i) {
+    if ((by && i == *by) || participants_[i].gone) {
+      continue;
+    }
+    Await(i, nullptr, deadline);
+  }
+  RestartDeadline();
+  Evaluate();
+}
+
+void SettleJoin::StartSettle() {
+  phase_ = Phase::kSettle;
+  const base::TimeTicks deadline = SettleDeadline();
+  for (size_t i = 0; i < participants_.size(); ++i) {
+    if (!participants_[i].gone) {
+      Await(i, nullptr, deadline);
+    }
+  }
+  RestartDeadline();
+  Evaluate();
+}
+
+void SettleJoin::RestartDeadline() {
+  base::TimeTicks latest;
+  for (const Participant& participant : participants_) {
+    if (participant.waiting && !participant.gone) {
+      latest = std::max(latest, participant.backstop);
+    }
+  }
+  if (latest.is_null()) {
+    deadline_timer_.Stop();
+    return;
+  }
+  deadline_timer_.Start(
+      FROM_HERE, std::max(base::TimeDelta(), latest - base::TimeTicks::Now()),
+      base::BindOnce(&SettleJoin::OnDeadline, base::Unretained(this)));
+}
+
+void SettleJoin::Evaluate() {
+  if (std::ranges::any_of(participants_,
+                          [](const Participant& p) { return p.waiting; })) {
+    return;
+  }
+  switch (phase_) {
+    case Phase::kUntil:
+      // Waits for its timeout: a document still to come, or the browser,
+      // may meet it.
+    case Phase::kDone:
+      return;
+    case Phase::kTimedOut:
+      Finish();
+      return;
+    case Phase::kSettle:
+    case Phase::kNavigation:
+      break;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeTicks deadline = SettleDeadline();
+  if (now < deadline && PendingNavigation()) {
+    // The renderers are done and a navigation is not: it ends (its new
+    // document then joins), or the cap does.
+    phase_ = Phase::kNavigation;
+    deadline_timer_.Start(
+        FROM_HERE, deadline - now,
+        base::BindOnce(&SettleJoin::OnDeadline, base::Unretained(this)));
+    return;
+  }
+  Finish();
+}
+
+void SettleJoin::OnArmChanged() {
+  if (phase_ == Phase::kDone) {
+    return;
+  }
+  // Documents that left the page are no longer waited for.
+  for (Participant& participant : participants_) {
+    if (!participant.gone && !participant.renderer->Current()) {
+      participant.gone = true;
+      participant.waiting = false;
+      ++participant.generation;
+    }
+  }
+  SettleArm* arm = CurrentArm();
+  std::vector<size_t> joined;
+  if (arm) {
+    if (first_commit_ != arm->first_commit()) {
+      first_commit_ = arm->first_commit();
+    }
+    // A local root armed at its commit since joins, in the phase under way.
+    for (const scoped_refptr<SettleRenderer>& renderer : arm->renderers()) {
+      if (renderer->Current() && !HasParticipant(*renderer)) {
+        joined.push_back(AddParticipant(renderer, /*late=*/false));
+      }
+    }
+  }
+  switch (phase_) {
+    case Phase::kUntil:
+      if (!arm) {
+        // The arm ended (its action dropped, the tab gone): no wait more.
+        OnUntilTimeout();
+        return;
+      }
+      if (GoneOwnerLeft()) {
+        UntilMet(base::TimeTicks::Now(), std::nullopt);
+        return;
+      }
+      if (std::optional<base::TimeTicks> at = BrowserUntilAt()) {
+        UntilMet(*at, std::nullopt);
+        return;
+      }
+      for (size_t index : joined) {
+        if (blink::mojom::AgentUntilPtr until =
+                UntilFor(participants_[index])) {
+          Await(index, std::move(until), base::TimeTicks());
+        }
+      }
+      return;
+    case Phase::kTimedOut:
+      // A document that joined since the timeout is read too: "settled
+      // without it" must not leave a frame unread.
+      if (!joined.empty()) {
+        for (size_t index : joined) {
+          // Armed at its commit, moments ago: one quiet window from now.
+          participants_[index].late = true;
+          Await(index, nullptr, base::TimeTicks::Now());
+        }
+        RestartDeadline();
+      }
+      Evaluate();
+      return;
+    case Phase::kSettle: {
+      const base::TimeTicks deadline = SettleDeadline();
+      for (size_t index : joined) {
+        Await(index, nullptr, deadline);
+      }
+      RestartDeadline();
+      Evaluate();
+      return;
+    }
+    case Phase::kNavigation:
+      if (!joined.empty() || !PendingNavigation()) {
+        // A new document to wait for, or the navigation ended with none
+        // here: every local root is looked at again.
+        StartSettle();
+        return;
+      }
+      // A commit may have moved the cap.
+      Evaluate();
+      return;
+    case Phase::kDone:
+      return;
+  }
+}
+
+// `until` was not met in time. Every local root is asked again, with no
+// `until`, whether the page has settled without it: a wait still out answers
+// first (that answer is dropped, a newer wait having replaced it), and a
+// renderer not waited on -- the `until` was the browser's own, a URL or a
+// tab -- reads the page now. The renderers are disarmed when the answer
+// goes (Finish).
+void SettleJoin::OnUntilTimeout() {
+  if (phase_ != Phase::kUntil) {
+    return;
+  }
+  phase_ = Phase::kTimedOut;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!CurrentArm()) {
+    // The arm ended (its action dropped, the tab gone): its renderers were
+    // disarmed with it, which answers them, and there is no arm to ask again.
+    for (Participant& participant : participants_) {
+      if (participant.waiting && !participant.gone) {
+        Disarm(participant);
+      }
+    }
+    deadline_timer_.Start(
+        FROM_HERE, kSlack,
+        base::BindOnce(&SettleJoin::OnDeadline, base::Unretained(this)));
+    Evaluate();
+    return;
+  }
+  for (size_t i = 0; i < participants_.size(); ++i) {
+    if (!participants_[i].gone) {
+      // One re-arm for this phase too: a renderer idle through the wait may
+      // have outlived its lease again.
+      participants_[i].rearmed = false;
+      // One quiet window from now, as for a renderer armed by the call: the
+      // bare grace would leave a request that had just ended no time to
+      // settle.
+      participants_[i].late = true;
+      Await(i, nullptr, now);
+    }
+  }
+  RestartDeadline();
+  Evaluate();
+}
+
+void SettleJoin::OnDeadline() {
+  if (phase_ == Phase::kSettle || phase_ == Phase::kNavigation ||
+      phase_ == Phase::kTimedOut) {
+    Finish();
+  }
+}
+
+void SettleJoin::Disarm(Participant& participant) {
+  SettleRenderer& renderer = *participant.renderer;
+  if (renderer.armed && renderer.collector.is_connected()) {
+    renderer.collector->DisarmSettle(params_.arm_id);
+  }
+  // The next call on this arm arms it again.
+  renderer.armed = false;
+}
+
+void SettleJoin::Finish() {
+  if (phase_ == Phase::kDone) {
+    return;
+  }
+  const Phase was = phase_;
+  phase_ = Phase::kDone;
+  until_timer_.Stop();
+  deadline_timer_.Stop();
+  const base::TimeTicks now = base::TimeTicks::Now();
+
+  auto changing = std::make_unique<Array<Page::SettleChange>>();
+  // browser: `unanswered` marks a frame that gave no
+  // reading, so a reader need not match its words.
+  const auto add = [&changing](const std::string& kind, const std::string& what,
+                               bool meanwhile, bool unanswered = false) {
+    if (changing->size() >= kMaxChanging) {
+      return;
+    }
+    for (const std::unique_ptr<Page::SettleChange>& kept : *changing) {
+      if (kept->GetKind() == kind && kept->GetWhat() == what) {
+        return;
+      }
+    }
+    std::unique_ptr<Page::SettleChange> change =
+        Page::SettleChange::Create().SetKind(kind).SetWhat(what).Build();
+    if (meanwhile) {
+      change->SetMeanwhile(true);
+    }
+    if (unanswered) {
+      change->SetUnanswered(true);
+    }
+    changing->push_back(std::move(change));
+  };
+
+  // Settled: every renderer settled, no navigation pending, and `until` met
+  // before the settle that followed it -- or, not met in time, every renderer
+  // settled without it (the waits asked at the timeout).
+  bool settled = was == Phase::kTimedOut || !params_.has_until || until_met_;
+  if (std::optional<GURL> pending = PendingNavigation()) {
+    settled = false;
+    add("navigation", PendingWhat(*pending), false);
+  }
+  bool paused = false;
+  bool answered = false;
+  // browser: what the frames showed more, or fewer, than at the arm --
+  // told only when every one that answered counted both -- and whether any
+  // frame's DOM moved since.
+  int shown_change = 0;
+  bool shown_counted = true;
+  bool dom_changed = false;
+  double after_ms =
+      first_commit_.is_null()
+          ? 0
+          : std::max(0.0, (first_commit_ - t0_).InMillisecondsF());
+  for (const Participant& participant : participants_) {
+    if (participant.gone) {
+      continue;
+    }
+    if (participant.waiting) {
+      settled = false;
+      add("lifecycle", participant.renderer->name + " did not answer", false,
+          /*unanswered=*/true);
+      continue;
+    }
+    if (!participant.reading) {
+      continue;
+    }
+    answered = true;
+    const blink::mojom::AgentSettleReading& reading = *participant.reading;
+    settled = settled && reading.settled;
+    paused = paused || reading.rendering_paused;
+    shown_counted = shown_counted && reading.shown_counted;
+    shown_change = base::ClampAdd(shown_change, reading.shown_change);
+    dom_changed = dom_changed || reading.dom_changed;
+    // From T: a document armed at its commit counts the commit as a change.
+    const int64_t last_change_ms =
+        ReadingMs(reading.last_change_ms, participant.t, now);
+    if (last_change_ms > 0 || participant.committed_after_arm) {
+      after_ms = std::max(
+          after_ms, (participant.t - t0_).InMillisecondsF() + last_change_ms);
+    }
+    for (const blink::mojom::AgentChangingPtr& item : reading.changing) {
+      add(item->kind, Name(participant, *item), item->meanwhile);
+    }
+  }
+  if (!answered) {
+    settled = false;
+    add("lifecycle", "no frame of the page answered", false,
+        /*unanswered=*/true);
+  }
+  if (settled) {
+    // Settled after `until` was seen, never before it (never "seen after
+    // 1.0s; settled after 0.0s").
+    if (until_met_) {
+      after_ms = std::max(after_ms, (until_at_ - t0_).InMillisecondsF());
+    }
+  } else {
+    // Not settled: when the browser stopped waiting, which the reply's
+    // "still changing at" names.
+    after_ms = std::max(0.0, (now - t0_).InMillisecondsF());
+  }
+
+  std::unique_ptr<Page::SettleReport> report =
+      Page::SettleReport::Create()
+          .SetSettled(settled)
+          .SetAfterMs(after_ms)
+          .SetStillChanging(std::move(changing))
+          .Build();
+  if (paused) {
+    report->SetRenderingPaused(true);
+  }
+  if (!first_commit_.is_null()) {
+    report->SetNavigated(true);
+  }
+  // browser.
+  if (answered && shown_counted) {
+    report->SetShownChange(shown_change);
+  }
+  if (dom_changed) {
+    report->SetDomChanged(true);
+  }
+  if (params_.brought_forward) {
+    report->SetBroughtForward(true);
+  }
+  std::optional<bool> until_seen;
+  std::optional<double> until_after_ms;
+  if (params_.has_until) {
+    until_seen = until_met_;
+    if (until_met_) {
+      until_after_ms = std::max(0.0, (until_at_ - t0_).InMillisecondsF());
+    }
+  }
+  // An `until` answered: the renderers are disarmed (spec 7); a later call on
+  // this arm arms them again.
+  if (params_.has_until) {
+    for (Participant& participant : participants_) {
+      if (!participant.gone) {
+        Disarm(participant);
+      }
+    }
+  }
+  // browser: the per-action report, from each renderer's part, before
+  // the call lets go of itself.
+  std::unique_ptr<Page::AgentActionReport> action_report;
+  if (params_.report && params_.assemble_report) {
+    std::vector<SettleReportPart> parts;
+    for (Participant& participant : participants_) {
+      if (participant.gone) {
+        continue;
+      }
+      // One still waiting, or answering without it, gives a part with no
+      // report.
+      SettleReportPart part;
+      part.frame = participant.renderer->frame;
+      if (participant.reading) {
+        part.report = std::move(participant.reading->report);
+      }
+      parts.push_back(std::move(part));
+    }
+    action_report = std::move(params_.assemble_report).Run(std::move(parts));
+  }
+  std::unique_ptr<Callback> callback = std::move(callback_);
+  Close();
+  callback->sendSuccess(std::move(report), until_seen, until_after_ms,
+                        std::move(action_report));
+}
+
+void SettleJoin::Fail(const Response& response) {
+  if (phase_ == Phase::kDone) {
+    return;
+  }
+  phase_ = Phase::kDone;
+  until_timer_.Stop();
+  deadline_timer_.Stop();
+  for (Participant& participant : participants_) {
+    if (!participant.gone) {
+      Disarm(participant);
+    }
+  }
+  std::unique_ptr<Callback> callback = std::move(callback_);
+  Close();
+  callback->sendFailure(response);
+}
+
+void SettleJoin::Close() {
+  // A wait still out answers into nothing: its pipe may close below.
+  weak_factory_.InvalidateWeakPtrs();
+  std::vector<Participant> participants = std::move(participants_);
+  participants_.clear();
+  participants.clear();
+  base::SequencedTaskRunner::GetCurrentDefault()->ReleaseSoon(FROM_HERE,
+                                                              std::move(self_));
+}
+
+std::string SettleJoin::Name(const Participant& participant,
+                             const blink::mojom::AgentChanging& item) const {
+  if (item.node_id == 0) {
+    return item.what;
+  }
+  const auto found = label_index_.find(
+      std::make_pair(participant.renderer->frame, item.node_id));
+  if (found == label_index_.end()) {
+    return item.what;
+  }
+  const Label& label = params_.labels[found->second];
+  // A changed element by its mark alone: the label's name is the last
+  // listing's, and may be what changed (a1 "tick 36" above a
+  // listing reading "tick 89").
+  const bool changed = item.kind == "mutation" &&
+                       std::string_view(item.what).ends_with(" (changed)");
+  return Relabel(item.what, changed ? label.mark : LabelText(label),
+                 item.kind == "animation");
+}
