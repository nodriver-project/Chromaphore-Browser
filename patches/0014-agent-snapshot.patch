+// One local root's document, armed for a settle: the collector's pipe the arm
+// went on (every wait for it goes on the same pipe, so it arrives after the
+// arm), and T there.
+struct SettleRenderer : public base::RefCounted<SettleRenderer> {
+  SettleRenderer();
+  SettleRenderer(const SettleRenderer&) = delete;
+  SettleRenderer& operator=(const SettleRenderer&) = delete;
+
+  // Still its frame's document, and that frame still a live local root of
+  // the page.
+  bool Current() const;
+
+  GlobalRenderFrameHostId frame;
+  blink::DocumentToken document;
+  // T for this document: the arm's, or its commit's when it committed after
+  // the arm.
+  base::TimeTicks t;
+  bool committed_after_arm = false;
+  // ArmSettle went out on `collector`, and no DisarmSettle since.
+  bool armed = false;
+  // "main" or "frame <host>": for a frame that did not answer.
+  std::string name;
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+
+ private:
+  friend class base::RefCounted<SettleRenderer>;
+  ~SettleRenderer();
+};
