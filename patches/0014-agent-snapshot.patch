+// browser: what a carry reading knows of the wheel along an axis, for
+// WheelStation: the scrollers that hold the target, innermost first, the way
+// the need asks the wheel to turn, and which of them move the target toward
+// it (CarryNeed's movers).
+struct AgentSnapshotCollectorImpl::WheelBinder {
+  STACK_ALLOCATED();
+
+ public:
+  HeapVector<Member<const LayoutBox>> chain;
+  bool vertical = true;
+  double toward = 0;
+  wtf_size_t movers_from = 0;
+  wtf_size_t movers_to = 0;
+};
+
+// browser: what one WheelScrollerAt asks, in the terms the read takes.
+struct AgentSnapshotCollectorImpl::WheelAsk {
+  double x = 0;
+  double y = 0;
+  WheelAxis axis = WheelAxis::kDown;
+  WheelWay way = WheelWay::kForward;
+  int32_t scroller_id = 0;
+  WheelLatchCheck latch_check = WheelLatchCheck::kSkip;
+  WheelPastFrame past = WheelPastFrame::kStop;
+  WheelLayout layout = WheelLayout::kAsIs;
+};
+
+// static
+const char AgentSnapshotCollectorImpl::kSupplementName[] =
+    "AgentSnapshotCollectorImpl";
+
+// static
+AgentSnapshotCollectorImpl* AgentSnapshotCollectorImpl::From(
+    Document& document) {
+  return Supplement<Document>::From<AgentSnapshotCollectorImpl>(document);
+}
+
+// static
+void AgentSnapshotCollectorImpl::BindReceiver(
+    LocalFrame* frame,
+    mojo::PendingReceiver<mojom::blink::AgentSnapshotCollector> receiver) {
+  DCHECK(frame && frame->GetDocument());
+  auto& document = *frame->GetDocument();
+  auto* collector = AgentSnapshotCollectorImpl::From(document);
+  if (!collector) {
+    collector = MakeGarbageCollected<AgentSnapshotCollectorImpl>(
+        base::PassKey<AgentSnapshotCollectorImpl>(), *frame);
+    Supplement<Document>::ProvideTo(document, collector);
+  }
+  collector->Bind(std::move(receiver));
+}
+
+AgentSnapshotCollectorImpl::AgentSnapshotCollectorImpl(
+    base::PassKey<AgentSnapshotCollectorImpl>,
+    LocalFrame& frame)
+    : Supplement<Document>(*frame.GetDocument()),
+      receiver_set_(this, frame.DomWindow()) {}
+
+AgentSnapshotCollectorImpl::~AgentSnapshotCollectorImpl() = default;
+
+void AgentSnapshotCollectorImpl::Bind(
+    mojo::PendingReceiver<mojom::blink::AgentSnapshotCollector> receiver) {
+  receiver_set_.Add(
+      std::move(receiver),
+      GetSupplementable()->GetTaskRunner(TaskType::kInternalUserInteraction));
+}
+
+void AgentSnapshotCollectorImpl::Trace(Visitor* visitor) const {
+  visitor->Trace(receiver_set_);
+  visitor->Trace(watch_view_);
+  visitor->Trace(watch_counted_view_);
+  visitor->Trace(watch_target_holder_);
+  visitor->Trace(watch_grab_holder_);
+  visitor->Trace(settle_watcher_);
+  visitor->Trace(freeze_);
+  Supplement<Document>::Trace(visitor);
+  LocalFrameView::LifecycleNotificationObserver::Trace(visitor);
+}
+
+void AgentSnapshotCollectorImpl::CollectFrameElements(
+    mojom::blink::AgentSnapshotOptionsPtr options,
+    CollectFrameElementsCallback callback) {
+  auto result = mojom::blink::AgentFrameSnapshot::New();
+
+  LocalFrame* root_frame = GetSupplementable()->GetFrame();
+  Document* root_document = GetSupplementable();
+  if (!root_frame || !root_document || !root_document->documentElement() ||
+      !root_document->View()) {
+    // browser: nothing is listed, so every id the browser knows here is
+    // answered.
+    if (options) {
+      AppendUnlisted(root_frame, options->known_node_ids, Vector<int32_t>(),
+                     Vector<int32_t>(), result->unlisted);
+    }
+    // browser: a document with nothing in it may be blank.
+    if (root_document) {
+      result->document_blank = DocumentBlank(*root_document);
+    }
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  const mojom::blink::AgentOffscreenMode offscreen_mode =
+      options ? options->offscreen_mode
+              : mojom::blink::AgentOffscreenMode::kSummary;
+
+  // browser: the layer on top, when asked -- before any accessibility
+  // pass, whose frozen cache a hit test must not run under.
+  const bool layers =
+      options && options->layer_scope != mojom::blink::AgentLayerScope::kOff;
+  // browser: the layers alone, read as the per-action report reads them.
+  if (layers && options->layers_only) {
+    LayerScan scan;
+    ReadLayerStack(*root_frame, *root_document, scan, *result);
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  LayerScan layer_scan;
+  if (layers) {
+    DetectLayer(*root_frame, layer_scan);
+  }
+
+  // The browser calls this on local roots only; same-process descendants are
+  // walked here with their boxes expressed in this local root's space.
+  HeapVector<Member<LocalFrame>> frames;
+  CollectSameProcessFrames(root_frame, frames);
+
+  Collected collected;
+  for (LocalFrame* frame : frames) {
+    CollectFrameDocumentElements(frame, offscreen_mode, collected);
+  }
+
+  Vector<bool> removed = CoincidentNestedElements(collected.kept);
+  LocalDOMWindow* root_window = root_frame->DomWindow();
+  const double root_width = root_window ? root_window->innerWidth() : 0;
+  const double root_height = root_window ? root_window->innerHeight() : 0;
+  DropUnnamedParts(collected.kept, collected.elements, removed, root_width,
+                   root_height);
+  DropEchoes(collected.kept, collected.elements, removed);
+  DropPartsOfControls(collected.kept, collected.elements, removed);
+  // browser: what this process lays over every part of a kept element a
+  // press could reach, within one budget of hit tests a capture.
+  int under_budget = kUnderBudget;
+  StaysPutReads stays_put;  // the mark's own
+  // Scope on: what a click cannot reach is left out (clickable = shown,
+  // unclickable = hidden), grouped by the stack entry
+  // holding its cover -- the cover, or its veil -- else by the cover itself.
+  const bool hide =
+      layers && options->layer_scope == mojom::blink::AgentLayerScope::kOn;
+  // A text field holding a value -- a card number, a password -- is never left
+  // out: its box must reach the screenshot's redaction, seen through a veil.
+  // Not a checkbox's, a button's or a select's value.
+  const auto holds_text = [](Element& element, const String& value) {
+    if (value.empty()) {
+      return false;
+    }
+    if (auto* input = DynamicTo<HTMLInputElement>(element)) {
+      return input->IsTextField();
+    }
+    return IsA<HTMLTextAreaElement>(element) || EditableByAttribute(element);
+  };
+  const auto entry_of = [&](const Element& cover) -> int {
+    for (wtf_size_t k = layer_scan.stack.size(); k-- > 0;) {
+      const wtf_size_t i = layer_scan.stack[k];
+      const int32_t veil = layer_scan.facts[i].veil_node_id;
+      if (HoldsAcross(*layer_scan.roots[i], cover) ||
+          (veil && static_cast<int32_t>(
+                       DOMNodeIds::ExistingIdForNode(&cover)) == veil)) {
+        return static_cast<int>(k);
+      }
+    }
+    return -1;
+  };
+  // The covers that hid a control: the stack entry's root (its key, the
+  // entry). Only a layer's: on a page alone, and under a layer's own parts, a
+  // control stays listed with its mark.
+  HeapVector<Member<Element>> cover_roots;
+  Vector<int> cover_entries;
+  // The open blocking layers' roots and veils, for
+  // UnderCover's one-layer test; and those of them that shut the page, each
+  // beside its layer's root, under which it reads no mark for what lies
+  // outside that layer.
+  HeapVector<Member<Element>> blocking_boxes;
+  HeapVector<Member<Element>> shut_boxes;
+  HeapVector<Member<Element>> shut_roots;
+  for (const wtf_size_t s : layer_scan.stack) {
+    if (!layer_scan.facts[s].blocking) {
+      continue;
+    }
+    const bool shuts = layer_scan.facts[s].shuts_page;
+    blocking_boxes.push_back(layer_scan.roots[s]);
+    if (shuts) {
+      shut_boxes.push_back(layer_scan.roots[s]);
+      shut_roots.push_back(layer_scan.roots[s]);
+    }
+    if (Element* veil_element = LayerVeilOf(layer_scan.facts[s])) {
+      blocking_boxes.push_back(veil_element);
+      if (shuts) {
+        shut_boxes.push_back(veil_element);
+        shut_roots.push_back(layer_scan.roots[s]);
+      }
+    }
+  }
+  // browser: the open layers' veils, each beside its layer's root and
+  // name, top layer first, for UnderCover to name a cover on a veil by its
+  // layer.
+  HeapVector<Member<Element>> veil_boxes;
+  HeapVector<Member<Element>> veil_roots;
+  Vector<String> veil_names;
+  for (wtf_size_t k = layer_scan.stack.size(); k-- > 0;) {
+    const wtf_size_t s = layer_scan.stack[k];
+    if (Element* veil_element = LayerVeilOf(layer_scan.facts[s])) {
+      veil_boxes.push_back(veil_element);
+      veil_roots.push_back(layer_scan.roots[s]);
+      veil_names.push_back(
+          LayerKindName(layer_scan.facts[s].kind, layer_scan.facts[s].name));
+    }
+  }
+  // In view as the browser lists it: in its own frame's view, and some of its
+  // box -- in the local root's frame -- within the local root's view (a
+  // zero-height "skip target"; what an ad frame in this process holds below
+  // the fold, in view in that frame's own view, which the browser lists
+  // off-screen). As the browser takes it at page zoom 1, the size the
+  // sessions run at (page_handler.cc's TODO for other zooms).
+  const gfx::RectF root_view_rect(0, 0, static_cast<float>(root_width),
+                                  static_cast<float>(root_height));
+  const auto listed_in_view = [&](wtf_size_t i) {
+    const mojom::blink::AgentElementBox* in_box =
+        collected.elements[i]->box.get();
+    if (!collected.elements[i]->in_frame_viewport || !in_box) {
+      return false;
+    }
+    gfx::RectF shown = RectOf(*in_box);
+    shown.Intersect(root_view_rect);
+    return !shown.IsEmpty();
+  };
+  // browser: a control an open modal dialog or an element shown full
+  // screen shuts out (InertModal), which the walk kept for this: behind the
+  // modal's own blocking entry, told by no hit test, and marked under it. In
+  // view, with scope on, left out behind it -- save a text field holding a
+  // value, as below; off-screen, with scope on, left out behind it. The
+  // modal's root joins the covers that hid a control only when its page is
+  // not inert: under a modal the shut-out pass takes the text with no hit
+  // test. With no such entry, or the control's own entry not below it,
+  // dropped, as the walk drops an inert control.
+  Vector<bool> by_modal(collected.elements.size());
+  for (wtf_size_t i = 0; i < collected.elements.size(); ++i) {
+    if (removed[i] || !collected.elements[i]->interactive) {
+      continue;
+    }
+    Element& element = *collected.kept[i].element;
+    Element* modal = InertModal(element);
+    if (!modal) {
+      continue;
+    }
+    int at = -1;
+    for (wtf_size_t k = layer_scan.stack.size(); k-- > 0;) {
+      const wtf_size_t s = layer_scan.stack[k];
+      if (layer_scan.roots[s].Get() == modal && layer_scan.facts[s].blocking) {
+        at = static_cast<int>(k);
+        break;
+      }
+    }
+    if (at < 0 || InnermostEntry(layer_scan, element) >= at) {
+      removed[i] = true;
+      continue;
+    }
+    by_modal[i] = true;
+    collected.elements[i]->shut_out = true;
+    const LayerFacts& facts = layer_scan.facts[layer_scan.stack[at]];
+    const bool in_view = listed_in_view(i);
+    // browser: off-screen too -- behind it wherever a reveal brings
+    // it, which is not so of what lies under a veil.
+    collected.elements[i]->under =
+        CoverWhere(*modal, element, LayerKindName(facts.kind, facts.name));
+    collected.elements[i]->under_layer = at;
+    if (!hide ||
+        (in_view && holds_text(element, collected.elements[i]->value))) {
+      continue;
+    }
+    collected.elements[i]->hidden = true;
+    collected.elements[i]->hidden_layer = at;
+    collected.elements[i]->hidden_behind = facts.name;
+    Element* key = layer_scan.roots[layer_scan.stack[at]].Get();
+    if (in_view && !facts.page_inert && !cover_roots.Contains(key)) {
+      cover_roots.push_back(key);
+      cover_entries.push_back(at);
+    }
+  }
+  for (wtf_size_t i = 0; i < collected.elements.size(); ++i) {
+    if (removed[i] || by_modal[i] || !collected.elements[i]->interactive ||
+        !listed_in_view(i)) {
+      continue;
+    }
+    Element& element = *collected.kept[i].element;
+    Element* cover = nullptr;
+    bool untold = false;
+    bool five_only = false;
+    bool unshown = false;
+    // browser: whether the test told its reach (reach_told). UnderCover
+    // says `untold` for StaysPutOver's want only; it answers nothing and does
+    // not say so before the page's first layout or while its lifecycle
+    // updates are held (hit tests then find nothing), with no hit test left
+    // at its start, or once its grid runs out of them -- which the view and
+    // the budget it leaves tell here (a test that reached on its very last
+    // hit test counts as not told too).
+    const LocalFrameView* under_view = root_frame->View();
+    const bool had_budget = under_budget > 0 && under_view &&
+                            under_view->DidFirstLayout() &&
+                            under_view->LifecycleUpdatesActive();
+    const String under = UnderCover(
+        *root_frame, element, under_budget, stays_put, &cover, &untold,
+        /*look_five=*/!layer_scan.stack.empty(), &five_only,
+        blocking_boxes.empty() ? nullptr : &blocking_boxes, &unshown,
+        shut_boxes.empty() ? nullptr : &shut_boxes,
+        shut_boxes.empty() ? nullptr : &shut_roots,
+        veil_boxes.empty() ? nullptr : &veil_boxes,
+        veil_boxes.empty() ? nullptr : &veil_roots,
+        veil_boxes.empty() ? nullptr : &veil_names);
+    if (untold || !had_budget || (under.empty() && under_budget <= 0)) {
+      collected.elements[i]->reach_told = false;
+    }
+    const int own = InnermostEntry(layer_scan, element);
+    const int entry = cover ? entry_of(*cover) : -1;
+    // Not told by the mark for want of its hit tests (`untold`): no mark, as
+    // for want of the grid's -- a bare one says a click is refused, and a
+    // sticky column's rows past the mark's budget belie it. Save behind a
+    // blocking layer above its own: a scroll seldom takes it out from under
+    // there, and the mark names what it is behind.
+    const bool behind_blocking =
+        entry > own && layer_scan.facts[layer_scan.stack[entry]].blocking;
+    // An SVG shape or one taking no press is marked only behind a layer,
+    // never on a page alone.
+    if (!under.empty() && (!untold || behind_blocking) &&
+        (!five_only || entry > own)) {
+      collected.elements[i]->under = under;
+      // browser: the entry its cover lies in, its own included.
+      collected.elements[i]->under_layer = entry;
+    }
+    if (!hide) {
+      continue;
+    }
+    // No reveal brings it out from under (not "stays put", and not untold
+    // for want of hit tests), not a scrollbar (no cover element), and an
+    // entry above its own over it: out of reach. Never a text field holding
+    // a value (holds_text).
+    const bool stays = under.ends_with(" (stays put)");
+    const bool holds = holds_text(element, collected.elements[i]->value);
+    int behind = entry;
+    bool out =
+        cover && !untold && !under.empty() && !stays && !holds && entry > own;
+    // Nothing of it shows -- a skip link in a 0-px nav, an ad clipped away --
+    // so no press reaches it: out behind a blocking layer above its own when
+    // that layer is what lies at the middle of its box in view (one hit test,
+    // from UnderCover's budget, and only with such a layer open).
+    bool blocking_above = false;
+    for (wtf_size_t k = static_cast<wtf_size_t>(own + 1);
+         k < layer_scan.stack.size() && !blocking_above; ++k) {
+      blocking_above = layer_scan.facts[layer_scan.stack[k]].blocking;
+    }
+    if (!out && unshown && !holds && blocking_above) {
+      // browser: with no hit test left it cannot tell (reach_told).
+      if (under_budget <= 0) {
+        collected.elements[i]->reach_told = false;
+      }
+      Element* there = AtBoxMiddle(*root_frame, element, under_budget);
+      const int at_entry = there ? entry_of(*there) : -1;
+      if (at_entry > own &&
+          layer_scan.facts[layer_scan.stack[at_entry]].blocking) {
+        out = true;
+        behind = at_entry;
+      }
+    }
+    if (!out) {
+      continue;
+    }
+    collected.elements[i]->hidden = true;
+    collected.elements[i]->hidden_layer = behind;
+    // The layer's name as well, for a browser that does not take this local
+    // root's entries (its frame gate).
+    collected.elements[i]->hidden_behind =
+        layer_scan.facts[layer_scan.stack[behind]].name;
+    Element* key = layer_scan.roots[layer_scan.stack[behind]].Get();
+    if (!cover_roots.Contains(key)) {
+      cover_roots.push_back(key);
+      cover_entries.push_back(behind);
+    }
+  }
+  // Text in view whose middle lies under a cover that hid a control
+  // (one read-only hit test each), and what is off-screen behind the top
+  // blocking entry when it shuts the page off.
+  if (hide) {
+    int text_budget = kHiddenTextBudget;
+    LocalFrameView* root_view = root_frame->View();
+    for (wtf_size_t i = 0;
+         i < collected.elements.size() && !cover_roots.empty() && root_view;
+         ++i) {
+      if (removed[i] || collected.elements[i]->interactive ||
+          !listed_in_view(i) || collected.elements[i]->hidden) {
+        continue;
+      }
+      // browser: past the budget the test is not run, and the text is
+      // not told (reach_told); the loop goes on to mark the rest so.
+      if (text_budget-- <= 0) {
+        collected.elements[i]->reach_told = false;
+        continue;
+      }
+      Element& element = *collected.kept[i].element;
+      const gfx::RectF shown = LayerShownOf(element, *root_frame);
+      if (shown.IsEmpty()) {
+        continue;
+      }
+      HitTestLocation location(
+          root_view->ConvertFromRootFrame(shown.CenterPoint()));
+      HitTestResult hit_result =
+          root_frame->GetEventHandler().HitTestResultAtLocation(
+              location, HitTestRequest::kReadOnly | HitTestRequest::kActive |
+                            HitTestRequest::kAllowChildFrameContent);
+      Element* hit = DragTargetOf(hit_result.InnerElement());
+      if (!hit || HoldsAcross(element, *hit) || HoldsAcross(*hit, element)) {
+        continue;
+      }
+      const int hit_entry = entry_of(*hit);
+      // The innermost entry holding the text itself: text inside a layer at
+      // or above the cover's is that layer's own (its sticky footer, a fade
+      // over its list), never behind it. Every cover is a layer's.
+      const int own_entry = InnermostEntry(layer_scan, element);
+      for (wtf_size_t c = 0; c < cover_roots.size(); ++c) {
+        if (own_entry >= cover_entries[c] || hit_entry != cover_entries[c]) {
+          continue;
+        }
+        collected.elements[i]->hidden = true;
+        collected.elements[i]->hidden_layer = cover_entries[c];
+        collected.elements[i]->hidden_behind =
+            layer_scan.facts[layer_scan.stack[cover_entries[c]]].name;
+        break;
+      }
+    }
+    int shut = -1;
+    bool inert_page = false;
+    for (wtf_size_t k = layer_scan.stack.size(); k-- > 0;) {
+      const LayerFacts& facts = layer_scan.facts[layer_scan.stack[k]];
+      if (facts.blocking) {
+        shut = facts.shuts_page ? static_cast<int>(k) : -1;
+        inert_page = facts.page_inert;
+        break;
+      }
+    }
+    // Off-screen, and -- behind a modal whose page is inert, where no cover is
+    // found (on a showModal) and its controls are put behind it
+    // above -- text in view too; not what that entry or one above it
+    // holds (a picker or a popover over the modal).
+    if (shut >= 0) {
+      for (wtf_size_t i = 0; i < collected.elements.size(); ++i) {
+        // In view as the browser lists it (listed_in_view).
+        const bool in_view = listed_in_view(i);
+        if (removed[i] || collected.elements[i]->hidden ||
+            (in_view && (!inert_page || collected.elements[i]->interactive))) {
+          continue;
+        }
+        bool held = false;
+        for (wtf_size_t k = static_cast<wtf_size_t>(shut);
+             k < layer_scan.stack.size() && !held; ++k) {
+          held = HoldsAcross(*layer_scan.roots[layer_scan.stack[k]],
+                             *collected.kept[i].element);
+        }
+        if (held) {
+          continue;
+        }
+        collected.elements[i]->hidden = true;
+        collected.elements[i]->hidden_layer = shut;
+        collected.elements[i]->hidden_behind =
+            layer_scan.facts[layer_scan.stack[shut]].name;
+      }
+    }
+  }
+  result->elements.ReserveInitialCapacity(collected.elements.size());
+  for (wtf_size_t i = 0; i < collected.elements.size(); ++i) {
+    if (!removed[i]) {
+      // The innermost entry holding it.
+      collected.elements[i]->layer =
+          InnermostEntry(layer_scan, *collected.kept[i].element);
+      result->elements.push_back(std::move(collected.elements[i]));
+    }
+  }
+  // The stack as the reply carries it, and this document's name and head.
+  if (layers) {
+    AppendLayerStack(layer_scan, frames, *root_frame, *root_document, *result);
+  }
+  // browser: the live regions pass 1 met that count now and say
+  // something; what they said since the last arm; and every id the browser
+  // knows here that this reply does not carry, with why (hidden elements are
+  // carried).
+  result->regions = ReadRegions(*root_frame, collected.region_roots,
+                                /*skip_locked=*/true);
+  result->heard = HeardReads(settle_watcher_.Get(), result->regions);
+  CapRegions(result->regions);
+  result->offscreen_node_ids = collected.offscreen_ids;
+  if (options) {
+    Vector<int32_t> returned;
+    returned.ReserveInitialCapacity(result->elements.size());
+    for (const mojom::blink::AgentElementPtr& element : result->elements) {
+      returned.push_back(element->backend_node_id);
+    }
+    AppendUnlisted(root_frame, options->known_node_ids, std::move(returned),
+                   std::move(collected.offscreen_ids), result->unlisted);
+  }
+  // browser: this local root's document scroll in CSS px, as
+  // LocalDOMWindow::scrollX()/scrollY() compute it (the layout viewport's
+  // web-exposed offset over the frame's layout zoom), without their forced
+  // layout: the walk above ran it. And its size, that viewport's contents,
+  // over the same zoom.
+  const LocalFrameView* root_view = root_document->View();
+  if (const PaintLayerScrollableArea* viewport =
+          root_view ? root_view->LayoutViewport() : nullptr) {
+    const ScrollOffset offset = viewport->GetWebExposedScrollOffset();
+    const float zoom = root_frame->LayoutZoomFactor();
+    result->scroll_x = offset.x() / zoom;
+    result->scroll_y = offset.y() / zoom;
+    const gfx::Size contents = viewport->ContentsSize();
+    result->content_width = static_cast<double>(contents.width()) / zoom;
+    result->content_height = static_cast<double>(contents.height()) / zoom;
+  }
+  // browser: the main scroller (MainScrollerOf), limited to what the top
+  // blocking layer holds only when layers were asked; whether the document is
+  // scroll locked, scope off too; and whether it is blank.
+  LocalFrameView* scroller_view = root_frame->View();
+  if (auto* widget =
+          static_cast<WebFrameWidgetImpl*>(root_frame->GetWidgetForLocalRoot());
+      widget && scroller_view) {
+    const RootDips dips(*scroller_view, *widget);
+    result->main_scroller =
+        MainScrollerOf(*root_frame, dips, layers ? &layer_scan : nullptr);
+  }
+  result->document_locked = DocumentScrollLocked(*root_document);
+  result->document_blank = DocumentBlank(*root_document);
+  std::move(callback).Run(std::move(result));
+}
+
+void AgentSnapshotCollectorImpl::ResolveNode(int32_t local_dom_node_id,
+                                             ResolveNodeCallback callback) {
+  // The mojo `box` field is non-nullable, so a not-found reply carries a
+  // zero box.
+  auto not_found = [&callback]() {
+    std::move(callback).Run(
+        /*found=*/false,
+        mojom::blink::AgentElementBox::New(0.0, 0.0, 0.0, 0.0));
+  };
+
+  // DOMNodeIds are process-global, so this also resolves nodes in the
+  // same-process subframes whose ids CollectFrameElements handed out -- and
+  // would resolve nodes of other pages, but for the ownership check.
+  Element* element =
+      OwnedElement(GetSupplementable()->GetFrame(), local_dom_node_id);
+  if (!element || !element->GetLayoutObject()) {
+    not_found();
+    return;
+  }
+  Document& document = element->GetDocument();
+  LocalFrame* frame = document.GetFrame();
+  if (!frame || !frame->View()) {
+    not_found();
+    return;
+  }
+
+  // Same layout update as the capture path; geometry only, no AX cache.
+  document.UpdateStyleAndLayout(DocumentUpdateReason::kInspector);
+  // Layout can run script and detach the element.
+  if (!element->GetLayoutObject()) {
+    not_found();
+    return;
+  }
+
+  // Local-root space, exactly as CollectFrameDocumentElements reports it.
+  DOMRect* rect = element->GetBoundingClientRect();
+  const gfx::PointF root_top_left =
+      frame->View()->ConvertToRootFrame(gfx::PointF(rect->x(), rect->y()));
+  std::move(callback).Run(
+      /*found=*/true,
+      mojom::blink::AgentElementBox::New(root_top_left.x(), root_top_left.y(),
+                                         rect->width(), rect->height()));
+}
