+        layer = page.index[k][control->layer];
+      }
+      if (layer < 0) {
+        layer = holder;
+      }
+      std::unique_ptr<Page::AgentControl> row =
+          Page::AgentControl::Create()
+              .SetBackendNodeId(control->node_id)
+              .SetLocalRootFrameId(frame_id)
+              .SetFrameId(frame_id)
+              .SetX(control->x)
+              .SetY(control->y)
+              .SetWidth(control->width)
+              .SetHeight(control->height)
+              .SetKind(control->button ? "button" : "field")
+              .SetRole(control->role)
+              .SetLabel(control->label)
+              .Build();
+      if (control->disabled) {
+        row->SetDisabled(true);
+      }
+      if (control->readonly) {
+        row->SetReadonly(true);
+      }
+      if (control->required) {
+        row->SetRequired(true);
+      }
+      if (control->checked) {
+        row->SetChecked(true);
+      }
+      if (control->secret) {
+        row->SetSecret(true);
+      }
+      if (layer >= 0) {
+        row->SetLayer(layer);
+      }
+      if (control->validity) {
+        row->SetInvalid(std::make_unique<protocol::Array<std::string>>(
+            InvalidReasonNames(control->validity->reasons)));
+        if (control->validity->error && !control->validity->error->empty()) {
+          row->SetError(*control->validity->error);
+        }
+      }
+      reply->emplace_back(std::move(row));
+    }
+  }
+  return reply;
+}
+
+// browser: why a renderer did not return a node the space knows.
+AgentVerdict AgentVerdictOf(blink::mojom::AgentUnlistedWhy why) {
+  if (why == blink::mojom::AgentUnlistedWhy::kCollected) {
+    return AgentVerdict::kCollected;
+  }
+  if (why == blink::mojom::AgentUnlistedWhy::kMoved) {
+    return AgentVerdict::kMoved;
+  }
+  if (why == blink::mojom::AgentUnlistedWhy::kDetached) {
+    return AgentVerdict::kDetached;
+  }
+  if (why == blink::mojom::AgentUnlistedWhy::kOffscreen) {
+    return AgentVerdict::kOffscreen;
+  }
+  return AgentVerdict::kUnlisted;
+}
+
+// browser: whether a local root's layers count for the page's stack, as
+// a capture counts them: the page's own frame, or one showing
+// kLayerFrameShowShare of the view.
+bool LayerFrameShows(RenderFrameHostImpl& rfh, const gfx::Size& view) {
+  if (rfh.IsOutermostMainFrame()) {
+    return true;
+  }
+  const double view_area = static_cast<double>(view.width()) * view.height();
+  gfx::RectF shown = ShownPartInRoot(rfh);
+  shown.Intersect(gfx::RectF(gfx::SizeF(view)));
+  return view_area > 0 &&
+         shown.width() * shown.height() >= view_area * kLayerFrameShowShare;
+}
+
+// browser: the page's stack as the id space keeps the last one read.
+AgentLastLayers LastLayersOf(const PageLayers& page,
+                             const std::vector<LayerFrame>& frames) {
+  AgentLastLayers last;
+  last.read_at = base::TimeTicks::Now();
+  for (const PageLayers::Entry& entry : page.entries) {
+    const blink::mojom::AgentLayer& layer =
+        *frames[entry.frame].snapshot->layers[entry.local];
+    AgentLastLayer kept;
+    kept.kind = layer.kind;
+    kept.name = entry.name;
+    kept.head = entry.head;
+    kept.how = layer.how;
+    kept.blocking = layer.blocking;
+    kept.node_id = layer.root_node_id;
+    kept.frame_id = frames[entry.frame].frame_id;
+    kept.animating_ms = layer.animating_ms;
+    last.layers.push_back(std::move(kept));
+  }
+  return last;
+}
+
+// browser: the stack to keep as the document's last: `now`, and what
+// was last read of each frame in `unread` (still in the page, its stack not
+// read this time, or not counted: it shows under a tenth of the view), so the
+// next report neither closes nor reopens what that frame holds.
+AgentLastLayers WithUnreadLayers(AgentLastLayers now,
+                                 const std::optional<AgentLastLayers>& last,
+                                 const base::flat_set<std::string>& unread) {
+  if (last) {
+    for (const AgentLastLayer& was : last->layers) {
+      if (unread.contains(was.frame_id)) {
+        now.layers.push_back(was);
+      }
+    }
+  }
+  return now;
+}
+
+// browser: a stored layer as the protocol says it.
+std::unique_ptr<Page::AgentLayer> LastLayerReply(const AgentLastLayer& layer) {
+  std::unique_ptr<Page::AgentLayer> reply = Page::AgentLayer::Create()
+                                                .SetKind(layer.kind)
+                                                .SetName(layer.name)
+                                                .SetHead(layer.head)
+                                                .SetHow(layer.how)
+                                                .SetBlocking(layer.blocking)
+                                                .SetNodeId(layer.node_id)
+                                                .SetFrameId(layer.frame_id)
+                                                .Build();
+  if (layer.animating_ms > 0) {
+    reply->SetAnimatingMs(layer.animating_ms);
+  }
+  return reply;
+}
+
+// browser: a stack read now against the document's last one, as the
+// protocol says it; each list null until LayerChangesSince fills it.
+struct LayerChanges {
+  // Indices into `now` of the layers the last read did not hold.
+  std::unique_ptr<protocol::Array<int>> opened;
+  // Of the last read, the layers not open now, as they were read then.
+  std::unique_ptr<protocol::Array<Page::AgentLayer>> closed;
+  // Of `now`, the layers kept since whose head changed.
+  std::unique_ptr<protocol::Array<Page::AgentLayerReworded>> reworded;
+};
+
+// browser: what a report or a call-start read tells of the stack: a
+// layer is the same one by its frame and node; one of a frame in `unread`
+// (still in the page, its stack not read this time, or not counted) is never
+// closed.
+LayerChanges LayerChangesSince(const AgentLastLayers& now,
+                               const AgentLastLayers& last,
+                               const base::flat_set<std::string>& unread) {
+  const auto same = [](const AgentLastLayer& a, const AgentLastLayer& b) {
+    return a.frame_id == b.frame_id && a.node_id == b.node_id;
+  };
+  LayerChanges changes;
+  changes.opened = std::make_unique<protocol::Array<int>>();
+  changes.closed = std::make_unique<protocol::Array<Page::AgentLayer>>();
+  changes.reworded =
+      std::make_unique<protocol::Array<Page::AgentLayerReworded>>();
+  for (size_t i = 0; i < now.layers.size(); ++i) {
+    auto was = std::ranges::find_if(last.layers, [&](const auto& kept) {
+      return same(kept, now.layers[i]);
+    });
+    if (was == last.layers.end()) {
+      changes.opened->push_back(base::checked_cast<int>(i));
+    } else if (was->head != now.layers[i].head) {
+      changes.reworded->emplace_back(Page::AgentLayerReworded::Create()
+                                         .SetIndex(base::checked_cast<int>(i))
+                                         .SetHeadBefore(was->head)
+                                         .Build());
+    }
+  }
+  for (const AgentLastLayer& was : last.layers) {
+    if (!unread.contains(was.frame_id) &&
+        std::ranges::none_of(
+            now.layers, [&](const auto& open) { return same(was, open); })) {
+      changes.closed->emplace_back(LastLayerReply(was));
+    }
+  }
+  return changes;
+}
+
+// browser: how long a report waits before reading
+// the page once more: a layer kept since the baseline that animates, or a
+// new blank blocking one that does, is waited out (+150 ms), up to `cap`.
+int LayerExitWaitMs(const std::vector<SettleReportPart>& parts,
+                    const AgentIdSpace& space,
+                    const gfx::Size& view,
+                    int cap) {
+  if (cap <= 0) {
+    return 0;
+  }
+  std::vector<LayerFrame> frames;
+  for (const SettleReportPart& part : parts) {
+    RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(part.frame);
+    if (rfh && part.report && part.report->layer_snapshot) {
+      frames.push_back({rfh, rfh->GetDevToolsFrameToken().ToString(),
+                        part.report->layer_snapshot.get(),
+                        LayerFrameShows(*rfh, view)});
+    }
+  }
+  const AgentLastLayers now = LastLayersOf(AssemblePageLayers(frames), frames);
+  const std::optional<AgentLastLayers>& last = space.last_layers();
+  int wait = 0;
+  for (const AgentLastLayer& layer : now.layers) {
+    if (layer.animating_ms <= 0) {
+      continue;
+    }
+    const bool kept =
+        last && std::ranges::any_of(last->layers, [&](const auto& was) {
+          return was.frame_id == layer.frame_id && was.node_id == layer.node_id;
+        });
+    if (kept || (layer.blocking && layer.name.empty() && layer.head.empty())) {
+      // Saturated: the figure is the renderer's.
+      const int exit_ms = base::ClampAdd(layer.animating_ms, 150);
+      wait = std::max(wait, exit_ms);
+    }
+  }
+  return std::min(wait, cap);
+}
+
+// browser: every live local root of the page now, in the order a capture
+// asks them; one in the back-forward cache or leaving the page is frozen, and
+// never answers.
+std::vector<RenderFrameHostImpl*> LiveLocalRoots(RenderFrameHostImpl* root) {
+  std::vector<RenderFrameHostImpl*> roots;
+  root->ForEachRenderFrameHostImpl([&roots](RenderFrameHostImpl* rfh) {
+    if (rfh->IsRenderFrameLive() && rfh->is_local_root() && rfh->IsActive()) {
+      roots.push_back(rfh);
+    }
+  });
+  return roots;
+}
+
+// browser: entry `p` of the page's stack by its key, as the id space
+// keeps it.
+AgentLayerRefData LayerRefOf(const PageLayers& page,
+                             size_t p,
+                             const std::vector<LayerFrame>& frames) {
+  const PageLayers::Entry& entry = page.entries[p];
+  const blink::mojom::AgentLayer& layer =
+      *frames[entry.frame].snapshot->layers[entry.local];
+  AgentLayerRefData ref;
+  ref.kind = layer.kind;
+  ref.name = entry.name;
+  ref.frame_id = frames[entry.frame].frame_id;
+  ref.node_id = layer.root_node_id;
+  return ref;
+}
+
+std::unique_ptr<Page::AgentLayerRef> LayerRefReply(
+    const AgentLayerRefData& ref) {
+  return Page::AgentLayerRef::Create()
+      .SetKind(ref.kind)
+      .SetName(ref.name)
+      .SetFrameId(ref.frame_id)
+      .SetNodeId(ref.node_id)
+      .Build();
+}
+
+// browser: a live region as read, with its frame and the id it is told
+// by.
+struct RegionReply {
+  int region_id = 0;
+  std::string frame_id;
+  raw_ptr<const blink::mojom::AgentRegionRead> read = nullptr;
+};
+
+std::unique_ptr<Page::AgentLiveRegion> LiveRegionReply(
+    const RegionReply& region) {
+  return Page::AgentLiveRegion::Create()
+      .SetRegionId(region.region_id)
+      .SetFrameId(region.frame_id)
+      .SetKind(region.read->kind)
+      .SetAssertive(region.read->assertive)
+      .SetText(region.read->text)
+      .Build();
+}
+
+// browser: what a region said since the last action, keyed by the arm it
+// was heard under, the local root, the document that heard it (unique
+// across the frame's documents) and its number, so a later read returns it
+// under the same key; beforeAction when it was heard before that action
+// armed the watch and its arm carried it on.
+std::unique_ptr<Page::AgentHeard> HeardReply(
+    AgentIdSpace& space,
+    const GlobalRenderFrameHostId& local_root,
+    const std::string& frame_id,
+    const blink::mojom::AgentHeardRead& heard) {
+  RegionReply region;
+  region.region_id =
+      space.RegionIdFor(AgentKey(local_root, heard.region->node_id));
+  region.frame_id = frame_id;
+  region.read = heard.region.get();
+  std::unique_ptr<Page::AgentHeard> reply =
+      Page::AgentHeard::Create()
+          .SetKey(base::StrCat({base::NumberToString(heard.arm_id), ":",
+                                frame_id, ":", heard.document, ":",
+                                base::NumberToString(heard.index)}))
+          .SetRegion(LiveRegionReply(region))
+          .SetGone(heard.gone)
+          .SetAgoMs(heard.ago_ms)
+          .Build();
+  if (heard.before_action) {
+    reply->SetBeforeAction(true);
+  }
+  // browser: recorded while no watch looked; said by the page itself.
+  if (heard.unwatched) {
+    reply->SetUnwatched(true);
+  }
+  if (heard.own) {
+    reply->SetOwn(true);
+  }
+  // browser: the changes it stands for, past its region's allowance,
+  // and the text of the one it took the place of.
+  if (heard.changes > 1) {
+    reply->SetChanges(heard.changes);
+  }
+  if (heard.replaced) {
+    reply->SetReplaced(*heard.replaced);
+  }
+  // browser: what a log's change added.
+  if (heard.added) {
+    reply->SetAdded(*heard.added);
+  }
+  return reply;
+}
+
+// browser: the space's delta on the wire. `regions` are the capture's, in
+// the order the space was given them, with their ids.
+std::unique_ptr<Page::AgentSnapshotDelta> DeltaReply(
+    const AgentDeltaOut& delta,
+    const std::vector<RegionReply>& regions) {
+  auto added = std::make_unique<protocol::Array<Page::AgentDeltaAdded>>();
+  for (const AgentDeltaOut::Added& entry : delta.added) {
+    added->emplace_back(Page::AgentDeltaAdded::Create()
+                            .SetAgentNodeId(entry.agent_node_id)
+                            .SetWhy(entry.why)
+                            .Build());
+  }
+  auto removed = std::make_unique<protocol::Array<Page::AgentDeltaRemoved>>();
+  for (const AgentDeltaOut::Removed& entry : delta.removed) {
+    std::unique_ptr<Page::AgentDeltaRemoved> reply =
+        Page::AgentDeltaRemoved::Create()
+            .SetAgentNodeId(entry.agent_node_id)
+            .SetLabel(entry.label)
+            .SetRole(entry.role)
+            .SetWhy(entry.why)
+            .SetWasInView(entry.was_in_view)
+            .SetBaselineIndex(entry.baseline_index)
+            .Build();
+    if (!entry.name.empty()) {
+      reply->SetName(entry.name);
+    }
+    if (entry.behind_layer >= 0) {
+      reply->SetBehindLayer(entry.behind_layer);
+    }
+    if (!entry.covered_by.empty()) {
+      reply->SetCoveredBy(entry.covered_by);
+    }
+    removed->emplace_back(std::move(reply));
+  }
+  auto changed = std::make_unique<protocol::Array<Page::AgentDeltaChanged>>();
+  for (const AgentDeltaOut::Changed& entry : delta.changed) {
+    std::unique_ptr<Page::AgentDeltaChanged> reply =
+        Page::AgentDeltaChanged::Create()
+            .SetAgentNodeId(entry.agent_node_id)
+            .SetWhat(entry.what)
+            .Build();
+    if (entry.from) {
+      reply->SetFrom(*entry.from);
+    }
+    if (entry.to) {
+      reply->SetTo(*entry.to);
+    }
+    if (entry.from_states) {
+      reply->SetFromStates(std::make_unique<protocol::Array<std::string>>(
+          entry.from_states->begin(), entry.from_states->end()));
+    }
+    if (entry.to_states) {
+      reply->SetToStates(std::make_unique<protocol::Array<std::string>>(
+          entry.to_states->begin(), entry.to_states->end()));
+    }
+    changed->emplace_back(std::move(reply));
+  }
+  auto layers_closed = std::make_unique<protocol::Array<Page::AgentLayerRef>>();
+  for (const AgentLayerRefData& ref : delta.layers_closed) {
+    layers_closed->emplace_back(LayerRefReply(ref));
+  }
+  auto announcements =
+      std::make_unique<protocol::Array<Page::AgentLiveRegion>>();
+  for (int r : delta.announcements) {
+    if (r >= 0 && static_cast<size_t>(r) < regions.size()) {
+      announcements->emplace_back(
+          LiveRegionReply(regions[static_cast<size_t>(r)]));
+    }
+  }
+  std::unique_ptr<Page::AgentSnapshotDelta> reply =
+      Page::AgentSnapshotDelta::Create()
+          .SetUnchanged(delta.unchanged)
+          .SetAdded(std::move(added))
+          .SetRemoved(std::move(removed))
+          .SetChanged(std::move(changed))
+          .SetReordered(std::make_unique<protocol::Array<int>>(
+              delta.reordered.begin(), delta.reordered.end()))
+          .SetLayersOpened(std::make_unique<protocol::Array<int>>(
+              delta.layers_opened.begin(), delta.layers_opened.end()))
+          .SetLayersClosed(std::move(layers_closed))
+          .SetAnnouncements(std::move(announcements))
+          .SetPartial(delta.partial)
+          .Build();
+  if (delta.focus_changed) {
+    std::unique_ptr<Page::AgentDeltaFocus> focus =
+        Page::AgentDeltaFocus::Create().Build();
+    if (delta.focus_agent_node_id != 0) {
+      focus->SetAgentNodeId(delta.focus_agent_node_id);
+    }
+    if (!delta.focus_label.empty()) {
+      focus->SetLabel(delta.focus_label);
+    }
+    reply->SetFocus(std::move(focus));
+  }
+  if (delta.url) {
+    reply->SetUrl(*delta.url);
+  }
+  if (delta.title) {
+    reply->SetTitle(*delta.title);
+  }
+  if (delta.scroll) {
+    std::unique_ptr<Page::AgentDeltaScroll> scroll =
+        Page::AgentDeltaScroll::Create()
+            .SetX(delta.scroll->x)
+            .SetY(delta.scroll->y)
+            .Build();
+    // browser: the main scroller's id and label; none for the page's own
+    // window.
+    if (delta.scroll->agent_node_id != 0) {
+      scroll->SetAgentNodeId(delta.scroll->agent_node_id);
+    }
+    if (!delta.scroll->label.empty()) {
+      scroll->SetLabel(delta.scroll->label);
+    }
+    reply->SetScroll(std::move(scroll));
+  }
+  return reply;
+}
+
+// browser: an element the space holds, as last listed; whether it is
+// alive is its renderer's to tell, unknown until then.
+std::unique_ptr<Page::AgentNodeLife> FoundNodeLife(const AgentIdEntry& entry) {
+  std::unique_ptr<Page::AgentNodeLife> life =
+      Page::AgentNodeLife::Create().SetState("unknown").Build();
+  if (entry.agent_node_id != 0) {
+    life->SetAgentNodeId(entry.agent_node_id);
+  }
+  if (!entry.label.empty()) {
+    life->SetLabel(entry.label);
+  }
+  if (!entry.role.empty()) {
+    life->SetRole(entry.role);
+  }
+  if (!entry.name.empty()) {
+    life->SetName(entry.name);
+  }
+  life->SetPlacement(AgentPlaceName(entry.place));
+  if (entry.behind) {
+    life->SetBehind(LayerRefReply(*entry.behind));
+  }
+  return life;
+}
+
+// browser: an id or label the space no longer holds (gone; unknown while
+// it is among the newest dropped past its cap), or never held (elsewhere).
+std::unique_ptr<Page::AgentNodeLife> PastNodeLife(const AgentPastAnswer& past) {
+  const char* state = "elsewhere";
+  if (past.kind == AgentPastAnswer::Kind::kGone) {
+    state = "gone";
+  } else if (past.kind == AgentPastAnswer::Kind::kUnknown) {
+    state = "unknown";
+  }
+  std::unique_ptr<Page::AgentNodeLife> life =
+      Page::AgentNodeLife::Create().SetState(state).Build();
+  if (past.agent_node_id != 0) {
+    life->SetAgentNodeId(past.agent_node_id);
+  }
+  if (!past.label.empty()) {
+    life->SetLabel(past.label);
+  }
+  if (!past.role.empty()) {
+    life->SetRole(past.role);
+  }
+  if (!past.name.empty()) {
+    life->SetName(past.name);
+  }
+  if (past.kind == AgentPastAnswer::Kind::kGone) {
+    life->SetPlacement(AgentPlaceName(AgentPlace::kGone));
+  }
+  return life;
+}
+
+// browser: what a renderer answered of a node, onto its answer; shared by
+// agentNodesAlive and agentReport's nodes.
+void FillNodeLife(Page::AgentNodeLife& life,
+                  const blink::mojom::AgentNodeState& state) {
+  life.SetState(state.alive ? "alive" : "gone");
+  if (!state.alive) {
+    return;
+  }
+  life.SetRendered(state.rendered);
+  life.SetReads(state.reads);
+  // browser: a checkbox's, switch's or radio's state.
+  if (state.checked) {
+    life.SetChecked(*state.checked);
+  }
+  // browser: why it is invalid now, and the page's words.
+  if (state.validity) {
+    life.SetInvalid(std::make_unique<protocol::Array<std::string>>(
+        InvalidReasonNames(state.validity->reasons)));
+    if (state.validity->error && !state.validity->error->empty()) {
+      life.SetError(*state.validity->error);
+    }
+  }
+}
