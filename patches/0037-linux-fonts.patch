@@ -0,0 +1,67 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/fonts/linux/windows_vertical_metrics.h"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+#include "third_party/skia/include/core/SkTypeface.h"
+#include "third_party/skia/include/core/SkTypes.h"
+
+namespace blink {
+
+namespace {
+
+constexpr SkFontTableTag kOs2Tag = SkSetFourByteTag('O', 'S', '/', '2');
+constexpr SkFontTableTag kHheaTag = SkSetFourByteTag('h', 'h', 'e', 'a');
+
+// OS/2 version 0 ends with usWinDescent, at 78 bytes; hhea's lineGap ends at
+// 10.
+constexpr size_t kOs2Size = 78;
+constexpr size_t kHheaSize = 10;
+constexpr int kUseTypoMetrics = 1 << 7;
+
+template <size_t N>
+int ReadUint16(const std::array<uint8_t, N>& table, size_t offset) {
+  return (table[offset] << 8) | table[offset + 1];
+}
+
+template <size_t N>
+int ReadInt16(const std::array<uint8_t, N>& table, size_t offset) {
+  return static_cast<int16_t>(ReadUint16(table, offset));
+}
+
+}  // namespace
+
+std::optional<WindowsVerticalMetrics> GetWindowsVerticalMetrics(
+    const SkTypeface& face,
+    float size) {
+  const int units_per_em = face.getUnitsPerEm();
+  std::array<uint8_t, kOs2Size> os2;
+  std::array<uint8_t, kHheaSize> hhea;
+  if (units_per_em <= 0 ||
+      face.getTableData(kOs2Tag, 0, os2.size(), os2.data()) != os2.size() ||
+      face.getTableData(kHheaTag, 0, hhea.size(), hhea.data()) !=
+          hhea.size()) {
+    return std::nullopt;
+  }
+  const float scale = size / units_per_em;
+  if (ReadUint16(os2, 62) & kUseTypoMetrics) {
+    return WindowsVerticalMetrics{ReadInt16(os2, 68) * scale,
+                                  -ReadInt16(os2, 70) * scale,
+                                  ReadInt16(os2, 72) * scale};
+  }
+  const int win_ascent = ReadUint16(os2, 74);
+  const int win_descent = ReadUint16(os2, 76);
+  const int hhea_spacing =
+      ReadInt16(hhea, 4) - ReadInt16(hhea, 6) + ReadInt16(hhea, 8);
+  const int line_gap = std::max(0, hhea_spacing - (win_ascent + win_descent));
+  return WindowsVerticalMetrics{win_ascent * scale, win_descent * scale,
+                                line_gap * scale};
+}
+
+}  // namespace blink
