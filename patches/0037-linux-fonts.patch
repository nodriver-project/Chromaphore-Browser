+// browser: a Linux build presenting Windows sees only the Windows fonts it
+// ships, with Windows' generic families: a Windows machine has none of
+// Linux's fonts. Null, leaving the host's configuration, with
+// --use-chromium-defaults, without the shipped fonts, and in every process
+// but the browser.
+FcConfig* CreateWindowsFontConfig() {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kUseChromiumDefaults)) {
+    return nullptr;
+  }
+  // Only the browser process builds it ("type" is content's switch for a
+  // child's kind; the browser has none). The browser answers a renderer's
+  // font questions (the font service), and a sandboxed process can do
+  // neither thing this needs: base::DIR_EXE cannot be resolved there, which
+  // PathService treats as fatal, and no font file can be opened. A renderer
+  // gets here through gfx::Font, which Chrome's error page asks for its font
+  // family (webui::GetFontFamily()): without this, every network error page
+  // killed the renderer that was to show it.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("type")) {
+    return nullptr;
+  }
+  std::vector<base::FilePath> files;
+  if (FontFilesProvider()) {
+    files = FontFilesProvider().Run();
+  }
+  std::vector<base::FilePath> dirs;
+  if (files.empty()) {
+    base::FilePath exe_dir;
+    if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+      return nullptr;
+    }
+    const base::FilePath root = exe_dir.Append("browser_fonts");
+    dirs = {root.Append("base_win11"), root.Append("emoji_v151")};
+    if (!base::DirectoryExists(dirs[0])) {
+      LOG(WARNING) << "browser: no Windows fonts at " << dirs[0]
+                   << "; the host's fonts stay visible";
+      return nullptr;
+    }
+  }
+  FcConfig* config = FcConfigCreate();
+  if (!FcConfigParseAndLoadFromMemory(
+          config, reinterpret_cast<const FcChar8*>(kWindowsFontConfig),
+          FcTrue) ||
+      !FcConfigBuildFonts(config)) {
+    FcConfigDestroy(config);
+    return nullptr;
+  }
+  // The default set file by file, like the provider's, never as
+  // directories: fontconfig serves a directory from its cache, with the
+  // family names as scanned when the cache was written, so the scan rules
+  // above would not reach fonts cached by an older build.
+  for (const base::FilePath& dir : dirs) {
+    base::FileEnumerator fonts(dir, /*recursive=*/false,
+                               base::FileEnumerator::FILES);
+    for (base::FilePath file = fonts.Next(); !file.empty();
+         file = fonts.Next()) {
+      files.push_back(file);
+    }
+  }
+  for (const base::FilePath& file : files) {
+    FcConfigAppFontAddFile(
+        config, reinterpret_cast<const FcChar8*>(file.value().c_str()));
+  }
+  return config;
+}
