+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_LINUX_WINDOWS_GDI_ADVANCES_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_LINUX_WINDOWS_GDI_ADVANCES_H_
+
+class SkFont;
+
+namespace blink {
+
+// browser: Skia's DirectWrite backend measures a face in GDI's classic mode,
+// every advance a whole pixel, when embedded bitmaps are on and the face has
+// a bitmap strike at the size (SkScalerContext_DW's has_bitmap_strike()).
+// FreeType gives the glyphs inside a strike their bitmaps' whole-pixel
+// advances too, but the others their outlines' fractional ones (Cambria's
+// space at 12 and 16 px). True when a Linux build presenting Windows should
+// round `font`'s advances as Windows does.
+bool WindowsMeasuresWholePixels(const SkFont& font);
+
+// browser: Skia's FreeType port gives FreeType the size truncated to 1/64 px
+// and scales advances by that size; DirectWrite scales them by the exact
+// size (13.3333 px against 13.328125). The factor an advance Skia reports
+// for `font` is scaled by in a Linux build presenting Windows: requested
+// over truncated size, 1 at whole sizes and otherwise.
+float ExactAdvanceScale(const SkFont& font);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_LINUX_WINDOWS_GDI_ADVANCES_H_
