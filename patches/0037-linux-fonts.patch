+
+constexpr SkFontTableTag kEblcTag = SkSetFourByteTag('E', 'B', 'L', 'C');
+constexpr SkFontTableTag kEbscTag = SkSetFourByteTag('E', 'B', 'S', 'C');
+constexpr SkFontTableTag kGaspTag = SkSetFourByteTag('g', 'a', 's', 'p');
+
+// EBLC and EBSC: version 2.0 and a size count, then one record per size.
+constexpr uint32_t kTableVersion = 0x00020000;
+constexpr size_t kTableHeaderSize = 8;
+constexpr size_t kBitmapSizeRecordSize = 48;
+constexpr size_t kBitmapScaleRecordSize = 28;
+constexpr uint32_t kMaxSizes = 1024;
+constexpr int kGaspGridfit = 0x0001;
+
+template <size_t N>
+uint32_t ReadUint16(const std::array<uint8_t, N>& data, size_t offset) {
+  return (uint32_t{data[offset]} << 8) | data[offset + 1];
+}
+
+template <size_t N>
+uint32_t ReadUint32(const std::array<uint8_t, N>& data, size_t offset) {
+  return (ReadUint16(data, offset) << 16) | ReadUint16(data, offset + 2);
+}
+
+struct PpemRange {
+  int min;
+  int max;
+};
+
+// The ppem range Skia tests for a strike: the size alone, or the whole gasp
+// range holding it when that range asks for grid-fitting only.
+PpemRange StrikeRange(const SkTypeface& typeface, int ppem) {
+  PpemRange range{ppem, ppem};
+  std::array<uint8_t, 4> header;
+  if (typeface.getTableData(kGaspTag, 0, header.size(), header.data()) !=
+      header.size()) {
+    return range;
+  }
+  const uint32_t count = ReadUint16(header, 2);
+  int min = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    std::array<uint8_t, 4> record;
+    if (typeface.getTableData(kGaspTag, 4 + 4 * i, record.size(),
+                              record.data()) != record.size()) {
+      break;
+    }
+    const int max = static_cast<int>(ReadUint16(record, 0));
+    if (ppem <= max) {
+      if (static_cast<int>(ReadUint16(record, 2)) == kGaspGridfit) {
+        range = PpemRange{min, max};
+      }
+      break;
+    }
+    min = max + 1;
+  }
+  return range;
+}
+
+// The number of size records of an EBLC or EBSC table, or 0.
+uint32_t SizeCount(const SkTypeface& typeface,
+                   SkFontTableTag tag,
+                   size_t record_size) {
+  std::array<uint8_t, kTableHeaderSize> header;
+  if (typeface.getTableData(tag, 0, header.size(), header.data()) !=
+          header.size() ||
+      ReadUint32(header, 0) != kTableVersion) {
+    return 0;
+  }
+  const uint32_t count = ReadUint32(header, 4);
+  if (count > kMaxSizes ||
+      typeface.getTableSize(tag) < kTableHeaderSize + record_size * count) {
+    return 0;
+  }
+  return count;
+}
+
+// As SkScalerContext_DW's has_bitmap_strike().
+bool HasBitmapStrike(const SkTypeface& typeface, PpemRange range) {
+  const uint32_t sizes =
+      SizeCount(typeface, kEblcTag, kBitmapSizeRecordSize);
+  for (uint32_t i = 0; i < sizes; ++i) {
+    // startGlyphIndex, endGlyphIndex, ppemX and ppemY, at 40 to 45.
+    std::array<uint8_t, 6> tail;
+    if (typeface.getTableData(kEblcTag,
+                              kTableHeaderSize + kBitmapSizeRecordSize * i + 40,
+                              tail.size(), tail.data()) != tail.size()) {
+      return false;
+    }
+    const int ppem_x = tail[4];
+    if (ppem_x == tail[5] && range.min <= ppem_x && ppem_x <= range.max &&
+        ReadUint16(tail, 2) >= ReadUint16(tail, 0) + 3) {
+      return true;
+    }
+  }
+  const uint32_t scales =
+      SizeCount(typeface, kEbscTag, kBitmapScaleRecordSize);
+  for (uint32_t i = 0; i < scales; ++i) {
+    // ppemX and ppemY, after the two 12-byte line metrics.
+    std::array<uint8_t, 2> ppem;
+    if (typeface.getTableData(kEbscTag,
+                              kTableHeaderSize + kBitmapScaleRecordSize * i + 24,
+                              ppem.size(), ppem.data()) != ppem.size()) {
+      return false;
+    }
+    if (ppem[0] == ppem[1] && range.min <= ppem[0] && ppem[0] <= range.max) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+float ExactAdvanceScale(const SkFont& font) {
+  if (!PresentsWindowsPlatform()) {
+    return 1.0f;
+  }
+  const float size = font.getSize();
+  // As SkScalarToFDot6: truncated to 26.6.
+  const float truncated = static_cast<float>(static_cast<int>(size * 64)) / 64;
+  return truncated > 0 && truncated != size ? size / truncated : 1.0f;
+}
+
+bool WindowsMeasuresWholePixels(const SkFont& font) {
+  const SkTypeface* typeface = font.getTypeface();
+  if (!typeface || !font.isEmbeddedBitmaps() || !PresentsWindowsPlatform()) {
+    return false;
+  }
+  // The size as SkScalerContext_DW rounds it, and the ppem it truncates to.
+  const SkScalar gdi_size = SkScalarRoundToScalar(font.getSize() * 64) / 64;
+  const int ppem = SkScalarTruncToInt(gdi_size);
+  return ppem > 0 && HasBitmapStrike(*typeface, StrikeRange(*typeface, ppem));
+}
+
+}  // namespace blink
