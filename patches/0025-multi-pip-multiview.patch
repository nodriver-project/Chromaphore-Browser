@@ -0,0 +1,383 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/overlay/multiview/multiview_host.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/no_destructor.h"
+#include "base/strings/strcat.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/picture_in_picture/picture_in_picture_window_manager.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/overlay/multiview/multiview_grid_view.h"
+#include "chrome/browser/ui/views/overlay/multiview/multiview_tile.h"
+#include "chrome/browser/ui/views/overlay/video_overlay_window_views.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/picture_in_picture_window_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/video_picture_in_picture_window_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/url_constants.h"
+#include "ui/base/base_window.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace {
+
+// How long a sent tab may take to start picture-in-picture before its place
+// is given up, e.g. because its page has no single video to show.
+constexpr base::TimeDelta kPendingTimeout = base::Seconds(5);
+
+std::vector<MultiviewHost*>& Hosts() {
+  static base::NoDestructor<std::vector<MultiviewHost*>> hosts;
+  return *hosts;
+}
+
+base::RepeatingCallbackList<void(MultiviewHost*)>& HostChangedCallbacks() {
+  static base::NoDestructor<base::RepeatingCallbackList<void(MultiviewHost*)>>
+      callbacks;
+  return *callbacks;
+}
+
+bool IsMultiviewUrl(const GURL& url) {
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         url.host() == kChromeUIMultiviewHost;
+}
+
+content::VideoPictureInPictureWindowController* GetController(
+    content::WebContents* source) {
+  return content::PictureInPictureWindowController::
+      GetOrCreateVideoPictureInPictureController(source);
+}
+
+void EnterPictureInPicture(base::WeakPtr<content::WebContents> source) {
+  if (source) {
+    content::MediaSession::Get(source.get())->EnterPictureInPicture();
+  }
+}
+
+}  // namespace
+
+// Watches a tab whose video is in a tile, and closes the tile when the tab
+// navigates away, as the window manager does for a floating window.
+class MultiviewHost::SourceObserver : public content::WebContentsObserver {
+ public:
+  SourceObserver(MultiviewHost* host, content::WebContents* source)
+      : content::WebContentsObserver(source), host_(host) {}
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override {
+    // May delete `this`.
+    ReleasePictureInPicture(web_contents());
+  }
+  void WebContentsDestroyed() override {
+    // The controller destroys the tile with the tab. Deletes `this`.
+    host_->EraseClaimed(web_contents());
+  }
+
+ private:
+  const raw_ptr<MultiviewHost> host_;
+};
+
+MultiviewHost::MultiviewHost(content::WebContents* multiview_tab)
+    : content::WebContentsObserver(multiview_tab),
+      content::WebContentsUserData<MultiviewHost>(*multiview_tab) {
+  Hosts().push_back(this);
+}
+
+MultiviewHost::~MultiviewHost() {
+  weak_factory_.InvalidateWeakPtrs();
+  std::erase(Hosts(), this);
+  // Views showing this tab drop their grid.
+  HostChangedCallbacks().Notify(this);
+  if (grid_view_) {
+    grid_view_->ClearHost();
+  }
+
+  // The videos go back to their tabs and keep playing there.
+  std::vector<base::WeakPtr<content::WebContents>> sources;
+  for (const auto& observer : claimed_) {
+    sources.push_back(observer->web_contents()->GetWeakPtr());
+  }
+  claimed_.clear();
+  pending_.clear();
+  for (const auto& source : sources) {
+    if (source) {
+      GetController(source.get())->Close(/*should_pause_video=*/false);
+    }
+  }
+}
+
+// static
+void MultiviewHost::SendToMultiview(content::WebContents* source) {
+  if (!source || IsMultiviewUrl(source->GetLastCommittedURL())) {
+    return;
+  }
+  if (MultiviewHost* host = FindHostFor(source)) {
+    host->ShowTab();
+    return;
+  }
+  MultiviewHost* host = FindOrOpenHostFor(source);
+  if (!host) {
+    return;
+  }
+  host->ShowTab();
+  if (host->SourceCount() >= kMaxTiles) {
+    return;
+  }
+
+  // Close a floating window of `source` first, without pausing the video.
+  // This must happen before `source` is pending, or the end of that session
+  // would count as the end of the tile's.
+  PictureInPictureWindowManager::GetInstance()
+      ->ExitPictureInPictureForWebContents(source);
+
+  host->pending_.push_back(source->GetWeakPtr());
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&MultiviewHost::DropPending, host->GetWeakPtr(),
+                     source->GetWeakPtr()),
+      kPendingTimeout);
+
+  // The controller keeps its window between sessions, so a floating window
+  // has to be destroyed for the next session to get a tile.
+  VideoOverlayWindowViews::DestroyWindowFor(
+      GetController(source),
+      base::BindOnce(&EnterPictureInPicture, source->GetWeakPtr()));
+}
+
+// static
+bool MultiviewHost::ClaimPictureInPicture(content::WebContents* source) {
+  MultiviewHost* host = FindHostFor(source);
+  if (!host) {
+    return false;
+  }
+  if (host->IsClaimed(source)) {
+    // A new session of a tab whose video is already in a tile.
+    return true;
+  }
+  host->ErasePending(source);
+  // A floating window left from an earlier session would be reused.
+  if (VideoOverlayWindowViews::HasWindowFor(GetController(source))) {
+    return false;
+  }
+  host->claimed_.push_back(std::make_unique<SourceObserver>(host, source));
+  return true;
+}
+
+// static
+bool MultiviewHost::ReleasePictureInPicture(content::WebContents* source) {
+  MultiviewHost* host = FindHostFor(source);
+  if (!host || !host->IsClaimed(source)) {
+    return false;
+  }
+  host->EraseClaimed(source);
+  // Hides the tile, which then destroys itself. Does nothing if the tile is
+  // already hidden.
+  GetController(source)->Close(/*should_pause_video=*/false);
+  return true;
+}
+
+// static
+std::unique_ptr<content::VideoOverlayWindow> MultiviewHost::MaybeCreateTile(
+    content::VideoPictureInPictureWindowController* controller) {
+  MultiviewHost* host = FindHostFor(controller->GetWebContents());
+  if (!host || !host->IsClaimed(controller->GetWebContents())) {
+    return nullptr;
+  }
+  return std::make_unique<MultiviewTile>(controller);
+}
+
+// static
+MultiviewHost* MultiviewHost::AttachTile(MultiviewTile* tile) {
+  MultiviewHost* host = FindHostFor(tile->GetSource());
+  if (!host || !host->IsClaimed(tile->GetSource())) {
+    return nullptr;
+  }
+  if (!std::ranges::contains(host->tiles_, tile)) {
+    host->tiles_.push_back(tile);
+  }
+  return host;
+}
+
+// static
+base::CallbackListSubscription MultiviewHost::AddHostChangedCallback(
+    HostChangedCallback callback) {
+  return HostChangedCallbacks().Add(std::move(callback));
+}
+
+std::unique_ptr<views::View> MultiviewHost::CreateGridView() {
+  return std::make_unique<MultiviewGridView>(this);
+}
+
+void MultiviewHost::OnTileChanged() {
+  // Tiles change while their buttons are being pressed, so the grid updates
+  // afterwards.
+  if (grid_update_pending_) {
+    return;
+  }
+  grid_update_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&MultiviewHost::UpdateGrid, GetWeakPtr()));
+}
+
+void MultiviewHost::RemoveTile(MultiviewTile* tile) {
+  std::erase(tiles_, tile);
+  OnTileChanged();
+}
+
+void MultiviewHost::SetGridView(MultiviewGridView* grid_view) {
+  grid_view_ = grid_view;
+}
+
+// static
+MultiviewHost* MultiviewHost::FindHostFor(content::WebContents* source) {
+  // An expired pending entry would match a null `source`.
+  if (!source) {
+    return nullptr;
+  }
+  for (MultiviewHost* host : Hosts()) {
+    if (host->IsPending(source) || host->IsClaimed(source)) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+// static
+MultiviewHost* MultiviewHost::FindOrOpenHostFor(content::WebContents* source) {
+  Profile* const profile =
+      Profile::FromBrowserContext(source->GetBrowserContext());
+  content::WebContents* multiview_tab = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() != profile) {
+          return true;
+        }
+        TabStripModel* const tab_strip = browser->GetTabStripModel();
+        for (int i = 0; i < tab_strip->count(); ++i) {
+          content::WebContents* const contents = tab_strip->GetWebContentsAt(i);
+          if (IsMultiviewUrl(contents->GetVisibleURL())) {
+            multiview_tab = contents;
+            return false;
+          }
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+
+  if (!multiview_tab) {
+    tabs::TabInterface* const tab =
+        tabs::TabInterface::MaybeGetFromContents(source);
+    if (!tab || !tab->GetBrowserWindowInterface()) {
+      return nullptr;
+    }
+    NavigateParams params(tab->GetBrowserWindowInterface(),
+                          GURL(base::StrCat({content::kChromeUIScheme,
+                                             url::kStandardSchemeSeparator,
+                                             kChromeUIMultiviewHost})),
+                          ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+    multiview_tab = params.navigated_or_inserted_contents;
+    if (!multiview_tab) {
+      return nullptr;
+    }
+  }
+
+  if (!FromWebContents(multiview_tab)) {
+    CreateForWebContents(multiview_tab);
+    // Only now can a view showing the tab find the host.
+    HostChangedCallbacks().Notify(nullptr);
+  }
+  return FromWebContents(multiview_tab);
+}
+
+bool MultiviewHost::IsPending(content::WebContents* source) const {
+  return std::ranges::any_of(
+      pending_, [source](const base::WeakPtr<content::WebContents>& pending) {
+        return pending.get() == source;
+      });
+}
+
+bool MultiviewHost::IsClaimed(content::WebContents* source) const {
+  return std::ranges::any_of(
+      claimed_, [source](const std::unique_ptr<SourceObserver>& observer) {
+        return observer->web_contents() == source;
+      });
+}
+
+size_t MultiviewHost::SourceCount() {
+  std::erase_if(pending_, [](const base::WeakPtr<content::WebContents>& p) {
+    return !p;
+  });
+  return pending_.size() + claimed_.size();
+}
+
+void MultiviewHost::ErasePending(content::WebContents* source) {
+  std::erase_if(pending_,
+                [source](const base::WeakPtr<content::WebContents>& pending) {
+                  return !pending || pending.get() == source;
+                });
+}
+
+void MultiviewHost::EraseClaimed(content::WebContents* source) {
+  std::erase_if(claimed_,
+                [source](const std::unique_ptr<SourceObserver>& observer) {
+                  return observer->web_contents() == source;
+                });
+}
+
+void MultiviewHost::ShowTab() {
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents());
+  BrowserWindowInterface* const browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!browser) {
+    return;
+  }
+  TabStripModel* const tab_strip = browser->GetTabStripModel();
+  const int index = tab_strip->GetIndexOfWebContents(web_contents());
+  if (index != TabStripModel::kNoTab) {
+    tab_strip->ActivateTabAt(index);
+  }
+  browser->GetWindow()->Activate();
+}
+
+void MultiviewHost::DropPending(base::WeakPtr<content::WebContents> source) {
+  if (source) {
+    ErasePending(source.get());
+  }
+}
+
+void MultiviewHost::UpdateGrid() {
+  grid_update_pending_ = false;
+  if (grid_view_) {
+    grid_view_->Update();
+  }
+}
+
+void MultiviewHost::PrimaryPageChanged(content::Page& page) {
+  if (!IsMultiviewUrl(page.GetMainDocument().GetLastCommittedURL())) {
+    // The tab left the Multiview page. Deletes `this`.
+    web_contents()->RemoveUserData(UserDataKey());
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(MultiviewHost);
