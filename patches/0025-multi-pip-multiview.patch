+
+// Returns the cell of each video in `area`, in order. Picks the grid of rows
+// and columns that shows the most video, where each video keeps its aspect
+// ratio inside its cell; on a tie it prefers fewer rows. A last row that is
+// not full is centered.
+std::vector<gfx::Rect> ComputeMultiviewCells(
+    const gfx::Size& area,
+    const std::vector<float>& aspect_ratios) {
+  const int count = static_cast<int>(aspect_ratios.size());
+  if (count == 0 || area.IsEmpty()) {
+    return {};
+  }
+
+  const auto cell_size = [&](int rows, int columns) {
+    return gfx::SizeF(
+        (area.width() - kTileGap * (columns - 1)) / static_cast<float>(columns),
+        (area.height() - kTileGap * (rows - 1)) / static_cast<float>(rows));
+  };
+
+  int best_rows = 1;
+  double best_shown = 0;
+  for (int rows = 1; rows <= count; ++rows) {
+    const int columns = (count + rows - 1) / rows;
+    // A shape with an empty row has the same cells as one with fewer rows.
+    if ((rows - 1) * columns >= count) {
+      continue;
+    }
+    const gfx::SizeF cell = cell_size(rows, columns);
+    if (cell.IsEmpty()) {
+      continue;
+    }
+    double shown = 0;
+    for (float ratio : aspect_ratios) {
+      const double width =
+          std::min<double>(cell.width(), cell.height() * ratio);
+      shown += width * width / ratio;
+    }
+    // Only a clearly larger area wins, so a tie keeps fewer rows.
+    if (shown > best_shown * 1.0001) {
+      best_shown = shown;
+      best_rows = rows;
+    }
+  }
+
+  const int columns = (count + best_rows - 1) / best_rows;
+  const gfx::SizeF cell = cell_size(best_rows, columns);
+  std::vector<gfx::Rect> cells;
+  cells.reserve(count);
+  for (int i = 0; i < count; ++i) {
+    const int row = i / columns;
+    const int in_row = std::min(columns, count - row * columns);
+    const float row_offset = (columns - in_row) * (cell.width() + kTileGap) / 2;
+    const gfx::RectF rect(
+        row_offset + (i % columns) * (cell.width() + kTileGap),
+        row * (cell.height() + kTileGap), cell.width(), cell.height());
+    cells.push_back(gfx::ToRoundedRect(rect));
+  }
+  return cells;
+}
