+// browser: a watched tab navigated or went away.
+void PictureInPictureWindowManager::OnVideoWebContentsGone(
+    VideoWebContentsObserver* observer) {
+  if (observer == video_web_contents_observer_.get()) {
+    CloseWindowInternal();
+    PromoteOtherVideoWindow();
+    return;
+  }
+  CloseOtherVideoWindow(observer->web_contents());
+}
+
+bool PictureInPictureWindowManager::CloseOtherVideoWindow(
+    content::WebContents* web_contents) {
+  auto it = std::ranges::find(other_video_windows_, web_contents,
+                              [](const OtherVideoWindow& window) {
+                                return window.observer->web_contents();
+                              });
+  if (it == other_video_windows_.end()) {
+    return false;
+  }
+
+  // Forget the window before closing it, so the call that closing makes back
+  // into `ExitPictureInPictureForWebContents()` finds nothing left to do.
+  content::PictureInPictureWindowController* controller = it->controller;
+  other_video_windows_.erase(it);
+  controller->Close(/*should_pause_video=*/false);
+  return true;
+}
+
+void PictureInPictureWindowManager::CloseOtherVideoWindows() {
+  // Same as above: forget all windows before closing any of them.
+  std::vector<OtherVideoWindow> windows;
+  windows.swap(other_video_windows_);
+  for (OtherVideoWindow& window : windows) {
+    window.controller->Close(/*should_pause_video=*/false);
+  }
+}
+
+void PictureInPictureWindowManager::PromoteOtherVideoWindow() {
+  if (pip_window_controller_ || is_closing_window_ ||
+      other_video_windows_.empty()) {
+    return;
+  }
+
+  OtherVideoWindow window = std::move(other_video_windows_.back());
+  other_video_windows_.pop_back();
+  pip_window_controller_ = window.controller;
+  video_web_contents_observer_ = std::move(window.observer);
+}
