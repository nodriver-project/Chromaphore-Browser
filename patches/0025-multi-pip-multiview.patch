+// browser: where a new window of `window_size` opens: the first corner of
+// `work_area` that no other open video picture-in-picture window overlaps,
+// starting with the usual bottom-right one. When every corner is taken, the
+// window opens bottom-right, on top of the others.
+gfx::Point GetInitialWindowOrigin(const gfx::Rect& work_area,
+                                  const gfx::Size& window_size,
+                                  int margin) {
+  const int left = work_area.x() + margin;
+  const int top = work_area.y() + margin;
+  const int right = work_area.right() - window_size.width() - margin;
+  const int bottom = work_area.bottom() - window_size.height() - margin;
+  const gfx::Point corners[] = {
+      {right, bottom}, {left, bottom}, {right, top}, {left, top}};
+
+  const std::vector<gfx::Rect> other_windows =
+      PictureInPictureWindowManager::GetInstance()
+          ->GetOtherVideoWindowBoundsInScreen();
+  for (const gfx::Point& corner : corners) {
+    const gfx::Rect candidate(corner, window_size);
+    if (std::ranges::none_of(other_windows, [&](const gfx::Rect& other) {
+          return other.Intersects(candidate);
+        })) {
+      return corner;
+    }
+  }
+  return corners[0];
+}
