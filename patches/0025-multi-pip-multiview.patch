+// browser: shows the Multiview grid in place of the web contents when the
+// tab hosts one.
+void ContentsWebView::UpdateMultiviewGrid(MultiviewHost* destroyed_host) {
+  MultiviewHost* host =
+      web_contents() ? MultiviewHost::FromWebContents(web_contents()) : nullptr;
+  if (host == destroyed_host) {
+    host = nullptr;
+  }
+  if (host == multiview_host_) {
+    return;
+  }
+  if (multiview_grid_) {
+    RemoveChildViewT(multiview_grid_.ExtractAsDangling());
+    holder()->SetVisible(true);
+  }
+  multiview_host_ = host;
+  if (host) {
+    multiview_grid_ = AddChildView(host->CreateGridView());
+    multiview_grid_->SetBoundsRect(GetLocalBounds());
+    ChildVisibilityChanged(multiview_grid_);
+  }
+}
