@@ -0,0 +1,148 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_OVERLAY_MULTIVIEW_MULTIVIEW_HOST_H_
+#define CHROME_BROWSER_UI_VIEWS_OVERLAY_MULTIVIEW_MULTIVIEW_HOST_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class VideoOverlayWindow;
+class VideoPictureInPictureWindowController;
+class WebContents;
+}  // namespace content
+
+namespace views {
+class View;
+}  // namespace views
+
+class MultiviewGridView;
+class MultiviewTile;
+
+// The host of the Multiview page, chrome://multiview.
+inline constexpr char kChromeUIMultiviewHost[] = "multiview";
+
+// Shows the videos of up to four other tabs side by side in one tab, the
+// Multiview tab. Each video is a picture-in-picture session whose window is a
+// tile in that tab instead of a floating window: the tab shows the video's own
+// compositor surface, so nothing is copied and protected video keeps playing.
+//
+// The host lives on the Multiview tab's WebContents and keeps the tiles; the
+// grid that draws them belongs to whichever ContentsWebView shows the tab, so
+// the tiles move, resize and minimize with the browser window.
+class MultiviewHost : public content::WebContentsObserver,
+                      public content::WebContentsUserData<MultiviewHost> {
+ public:
+  static constexpr size_t kMaxTiles = 4;
+
+  // Called with the host being destroyed, or with null after a host was
+  // created.
+  using HostChangedCallback =
+      base::RepeatingCallback<void(MultiviewHost* destroyed_host)>;
+
+  MultiviewHost(const MultiviewHost&) = delete;
+  MultiviewHost& operator=(const MultiviewHost&) = delete;
+  ~MultiviewHost() override;
+
+  // Shows the video of `source` in the Multiview tab of its profile, opening
+  // one next to `source` if there is none, and switches to that tab. Does
+  // nothing more when the tab already holds `kMaxTiles` videos.
+  static void SendToMultiview(content::WebContents* source);
+
+  // Called when `source` starts picture-in-picture. Returns true if the
+  // session belongs in a Multiview tile; no floating window may then be
+  // involved.
+  static bool ClaimPictureInPicture(content::WebContents* source);
+
+  // Called when the picture-in-picture session of `source` ends. Returns true
+  // if the session was in a Multiview tile, which is now closed.
+  static bool ReleasePictureInPicture(content::WebContents* source);
+
+  // Returns the window for a session that belongs in a tile, or null when the
+  // session gets a floating window.
+  static std::unique_ptr<content::VideoOverlayWindow> MaybeCreateTile(
+      content::VideoPictureInPictureWindowController* controller);
+
+  // Adds `tile` to the host that holds its tab and returns that host, or
+  // returns null if no Multiview tab holds it.
+  static MultiviewHost* AttachTile(MultiviewTile* tile);
+
+  static base::CallbackListSubscription AddHostChangedCallback(
+      HostChangedCallback callback);
+
+  base::WeakPtr<MultiviewHost> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  // Creates the grid for the view that shows this host's tab.
+  std::unique_ptr<views::View> CreateGridView();
+
+  // The tiles in display order. Only tiles that are shown are drawn.
+  const std::vector<raw_ptr<MultiviewTile>>& tiles() const { return tiles_; }
+
+  // Called by tiles and the grid.
+  void OnTileChanged();
+  void RemoveTile(MultiviewTile* tile);
+  void SetGridView(MultiviewGridView* grid_view);
+
+ private:
+  friend class content::WebContentsUserData<MultiviewHost>;
+
+  explicit MultiviewHost(content::WebContents* multiview_tab);
+
+  // Returns the host whose tab holds, or is about to hold, `source`.
+  static MultiviewHost* FindHostFor(content::WebContents* source);
+
+  // Returns the Multiview tab of `source`'s profile, opening one next to
+  // `source` if needed.
+  static MultiviewHost* FindOrOpenHostFor(content::WebContents* source);
+
+  bool IsPending(content::WebContents* source) const;
+  bool IsClaimed(content::WebContents* source) const;
+  void ErasePending(content::WebContents* source);
+  void EraseClaimed(content::WebContents* source);
+
+  // The number of tabs held, pending or shown.
+  size_t SourceCount();
+
+  // Switches to this host's tab.
+  void ShowTab();
+
+  // Gives up the place of `source` if its session did not start in time.
+  void DropPending(base::WeakPtr<content::WebContents> source);
+
+  void UpdateGrid();
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+  class SourceObserver;
+
+  // Sent tabs whose session has not started yet.
+  std::vector<base::WeakPtr<content::WebContents>> pending_;
+
+  // Tabs whose session is shown here, each watched for navigation.
+  std::vector<std::unique_ptr<SourceObserver>> claimed_;
+
+  // Owned by the content picture-in-picture controllers; a tile removes itself
+  // when destroyed.
+  std::vector<raw_ptr<MultiviewTile>> tiles_;
+
+  raw_ptr<MultiviewGridView> grid_view_ = nullptr;
+  bool grid_update_pending_ = false;
+
+  base::WeakPtrFactory<MultiviewHost> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_OVERLAY_MULTIVIEW_MULTIVIEW_HOST_H_
diff --git a/chrome/browser/ui/views/overlay/multiview/multiview_tile.cc b/chrome/browser/ui/views/overlay/multiview/multiview_tile.cc
new file mode 100644
index 0000000000..b4a5141fe3
--- /dev/null
+++ b/chrome/browser/ui/views/overlay/multiview/multiview_tile.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/overlay/multiview/multiview_tile.h"
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/ui/views/overlay/multiview/multiview_grid_view.h"
+#include "chrome/browser/ui/views/overlay/multiview/multiview_host.h"
+#include "content/public/browser/video_picture_in_picture_window_controller.h"
+
+MultiviewTile::MultiviewTile(
+    content::VideoPictureInPictureWindowController* controller)
+    : controller_(controller) {}
+
+MultiviewTile::~MultiviewTile() {
+  if (view_) {
+    view_->OnTileDestroyed();
+  }
+  if (host_) {
+    host_->RemoveTile(this);
+  }
+}
+
+content::WebContents* MultiviewTile::GetSource() const {
+  return controller_->GetWebContents();
+}
+
+float MultiviewTile::GetAspectRatio() const {
+  if (natural_size_.IsEmpty()) {
+    return kDefaultAspectRatio;
+  }
+  return static_cast<float>(natural_size_.width()) / natural_size_.height();
+}
+
+void MultiviewTile::SetView(MultiviewTileView* view) {
+  view_ = view;
+}
+
+void MultiviewTile::SetVideoBoundsInScreen(const gfx::Rect& bounds) {
+  if (bounds == bounds_ || bounds.IsEmpty()) {
+    return;
+  }
+  const bool resized = bounds.size() != bounds_.size();
+  bounds_ = bounds;
+  if (resized) {
+    controller_->UpdateLayerBounds();
+  }
+}
+
+bool MultiviewTile::IsActive() const {
+  return false;
+}
+
+void MultiviewTile::Close() {
+  shown_ = false;
+  if (host_) {
+    host_->OnTileChanged();
+  }
+}
+
+void MultiviewTile::ShowInactive() {
+  destroy_weak_factory_.InvalidateWeakPtrs();
+  MultiviewHost* host = MultiviewHost::AttachTile(this);
+  if (!host) {
+    // The tab's session no longer belongs in a Multiview tab. This window
+    // can't float, so end the session; the next one gets a new window.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&MultiviewTile::DestroyWindow,
+                                  destroy_weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (host_ && host_.get() != host) {
+    host_->RemoveTile(this);
+  }
+  host_ = host->GetWeakPtr();
+  shown_ = true;
+  host->OnTileChanged();
+}
+
+void MultiviewTile::Hide() {
+  shown_ = false;
+  if (host_) {
+    host_->OnTileChanged();
+  }
+  // Called while the controller closes the window, so destroy it afterwards.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&MultiviewTile::DestroyWindow,
+                                destroy_weak_factory_.GetWeakPtr()));
+}
+
+bool MultiviewTile::IsVisible() const {
+  return shown_;
+}
+
+gfx::Rect MultiviewTile::GetBounds() {
+  return bounds_;
+}
+
+void MultiviewTile::UpdateNaturalSize(const gfx::Size& natural_size) {
+  if (natural_size == natural_size_) {
+    return;
+  }
+  natural_size_ = natural_size;
+  if (host_) {
+    host_->OnTileChanged();
+  }
+}
+
+void MultiviewTile::SetPlaybackState(PlaybackState playback_state) {
+  playback_state_ = playback_state;
+  if (view_) {
+    view_->UpdateControls();
+  }
+}
+
+void MultiviewTile::SetPlayPauseButtonVisibility(bool is_visible) {
+  play_pause_visible_ = is_visible;
+  if (view_) {
+    view_->UpdateControls();
+  }
+}
+
+void MultiviewTile::SetSurfaceId(const viz::SurfaceId& surface_id) {
+  surface_id_ = surface_id;
+  if (view_) {
+    view_->UpdateSurface();
+  }
+}
+
+void MultiviewTile::DestroyWindow() {
+  // Deletes `this`.
+  controller_->OnWindowDestroyed(/*should_pause_video=*/false);
+}
