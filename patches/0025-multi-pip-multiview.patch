+      vector_icons::kVolumeUpIcon, IDS_PICTURE_IN_PICTURE_MUTE_TEXT));
+  controls_view_->AddChildView(
+      CreateControlButton(base::BindRepeating(&MultiviewTileView::BackToTab,
+                                              base::Unretained(this)),
+                          vector_icons::kBackToTabIcon,
+                          IDS_PICTURE_IN_PICTURE_BACK_TO_TAB_CONTROL_TEXT));
+  controls_view_->AddChildView(CreateControlButton(
+      base::BindRepeating(&MultiviewTileView::Remove, base::Unretained(this)),
+      vector_icons::kCloseIcon, IDS_PICTURE_IN_PICTURE_CLOSE_CONTROL_TEXT));
+
+  UpdateControls();
+}
+
+MultiviewTileView::~MultiviewTileView() {
+  UnregisterFrameSink();
+  if (tile_) {
+    tile_->SetView(nullptr);
+  }
+}
+
+void MultiviewTileView::OnTileDestroyed() {
+  UnregisterFrameSink();
+  tile_ = nullptr;
+}
+
+void MultiviewTileView::UpdateSurface() {
+  if (!tile_ || !tile_->surface_id().is_valid()) {
+    return;
+  }
+  if (tile_->surface_id().frame_sink_id() != frame_sink_id_) {
+    UnregisterFrameSink();
+    frame_sink_id_ = tile_->surface_id().frame_sink_id();
+    RegisterFrameSink();
+  }
+  video_view_->layer()->AsSurface()->SetShowSurface(
+      tile_->surface_id(), video_view_->size(),
+      cc::DeadlinePolicy::UseDefaultDeadline(),
+      /*stretch_content_to_fill_bounds=*/true);
+}
+
+void MultiviewTileView::UpdateControls() {
+  if (!tile_) {
+    return;
+  }
+  play_pause_button_->SetVisible(tile_->play_pause_visible());
+  if (tile_->playback_state() == MultiviewTile::kPlaying) {
+    SetButtonIcon(play_pause_button_, vector_icons::kPauseIcon,
+                  IDS_PICTURE_IN_PICTURE_PAUSE_CONTROL_TEXT);
+  } else {
+    SetButtonIcon(play_pause_button_, vector_icons::kPlayArrowIcon,
+                  IDS_PICTURE_IN_PICTURE_PLAY_CONTROL_TEXT);
+  }
+
+  content::WebContents* source = tile_->GetSource();
+  if (source && source->IsAudioMuted()) {
+    SetButtonIcon(mute_button_, vector_icons::kVolumeOffIcon,
+                  IDS_PICTURE_IN_PICTURE_UNMUTE_TEXT);
+  } else {
+    SetButtonIcon(mute_button_, vector_icons::kVolumeUpIcon,
+                  IDS_PICTURE_IN_PICTURE_MUTE_TEXT);
+  }
+  InvalidateLayout();
+}
+
+void MultiviewTileView::Layout(PassKey) {
+  const gfx::Rect video = GetVideoBounds();
+  video_view_->SetBoundsRect(video);
+  video_view_->layer()->AsSurface()->SetSurfaceSize(video.size());
+
+  controls_view_->SetBounds(video.x(), video.bottom() - kControlsHeight,
+                            video.width(), kControlsHeight);
+  // Playback buttons on the left, tab buttons on the right.
+  const int button_y = (kControlsHeight - kButtonSize) / 2;
+  int left = kControlsPadding;
+  int right = controls_view_->width() - kControlsPadding;
+  for (views::View* button : controls_view_->children()) {
+    if (!button->GetVisible()) {
+      continue;
+    }
+    if (button == play_pause_button_.get() || button == mute_button_.get()) {
+      button->SetPosition(gfx::Point(left, button_y));
+      left += kButtonSize;
+    } else {
+      right -= kButtonSize;
+      button->SetPosition(gfx::Point(right, button_y));
+    }
+  }
+
+  if (tile_ && GetWidget()) {
+    gfx::Rect video_in_screen = video;
+    views::View::ConvertRectToScreen(this, &video_in_screen);
+    tile_->SetVideoBoundsInScreen(video_in_screen);
+  }
+}
+
+void MultiviewTileView::AddedToWidget() {
+  RegisterFrameSink();
+  UpdateSurface();
+}
+
+void MultiviewTileView::RemovedFromWidget() {
+  UnregisterFrameSink();
+}
+
+// Moves over the controls go to the buttons instead; see OnMouseRested().
+void MultiviewTileView::OnMouseMoved(const ui::MouseEvent& event) {
+  // Windows also reports a move when a window opens or closes under a resting
+  // pointer, such as the full screen exit hint. Only a real move counts.
+  gfx::Point location = event.location();
+  views::View::ConvertPointToScreen(this, &location);
+  if (location == last_mouse_location_) {
+    return;
+  }
+  last_mouse_location_ = location;
+  ShowControlsForAWhile();
+}
+
+void MultiviewTileView::OnMouseExited(const ui::MouseEvent& event) {
+  HideControls();
+}
+
+ui::Cursor MultiviewTileView::GetCursor(const ui::MouseEvent& event) {
+  // Asked only while the pointer is over the video; the controls are hidden
+  // then only after the mouse has rested.
+  return controls_view_->GetVisible()
+             ? ui::Cursor()
+             : ui::Cursor(ui::mojom::CursorType::kNone);
+}
+
+gfx::Rect MultiviewTileView::GetVideoBounds() const {
+  const float ratio =
+      tile_ ? tile_->GetAspectRatio() : MultiviewTile::kDefaultAspectRatio;
+  const gfx::Rect area = GetLocalBounds();
+  gfx::SizeF video(area.width(), area.width() / ratio);
+  if (video.height() > area.height()) {
+    video = gfx::SizeF(area.height() * ratio, area.height());
+  }
+  return gfx::ToRoundedRect(
+      gfx::RectF(area.x() + (area.width() - video.width()) / 2,
+                 area.y() + (area.height() - video.height()) / 2, video.width(),
+                 video.height()));
+}
+
+void MultiviewTileView::RegisterFrameSink() {
+  if (compositor_ || !frame_sink_id_.is_valid() || !GetWidget() ||
+      !GetWidget()->GetCompositor()) {
+    return;
+  }
+  compositor_ = GetWidget()->GetCompositor();
+  compositor_->AddChildFrameSink(frame_sink_id_);
+  compositor_->AddObserver(this);
+}
+
+void MultiviewTileView::UnregisterFrameSink() {
+  if (!compositor_) {
+    return;
+  }
+  compositor_->RemoveObserver(this);
+  compositor_->RemoveChildFrameSink(frame_sink_id_);
+  compositor_ = nullptr;
+}
+
+void MultiviewTileView::OnCompositingShuttingDown(ui::Compositor* compositor) {
+  UnregisterFrameSink();
+}
+
+void MultiviewTileView::ShowControlsForAWhile() {
+  if (!controls_view_->GetVisible()) {
+    UpdateControls();
+    controls_view_->SetVisible(true);
+  }
+  hide_controls_timer_.Start(FROM_HERE, kControlsHideDelay,
+                             base::BindOnce(&MultiviewTileView::OnMouseRested,
+                                            base::Unretained(this)));
+}
+
+void MultiviewTileView::OnMouseRested() {
+  // As in video players, the controls stay while the pointer is on them.
+  if (controls_view_->IsMouseHovered()) {
+    ShowControlsForAWhile();
+    return;
+  }
+  HideControls();
+  // The pointer goes with the controls; the next move brings both back.
+  if (GetWidget()) {
+    GetWidget()->SetCursor(ui::Cursor(ui::mojom::CursorType::kNone));
+  }
+}
+
+void MultiviewTileView::HideControls() {
+  hide_controls_timer_.Stop();
+  controls_view_->SetVisible(false);
+}
+
+void MultiviewTileView::TogglePlayPause() {
+  if (!tile_) {
+    return;
+  }
+  const bool playing = tile_->controller()->TogglePlayPause();
+  tile_->SetPlaybackState(playing ? MultiviewTile::kPlaying
+                                  : MultiviewTile::kPaused);
+}
+
+void MultiviewTileView::ToggleMute() {
+  content::WebContents* source = tile_ ? tile_->GetSource() : nullptr;
+  if (!source) {
+    return;
+  }
+  // Mutes the whole tab, as its tab strip audio indicator does; the page
+  // can't tell.
+  SetTabAudioMuted(source, !source->IsAudioMuted(),
+                   TabMutedReason::kAudioIndicator, std::string());
+  UpdateControls();
+}
+
+void MultiviewTileView::BackToTab() {
+  if (tile_) {
+    tile_->controller()->CloseAndFocusInitiator();
+  }
+}
+
+void MultiviewTileView::Remove() {
+  if (tile_) {
+    tile_->controller()->Close(/*should_pause_video=*/false);
+  }
+}
+
+BEGIN_METADATA(MultiviewTileView)
+END_METADATA
+
+// MultiviewGridView -----------------------------------------------------------
+
+MultiviewGridView::MultiviewGridView(MultiviewHost* host) : host_(host) {
+  SetPaintToLayer();
+  SetBackground(views::CreateSolidBackground(SK_ColorBLACK));
+  host_->SetGridView(this);
+  Update();
+}
+
+MultiviewGridView::~MultiviewGridView() {
+  if (host_) {
+    host_->SetGridView(nullptr);
+  }
+}
+
+void MultiviewGridView::ClearHost() {
+  host_ = nullptr;
+  RemoveAllChildViews();
+  SetVisible(false);
+}
+
+void MultiviewGridView::Update() {
+  if (!host_) {
+    return;
+  }
+  std::vector<MultiviewTile*> shown;
+  for (MultiviewTile* tile : host_->tiles()) {
+    if (tile->is_shown()) {
+      shown.push_back(tile);
+    }
+  }
+  std::vector<MultiviewTile*> current;
+  for (views::View* child : children()) {
+    current.push_back(static_cast<MultiviewTileView*>(child)->tile());
+  }
+  if (current != shown) {
+    RemoveAllChildViews();
+    for (MultiviewTile* tile : shown) {
+      AddChildView(std::make_unique<MultiviewTileView>(tile));
+    }
+  }
+  SetVisible(!shown.empty());
+  // A video's aspect ratio may have changed even where its cell did not.
+  for (views::View* child : children()) {
+    child->InvalidateLayout();
+  }
+  InvalidateLayout();
+}
+
+void MultiviewGridView::Layout(PassKey) {
+  std::vector<float> aspect_ratios;
+  for (views::View* child : children()) {
+    MultiviewTile* tile = static_cast<MultiviewTileView*>(child)->tile();
+    aspect_ratios.push_back(tile ? tile->GetAspectRatio()
+                                 : MultiviewTile::kDefaultAspectRatio);
+  }
+  const std::vector<gfx::Rect> cells =
+      ComputeMultiviewCells(size(), aspect_ratios);
+  for (size_t i = 0; i < cells.size(); ++i) {
+    children()[i]->SetBoundsRect(cells[i]);
+  }
+}
+
+BEGIN_METADATA(MultiviewGridView)
+END_METADATA
