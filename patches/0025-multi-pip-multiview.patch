+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_OVERLAY_MULTIVIEW_MULTIVIEW_TILE_H_
+#define CHROME_BROWSER_UI_VIEWS_OVERLAY_MULTIVIEW_MULTIVIEW_TILE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/viz/common/surfaces/surface_id.h"
+#include "content/public/browser/overlay_window.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content {
+class VideoPictureInPictureWindowController;
+class WebContents;
+}  // namespace content
+
+class MultiviewHost;
+class MultiviewTileView;
+
+// The picture-in-picture window of a video shown in the Multiview tab. The
+// content controller owns it as it would own a floating window. It keeps what
+// the tab needs to draw the video and passes changes on to the tile's view
+// while the Multiview tab is shown.
+class MultiviewTile : public content::VideoOverlayWindow {
+ public:
+  // Width divided by height of a video whose size is not known yet.
+  static constexpr float kDefaultAspectRatio = 16.0f / 9.0f;
+
+  explicit MultiviewTile(
+      content::VideoPictureInPictureWindowController* controller);
+  MultiviewTile(const MultiviewTile&) = delete;
+  MultiviewTile& operator=(const MultiviewTile&) = delete;
+  ~MultiviewTile() override;
+
+  content::VideoPictureInPictureWindowController* controller() const {
+    return controller_;
+  }
+  content::WebContents* GetSource() const;
+  bool is_shown() const { return shown_; }
+  const viz::SurfaceId& surface_id() const { return surface_id_; }
+  PlaybackState playback_state() const { return playback_state_; }
+  bool play_pause_visible() const { return play_pause_visible_; }
+
+  // Width divided by height of the video, 16:9 until the size is known.
+  float GetAspectRatio() const;
+
+  // Called by the view of this tile while it exists.
+  void SetView(MultiviewTileView* view);
+
+  // Called by the view when the video's place on screen changes. The page
+  // sees the size as the size of its picture-in-picture window.
+  void SetVideoBoundsInScreen(const gfx::Rect& bounds);
+
+  // content::VideoOverlayWindow:
+  bool IsActive() const override;
+  void Close() override;
+  void ShowInactive() override;
+  void Hide() override;
+  bool IsVisible() const override;
+  gfx::Rect GetBounds() override;
+  void UpdateNaturalSize(const gfx::Size& natural_size) override;
+  void SetPlaybackState(PlaybackState playback_state) override;
+  void SetPlayPauseButtonVisibility(bool is_visible) override;
+  void SetSkipAdButtonVisibility(bool is_visible) override {}
+  void SetNextTrackButtonVisibility(bool is_visible) override {}
+  void SetPreviousTrackButtonVisibility(bool is_visible) override {}
+  void SetHidePictureInPictureButtonVisibility(bool is_visible) override {}
+  void SetMicrophoneMuted(bool muted) override {}
+  void SetCameraState(bool turned_on) override {}
+  void SetMediaMuted(bool muted) override {}
+  void SetToggleMicrophoneButtonVisibility(bool is_visible) override {}
+  void SetToggleCameraButtonVisibility(bool is_visible) override {}
+  void SetHangUpButtonVisibility(bool is_visible) override {}
+  void SetNextSlideButtonVisibility(bool is_visible) override {}
+  void SetPreviousSlideButtonVisibility(bool is_visible) override {}
+  void SetMediaPosition(const media_session::MediaPosition& position) override {
+  }
+  void SetSourceTitle(const std::u16string& source_title) override {}
+  void SetFaviconImages(
+      const std::vector<media_session::MediaImage>& images) override {}
+  void SetSurfaceId(const viz::SurfaceId& surface_id) override;
+  void SetPlaybackControlsVisibility(bool is_visible) override {}
+  void SetImmersiveVideoOptions(
+      const content::ImmersiveOptions& options) override {}
+
+ private:
+  // Has the controller destroy this window, so that the tab's next
+  // picture-in-picture session gets a new one, which may be a floating window.
+  void DestroyWindow();
+
+  const raw_ptr<content::VideoPictureInPictureWindowController> controller_;
+  base::WeakPtr<MultiviewHost> host_;
+  raw_ptr<MultiviewTileView> view_ = nullptr;
+  bool shown_ = false;
+  viz::SurfaceId surface_id_;
+  gfx::Size natural_size_;
+  // Before the first layout the page is told a typical tile size.
+  gfx::Rect bounds_{0, 0, 640, 360};
+  PlaybackState playback_state_ = kPlaying;
+  bool play_pause_visible_ = false;
+
+  // Invalidated when the tile is shown again before a posted DestroyWindow()
+  // runs.
+  base::WeakPtrFactory<MultiviewTile> destroy_weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_OVERLAY_MULTIVIEW_MULTIVIEW_TILE_H_
diff --git a/chrome/browser/ui/views/overlay/multiview/multiview_ui.cc b/chrome/browser/ui/views/overlay/multiview/multiview_ui.cc
new file mode 100644
index 0000000000..17134c79b9
--- /dev/null
+++ b/chrome/browser/ui/views/overlay/multiview/multiview_ui.cc
@@ -0,0 +1,100 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/overlay/multiview/multiview_ui.h"
+
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/i18n/rtl.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/strings/escape.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace {
+
+constexpr char kMainCss[] = R"CSS(html, body {
+  height: 100%;
+  margin: 0;
+}
+body {
+  align-items: center;
+  background: #000;
+  color: #9aa0a6;
+  display: flex;
+  font: 15px system-ui, sans-serif;
+  justify-content: center;
+  text-align: center;
+}
+p {
+  max-width: 420px;
+}
+)CSS";
+
+std::string Escape(std::u16string_view text) {
+  return base::EscapeForHTML(base::UTF16ToUTF8(text));
+}
+
+// Builds the page in the browser's language. The hint names the Send to
+// Multiview button in bold.
+std::string BuildMainHtml() {
+  const std::u16string button =
+      l10n_util::GetStringUTF16(IDS_MULTIVIEW_SEND_TO_MULTIVIEW);
+  size_t button_offset = 0;
+  const std::u16string hint = l10n_util::GetStringFUTF16(
+      IDS_MULTIVIEW_PAGE_HINT, button, &button_offset);
+  const std::u16string_view hint_view(hint);
+
+  return base::StrCat(
+      {"<!doctype html>\n<html dir=\"", base::i18n::IsRTL() ? "rtl" : "ltr",
+       "\" lang=\"",
+       base::EscapeForHTML(g_browser_process->GetApplicationLocale()),
+       "\">\n<head>\n<meta charset=\"utf-8\">\n"
+       "<meta name=\"color-scheme\" content=\"dark\">\n<title>",
+       Escape(l10n_util::GetStringUTF16(IDS_MULTIVIEW_TITLE)),
+       "</title>\n<link rel=\"stylesheet\" href=\"multiview.css\">\n"
+       "</head>\n<body>\n<p>",
+       Escape(hint_view.substr(0, button_offset)), "<b>", Escape(button),
+       "</b>", Escape(hint_view.substr(button_offset + button.size())),
+       "</p>\n</body>\n</html>\n"});
+}
+
+// The file a request asks for: its path without a query or fragment.
+std::string_view RequestedFile(std::string_view path) {
+  return path.substr(0, path.find_first_of("?#"));
+}
+
+bool ShouldHandleRequest(const std::string& path) {
+  const std::string_view file = RequestedFile(path);
+  return file.empty() || file == "multiview.css";
+}
+
+void HandleRequest(const std::string& path,
+                   content::WebUIDataSource::GotDataCallback callback) {
+  std::string body =
+      RequestedFile(path).empty() ? BuildMainHtml() : std::string(kMainCss);
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::move(body)));
+}
+
+}  // namespace
+
+MultiviewUI::MultiviewUI(content::WebUI* web_ui)
