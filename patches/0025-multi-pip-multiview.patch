+void ContentsWebView::ChildVisibilityChanged(views::View* child) {
+  views::WebView::ChildVisibilityChanged(child);
+  // While the grid shows videos it covers the page, and the page must not
+  // take the mouse events aimed at the grid.
+  if (child == multiview_grid_) {
+    holder()->SetVisible(!child->GetVisible());
+  }
+}
