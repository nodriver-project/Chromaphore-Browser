+
+namespace ui {
+class Compositor;
+}  // namespace ui
+
+namespace views {
+class ImageButton;
+}  // namespace views
+
+class MultiviewHost;
+class MultiviewTile;
+
+// One video in the Multiview tab: the video's compositor surface, letterboxed
+// in the tile. Moving the mouse over it shows its controls; once the mouse
+// rests for a few seconds, the controls and the pointer go away.
+class MultiviewTileView : public views::View, public ui::CompositorObserver {
+  METADATA_HEADER(MultiviewTileView, views::View)
+
+ public:
+  explicit MultiviewTileView(MultiviewTile* tile);
+  MultiviewTileView(const MultiviewTileView&) = delete;
+  MultiviewTileView& operator=(const MultiviewTileView&) = delete;
+  ~MultiviewTileView() override;
+
+  MultiviewTile* tile() const { return tile_; }
+
+  // Called by the tile.
+  void OnTileDestroyed();
+  void UpdateSurface();
+  void UpdateControls();
+
+  // views::View:
+  void Layout(PassKey) override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+  void OnMouseMoved(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+  ui::Cursor GetCursor(const ui::MouseEvent& event) override;
+
+  // ui::CompositorObserver:
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override;
+
+ private:
+  // The video's rect in this view, the largest that keeps its aspect ratio.
+  gfx::Rect GetVideoBounds() const;
+
+  // The window's compositor must know the video's frame sink to drive it.
+  void RegisterFrameSink();
+  void UnregisterFrameSink();
+
+  // Shows the controls until the mouse has rested for a few seconds.
+  void ShowControlsForAWhile();
+  void OnMouseRested();
+  void HideControls();
+
+  void TogglePlayPause();
+  void ToggleMute();
+  void BackToTab();
+  void Remove();
+
+  raw_ptr<MultiviewTile> tile_;
+  raw_ptr<views::View> video_view_ = nullptr;
+  raw_ptr<views::View> controls_view_ = nullptr;
+  raw_ptr<views::ImageButton> play_pause_button_ = nullptr;
+  raw_ptr<views::ImageButton> mute_button_ = nullptr;
+
+  raw_ptr<ui::Compositor> compositor_ = nullptr;
+  viz::FrameSinkId frame_sink_id_;
+
+  base::OneShotTimer hide_controls_timer_;
+  // In screen coordinates, to tell a real move from a repeated one.
+  std::optional<gfx::Point> last_mouse_location_;
+};
+
+// The videos of a Multiview tab, drawn over the tab's page while the tab is
+// shown. Hidden while there are no videos, so the page's hint shows.
+class MultiviewGridView : public views::View {
+  METADATA_HEADER(MultiviewGridView, views::View)
+
+ public:
+  explicit MultiviewGridView(MultiviewHost* host);
+  MultiviewGridView(const MultiviewGridView&) = delete;
+  MultiviewGridView& operator=(const MultiviewGridView&) = delete;
+  ~MultiviewGridView() override;
+
+  // Matches the tile views to the host's shown tiles and lays them out.
+  void Update();
+
+  // Called when the host goes away before this view.
+  void ClearHost();
+
+  // views::View:
+  void Layout(PassKey) override;
+
+ private:
+  raw_ptr<MultiviewHost> host_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_OVERLAY_MULTIVIEW_MULTIVIEW_GRID_VIEW_H_
