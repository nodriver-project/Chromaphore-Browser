+  // browser: what the paste leads to is watched from here.
+  base::WeakPtr<ActionOutcomeWatch> watch = OutcomeWatch()->GetWeakPtr();
+  const int action_id = watch->ArmKeys(widget_host, follow_navigation);
+  StartChordSession(kCtrlModifierBit, "v", /*phase=*/0, speed_multiplier,
+                    base::BindOnce(&InputHandler::OnPasteChordFinished,
+                                   weak_factory_.GetWeakPtr(), watch, action_id,
+                                   std::move(text), read_back, before_root,
+                                   std::move(before), std::move(callback)));
+}
+
+void InputHandler::OnPasteChordFinished(
+    base::WeakPtr<ActionOutcomeWatch> watch,
+    int action_id,
+    std::string text,
+    bool read_back,
+    GlobalRenderFrameHostId before_root,
+    blink::mojom::AgentFieldReadingPtr before,
+    std::unique_ptr<DispatchPasteCallback> callback,
+    bool success) {
+  if (!success) {
+    if (watch) {
+      watch->Abandon(action_id);
+    }
+    callback->sendFailure(Response::ServerError("Paste aborted"));
+    return;
+  }
+  ActionOutcomeWatch::Reply(
+      watch.get(), action_id,
+      base::BindOnce(&InputHandler::AnswerPaste, weak_factory_.GetWeakPtr(),
+                     std::move(callback), std::move(text), read_back,
+                     before_root, std::move(before)));
