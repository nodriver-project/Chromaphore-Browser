+// browser: a key pressed and released by Input.performDrag's executor (an
+// Escape that cancels a pointer library's drag), through the path
+// Input.dispatchKeyChord takes; its answer posted.
+void InputHandler::PressKey(const std::string& key,
+                            base::OnceCallback<void(bool ok)> done) {
+  base::OnceCallback<void(bool)> posted = PostedReply(std::move(done));
+  if (!KeyboardTypingSession::IsChordKey(key)) {
+    std::move(posted).Run(false);
+    return;
+  }
+  StartChordSession(/*modifiers=*/0, key, /*phase=*/0,
+                    /*speed_multiplier=*/1.0, std::move(posted));
