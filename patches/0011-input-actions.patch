@@ -0,0 +1,39 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_RENDERER_HOST_INPUT_LOCK_KEY_EVENT_FLAGS_H_
+#define CONTENT_BROWSER_RENDERER_HOST_INPUT_LOCK_KEY_EVENT_FLAGS_H_
+
+#include "build/build_config.h"
+#include "ui/events/event_constants.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "ui/events/event_utils.h"
+#elif BUILDFLAG(IS_LINUX)
+#include "third_party/blink/public/common/user_agent/presents_windows_platform.h"
+#endif
+
+namespace content {
+
+// browser: the lock keys' state as ui::EventFlags bits, as real input carries
+// it. Windows reports NumLock, CapsLock and ScrollLock on every mouse, wheel
+// and key event it builds, so the synthetic ones report them too; zero on
+// other platforms. ui::EventFlagsToWebEventModifiers() turns the result into
+// blink::WebInputEvent modifiers.
+inline int LockKeyEventFlags() {
+#if BUILDFLAG(IS_WIN)
+  return ui::GetModifiersFromKeyState() &
+         (ui::EF_NUM_LOCK_ON | ui::EF_CAPS_LOCK_ON | ui::EF_SCROLL_LOCK_ON);
+#elif BUILDFLAG(IS_LINUX)
+  // browser: a Linux build presenting Windows reports a Windows desktop's
+  // usual state, NumLock on, the others off.
+  return blink::PresentsWindowsPlatform() ? ui::EF_NUM_LOCK_ON : 0;
+#else
+  return 0;
+#endif
+}
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_RENDERER_HOST_INPUT_LOCK_KEY_EVENT_FLAGS_H_
