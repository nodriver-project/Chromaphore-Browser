+  drag_source_.reset();
+  const bool drop = drag->end == DragPath::End::kDrop;
+  RenderWidgetHostImpl* target =
+      drag->over ? RenderWidgetHostImpl::From(drag->over->GetRenderWidgetHost())
+                 : nullptr;
+  ui::mojom::DragOperation operation = ui::mojom::DragOperation::kNone;
+  std::string outcome = "cancelled";
+  if (success && drop && target &&
+      drag->operation != ui::mojom::DragOperation::kNone) {
+    // Dropped where the button came up: drop on the target, then dragend on
+    // the source, half a millisecond apart, as Windows ends a drag -- and no
+    // extra dragover just before, which stock dispatchDragEvent sends.
+    DropData dropped(*drag->drop_data);
+    target->FilterDropData(&dropped);
+    dropped.operation = drag->operation;
+    dropped.document_is_handling_drag = drag->document_is_handling_drag;
+    // browser: the page's answer to the drop is what Input.performDrag's
+    // outcome waits for.
+    target->DragTargetDrop(
+        dropped, drag->over_point, drag->over_screen, drag->drop_modifiers,
+        outcome_watch_ ? outcome_watch_->DropSent(target)
+                       : base::OnceClosure(base::DoNothing()));
+    operation = drag->operation;
+    outcome = "dropped";
+  } else {
+    // Called off, or let go over something that would not take it.
+    if (target) {
+      target->DragTargetDragLeave(drag->over_point, drag->over_screen);
+    }
+    if (success && drop) {
+      outcome = "refused";
+    }
+  }
+  // The source hears where the drag ended, in its own view -- which may be
+  // another frame's than the target's -- as WebContentsViewAura::EndDrag
+  // tells it.
+  RenderWidgetHostImpl* source = drag->source.get();
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  if (source && web_contents_) {
+    gfx::PointF source_point = drag->over_root;
+    gfx::PointF screen_point = drag->over_screen;
+    if (widget_host && widget_host->GetView()) {
+      screen_point = ConvertWidgetPointToScreenPoint(*widget_host->GetView(),
+                                                     drag->over_root);
+      if (source->GetView()) {
+        widget_host->GetView()->TransformPointToCoordSpaceForView(
+            drag->over_root, source->GetView(), &source_point);
+      }
+    }
+    web_contents_->DragSourceEndedAt(source_point.x(), source_point.y(),
+                                     screen_point.x(), screen_point.y(),
+                                     operation, source);
+    web_contents_->SystemDragEnded(source);
+  }
+  // The button came up inside the system's drag loop: the page gets no
+  // mouseup. (No capture to give up: a debugger press takes none.)
+  DragPathGone(*drag, outcome);
+}
