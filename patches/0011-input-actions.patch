+void InputHandler::DragPathStep() {
+  if (!drag_path_) {
+    return;
+  }
+  DragPath& drag = *drag_path_;
+  if (drag.hit_testing) {
+    return;  // the point on its way goes on when its hit test answers
+  }
+  if (drag.next >= drag.points.size()) {
+    DragPathRest();
+    return;
+  }
+  // browser: on the plan's clock. A point whose successor is already due (a
+  // hit test was out while the hand moved on) is not sent, as a mouse's
+  // reports coalesce while the drag loop is busy: the hand is where the plan
+  // has it at each moment, and a band takes the time the plan gave it. The
+  // walk's last point and a kept one (leaving a band) always go.
+  const base::TimeTicks step_at = base::TimeTicks::Now();
+  while (drag.next + 1 < drag.points.size() &&
+         !(drag.next < drag.keep.size() && drag.keep[drag.next]) &&
+         drag.started + drag.interval * static_cast<double>(drag.next + 1) <=
+             step_at) {
+    drag.next++;
+  }
+  if (drag.over && drag.points[drag.next] == drag.over_root) {
+    // browser: a point the pointer has not moved from sends nothing -- but a
+    // pointer still for a while is asked about again, as the system's drag
+    // loop asks every 53-73 ms. The next point goes when the polling grid
+    // says, as below.
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (now - drag.last_over_at >= drag.quiet_after) {
+      if (RenderWidgetHostImpl* over_host =
+              RenderWidgetHostImpl::From(drag.over->GetRenderWidgetHost())) {
+        drag.replies_pending++;
+        over_host->DragTargetDragOver(
+            drag.over_point, drag.over_screen, drag.mask, drag.key_modifiers,
+            base::BindOnce(&InputHandler::OnDragPathReply,
+                           weak_factory_.GetWeakPtr(), drag.id,
+                           drag.over_generation));
+        NoteDragOver(now);
+        drag.quiet_after = DragLoopAskDelay();
+      }
+    }
+    drag.next++;
+    base::TimeTicks due = drag.started +
+                          drag.interval * static_cast<double>(drag.next) +
+                          PollingJitter(drag.interval);
+    // Still on the pixel at the next point too (not the walk's last): the
+    // system's loop asks again on its own clock, not the mouse's polling
+    // grid. Points stay timed from `started`; one that moves goes on time.
+    if (drag.next + 1 < drag.points.size() &&
+        drag.points[drag.next] == drag.over_root) {
+      due = std::min(due, drag.last_over_at + drag.quiet_after);
+    }
+    drag.timer.Start(FROM_HERE,
+                     std::max(due - base::TimeTicks::Now(), base::TimeDelta()),
+                     base::BindOnce(&InputHandler::DragPathStep,
+                                    weak_factory_.GetWeakPtr()));
+    return;
+  }
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  if (!widget_host || !widget_host->delegate() ||
+      !widget_host->delegate()->GetInputEventRouter() ||
+      !widget_host->GetView()) {
+    EndDragPath(false);
+    return;
+  }
+  // A hit test that never answers -- its targeter gone -- calls the drag off
+  // rather than leaving it held for good.
+  drag.hit_testing = true;
+  drag.timer.Start(FROM_HERE, kDragHitTestTimeout,
+                   base::BindOnce(&InputHandler::EndDragPath,
+                                  weak_factory_.GetWeakPtr(), false));
+  // Each point goes to whatever is under it, as the system's drag loop asks
+  // the window under the cursor.
+  widget_host->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+      widget_host->GetView(), drag.points[drag.next],
+      base::BindOnce(&InputHandler::OnDragPathWidget,
+                     weak_factory_.GetWeakPtr(), drag.id, drag.call));
+}
+
+void InputHandler::OnDragPathWidget(
+    uint64_t drag_id,
+    int call,
+    base::WeakPtr<RenderWidgetHostViewBase> target,
+    std::optional<gfx::PointF> maybe_point) {
+  if (!drag_path_ || drag_path_->id != drag_id || drag_path_->call != call) {
+    return;  // the answer for a drag that has ended, or a call overtaken
+  }
+  drag_path_->hit_testing = false;
+  if (drag_path_->next >= drag_path_->points.size()) {
+    DragPathStep();  // the path was cut short meanwhile
+    return;
+  }
+  RenderWidgetHostImpl* host =
+      target ? RenderWidgetHostImpl::From(target->GetRenderWidgetHost())
+             : nullptr;
+  if (!host || !maybe_point.has_value()) {
+    EndDragPath(false);
+    return;
+  }
+  DragPath& drag = *drag_path_;
+  const gfx::PointF point = *maybe_point;
+  const gfx::PointF screen = ConvertWidgetPointToScreenPoint(*target, point);
+  if (drag.over.get() != target.get()) {
+    // Into another view, or into the page at all: the one it leaves hears so,
+    // and the one it enters is given the data, as that view may see it. What
+    // it will take is not known until it answers.
+    if (RenderWidgetHostViewBase* left = drag.over.get()) {
+      if (RenderWidgetHostImpl* left_host =
+              RenderWidgetHostImpl::From(left->GetRenderWidgetHost())) {
+        left_host->DragTargetDragLeave(drag.over_point, drag.over_screen);
+      }
+    }
+    drag.over_generation++;
+    drag.replies_pending = 1;
+    drag.operation = ui::mojom::DragOperation::kNone;
+    drag.document_is_handling_drag = false;
+    DropData entering(*drag.drop_data);
+    host->FilterDropData(&entering);
+    host->DragTargetDragEnter(entering, point, screen, drag.mask,
+                              drag.key_modifiers,
+                              base::BindOnce(&InputHandler::OnDragPathReply,
+                                             weak_factory_.GetWeakPtr(),
+                                             drag.id, drag.over_generation));
+  } else {
+    drag.replies_pending++;
+    host->DragTargetDragOver(point, screen, drag.mask, drag.key_modifiers,
+                             base::BindOnce(&InputHandler::OnDragPathReply,
+                                            weak_factory_.GetWeakPtr(), drag.id,
+                                            drag.over_generation));
+  }
+  drag.over = target;
+  drag.over_point = point;
+  drag.over_screen = screen;
+  drag.over_root = drag.points[drag.next];
+  NoteDragOver(base::TimeTicks::Now());
+  drag.quiet_after = DragLoopAskDelay();
+  drag.next++;
+  // The next point when the polling grid says, off it by up to 30% of an
+  // interval either way, as the UI thread's own timing is.
+  const base::TimeTicks due = drag.started +
+                              drag.interval * static_cast<double>(drag.next) +
+                              PollingJitter(drag.interval);
+  drag.timer.Start(
+      FROM_HERE, std::max(due - base::TimeTicks::Now(), base::TimeDelta()),
+      base::BindOnce(&InputHandler::DragPathStep, weak_factory_.GetWeakPtr()));
+}
+
+void InputHandler::OnDragPathReply(uint64_t drag_id,
+                                   int over_generation,
+                                   ui::mojom::DragOperation operation,
+                                   bool document_is_handling_drag) {
+  if (!drag_path_ || drag_path_->id != drag_id ||
+      drag_path_->over_generation != over_generation) {
+    return;  // from a drag that has ended, or a view it has left
+  }
+  DragPath& drag = *drag_path_;
+  drag.replies_pending = std::max(0, drag.replies_pending - 1);
+  drag.operation = operation;
+  drag.document_is_handling_drag = document_is_handling_drag;
+}
+
+void InputHandler::DragPathRest() {
+  if (!drag_path_) {
+    return;
+  }
+  DragPath& drag = *drag_path_;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // Just arrived from the walk's last point, whose dragover has gone out.
+  const bool arrived = !drag.held && drag.rest_until.is_null();
+  if (!drag.held) {
+    if (arrived) {
+      drag.rest_until = now;
+    }
+    if (drag.end != DragPath::End::kHold) {
+      // Let go, with no dragover first. A drop is decided on what the view
+      // said last, so it waits for answers still on their way.
+      if (drag.end == DragPath::End::kDrop && drag.replies_pending > 0) {
+        if (drag.settle_until.is_null()) {
+          drag.settle_until = now + drag.settle_cap;
+        }
+        if (now < drag.settle_until) {
+          drag.timer.Start(FROM_HERE, base::Milliseconds(4),
+                           base::BindOnce(&InputHandler::DragPathRest,
+                                          weak_factory_.GetWeakPtr()));
+          return;
+        }
+      }
+      EndDragPath(true);
+      return;
+    }
+    // Walked there and held: the executor hears so, and the drag stays where
+    // it is until the next walk carries it on or it is let go of.
+    drag.held = true;
+    drag.held_since = now;
+    if (drag.walk_arrived) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, std::move(drag.walk_arrived));
+    }
+  } else if (now - drag.held_since > kDragHeldQuietAfter) {
+    return;  // held far longer than a hand holds one: left quiet
+  }
+  // Still: the system's drag loop asks the window under the cursor again every
+  // ~60 ms, and the page hears drag and dragover each time.
+  if (!arrived && drag.over) {
+    if (RenderWidgetHostImpl* host =
+            RenderWidgetHostImpl::From(drag.over->GetRenderWidgetHost())) {
+      drag.replies_pending++;
+      host->DragTargetDragOver(drag.over_point, drag.over_screen, drag.mask,
+                               drag.key_modifiers,
+                               base::BindOnce(&InputHandler::OnDragPathReply,
+                                              weak_factory_.GetWeakPtr(),
+                                              drag.id, drag.over_generation));
+      NoteDragOver(base::TimeTicks::Now());
+    }
+  }
+  base::TimeDelta delay = DragLoopAskDelay();
+  if (arrived && !drag.last_over_at.is_null()) {
+    // browser: on the cadence the walk's last dragover set, which may have
+    // gone out a while before arriving: points not moved from send none.
+    delay =
+        std::max(drag.last_over_at + drag.quiet_after - now, base::TimeDelta());
+  }
+  drag.timer.Start(
+      FROM_HERE, std::max(delay, base::TimeDelta()),
+      base::BindOnce(&InputHandler::DragPathRest, weak_factory_.GetWeakPtr()));
+}
