+    blink::mojom::AgentFieldReadingPtr before) {
+  // A later typing call, chord or paste came meanwhile: it took the keys.
+  if (request != typing_request_) {
+    callback->sendFailure(Response::ServerError("Paste aborted"));
+    return;
+  }
+  StartPaste(std::move(text), speed_multiplier, follow_navigation,
+             /*read_back=*/true, std::move(callback), root, std::move(before));
+}
