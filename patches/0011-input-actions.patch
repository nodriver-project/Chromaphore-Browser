+// A wheel's sequence keeps the scroller it began on until it has rested this
+// long, or the pointer has gone this far (DIPs) from where it began
+// (MouseWheelPhaseHandler): a turn after either begins a new one.
+constexpr base::TimeDelta kSequenceRest = base::Milliseconds(500);
+constexpr double kSequenceSlopDips = 10;
+// A notch's scroll shows within this long: notches turned more recently are
+// counted as on their way.
+constexpr base::TimeDelta kInFlight = base::Milliseconds(250);
+// A settled reading waits at most this long for the scroll to run out.
+constexpr int kSettleMs = 1500;
+// At most this many settled rounds of single notches.
+constexpr int kMaxSettleRounds = 8;
+// The hand moves at most this many times back over the scroller, and once to
+// find one.
+constexpr int kMaxHandMoves = 3;
+constexpr int kMaxFinds = 1;
+// A wheel point's width, for the leg's timing (the reveal's).
+constexpr double kMoveWidthPx = 40;
+// What a notch moves a scroller, in CSS px, until measured; and the bounds of
+// a measurement.
+constexpr double kNotchPx = 100;
+constexpr double kMinPerNotch = 10;
+constexpr double kMaxPerNotch = 400;
+// Less than this has not moved.
+constexpr double kMovedPx = 0.5;
+
+// A hand that has just come to rest turns the wheel this long later.
+base::TimeDelta RestPause() {
+  return base::Milliseconds(base::RandIntInclusive(80, 200));
+}
+
+// A notch that begins a new wheel sequence waits this long after the last
+// one: a little past kSequenceRest, a hand's pause before it turns the
+// wheel again.
+base::TimeDelta NewSequenceGap() {
+  return base::Milliseconds(base::RandIntInclusive(560, 700));
+}
+
+// Notches turned in a row are this far apart, at a hand's pace.
+base::TimeDelta NotchGap(bool flick, double speed_multiplier) {
+  return flick ? ScaledDelay(40, 89, speed_multiplier)
+               : ScaledDelay(45, 104, speed_multiplier);
+}
+
+WheelScrollerFigures FiguresOf(const blink::mojom::AgentWheelScroller& s) {
+  // A figure of the renderer's that is not finite reads as 0.
+  const auto finite = [](double v) { return std::isfinite(v) ? v : 0.0; };
+  WheelScrollerFigures figures;
+  figures.name = s.name;
+  figures.page = s.is_top_window;
+  figures.position = finite(s.position);
+  figures.raw = finite(s.raw);
+  figures.max = finite(s.max);
+  figures.length = finite(s.length);
+  return figures;
+}
