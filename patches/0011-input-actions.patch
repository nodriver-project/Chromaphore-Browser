+namespace content::protocol {
+
+namespace {
+
+// After the click, a chooser is waited for this long: the life of the
+// click's activation, past which the page can open none. After the files
+// went to it, the field is read every frame at most this long.
+constexpr base::TimeDelta kChooserWait = base::Seconds(5);
+constexpr base::TimeDelta kSettle = base::Milliseconds(1000);
+constexpr base::TimeDelta kLookGap = base::Milliseconds(16);
+constexpr char kTimeoutReason[] = "the choice took longer than its timeoutMs";
+
+// Every file under `folder`, as Chrome lists a folder a person chose:
+// folders themselves are left out (FileSelectHelper's directory lister).
+std::vector<base::FilePath> ListFolder(base::FilePath folder) {
+  std::vector<base::FilePath> files;
+  base::FileEnumerator files_in(folder, /*recursive=*/true,
+                                base::FileEnumerator::FILES);
+  for (base::FilePath file = files_in.Next(); !file.empty();
+       file = files_in.Next()) {
+    files.push_back(file);
+  }
+  return files;
+}
+
+}  // namespace
+
+FileResult::FileResult() = default;
+FileResult::FileResult(FileResult&&) = default;
+FileResult& FileResult::operator=(FileResult&&) = default;
+FileResult::~FileResult() = default;
+
+FileSession::Params::Params() = default;
+FileSession::Params::Params(const Params&) = default;
+FileSession::Params& FileSession::Params::operator=(const Params&) = default;
+FileSession::Params::~Params() = default;
+
+FileSession::FileSession(InputHandler& handler,
+                         uint64_t id,
+                         Params params,
+                         Completion completion,
+                         base::OnceCallback<void(uint64_t)> on_done)
+    : handler_(handler),
+      id_(id),
+      params_(std::move(params)),
+      completion_(std::move(completion)),
+      on_done_(std::move(on_done)),
+      started_(base::TimeTicks::Now()) {}
+
+FileSession::~FileSession() {
+  // The handler is going (its input state reset): nothing of it is asked.
+  if (completion_) {
+    handler_alive_ = false;
+    // Its outcome watch is not asked either.
+    action_id_ = 0;
+    Send("interrupted", InterruptionName(InputHandler::Interruption::kReset),
+         std::string(), std::string(), /*wait=*/false);
+  }
+  CancelChooser();
+}
+
+base::WeakPtr<FileSession> FileSession::Weak() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void FileSession::Start() {
+  timeout_timer_.Start(FROM_HERE, params_.timeout,
+                       base::BindOnce(&FileSession::OnTimeout, Weak()));
+  RenderFrameHostImpl* rfh =
+      handler_->BindCollectorForFrame(params_.frame_id, &collector_);
+  if (!rfh) {
+    Answer("gone", "the element's frame is gone");
+    return;
+  }
+  local_root_ = rfh->GetGlobalId();
+  // Whether each path is there, and what it is, read off the UI thread.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&FileSession::StatPaths, params_.paths),
+      base::BindOnce(&FileSession::OnStatted, Weak()));
+}
+
+// static
+std::vector<FileSession::PathKind> FileSession::StatPaths(
+    std::vector<base::FilePath> paths) {
+  std::vector<PathKind> kinds;
+  for (const base::FilePath& path : paths) {
+    if (base::DirectoryExists(path)) {
+      if (!base::PathIsReadable(path)) {
+        kinds.push_back(PathKind::kMissing);
+        continue;
+      }
+      // A folder holding no file would empty the field of what it holds.
+      base::FileEnumerator files_in(path, /*recursive=*/true,
+                                    base::FileEnumerator::FILES);
+      kinds.push_back(files_in.Next().empty() ? PathKind::kEmptyFolder
+                                              : PathKind::kFolder);
+    } else if (base::PathExists(path) && base::PathIsReadable(path)) {
+      kinds.push_back(PathKind::kFile);
+    } else {
+      kinds.push_back(PathKind::kMissing);
+    }
+  }
+  return kinds;
+}
+
+void FileSession::OnStatted(std::vector<PathKind> kinds) {
+  if (answered()) {
+    return;
+  }
+  kinds_ = std::move(kinds);
+  for (size_t i = 0; i < kinds_.size(); ++i) {
+    if (kinds_[i] == PathKind::kMissing ||
+        kinds_[i] == PathKind::kEmptyFolder) {
+      path_ = params_.given[i];
+      Answer("missing",
+             kinds_[i] == PathKind::kEmptyFolder ? "empty" : std::string());
+      return;
+    }
+  }
+  Ask(Read::kFirst);
+}
+
+void FileSession::Interrupt(InputHandler::Interruption why) {
+  if (answered()) {
+    return;
+  }
+  if (given_) {
+    // The files went to the chooser: only the reading after it was cut
+    // short, or its frame went (the navigation it led to is in its outcome).
+    Answer("chosen", why == InputHandler::Interruption::kNavigated ? "navigated"
+                                                                   : "unread");
+    return;
+  }
+  StopSteps();
+  CancelChooser();
+  Answer("interrupted", InterruptionName(why));
+}
+
+void FileSession::StopSteps() {
+  if (moving_) {
+    // The hand stops where it has got to (its answer, posted, finds this one
+    // answered).
+    handler_->InterruptMoveSession();
+  }
+  if (revealing_ && handler_->reveal_) {
+    handler_->AnswerReveal("interrupted");
+  }
+}
+
+void FileSession::CancelChooser() {
+  if (listener_) {
+    // As a person closing the dialog: the page hears its cancel.
+    scoped_refptr<FileSelectListener> listener = std::move(listener_);
+    listener->FileSelectionCanceled();
+  }
+}
+
+void FileSession::Ask(Read read) {
+  mojo::Remote<blink::mojom::AgentSnapshotCollector>& collector =
+      read == Read::kAfter ? chooser_collector_ : collector_;
+  const int32_t node_id =
+      read == Read::kAfter ? chosen_node_id_ : params_.node_id;
+  if (!collector.is_connected()) {
+    OnRead(read, blink::mojom::AgentFileReadingPtr());
+    return;
+  }
+  collector->ReadFileField(
+      node_id,
+      read == Read::kAfter ? wanted_names_ : std::vector<std::string>(),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&FileSession::OnRead, Weak(), read),
+          blink::mojom::AgentFileReadingPtr()));
+}
+
+bool FileSession::LookAgain(Read read) {
+  if (base::TimeTicks::Now() >= deadline_) {
+    return false;
+  }
+  clock_.Start(FROM_HERE, kLookGap,
+               base::BindOnce(&FileSession::Ask, Weak(), read));
+  return true;
+}
+
+void FileSession::OnRead(Read read, blink::mojom::AgentFileReadingPtr reading) {
+  if (answered() || timed_out_) {
+    return;
+  }
+  if (!reading || reading->kind == "gone") {
+    if (given_) {
+      // The files went to the chooser and the page replaced the field after
+      // them (an onchange that renders it anew): chosen, not read back.
+      Answer("chosen", reading ? "replaced" : "unread");
+    } else if (reached_) {
+      Answer("interrupted", "gone");
+    } else {
+      Answer("gone", reading ? "the element is no longer in the page"
+                             : "the page's renderer went away");
+    }
+    return;
+  }
+  const blink::mojom::AgentFileReading& r = *reading;
+  switch (read) {
+    case Read::kFirst:
+      OnFirstRead(r);
+      return;
+    case Read::kAfter:
+      count_ = r.count;
+      // Files by their names, in order; a folder's by their count.
+      if (mode_ == "folder" ? count_ == wanted_count_ : r.matches) {
+        Answer("chosen");
+        return;
+      }
+      if (!LookAgain(read)) {
+        // A folder's links to elsewhere are left out by the browser (its
+        // RemoveSymlinks), so a folder holding some is chosen as it is. An
+        // empty field may be one the page emptied once it took the files
+        // (an upload on change): said so, not claimed either way.
+        if (mode_ == "folder" && count_ > 0) {
+          Answer("chosen");
+        } else {
+          Answer("mismatch", count_ == 0 ? "empty" : std::string());
+        }
+      }
+      return;
+  }
+}
+
+void FileSession::OnFirstRead(const blink::mojom::AgentFileReading& r) {
+  if (r.kind == "file" || r.kind == "label") {
+    // A file input, or a label of one: the field, checked before anything
+    // moves.
+    field_node_id_ = r.field_node_id;
+    field_ = r.field;
+    mode_ = r.folder ? "folder" : r.multiple ? "multiple" : "single";
+    accept_ = r.accept;
+    count_ = r.count;
+    if (r.disabled) {
+      Answer("disabled");
+      return;
+    }
+    const std::string misfit = Misfit(mode_);
+    if (!misfit.empty()) {
+      Answer(misfit, misfit_reason_);
+      return;
+    }
+    // A person clicks the field where it shows, else its label (also when a
+    // press on the field itself was refused); a field with neither is opened
+    // by something the page made for it.
+    label_node_id_ = r.label_node_id;
+    label_name_ = r.label;
+    if (r.kind == "label" || (r.rendered && !field_refused_)) {
+      opener_node_id_ = params_.node_id;
+    } else if (r.label_node_id) {
+      opener_node_id_ = r.label_node_id;
+    } else if (field_refused_) {
+      // The press on it was refused, and the label tried in its place has
+      // gone since.
+      Answer("unreachable",
+             "the press on it was refused, and its label is no longer shown");
+      return;
+    } else {
+      opener_ = r.opener;
+      Answer("hiddenInput");
+      return;
+    }
+  } else {
+    // Anything else -- a button, a link -- is clicked as it is, and the
+    // chooser it opens says the field.
+    opener_node_id_ = params_.node_id;
+  }
+  if (!revealed_) {
+    Reveal();
+    return;
+  }
+  Open();
+}
+
+std::string FileSession::Misfit(const std::string& mode) {
+  misfit_reason_.clear();
+  if (mode == "folder") {
+    if (kinds_.size() == 1 && kinds_[0] == PathKind::kFolder) {
+      return std::string();
+    }
+    size_t i = 0;
+    while (i < kinds_.size() && kinds_[i] == PathKind::kFolder) {
+      ++i;
+    }
+    if (i < kinds_.size()) {
+      path_ = params_.given[i];
+    } else {
+      // Folders only, more than one: the second, as a person can pick one.
+      path_ = params_.given[1];
+      misfit_reason_ = "oneFolder";
+    }
+    return "notFolder";
+  }
+  for (size_t i = 0; i < kinds_.size(); ++i) {
+    if (kinds_[i] == PathKind::kFolder) {
+      path_ = params_.given[i];
+      return "folder";
+    }
+  }
+  if (mode == "single" && kinds_.size() > 1) {
+    return "single";
+  }
+  return std::string();
+}
+
+void FileSession::Reveal() {
+  if (answered()) {
+    return;
+  }
+  InputHandler::RevealRequest request;
+  request.backend_node_id = opener_node_id_;
+  request.frame_id = params_.frame_id;
+  request.x = params_.pointer_x;
+  request.y = params_.pointer_y;
+  request.timeout_ms = StepTimeoutMs(RemainingMs());
+  revealing_ = true;
+  // Its answer can come before RunReveal returns, and what follows sends
+  // more input: posted.
+  handler_->RunReveal(std::move(request),
+                      base::BindPostTaskToCurrentDefault(
+                          base::BindOnce(&FileSession::OnRevealed, Weak())));
+}
+
+void FileSession::OnRevealed(InputHandler::RevealResult result) {
+  revealing_ = false;
+  if (answered()) {
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  const std::string& outcome = result.outcome;
+  if (outcome == "shown" || outcome == "blocked") {
+    // In view, or as far as the wheel brings it: read again, then the
+    // press's own check says what reaches it.
+    revealed_ = true;
+    Ask(Read::kFirst);
+    return;
+  }
+  if (outcome == "covered") {
+    if (TryLabel()) {
+      return;
+    }
+    Answer("covered", "covered", result.covering.value_or(std::string()),
+           result.covering_kind.value_or(std::string()));
+    return;
+  }
+  if (outcome == "gone") {
+    Answer("gone", "the element is no longer in the page");
+    return;
+  }
+  if (outcome == "interrupted" || outcome == "timeout") {
+    Answer(outcome);
+    return;
+  }
+  if (TryLabel()) {
+    return;
+  }
+  Answer("unreachable", "it could not be brought into view (" + outcome + ")");
+}
+
+bool FileSession::TryLabel() {
+  // Only for the field itself, once, and when it has a label that shows: a
+  // field hidden away (clipped, kept for screen readers) is opened by its
+  // label, as a person opens it.
+  if (field_refused_ || !label_node_id_ || !field_node_id_ ||
+      opener_node_id_ != field_node_id_) {
+    return false;
+  }
+  field_refused_ = true;
+  // The click did not go out: its arm dropped, and no chooser waited for.
+  if (action_id_ && handler_alive_) {
+    if (ActionOutcomeWatch* watch = handler_->outcome_watch()) {
+      watch->Abandon(action_id_);
+    }
+  }
+  action_id_ = 0;
+  waiting_chooser_ = false;
+  revealed_ = false;
+  Ask(Read::kFirst);
+  return true;
+}
+
+void FileSession::Open() {
+  if (answered()) {
+    return;
+  }
+  // The click is the action, watched from here; the chooser it opens is
+  // taken from here (TakeChooser), whenever it comes.
+  action_id_ = handler_->OutcomeWatch()->ArmSelect(local_root_,
+                                                   params_.follow_navigation);
+  waiting_chooser_ = true;
+  InputHandler::MoveRequest move;
+  move.backend_node_id = opener_node_id_;
+  move.frame_id = params_.frame_id;
+  move.intent = params_.intent;
+  move.end_action = "click";
+  move.end_button = "left";
+  move.end_click_count = 1;
+  move.speed_multiplier = params_.speed_multiplier;
+  move.timeout_ms = StepTimeoutMs(RemainingMs());
+  move.pointer_x = params_.pointer_x;
+  move.pointer_y = params_.pointer_y;
+  move.follow_navigation = params_.follow_navigation;
+  move.arm = false;
+  moving_ = true;
+  handler_->RunMove(std::move(move),
+                    base::BindPostTaskToCurrentDefault(
+                        base::BindOnce(&FileSession::OnOpened, Weak())));
+}
+
+void FileSession::OnOpened(MoveResult result) {
+  moving_ = false;
+  if (answered()) {
+    return;
+  }
+  const bool clicked = !result.failure && result.outcome == "clicked";
+  if (clicked) {
+    reached_ = true;
+  }
+  if (!waiting_chooser_) {
+    // A chooser came on the click's way: its course goes on.
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  if (!clicked) {
+    const std::string& outcome = result.outcome;
+    if ((outcome == "covered" || outcome == "hidden" ||
+         outcome == "unreachable") &&
+        TryLabel()) {
+      return;
+    }
+    AnswerMove(result);
+    return;
+  }
+  clock_.Start(FROM_HERE, kChooserWait,
+               base::BindOnce(&FileSession::OnNoChooser, Weak()));
+}
+
+void FileSession::OnNoChooser() {
+  // The click's activation has run out: no chooser can come of it now.
+  waiting_chooser_ = false;
+  Answer("noChooser");
+}
+
+bool FileSession::TakeChooser(RenderFrameHostImpl* rfh,
+                              FileSelectListener* listener,
+                              const blink::mojom::FileChooserParams& params) {
+  if (answered() || !waiting_chooser_ || !rfh || !listener) {
+    return false;
+  }
+  waiting_chooser_ = false;
+  clock_.Stop();
+  reached_ = true;
+  listener_ = listener;
+  chooser_document_ = rfh->GetWeakDocumentPtr();
+  chooser_mode_ = params.mode;
+  if (accept_.empty()) {
+    accept_ = base::UTF16ToUTF8(base::JoinString(params.accept_types, u","));
+  }
+  // Which field it came from, read in its own renderer; the chooser is held
+  // until then, as a dialog is up while a person looks.
+  RenderFrameHostImpl* root = handler_->BindCollectorForFrame(
+      rfh->GetDevToolsFrameToken().ToString(), &chooser_collector_);
+  if (!root) {
+    CancelChooser();
+    Answer("interrupted", "gone");
+    return true;
+  }
+  chooser_root_ = root->GetGlobalId();
+  if (chooser_root_ != local_root_) {
+    // From outside the element named's local root -- another process's
+    // frame: a script can open only a field of its own frame or one of the
+    // same origin, which is in the same local root. Not this one.
+    CancelChooser();
+    count_ = -1;
+    field_.clear();
+    Answer("otherField");
+    return true;
+  }
+  if (field_node_id_) {
+    // The field named: whether its chooser is the one open, read on it.
+    collector_->ReadFileField(
+        field_node_id_, std::vector<std::string>(),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&FileSession::OnOpenField, Weak()),
+            blink::mojom::AgentFileReadingPtr()));
+    return true;
+  }
+  // Else the field it came from, looked for in the chooser's own frame
+  // only: a page queues choosers, and each one queued marks its field open.
+  chooser_collector_->ReadOpenFileField(
+      rfh->GetDevToolsFrameToken().ToString(),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&FileSession::OnOpenField, Weak()),
+          blink::mojom::AgentFileReadingPtr()));
+  return true;
+}
+
+void FileSession::OnOpenField(blink::mojom::AgentFileReadingPtr reading) {
+  if (answered()) {
+    return;
+  }
+  const bool found = reading && reading->kind == "file";
+  if (field_node_id_ &&
+      !(found && reading->open && reading->field_node_id == field_node_id_)) {
+    // The field named has no chooser open: this one is another field's.
+    // Cancelled; which field it came from is not read.
+    field_.clear();
+    count_ = -1;
+    CancelChooser();
+    Answer("otherField");
+    return;
+  }
+  if (found) {
+    chosen_node_id_ = reading->field_node_id;
+    field_ = reading->field;
+    if (accept_.empty()) {
+      accept_ = reading->accept;
+    }
+    count_ = reading->count;
+  }
+  // A page too large to look through for the field: given, not read back.
+  field_unread_ = reading && reading->kind == "unread";
+  mode_ =
+      chooser_mode_ == blink::mojom::FileChooserParams::Mode::kUploadFolder
+          ? "folder"
+      : chooser_mode_ == blink::mojom::FileChooserParams::Mode::kOpenMultiple
+          ? "multiple"
+          : "single";
+  // Checked again on the chooser itself, which says what the field takes
+  // when the element named was not the field.
+  const std::string misfit = Misfit(mode_);
+  if (!misfit.empty()) {
+    CancelChooser();
+    Answer(misfit, misfit_reason_);
+    return;
+  }
+  // As a person finding the files in the dialog: a pause, then the pick.
+  clock_.Start(FROM_HERE, ScaledDelay(1000, 3000, params_.speed_multiplier),
+               base::BindOnce(&FileSession::Choose, Weak()));
+}
+
+void FileSession::Choose() {
+  if (answered()) {
+    return;
+  }
+  if (!chooser_document_.AsRenderFrameHostIfValid()) {
+    // Its document went (a navigation, the frame removed) while the chooser
+    // was held: an answer would reach nothing.
+    CancelChooser();
+    Answer("interrupted", "navigated");
+    return;
+  }
+  if (mode_ == "folder") {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+        base::BindOnce(&ListFolder, params_.paths[0]),
+        base::BindOnce(&FileSession::Give, Weak()));
+    return;
+  }
+  Give(params_.paths);
+}
+
+void FileSession::Give(std::vector<base::FilePath> files) {
+  if (answered() || !listener_) {
+    return;
+  }
+  if (!chooser_document_.AsRenderFrameHostIfValid()) {
+    // Its document went while the folder was listed.
+    CancelChooser();
+    Answer("interrupted", "navigated");
+    return;
+  }
+  const bool folder = mode_ == "folder";
+  std::vector<blink::mojom::FileChooserFileInfoPtr> infos;
+  wanted_names_.clear();
+  for (const base::FilePath& file : files) {
+    if (!folder) {
+      // The name the page's File takes: the file's own (no display name).
+      wanted_names_.push_back(file.BaseName().AsUTF8Unsafe());
+    }
+    // A file a person picked takes its own name in the page; a folder's file
+    // its name as the folder lister reads it.
+    infos.push_back(blink::mojom::FileChooserFileInfo::NewNativeFile(
+        blink::mojom::NativeFileInfo::New(
+            file, folder ? file.BaseName().AsUTF16Unsafe() : std::u16string(),
+            std::vector<std::u16string>())));
+  }
+  wanted_count_ = static_cast<int>(files.size());
+  given_ = true;
+  // The browser's own answer to a chooser: it grants the page read access
+  // to each file (FileChooserImpl::FileSelected), and the field takes them.
+  scoped_refptr<FileSelectListener> listener = std::move(listener_);
+  listener->FileSelected(std::move(infos),
+                         folder ? params_.paths[0] : base::FilePath(),
+                         chooser_mode_);
+  if (!chosen_node_id_) {
+    // A field the page made and never put in it, or one not looked for to
+    // the end: given, not read back.
+    Answer("chosen", field_unread_ ? "unread" : "detached");
+    return;
+  }
+  // A large folder takes the renderer a while to make its files.
+  deadline_ = base::TimeTicks::Now() + kSettle +
+              (folder ? base::Milliseconds(wanted_count_) : base::TimeDelta());
+  Ask(Read::kAfter);
+}
+
+void FileSession::AnswerMove(const MoveResult& result) {
+  const std::string& outcome = result.outcome;
+  if (outcome == "gone") {
+    Answer("gone", result.reason);
+    return;
+  }
+  if (outcome == "covered" || outcome == "hidden" || outcome == "interrupted" ||
+      outcome == "timeout" || outcome == "unreachable") {
+    Answer(outcome, result.reason, result.hit, result.hit_kind);
+    return;
+  }
+  // Pressed, released or arrived: not the click asked for.
+  Answer("unreachable", "the click did not go out (" + outcome + ")",
+         result.hit);
+}
+
+void FileSession::OnTimeout() {
+  timed_out_ = true;
+  if (given_) {
+    // The files went to the chooser: only the reading after it was cut
+    // short.
+    Answer("chosen", "unread");
+    return;
+  }
+  StopSteps();
+  CancelChooser();
+  Answer("timeout", kTimeoutReason);
+}
+
+void FileSession::Answer(const std::string& outcome,
+                         const std::string& reason,
+                         const std::string& hit,
+                         const std::string& hit_kind) {
+  if (answered()) {
+    return;
+  }
+  // What the choice led to is answered once settled when it ran its course;
+  // else at once, with what is known.
+  Send(outcome, reason, hit, hit_kind,
+       /*wait=*/(outcome == "chosen" || outcome == "mismatch") && !timed_out_);
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void FileSession::Fail(Response response) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  CancelChooser();
+  if (waiting_chooser_ && (reached_ || moving_) && handler_alive_) {
+    handler_->RefuseLateChoosers(local_root_);
+  }
+  waiting_chooser_ = false;
+  collector_.reset();
+  chooser_collector_.reset();
+  if (action_id_ && !reached_ && handler_alive_) {
+    if (ActionOutcomeWatch* watch = handler_->outcome_watch()) {
+      watch->Abandon(action_id_);
+    }
+  }
+  action_id_ = 0;
+  FileResult result;
+  result.failure = std::move(response);
+  std::move(completion).Run(std::move(result));
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void FileSession::Send(const std::string& outcome,
+                       const std::string& reason,
+                       const std::string& hit,
+                       const std::string& hit_kind,
+                       bool wait) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  CancelChooser();
+  if (waiting_chooser_ && (reached_ || moving_) && handler_alive_) {
+    // Its click went out, or may still: a chooser of the click's local root
+    // that comes while the click's activation lasts is cancelled, as a
+    // person closes a dialog they no longer want, not shown.
+    handler_->RefuseLateChoosers(local_root_);
+  }
+  waiting_chooser_ = false;
+  collector_.reset();
+  chooser_collector_.reset();
+  const double scale = params_.css_scale > 0 ? params_.css_scale : 1;
+  FileResult result;
+  result.outcome = outcome;
+  result.reason = reason;
+  result.hit = hit;
+  result.hit_kind = hit_kind;
+  result.path = path_;
+  result.field = field_;
+  result.mode = mode_;
+  result.accept = accept_;
+  result.opener = opener_;
+  // The field's label, when the hand pressed it in place of the element named.
+  if (opener_node_id_ && opener_node_id_ != params_.node_id &&
+      opener_node_id_ == label_node_id_) {
+    result.pressed = label_name_;
+  }
+  result.count = count_;
+  if (handler_alive_) {
+    if (std::optional<PlannerPoint> hand = handler_->LastPointer()) {
+      result.x = hand->x / scale;
+      result.y = hand->y / scale;
+    } else {
+      result.x = params_.pointer_x.value_or(0);
+      result.y = params_.pointer_y.value_or(0);
+    }
+  }
+  result.duration_ms = (base::TimeTicks::Now() - started_).InMillisecondsF();
+  ActionOutcomeWatch* watch =
+      handler_alive_ && action_id_ ? handler_->outcome_watch() : nullptr;
+  if (watch && !reached_) {
+    // Armed, and nothing of the click reached the page: dropped, with no
+    // answer and no late events.
+    watch->Abandon(action_id_);
+    watch = nullptr;
+  }
+  if (watch) {
+    ActionOutcomeWatch::Reply(
+        watch, action_id_,
+        base::BindOnce(
+            [](Completion completion, FileResult result,
+               std::unique_ptr<Page::ActionOutcome> action_outcome) {
+              result.action_outcome = std::move(action_outcome);
+              std::move(completion).Run(std::move(result));
+            },
+            std::move(completion), std::move(result)),
+        wait);
+    return;
+  }
+  std::move(completion).Run(std::move(result));
+}
+
+double FileSession::RemainingMs() const {
+  const base::TimeDelta elapsed = base::TimeTicks::Now() - started_;
+  return (params_.timeout - elapsed).InMillisecondsF();
+}
+
+}  // namespace content::protocol
