+#include "mojo/public/cpp/bindings/callback_helpers.h"
+
+namespace content::protocol {
+
+namespace {
+
+// After the click, the picker is watched for this long, then once this much
+// longer, as a hand waits for a picker that is slow to come; after the pick,
+// the field is read every frame at most this long.
+constexpr base::TimeDelta kOpenWait = base::Milliseconds(500);
+constexpr base::TimeDelta kOpenExtra = base::Milliseconds(300);
+constexpr base::TimeDelta kSettle = base::Milliseconds(500);
+constexpr base::TimeDelta kLookGap = base::Milliseconds(16);
+// Out of time with the click or the pick on its way: its answer waited for
+// at most this long; after a click that went out, its picker looked for this
+// many frames, and closed if it shows.
+constexpr base::TimeDelta kInFlightWait = base::Milliseconds(5000);
+constexpr int kCloseLooks = 3;
+constexpr char kTimeoutReason[] = "the pick took longer than its timeoutMs";
+
+}  // namespace
+
+ColorResult::ColorResult() = default;
+ColorResult::ColorResult(ColorResult&&) = default;
+ColorResult& ColorResult::operator=(ColorResult&&) = default;
+ColorResult::~ColorResult() = default;
+
+ColorSession::Params::Params() = default;
+ColorSession::Params::Params(const Params&) = default;
+ColorSession::Params& ColorSession::Params::operator=(const Params&) = default;
+ColorSession::Params::~Params() = default;
+
+ColorSession::ColorSession(InputHandler& handler,
+                           uint64_t id,
+                           Params params,
+                           Completion completion,
+                           base::OnceCallback<void(uint64_t)> on_done)
+    : handler_(handler),
+      id_(id),
+      params_(std::move(params)),
+      completion_(std::move(completion)),
+      on_done_(std::move(on_done)),
+      started_(base::TimeTicks::Now()) {}
+
+ColorSession::~ColorSession() {
+  // The handler is going (its input state reset): nothing of it is asked.
+  if (completion_) {
+    ClosePicker();
+    handler_alive_ = false;
+    // Its outcome watch is not asked either.
+    action_id_ = 0;
+    Send("interrupted", InterruptionName(InputHandler::Interruption::kReset),
+         std::string(), std::string(), /*wait=*/false);
+  }
+}
+
+base::WeakPtr<ColorSession> ColorSession::Weak() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void ColorSession::Start() {
+  timeout_timer_.Start(FROM_HERE, params_.timeout,
+                       base::BindOnce(&ColorSession::OnTimeout, Weak()));
+  RenderFrameHostImpl* rfh =
+      handler_->BindCollectorForFrame(params_.frame_id, &collector_);
+  if (!rfh) {
+    Answer("gone", "the field's frame is gone");
+    return;
+  }
+  local_root_ = rfh->GetGlobalId();
+  Ask(Read::kFirst);
+}
+
+void ColorSession::Interrupt(InputHandler::Interruption why) {
+  if (answered()) {
+    return;
+  }
+  if (as_picked_ || pick_in_flight_) {
+    // All of the pick went out -- one on its way is delivered all the same:
+    // only the reading after it was cut short, or its frame went (the
+    // navigation it led to is in its outcome).
+    Answer("picked", why == InputHandler::Interruption::kNavigated ? "navigated"
+                                                                   : "unread");
+    return;
+  }
+  StopSteps();
+  ClosePicker();
+  Answer("interrupted", InterruptionName(why));
+}
+
+void ColorSession::StopSteps() {
+  if (moving_) {
+    // The hand stops where it has got to (its answer, posted, finds this one
+    // answered).
+    handler_->InterruptMoveSession();
+  }
+  if (revealing_ && handler_->reveal_) {
+    handler_->AnswerReveal("interrupted");
+  }
+}
+
+void ColorSession::ClosePicker() {
+  if (picker_may_show_ && !pick_in_flight_ && collector_.is_connected()) {
+    // Closed as Escape closes it, with nothing chosen: an empty value. Sent
+    // before the answer lets the pipe go; its reply is not waited for.
+    collector_->CommitColor(params_.node_id, std::string(), base::DoNothing());
+  }
+  picker_may_show_ = false;
+}
+
+void ColorSession::Ask(Read read) {
+  if (!collector_.is_connected()) {
+    OnRead(read, blink::mojom::AgentColorReadingPtr());
+    return;
+  }
+  collector_->ReadColor(params_.node_id, params_.value,
+                        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                            base::BindOnce(&ColorSession::OnRead, Weak(), read),
+                            blink::mojom::AgentColorReadingPtr()));
+}
+
+bool ColorSession::LookAgain(Read read) {
+  if (base::TimeTicks::Now() >= deadline_) {
+    return false;
+  }
+  clock_.Start(FROM_HERE, kLookGap,
+               base::BindOnce(&ColorSession::Ask, Weak(), read));
+  return true;
+}
+
+void ColorSession::OnRead(Read read,
+                          blink::mojom::AgentColorReadingPtr reading) {
+  if (answered()) {
+    return;
+  }
+  if (read == Read::kClose) {
+    OnCloseRead(reading.get());
+    return;
+  }
+  if (timed_out_) {
+    // Out of time: its answer comes with what is on its way.
+    return;
+  }
+  if (!reading || reading->kind == "gone") {
+    if (as_picked_) {
+      // All of the pick went out and the page replaced the field after it
+      // (an oninput that renders it anew): picked, as the pick made it; with
+      // no reading at all (its renderer went), not read back.
+      Answer("picked", reading ? "replaced" : "unread");
+    } else if (reached_) {
+      Answer("interrupted", "gone");
+    } else {
+      Answer("gone", reading ? "the field is no longer in the page"
+                             : "the page's renderer went away");
+    }
+    return;
+  }
+  const blink::mojom::AgentColorReading& r = *reading;
+  switch (read) {
+    case Read::kFirst:
+      OnFirstRead(r);
+      return;
+    case Read::kPicker:
+      OnPickerRead(r);
+      return;
+    case Read::kAfter:
+      if (r.matches) {
+        Answer("picked");
+        return;
+      }
+      if (r.disabled) {
+        // The page disabled it while its picker was open: the pick took
+        // nothing (ColorInputType::DidChooseColor).
+        Answer("disabled");
+        return;
+      }
+      if (!LookAgain(read)) {
+        Answer("mismatch");
+      }
+      return;
+    case Read::kClose:
+      return;
+  }
+}
+
+void ColorSession::OnFirstRead(const blink::mojom::AgentColorReading& r) {
+  if (r.kind == "notColor") {
+    Answer("notColor");
+    return;
+  }
+  if (r.disabled) {
+    Answer("disabled");
+    return;
+  }
+  if (r.matches) {
+    // It holds exactly that: nothing is pressed.
+    Answer("already");
+    return;
+  }
+  if (r.picker_shown) {
+    // Its picker is open already (a click before this call opened it): the
+    // pick in it, with no click.
+    picker_may_show_ = true;
+    OnPickerRead(r);
+    return;
+  }
+  if (!revealed_) {
+    Reveal();
+    return;
+  }
+  Open();
+}
+
+void ColorSession::OnCloseRead(const blink::mojom::AgentColorReading* r) {
+  if (r && r->kind == "color" && r->picker_shown) {
+    // Opened after the time ran out: closed again, with nothing chosen.
+    picker_may_show_ = true;
+    ClosePicker();
+  } else if (r && r->kind != "gone" && ++close_looks_ < kCloseLooks) {
+    // A picker the browser is about to show: looked for again.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&ColorSession::Ask, Weak(), Read::kClose),
+        kLookGap);
+    return;
+  }
+  Answer("timeout", kTimeoutReason);
+}
+
+void ColorSession::Reveal() {
+  if (answered()) {
+    return;
+  }
+  InputHandler::RevealRequest request;
+  request.backend_node_id = params_.node_id;
+  request.frame_id = params_.frame_id;
+  request.x = params_.pointer_x;
+  request.y = params_.pointer_y;
+  request.timeout_ms = StepTimeoutMs(RemainingMs());
+  revealing_ = true;
+  // Its answer can come before RunReveal returns, and what follows sends
+  // more input: posted.
+  handler_->RunReveal(std::move(request),
+                      base::BindPostTaskToCurrentDefault(
+                          base::BindOnce(&ColorSession::OnRevealed, Weak())));
+}
+
+void ColorSession::OnRevealed(InputHandler::RevealResult result) {
+  revealing_ = false;
+  if (answered()) {
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  const std::string& outcome = result.outcome;
+  if (outcome == "shown" || outcome == "blocked") {
+    // In view, or as far as the wheel brings it: read again, then the
+    // press's own check says what reaches it.
+    revealed_ = true;
+    Ask(Read::kFirst);
+    return;
+  }
+  if (outcome == "covered") {
+    Answer("covered", "covered", result.covering.value_or(std::string()),
+           result.covering_kind.value_or(std::string()));
+    return;
+  }
+  if (outcome == "gone") {
+    Answer("gone", "the field is no longer in the page");
+    return;
+  }
+  if (outcome == "interrupted" || outcome == "timeout") {
+    Answer(outcome);
+    return;
+  }
+  Answer("unreachable", "it could not be brought into view (" + outcome + ")");
+}
+
+void ColorSession::Open() {
+  if (answered()) {
+    return;
+  }
+  // What the browser checks before it shows a page popup
+  // (WebContentsImpl::ShowCreatedWidget): an inactive window or a hidden tab
+  // gets none.
+  WebContentsImpl* contents = handler_->web_contents_;
+  RenderWidgetHostImpl* main_widget =
+      contents && contents->GetPrimaryMainFrame()
+          ? contents->GetPrimaryMainFrame()->GetRenderWidgetHost()
+          : nullptr;
+  window_inactive_ = main_widget && !main_widget->is_active();
+  tab_hidden_ =
+      contents && contents->GetVisibility() == content::Visibility::HIDDEN;
+  // The opening click is not the action: the pick is.
+  InputHandler::MoveRequest move;
+  move.backend_node_id = params_.node_id;
+  move.frame_id = params_.frame_id;
+  move.intent = params_.intent;
+  move.end_action = "click";
+  move.end_button = "left";
+  move.end_click_count = 1;
+  move.speed_multiplier = params_.speed_multiplier;
+  move.timeout_ms = StepTimeoutMs(RemainingMs());
+  move.pointer_x = params_.pointer_x;
+  move.pointer_y = params_.pointer_y;
+  move.follow_navigation = params_.follow_navigation;
+  move.arm = false;
+  moving_ = true;
+  handler_->RunMove(std::move(move),
+                    base::BindPostTaskToCurrentDefault(
+                        base::BindOnce(&ColorSession::OnOpened, Weak())));
+}
+
+void ColorSession::OnOpened(MoveResult result) {
+  moving_ = false;
+  if (answered()) {
+    return;
+  }
+  const bool clicked = !result.failure && result.outcome == "clicked";
+  if (timed_out_) {
+    if (clicked) {
+      // Its picker may be opening: looked for, and closed if it shows.
+      Ask(Read::kClose);
+      return;
+    }
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  if (!clicked) {
+    AnswerMove(result);
+    return;
+  }
+  picker_may_show_ = true;
+  deadline_ = base::TimeTicks::Now() + kOpenWait;
+  Ask(Read::kPicker);
+}
+
+void ColorSession::OnPickerRead(const blink::mojom::AgentColorReading& r) {
+  if (r.picker_shown) {
+    // As a person choosing a colour: a look at the picker, then the pick.
+    clock_.Start(FROM_HERE, ScaledDelay(900, 2400, params_.speed_multiplier),
+                 base::BindOnce(&ColorSession::Pick, Weak()));
+    return;
+  }
+  if (base::TimeTicks::Now() >= deadline_ && !picker_wait_extended_) {
+    picker_wait_extended_ = true;
+    deadline_ = base::TimeTicks::Now() + kOpenExtra;
+  }
+  if (LookAgain(Read::kPicker)) {
+    return;
+  }
+  // None showed: one shown later than this is closed as it would be now.
+  ClosePicker();
+  Answer("notOpened", tab_hidden_        ? "tabHidden"
+                      : window_inactive_ ? "windowInactive"
+                                         : "notOpened");
+}
+
+void ColorSession::Pick() {
+  if (answered()) {
+    return;
+  }
+  if (!collector_.is_connected()) {
+    Answer("gone", "the page's renderer went away");
+    return;
+  }
+  // The pick is the action, watched from here; from its sending it counts as
+  // having reached the page, and the picker as closing.
+  action_id_ = handler_->OutcomeWatch()->ArmSelect(local_root_,
+                                                   params_.follow_navigation);
+  reached_ = true;
+  picker_may_show_ = false;
+  pick_in_flight_ = true;
+  // A reply lost on the way (its renderer went) says nothing of the pick:
+  // `dropped`.
+  collector_->CommitColor(params_.node_id, params_.value,
+                          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                              base::BindOnce(&ColorSession::OnPicked, Weak()),
+                              std::string("dropped")));
+}
+
+void ColorSession::OnPicked(const std::string& outcome) {
+  pick_in_flight_ = false;
+  if (answered()) {
+    return;
+  }
+  if (outcome == "picked") {
+    as_picked_ = true;
+  } else if (outcome != "dropped") {
+    // Nothing was picked.
+    reached_ = false;
+  }
+  if (timed_out_) {
+    Answer(as_picked_ ? "picked" : "timeout",
+           as_picked_ ? "unread" : kTimeoutReason);
+    return;
+  }
+  if (outcome == "picked" || outcome == "dropped") {
+    if (outcome == "dropped" &&
+        !handler_->BindCollectorForFrame(params_.frame_id, &collector_)) {
+      // Whether the pick took cannot be read: its frame has no renderer.
+      Answer("interrupted", "gone");
+      return;
+    }
+    deadline_ = base::TimeTicks::Now() + kSettle;
+    Ask(Read::kAfter);
+    return;
+  }
+  if (outcome == "notOpen") {
+    // The picker closed during the dwell -- the page, or the window going
+    // inactive, closed it -- with nothing chosen.
+    Answer("notOpened", "closed");
+    return;
+  }
+  if (outcome == "notColor") {
+    // The page made it another kind of field during the dwell.
+    Answer("notColor");
+    return;
+  }
+  if (outcome == "gone") {
+    Answer("gone", "the field is no longer in the page");
+    return;
+  }
+  // badValue: the renderer refused a colour the browser checked before
+  // anything moved; nothing was picked.
+  Answer("interrupted", outcome);
+}
+
+void ColorSession::AnswerMove(const MoveResult& result) {
+  const std::string& outcome = result.outcome;
+  if (outcome == "gone") {
+    Answer("gone", result.reason);
+    return;
+  }
+  if (outcome == "covered" || outcome == "hidden" || outcome == "interrupted" ||
+      outcome == "timeout" || outcome == "unreachable") {
+    Answer(outcome, result.reason, result.hit, result.hit_kind);
+    return;
+  }
+  // Pressed, released or arrived: not the click asked for.
+  Answer("unreachable", "the click did not go out (" + outcome + ")",
+         result.hit);
+}
+
+void ColorSession::OnTimeout() {
+  timed_out_ = true;
+  if (revealing_ && handler_->reveal_) {
+    handler_->AnswerReveal("interrupted");
+  }
+  if (as_picked_) {
+    // All of the pick went out: only the reading after it was cut short.
+    Answer("picked", "unread");
+    return;
+  }
+  if (moving_ || pick_in_flight_) {
+    // The click or the pick on its way: its answer, and what it did, waited
+    // for a little (OnOpened, OnPicked).
+    if (moving_) {
+      handler_->InterruptMoveSession();
+    }
+    clock_.Start(
+        FROM_HERE, kInFlightWait,
+        base::BindOnce(&ColorSession::Answer, Weak(), std::string("timeout"),
+                       std::string(kTimeoutReason), std::string(),
+                       std::string()));
+    return;
+  }
+  ClosePicker();
+  Answer("timeout", kTimeoutReason);
+}
+
+void ColorSession::Answer(const std::string& outcome,
+                          const std::string& reason,
+                          const std::string& hit,
+                          const std::string& hit_kind) {
+  if (answered()) {
+    return;
+  }
+  // What the pick led to is answered once settled when it ran its course;
+  // else at once, with what is known.
+  Send(outcome, reason, hit, hit_kind,
+       /*wait=*/(outcome == "picked" || outcome == "mismatch") && !timed_out_);
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void ColorSession::Fail(Response response) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  if (action_id_ && !reached_ && handler_alive_) {
+    if (ActionOutcomeWatch* watch = handler_->outcome_watch()) {
+      watch->Abandon(action_id_);
+    }
+  }
+  action_id_ = 0;
+  ColorResult result;
+  result.failure = std::move(response);
+  std::move(completion).Run(std::move(result));
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void ColorSession::Send(const std::string& outcome,
+                        const std::string& reason,
+                        const std::string& hit,
+                        const std::string& hit_kind,
+                        bool wait) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  const double scale = params_.css_scale > 0 ? params_.css_scale : 1;
+  ColorResult result;
+  result.outcome = outcome;
+  result.reason = reason;
+  result.hit = hit;
+  result.hit_kind = hit_kind;
+  if (handler_alive_) {
+    if (std::optional<PlannerPoint> hand = handler_->LastPointer()) {
+      result.x = hand->x / scale;
+      result.y = hand->y / scale;
+    } else {
+      result.x = params_.pointer_x.value_or(0);
+      result.y = params_.pointer_y.value_or(0);
+    }
+  }
+  result.duration_ms = (base::TimeTicks::Now() - started_).InMillisecondsF();
+  ActionOutcomeWatch* watch =
+      handler_alive_ && action_id_ ? handler_->outcome_watch() : nullptr;
+  if (watch && !reached_) {
+    // Armed, and nothing of the pick reached the page: dropped, with no
+    // answer and no late events.
+    watch->Abandon(action_id_);
+    watch = nullptr;
+  }
+  if (watch) {
+    ActionOutcomeWatch::Reply(
+        watch, action_id_,
+        base::BindOnce(
+            [](Completion completion, ColorResult result,
+               std::unique_ptr<Page::ActionOutcome> action_outcome) {
+              result.action_outcome = std::move(action_outcome);
+              std::move(completion).Run(std::move(result));
+            },
+            std::move(completion), std::move(result)),
+        wait);
+    return;
+  }
+  std::move(completion).Run(std::move(result));
+}
+
+double ColorSession::RemainingMs() const {
+  const base::TimeDelta elapsed = base::TimeTicks::Now() - started_;
+  return (params_.timeout - elapsed).InMillisecondsF();
+}
+
+}  // namespace content::protocol
diff --git a/content/browser/devtools/protocol/color_session.h b/content/browser/devtools/protocol/color_session.h
new file mode 100644
