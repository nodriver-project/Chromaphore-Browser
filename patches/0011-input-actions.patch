+                       base::BindOnce(&DragSession::OnSlot, Weak(), use, ask));
+}
+
+void DragSession::OnSlot(SlotUse use,
+                         uint64_t ask,
+                         blink::mojom::AgentSlotPtr slot) {
+  if (!Current(ask)) {
+    return;
+  }
+  const bool usable = slot && slot->found && FiniteSlot(slot.get());
+  switch (use) {
+    case SlotUse::kAfter:
+      // After a let-go: where the grabbed element is now (grabIndexAfter;
+      // the caller words a move from grabIndexBefore/After).
+      if (usable) {
+        grab_after_ = std::move(slot);
+      }
+      FinishAfterRead(SlotUse::kAfter);
+      return;
+    case SlotUse::kEndAfter:
+      // After a native drag's end: grabIndexAfter, worded by the
+      // caller.
+      if (usable) {
+        grab_after_ = std::move(slot);
+      }
+      FinishAfterRead(SlotUse::kEndAfter);
+      return;
+    case SlotUse::kAfterTarget:
+      // The target's place now: the side asked for reached or not.
+      if (usable && grab_after_ && SameList(*grab_after_, *slot)) {
+        slot_reached_ = OrderPasses(*grab_after_, *slot);
+      }
+      FinishAfterRead(after_next_);
+      return;
+    case SlotUse::kPutBack:
+      // Put back over its own place: truly, when its place among its
+      // siblings -- and a slider's value -- is the one it had.
+      if (usable && grab_before_ && grab_before_->found) {
+        const blink::mojom::AgentSlot& before = *grab_before_;
+        if (before.count >= 2 && slot->count >= 2 &&
+            slot->index != before.index) {
+          // Its place among its siblings changed: not put back (the caller
+          // words the move from grabIndexBefore/After).
+          put_back_ = false;
+        } else if (range_grab_ && slot->value != before.value) {
+          put_back_ = false;
+          end_reason_ +=
+              "; it was let go over its own place, but its value "
+              "is now " +
+              slot->value + " (it was " + before.value + ")";
+        }
+      }
+      if (usable) {
+        grab_after_ = std::move(slot);
+      }
+      FinishAfterRead(SlotUse::kPutBack);
+      return;
+    default:
+      break;
+  }
+  if (!FiniteSlot(slot.get())) {
+    BadGeometry();
+    return;
+  }
+  const bool found = slot && slot->found;
+  switch (use) {
+    case SlotUse::kGrab:
+      // Phase 0: where to press on it.
+      if (!found) {
+        Fail("gone",
+             "the element to grab is no longer on the page. Observe again");
+        return;
+      }
+      grab_point_ =
+          At(RectToRoot(slot->box.get()), params_.grab_fraction_x.value_or(0.5),
+             params_.grab_fraction_y.value_or(0.5));
+      Survey(base::BindOnce(&DragSession::CheckSurvey, Weak()));
+      return;
+    case SlotUse::kLanding:
+      if (params_.target_kind == TargetKind::kFraction) {
+        if (!found) {
+          Fail("gone", GrabName() + " is no longer on the page");
+          return;
+        }
+        letgo_box_ = RectToRoot(slot->box.get());
+        Land(At(letgo_box_, params_.fraction_x, params_.fraction_y));
+        return;
+      }
+      if (!found) {
+        FailTargetGone();
+        return;
+      }
+      if (const std::optional<PlannerPoint> landing =
+              ChooseLanding(slot.get())) {
+        Land(*landing);
+        return;
+      }
+      Fail("unreachable",
+           TargetName() + " does not show: it lies " + HiddenWhere());
+      return;
+    case SlotUse::kVerify: {
+      // A pointer drag over an element: L inside its slot on the side asked
+      // for, nothing scrolled since L was read.
+      if (!found) {
+        FailTargetGone();
+        return;
+      }
+      if (ChangedSinceLanding()) {
+        Correct(Miss::kMoved);
+        return;
+      }
+      const DragRect layout = RectToRoot(slot->layout_box.get());
+      const bool over = slot->count >= 2 && !layout.IsEmpty()
+                            ? OverSlot(layout, slot->list_vertical, landing_)
+                            : RectToRoot(slot->box.get()).Contains(landing_);
+      if (!over) {
+        hit_ = "a place off its slot";
+        Correct(Miss::kHit);
+        return;
+      }
+      verified_slot_ = layout;
+      Describe(DescribeUse::kBefore);
+      return;
+    }
+    case SlotUse::kOrderGrab:
+      // The list's order: the grabbed element's place, then the target's.
+      order_grab_ = std::move(slot);
+      ReadSlot(SlotUse::kOrderTarget, params_.target_node_id);
+      return;
+    case SlotUse::kOrderTarget:
+      if (found && order_grab_ && OrderPasses(*order_grab_, *slot)) {
+        Passed(order_final_);
+        return;
+      }
+      final_timer_.Stop();
+      Correct(Miss::kHit);
+      return;
+    case SlotUse::kStepGrab:
+      // The grabbed element's place, then the target's.
+      order_grab_ = std::move(slot);
+      ReadSlot(SlotUse::kStepTarget, params_.target_node_id);
+      return;
+    case SlotUse::kStepTarget: {
+      // On the side asked for, the steps used up, or no order to read:
+      // verified and dropped as any landing. A list that has not moved the
+      // grabbed element since the press reorders only on the drop: no
+      // step, the let-go at the slot point.
+      const blink::mojom::AgentSlot* grab = order_grab_.get();
+      if (!found || !grab || !SameList(*grab, *slot) || !ListMovedGrab(*grab) ||
+          OrderPasses(*grab, *slot) || order_steps_ >= kMaxOrderSteps) {
+        Probe(ProbeUse::kLanding);
+        return;
+      }
+      // A third of an item on along the list, toward the side asked for,
+      // while that stays calm and near the target; the landing is where the
+      // hand goes.
+      const int want =
+          params_.slot == Slot::kAfter ? slot->index + 1 : slot->index - 1;
+      const DragRect layout = RectToRoot(slot->layout_box.get());
+      const bool vertical = slot->list_vertical;
+      const double step = std::max(2.0, (vertical ? layout.h : layout.w) / 3) *
+                          (grab->index < want ? 1 : -1);
+      const PlannerPoint from = Hand();
+      PlannerPoint to = from;
+      if (vertical) {
+        to.y += step;
+      } else {
+        to.x += step;
+      }
+      to = InView(to);
+      // The target's box now, one item further each way along the list (a
+      // list that moves the grabbed item past it moves it by that item's
+      // length): a step never goes past the items next to it.
+      DragRect reach = layout;
+      if (vertical) {
+        reach.y -= layout.h;
+        reach.h += 2 * layout.h;
+      } else {
+        reach.x -= layout.w;
+        reach.w += 2 * layout.w;
+      }
+      if (!reach.Contains(to) || !terrain_ ||
+          !terrain_->Calm(to, kClearance, item_offset_)) {
+        Probe(ProbeUse::kLanding);
+        return;
+      }
+      ++order_steps_;
+      landing_ = to;
+      PlayLeg(
+          Plan(from, to, kPointWidth, PathIntent::kDefault,
+               terrain_->Constraints(from, to, kBandBudgetMs, item_offset_)),
+          base::BindOnce(&DragSession::StepByOrder, Weak()));
+      return;
+    }
+    case SlotUse::kAfter:
+    case SlotUse::kEndAfter:
+    case SlotUse::kPutBack:
+    case SlotUse::kAfterTarget:
+      break;
+  }
+}
+
+void DragSession::IssueWheelStation(StationUse use,
+                                    bool vertical,
+                                    uint64_t ask) {
+  if (!CanAsk()) {
+    return;
+  }
+  const PlannerPoint hand = ToLocal(Hand());
+  collector_->WheelStation(
+      params_.target_node_id, params_.aim_x, params_.aim_y,
+      vertical ? kAxisVertical : kAxisHorizontal, hand.x, hand.y,
+      use == StationUse::kStage && PointerDrag(),
+      base::BindOnce(&DragSession::OnStation, Weak(), use, ask));
+}
+
+// Where to turn the wheel from. Before the press: the first leg's end (or
+// the landing when there is none). In a stage: none is
+// as near as the wheel brings it when the target shows already, else
+// blocked; a box that takes the wheel itself (a blocking wheel listener) is
+// blocked for a native drag, whose wheel does nothing there.
+void DragSession::OnStation(StationUse use,
+                            uint64_t ask,
+                            bool found,
+                            double x,
+                            double y,
+                            blink::mojom::AgentElementBoxPtr region,
+                            int32_t box_id,
+                            const std::string& box_name) {
+  if (!Current(ask)) {
+    return;
+  }
+  if (!std::isfinite(x) || !std::isfinite(y) || !FiniteBox(region.get())) {
+    BadGeometry();
+    return;
+  }
+  const std::string box =
+      BoxName(box_id, box_name.empty() ? std::string("the page") : box_name);
+  // Moved onto the target's track where it can be.
+  const PlannerPoint offered = ToRoot(x, y);
+  const PlannerPoint taken = found ? StationOnTrack(offered, box_id) : offered;
+  switch (use) {
+    case StationUse::kFirst:
+      if (found) {
+        const DragBand* binder = terrain_->Find(box_id);
+        if (binder && binder->wheel_blocked) {
+          // Refused before the press: a blocking wheel listener there
+          // keeps the wheel from scrolling it under a held drag.
+          Fail("blocked", box +
+                              " takes the wheel itself, so it cannot be "
+                              "scrolled to " +
+                              TargetName() + " while a drag is held");
+          return;
+        }
+        SetFirstWaypoint(taken, kStationWidth);
+      } else {
+        SetFirstWaypoint(LandingEstimate(/*after_carry=*/false),
+                         LandingWidth());
+        first_is_landing_ = true;
+      }
+      ReachGrab();
+      return;
+    case StationUse::kStage:
+      break;
+  }
+  if (!found) {
+    // The renderer looks for a station only toward a need of its own
+    // (Blink's belts): a pointer drag's need past a library's zone is the
+    // executor's alone, turned at a station found here.
+    if (PointerDrag() && std::abs(vertical_ ? need_.y : need_.x) >= 1 &&
+        StationFromTerrain()) {
+      return;
+    }
+    if (reading_ && reading_->land_shown) {
+      StartApproach();
+      return;
+    }
+    Fail("blocked",
+         "nowhere over " + box + " turns the wheel toward " + TargetName());
+    return;
+  }
+  if (kind_ == Kind::kNative) {
+    const DragBand* band = terrain_->Find(box_id);
+    if (band && band->wheel_blocked) {
+      Fail("blocked", box +
+                          " takes the wheel itself, so turning it there does "
+                          "nothing while a drag is held");
+      return;
+    }
+  }
+  TakeStation(taken, RectToRoot(region.get()), box_id, box);
+}
+
+// A wheel station on the target's own track: for a carry across, a
+// spot level with the target's row; for one down, over its column -- the
+// offered station moved there across the axis, a quarter of the target's
+// size (at most 12 px) in from its edges -- when that spot is in the
+// binder's visible part, calm, and the wheel there still turns the binder.
+// The offered station otherwise; for the page's own scroller; for a box
+// whose wheel the page takes; and for a pointer drag, whose wheel the page
+// sees (a listener at the moved spot could swallow notches).
+PlannerPoint DragSession::StationOnTrack(const PlannerPoint& station,
+                                         int binder) const {
+  const DragRect target = TargetBoxNow();
+  const DragBand* box = terrain_ ? terrain_->Find(binder) : nullptr;
+  if (target.IsEmpty() || !box || box->is_document || box->wheel_blocked ||
+      PointerDrag()) {
+    return station;
+  }
+  PlannerPoint on = station;
+  if (vertical_) {
+    const double m = std::min(target.w / 4, kTrackInsetPx);
+    on.x = std::clamp(station.x, target.x + m,
+                      std::max(target.x + m, target.right() - m));
+  } else {
+    const double m = std::min(target.h / 4, kTrackInsetPx);
+    on.y = std::clamp(station.y, target.y + m,
+                      std::max(target.y + m, target.bottom() - m));
+  }
+  if (Distance(on, station) < 0.5 || !box->visible.Contains(on) ||
+      !terrain_->Calm(on, kClearance, item_offset_) || LatchAt(on) != binder) {
+    return station;
+  }
+  return on;
+}
+
+// The stage's station: where the wheel is turned, the region the hand may
+// wander in and the box the wheel turns there; then the leg there, with the
+// first spin. A stage taken up for a live zone keeps at least the need that
+// brings the landing out of it.
+void DragSession::TakeStation(const PlannerPoint& at,
+                              const DragRect& region,
+                              int box_id,
+                              const std::string& box) {
+  station_ = at;
+  region_ = region;
+  if (!region_.Contains(station_)) {
+    region_ = DragRect{station_.x - 3, station_.y - 3, 6, 6};
+  }
+  has_station_ = true;
+  const bool zone_stage = zone_box_ != 0;
+  const PlannerPoint zone_need = need_;
+  zone_box_ = 0;
+  binder_id_ = box_id;
+  binder_name_ = box;
+  // The box the wheel turns at the station: the binder, or a box inside it
+  // that the station lies over and that has room that way. The watch
+  // credits both to the wheel; a change of it re-stations.
+  notch_latch_id_ = LatchAt(station_);
+  if (notch_latch_id_ == 0) {
+    notch_latch_id_ = binder_id_;
+  }
+  if (PointerDrag() && terrain_) {
+    terrain_->SetBinder(binder_id_);  // its zones at both its ends
+  }
+  if (reading_ && PointerDrag()) {
+    // The zone the need is grown past is this box's now: measured
+    // from it, so the first spin's progress is the scroll's alone.
+    need_ = NeedToRoot(*reading_);
+    ExtendNeedForZones();
+    // The next reading's progress is told from the reading's own need; a
+    // zone's stage turns at least what brings the landing out of it.
+    last_settled_need_ = vertical_ ? need_.y : need_.x;
+    if (zone_stage) {
+      double& along = vertical_ ? need_.y : need_.x;
+      const double out = vertical_ ? zone_need.y : zone_need.x;
+      along = out > 0 ? std::max(along, out) : std::min(along, out);
+    }
+  }
+  NoteWheelBoxes();
+  GoToStation();
+}
+
+void DragSession::ReadCarry(ReadUse use) {
+  Ask(base::BindRepeating(&DragSession::IssueCarryRead, Weak(), use));
+}
+
+void DragSession::IssueCarryRead(ReadUse use, uint64_t ask) {
+  if (!CanAsk()) {
+    return;
+  }
+  const PlannerPoint hand = ToLocal(Hand());
+  const int axis = use == ReadUse::kCarry
+                       ? (vertical_ ? kAxisVertical : kAxisHorizontal)
+                       : kAxisFurtherOff;
+  collector_->CarryRead(
+      params_.target_node_id, params_.aim_x, params_.aim_y, hand.x, hand.y,
+      axis, base::BindOnce(&DragSession::OnCarryRead, Weak(), use, ask));
+}
+
+void DragSession::OnCarryRead(ReadUse use,
+                              uint64_t ask,
+                              blink::mojom::AgentCarryReadingPtr reading) {
+  if (!Current(ask)) {
+    return;
+  }
+  if (!reading || !reading->found) {
+    FailTargetGone();
+    return;
+  }
+  if (!FiniteReading(reading.get())) {
+    BadGeometry();
+    return;
+  }
+  if (!reading->covering.empty()) {
+    FailCovered(*reading);
+    return;
+  }
+  need_ = NeedToRoot(*reading);
+  reading_ = std::move(reading);
+  if (use == ReadUse::kCarry) {
+    ExtendNeedForZones();
+    AfterSpin();
+    return;
+  }
+  LandOnElement();
+}
+
+// The verify checks L -- the pixel the hand is on when it is there, L as
+// planned from the calm point beside an in-band one; the last check, the
+// pixel the last dragover used. Of the target, or of the grabbed element.
+void DragSession::IssueHitCheck(HitUse use, uint64_t ask) {
+  if (!CanAsk()) {
+    return;
+  }
+  const bool on_grab = use == HitUse::kVerifyGrab || use == HitUse::kFinalGrab;
+  const bool is_final = use == HitUse::kFinal || use == HitUse::kFinalGrab;
+  PlannerPoint at = final_at_;
+  if (!is_final) {
+    at = kind_ == Kind::kNative && !calm_point_ ? Hand() : landing_;
+  }
+  const PlannerPoint local = ToLocal(at);
+  collector_->HitCheck(
+      on_grab ? grab_id_ : params_.target_node_id, local.x, local.y,
+      base::BindOnce(&DragSession::OnHitCheck, Weak(), use, ask));
+}
+
+// The verify (at L, before any dart): reached goes on to the description;
+// the last check (at the pixel the last dragover used): reached, with
+// nothing scrolled since L was read, drops. Covered, a label, disabled,
+// inert: not over the target itself -- unless (a native drag over a list
+// that moves the grabbed element as it is dragged) the grabbed element is
+// what is there, or the list's order already has it where it was asked to
+// go -- corrected.
+void DragSession::OnHitCheck(HitUse use,
+                             uint64_t ask,
+                             const std::string& verdict,
+                             const std::string& hit,
+                             const std::string& hit_kind) {
+  if (!Current(ask)) {
+    return;
+  }
+  const bool on_grab = use == HitUse::kVerifyGrab || use == HitUse::kFinalGrab;
+  const bool is_final = use == HitUse::kFinal || use == HitUse::kFinalGrab;
+  if (verdict == "reached") {
+    Passed(is_final);
+    return;
+  }
+  if (!on_grab) {
+    if (verdict == "gone") {
+      FailTargetGone();
+      return;
+    }
+    // browser: an inert target's hit is what switched it off, not what
+    // lies under the pointer: kept apart, for the answer when the drag gives
+    // up on it; hit_ says the verdict meanwhile.
+    const bool inert = verdict == "inert";
+    SetHit((hit.empty() || inert) ? verdict : hit,
+           inert ? std::string() : hit_kind);
+    if (inert) {
+      inert_cause_ = InertCause{hit, hit_kind};
+    } else {
+      inert_cause_.reset();
+    }
+    if (kind_ == Kind::kNative && TargetInList() && grab_id_ != 0) {
+      Ask(base::BindRepeating(
+          &DragSession::IssueHitCheck, Weak(),
+          is_final ? HitUse::kFinalGrab : HitUse::kVerifyGrab));
+      return;
+    }
+    final_timer_.Stop();
+    // A fixed cover over the landing: carried on, not re-aimed.
+    const bool fixed_cover =
+        verdict == "covered" && UnderCover(landing_, frame_target_box_);
+    Correct(fixed_cover ? Miss::kCover : Miss::kHit);
+    return;
+  }
+  // Not the grabbed element either: the list's order decides.
+  order_final_ = is_final;
+  ReadSlot(SlotUse::kOrderGrab, grab_id_);
+}
+
+void DragSession::IssueDescribe(DescribeUse use, uint64_t ask) {
+  if (!CanAsk()) {
+    return;
+  }
+  const PlannerPoint at =
+      ToLocal(use == DescribeUse::kBefore ? landing_ : hand_);
+  // The grabbed element is left out only when it follows the pointer (a
+  // library translates it under the hand); a drag that leaves it in place
+  // names it when it is what lies there.
+  std::vector<int32_t> exclude;
+  if (grab_id_ != 0 && grab_follows_) {
+    exclude.push_back(grab_id_);
+  }
+  collector_->DescribePoint(
+      at.x, at.y, exclude, /*place=*/false,
+      base::BindOnce(&DragSession::OnDescribed, Weak(), use, ask));
+}
+
+void DragSession::OnDescribed(DescribeUse use,
+                              uint64_t ask,
+                              const std::string& hit,
+                              int32_t hit_node_id,
+                              const std::string& value) {
+  if (!Current(ask)) {
+    return;
+  }
+  if (use == DescribeUse::kBefore) {
+    if (!hit.empty()) {
+      hit_ = hit;
+    }
+    hit_value_before_ = value;
+    Approached();
+    return;
+  }
+  hit_value_after_ = value;
+  Answer(letgo_outcome_, letgo_reason_);
+}
+
+void DragSession::IssueValueAt(uint64_t ask) {
+  if (!CanAsk()) {
+    return;
+  }
+  const PlannerPoint at = ToLocal(landing_);
+  collector_->ValueAtPoint(
+      grab_id_, at.x, at.y,
+      base::BindOnce(&DragSession::OnValueAt, Weak(), ask));
+}
+
+// A range input: L must give the value asked for (or the nearest reachable
+// step); else L is read again once and the hand moved there.
+void DragSession::OnValueAt(uint64_t ask, bool ok, double value) {
+  if (!Current(ask)) {
+    return;
+  }
+  if (ok && !std::isfinite(value)) {
+    BadGeometry();
+    return;
+  }
+  const double expected = value_reached_.value_or(params_.value);
+  const bool right = ok && std::abs(value - expected) <=
+                               1e-9 * std::max(1.0, std::abs(expected));
+  if (right || value_corrected_) {
+    if (ok) {
+      value_reached_ = value;
+    }
+    Describe(DescribeUse::kBefore);
+    return;
+  }
+  value_corrected_ = true;
+  ++corrections_;
+  Survey(base::BindOnce(&DragSession::LandOnValue, Weak()));
+}
+
+// ===================================================== mapping, terrain
+
+RenderWidgetHostViewBase* DragSession::LocalView() const {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(params_.local_root);
+  return rfh && rfh->IsRenderFrameLive() ? rfh->GetView() : nullptr;
+}
+
+// A point of the local root's widget, in the root view.
+PlannerPoint DragSession::ToRoot(double x, double y) const {
+  if (!std::isfinite(x) || !std::isfinite(y)) {
+    return PlannerPoint();
+  }
+  RenderWidgetHostViewBase* view = LocalView();
+  if (!view) {
+    return PlannerPoint{x, y};
+  }
+  const gfx::PointF p =
+      view->TransformPointToRootCoordSpaceF(gfx::PointF(x, y));
+  return PlannerPoint{p.x(), p.y()};
+}
+
+// A point of the root view, in the local root's widget.
+PlannerPoint DragSession::ToLocal(const PlannerPoint& p) const {
+  RenderWidgetHostViewBase* view = LocalView();
+  RenderWidgetHostViewBase* root = view ? view->GetRootView() : nullptr;
+  gfx::PointF local(p.x, p.y);
+  if (root && root != view) {
+    root->TransformPointToCoordSpaceForView(gfx::PointF(p.x, p.y), view,
+                                            &local);
+  }
+  return PlannerPoint{local.x(), local.y()};
+}
+
+// A box of the local root's widget, in the root view: the bounding box of
+// its two corners.
+DragRect DragSession::RectToRoot(
+    const blink::mojom::AgentElementBox* box) const {
+  if (!box || !FiniteBox(box)) {
+    return DragRect();
+  }
+  const PlannerPoint a = ToRoot(box->x, box->y);
+  const PlannerPoint b = ToRoot(box->x + box->width, box->y + box->height);
+  return DragRect{std::min(a.x, b.x), std::min(a.y, b.y), std::abs(b.x - a.x),
+                  std::abs(b.y - a.y)};
+}
+
+// A reading's need, in the root view.
+PlannerPoint DragSession::NeedToRoot(
+    const blink::mojom::AgentCarryReading& r) const {
+  const PlannerPoint aim = ToRoot(r.aim_x, r.aim_y);
+  const PlannerPoint from = ToRoot(r.aim_x - r.need_x, r.aim_y - r.need_y);
+  return PlannerPoint{aim.x - from.x, aim.y - from.y};
+}
+
+// The last survey's terrain in the root view. Pointer drags also know the
+// band boxes that hold the grabbed element: a library scrolls those even
+// with the pointer outside them.
+DragTerrain DragSession::BuildTerrain(DragMode mode) const {
+  std::vector<DragBand> bands;
+  std::vector<DragFixedBox> fixed;
+  DragRect viewport;
+  if (survey_) {
+    viewport = RectToRoot(survey_->viewport.get());
+    // A frame of another process: only what the page shows of it. A hand
+    // outside that is over the page, where a native drag's events go to the
+    // page.
+    RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(params_.local_root);
+    if (rfh && rfh->GetParent()) {
+      const gfx::RectF shown = ShownPartInRoot(*rfh);
+      viewport = viewport.Intersect(
+          DragRect{shown.x(), shown.y(), shown.width(), shown.height()});
+    }
+  }
+  // A range input's drag scrolls nothing: no band, no cover.
+  if (survey_ && !range_grab_) {
+    for (const blink::mojom::AgentBandBoxPtr& box : survey_->bands) {
+      if (!box) {
+        continue;
+      }
+      DragBand band;
+      band.id = box->id;
+      band.parent = box->parent;
+      band.fixed = box->fixed;
+      band.name = box->name;
+      band.is_document = box->is_document;
+      band.border = RectToRoot(box->border.get());
+      band.outer = RectToRoot(box->outer.get());
+      band.inner = RectToRoot(box->inner.get());
+      band.visible = RectToRoot(box->visible.get());
+      band.lib_inner = RectToRoot(box->lib_inner.get());
+      band.up = box->up;
+      band.down = box->down;
+      band.left = box->left;
+      band.right = box->right;
+      band.wheel_blocked = box->wheel_blocked;
+      band.scroll_x = box->scroll_x;
+      band.scroll_y = box->scroll_y;
+      bands.push_back(std::move(band));
+    }
+    for (const blink::mojom::AgentFixedBoxPtr& box : survey_->fixed_boxes) {
+      if (!box) {
+        continue;
+      }
+      DragFixedBox cover;
+      cover.id = box->id;
+      cover.name = box->name;
+      cover.box = RectToRoot(box->box.get());
+      fixed.push_back(std::move(cover));
+    }
+  }
+  DragTerrain terrain(mode, viewport, std::move(bands), std::move(fixed));
+  if (mode == DragMode::kPointer) {
+    terrain.SetGrabChain(grab_chain_);
+    if (binder_id_ != 0) {
+      // The box the wheel turns: its zones count at both its ends.
+      terrain.SetBinder(binder_id_);
+    }
+  }
+  return terrain;
+}
+
+// The band boxes holding the grab point at the press, innermost first: the
+// one a native drag's autoscroll would pick there, and its ancestors.
+std::vector<int> DragSession::GrabChain() const {
+  std::vector<int> chain;
+  if (!terrain_) {
+    return chain;
+  }
+  const DragTerrain native = BuildTerrain(DragMode::kNative);
+  int box = native.OwnerAt(grab_point_);
+  while (box != 0 && !std::ranges::contains(chain, box) &&
+         chain.size() <= native.bands().size()) {
+    chain.push_back(box);
+    const DragBand* band = native.Find(box);
+    box = band ? band->parent : 0;
+  }
+  return chain;
+}
+
+double DragSession::FrameMs() const {
+  return survey_ && survey_->frame_interval_ms > 0 ? survey_->frame_interval_ms
+                                                   : kDefaultFrameMs;
+}
+
+// CSS px to root DIPs, as the call found it (1 when it gave none).
+double DragSession::CssScale() const {
+  return params_.css_scale > 0 ? params_.css_scale : 1;
+}
+
+double DragSession::Dsf() const {
+  return survey_ && survey_->device_scale_factor > 0
+             ? survey_->device_scale_factor
+             : 1;
+}
+
+// ================================================================= wording
+
+std::string DragSession::GrabName() const {
+  const blink::mojom::AgentSlot* slot = grab_before_.get();
+  return Quoted(slot && slot->found ? slot->text : std::string(),
+                "the element to grab");
+}
+
+std::string DragSession::TargetName() const {
+  if (params_.target_kind != TargetKind::kElement) {
+    return "the place to let go";
+  }
+  const blink::mojom::AgentSlot* slot =
+      survey_ && survey_->target ? survey_->target.get() : nullptr;
+  return Quoted(slot && slot->found ? slot->text : std::string(), "the target");
+}
+
+std::string DragSession::BoxName(int box, const std::string& fallback) const {
+  const auto it = names_.find(box);
+  if (it != names_.end() && !it->second.empty()) {
+    return it->second;
+  }
+  return fallback;
+}
