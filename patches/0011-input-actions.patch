+// found in the LICENSE file.
+
+// The tables keyboard_typing_session.cc times typed text by. It includes
+// this file inside its namespace, after the sizes the arrays use.
+//
+// By typing speed in words a minute (kTypistSpeeds): the median gap from one
+// press to the next and the median hold, in ms; each pair's gap as a share
+// of that median, at the probabilities of kGapProbabilities; the hold of the
+// key before each pair, as a share of the median hold; and each pair of
+// letters' gap in hundredths of its kind of pair's, by first and second key,
+// a to z and then the space bar ("th" is quicker than "tb"). For Shift, in
+// ms: at kShiftWaitProbabilities, from the key before coming up to Shift
+// going down (under zero with that key still down), from its key coming up
+// to Shift coming up (under zero with Shift up first) and from Shift coming
+// up to the next key going down; at kGapProbabilities, from Shift going down
+// to its key going down. Past its 95th percentile each of the four thins out
+// exponentially: kShiftTailMs is the tail's scale, in ms (kTailWait and so
+// on).
+
+#if !defined(BROWSER_TYPING_TABLES_MEASURED)
+// A plain typist: no measurement. A word is five keys, so a typist of
+// w words a minute presses one every 12000 / w ms on average; the time
+// between keys spreads as a lognormal with its 5th and 95th
+// percentiles as far apart as 60 and 260 ms; a key is held 97.5 ms at
+// the middle; the same key again is 20% quicker, the first key after
+// a space 20% slower and thirty common pairs of letters 30% quicker;
+// Shift's times are round shares of the gap.
+constexpr double kTypistSpeeds[] = {35, 45, 55, 65, 75, 90};
+constexpr double kGapProbabilities[] = {
+    0.01, 0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99};
+constexpr double kMedianGapMs[] = {310, 241, 198, 167, 145, 121};
+constexpr double kMedianHoldMs[] = {97.5, 97.5, 97.5, 97.5, 97.5, 97.5};
+constexpr double kGapOverMedian[kKeyPairCount][kTypistSpeedCount]
+                               [kGapQuantileCount] = {
+    // the other hand
+    {
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+    },
+    // the same hand, another finger
+    {
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+    },
+    // the same finger, another key
+    {
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+    },
+    // the same key again
+    {
+        {0.28, 0.38, 0.45, 0.59, 0.80, 1.08, 1.42, 1.67, 2.26},
+        {0.28, 0.38, 0.45, 0.59, 0.80, 1.08, 1.42, 1.67, 2.26},
+        {0.28, 0.38, 0.45, 0.59, 0.80, 1.08, 1.42, 1.67, 2.26},
+        {0.28, 0.38, 0.45, 0.59, 0.80, 1.08, 1.42, 1.67, 2.26},
+        {0.28, 0.38, 0.45, 0.59, 0.80, 1.08, 1.42, 1.67, 2.26},
+        {0.28, 0.38, 0.45, 0.59, 0.80, 1.08, 1.42, 1.67, 2.26},
+    },
+    // a key, then the space bar
+    {
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+        {0.35, 0.48, 0.56, 0.74, 1.00, 1.35, 1.77, 2.08, 2.82},
+    },
+    // the space bar, then a key
+    {
+        {0.43, 0.58, 0.68, 0.89, 1.20, 1.62, 2.12, 2.50, 3.38},
+        {0.43, 0.58, 0.68, 0.89, 1.20, 1.62, 2.12, 2.50, 3.38},
+        {0.43, 0.58, 0.68, 0.89, 1.20, 1.62, 2.12, 2.50, 3.38},
+        {0.43, 0.58, 0.68, 0.89, 1.20, 1.62, 2.12, 2.50, 3.38},
+        {0.43, 0.58, 0.68, 0.89, 1.20, 1.62, 2.12, 2.50, 3.38},
+        {0.43, 0.58, 0.68, 0.89, 1.20, 1.62, 2.12, 2.50, 3.38},
+    },
+};
+constexpr double kHoldBeforePair[kKeyPairCount][kTypistSpeedCount] = {
+    {1.00, 1.00, 1.00, 1.00, 1.00, 1.00},
+    {1.00, 1.00, 1.00, 1.00, 1.00, 1.00},
+    {1.00, 1.00, 1.00, 1.00, 1.00, 1.00},
+    {1.00, 1.00, 1.00, 1.00, 1.00, 1.00},
+    {1.00, 1.00, 1.00, 1.00, 1.00, 1.00},
+    {1.00, 1.00, 1.00, 1.00, 1.00, 1.00},
+};
+constexpr uint8_t kLetterPairPercent[27][27] = {
+    // a
+    {100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 70, 100, 70, 100,
