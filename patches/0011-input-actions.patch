+// CDP modifier bits, as in Input.dispatchKeyEvent.modifiers, and the
+// WebInputEvent modifier each one maps to.
+struct ModifierBit {
+  int cdp_bit;
+  int blink_modifier;
+};
+constexpr ModifierBit kModifierBits[] = {
+    {1, blink::WebInputEvent::kAltKey},
+    {2, blink::WebInputEvent::kControlKey},
+    {4, blink::WebInputEvent::kMetaKey},
+    {8, blink::WebInputEvent::kShiftKey},
+};
+constexpr int kModShift = 8;
+// Alt, Ctrl or Meta: with any of these down a key is a command, not text.
+constexpr int kModCommand = 1 | 2 | 4;
+
+// The speed multiplier's range, the mouse planner's too: from 20 times
+// slower than the baseline to 20 times faster. The protocol asks only for a
+// positive number; one outside the range types at its nearer end.
+constexpr double kSpeedMultiplierMin = 0.05;
+constexpr double kSpeedMultiplierMax = 20.0;
+
+// A key held down repeats as Windows repeats it, measured with the default
+// keyboard settings: the first repeat about half a second after the press, then
+// about thirty a second, a scheduling hiccup now and then.
+constexpr int kRepeatDelayMs = 500;
+constexpr int kRepeatIntervalMinMs = 29;
+constexpr int kRepeatIntervalMaxMs = 34;
+// A key is not held forever: the caller lets go long before this.
+constexpr base::TimeDelta kMaxHold = base::Seconds(60);
+
+// A chord's keys: however fast it is pressed, a key is held as long as a
+// person holds one. Typed text takes its holds from the typist (below).
+constexpr int kMinHoldMs = 45;
+constexpr int kMinHoldRangeTopMs = 70;
+
+// browser: how near a wake must be to be a precise one: under base's
+// kMaxPreciseDelay (36 ms), and more than a tick of Windows' timer, by which
+// the ordinary wake before it may come late.
+constexpr base::TimeDelta kPreciseWakeWithin = base::Milliseconds(30);
+// browser: an event is sent at its time on the keyboard's clock, to a few
+// microseconds. No wake is that fine: Windows' message pump waits in whole
+// milliseconds, so even a precise wake comes up to a millisecond or two
+// late, and a keyboard's reports reach a page within a fifth of one (two
+// recorded keyboards; sent as the wakes came, the clock was four times as
+// wide as theirs). So the session is woken a little before each event and
+// waits out the rest on the clock itself. How long before: what the wakes
+// have lately come late, and a margin, within these bounds. The upper one is
+// a tick of Windows' ordinary timer, which is all the precision there is on
+// battery power or behind another window; it is also the most one task
+// waits in all. A repeat is not waited for: it is the system's own, on no
+// clock a page can check.
+constexpr base::TimeDelta kWaitOutLeast = base::Milliseconds(2);
+constexpr base::TimeDelta kWaitOutMost = base::Milliseconds(16);
+// The wait looks at the clock at most this often: it ends on a clock that
+// stands still (a test's).
+constexpr int kWaitOutLooks = 20'000'000;
