+// browser: the path's points put on whole device pixels of the window -- each
+// staying on the pixel the one before is on until it is well past it
+// (StickyPixel) -- and kept on the screens.
+void InputHandler::SnapDragPoints() {
+  DragPath& drag = *drag_path_;
+  drag.points.clear();
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  RenderWidgetHostViewBase* view =
+      widget_host ? widget_host->GetView() : nullptr;
+  if (!view) {
+    drag.points = drag.raw;
+    return;
+  }
+  const double device_scale =
+      std::max(static_cast<double>(view->GetDeviceScaleFactor()), 0.25);
+  gfx::Vector2d in_window;
+#if defined(USE_AURA)
+  if (aura::Window* native = view->GetNativeView()) {
+    in_window = native->GetBoundsInRootWindow().OffsetFromOrigin();
+  }
+#endif
+  // From the pixel the drag is on, where it is.
+  std::optional<double> held_x;
+  std::optional<double> held_y;
+  if (drag.over) {
+    held_x = std::round((drag.over_root.x() + in_window.x()) * device_scale);
+    held_y = std::round((drag.over_root.y() + in_window.y()) * device_scale);
+  }
+  const auto on_pixel = [device_scale](double dip, double origin,
+                                       std::optional<double>& held) {
+    const float out = static_cast<float>(
+        StickyPixel((dip + origin) * device_scale, held) / device_scale -
+        origin);
+    return out == 0.f ? 0.f : out;  // never -0
+  };
+  // And on the screens: a cursor pushed past their edge stays on it.
+  const gfx::Rect bounds = view->GetViewBounds();
+  const gfx::Rect screens = AllScreens(bounds);
+  for (size_t i = 0; i < drag.raw.size(); ++i) {
+    // The walk's last point on the pixel nearest it, as a press lands: the
+    // hand comes to rest where it was aimed, not on a pixel held over.
+    std::optional<double> exact_x;
+    std::optional<double> exact_y;
+    const bool last = i + 1 == drag.raw.size();
+    float x = on_pixel(drag.raw[i].x(), in_window.x(), last ? exact_x : held_x);
+    float y = on_pixel(drag.raw[i].y(), in_window.y(), last ? exact_y : held_y);
+    if (!screens.IsEmpty()) {
+      x = OnScreens(x, screens.x() - bounds.x(), screens.right() - bounds.x(),
+                    in_window.x(), device_scale);
+      y = OnScreens(y, screens.y() - bounds.y(), screens.bottom() - bounds.y(),
+                    in_window.y(), device_scale);
+    }
+    drag.points.emplace_back(x, y);
+  }
+}
