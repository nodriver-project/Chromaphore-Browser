+
+// Input.chooseFiles' executor: files chosen for a file field the way a
+// person chooses them, as one action. The paths are checked first, off the
+// UI thread: each one there and readable, and a file or a folder. The element
+// named is read in its renderer (AgentSnapshotCollector::ReadFileField): a
+// file input or its label names the field, whose kind (one file, several, a
+// folder) and state are checked before anything moves, and which the hand
+// clicks itself when it shows, else its first label that shows (a field with
+// neither is refused, asking for the element that opens it); any other
+// element is clicked as it is. The click is armed as the action
+// (ActionOutcomeWatch::ArmSelect), and the next file chooser of the page --
+// handed over by InputHandler::WillRunFileChooser before the browser shows a
+// dialog -- is taken: its field read in its renderer (ReadOpenFileField) and
+// checked against the one named and against the paths; then, after a pause as
+// a person picking the files takes, answered through its own listener with
+// the files (a folder listed here, files only, as Chrome lists one), so the
+// browser grants the page read access as for a dialog's answer, and the field
+// read until it holds them. No chooser within the life of the click's
+// activation answers noChooser. One at a time per InputHandler: other pointer
+// input, a newer command of its kind, Input.disable or a renderer change
+// answers it interrupted, with why; a chooser it holds is cancelled, as a
+// person closing the dialog cancels it.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_FILE_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_FILE_SESSION_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/devtools/protocol/move_session.h"
+#include "content/browser/devtools/protocol/page.h"
+#include "content/public/browser/file_select_listener.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom.h"
+#include "third_party/blink/public/mojom/choosers/file_chooser.mojom.h"
+
+namespace content::protocol {
+
+// What a choice came to, as Input.chooseFiles answers it: a refusal before
+// any session in `failure`; else the outcome, why, what lies over a press
+// refused and the kind of an open layer that names, the path a refusal is
+// about, the field the chooser came from and what it takes (single, multiple,
+// folder), its accept, what may open a field no press reaches, how many files
+// it holds as last read (-1: not read), where the hand is (CSS px of the main
+// frame's viewport), how long it took, and what the click led to (null when
+// it did not go out). Empty strings are left out of the answer.
+struct FileResult {
+  FileResult();
+  FileResult(FileResult&&);
+  FileResult& operator=(FileResult&&);
+  ~FileResult();
+
+  std::optional<Response> failure;
+  std::string outcome;
+  std::string reason;
+  std::string hit;
+  std::string hit_kind;
+  std::string path;
+  std::string field;
+  std::string mode;
+  std::string accept;
+  std::string opener;
+  // What the hand pressed when it was not the element named: the field's label
+  // that shows, pressed in the field's place, described as a hit is.
+  std::string pressed;
+  int count = -1;
+  double x = 0;
+  double y = 0;
+  double duration_ms = 0;
+  std::unique_ptr<Page::ActionOutcome> action_outcome;
+};
+
+class FileSession {
+ public:
+  // A call to Input.chooseFiles, checked by InputHandler::ChooseFiles.
+  struct Params {
+    Params();
+    Params(const Params&);
+    Params& operator=(const Params&);
+    ~Params();
+
+    // What opens the chooser: its DOMNodeId in the local root of `frame_id`.
+    int32_t node_id = 0;
+    std::string frame_id;
+    // The paths as given (each absolute), and as paths.
+    std::vector<std::string> given;
+    std::vector<base::FilePath> paths;
+    // As Input.moveTo takes them, for the hand's click.
+    std::optional<std::string> intent;
+    double speed_multiplier = 1;
+    base::TimeDelta timeout;
+    // Where the pointer is, in CSS px of the main frame's viewport, for when
+    // no mouse path has put it anywhere yet.
+    std::optional<double> pointer_x;
+    std::optional<double> pointer_y;
+    // Root DIPs per CSS px of the main frame's viewport.
+    double css_scale = 1;
+    // Whether the answer waits for a cross-document navigation the choice
+    // started to end.
+    bool follow_navigation = true;
+  };
+
+  using Completion = base::OnceCallback<void(FileResult)>;
+
+  // `completion` hears the answer; `on_done` hears this session's id, posted,
+  // once it has answered.
+  FileSession(InputHandler& handler,
+              uint64_t id,
+              Params params,
+              Completion completion,
+              base::OnceCallback<void(uint64_t)> on_done);
+  FileSession(const FileSession&) = delete;
+  FileSession& operator=(const FileSession&) = delete;
+  // Unanswered, it answers interrupted, without the handler; a chooser it
+  // holds is cancelled.
+  ~FileSession();
+
+  void Start();
+  // Other input, a renderer change (the frame navigated) or Input.disable:
+  // answered at once -- chosen when the files went to the chooser, else
+  // interrupted with `why`; its own move or reveal stops where it has got to,
+  // and a chooser it holds is cancelled.
+  void Interrupt(InputHandler::Interruption why);
+  // A file chooser of the page, before the browser shows a dialog for it:
+  // true when this session takes it -- its click is armed and it has not
+  // answered -- and then answers `listener`, always.
+  bool TakeChooser(RenderFrameHostImpl* rfh,
+                   FileSelectListener* listener,
+                   const blink::mojom::FileChooserParams& params);
+
+  uint64_t id() const { return id_; }
+  bool answered() const { return !completion_; }
+
+ private:
+  // What a path is: not there or not readable, a file, a folder holding
+  // files, a folder holding none.
+  enum class PathKind { kMissing, kFile, kFolder, kEmptyFolder };
+  // What a reading of a field is for.
+  enum class Read {
+    // The element named, before anything and again once it is in view.
+    kFirst,
+    // After the files went to the chooser: until the field holds them.
+    kAfter,
+  };
+
+  static std::vector<PathKind> StatPaths(std::vector<base::FilePath> paths);
+  void OnStatted(std::vector<PathKind> kinds);
+
+  void Ask(Read read);
+  void OnRead(Read read, blink::mojom::AgentFileReadingPtr reading);
+  void OnFirstRead(const blink::mojom::AgentFileReading& reading);
+  // The paths against what a field takes ("single", "multiple" or "folder"):
+  // empty when they fit; else the refusal's outcome, with `path_` and
+  // `misfit_reason_` set.
+  std::string Misfit(const std::string& mode);
+  // The press on the field itself refused: true when its label is tried in
+  // its place (the action dropped, read again); false to answer the refusal.
+  bool TryLabel();
+
+  void Reveal();
+  void OnRevealed(InputHandler::RevealResult result);
+  // The click that opens the chooser, armed.
+  void Open();
+  void OnOpened(MoveResult result);
+  void OnNoChooser();
+  void OnOpenField(blink::mojom::AgentFileReadingPtr reading);
+  // The dwell over: the files to the chooser (a folder listed first).
+  void Choose();
+  void Give(std::vector<base::FilePath> files);
+  // The chooser held, if any, cancelled: the page hears its cancel.
+  void CancelChooser();
+  bool LookAgain(Read read);
+
+  void AnswerMove(const MoveResult& result);
+  void OnTimeout();
+  // The one answer: `wait` once what the armed action led to has settled.
+  void Answer(const std::string& outcome,
+              const std::string& reason = std::string(),
+              const std::string& hit = std::string(),
+              const std::string& hit_kind = std::string());
+  void Fail(Response response);
+  void Send(const std::string& outcome,
+            const std::string& reason,
+            const std::string& hit,
+            const std::string& hit_kind,
+            bool wait);
+  // Its own move or reveal under way stops where it has got to.
+  void StopSteps();
+  double RemainingMs() const;
+  base::WeakPtr<FileSession> Weak();
+
+  const raw_ref<InputHandler> handler_;
+  const uint64_t id_;
+  Params params_;
+  Completion completion_;
+  base::OnceCallback<void(uint64_t)> on_done_;
+  const base::TimeTicks started_;
+
+  // The element named's renderer; the chooser's field's, once it came.
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector_;
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> chooser_collector_;
+  GlobalRenderFrameHostId local_root_;
+  GlobalRenderFrameHostId chooser_root_;
+  std::vector<PathKind> kinds_;
+
+  // The field the element named is (a file input, or a label's control): its
+  // DOMNodeId in `local_root_`, 0 when the element named is something else.
+  int32_t field_node_id_ = 0;
+  // What the hand clicks: the element named, or the field's label; the
+  // field's first label that shows (0: none), and whether a press on the
+  // field itself was refused, so the label is clicked in its place.
+  int32_t opener_node_id_ = 0;
+  int32_t label_node_id_ = 0;
+  bool field_refused_ = false;
+  // As the answer says them, once known.
+  std::string path_;
+  std::string field_;
+  std::string mode_;
+  std::string accept_;
+  std::string opener_;
+  // The field's first label that shows, as the reading describes it.
+  std::string label_name_;
+  std::string misfit_reason_;
+  int count_ = -1;
+  // The chooser's field: its DOMNodeId in `chooser_root_` (0: not in the
+  // page, read none), and what went to it: how many files, and their names
+  // (none for a folder, judged by its count).
+  int32_t chosen_node_id_ = 0;
+  // The page was too large to look through for the chooser's field.
+  bool field_unread_ = false;
+  int wanted_count_ = 0;
+  std::vector<std::string> wanted_names_;
+  // The chooser's document: a frame that navigated or went while the
+  // chooser was held takes no answer, and none is claimed.
+  WeakDocumentPtr chooser_document_;
+
+  // The chooser held until the files go to it, and its mode.
+  scoped_refptr<FileSelectListener> listener_;
+  blink::mojom::FileChooserParams::Mode chooser_mode_ =
+      blink::mojom::FileChooserParams::Mode::kOpen;
+  // From the click's arming until a chooser came: one is taken.
+  bool waiting_chooser_ = false;
+  // The files went to the chooser.
+  bool given_ = false;
+
+  base::TimeTicks deadline_;
+  bool revealed_ = false;
+  bool revealing_ = false;
+  bool moving_ = false;
+  bool timed_out_ = false;
+  // The outcome watch's id once the click armed it (0: none); whether the
+  // click went out.
+  int action_id_ = 0;
+  bool reached_ = false;
+  // False once the handler is going (the destructor): nothing of it is
+  // asked.
+  bool handler_alive_ = true;
+
+  base::OneShotTimer timeout_timer_;
+  base::OneShotTimer clock_;
+  base::WeakPtrFactory<FileSession> weak_factory_{this};
+};
