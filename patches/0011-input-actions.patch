+
+// Input.moveTo's executor: one move of the
+// hand -- to an element, a box or a point, or none -- and what it does on
+// arrival: press, release or click. Answered once.
+//
+// The leg is the hand's (HumanPathPlanner: the handler's own planner), one
+// gesture, held to the view as a drag's legs are (BoundLegToView): no bow
+// and nothing past its end leaves it. The wait before a press (or a release)
+// is the hand's own, counted from the last move the page saw
+// (InputHandler::LastMoveAt). Before an element's
+// press or click it is aimed afresh -- the hand follows it when it has moved,
+// at most kMaxCorrections times -- and the press point is hit-checked as a
+// real press is routed: when something else would take it, nothing is
+// pressed and the answer says what. One at a time per InputHandler: a newer
+// command answers it interrupted at once, and a gesture already queued plays
+// out.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_MOVE_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_MOVE_SESSION_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/browser/devtools/protocol/human_path_planner.h"
+#include "content/browser/devtools/protocol/input.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/devtools/protocol/page.h"
+#include "content/common/input/synthetic_mouse_path_gesture_params.h"
+#include "content/common/input/synthetic_pointer_action_params.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace content {
+
+class RenderWidgetHostViewBase;
+
+namespace protocol {
+
+// What a move came to, as Input.moveTo answers it: a refusal before any move
+// in `failure`; else the outcome and why, what lies over the press point, where
+// the pointer is in CSS px of the main frame's viewport, the times the hand
+// followed the element, how long the move took, and what its end led to (null
+// when it armed nothing). An empty reason or hit is left out of the answer.
+struct MoveResult {
+  MoveResult();
+  MoveResult(MoveResult&&);
+  MoveResult& operator=(MoveResult&&);
+  ~MoveResult();
+
+  std::optional<Response> failure;
+  std::string outcome;
+  std::string reason;
+  std::string hit;
+  // When `hit` names an open layer the element is not in, its kind: listbox,
+  // menu, dialog, alert, popover or picker.
+  std::string hit_kind;
+  double x = 0;
+  double y = 0;
+  int corrections = 0;
+  double duration_ms = 0;
+  std::unique_ptr<Page::ActionOutcome> action_outcome;
+};
+
+class MoveSession {
+ public:
+  enum class Target { kNone, kElement, kBox, kPoint };
+
+  // A call to Input.moveTo, checked and resolved by InputHandler::MoveTo.
+  // Points and boxes in the root view's DIPs; the element's node id is a
+  // DOMNodeId in `local_root`.
+  struct Params {
+    Params();
+    Params(const Params&);
+    Params& operator=(const Params&);
+    ~Params();
+
+    Target target = Target::kNone;
+    GlobalRenderFrameHostId local_root;
+    int node_id = 0;
+    // Where on the element's piece or the box to land, as fractions across
+    // it; absent, the hand's own pick (ClickPoint).
+    std::optional<double> aim_x;
+    std::optional<double> aim_y;
+    PlannerRect box;
+    PlannerPoint point;
+    PathIntent intent = PathIntent::kDefault;
+    SyntheticMousePathGestureParams::EndAction end_action =
+        SyntheticMousePathGestureParams::EndAction::kNone;
+    SyntheticPointerActionParams::Button end_button =
+        SyntheticPointerActionParams::Button::LEFT;
+    int click_count = 1;
+    int modifiers = 0;
+    double speed_multiplier = 1;
+    // An element's press or click is hit-checked first.
+    bool check = true;
+    // With no end: an element's landing is aimed afresh, routed and
+    // hit-checked as a press there would be, and nothing is pressed --
+    // arrived when a press there reaches it, its label, or what holds it
+    // (pointer-events: none, a disabled control); else what the check found.
+    // Input.scrollBy's move: a wheel turned there goes where a press would.
+    bool check_landing = false;
+    // Whether the end's press, release or click arms the outcome watch: not
+    // when another command makes it its action's opening press (a select's
+    // opening click: the pick is the action).
+    bool arm = true;
+    base::TimeDelta timeout;
+    // Where the hand is, and the button it holds down (InputHandler::
+    // HeldButton): a held move gets the drag tempo, and the button rides on
+    // its moves.
+    PlannerPoint hand;
+    SyntheticPointerActionParams::Button held_button =
+        SyntheticPointerActionParams::Button::NO_BUTTON;
+    // The root view, in its own DIPs: no leg leaves it.
+    PlannerRect view;
+    // Root DIPs per CSS px of the main frame's viewport.
+    double css_scale = 1;
+    // What a press, release or click led to waits for a cross-document
+    // navigation it started to end.
+    bool follow_navigation = true;
+  };
+
+  // Hears the move's one answer.
+  using Completion = InputHandler::MoveCompletion;
+
+  // `planner` is the hand's (the handler's, which outlives the session).
+  // `collector` is the element's local root's, bound only for an element.
+  // `completion` hears the answer; `on_done` hears this session's id, posted,
+  // once it has answered.
+  MoveSession(InputHandler& handler,
+              uint64_t id,
+              const Params& params,
+              HumanPathPlanner& planner,
+              mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+              Completion completion,
+              base::OnceCallback<void(uint64_t)> on_done);
+  MoveSession(const MoveSession&) = delete;
+  MoveSession& operator=(const MoveSession&) = delete;
+  // Unanswered, it answers interrupted, without the handler.
+  ~MoveSession();
+
+  // A call refused before any session: answered `outcome` at once, the
+  // pointer where it is (root DIPs).
+  static void Refuse(Completion completion,
+                     const std::string& outcome,
+                     const std::string& reason,
+                     const PlannerPoint& hand,
+                     double css_scale);
+
+  void Start();
+  // Other pointer input, Input.disable, a renderer change or a newer move:
+  // answered interrupted at once; a gesture already queued plays out.
+  void Interrupt();
+
+  uint64_t id() const { return id_; }
+  bool answered() const { return !completion_; }
+
+ private:
+  // The element's piece, asked for (Aim) and answered (OnAimed); asked again
+  // on arrival before a press, and after a look (ReAim, OnReAimed).
+  void Aim();
+  void OnAimed(blink::mojom::AgentAimPiecePtr piece);
+  void ReAim();
+  void OnReAimed(blink::mojom::AgentAimPiecePtr piece);
+  // The leg to `to` (root DIPs) for a target `width` px across along it,
+  // then Arrived: inside the hover region the hand is in, when there is one
+  // -- across into the box the target is in first, then on to it,
+  // when no one rectangle of the region holds both ends.
+  void Leg(const PlannerPoint& to, double width);
+  // One gesture to `to`, kept inside `keep` when that is not empty and holds
+  // both ends; the last answers OnLegDone once played, one before it
+  // OnTurnDone. False when it was refused.
+  bool LegOnce(const PlannerPoint& to,
+               double width,
+               const PlannerRect& keep,
+               bool last);
+  // Planned points played as one gesture from where the hand is, the last on
+  // its pixel when `exact_end`; as LegOnce answers.
+  bool Play(std::vector<PlannedPoint> leg,
+            const PlannerPoint& to,
+            bool last,
+            bool exact_end);
+  void OnLegDone(bool ok);
+  void OnTurnDone(bool ok);
+  // The hover region the renderer read, in root DIPs, cut to the view.
+  void KeepRegion(const blink::mojom::AgentAimPiece& piece);
+  // Where the hand is, in the local root's widget (DIPs), for the renderer.
+  gfx::PointF HandInLocal() const;
+  // On arrival: the answer for a plain move; else the dwell drawn, an
+  // element's press re-aimed and hit-checked, then the end.
+  void Arrived();
+  // The landing routed as a real press is (the widget under it), then
+  // hit-checked in the element's local root.
+  void Route();
+  void OnRouted(base::WeakPtr<RenderWidgetHostViewBase> target,
+                std::optional<gfx::PointF> point);
+  void OnHitChecked(const std::string& verdict,
+                    const std::string& hit,
+                    const std::string& hit_kind);
+  // What lies over the landing in another frame's process, named there, and
+  // where it is: the page's own content (`page`) or another frame's.
+  void OnCoverNamed(bool page,
+                    const std::string& hit,
+                    int32_t hit_node_id,
+                    const std::string& value);
+  // The frame a frame element holds, when it is one of another process: a
+  // press landing in its view, or in one inside it, presses the element.
+  RenderWidgetHostViewBase* ChildFrameView() const;
+  // Whether a press landing in `target` lands inside the frame a frame
+  // element holds, in this process or another.
+  bool InChildFrame(RenderWidgetHostViewBase* target) const;
+  // The end at the landing, its wait counted from the last move.
+  void End();
+  void OnEnded(bool ok);
+  void OnEndOverdue();
+  void OnTimeout();
+  void OnCollectorGone();
+  void Answer(const std::string& outcome,
+              const std::string& reason = std::string(),
+              const std::string& hit = std::string(),
+              const std::string& hit_kind = std::string());
+  // The one answer, with the pointer at `at` (root DIPs).
+  void Send(const std::string& outcome,
+            const std::string& reason,
+            const std::string& hit,
+            const PlannerPoint& at,
+            const std::string& hit_kind = std::string());
+
+  // Where on a box (root DIPs) the hand lands: the call's fractions, kept
+  // inside as a press point is, else the hand's own pick, its scatter sized
+  // by `sized_by` (what shows of the whole element).
+  PlannerPoint PointIn(const PlannerRect& box,
+                       const PlannerRect& sized_by) const;
+  // Keeps the parts of the element a press would act on instead of it, as
+  // the renderer read them.
+  void KeepHoles(const blink::mojom::AgentAimPiece& piece);
+  // The box, or -- its middle on one of those parts -- the part clear of them
+  // all a hand would take: large, thick and near it.
+  PlannerRect ClearPart(const PlannerRect& box) const;
+  // The largest part of the box clear of them all, at least 8 px each way --
+  // with `near_hand`, the best by its size and thickness against its distance
+  // from the hand; empty for none.
+  PlannerRect LargestClearPart(const PlannerRect& box, bool near_hand) const;
+  // What shows of the element's whole box (root DIPs) at the last reading;
+  // the piece when that is unknown.
+  PlannerRect ShownBox() const;
+  // How wide a box is along the way from the hand to `to`: the chord
+  // through it in that direction, for the leg's timing.
+  double WidthAlong(const PlannerRect& box, const PlannerPoint& to) const;
+  // pressed, released or clicked: what the end does.
+  std::string EndOutcome() const;
+  bool Presses() const;
+  RenderWidgetHostViewBase* LocalView() const;
+  PlannerPoint ToRoot(double x, double y) const;
+  // A box of the local root's widget, in the root view (empty when it is
+  // not finite).
+  PlannerRect BoxToRoot(const blink::mojom::AgentElementBox* box) const;
+  InputHandler::MousePathRequest Request(
+      std::vector<PlannerPoint> points) const;
+  base::WeakPtr<MoveSession> Weak();
+
+  const raw_ref<InputHandler> handler_;
+  const uint64_t id_;
+  const Params params_;
+  const raw_ref<HumanPathPlanner> planner_;
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector_;
+  Completion completion_;
+  base::OnceCallback<void(uint64_t)> on_done_;
+
+  const base::TimeTicks started_;
+  // Where the hand is (root DIPs), once what has been queued has played.
+  PlannerPoint hand_;
+  // Where it lands, and the piece of the element (or the box) it aims at.
+  PlannerPoint landing_;
+  PlannerRect piece_;
+  int corrections_ = 0;
+  // Re-aims off a part of the element with a control of its own come up under
+  // the landing: not the element moving.
+  int hole_corrections_ = 0;
+  // The element's box (root DIPs) at the last reading; whether the reading
+  // asked for now is a look at an element that had moved; whether it has been
+  // seen moving, and how many looks in a row since have found it still.
+  PlannerRect seen_box_;
+  bool looked_ = false;
+  bool seen_moving_ = false;
+  int still_looks_ = 0;
+  // The element's box when the landing was chosen on it, and whether the
+  // hand has followed it once it settled.
+  PlannerRect aimed_box_;
+  bool followed_ = false;
+  // The end's own wait, drawn once on the first arrival; whether the end
+  // has been queued.
+  std::optional<double> dwell_ms_;
+  bool end_queued_ = false;
+  // The outcome watch's id for the end, once it went out (0:
+  // none).
+  int action_id_ = 0;
+  // The parts of the element a press would act on instead of it -- its own
+  // links, buttons, controls -- in root DIPs, 1 px wider each way and cut to
+  // the piece; none when no part of it clear of them is an eighth of it. And
+  // the one the press landed on, when the hit check named one.
+  std::vector<PlannerRect> holes_;
+  std::string inner_;
+  // The boxes of the hover region the hand is in on its way to the element,
+  // as the last reading had them; none when there is none.
+  std::vector<PlannerRect> region_;
+  // A frame element's own frame (its DevTools token, AimPiece), and the
+  // collector of the frame whose content lies over the landing.
+  std::optional<std::string> child_frame_;
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> cover_collector_;
+  base::OneShotTimer timeout_timer_;
+  base::OneShotTimer look_timer_;
+  base::WeakPtrFactory<MoveSession> weak_factory_{this};
+};
