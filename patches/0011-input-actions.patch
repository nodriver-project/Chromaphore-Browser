+// browser: Input.dispatchMousePath: its parameters checked, its points put in
+// the root view's DIPs, then QueueMousePath.
+void InputHandler::DispatchMousePath(
+    std::unique_ptr<Array<Input::MousePathPoint>> path,
+    int polling_rate_hz,
+    std::optional<std::string> button,
+    std::optional<int> modifiers,
+    std::unique_ptr<Input::MousePathEnd> end,
+    std::unique_ptr<Array<Input::MouseWheelNotch>> wheel,
+    std::optional<bool> follow_navigation,
+    std::unique_ptr<DispatchMousePathCallback> callback) {
+  // browser: other pointer input ends a reveal under way where it has got to.
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  // browser: and a drag Input.performDrag is carrying out.
+  InterruptAllSessions();
+  if (!path || path->empty()) {
+    callback->sendFailure(
+        Response::InvalidParams("'path' must be a non-empty array"));
+    return;
+  }
+  if (polling_rate_hz < kMinPollingRateHz ||
+      polling_rate_hz > kMaxPollingRateHz) {
+    callback->sendFailure(
+        Response::InvalidParams("'pollingRateHz' must be between 1 and 10000"));
+    return;
+  }
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  if (!host_ || !host_->GetRenderWidgetHost() || !root_view) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+
+  // A move without a held button is a hover whatever the caller intended:
+  // no drag starts and no pointer capture is granted, so a native control
+  // such as <input type=range> stays where the press landed. A hand-written
+  // mousemove listener keeps its own is-down flag and reacts anyway, which
+  // is why a hover reads as working until it meets a real control.
+  const std::optional<SyntheticPointerActionParams::Button> held =
+      ButtonByName(button.value_or("none"), /*allow_none=*/true);
+  if (!held) {
+    callback->sendFailure(
+        Response::InvalidParams("'button' must be one of none, left, middle, "
+                                "right, back, forward"));
+    return;
+  }
+
+  MousePathRequest request;
+  request.polling_rate_hz = polling_rate_hz;
+  request.button = *held;
+  if (modifiers.has_value()) {
+    if (!ValidModifiers(*modifiers)) {
+      callback->sendFailure(Response::InvalidParams(
+          "'modifiers' must combine Alt=1, Ctrl=2, Meta=4 and Shift=8"));
+      return;
+    }
+    request.modifiers = *modifiers;
+  }
+  if (end) {
+    using EndAction = SyntheticMousePathGestureParams::EndAction;
+    const std::optional<EndAction> end_action =
+        ParseEndAction(end->GetAction());
+    if (!end_action) {
+      callback->sendFailure(Response::InvalidParams(
+          "'end.action' must be one of press, release, click"));
+      return;
+    }
+    request.end_action = *end_action;
+    const std::optional<SyntheticPointerActionParams::Button> end_button =
+        ButtonByName(end->GetButton("left"), /*allow_none=*/false);
+    if (!end_button) {
+      callback->sendFailure(Response::InvalidParams(
+          "'end.button' must be one of left, middle, right, back, forward"));
+      return;
+    }
+    request.end_button = *end_button;
+    const int clicks = end->GetClickCount(1);
+    if (!ValidClickCount(clicks)) {
+      callback->sendFailure(
+          Response::InvalidParams("'end.clickCount' must be 1, 2 or 3"));
+      return;
+    }
+    request.click_count = clicks;
+    const double delay_ms = end->GetDelayMs(0);
+    const double hold_ms = end->GetHoldMs(0);
+    const double gap_ms = end->GetGapMs(0);
+    for (double ms : {delay_ms, hold_ms, gap_ms}) {
+      if (ms < 0 || ms > 10000) {
+        callback->sendFailure(Response::InvalidParams(
+            "'end' delays must be between 0 and 10000 ms"));
+        return;
+      }
+    }
+    request.end_delay = base::Milliseconds(delay_ms);
+    request.hold = base::Milliseconds(hold_ms);
+    request.click_gap = base::Milliseconds(gap_ms);
+  }
+  if (wheel) {
+    for (const auto& notch : *wheel) {
+      const int notches_x = notch->GetNotchesX(0);
+      const int notches_y = notch->GetNotchesY(0);
+      const double delay_ms = notch->GetDelayMs(0);
+      if (notches_x < -20 || notches_x > 20 || notches_y < -20 ||
+          notches_y > 20 || delay_ms < 0 || delay_ms > 10000) {
+        callback->sendFailure(Response::InvalidParams(
+            "each wheel turn is at most 20 notches, at most 10000 ms after "
+            "the last"));
+        return;
+      }
+      request.wheel.push_back(
+          {notches_x, notches_y, base::Milliseconds(delay_ms)});
+    }
+  }
+  // Into the root view's DIPs, where QueueMousePath works.
+  const float scale = ScaleFactor();
+  for (const auto& point : *path) {
+    request.points.push_back({point->GetX() * scale, point->GetY() * scale});
+  }
+  // A press or a wheel turn outside the view is refused, as QueueMousePath
+  // refuses it, with the reason.
+  if (MousePathEndsOutsideView(request, root_view->GetViewBounds())) {
+    callback->sendFailure(Response::InvalidParams(
+        "the path ends outside the page's view, where a press or a wheel "
+        "turn is not delivered"));
+    return;
+  }
+  // browser: a press, release or click at the end is an action whose outcome
+  // is watched; nothing QueueMousePath refuses is left by here.
+  const int action_id =
+      end ? OutcomeWatch()->ArmMouse(request.end_action, request.click_count,
+                                     follow_navigation.value_or(true))
+          : 0;
+  QueueMousePath(std::move(request),
+                 base::BindOnce(&InputHandler::OnMousePathFinished,
+                                weak_factory_.GetWeakPtr(), std::move(callback),
+                                action_id));
+}
+
+void InputHandler::OnMousePathFinished(
+    std::unique_ptr<DispatchMousePathCallback> callback,
+    int action_id,
+    bool ok) {
+  if (ok) {
+    // browser: answered once what the end led to is known.
+    ActionOutcomeWatch::Reply(
+        outcome_watch_.get(), action_id,
+        base::BindOnce(&DispatchMousePathCallback::sendSuccess,
+                       std::move(callback)));
+  } else {
+    if (outcome_watch_) {
+      outcome_watch_->Abandon(action_id);
+    }
+    callback->sendFailure(Response::ServerError("Mouse path gesture aborted"));
+  }
+}
+
 void InputHandler::ClearInputState() {
+  // browser: a drag Input.performDrag is carrying out ends, and is answered
+  // interrupted.
+  InterruptDragSession();
+  InterruptMoveSession();
+  InterruptScrollSession();
+  InterruptSelectSession(Interruption::kReset);
+  InterruptTemporalSession(Interruption::kReset);
+  InterruptColorSession(Interruption::kReset);
+  InterruptFileSession(Interruption::kReset);
+  // browser: where the last path left the pointer is no longer known, nor
+  // a button held.
+  last_path_point_.reset();
+  held_button_ = SyntheticPointerActionParams::Button::NO_BUTTON;
+  wheel_sequence_ = WheelSequence();
   while (!injectors_.empty())
     (*injectors_.begin())->Cleanup();
   // TODO(dgozman): cleanup touch callbacks as well?
   pointer_ids_.clear();
+  // browser: a pending typing session's destructor answers its CDP callback:
+  // failed, unless its keys had gone down. A typing call or a paste
+  // still waiting for its field reading before is dropped too: it would
+  // type into whatever document came meanwhile.
+  active_typing_session_.reset();
+  ++typing_request_;
+  // browser: a drag held is called off, not left mid-drag, and
+  // Input.performDrag's executor hears so.
+  EndDragPath(false);
+  // browser: and a reveal under way is answered, not left hanging.
+  if (std::unique_ptr<Reveal> reveal = std::move(reveal_)) {
+    reveal->timer.Stop();
+    if (reveal->completion) {
+      FailReveal(std::move(reveal->completion),
+                 Response::ServerError("Input was reset"));
+    }
+  }
 }
 
