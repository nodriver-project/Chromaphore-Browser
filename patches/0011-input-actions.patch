+using EndAction = SyntheticMousePathGestureParams::EndAction;
+using Type = blink::WebInputEvent::Type;
+
+// The renderer has this long, from the command's last event leaving, to
+// answer for it: a dialog in a click handler holds the ack until it closes.
+constexpr base::TimeDelta kHandledCap = base::Milliseconds(1000);
+// Then this long more: a navigation request travels on another pipe than the
+// ack, and a form submission is a task posted after the event's.
+constexpr base::TimeDelta kGrace = base::Milliseconds(100);
+// A cross-document navigation the action started is followed this long, from
+// the grace's end, to its commit (or failure).
+constexpr base::TimeDelta kCommitCap = base::Seconds(3);
+// At most this many things an answer carries, and late events an action
+// sends; same-document ones after the answer at most one per window (a feed
+// that replaceStates as it scrolls).
+constexpr size_t kMaxItems = 32;
+constexpr int kMaxLateEvents = 32;
+constexpr base::TimeDelta kSameDocumentWindow = base::Milliseconds(250);
+// Actions ended before their command settled them, kept for that Settle.
+constexpr size_t kMaxSuperseded = 4;
+
+base::TimeTicks Now() {
+  return base::TimeTicks::Now();
+}
+
+// Action ids, browser-wide (the UI thread's): a watch made again after
+// Input.disable never reuses one a command still playing out holds.
+int NextActionId() {
+  static int last_action_id = 0;
+  return ++last_action_id;
+}
+
+std::string DispositionName(WindowOpenDisposition disposition) {
+  switch (disposition) {
+    case WindowOpenDisposition::NEW_FOREGROUND_TAB:
+      return "newForegroundTab";
+    case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+      return "newBackgroundTab";
+    case WindowOpenDisposition::NEW_POPUP:
+      return "newPopup";
+    case WindowOpenDisposition::NEW_WINDOW:
+      return "newWindow";
+    case WindowOpenDisposition::CURRENT_TAB:
+      return "currentTab";
+    case WindowOpenDisposition::SINGLETON_TAB:
+      return "singletonTab";
+    case WindowOpenDisposition::SAVE_TO_DISK:
+      return "saveToDisk";
+    case WindowOpenDisposition::OFF_THE_RECORD:
+      return "offTheRecord";
+    case WindowOpenDisposition::IGNORE_ACTION:
+      return "ignoreAction";
+    case WindowOpenDisposition::SWITCH_TO_TAB:
+      return "switchToTab";
+    case WindowOpenDisposition::NEW_PICTURE_IN_PICTURE:
+      return "newPictureInPicture";
+    case WindowOpenDisposition::NEW_SPLIT_VIEW:
+      return "newSplitView";
+    case WindowOpenDisposition::UNKNOWN:
+      return "unknown";
+  }
+  return "unknown";
+}
