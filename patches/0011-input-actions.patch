+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Input.pickColor's executor: a colour field -- an <input type=color> --
+// set the way a person sets one, as one action. The field is read in its
+// renderer (AgentSnapshotCollector::ReadColor) before anything moves: refused
+// when it is not such a field or is disabled; answered already when it holds
+// the colour. Else it is brought into view (InputHandler::RunReveal) and read
+// again, and the hand clicks it (InputHandler::RunMove, unarmed). Its picker
+// -- a page popup the browser shows -- is watched for each frame; once it
+// shows, the session waits as a person choosing a colour would, then picks
+// through the picker's own commit (AgentSnapshotCollector::CommitColor: what
+// pressing Enter on a typed hex code runs), armed as the action
+// (ActionOutcomeWatch::ArmSelect) right before it goes out, as a select's pick
+// is; the field is read until it holds the colour: picked, else mismatch. A
+// picker that does not show (an inactive window, a hidden tab) answers
+// notOpened, with why. One at a time per InputHandler: other pointer input, a
+// newer pick or fill, a select, scroll, reveal or move, Input.disable or a
+// renderer change answers it interrupted, with why; its picker, when open, is
+// closed without a pick.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_COLOR_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_COLOR_SESSION_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/devtools/protocol/move_session.h"
+#include "content/browser/devtools/protocol/page.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom.h"
+
+namespace content::protocol {
+
+// What a pick came to, as Input.pickColor answers it: a refusal before any
+// session in `failure`; else the outcome, why, what lies over a press refused
+// and the kind of an open layer that names, where the hand is (CSS px of the
+// main frame's viewport), how long it took, and what the pick led to (null
+// when it did not go out). Empty strings are left out of the answer.
+struct ColorResult {
+  ColorResult();
+  ColorResult(ColorResult&&);
+  ColorResult& operator=(ColorResult&&);
+  ~ColorResult();
+
+  std::optional<Response> failure;
+  std::string outcome;
+  std::string reason;
+  std::string hit;
+  std::string hit_kind;
+  double x = 0;
+  double y = 0;
+  double duration_ms = 0;
+  std::unique_ptr<Page::ActionOutcome> action_outcome;
+};
+
+class ColorSession {
+ public:
+  // A call to Input.pickColor, checked by InputHandler::PickColor.
+  struct Params {
+    Params();
+    Params(const Params&);
+    Params& operator=(const Params&);
+    ~Params();
+
+    // The field: its DOMNodeId in the local root of `frame_id`.
+    int32_t node_id = 0;
+    std::string frame_id;
+    // The colour, #rrggbb, lower-cased.
+    std::string value;
+    // As Input.moveTo takes them, for the hand's click.
+    std::optional<std::string> intent;
+    double speed_multiplier = 1;
+    base::TimeDelta timeout;
+    // Where the pointer is, in CSS px of the main frame's viewport, for when
+    // no mouse path has put it anywhere yet.
+    std::optional<double> pointer_x;
+    std::optional<double> pointer_y;
+    // Root DIPs per CSS px of the main frame's viewport.
+    double css_scale = 1;
+    // Whether the answer waits for a cross-document navigation the pick
+    // started to end.
+    bool follow_navigation = true;
+  };
+
+  using Completion = base::OnceCallback<void(ColorResult)>;
+
+  // `completion` hears the answer; `on_done` hears this session's id, posted,
+  // once it has answered.
+  ColorSession(InputHandler& handler,
+               uint64_t id,
+               Params params,
+               Completion completion,
+               base::OnceCallback<void(uint64_t)> on_done);
+  ColorSession(const ColorSession&) = delete;
+  ColorSession& operator=(const ColorSession&) = delete;
+  // Unanswered, it answers interrupted, without the handler; its picker, when
+  // open, is closed without a pick.
+  ~ColorSession();
+
+  void Start();
+  // Other input, a renderer change (the frame navigated) or Input.disable:
+  // answered at once -- picked when all of the pick went out, else
+  // interrupted with `why`; its own move or reveal stops where it has got to,
+  // and its picker, when open, is closed without a pick.
+  void Interrupt(InputHandler::Interruption why);
+
+  uint64_t id() const { return id_; }
+  bool answered() const { return !completion_; }
+
+ private:
+  // What a reading of the field is for.
+  enum class Read {
+    // Before anything, and again once it is in view: what it is, and whether
+    // anything is to be done.
+    kFirst,
+    // After the click, each frame: whether its picker shows.
+    kPicker,
+    // After the pick: until it holds the colour.
+    kAfter,
+    // Out of time after a click that went out: whether its picker shows, to
+    // close it.
+    kClose,
+  };
+
+  void Ask(Read read);
+  void OnRead(Read read, blink::mojom::AgentColorReadingPtr reading);
+  void OnFirstRead(const blink::mojom::AgentColorReading& reading);
+  void OnCloseRead(const blink::mojom::AgentColorReading* reading);
+
+  void Reveal();
+  void OnRevealed(InputHandler::RevealResult result);
+  // The click that opens its picker.
+  void Open();
+  void OnOpened(MoveResult result);
+  void OnPickerRead(const blink::mojom::AgentColorReading& reading);
+  // The picker shows: the pick, after the dwell.
+  void Pick();
+  void OnPicked(const std::string& outcome);
+  // Its picker closed without a pick, when it may be open.
+  void ClosePicker();
+  // A reading that did not show what it waits for yet: asked again a frame
+  // later, and true, while `deadline_` is ahead; false once it has passed.
+  bool LookAgain(Read read);
+
+  // The hand's click refused: answered as the move said it.
+  void AnswerMove(const MoveResult& result);
+  void OnTimeout();
+  // The one answer: `wait` once what the armed action led to has settled.
+  void Answer(const std::string& outcome,
+              const std::string& reason = std::string(),
+              const std::string& hit = std::string(),
+              const std::string& hit_kind = std::string());
+  void Fail(Response response);
+  void Send(const std::string& outcome,
+            const std::string& reason,
+            const std::string& hit,
+            const std::string& hit_kind,
+            bool wait);
+  // Its own move or reveal under way stops where it has got to.
+  void StopSteps();
+  double RemainingMs() const;
+  base::WeakPtr<ColorSession> Weak();
+
+  const raw_ref<InputHandler> handler_;
+  const uint64_t id_;
+  Params params_;
+  Completion completion_;
+  base::OnceCallback<void(uint64_t)> on_done_;
+  const base::TimeTicks started_;
+
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector_;
+  GlobalRenderFrameHostId local_root_;
+  // Until when a look waits for what it reads for; whether the picker's watch
+  // has had its extra wait, as a hand waits for a picker that is slow to come.
+  base::TimeTicks deadline_;
+  bool picker_wait_extended_ = false;
+  // At the click: whether the browser would refuse the picker.
+  bool window_inactive_ = false;
+  bool tab_hidden_ = false;
+  // Out of time after a click: how many frames its picker has been looked
+  // for.
+  int close_looks_ = 0;
+
+  // The field has been brought into view, and read again after it.
+  bool revealed_ = false;
+  bool revealing_ = false;
+  bool moving_ = false;
+  // From the click's answer until the pick goes out: its picker may be open.
+  bool picker_may_show_ = false;
+  // The pick sent and not answered; answered picked: all of it went out.
+  bool pick_in_flight_ = false;
+  bool as_picked_ = false;
+  bool timed_out_ = false;
+  // The outcome watch's id once the pick armed it (0: none); whether the
+  // pick may have reached the page (from its sending, until its answer says
+  // nothing did).
+  int action_id_ = 0;
+  bool reached_ = false;
+  // False once the handler is going (the destructor): nothing of it is
+  // asked.
+  bool handler_alive_ = true;
+
+  base::OneShotTimer timeout_timer_;
+  base::OneShotTimer clock_;
+  base::WeakPtrFactory<ColorSession> weak_factory_{this};
+};
+
+}  // namespace content::protocol
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_COLOR_SESSION_H_
diff --git a/content/browser/devtools/protocol/drag_route.cc b/content/browser/devtools/protocol/drag_route.cc
new file mode 100644
index 0000000000..2ce3b9096d
--- /dev/null
+++ b/content/browser/devtools/protocol/drag_route.cc
@@ -0,0 +1,1100 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/devtools/protocol/drag_route.h"
+
+#include <stddef.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <limits>
+#include <numbers>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+
+namespace content {
+
+namespace {
+
+// Calm reads one point of every cell the terrain's edges cut its clearance
+// square into; a square cut into more columns or rows than this is answered
+// "not calm" (only an absurd clearance gets there).
+constexpr size_t kMaxCellsPerAxis = 64;
+
+// NearestCalm: rings every px to 8 px, every 2 px to 32 px, every 4 px
+// beyond, with 16 + 4 * r candidates on a ring of radius r, the first at
+// angle 0. The radius is held to 400 px so the search stays bounded.
+constexpr double kFineRingsTo = 8;
+constexpr double kMediumRingsTo = 32;
+constexpr double kMaxSearchRadius = 400;
+constexpr int kRingCandidates = 16;
+constexpr int kRingCandidatesPerPx = 4;
+
+// Corridor: a sample every 4 px along the chord (at most 1024 samples, so a
+// chord over 4092 px is sampled more sparsely), the room capped at 400 px,
+// and at most 256 segments read along one ray (past them the room ends
+// where the reading stopped).
+constexpr double kCorridorStep = 4;
+constexpr double kCorridorCap = 400;
+constexpr double kMaxCorridorIntervals = 1023;
+constexpr size_t kMaxRaySegments = 256;
+
+// No band box.
+constexpr size_t kNoBox = std::numeric_limits<size_t>::max();
+
+// The sides of a band, as bits.
+constexpr int kTop = 1;
+constexpr int kBottom = 2;
+constexpr int kLeft = 4;
+constexpr int kRight = 8;
+constexpr int kAllSides = kTop | kBottom | kLeft | kRight;
+constexpr std::array<int, 4> kSideBits = {kTop, kBottom, kLeft, kRight};
+
+// Every x and every y at which a rect of the terrain starts or ends, sorted
+// and unique, built once per search. BandAt and ScrollbarAt answer the same
+// for every point of a cell between neighbouring edges (containment is
+// half-open, so a cell [a, b) holds its left end a, and a zone's
+// half-planes are p < edge or p >= edge), which is what makes Calm's
+// clearance and Corridor's rays exact.
+struct Edges {
+  std::vector<double> xs;
+  std::vector<double> ys;
+};
+
+// Which band boxes count at a point.
+enum class Rule {
+  // Blink's walk for a native drag: the box's visible holds the point; under
+  // fixed boxes, only a box inside one of them or one of them itself (their
+  // stacking is not known, so any of the fixed boxes over the point).
+  kOwner,
+  // A pointer library: a box whose visible holds the point, or a box of the
+  // grab chain, counts when the point lies beyond its lib_inner on a live
+  // side (LiveSides). A fixed cover does not stop a library: it tests the
+  // pointer against its scroll containers' rects.
+  kLibZone,
+};
+
+bool IsFinite(const PlannerPoint& p) {
+  return std::isfinite(p.x) && std::isfinite(p.y);
+}
+
+bool IsZero(const PlannerPoint& p) {
+  return p.x == 0 && p.y == 0;
+}
+
+// A rect with a non-finite field reads as empty.
+DragRect FiniteRect(const DragRect& r) {
+  if (std::isfinite(r.x) && std::isfinite(r.y) && std::isfinite(r.w) &&
+      std::isfinite(r.h)) {
+    return r;
+  }
+  return DragRect();
+}
+
+// A non-finite item offset reads as none.
+PlannerPoint FiniteOffset(const PlannerPoint& offset) {
+  return IsFinite(offset) ? offset : PlannerPoint();
+}
+
+// The edges a rect's containment can change at: none on an axis where it
+// has no extent (nothing is ever inside it there).
+void AddEdges(const DragRect& r,
+              std::vector<double>* xs,
+              std::vector<double>* ys) {
+  if (r.w > 0) {
+    xs->push_back(r.x);
+    xs->push_back(r.right());
+  }
+  if (r.h > 0) {
+    ys->push_back(r.y);
+    ys->push_back(r.bottom());
+  }
+}
+
+// A library zone's edges count on both axes even without extent: outside
+// its box the zone is half-planes, which an empty lib_inner still bounds.
+void AddZoneEdges(const DragRect& r,
+                  std::vector<double>* xs,
+                  std::vector<double>* ys) {
+  xs->push_back(r.x);
+  xs->push_back(r.right());
+  ys->push_back(r.y);
+  ys->push_back(r.bottom());
+}
+
+void SortUnique(std::vector<double>* values) {
+  std::sort(values->begin(), values->end());
+  values->erase(std::unique(values->begin(), values->end()), values->end());
+}
+
+// Each band box's parent as an index into `bands` (kNoBox: none, or a box
+// the survey did not list); of two boxes with one id the first, as Find().
+std::vector<size_t> ParentIndices(const std::vector<DragBand>& bands) {
+  std::vector<std::pair<int, size_t>> by_id;
+  by_id.reserve(bands.size());
+  for (size_t i = 0; i < bands.size(); ++i) {
+    by_id.emplace_back(bands[i].id, i);
+  }
+  std::sort(by_id.begin(), by_id.end());
+  std::vector<size_t> parents(bands.size(), kNoBox);
+  for (size_t i = 0; i < bands.size(); ++i) {
+    const int parent = bands[i].parent;
+    if (parent == 0 || parent == bands[i].id) {
+      continue;
+    }
+    const auto it = std::lower_bound(by_id.begin(), by_id.end(),
+                                     std::make_pair(parent, size_t{0}));
+    if (it != by_id.end() && it->first == parent) {
+      parents[i] = it->second;
+    }
+  }
+  return parents;
+}
+
+Edges BuildEdges(const DragTerrain& terrain) {
+  Edges edges;
+  AddEdges(terrain.viewport(), &edges.xs, &edges.ys);
+  for (const DragBand& band : terrain.bands()) {
+    AddEdges(band.border, &edges.xs, &edges.ys);
+    AddEdges(band.outer, &edges.xs, &edges.ys);
+    AddEdges(band.inner, &edges.xs, &edges.ys);
+    AddEdges(band.visible, &edges.xs, &edges.ys);
+    AddZoneEdges(band.lib_inner, &edges.xs, &edges.ys);
+  }
+  for (const DragFixedBox& fixed : terrain.fixed_boxes()) {
+    AddEdges(fixed.box, &edges.xs, &edges.ys);
+  }
+  SortUnique(&edges.xs);
+  SortUnique(&edges.ys);
+  return edges;
+}
+
+// The sides of `rect` p lies beyond, of those in `sides`: above it (kTop),
+// below it, left of it, right of it. Half-open as Contains: a point on the
+// bottom or the right edge lies beyond.
+int SidesBeyond(const DragRect& rect, const PlannerPoint& p, int sides) {
+  int beyond = 0;
+  if ((sides & kTop) != 0 && p.y < rect.y) {
+    beyond |= kTop;
+  }
+  if ((sides & kBottom) != 0 && p.y >= rect.bottom()) {
+    beyond |= kBottom;
+  }
+  if ((sides & kLeft) != 0 && p.x < rect.x) {
+    beyond |= kLeft;
+  }
+  if ((sides & kRight) != 0 && p.x >= rect.right()) {
+    beyond |= kRight;
+  }
+  return beyond;
+}
+
+// The live sides of b's library zone: a library (dnd-kit's !isTop and the
+// like, react-beautiful-dnd, SortableJS) scrolls a container only toward a
+// side it can still scroll to. The binder (the box the wheel scrolls)
+// counts both ends of an axis it scrolls on: its other end comes alive as
+// it moves.
+int LiveSides(const DragBand& b, bool binder) {
+  const bool vertical = binder && (b.up || b.down);
+  const bool horizontal = binder && (b.left || b.right);
+  int sides = 0;
+  if (b.up || vertical) {
+    sides |= kTop;
+  }
+  if (b.down || vertical) {
+    sides |= kBottom;
+  }
+  if (b.left || horizontal) {
+    sides |= kLeft;
+  }
+  if (b.right || horizontal) {
+    sides |= kRight;
+  }
+  return sides;
+}
+
+// The live sides of b's library zone p is in: beyond lib_inner on a live
+// side. Inside b that is its zone; past b (a box of the grab chain) the
+// zone runs on as half-planes, as a library that tests the dragged item's
+// scroll ancestors (dnd-kit, react-beautiful-dnd) has no "inside the rect"
+// test.
+int ZoneSides(const DragBand& b, const PlannerPoint& p, int binder) {
+  return SidesBeyond(b.lib_inner, p, LiveSides(b, b.id == binder));
+}
+
+// b is a scroll ancestor of the dragged element: named by the grab chain,
+// or the main document (a document box with no band box above it), which
+// holds every element of the page.
+bool InGrabChain(const DragBand& b, const std::vector<int>& grab_chain) {
+  return (b.is_document && b.parent == 0) ||
+         std::ranges::contains(grab_chain, b.id);
+}
+
+// The innermost band box counting at p under `rule`: no other counting box
+// has it as an ancestor through `parent`. Of several (overlapping
+// siblings), the last in the vector. kNoBox: none.
+size_t InnermostAt(const DragTerrain& terrain,
+                   const std::vector<size_t>& parents,
+                   const std::vector<int>& grab_chain,
+                   int binder,
+                   const PlannerPoint& p,
+                   Rule rule) {
+  const std::vector<DragBand>& bands = terrain.bands();
+  bool covered = false;
+  std::vector<int> covers;
+  if (rule == Rule::kOwner) {
+    for (const DragFixedBox& fixed : terrain.fixed_boxes()) {
+      if (!fixed.box.Contains(p)) {
+        continue;
+      }
+      covered = true;
+      if (fixed.id != 0) {
+        covers.push_back(fixed.id);
+      }
+    }
+  }
+  std::vector<size_t> counting;
+  for (size_t i = 0; i < bands.size(); ++i) {
+    const DragBand& band = bands[i];
+    const bool holds = band.visible.Contains(p);
+    if (rule == Rule::kOwner) {
+      // Under fixed boxes: a box inside one of them, or one of them itself
+      // (a fixed scroller is a fixed box and a band box under one id).
+      if (!holds || (covered && !std::ranges::contains(covers, band.fixed) &&
+                     !std::ranges::contains(covers, band.id))) {
+        continue;
+      }
+    } else {
+      const bool reaches = holds || InGrabChain(band, grab_chain);
+      if (!reaches || ZoneSides(band, p, binder) == 0) {
+        continue;
+      }
+    }
+    counting.push_back(i);
+  }
+  if (counting.size() <= 1) {
+    return counting.empty() ? kNoBox : counting.front();
+  }
+  // Every box some counting box names as an ancestor; a walk stops at a
+  // box it started from or after as many steps as there are boxes, so a
+  // cycle in `parent` cannot hang it.
+  std::vector<size_t> ancestors;
+  for (const size_t i : counting) {
+    size_t j = parents[i];
+    for (size_t steps = 0; j != kNoBox && j != i && steps < bands.size();
+         ++steps) {
+      ancestors.push_back(j);
+      j = parents[j];
+    }
+  }
+  size_t innermost = kNoBox;
+  for (const size_t i : counting) {
+    if (!std::ranges::contains(ancestors, i)) {
+      innermost = i;
+    }
+  }
+  return innermost != kNoBox ? innermost : counting.back();
+}
+
+// The band p is in and which of its sides (bits), by the terrain's mode;
+// BandAt is its id. Native: the owner, and the sides of its inner p lies
+// beyond. Pointer: the counting box, and its live zone sides p is in.
+struct BandHit {
+  int id = 0;
+  int sides = 0;
+};
+
+BandHit BandHitAt(const DragTerrain& terrain,
+                  const std::vector<size_t>& parents,
+                  const std::vector<int>& grab_chain,
+                  int binder,
+                  const PlannerPoint& p) {
+  const std::vector<DragBand>& bands = terrain.bands();
+  if (terrain.mode() == DragMode::kPointer) {
+    const size_t zone =
+        InnermostAt(terrain, parents, grab_chain, binder, p, Rule::kLibZone);
+    if (zone == kNoBox) {
+      return BandHit();
+    }
+    const DragBand& band = bands[zone];
+    return BandHit{band.id, ZoneSides(band, p, binder)};
+  }
+  const size_t owner =
+      InnermostAt(terrain, parents, grab_chain, binder, p, Rule::kOwner);
+  if (owner == kNoBox) {
+    return BandHit();
+  }
+  // The owner's visible holds p and lies in its border, so "in its border,
+  // not in its inner" is "not in its inner".
+  const DragBand& band = bands[owner];
+  if (band.inner.Contains(p)) {
+    return BandHit();
+  }
+  const int sides = SidesBeyond(band.inner, p, kAllSides);
+  return BandHit{band.id, sides != 0 ? sides : kAllSides};
+}
+
+// The box whose scrollbar holds p (its visible and border hold p, its outer
+// does not), the first in the vector; 0 none.
+int ScrollbarAt(const DragTerrain& terrain, const PlannerPoint& p) {
+  for (const DragBand& band : terrain.bands()) {
+    if (band.visible.Contains(p) && band.border.Contains(p) &&
+        !band.outer.Contains(p)) {
+      return band.id;
+    }
+  }
+  return 0;
+}
+
+// One point of each cell `edges` cut [lo, hi] into: lo, then every edge in
+// (lo, hi]. False when there are more than kMaxCellsPerAxis.
+bool CellStarts(const std::vector<double>& edges,
+                double lo,
+                double hi,
+                std::vector<double>* starts) {
+  starts->clear();
+  starts->push_back(lo);
+  for (auto it = std::upper_bound(edges.begin(), edges.end(), lo);
+       it != edges.end() && *it <= hi; ++it) {
+    if (starts->size() >= kMaxCellsPerAxis) {
+      return false;
+    }
+    starts->push_back(*it);
+  }
+  return true;
+}
+
+// Every point within `half` of c on both axes (a square: a little more than
+// the disc of that radius) is in no band and, with `scrollbars`, over no
+// scrollbar. Exact on the terrain's rects: one point of every cell.
+bool SquareClear(const DragTerrain& terrain,
+                 const Edges& edges,
+                 const PlannerPoint& c,
+                 double half,
+                 bool scrollbars) {
+  std::vector<double> xs;
+  std::vector<double> ys;
+  if (!CellStarts(edges.xs, c.x - half, c.x + half, &xs) ||
+      !CellStarts(edges.ys, c.y - half, c.y + half, &ys)) {
+    return false;
+  }
+  for (const double x : xs) {
+    for (const double y : ys) {
+      const PlannerPoint q{x, y};
+      if (terrain.BandAt(q) != 0) {
+        return false;
+      }
+      if (scrollbars && ScrollbarAt(terrain, q) != 0) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// Calm, with the terrain's edges built and the item offset finite.
+bool CalmIn(const DragTerrain& terrain,
+            const Edges& edges,
+            const PlannerPoint& p,
+            double clearance,
+            const PlannerPoint& item_offset) {
+  const DragRect inside = terrain.viewport().Inset(DragTerrain::kViewMargin,
+                                                   DragTerrain::kViewMargin);
+  if (!IsFinite(p) || !inside.Contains(p)) {
+    return false;
+  }
+  const double half = std::isfinite(clearance) ? std::max(0.0, clearance)
+                                               : DragTerrain::kClearance;
+  if (terrain.BandAt(p) != 0 ||
+      !SquareClear(terrain, edges, p, half, /*scrollbars=*/true)) {
+    return false;
+  }
+  if (terrain.mode() != DragMode::kPointer || IsZero(item_offset)) {
+    return true;
+  }
+  // The dragged item's centre, where a library that follows the item
+  // tests it; tremor moves it with the pointer.
+  const PlannerPoint item{p.x + item_offset.x, p.y + item_offset.y};
+  return IsFinite(item) &&
+         SquareClear(terrain, edges, item, half, /*scrollbars=*/false);
+}
+
+// The ring after the one at r.
+double NextRing(double r) {
+  if (r < kFineRingsTo) {
+    return r + 1;
+  }
+  return r < kMediumRingsTo ? r + 2 : r + 4;
+}
+
+// NearestCalm's ring radii up to `limit`, the last one at `limit` itself.
+std::vector<double> RingRadii(double limit) {
+  std::vector<double> radii;
+  for (double r = 1; r <= limit; r = NextRing(r)) {
+    radii.push_back(r);
+  }
+  if (limit > 0 && (radii.empty() || radii.back() < limit)) {
+    radii.push_back(limit);
+  }
+  return radii;
+}
+
+// Every t in (0, cap] at which the ray origin + t * dir crosses one of
+// `edges` (one axis).
+void AddCrossings(const std::vector<double>& edges,
+                  double origin,
+                  double dir,
+                  double cap,
+                  std::vector<double>* ts) {
+  if (std::abs(dir) < 1e-9) {
+    return;
+  }
+  const double reach = origin + dir * cap;
+  const double lo = std::min(origin, reach);
+  const double hi = std::max(origin, reach);
+  for (auto it = std::lower_bound(edges.begin(), edges.end(), lo);
+       it != edges.end() && *it <= hi; ++it) {
+    const double t = (*it - origin) / dir;
+    if (t > 0 && t <= cap) {
+      ts->push_back(t);
+    }
+  }
+}
+
+// The band sides a chord crosses, as (box id, side bit).
+using CrossedSides = std::vector<std::pair<int, int>>;
+
+void MarkCrossed(const BandHit& hit, CrossedSides* crossed) {
+  for (const int side : kSideBits) {
+    const std::pair<int, int> key(hit.id, side);
+    if ((hit.sides & side) != 0 && !std::ranges::contains(*crossed, key)) {
+      crossed->push_back(key);
+    }
+  }
+}
+
+// Every side of the band hit is one the chord crosses.
+bool AllCrossed(const BandHit& hit, const CrossedSides& crossed) {
+  for (const int side : kSideBits) {
+    if ((hit.sides & side) != 0 &&
+        !std::ranges::contains(crossed, std::make_pair(hit.id, side))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// How far the ray from q along the unit vector dir runs, up to cap, before
+// a wall: the start of the first segment (between the ray's crossings of
+// the terrain's edges) whose middle `is_wall` names. Nothing changes inside
+// a segment, so the room is exact. 0 when q is outside the viewport.
+template <typename IsWallFn>
+double RayRoom(const DragTerrain& terrain,
+               const Edges& edges,
+               const PlannerPoint& q,
+               const PlannerPoint& dir,
+               double cap,
+               const IsWallFn& is_wall) {
+  if (!(cap > 0) || !terrain.viewport().Contains(q)) {
+    return 0;
+  }
+  std::vector<double> cuts;
+  AddCrossings(edges.xs, q.x, dir.x, cap, &cuts);
+  AddCrossings(edges.ys, q.y, dir.y, cap, &cuts);
+  cuts.push_back(cap);
+  SortUnique(&cuts);
+  double start = 0;
+  size_t read = 0;
+  for (const double end : cuts) {
+    if (++read > kMaxRaySegments) {
+      return start;
+    }
+    const double mid = (start + end) / 2;
+    const PlannerPoint m{q.x + dir.x * mid, q.y + dir.y * mid};
+    if (is_wall(m)) {
+      return start;
+    }
+    start = end;
+  }
+  return cap;
+}
+
+// A leg's band_of: the band p is in or within the budget's margin of, and
+// for a pointer drag, while p is clear of every band, the band the dragged
+// item's centre (p + item_offset) is in or near.
+int BandForLeg(const DragTerrain& terrain,
+               const PlannerPoint& item_offset,
+               const PlannerPoint& p) {
+  const int band = terrain.BudgetBandAt(p);
+  if (band != 0 || terrain.mode() != DragMode::kPointer ||
+      IsZero(item_offset)) {
+    return band;
+  }
+  return terrain.BudgetBandAt(
+      PlannerPoint{p.x + item_offset.x, p.y + item_offset.y});
+}
+
+}  // namespace
+
+bool DragRect::IsEmpty() const {
+  return !(w > 0 && h > 0);
+}
+
+bool DragRect::Contains(const PlannerPoint& p) const {
+  return !IsEmpty() && x <= p.x && p.x < right() && y <= p.y && p.y < bottom();
+}
+
+DragRect DragRect::Inset(double dx, double dy) const {
+  DragRect inset{x + dx, y + dy, w - 2 * dx, h - 2 * dy};
+  // Nothing left on an axis: no extent there, at the middle.
+  if (!(inset.w > 0)) {
+    inset.x = x + w / 2;
+    inset.w = 0;
+  }
+  if (!(inset.h > 0)) {
+    inset.y = y + h / 2;
+    inset.h = 0;
+  }
+  return inset;
+}
+
+DragRect DragRect::Intersect(const DragRect& other) const {
+  if (IsEmpty() || other.IsEmpty()) {
+    return DragRect();
+  }
+  const double left = std::max(x, other.x);
+  const double top = std::max(y, other.y);
+  const double width = std::min(right(), other.right()) - left;
+  const double height = std::min(bottom(), other.bottom()) - top;
+  if (!(width > 0 && height > 0)) {
+    return DragRect();
+  }
+  return DragRect{left, top, width, height};
+}
+
+DragTerrain::DragTerrain(DragMode mode,
+                         DragRect viewport,
+                         std::vector<DragBand> bands,
+                         std::vector<DragFixedBox> fixed_boxes)
+    : mode_(mode),
+      viewport_(FiniteRect(viewport)),
+      bands_(std::move(bands)),
+      fixed_(std::move(fixed_boxes)) {
+  // A band box is named by its DOMNodeId (> 0) and 0 means none, so a box
+  // without one could never be told from no box: it is dropped. A rect with
+  // a non-finite field reads as empty.
+  std::erase_if(bands_, [](const DragBand& band) { return band.id <= 0; });
+  for (DragBand& band : bands_) {
+    band.border = FiniteRect(band.border);
+    band.outer = FiniteRect(band.outer);
+    band.inner = FiniteRect(band.inner);
+    band.visible = FiniteRect(band.visible);
+    band.lib_inner = FiniteRect(band.lib_inner);
+  }
+  for (DragFixedBox& fixed : fixed_) {
+    fixed.box = FiniteRect(fixed.box);
+  }
+  parents_ = ParentIndices(bands_);
+}
