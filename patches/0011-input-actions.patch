+// browser: a drag that is over: DragFinish answered with `outcome` -- or,
+// when none was asked for, the executor told the drag was lost.
+void InputHandler::DragPathGone(DragPath& drag, const std::string& outcome) {
+  // browser: the button came up inside the drag loop.
+  held_button_ = SyntheticPointerActionParams::Button::NO_BUTTON;
+  if (drag.end == DragPath::End::kHold) {
+    DragHoldEnded();
