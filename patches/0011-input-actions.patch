+// found in the LICENSE file.
+
+#include "content/browser/devtools/protocol/drag_session.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <numbers>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/location.h"
+#include "base/notreached.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/stringprintf.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/types/optional_util.h"
+#include "components/browser/movement_persona.h"
+#include "content/browser/devtools/protocol/action_outcome_watch.h"
+#include "content/browser/devtools/protocol/handler_helpers.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_delegate.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_base.h"
+#include "content/common/input/synthetic_mouse_path_gesture_params.h"
+#include "content/common/input/synthetic_pointer_action_params.h"
+#include "content/public/browser/render_widget_host.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace content::protocol {
+
+namespace {
+
+using EndAction = SyntheticMousePathGestureParams::EndAction;
+using Button = SyntheticPointerActionParams::Button;
+
+// The wheel: a notch moves about 100 root DIPs until measured settle to
+// settle (held to 10-400); a stage goes on while the need is at least half a
+// notch; spins of 2-3 notches while more than 2 are left, single notches
+// after; 40-90 ms between a spin's notches, the first 0-40 ms after the hand
+// is in the station's region for good; 140-320 ms breaths between spins,
+// one 560-700 ms breath for a wheel that moved nothing; a stage whose spins
+// leave the need all but unchanged 4 times running chases a target that
+// recedes.
+constexpr double kNotchGuess = 100;
+constexpr double kNotchMin = 10;
+constexpr double kNotchMax = 400;
+constexpr double kStageMinNotches = 0.5;
+constexpr double kSpinWhileMoreThan = 2;
+constexpr int kNotchGapMinMs = 40;
+constexpr int kNotchGapMaxMs = 90;
+constexpr int kFirstNotchMaxMs = 40;
+constexpr int kBreathMinMs = 140;
+constexpr int kBreathMaxMs = 320;
+constexpr int kStallBreathMinMs = 560;
+constexpr int kStallBreathMaxMs = 700;
+constexpr int kMaxStalledSpins = 4;
+constexpr double kStallProgress = 0.1;
+// A scroll of the box the wheel turns counts as ours from the spin's first
+// notch until this long after its last (and while its settle is waited
+// out).
+constexpr base::TimeDelta kNotchInFlight = base::Milliseconds(300);
+// Settled: frames with the box still spanning 3 frame intervals, or a
+// scrollend; nothing moved: frames spanning 350 ms after the last notch with
+// no change, or, only when no frame comes at all, 350 ms on the browser's
+// clock.
+constexpr double kStillFrames = 3;
+constexpr base::TimeDelta kNoMoveWait = base::Milliseconds(350);
+// A frame interval, when the survey gives none.
+constexpr double kDefaultFrameMs = 16.67;
+// A re-plan waits for a frame showing the box the wheel turned still, at
+// most this long past the notches' window, asking this often.
+constexpr base::TimeDelta kStillWaitMax = base::Seconds(1);
+constexpr base::TimeDelta kStillPoll = base::Milliseconds(20);
+// Offsets that change by less than this (CSS px) did not change; nets
+// smaller than kNetPx are not reported.
+constexpr double kOffsetEpsilon = 0.01;
+constexpr double kNetPx = 0.5;
+// The bands: a run in one band at most 70 ms, its exit included (the
+// planner's budget, which leaves room for the up to 30 ms that stamp
+// jitter, the exit's hit test and the cadence add to a run); the guard at
+// 140 ms; a dart's 1-99 % span 80 ms; dart, rest, last checks and drop in a
+// band at most 110 ms, the rest at most 30 ms of it, 20 ms kept for the
+// last hit check and 10 ms for the drop itself.
+constexpr double kBandBudgetMs = 70;
+// Single notches in one stage before it ends anyway (back and forth across
+// a calm stretch shorter than a notch); steps along a list.
+constexpr int kMaxSingleNotches = 6;
+constexpr int kMaxOrderSteps = 4;
+// A landing in a library's live zone takes the carry up again at most this
+// often a drag; a station found here is a grid over the middle 40-60 % of
+// the box along the axis, as WheelStation lays one, kept up to 24 px in from
+// its sides across it. The wheel's credit for a box has 2 px to spare a
+// spin.
+constexpr int kMaxZoneReturns = 2;
+constexpr double kStationFrom = 0.4;
+constexpr double kStationSpan = 0.2;
+constexpr double kStationInsetMaxPx = 24;
+constexpr int kStationAlong = 8;
+constexpr int kStationAcross = 12;
+constexpr double kSpinSlackPx = 2;
+constexpr base::TimeDelta kBandGuard = base::Milliseconds(140);
+constexpr double kDartMs = 80;
+constexpr double kInBandTotalMs = 110;
+constexpr double kInBandRestMs = 30;
+constexpr double kFinalCheckMs = 20;
+// Re-aiming at a landing within kNoMovePx of the hand moves nothing; within
+// kNudgePx it is one homing sub-movement (a nudge), not a whole leg. A drop
+// zone made from a point is kHoldAroundPx round it, and every drop zone (a
+// hold region) is inset kHoldInsetPx.
+constexpr double kNoMovePx = 2;
+constexpr double kNudgePx = 24;
+constexpr double kHoldAroundPx = 12;
