+// browser: the humanized actions' timeouts, in ms: at least a second; 15 s
+// by default and a minute at most, or, for a drag, a scroll and a choice of
+// files, 30 s and two minutes.
+constexpr double kMinActionTimeoutMs = 1000;
+constexpr double kActionTimeoutMs = 15000;
+constexpr double kActionTimeoutMaxMs = 60000;
+constexpr double kLongActionTimeoutMs = 30000;
+constexpr double kLongActionTimeoutMaxMs = 120000;
+
+// browser: how long a settled reading waits at most for the scrollers that
+// hold the element to hold still, in ms.
+constexpr int kRevealSettleTimeoutMs = 1500;
+
+// browser: a hand come to rest turns the wheel 80-200 ms later; a spin's
+// notches go 40-90 ms apart, with a breath of 140-320 ms between spins.
+constexpr int kTurnAfterRestMinMs = 80;
+constexpr int kTurnAfterRestMaxMs = 200;
+constexpr int kNotchGapMinMs = 40;
+constexpr int kNotchGapMaxMs = 90;
+constexpr int kSpinBreathMinMs = 140;
+constexpr int kSpinBreathMaxMs = 320;
+
+// browser: a wheel's sequence keeps what it began on until the wheel has
+// rested half a second or the pointer has gone 10 DIPs from where it began
+// (MouseWheelPhaseHandler); a hand that wants a new one waits 560-700 ms.
+constexpr base::TimeDelta kWheelSequenceRest = base::Milliseconds(500);
+constexpr double kWheelSequenceSpanDips = 10;
+constexpr int kWheelBreathMinMs = 560;
+constexpr int kWheelBreathMaxMs = 700;
+
+// browser: a command's timeout, in ms: `default_ms` when it gives none, held
+// to kMinActionTimeoutMs-`max_ms`.
+double ClampTimeout(std::optional<double> timeout_ms,
+                    double default_ms,
+                    double max_ms) {
+  return std::clamp(timeout_ms.value_or(default_ms), kMinActionTimeoutMs,
+                    max_ms);
+}
+
+// browser: the refusal of a speed multiplier given and not above 0.
+std::optional<Response> CheckSpeedMultiplier(
+    const std::optional<double>& speed_multiplier) {
+  if (speed_multiplier.has_value() && *speed_multiplier <= 0) {
+    return Response::InvalidParams("'speedMultiplier' must be > 0");
+  }
+  return std::nullopt;
+}
+
+// browser: whether a notch `since_last` after the last one and `moved` DIPs
+// from where the last one's sequence began begins a sequence of its own.
+bool BeginsWheelSequence(base::TimeDelta since_last, double moved) {
+  return since_last >= kWheelSequenceRest || moved >= kWheelSequenceSpanDips;
+}
+
+// browser: the breath before a notch meant to begin a sequence of its own.
+base::TimeDelta WheelBreath() {
+  return base::Milliseconds(
+      base::RandIntInclusive(kWheelBreathMinMs, kWheelBreathMaxMs));
+}
+
+// browser: a reveal refused before anything turned.
+void FailReveal(InputHandler::RevealCompletion completion, Response response) {
+  InputHandler::RevealResult result;
+  result.failure = std::move(response);
+  std::move(completion).Run(std::move(result));
+}
+
+// browser: Input.revealElement's answer, from a reveal's result.
+InputHandler::RevealCompletion AnswerRevealElement(
+    std::unique_ptr<Input::Backend::RevealElementCallback> callback) {
+  return base::BindOnce(
+      [](std::unique_ptr<Input::Backend::RevealElementCallback> callback,
+         InputHandler::RevealResult result) {
+        if (result.failure) {
+          callback->sendFailure(*result.failure);
+          return;
+        }
+        callback->sendSuccess(
+            result.outcome, result.x, result.y, result.calm, result.element_x,
+            result.element_y, result.element_width, result.element_height,
+            result.notches, result.window_scrolled_x, result.window_scrolled_y,
+            result.box_scrolled_x, result.box_scrolled_y, result.box,
+            result.covering, result.covering_kind, result.pointer_x,
+            result.pointer_y, result.shows, result.box_first,
+            result.land_verdict, result.land_hit, result.land_hit_kind);
+      },
+      std::move(callback));
+}
