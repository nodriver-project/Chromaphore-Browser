+
+void InputHandler::WillRunFileChooser(
+    RenderFrameHostImpl* rfh,
+    FileSelectListener* listener,
+    const blink::mojom::FileChooserParams& params,
+    bool* handled) {
+  if (*handled || !rfh || !listener) {
+    return;
+  }
+  if (file_session_ && file_session_->TakeChooser(rfh, listener, params)) {
+    *handled = true;
+  }
+}
+
+void InputHandler::RefuseLateChooser(RenderFrameHostImpl* rfh,
+                                     FileSelectListener* listener,
+                                     bool* handled) {
+  if (*handled || !rfh || !listener) {
+    return;
+  }
+  RenderFrameHostImpl* root = rfh;
+  while (root && !root->is_local_root()) {
+    root = root->GetParent();
+  }
+  if (base::TimeTicks::Now() < refuse_choosers_until_ && root &&
+      root->GetGlobalId() == refuse_choosers_root_) {
+    // Opened late by the click of a choice that gave up: cancelled, as a
+    // person closes a dialog they no longer want, never shown.
+    refuse_choosers_until_ = base::TimeTicks();
+    *handled = true;
+    listener->FileSelectionCanceled();
+  }
+}
