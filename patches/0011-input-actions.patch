+// browser: Input.selectOptions: checked, then carried out by a
+// SelectSession, which answers once through AnswerSelectOptions.
+void InputHandler::SelectOptions(
+    int backend_node_id,
+    const std::string& frame_id,
+    std::unique_ptr<Array<std::string>> values,
+    std::optional<std::string> intent,
+    std::optional<double> speed_multiplier,
+    std::optional<double> timeout_ms,
+    std::optional<double> pointer_x,
+    std::optional<double> pointer_y,
+    std::optional<bool> follow_navigation,
+    std::unique_ptr<SelectOptionsCallback> callback) {
+  SelectSession::Completion completion =
+      AnswerSelectOptions(std::move(callback));
+  // Other pointer input: a reveal, a drag, a move, a scroll and a select
+  // under way end first.
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  InterruptAllSessions();
+  if (std::optional<Response> refusal = CheckActionCall(
+          "Input.selectOptions", /*refuse_held_drag=*/true,
+          {&speed_multiplier, &timeout_ms, &pointer_x, &pointer_y})) {
+    FailSelect(std::move(completion), *refusal);
+    return;
+  }
+  if (backend_node_id <= 0 || frame_id.empty()) {
+    FailSelect(std::move(completion),
+               Response::InvalidParams(
+                   "'backendNodeId' and 'frameId' must name the select"));
+    return;
+  }
+  if (!values || values->empty()) {
+    FailSelect(std::move(completion),
+               Response::InvalidParams("'values' must name an option"));
+    return;
+  }
+  const std::optional<PathIntent> path_intent =
+      ParsePathIntent(intent.value_or("default"));
+  if (!path_intent) {
+    FailSelect(std::move(completion), BadIntent());
+    return;
+  }
+  if (std::optional<Response> refusal =
+          CheckSpeedMultiplier(speed_multiplier)) {
+    FailSelect(std::move(completion), *refusal);
+    return;
+  }
+  SelectSession::Params params;
+  params.node_id = backend_node_id;
+  params.frame_id = frame_id;
+  params.values = std::move(*values);
+  params.intent = std::move(intent);
+  params.path_intent = *path_intent;
+  params.speed_multiplier = speed_multiplier.value_or(1);
+  params.timeout = base::Milliseconds(
+      ClampTimeout(timeout_ms, kActionTimeoutMs, kActionTimeoutMaxMs));
+  params.pointer_x = pointer_x;
+  params.pointer_y = pointer_y;
+  params.css_scale = CssScaleOrOne();
+  params.follow_navigation = follow_navigation.value_or(true);
+  // An answer run on the way here started another select: it must post.
+  DCHECK(!select_session_);
+  select_session_ = std::make_unique<SelectSession>(
+      *this, ++last_select_session_id_, std::move(params),
+      std::move(completion),
+      base::BindOnce(&InputHandler::OnSelectSessionDone,
+                     weak_factory_.GetWeakPtr()));
+  select_session_->Start();
+}
+
+void InputHandler::InterruptSelectSession(Interruption why) {
+  std::unique_ptr<SelectSession> session = std::move(select_session_);
+  if (!session) {
+    return;
+  }
+  session->Interrupt(why);
+  if (!session->answered()) {
+    // Its option's click answers first, and the select from it.
+    ending_select_sessions_.push_back(std::move(session));
+  }
+}
+
+void InputHandler::OnSelectSessionDone(uint64_t id) {
+  if (select_session_ && select_session_->id() == id) {
+    select_session_.reset();
+  }
+  std::erase_if(ending_select_sessions_,
+                [id](const std::unique_ptr<SelectSession>& session) {
+                  return session->id() == id;
+                });
+}
