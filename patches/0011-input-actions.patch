+  Ask(base::BindRepeating(&DragSession::IssueSurvey, Weak()));
+}
+
+void DragSession::IssueSurvey(uint64_t ask) {
+  if (!CanAsk()) {
+    return;
+  }
+  auto p = blink::mojom::AgentDragSurveyParams::New();
+  p->grab_node_id = grab_id_;
+  const PlannerPoint grab = ToLocal(pressed_ ? Hand() : grab_point_);
+  p->grab_x = grab.x;
+  p->grab_y = grab.y;
+  if (params_.target_kind == TargetKind::kElement) {
+    p->target_node_id = params_.target_node_id;
+    p->aim_x = params_.aim_x;
+    p->aim_y = params_.aim_y;
+  }
+  const PlannerPoint hand = ToLocal(Hand());
+  p->hand_x = hand.x;
+  p->hand_y = hand.y;
+  if (params_.target_kind == TargetKind::kValue) {
+    p->want_value = true;
+    p->value = params_.value;
+  }
+  collector_->DragSurvey(std::move(p),
+                         base::BindOnce(&DragSession::OnSurvey, Weak(), ask));
+}
+
+// A survey: its numbers checked, its lists held to their caps, the band
+// boxes' names and offsets kept (the first seen of each for `scrolled`, a
+// box first listed now recorded before it scrolls), the watched set renewed
+// when the boxes listed changed, the grabbed element before the press, and
+// the terrain for the drag's kind.
+void DragSession::OnSurvey(uint64_t ask,
+                           blink::mojom::AgentDragSurveyPtr survey) {
+  if (!Current(ask)) {
+    return;
+  }
+  if (!survey) {
+    Fail("gone", "the page could not be read");
+    return;
+  }
+  if (!FiniteSurvey(*survey)) {
+    BadGeometry();
+    return;
+  }
+  if (survey->bands.size() > kMaxBands) {
+    survey->bands.resize(kMaxBands);
+  }
+  if (survey->fixed_boxes.size() > kMaxFixed) {
+    survey->fixed_boxes.resize(kMaxFixed);
+  }
+  // The boxes watched: those holding the grabbed element first (its move is
+  // told by their scroll), then the rest, at most kMaxWatched.
+  std::vector<int32_t> ids;
+  std::vector<int32_t> others;
+  terrain_offsets_.clear();
+  for (const blink::mojom::AgentBandBoxPtr& band : survey->bands) {
+    if (!band || band->id == 0) {
+      continue;
+    }
+    names_[band->id] = band->name;
+    const Offsets at{band->scroll_x, band->scroll_y};
+    terrain_offsets_[band->id] = at;
+    if (!first_offsets_.contains(band->id)) {
+      first_offsets_[band->id] = at;
+    }
+    if (!frame_offsets_.contains(band->id)) {
+      frame_offsets_[band->id] = at;
+    }
+    latest_offsets_[band->id] = at;
+    if (std::ranges::contains(grab_chain_, band->id)) {
+      ids.push_back(band->id);
+    } else {
+      others.push_back(band->id);
+    }
+  }
+  for (const int32_t other : others) {
+    ids.push_back(other);
+  }
+  if (ids.size() > kMaxWatched) {
+    ids.resize(kMaxWatched);
+  }
+  if (!pressed_ && survey->grab) {
+    grab_before_ = survey->grab.Clone();
+  }
+  if (survey->grab && survey->grab->found && survey->grab->id != 0) {
+    grab_id_ = survey->grab->id;
+  }
+  survey_ = std::move(survey);
+  terrain_ = BuildTerrain(Mode());
+  terrain_layout_version_ = layout_version_;
+  survey_fresh_ = true;
+  survey_at_ = Now();
+  if (ids != watch_ids_) {
+    watch_ids_ = std::move(ids);
+    IssueWatch();
+  }
+  if (survey_then_) {
+    std::move(survey_then_).Run();
+  }
+}
