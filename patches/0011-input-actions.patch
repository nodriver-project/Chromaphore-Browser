+// found in the LICENSE file.
+
+// Input.scrollBy's executor: the wheel turned as a hand turns it to
+// scroll by about an amount one way -- over an element, the hand first moving
+// onto what shows of it, the landing checked as a press there would be; else
+// where the pointer is. The scroller is the one the wheel latches there, as
+// the renderer reads it (AgentSnapshotCollector::WheelScrollerAt): the
+// innermost box under the pointer with room that way, the box where
+// overscroll-behavior stops the chain, or the window. Spins of notches at the
+// pace asked, the scroll read after each spin, the last notches one at a time
+// once the scroll has run out; never on past its end. The action is armed as
+// its first notch goes out (ActionOutcomeWatch::ArmWheel) and answered once
+// the scroll has settled. One at a time per InputHandler: other pointer
+// input, Input.disable, a renderer change or a newer scroll answers it
+// interrupted, with the figures so far.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_SCROLL_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_SCROLL_SESSION_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/devtools/protocol/move_session.h"
+#include "content/browser/devtools/protocol/page.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace content {
+
+class RenderWidgetHostViewBase;
+
+namespace protocol {
+
+// One scroller along the scroll's axis, as Input.scrollBy's WheelScroller
+// says it: named as covers are (empty for the main frame's window), whether
+// it is that window, and -- in CSS px -- its position from its visual start,
+// its offset as scrollTop or scrollLeft gives it, how far it goes, and how
+// long it shows.
+struct WheelScrollerFigures {
+  std::string name;
+  bool page = false;
+  double position = 0;
+  double raw = 0;
+  double max = 0;
+  double length = 0;
+};
+
+// What a scroll came to, as Input.scrollBy answers it: a refusal before any
+// session in `failure`; else the outcome, the notches turned, the scroller
+// before the first notch and after the last (once the scroll ran out), the
+// main frame's window along the axis before and after when the scroller is
+// not it, which moved first, the box the hand moved over to find a scroller,
+// what lies over the landing and why, the scroller's DOMNodeId in its local
+// root, where the pointer is (CSS px of the main frame's viewport), how long
+// it took, and what the scroll led to (null when it armed nothing). Empty
+// strings are left out of the answer.
+struct ScrollResult {
+  ScrollResult();
+  ScrollResult(ScrollResult&&);
+  ScrollResult& operator=(ScrollResult&&);
+  ~ScrollResult();
+
+  std::optional<Response> failure;
+  std::string outcome;
+  int notches = 0;
+  std::optional<WheelScrollerFigures> before;
+  std::optional<WheelScrollerFigures> after;
+  std::optional<double> page_before;
+  std::optional<double> page_after;
+  std::optional<bool> page_first;
+  std::string moved_over;
+  std::string hit;
+  // When `hit` names an open layer the element is not in, its kind, as the
+  // move gave it.
+  std::string hit_kind;
+  std::string reason;
+  std::optional<int> scroller_id;
+  // The scroller's agentNodeId and label in the document's id space, when it
+  // holds one (none for a window, save one of a frame in another process: its
+  // frame element's, when a listing listed it).
+  std::optional<int> scroller_agent_node_id;
+  std::string scroller_label;
+  double pointer_x = 0;
+  double pointer_y = 0;
+  double duration_ms = 0;
+  std::unique_ptr<Page::ActionOutcome> action_outcome;
+};
+
+class ScrollSession {
+ public:
+  enum class Pace { kRead, kFlick };
+
+  // A call to Input.scrollBy, checked by InputHandler::ScrollBy. Points in the
+  // root view's DIPs; the amount in CSS px.
+  struct Params {
+    Params();
+    Params(const Params&);
+    Params& operator=(const Params&);
+    ~Params();
+
+    bool vertical = true;
+    // +1 down or right, -1 up or left.
+    int way = 1;
+    double amount = 400;
+    Pace pace = Pace::kRead;
+    // An element to scroll over: the hand's move onto it (InputHandler::
+    // RunMove, its landing checked and nothing pressed).
+    std::optional<InputHandler::MoveRequest> move;
+    // With no element: when nothing at the pointer scrolls that way and the
+    // window cannot scroll that way at all, the hand moves over the box with
+    // the most room that way.
+    bool find_scroller = true;
+    double speed_multiplier = 1;
+    base::TimeDelta timeout;
+    // Where the pointer is, with no element.
+    gfx::PointF at;
+    // Root DIPs per CSS px of the main frame's viewport.
+    double css_scale = 1;
+    // Whether the answer waits for a cross-document navigation the scroll
+    // started to end (ActionOutcomeWatch::ArmWheel).
+    bool follow_navigation = false;
+  };
+
+  using Completion = base::OnceCallback<void(ScrollResult)>;
+
+  // `completion` hears the answer; `on_done` hears this session's id, posted,
+  // once it has answered.
+  ScrollSession(InputHandler& handler,
+                uint64_t id,
+                Params params,
+                Completion completion,
+                base::OnceCallback<void(uint64_t)> on_done);
+  ScrollSession(const ScrollSession&) = delete;
+  ScrollSession& operator=(const ScrollSession&) = delete;
+  // Unanswered, it answers interrupted, without the handler.
+  ~ScrollSession();
+
+  void Start();
+  // Other pointer input, Input.disable, a renderer change or a newer scroll:
+  // answered interrupted at once, with the figures so far.
+  void Interrupt();
+
+  uint64_t id() const { return id_; }
+  bool answered() const { return !completion_; }
+
+ private:
+  // What a reading of the scroller is for.
+  enum class Read {
+    // The scroller at the pointer, first or after the hand moved to find one.
+    kFind,
+    // The same, asked of the main frame past a frame of another process that
+    // has nothing to move that way: the wheel chains out of it.
+    kFindPast,
+    // After a spin: offsets only.
+    kProgress,
+    // Before a notch that begins a new wheel sequence (half a second or more
+    // after the last): whether the wheel at the pointer still latches it.
+    kLatch,
+    // Once it has held still: the last notches are judged on these.
+    kSettled,
+  };
+
+  // The element's move (stage 1), answered.
+  void OnMoved(MoveResult result);
+  // The pointer routed as a wheel notch is, then the scroller there read in
+  // the local root under it.
+  void Find();
+  void OnFindRouted(base::WeakPtr<RenderWidgetHostViewBase> target,
+                    std::optional<gfx::PointF> point);
+  // Asks the bound collector about the scroller at `local` (the collector's
+  // local root's widget, DIPs).
+  void Ask(Read read,
+           int32_t scroller_id,
+           bool check_latch,
+           const gfx::PointF& local,
+           int settle_ms);
+  void OnRead(Read read, blink::mojom::AgentWheelScrollerPtr scroller);
+  // The scroller found: the plan and the first spin; or end, none, or the
+  // hand moved to find one.
+  void OnFound(Read read, const blink::mojom::AgentWheelScroller& scroller);
+  void OnProgress(const blink::mojom::AgentWheelScroller& scroller);
+  // Still latched: the notch goes out. Not: the hand back over the scroller
+  // (at most kMaxHandMoves times), else the scroll ends as far as it got.
+  void OnLatch(const blink::mojom::AgentWheelScroller& scroller);
+  void OnSettled(const blink::mojom::AgentWheelScroller& scroller);
+  // The figures of a reading kept: the scroller, the page's window, which
+  // moved first.
+  void Note(const blink::mojom::AgentWheelScroller& scroller);
+  // How far the scroller has moved since the first reading, in CSS px.
+  double Moved() const;
+  // Its room left the way the wheel turns, at the last reading.
+  double Room() const;
+  // Whether its end comes before the amount still to go. Decided again at
+  // every step: a page that grows while it scrolls (an infinite list) moves
+  // its end on, and the amount still bounds the scroll.
+  bool EndFirst() const;
+  // The notches still to turn: to its end when that comes first, else the
+  // amount still to go.
+  int NotchesLeft() const;
+
+  // Notches: a spin drawn (at most `at_most`) and turned, notch by notch on
+  // the clock; then a breath and a look (Look), or -- settling -- a settled
+  // reading. A notch half a second or more after the last begins a new wheel
+  // sequence, which latches anew at the pointer: it is sent once a reading
+  // has found the wheel there still latches this scroller (OnLatch).
+  void StartSpin(int at_most);
+  void Turn();
+  // The scroller read after a spin: offsets only.
+  void Look();
+  // The next spin from what is left, or the settle when a notch or less is.
+  void Continue();
+  // The scroller read once it has held still, for the last notches.
+  void Settle();
+  // One notch on its own after a settled reading, `after` from now.
+  void TurnOne(base::TimeDelta after);
+  // The hand to `to` (root DIPs), where the wheel turns what it should; then
+  // `next` after a hand's breath.
+  void MoveHand(const gfx::PointF& to, base::OnceClosure next);
+  void OnHandMoved(base::OnceClosure next, bool ok);
+
+  // Answers from the last readings: scrolled when it moved, still when the
+  // wheel turned and nothing did.
+  void Finish();
+  void OnTimeout();
+  void Answer(const std::string& outcome,
+              const std::string& reason = std::string(),
+              const std::string& hit = std::string(),
+              const std::string& hit_kind = std::string());
+  // A refusal the embedded move met before it began, answered as the call's.
+  void Fail(Response response);
+  // The one answer, the pointer at `at` (root DIPs); `wait`: once what the
+  // armed action led to has settled.
+  void Send(const std::string& outcome,
+            const std::string& reason,
+            const std::string& hit,
+            const gfx::PointF& at,
+            bool wait,
+            const std::string& hit_kind = std::string());
+
+  // The view of the local root that holds the scroller.
+  RenderWidgetHostViewBase* ScrollerView() const;
+  // The pointer in that view's widget (DIPs).
+  gfx::PointF PointerIn(RenderWidgetHostViewBase* view) const;
+  base::WeakPtr<ScrollSession> Weak();
+
+  const raw_ref<InputHandler> handler_;
+  const uint64_t id_;
+  Params params_;
+  Completion completion_;
+  base::OnceCallback<void(uint64_t)> on_done_;
+  const base::TimeTicks started_;
+
+  // Where the pointer is (root DIPs).
+  gfx::PointF at_;
+  // Whether the call named an element (the move goes first).
+  const bool has_element_;
+  // The collector of the local root the reading came from, and that local
+  // root; whether it is the main frame's.
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector_;
+  GlobalRenderFrameHostId local_root_;
+  bool main_root_ = true;
+  // The scroller the wheel latched (its DOMNodeId in `local_root_`).
+  int32_t scroller_id_ = 0;
+  // The first and last readings' figures; the page's window then and now.
+  std::optional<WheelScrollerFigures> before_;
+  std::optional<WheelScrollerFigures> after_;
+  std::optional<double> page_before_;
+  std::optional<double> page_now_;
+  bool have_moved_ = false;
+  std::optional<bool> page_first_;
+  std::string moved_over_;
+  int finds_ = 0;
+  int hand_moves_ = 0;
+
+  // How far a notch moves it (CSS px; measured settle to settle). How far to
+  // go is decided at every step (EndFirst, NotchesLeft).
+  double per_notch_;
+  // The last notches, one at a time on settled readings.
+  bool settling_ = false;
+  // No notch more: the wheel no longer latches the scroller and the hand
+  // found no place where it does; it ends as far as it got.
+  bool ending_ = false;
+  // The element's move is under way (stage 1).
+  bool moving_ = false;
+  // The last notch a latch reading was asked for: the next notch after it
+  // goes out without another. And the next notch gets one, whatever the gap:
+  // after a wait, a breath or a hand move.
+  base::TimeTicks latch_checked_after_;
+  bool check_latch_ = false;
+  // The wheel chained out of a frame of another process: every reading looks
+  // past it (past_remote_frame).
+  bool past_frame_ = false;
+  // The last hand move was refused: nothing moved.
+  bool hand_refused_ = false;
+  // Notches turned and when; how many are left of the spin under way.
+  int sent_ = 0;
+  std::vector<base::TimeTicks> turned_at_;
+  int in_spin_ = 0;
+  // At the last progress reading: the offset, whether a spin moved nothing
+  // and a breath has been taken for it.
+  double last_raw_ = 0;
+  bool breathed_ = false;
+  // The settle phase: rounds, the last settled offset (none before the first
+  // settled reading), notches since.
+  int settle_rounds_ = 0;
+  std::optional<double> settled_raw_;
+  int notches_since_settle_ = 0;
+  // The outcome watch's id once the first notch went out (0: none).
+  int action_id_ = 0;
+
+  base::OneShotTimer timeout_timer_;
+  base::OneShotTimer clock_;
+  base::WeakPtrFactory<ScrollSession> weak_factory_{this};
+};
+
