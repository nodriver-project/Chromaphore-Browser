+// browser: Input.dispatchPaste.
+void InputHandler::DispatchPaste(
+    const std::string& text,
+    std::optional<double> speed_multiplier,
+    std::optional<bool> follow_navigation,
+    std::optional<bool> read_back,
+    std::unique_ptr<DispatchPasteCallback> callback) {
+  // Only into a clipboard of the browser's own. Without one, this would put
+  // the text on the machine's clipboard, over whatever the person copied --
+  // and every browser on the machine shares that one.
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kPrivateClipboard)) {
+    callback->sendFailure(Response::ServerError(
+        "dispatchPaste needs --private-clipboard: without it the "
+        "text would go onto the machine's own clipboard"));
+    return;
+  }
+  if (!KeyboardTargetWidget()) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  // A session already running on this handler is cancelled now, as for
+  // dispatchKeystrokes: left running, it typed on while the field was read.
+  active_typing_session_.reset();
+  const int request = ++typing_request_;
+  if (!read_back.value_or(false)) {
+    StartPaste(text, speed_multiplier.value_or(1.0),
+               follow_navigation.value_or(true), /*read_back=*/false,
+               std::move(callback), GlobalRenderFrameHostId(), nullptr);
+    return;
+  }
+  // browser: the field the paste goes into, read first: what it holds
+  // before.
+  ReadFocusedField(
+      0, GlobalRenderFrameHostId(), std::nullopt, 0, 0,
+      /*settle_for_text=*/false, nullptr,
+      base::BindOnce(&InputHandler::OnPasteFieldRead,
+                     weak_factory_.GetWeakPtr(), request, text,
+                     speed_multiplier.value_or(1.0),
+                     follow_navigation.value_or(true), std::move(callback)));
+}
