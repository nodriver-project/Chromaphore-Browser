+    if (blink::PresentsWindowsPlatform()) {
+      base::ReplaceSubstringsAfterOffset(&text16, 0, u"\r\n", u"\n");
+      base::ReplaceSubstringsAfterOffset(&text16, 0, u"\n", u"\r\n");
+    }
+#endif
+#if BUILDFLAG(IS_WIN)
+    // Line breaks as Chrome's own copies write them on Windows.
+    base::ReplaceSubstringsAfterOffset(&text16, 0, u"\r\n", u"\n");
+    base::ReplaceSubstringsAfterOffset(&text16, 0, u"\n", u"\r\n");
+#endif
+    ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+    writer.WriteText(text16);
