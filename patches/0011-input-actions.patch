+// The renderer's numbers are checked before any reaches the planner: a
+// non-finite one is "no usable geometry". A missing box reads as empty.
+bool FiniteBox(const blink::mojom::AgentElementBox* b) {
+  return !b || (std::isfinite(b->x) && std::isfinite(b->y) &&
+                std::isfinite(b->width) && std::isfinite(b->height));
+}
+
+bool FiniteSlot(const blink::mojom::AgentSlot* s) {
+  return !s || (FiniteBox(s->box.get()) && FiniteBox(s->layout_box.get()));
+}
+
+// Both found, in one list of two or more: their places compare.
+bool SameList(const blink::mojom::AgentSlot& a,
+              const blink::mojom::AgentSlot& b) {
+  return a.found && b.found && a.count >= 2 && a.count == b.count &&
+         a.list_name == b.list_name;
+}
+
+bool FiniteReading(const blink::mojom::AgentCarryReading* r) {
+  if (!r) {
+    return true;
+  }
+  for (const double v :
+       {r->aim_x, r->aim_y, r->need_x, r->need_y, r->calm_x, r->calm_y,
+        r->firm_x, r->firm_y, r->rest_x, r->rest_y, r->land_x, r->land_y,
+        r->wheel_x, r->wheel_y, r->window_x, r->window_y, r->box_x, r->box_y}) {
+    if (!std::isfinite(v)) {
+      return false;
+    }
+  }
+  return FiniteBox(r->box.get());
+}
+
+bool FiniteSurvey(const blink::mojom::AgentDragSurvey& s) {
+  if (!FiniteBox(s.viewport.get()) || !std::isfinite(s.device_scale_factor) ||
+      !std::isfinite(s.page_zoom) || !std::isfinite(s.frame_interval_ms) ||
+      !std::isfinite(s.value_x) || !std::isfinite(s.value_y) ||
+      !std::isfinite(s.value_reached)) {
+    return false;
+  }
+  for (const blink::mojom::AgentBandBoxPtr& band : s.bands) {
+    if (band &&
+        !(FiniteBox(band->border.get()) && FiniteBox(band->outer.get()) &&
+          FiniteBox(band->inner.get()) && FiniteBox(band->visible.get()) &&
+          FiniteBox(band->lib_inner.get()) && std::isfinite(band->scroll_x) &&
+          std::isfinite(band->scroll_y))) {
+      return false;
+    }
+  }
+  for (const blink::mojom::AgentFixedBoxPtr& fixed : s.fixed_boxes) {
+    if (fixed && !FiniteBox(fixed->box.get())) {
+      return false;
+    }
+  }
+  if (s.slider && (!FiniteBox(s.slider->thumb.get()) ||
+                   !FiniteBox(s.slider->track.get()))) {
+    return false;
+  }
+  return FiniteSlot(s.grab.get()) && FiniteSlot(s.target.get()) &&
+         FiniteReading(s.target_reading.get());
+}
+
+bool FiniteFrame(const blink::mojom::AgentDragFrame& f) {
+  if (!std::isfinite(f.time_ms)) {
+    return false;
+  }
+  for (const double v : f.offsets) {
+    if (!std::isfinite(v)) {
+      return false;
+    }
+  }
+  return FiniteSlot(f.target.get()) && FiniteSlot(f.grab.get());
+}
