+constexpr double kSlotOnFrom = 0.25;
+constexpr double kSlotOnTo = 0.75;
+constexpr double kSlotBeforeTo = 1.0 / 3;
+constexpr double kSlotAfterFrom = 2.0 / 3;
+constexpr double kSlotBeforeAt = 1.0 / 6;
+constexpr double kSlotAfterAt = 5.0 / 6;
