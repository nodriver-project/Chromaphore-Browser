+
+// browser: a TemporalSession's digits, typed as dispatchKeystrokes
+// types text, with its default timing and no typos.
+void InputHandler::TypeText(const std::string& text,
+                            double speed_multiplier,
+                            base::OnceCallback<void(bool ok)> done) {
+  base::OnceCallback<void(bool)> posted = PostedReply(std::move(done));
+  RenderWidgetHostImpl* widget_host = KeyboardTargetWidget();
+  if (text.empty() || !widget_host) {
+    std::move(posted).Run(false);
+    return;
+  }
+  // A typing call's field reading still on its way loses the keys to these.
+  ++typing_request_;
+  KeyboardTypingSession::Params params;
+  params.text = text;
+  params.speed_multiplier = speed_multiplier > 0 ? speed_multiplier : 1.0;
+  // As dispatchKeystrokes with no seed: the microsecond clock makes each
+  // schedule distinct.
+  params.seed = ClockSeed();
+  active_typing_session_ = std::make_unique<KeyboardTypingSession>(
+      widget_host->GetWeakPtr(), std::move(params),
+      base::BindOnce([](base::OnceCallback<void(bool)> reply, bool success,
+                        int typos_corrected) { std::move(reply).Run(success); },
+                     std::move(posted)));
+  active_typing_session_->Start();
+}
