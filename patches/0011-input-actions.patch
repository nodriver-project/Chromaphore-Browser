+// browser: a text an answer leaves out when it is empty.
+std::optional<std::string> OptionalText(const std::string& value) {
+  return value.empty() ? std::nullopt : std::optional<std::string>(value);
+}
+
+// A path intent by its protocol name; nullopt for any other.
+std::optional<PathIntent> ParsePathIntent(std::string_view name) {
+  if (name == "default") {
+    return PathIntent::kDefault;
+  }
+  if (name == "confirm") {
+    return PathIntent::kConfirm;
+  }
+  if (name == "navigate") {
+    return PathIntent::kNavigate;
+  }
+  if (name == "casual") {
+    return PathIntent::kCasual;
+  }
+  if (name == "precise") {
+    return PathIntent::kPrecise;
+  }
+  return std::nullopt;
+}
+
+// The refusal of an intent no path has.
+Response BadIntent() {
+  return Response::InvalidParams(
+      "'intent' must be default, confirm, navigate, casual or precise");
+}
+
+// browser: a move refused before a session.
+void FailMove(InputHandler::MoveCompletion completion, Response response) {
+  MoveResult result;
+  result.failure = std::move(response);
+  std::move(completion).Run(std::move(result));
+}
+
+// browser: Input.moveTo's answer, from a move's result.
+InputHandler::MoveCompletion AnswerMoveTo(
+    std::unique_ptr<Input::Backend::MoveToCallback> callback) {
+  return base::BindOnce(
+      [](std::unique_ptr<Input::Backend::MoveToCallback> callback,
+         MoveResult result) {
+        if (result.failure) {
+          callback->sendFailure(*result.failure);
+          return;
+        }
+        callback->sendSuccess(
+            result.outcome, result.x, result.y, OptionalText(result.hit),
+            OptionalText(result.hit_kind), OptionalText(result.reason),
+            result.corrections, result.duration_ms,
+            std::move(result.action_outcome));
+      },
+      std::move(callback));
+}
