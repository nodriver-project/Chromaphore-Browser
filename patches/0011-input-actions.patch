+bool DragSession::CanAsk() const {
+  return collector_.is_bound() && collector_.is_connected();
+}
+
+void DragSession::Ask(base::RepeatingCallback<void(uint64_t)> issue) {
+  reissue_ = std::move(issue);
+  reissued_ = false;
+  reissue_.Run(++ask_);
+  read_timer_.Start(FROM_HERE, kReadTimeout,
+                    base::BindOnce(&DragSession::OnReadTimeout, Weak()));
+}
+
+// The answer to the read under way (an older one is dropped).
+bool DragSession::Current(uint64_t ask) {
+  if (answered() || ask != ask_) {
+    return false;
+  }
+  read_timer_.Stop();
+  reissue_.Reset();
+  return true;
+}
+
+void DragSession::DropReads() {
+  ++ask_;
+  read_timer_.Stop();
+  reissue_.Reset();
+}
+
+void DragSession::OnReadTimeout() {
+  if (answered() || !reissue_) {
+    return;
+  }
+  if (reissued_) {
+    if (ending_) {
+      Answer(end_outcome_, end_reason_);
+      return;
+    }
+    Fail("timeout", "the page did not answer a read in time");
+    return;
+  }
+  reissued_ = true;
+  reissue_.Run(++ask_);
+  read_timer_.Start(FROM_HERE, kReadTimeout,
+                    base::BindOnce(&DragSession::OnReadTimeout, Weak()));
+}
