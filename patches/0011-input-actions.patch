+      InnermostAt(*this, parents_, grab_chain_, binder_, p, Rule::kOwner);
+  return owner == kNoBox ? 0 : bands_[owner].id;
+}
+
+int DragTerrain::BandAt(const PlannerPoint& p) const {
+  return BandHitAt(*this, parents_, grab_chain_, binder_, p).id;
+}
+
+int DragTerrain::BudgetBandAt(const PlannerPoint& p) const {
+  return BandWithin(p, kBudgetMargin);
+}
+
+int DragTerrain::BandWithin(const PlannerPoint& p, double margin) const {
+  const int band = BandAt(p);
+  if (band != 0 || !IsFinite(p) || !(margin > 0)) {
+    return band;
+  }
+  const double side = margin;
+  const double slant = margin / std::numbers::sqrt2;
+  const std::array<PlannerPoint, 8> around = {{{side, 0.0},
+                                               {-side, 0.0},
+                                               {0.0, side},
+                                               {0.0, -side},
+                                               {slant, slant},
+                                               {slant, -slant},
+                                               {-slant, slant},
+                                               {-slant, -slant}}};
+  for (const PlannerPoint& step : around) {
+    const int beside = BandAt(PlannerPoint{p.x + step.x, p.y + step.y});
+    if (beside != 0) {
+      return beside;
+    }
+  }
+  return 0;
+}
+
+bool DragTerrain::Calm(const PlannerPoint& p,
+                       double clearance,
+                       PlannerPoint item_offset) const {
+  return CalmIn(*this, BuildEdges(*this), p, clearance,
+                FiniteOffset(item_offset));
+}
+
+std::optional<PlannerPoint> DragTerrain::NearestCalm(
+    const PlannerPoint& p,
+    double max_distance,
+    PlannerPoint item_offset) const {
+  if (!IsFinite(p)) {
+    return std::nullopt;
+  }
+  const Edges edges = BuildEdges(*this);
+  const PlannerPoint offset = FiniteOffset(item_offset);
+  if (CalmIn(*this, edges, p, kClearance, offset)) {
+    return p;
+  }
+  const double limit = std::isnan(max_distance)
+                           ? 0.0
+                           : std::clamp(max_distance, 0.0, kMaxSearchRadius);
+  // The first ring with a calm candidate answers. Each calm candidate is
+  // pulled in toward p along its own ray, a px at a time while it stays
+  // calm and short of the previous ring; the one that ends nearest p wins,
+  // the first in angle order on a tie.
+  double previous = 0;
+  for (const double radius : RingRadii(limit)) {
+    const int count =
+        kRingCandidates + kRingCandidatesPerPx * static_cast<int>(radius);
+    const int pulls = static_cast<int>(std::ceil(radius - previous)) - 1;
+    std::optional<PlannerPoint> best;
+    double best_reach = radius;
+    for (int k = 0; k < count; ++k) {
+      const double angle = 2 * std::numbers::pi * k / count;
+      const double ux = std::cos(angle);
+      const double uy = std::sin(angle);
+      PlannerPoint candidate{p.x + radius * ux, p.y + radius * uy};
+      if (!CalmIn(*this, edges, candidate, kClearance, offset)) {
+        continue;
+      }
+      double reach = radius;
+      for (int pull = 1; pull <= pulls; ++pull) {
+        const PlannerPoint closer{p.x + (radius - pull) * ux,
+                                  p.y + (radius - pull) * uy};
+        if (!CalmIn(*this, edges, closer, kClearance, offset)) {
+          break;
+        }
+        candidate = closer;
+        reach = radius - pull;
+      }
+      if (!best || reach < best_reach) {
+        best = candidate;
+        best_reach = reach;
+      }
+    }
+    if (best) {
+      return best;
+    }
+    previous = radius;
+  }
+  return std::nullopt;
+}
+
+DragTerrain::CorridorRoom DragTerrain::Corridor(const PlannerPoint& from,
+                                                const PlannerPoint& to) const {
+  // A non-finite chord: no room, the safe answer. A degenerate one:
+  // unbounded, LegConstraints' -1.
+  double plus = 0;
+  double minus = 0;
+  const double dx = to.x - from.x;
+  const double dy = to.y - from.y;
+  const double length = std::sqrt(dx * dx + dy * dy);
+  const bool known = IsFinite(from) && IsFinite(to) && std::isfinite(length);
+  if (known && length < 1) {
+    plus = -1;
+    minus = -1;
+  } else if (known) {
+    const Edges edges = BuildEdges(*this);
+    // LegConstraints' perp: (dy, -dx) / |d|.
+    const PlannerPoint perp{dy / length, -dx / length};
+    const PlannerPoint opposite{-perp.x, -perp.y};
+    const double wanted = std::ceil(length / kCorridorStep);
+    const int intervals =
+        static_cast<int>(std::clamp(wanted, 1.0, kMaxCorridorIntervals));
+    std::vector<PlannerPoint> samples;
+    samples.reserve(static_cast<size_t>(intervals) + 1);
+    for (int k = 0; k <= intervals; ++k) {
+      const double t = static_cast<double>(k) / static_cast<double>(intervals);
+      samples.push_back(PlannerPoint{from.x + dx * t, from.y + dy * t});
+    }
+    // A band side or a scrollbar the chord's own samples are in is crossed:
+    // the planner budgets it, so its edges are not walls. Bands per side: a
+    // chord through a box's left band leaves its top band a wall.
+    CrossedSides crossed_sides;
+    std::vector<int> crossed_bars;
+    for (const PlannerPoint& q : samples) {
+      MarkCrossed(BandHitAt(*this, parents_, grab_chain_, binder_, q),
+                  &crossed_sides);
+      const int bar = ScrollbarAt(*this, q);
+      if (bar != 0 && !std::ranges::contains(crossed_bars, bar)) {
+        crossed_bars.push_back(bar);
+      }
+    }
+    // A wall: outside the viewport, in a band side the chord does not
+    // cross, or over a scrollbar the chord does not cross.
+    const auto is_wall = [this, &crossed_sides,
+                          &crossed_bars](const PlannerPoint& m) {
+      if (!viewport_.Contains(m)) {
+        return true;
+      }
+      const BandHit hit = BandHitAt(*this, parents_, grab_chain_, binder_, m);
+      if (hit.id != 0 && !AllCrossed(hit, crossed_sides)) {
+        return true;
+      }
+      const int bar = ScrollbarAt(*this, m);
+      return bar != 0 && !std::ranges::contains(crossed_bars, bar);
+    };
+    // The least room per side; a ray need not look past the least so far.
+    plus = kCorridorCap;
+    minus = kCorridorCap;
+    for (const PlannerPoint& q : samples) {
+      plus = std::min(plus, RayRoom(*this, edges, q, perp, plus, is_wall));
+      minus =
+          std::min(minus, RayRoom(*this, edges, q, opposite, minus, is_wall));
+    }
+  }
+  return CorridorRoom{plus, minus};
+}
+
+LegConstraints DragTerrain::Constraints(const PlannerPoint& from,
+                                        const PlannerPoint& to,
+                                        double band_budget_ms,
+                                        PlannerPoint item_offset) const {
+  LegConstraints c;
+  c.band_of =
+      base::BindRepeating(&BandForLeg, *this, FiniteOffset(item_offset));
+  const CorridorRoom room = Corridor(from, to);
+  c.free_plus = room.free_plus;
+  c.free_minus = room.free_minus;
+  if (std::isfinite(band_budget_ms)) {
+    c.band_budget_ms = band_budget_ms;
+  }
+  return c;
+}
+
+namespace {
+
+// BoundLegToView: the least room the view gives a side, the planner's
+// corridor margin (human_path_planner.cc kCorridorMargin): with less on
+// either side it plans the leg dead straight, and at it nothing bows past
+// the chord toward that side and the bow turns to the other. Room past
+// kViewNoRoom is none to bound.
+constexpr double kViewRoomFloorPx = 5;
+constexpr double kViewNoRoom = 1e9;
+
+// The corridor a convex `rect` leaves a leg's chord either side: the room is
+// least at one of the chord's ends. Room `c` already gives only shrinks.
+void CorridorWithin(const PlannerPoint& from,
+                    const PlannerPoint& to,
+                    const DragRect& rect,
+                    LegConstraints* c) {
+  const double dx = to.x - from.x;
+  const double dy = to.y - from.y;
+  const double length = std::hypot(dx, dy);
+  // The room from `q` toward the unit normal (nx, ny) before the rect's
+  // edge.
+  const auto room = [&rect](double nx, double ny, const PlannerPoint& q) {
+    double least = kViewNoRoom;
+    if (nx > 1e-6) {
+      least = std::min(least, (rect.right() - q.x) / nx);
+    } else if (nx < -1e-6) {
+      least = std::min(least, (q.x - rect.x) / -nx);
+    }
+    if (ny > 1e-6) {
+      least = std::min(least, (rect.bottom() - q.y) / ny);
+    } else if (ny < -1e-6) {
+      least = std::min(least, (q.y - rect.y) / -ny);
+    }
+    return std::max(0.0, least);
+  };
+  const double px = dy / length;
+  const double py = -dx / length;
+  const double plus = std::max(kViewRoomFloorPx,
+                               std::min(room(px, py, from), room(px, py, to)));
+  const double minus = std::max(
+      kViewRoomFloorPx, std::min(room(-px, -py, from), room(-px, -py, to)));
+  if (plus < kViewNoRoom) {
+    c->free_plus = c->free_plus < 0 ? plus : std::min(c->free_plus, plus);
+  }
+  if (minus < kViewNoRoom) {
+    c->free_minus = c->free_minus < 0 ? minus : std::min(c->free_minus, minus);
+  }
+}
+
+}  // namespace
+
+// The view is convex, so the room toward a side is least at one of the
+// chord's ends.
+void BoundLegToView(const PlannerPoint& from,
+                    const PlannerPoint& to,
+                    const DragRect& view_in,
+                    LegConstraints* c) {
+  const DragRect view =
+      view_in.Inset(DragTerrain::kViewMargin, DragTerrain::kViewMargin);
+  if (view.IsEmpty() || !(std::hypot(to.x - from.x, to.y - from.y) >= 1)) {
+    return;
+  }
+  CorridorWithin(from, to, view, c);
+  // Nor past its end out of the view: with no hold region of its own and
+  // its end in the view, the view is its hold region (the forward misses
+  // and the brake shrink until it fits; a leg from off the view's rim is
+  // held from where it enters). A route stroke's timing leg, on a virtual
+  // chord wholly off the view, gets none.
+  if (!c->hold.has_value() && view.Contains(to)) {
+    c->hold = PlannerRect{view.x, view.y, view.w, view.h};
+  }
+}
+
+// A hover region is a rectangle the leg's ends are both in: its own
+// corridor, and it as the hold and the keep, in place of the view's hold --
+// it lies inside the view.
+void BoundLegToRegion(const PlannerPoint& from,
+                      const PlannerPoint& to,
+                      const PlannerRect& region,
+                      LegConstraints* c) {
+  const DragRect rect{region.x, region.y, region.w, region.h};
+  if (rect.IsEmpty() || !(std::hypot(to.x - from.x, to.y - from.y) >= 1)) {
+    return;
+  }
+  CorridorWithin(from, to, rect, c);
+  c->hold = region;
+  c->keep = region;
+}
+
+namespace {
+
+// The hand slows where a route curves more than this (1/px), by the
+// two-thirds power law.
+constexpr double kCurveRefCurvature = 1.0 / 150;
+// A corner's arc reaches at most this share of each stretch beside it.
+constexpr double kMaxCornerShare = 0.45;
+
+}  // namespace
+
+// The polyline `points` with each inner corner rounded by a circular arc of
+// radius radii[i] -- held to what the stretches either side allow, 45 % of
+// each at most -- sampled every px or finer.
+std::vector<RouteSample> RoundedRoute(const std::vector<PlannerPoint>& points,
+                                      const std::vector<double>& radii) {
+  std::vector<RouteSample> route;
+  if (points.empty() || radii.size() != points.size()) {
+    return route;
+  }
+  route.push_back(RouteSample{points[0], 0, 0});
+  const auto add = [&route](const PlannerPoint& p, double curvature) {
+    const double step = Distance(route.back().p, p);
+    if (step > 0) {
+      route.push_back(RouteSample{p, route.back().s + step, curvature});
+    }
+  };
+  const auto line_to = [&route, &add](const PlannerPoint& end) {
+    const PlannerPoint start = route.back().p;
+    const int steps =
+        std::max(1, static_cast<int>(std::ceil(Distance(start, end))));
+    for (int k = 1; k <= steps; ++k) {
+      const double f = static_cast<double>(k) / steps;
+      add(PlannerPoint{start.x + (end.x - start.x) * f,
+                       start.y + (end.y - start.y) * f},
+          0);
+    }
+  };
+  for (size_t i = 1; i < points.size(); ++i) {
+    const PlannerPoint& at = points[i];
+    if (i + 1 == points.size()) {
+      line_to(at);
+      break;
+    }
+    const PlannerPoint& prev = points[i - 1];
+    const PlannerPoint& next = points[i + 1];
+    const double in = Distance(prev, at);
+    const double on = Distance(at, next);
+    if (in < 1e-6 || on < 1e-6) {
+      line_to(at);
+      continue;
+    }
+    const PlannerPoint a{(at.x - prev.x) / in, (at.y - prev.y) / in};
+    const PlannerPoint b{(next.x - at.x) / on, (next.y - at.y) / on};
+    const double turn = std::acos(std::clamp(a.x * b.x + a.y * b.y, -1.0, 1.0));
+    const double half_tan = std::tan(turn / 2);
+    if (turn < 1e-3 || !std::isfinite(half_tan) || !(half_tan > 0)) {
+      line_to(at);
+      continue;
+    }
+    double r = std::max(0.0, radii[i]);
+    double reach = r * half_tan;
+    const double most = kMaxCornerShare * std::min(in, on);
+    if (reach > most) {
+      reach = most;
+      r = reach / half_tan;
+    }
+    if (r < 0.5) {
+      line_to(at);
+      continue;
+    }
+    const PlannerPoint start{at.x - a.x * reach, at.y - a.y * reach};
+    line_to(start);
+    // The centre, on the inside of the turn.
+    const double cross = a.x * b.y - a.y * b.x;
+    const PlannerPoint inward =
+        cross > 0 ? PlannerPoint{-a.y, a.x} : PlannerPoint{a.y, -a.x};
+    const PlannerPoint centre{start.x + inward.x * r, start.y + inward.y * r};
+    const double from_angle =
+        std::atan2(start.y - centre.y, start.x - centre.x);
+    const double sweep = cross > 0 ? turn : -turn;
+    const int steps = std::max(1, static_cast<int>(std::ceil(r * turn)));
+    for (int k = 1; k <= steps; ++k) {
+      const double angle = from_angle + sweep * k / steps;
+      add(PlannerPoint{centre.x + r * std::cos(angle),
+                       centre.y + r * std::sin(angle)},
+          1 / r);
+    }
+  }
+  return route;
+}
+
+std::vector<PlannedPoint> LayAlongRoute(const std::vector<RouteSample>& route,
+                                        const std::vector<PlannedPoint>& plain,
+                                        const PlannerPoint& origin,
+                                        const PlannerPoint& dir,
+                                        const PlannerPoint& to,
+                                        double tick_ms,
+                                        double smooth_px,
+                                        double min_pace) {
+  if (route.size() < 2 || plain.empty()) {
+    return {};
+  }
+  const double length = route.back().s;
+  // Laid along the route: how far along the chord each point is, as far
+  // along the route (an overshoot past either end goes on along the
+  // route's own heading there); its sideways wander off the chord, off the
+  // route.
+  const auto sample_at = [&route](double s) {
+    const auto it = std::lower_bound(
+        route.begin(), route.end(), s,
+        [](const RouteSample& r, double v) { return r.s < v; });
+    return std::clamp<size_t>(static_cast<size_t>(it - route.begin()), 1,
+                              route.size() - 1);
+  };
+  std::vector<PlannedPoint> laid;
+  std::vector<double> along;
+  laid.reserve(plain.size());
+  along.reserve(plain.size());
+  for (const PlannedPoint& point : plain) {
+    const double ox = point.p.x - origin.x;
+    const double oy = point.p.y - origin.y;
+    const double raw = ox * dir.x + oy * dir.y;
+    const double s = std::clamp(raw, 0.0, length);
+    const double past = raw - s;
+    const double side = oy * dir.x - ox * dir.y;
+    const size_t k = sample_at(s);
+    const RouteSample& a = route[k - 1];
+    const RouteSample& b = route[k];
+    const double span = b.s - a.s;
+    const double f = span > 0 ? std::clamp((s - a.s) / span, 0.0, 1.0) : 0;
+    const PlannerPoint tangent =
+        span > 0 ? PlannerPoint{(b.p.x - a.p.x) / span, (b.p.y - a.p.y) / span}
+                 : dir;
+    PlannedPoint q = point;
+    q.p = PlannerPoint{
+        a.p.x + (b.p.x - a.p.x) * f + tangent.x * past - tangent.y * side,
+        a.p.y + (b.p.y - a.p.y) * f + tangent.y * past + tangent.x * side};
+    laid.push_back(q);
+    along.push_back(s);
+  }
+  // The two-thirds power law: a pace per route sample, smoothed.
+  std::vector<double> pace(route.size(), 1);
+  for (size_t j = 0; j < route.size(); ++j) {
+    if (route[j].curvature > kCurveRefCurvature) {
+      pace[j] = std::clamp(std::cbrt(kCurveRefCurvature / route[j].curvature),
+                           min_pace, 1.0);
+    }
+  }
+  std::vector<double> smooth(route.size(), 1);
+  size_t lo = 0;
+  size_t hi = 0;
+  double sum = 0;
+  for (size_t j = 0; j < route.size(); ++j) {
+    while (hi < route.size() && route[hi].s <= route[j].s + smooth_px) {
+      sum += pace[hi];
+      ++hi;
+    }
+    while (route[lo].s < route[j].s - smooth_px) {
+      sum -= pace[lo];
+      ++lo;
+    }
+    smooth[j] = sum / static_cast<double>(hi - lo);
+  }
+  // Each step's time stretched by the pace where it goes.
+  std::vector<double> times(laid.size(), 0);
+  for (size_t i = 1; i < laid.size(); ++i) {
+    const double p = std::max(min_pace, smooth[sample_at(along[i])]);
+    times[i] = times[i - 1] + (laid[i].t_ms - laid[i - 1].t_ms) / p;
+  }
+  // Back on the polling grid; the last tick at `to`.
+  const double tick = tick_ms > 0 ? tick_ms : 1;
+  const size_t ticks =
+      static_cast<size_t>(std::ceil(times.back() / tick - 1e-9));
+  std::vector<PlannedPoint> stroke;
+  stroke.reserve(ticks + 1);
+  size_t i = 0;
+  for (size_t k = 0; k <= ticks; ++k) {
+    PlannedPoint q;
+    q.t_ms = static_cast<double>(k) * tick;
+    if (k == ticks || laid.size() < 2) {
+      q.p = k == ticks ? to : laid.back().p;
+    } else {
+      while (i + 2 < laid.size() && times[i + 1] < q.t_ms) {
+        ++i;
+      }
+      const double span = times[i + 1] - times[i];
+      const double f =
+          span > 0 ? std::clamp((q.t_ms - times[i]) / span, 0.0, 1.0) : 0;
+      q.p = PlannerPoint{laid[i].p.x + (laid[i + 1].p.x - laid[i].p.x) * f,
+                         laid[i].p.y + (laid[i + 1].p.y - laid[i].p.y) * f};
+    }
+    stroke.push_back(q);
+  }
+  return stroke;
+}
+
+}  // namespace content
