+ActionOutcomeWatch::Action::~Action() = default;
+
+// static
+ActionOutcomeWatch* ActionOutcomeWatch::ForSession(DevToolsSession* session,
+                                                   bool make) {
+  if (!session) {
+    return nullptr;
+  }
+  auto it = session->handlers().find(std::string(Input::Metainfo::domainName));
+  if (it == session->handlers().end()) {
+    return nullptr;
+  }
+  InputHandler* input = static_cast<InputHandler*>(it->second.get());
+  return make ? input->OutcomeWatch() : input->outcome_watch();
+}
+
+// static
+void ActionOutcomeWatch::DisarmFor(DevToolsSession* session) {
+  if (ActionOutcomeWatch* watch = ForSession(session, /*make=*/false)) {
+    watch->Disarm();
+  }
+}
+
+// static
+void ActionOutcomeWatch::Reply(ActionOutcomeWatch* watch,
+                               int action_id,
+                               ReplyCallback reply,
+                               bool wait) {
+  if (!watch || action_id == 0) {
+    std::move(reply).Run(nullptr);
+    return;
+  }
+  watch->Settle(action_id, std::move(reply), wait);
+}
+
+ActionOutcomeWatch::ActionOutcomeWatch(LateCallback on_late)
+    : on_late_(std::move(on_late)),
+      settle_arm_(std::make_unique<SettleArm>()) {}
+
+ActionOutcomeWatch::~ActionOutcomeWatch() {
+  EndCurrent(/*destroying=*/true);
+  StopWatchingWidgets();
+}
+
+void ActionOutcomeWatch::SetWebContents(WebContents* contents) {
+  if (!contents || contents == web_contents()) {
+    return;
+  }
+  EndCurrent(/*destroying=*/false);
+  StopWatchingWidgets();
+  under_way_.clear();
+  // The settle armed on the tab before is over.
+  settle_arm_->Clear();
+  Observe(contents);
+  // A load the main frame has under way already, as the first action will
+  // find it.
+  FrameTreeNode* root =
+      static_cast<WebContentsImpl*>(contents)->GetPrimaryFrameTree().root();
+  NavigationRequest* request = root->navigation_request();
+  if (request && !request->IsSameDocument()) {
+    RenderFrameHostImpl* frame = root->current_frame_host();
+    under_way_[request->GetNavigationId()] = UnderWay{
+        request->GetURL(), request->NavigationStart(),
+        frame ? frame->devtools_frame_token().ToString() : std::string()};
+  }
+}
+
+// ================================================================ arming
+
+ActionOutcomeWatch::Action& ActionOutcomeWatch::Begin(Kind kind,
+                                                      bool follow_navigation) {
+  EndCurrent(/*destroying=*/false);
+  StopWatchingWidgets();
+  action_ = std::make_unique<Action>();
+  Action& action = *action_;
+  action.id = NextActionId();
+  action.kind = kind;
+  action.follow_navigation = follow_navigation;
+  action.armed_at = Now();
+  // The settle is armed at the same moment with the same id, T the
+  // arm's time: before the press is queued, the first key sent, the pick
+  // made or the drop done. Messages only; nothing here waits for a renderer.
+  settle_arm_->Arm(web_contents(), action.id, action.armed_at, /*look=*/false);
+  // The page was still loading when the agent acted: its main frame's
+  // navigations under way are the action's too, marked so.
+  for (const auto& [navigation_id, under_way] : under_way_) {
+    Item item;
+    item.type = Item::Type::kNavigation;
+    item.at = under_way.started;
+    item.navigation_id = navigation_id;
+    item.state = "started";
+    item.url = under_way.url;
+    item.main_frame = true;
+    item.before_action = true;
+    item.frame_id = under_way.frame_id;
+    AddItem(action, std::move(item));
+  }
+  return action;
+}
+
+int ActionOutcomeWatch::ArmMouse(EndAction end,
+                                 int click_count,
+                                 bool follow_navigation) {
+  if (!web_contents() || end == EndAction::kNone) {
+    return 0;
+  }
+  Action& action = Begin(Kind::kMouse, follow_navigation);
+  action.awaited = end == EndAction::kPress ? Type::kMouseDown : Type::kMouseUp;
+  action.count = end == EndAction::kClick ? std::max(1, click_count) : 1;
+  // The press may be routed to any of the tab's widgets: an out-of-process
+  // frame's, an open popup's.
+  WatchTabWidgets();
+  return action.id;
+}
+
+int ActionOutcomeWatch::ArmKeys(RenderWidgetHost* widget,
+                                bool follow_navigation) {
+  WebContentsImpl* contents = static_cast<WebContentsImpl*>(web_contents());
+  if (!contents) {
+    return 0;
+  }
+  Action& action = Begin(Kind::kKeys, follow_navigation);
+  action.awaited = Type::kKeyUp;
+  // Keys act in the focused frame: it, and the frames holding it below the
+  // main frame, are the action's.
+  for (RenderFrameHostImpl* frame = contents->GetFocusedFrame();
+       frame && frame->GetParent(); frame = frame->GetParent()) {
+    action.focus_chain.push_back(
+        frame->frame_tree_node()->frame_tree_node_id());
+  }
+  WatchWidget(widget);
+  return action.id;
+}
+
+int ActionOutcomeWatch::ArmSelect(GlobalRenderFrameHostId local_root,
+                                  bool follow_navigation) {
+  if (!web_contents()) {
+    return 0;
+  }
+  Action& action = Begin(Kind::kSelect, follow_navigation);
+  action.local_root = local_root;
+  // The pick is the call itself.
+  action.dispatched_at = action.armed_at;
+  return action.id;
+}
+
+int ActionOutcomeWatch::ArmWheel(GlobalRenderFrameHostId local_root,
+                                 bool follow_navigation) {
+  if (!web_contents()) {
+    return 0;
+  }
+  Action& action = Begin(Kind::kWheel, follow_navigation);
+  action.local_root = local_root;
+  // The first notch goes out with the arm.
+  action.dispatched_at = action.armed_at;
+  return action.id;
+}
+
+int ActionOutcomeWatch::ArmDrop(bool follow_navigation) {
+  if (!web_contents()) {
+    return 0;
+  }
+  return Begin(Kind::kDrop, follow_navigation).id;
+}
+
+// The settle alone, for an action that is not input. Its id comes
+// from the same counter, so it never names an input action. browser: or
+// for a look (`look`), which the renderers do not take for an action.
+int ActionOutcomeWatch::ArmSettle(bool look) {
+  if (!web_contents()) {
+    return 0;
+  }
+  const int arm_id = NextActionId();
+  settle_arm_->Arm(web_contents(), arm_id, Now(), look);
+  return arm_id;
+}
+
+SettleArm& ActionOutcomeWatch::settle_arm() {
+  return *settle_arm_;
+}
+
+base::OnceClosure ActionOutcomeWatch::DropSent(RenderWidgetHost* target) {
+  Action* action = action_.get();
+  if (!action || action->kind != Kind::kDrop || action->answered ||
+      !action->dispatched_at.is_null()) {
+    return base::DoNothing();
+  }
+  action->dispatched_at = Now();
+  if (target) {
+    action->local_root = LocalRootOf(*target);
+  }
+  return base::BindOnce(&ActionOutcomeWatch::OnDropAnswered,
+                        weak_factory_.GetWeakPtr(), action->id);
+}
+
+void ActionOutcomeWatch::OnDropAnswered(int action_id) {
+  if (Action* action = Unanswered(action_id)) {
+    action->replied = true;
+    MaybeHandled(*action);
+  }
+}
+
+// ========================================================= the answer
+
+void ActionOutcomeWatch::Settle(int action_id, ReplyCallback reply, bool wait) {
+  Action* action = Unanswered(action_id);
+  if (!action || action->reply) {
+    std::move(reply).Run(TakeSuperseded(action_id));
+    return;
+  }
+  if (action->kind == Kind::kSelect || action->kind == Kind::kWheel) {
+    // Its reply is in: the page has run the pick's input and change, or the
+    // scroll has come to rest.
+    action->replied = true;
+    action->handled = true;
+  }
+  if (!wait) {
+    std::move(reply).Run(Answered(*action));
+    return;
+  }
+  action->reply = std::move(reply);
+  if (Handled(*action)) {
+    action->handled = true;
+    StartGrace(*action);
+    return;
+  }
+  action->step = Step::kHandled;
+  action->timer.Start(FROM_HERE, kHandledCap,
+                      base::BindOnce(&ActionOutcomeWatch::OnHandledCap,
+                                     base::Unretained(this)));
+}
+
+void ActionOutcomeWatch::Abandon(int action_id) {
+  // Its settle too, if it is still the one armed.
+  settle_arm_->Drop(action_id);
+  std::erase_if(superseded_, [action_id](const auto& kept) {
+    return kept.first == action_id;
+  });
+  Action* action = Unanswered(action_id);
+  if (!action || action->reply) {
+    return;
+  }
+  StopWatchingWidgets();
+  action_.reset();
+}
+
+void ActionOutcomeWatch::Disarm() {
+  EndCurrent(/*destroying=*/false);
+}
+
+void ActionOutcomeWatch::EndCurrent(bool destroying) {
+  std::unique_ptr<Action> action = std::move(action_);
+  if (!action) {
+    return;
+  }
+  StopWatchingWidgets();
+  action->in_flight.clear();
+  action->timer.Stop();
+  action->same_document_timer.Stop();
+  if (action->answered) {
+    // A same-document navigation held back goes out before the action's
+    // late events stop.
+    if (!destroying && action->held_same_document &&
+        action->late_sent < kMaxLateEvents) {
+      ++action->late_sent;
+      on_late_.Run(action->id, std::move(action->held_same_document));
+    }
+    return;
+  }
+  std::unique_ptr<Page::ActionOutcome> outcome = Answered(*action);
+  if (action->reply) {
+    // Its answer was waiting: it goes with what is known.
+    std::move(action->reply).Run(std::move(outcome));
+    return;
+  }
+  // Not yet settled by its command (it still plays out): kept for it.
+  superseded_.emplace_back(action->id, std::move(outcome));
+  if (superseded_.size() > kMaxSuperseded) {
+    superseded_.erase(superseded_.begin());
+  }
+}
+
+ActionOutcomeWatch::Action* ActionOutcomeWatch::Unanswered(int action_id) {
+  return action_ && action_->id == action_id && !action_->answered
+             ? action_.get()
+             : nullptr;
+}
+
+bool ActionOutcomeWatch::Handled(const Action& action) const {
+  // A cross-document navigation the action started: the page acted on it,
+  // whatever became of the rest of its events -- an Enter that submits a form
+  // swaps the renderer before its keyup goes out.
+  if (std::ranges::any_of(action.items, [](const Item& item) {
+        return item.type == Item::Type::kNavigation && !item.same_document &&
+               !item.before_action;
+      })) {
+    return true;
+  }
+  switch (action.kind) {
+    case Kind::kMouse:
+      return action.in_flight.empty() && action.acked >= action.count;
+    case Kind::kKeys:
+      // Every keyup sent has been answered for (the last among them), and
+      // one was.
+      return action.in_flight.empty() && action.acked >= 1;
+    case Kind::kSelect:
+    case Kind::kDrop:
+    case Kind::kWheel:
+      return action.replied;
+  }
+  NOTREACHED();
+}
+
+void ActionOutcomeWatch::MaybeHandled(Action& action) {
+  if (!Handled(action)) {
+    return;
+  }
+  action.handled = true;
+  if (action.reply && action.step == Step::kHandled) {
+    action.timer.Stop();
+    StartGrace(action);
+  }
+}
+
+// At the cap the answer says handled: false; acks later than this are not
+// counted.
+void ActionOutcomeWatch::OnHandledCap() {
+  if (action_ && action_->reply && action_->step == Step::kHandled) {
+    StartGrace(*action_);
+  }
+}
+
+void ActionOutcomeWatch::StartGrace(Action& action) {
+  StopWatchingWidgets();
+  action.step = Step::kGrace;
+  action.timer.Start(
+      FROM_HERE, kGrace,
+      base::BindOnce(&ActionOutcomeWatch::OnGraceOver, base::Unretained(this)));
+}
+
+void ActionOutcomeWatch::OnGraceOver() {
+  Action* action = action_.get();
+  if (!action || !action->reply) {
+    return;
+  }
+  if (action->follow_navigation && Following(*action)) {
+    action->step = Step::kFollow;
+    action->timer.Start(FROM_HERE, kCommitCap,
+                        base::BindOnce(&ActionOutcomeWatch::OnCommitCap,
+                                       base::Unretained(this)));
+    return;
+  }
+  SendAnswer(*action);
+}
+
+void ActionOutcomeWatch::OnCommitCap() {
+  if (action_ && action_->reply) {
+    SendAnswer(*action_);
+  }
+}
+
+// A navigation already under way at the arm is not followed: it is reported,
+// and its end comes late.
+bool ActionOutcomeWatch::Following(const Action& action) const {
+  return std::ranges::any_of(action.items, [](const Item& item) {
+    return item.type == Item::Type::kNavigation && !item.same_document &&
+           !item.before_action && !item.finished;
+  });
+}
+
+// One followed has ended; another started meanwhile (a client redirect) is
+// followed on, within the same cap.
+void ActionOutcomeWatch::MaybeFollowed(Action& action) {
+  if (action.reply && action.step == Step::kFollow && !Following(action)) {
+    action.timer.Stop();
+    SendAnswer(action);
+  }
+}
+
+std::unique_ptr<Page::ActionOutcome> ActionOutcomeWatch::Answered(
+    Action& action) {
+  action.timer.Stop();
+  action.step = Step::kNone;
+  StopWatchingWidgets();
+  const base::TimeTicks zero =
+      action.dispatched_at.is_null() ? action.armed_at : action.dispatched_at;
+  auto events = std::make_unique<Array<Page::ActionEvent>>();
+  for (const Item& item : action.items) {
+    // A tab closed since it opened is not reported.
+    if (item.type == Item::Type::kNewTab && !item.tab) {
+      continue;
+    }
+    events->push_back(ToEvent(action, item));
+  }
+  std::unique_ptr<Page::ActionOutcome> outcome =
+      Page::ActionOutcome::Create()
+          .SetActionId(action.id)
+          .SetHandled(action.handled)
+          .SetWaitedMs((Now() - zero).InMillisecondsF())
+          .SetEvents(std::move(events))
+          .Build();
+  action.answered = true;
+  // What is still under way is reported, late, as it ends.
+  for (Item& item : action.items) {
+    if (item.type == Item::Type::kNavigation && !item.finished) {
+      const int64_t navigation_id = item.navigation_id;
+      action.late_navigations[navigation_id] = std::move(item);
+    }
+  }
+  action.items.clear();
+  return outcome;
+}
+
+void ActionOutcomeWatch::SendAnswer(Action& action) {
+  ReplyCallback reply = std::move(action.reply);
+  std::unique_ptr<Page::ActionOutcome> outcome = Answered(action);
+  if (reply) {
+    std::move(reply).Run(std::move(outcome));
+  }
+}
+
+std::unique_ptr<Page::ActionOutcome> ActionOutcomeWatch::TakeSuperseded(
+    int action_id) {
+  auto it = std::ranges::find_if(superseded_, [action_id](const auto& kept) {
+    return kept.first == action_id;
+  });
+  if (it == superseded_.end()) {
+    return nullptr;
+  }
+  std::unique_ptr<Page::ActionOutcome> outcome = std::move(it->second);
+  superseded_.erase(it);
+  return outcome;
+}
+
+// ========================================================= navigations
+
+void ActionOutcomeWatch::DidStartNavigation(NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+    under_way_[handle->GetNavigationId()] =
+        UnderWay{handle->GetURL(), Now(), FrameIdOf(handle)};
+  }
+  Action* action = action_.get();
+  // Only what the page started: the browser's own -- an error page's
+  // auto-reload (NetErrorAutoReloader), a crashed tab's reload -- is no
+  // action's. A history navigation is the page's still when the browser
+  // starts it again: a history.back() whose back-forward cache entry was
+  // evicted as it was restored is restarted with no initiator
+  // (FrameTreeNode::RestartBackForwardCachedNavigationImpl). One already
+  // under way at the arm is reported whatever started it (Begin).
+  const bool page_started =
+      handle->IsRendererInitiated() ||
+      (handle->GetPageTransition() & ui::PAGE_TRANSITION_FORWARD_BACK) != 0;
+  if (!action || !page_started || !Reportable(*action, handle)) {
+    return;
+  }
+  Item item = NavigationItem(handle);
+  if (!action->answered) {
+    AddItem(*action, std::move(item));
+    // A cross-document start ends a wait for the ack.
+    MaybeHandled(*action);
+    return;
+  }
+  // After the answer: a cross-document start is an event of its own; a
+  // same-document navigation starts and ends at once, and is reported once,
+  // at its end.
+  std::unique_ptr<Page::ActionEvent> event =
+      item.same_document ? nullptr : ToEvent(*action, item);
+  const int64_t navigation_id = item.navigation_id;
+  action->late_navigations[navigation_id] = std::move(item);
+  if (event) {
+    SendLate(*action, std::move(event));
+  }
+}
+
+void ActionOutcomeWatch::DidRedirectNavigation(NavigationHandle* handle) {
+  const int64_t navigation_id = handle->GetNavigationId();
+  auto under_way = under_way_.find(navigation_id);
+  if (under_way != under_way_.end()) {
+    under_way->second.url = handle->GetURL();
+  }
+  if (!action_) {
+    return;
+  }
+  if (Item* item = FindItem(*action_, navigation_id)) {
+    item->url = handle->GetURL();
+  }
+}
+
+void ActionOutcomeWatch::DidFinishNavigation(NavigationHandle* handle) {
+  const int64_t navigation_id = handle->GetNavigationId();
+  under_way_.erase(navigation_id);
+  // A commit, a URL change; a local root's new document is armed.
+  settle_arm_->DidFinishNavigation(handle);
+  Action* action = action_.get();
+  if (!action) {
+    return;
+  }
+  if (!action->answered) {
+    Item* item = FindItem(*action, navigation_id);
+    if (!item) {
+      return;
+    }
+    Finish(*item, handle);
+    MaybeFollowed(*action);
+    return;
+  }
+  auto it = action->late_navigations.find(navigation_id);
+  if (it == action->late_navigations.end()) {
+    return;
+  }
+  Item item = std::move(it->second);
+  action->late_navigations.erase(it);
+  Finish(item, handle);
+  std::unique_ptr<Page::ActionEvent> event = ToEvent(*action, item);
+  if (item.same_document) {
+    SendLateSameDocument(*action, std::move(event));
+  } else {
+    SendLate(*action, std::move(event));
+  }
+}
+
+std::optional<GURL> ActionOutcomeWatch::PendingNavigation(int action_id) const {
+  if (!under_way_.empty()) {
+    return under_way_.begin()->second.url;
+  }
+  const Action* action = action_.get();
+  if (!action || action->id != action_id) {
+    return std::nullopt;
+  }
+  const auto pending = [](const Item& item) {
+    return item.type == Item::Type::kNavigation && !item.same_document &&
+           !item.finished;
+  };
+  for (const Item& item : action->items) {
+    if (pending(item)) {
+      return item.url;
+    }
+  }
+  for (const auto& [navigation_id, item] : action->late_navigations) {
+    if (pending(item)) {
+      return item.url;
+    }
+  }
+  return std::nullopt;
+}
+
+bool ActionOutcomeWatch::Reportable(const Action& action,
+                                    NavigationHandle* handle) const {
+  if (handle->IsInPrimaryMainFrame()) {
+    return true;
+  }
+  if (handle->IsInMainFrame()) {
+    // Another page's main frame: a prerendered or fenced one.
+    return false;
+  }
+  FrameTreeNode* node = NavigationRequest::From(handle)->frame_tree_node();
+  if (!node->frame_tree().is_primary()) {
+    return false;
+  }
+  // A subframe's own load navigates for the action only with the activation a
+  // click or a key in it gives: an ad's own redirect (a cookie sync) has none,
+  // and was reported as the page's. Same-document and history
+  // navigations never carry it there, and keep the rule below.
+  if (!handle->IsSameDocument() &&
+      (handle->GetPageTransition() & ui::PAGE_TRANSITION_FORWARD_BACK) == 0 &&
+      !handle->StartedWithTransientActivation()) {
+    return false;
+  }
+  // A subframe: only the frame the action was in.
+  if (action.kind == Kind::kKeys) {
+    return std::ranges::contains(action.focus_chain,
+                                 node->frame_tree_node_id());
+  }
+  RenderFrameHostImpl* root = RenderFrameHostImpl::FromID(action.local_root);
+  RenderFrameHostImpl* frame = node->current_frame_host();
+  if (!root || !frame ||
+      (frame != root && !frame->IsDescendantOfWithinFrameTree(root))) {
+    return false;
+  }
+  // Navigated by itself or a frame inside it: a link clicked in an iframe,
+  // not a main-frame link aimed at the iframe by name.
+  const std::optional<blink::LocalFrameToken>& token =
+      handle->GetInitiatorFrameToken();
+  if (!token) {
+    return false;
+  }
+  RenderFrameHostImpl* initiator = RenderFrameHostImpl::FromFrameToken(
+      handle->GetInitiatorProcessId(), *token);
+  return initiator && (initiator == frame ||
+                       initiator->IsDescendantOfWithinFrameTree(frame));
+}
+
+ActionOutcomeWatch::Item ActionOutcomeWatch::NavigationItem(
+    NavigationHandle* handle) const {
+  Item item;
+  item.type = Item::Type::kNavigation;
+  item.at = Now();
+  item.navigation_id = handle->GetNavigationId();
+  item.state = "started";
+  item.url = handle->GetURL();
+  item.same_document = handle->IsSameDocument();
+  item.main_frame = handle->IsInPrimaryMainFrame();
+  item.frame_id = FrameIdOf(handle);
+  return item;
+}
+
+// Committed, or failed: an error page, a navigation that did not commit
+// (aborted, replaced, a 204), one that became a download.
+void ActionOutcomeWatch::Finish(Item& item, NavigationHandle* handle) const {
+  item.at = Now();
+  item.finished = true;
+  item.url = handle->GetURL();
+  if (handle->HasCommitted() && !handle->IsErrorPage()) {
+    item.state = "committed";
+    return;
+  }
+  item.state = "failed";
+  const net::Error error = handle->GetNetErrorCode();
+  if (error != net::OK) {
+    item.error_text = net::ErrorToShortString(error);
+  }
+  item.is_download = handle->IsDownload();
+}
+
+void ActionOutcomeWatch::AddItem(Action& action, Item item) {
+  if (item.type == Item::Type::kNavigation && item.same_document) {
+    // A frame's same-document navigations are one item, its last.
+    for (Item& kept : action.items) {
+      if (kept.type == Item::Type::kNavigation && kept.same_document &&
+          kept.finished && kept.frame_id == item.frame_id) {
+        kept = std::move(item);
+        return;
+      }
+    }
+  }
+  if (action.items.size() < kMaxItems) {
+    action.items.push_back(std::move(item));
+  }
+}
+
+ActionOutcomeWatch::Item* ActionOutcomeWatch::FindItem(Action& action,
+                                                       int64_t navigation_id) {
+  for (Item& item : action.items) {
+    if (item.type == Item::Type::kNavigation &&
+        item.navigation_id == navigation_id) {
+      return &item;
+    }
+  }
+  auto it = action.late_navigations.find(navigation_id);
+  return it == action.late_navigations.end() ? nullptr : &it->second;
+}
+
+// ============================================================ new tabs
+
+void ActionOutcomeWatch::DidOpenRequestedURL(
+    WebContents* new_contents,
+    RenderFrameHost* source_render_frame_host,
+    const GURL& url,
+    const Referrer& referrer,
+    WindowOpenDisposition disposition,
+    ui::PageTransition transition,
+    bool started_from_context_menu,
+    bool renderer_initiated) {
+  // The settle's newTab until.
+  settle_arm_->DidOpenTab(new_contents);
+  Action* action = action_.get();
+  if (!action || !new_contents || new_contents == web_contents()) {
+    return;
+  }
+  Item item;
+  item.type = Item::Type::kNewTab;
+  item.at = Now();
+  item.url = url;
+  item.tab = new_contents->GetWeakPtr();
+  // Its target id: a page target is named by its main frame's devtools
+  // token (RenderFrameDevToolsAgentHost), as Target.targetCreated will name
+  // it -- for a popup with an opener, before the target exists.
+  if (RenderFrameHost* main_frame = new_contents->GetPrimaryMainFrame()) {
+    item.target_id = main_frame->GetDevToolsFrameToken().ToString();
+  }
+  item.disposition = disposition;
+  if (!action->answered) {
+    AddItem(*action, std::move(item));
+    return;
+  }
+  SendLate(*action, ToEvent(*action, item));
+}
+
+void ActionOutcomeWatch::DidBlockPopup(const GURL& url,
+                                       WindowOpenDisposition disposition) {
+  Action* action = action_.get();
+  if (!action) {
+    return;
+  }
+  Item item;
+  item.type = Item::Type::kPopupBlocked;
+  item.at = Now();
+  item.url = url;
+  item.disposition = disposition;
+  if (!action->answered) {
+    AddItem(*action, std::move(item));
+    return;
+  }
+  SendLate(*action, ToEvent(*action, item));
+}
+
+// browser: the print manager took a frame's print(). The page waits in
+// it until the print ends, and the action's ack with it: the print is an item
+// of the action under way, like a blocked popup -- it ends, handles and
+// answers nothing.
+void ActionOutcomeWatch::DidRequestScriptedPrint(
+    RenderFrameHost* render_frame_host) {
+  settle_arm_->DidRequestPrint();
+  Action* action = action_.get();
+  if (!action || !render_frame_host) {
+    return;
+  }
+  Item item;
+  item.type = Item::Type::kPrint;
+  item.at = Now();
+  item.frame_id = render_frame_host->GetDevToolsFrameToken().ToString();
+  if (!action->answered) {
+    AddItem(*action, std::move(item));
+    return;
+  }
+  SendLate(*action, ToEvent(*action, item));
+}
+
+void ActionOutcomeWatch::WebContentsDestroyed() {
+  // What is known goes out; then nothing more.
+  EndCurrent(/*destroying=*/false);
+  settle_arm_->Clear();
+  StopWatchingWidgets();
+  under_way_.clear();
+}
+
+// ========================================================= the events
+
+std::unique_ptr<Page::ActionEvent> ActionOutcomeWatch::ToEvent(
+    const Action& action,
+    const Item& item) const {
+  const base::TimeTicks zero =
+      action.dispatched_at.is_null() ? action.armed_at : action.dispatched_at;
+  const char* kind = item.type == Item::Type::kNavigation     ? "navigation"
+                     : item.type == Item::Type::kNewTab       ? "newTab"
+                     : item.type == Item::Type::kPopupBlocked ? "popupBlocked"
+                                                              : "print";
+  std::unique_ptr<Page::ActionEvent> event =
+      Page::ActionEvent::Create()
+          .SetKind(kind)
+          .SetAtMs((item.at - zero).InMillisecondsF())
+          .Build();
+  if (!item.url.is_empty()) {
+    event->SetUrl(item.url.possibly_invalid_spec());
+  }
+  if (item.type == Item::Type::kPrint) {
+    if (!item.frame_id.empty()) {
+      event->SetFrameId(item.frame_id);
+    }
+    return event;
+  }
+  if (item.type != Item::Type::kNavigation) {
+    if (!item.target_id.empty()) {
+      event->SetTargetId(item.target_id);
+    }
+    event->SetDisposition(DispositionName(item.disposition));
+    return event;
+  }
+  event->SetState(item.state);
+  event->SetSameDocument(item.same_document);
+  event->SetMainFrame(item.main_frame);
+  if (item.before_action) {
+    event->SetStartedBeforeAction(true);
+  }
+  if (!item.frame_id.empty()) {
+    event->SetFrameId(item.frame_id);
+  }
+  if (!item.error_text.empty()) {
+    event->SetErrorText(item.error_text);
+  }
+  if (item.is_download) {
+    event->SetIsDownload(true);
+  }
+  // The title, only when the browser has one now: a cross-document load
+  // seldom has one at its commit.
+  if (item.main_frame && item.state == "committed" && web_contents()) {
+    const NavigationEntry* entry =
+        web_contents()->GetController().GetLastCommittedEntry();
+    if (entry && entry->GetURL() == item.url && !entry->GetTitle().empty()) {
+      event->SetTitle(base::UTF16ToUTF8(entry->GetTitle()));
+    }
+  }
+  return event;
+}
+
+void ActionOutcomeWatch::SendLate(Action& action,
+                                  std::unique_ptr<Page::ActionEvent> event) {
+  if (action.late_sent >= kMaxLateEvents) {
+    return;
+  }
+  ++action.late_sent;
+  on_late_.Run(action.id, std::move(event));
+}
+
+void ActionOutcomeWatch::SendLateSameDocument(
+    Action& action,
+    std::unique_ptr<Page::ActionEvent> event) {
+  const base::TimeTicks now = Now();
+  if (!action.last_same_document_sent.is_null() &&
+      now - action.last_same_document_sent < kSameDocumentWindow) {
+    // Held until the window ends; a later one replaces it.
+    action.held_same_document = std::move(event);
+    if (!action.same_document_timer.IsRunning()) {
+      action.same_document_timer.Start(
+          FROM_HERE, action.last_same_document_sent + kSameDocumentWindow - now,
+          base::BindOnce(&ActionOutcomeWatch::FlushSameDocument,
+                         base::Unretained(this)));
+    }
+    return;
+  }
+  action.last_same_document_sent = now;
+  SendLate(action, std::move(event));
+}
+
+void ActionOutcomeWatch::FlushSameDocument() {
+  Action* action = action_.get();
+  if (!action || !action->held_same_document) {
+    return;
+  }
+  action->last_same_document_sent = Now();
+  SendLate(*action, std::move(action->held_same_document));
+}
+
+// ========================================================= the acks
+
+void ActionOutcomeWatch::OnInputEvent(const RenderWidgetHost& host,
+                                      const blink::WebInputEvent& event,
+                                      InputEventSource source) {
+  Action* action = action_.get();
+  // Ours only: the operator's own input in a headed window has no
+  // kFromDebugger (RenderWidgetHostViewEventHandler::OnMouseEvent puts it on
+  // the debugger's mouse events; the typing session on its keys).
+  if (!action || action->answered ||
+      !(event.GetModifiers() & blink::WebInputEvent::kFromDebugger)) {
+    return;
+  }
+  const Type type = event.GetType();
+  if (action->kind == Kind::kMouse) {
+    if (type != Type::kMouseDown && type != Type::kMouseUp) {
+      return;
+    }
+    // The press (or a lone release) is the action's dispatch, and the local
+    // root it went to is the acting one.
+    if (action->dispatched_at.is_null()) {
+      action->dispatched_at = Now();
+      action->local_root = LocalRootOf(host);
+    }
+  } else if (action->kind == Kind::kKeys) {
+    if (!blink::WebInputEvent::IsKeyboardEventType(type)) {
+      return;
+    }
+    if (action->dispatched_at.is_null()) {
+      action->dispatched_at = Now();
+    }
+  } else {
+    return;
+  }
+  if (type == action->awaited) {
+    action->in_flight.push_back(Sent{&host, type, event.TimeStamp()});
+    action->handled = false;
+  }
+}
+
+// An ack is matched to the event sent by its widget, type and time stamp: an
+// earlier action's late ack is not this one's.
+void ActionOutcomeWatch::OnInputEventAck(
+    const RenderWidgetHost& host,
+    blink::mojom::InputEventResultSource source,
+    blink::mojom::InputEventResultState state,
+    const blink::WebInputEvent& event) {
+  Action* action = action_.get();
+  if (!action || action->answered) {
+    return;
+  }
+  auto it = std::ranges::find_if(action->in_flight, [&](const Sent& sent) {
+    return sent.widget.get() == &host && sent.type == event.GetType() &&
+           sent.time == event.TimeStamp();
+  });
+  if (it == action->in_flight.end()) {
+    return;
+  }
+  action->in_flight.erase(it);
+  ++action->acked;
+  MaybeHandled(*action);
+}
+
+void ActionOutcomeWatch::RenderWidgetHostDestroyed(
+    RenderWidgetHost* widget_host) {
+  widget_host->RemoveInputEventObserver(this);
+  widget_host->RemoveObserver(this);
+  std::erase_if(watched_, [widget_host](const raw_ptr<RenderWidgetHost>& w) {
+    return w.get() == widget_host;
+  });
+  if (!action_ || action_->answered) {
+    return;
+  }
+  // What went to it will never be answered for: counted as answered, so the
+  // action does not wait out kHandledCap for a widget that is gone.
+  const size_t gone =
+      std::erase_if(action_->in_flight, [widget_host](const Sent& sent) {
+        return sent.widget.get() == widget_host;
+      });
+  if (gone > 0) {
+    action_->acked += static_cast<int>(gone);
+    MaybeHandled(*action_);
+  }
+}
+
+void ActionOutcomeWatch::WatchTabWidgets() {
+  WebContentsImpl* contents = static_cast<WebContentsImpl*>(web_contents());
+  if (!contents) {
+    return;
+  }
+  const RenderWidgetHostDelegate* tab = contents;
+  std::unique_ptr<RenderWidgetHostIterator> widgets =
+      RenderWidgetHost::GetRenderWidgetHosts();
+  while (RenderWidgetHost* widget = widgets->GetNextHost()) {
+    if (RenderWidgetHostImpl::From(widget)->delegate() == tab) {
+      WatchWidget(widget);
+    }
+  }
+}
+
+void ActionOutcomeWatch::WatchWidget(RenderWidgetHost* widget) {
+  const bool watched = std::ranges::any_of(
+      watched_, [widget](const raw_ptr<RenderWidgetHost>& w) {
+        return w.get() == widget;
+      });
+  if (!widget || watched) {
+    return;
+  }
+  widget->AddInputEventObserver(this);
+  widget->AddObserver(this);
+  watched_.push_back(widget);
+}
+
+// What was on its way is no longer counted: the acks are no longer heard.
+void ActionOutcomeWatch::StopWatchingWidgets() {
+  for (const raw_ptr<RenderWidgetHost>& widget : watched_) {
+    widget->RemoveInputEventObserver(this);
+    widget->RemoveObserver(this);
+  }
+  watched_.clear();
+  if (action_) {
+    action_->in_flight.clear();
+  }
+}
+
+GlobalRenderFrameHostId ActionOutcomeWatch::LocalRootOf(
+    const RenderWidgetHost& widget) const {
+  WebContentsImpl* contents = static_cast<WebContentsImpl*>(web_contents());
+  if (!contents) {
+    return GlobalRenderFrameHostId();
+  }
+  GlobalRenderFrameHostId found;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHostImpl(
+      [&](RenderFrameHostImpl* frame) {
+        if (static_cast<const RenderWidgetHost*>(
+                frame->GetLocalRenderWidgetHost()) == &widget) {
+          found = frame->GetGlobalId();
+        }
+      });
+  return found;
+}
+
+}  // namespace content::protocol
