+  // held move it has not yet taken went out, oldest first; when the window
+  // began waiting for it, and when that wait first found it caught up.
+  std::unique_ptr<PageTakes> page_takes_;
+  bool press_sent_ = false;
+  bool press_taken_ = false;
+  std::deque<base::TimeTicks> untaken_moves_;
+  base::TimeTicks page_wait_from_;
+  base::TimeTicks page_up_at_;
+
+  // The carry: the target's need (root DIPs, positive: the wheel turned
+  // down or right), the stage's axis and way, its station and region, the
+  // box the wheel turns there, and the spins.
+  PlannerPoint need_;
+  bool stage_started_ = false;
+  bool vertical_ = true;
+  int way_ = 1;
+  int stations_ = 0;
+  int axis_switches_ = 0;
+  PlannerPoint station_;
+  DragRect region_;
+  int binder_id_ = 0;
+  // The box the wheel turns at the stage's station (the latch there), which
+  // with the binder is what the watch credits to the wheel; the last notch's
+  // axis and way; whether its scroll may still be easing; the single notches
+  // turned in the stage.
+  int notch_latch_id_ = 0;
+  bool notch_vertical_ = true;
+  int notch_way_ = 1;
+  bool easing_ = false;
+  int single_notches_ = 0;
+  // A station has been taken (the last may serve again); the box whose
+  // live zone the landing was in, for the next station; the carry's returns
+  // for such landings.
+  bool has_station_ = false;
+  int zone_box_ = 0;
+  int zone_returns_ = 0;
+  // A box (and axis) a zone's stage found not to carry the target; the boxes
+  // the wheel turns, and the target's box, at the last settled reading.
+  int stuck_box_ = 0;
+  bool stuck_vertical_ = true;
+  base::flat_map<int, Offsets> stage_offsets_;
+  DragRect stage_target_;
+  std::string binder_name_;
+  // Root DIPs a notch moves the target, measured settle to settle.
+  double per_notch_ = 100;
+  double last_settled_need_ = 0;
+  int notches_since_settle_ = 0;
+  int stalled_spins_ = 0;
+  bool breathed_ = false;
+  base::TimeDelta breath_;
+  std::vector<base::TimeDelta> spin_at_;
+  base::TimeTicks spin_from_;
+  size_t spin_next_ = 0;
+  uint64_t spin_token_ = 0;
+  bool spinning_ = false;
+  bool settling_ = false;
+  bool probing_ = false;
+  // The settle, from the watch's frames (the renderer's clock): whether the
+  // box the wheel turns moved, when it last did, the first frame after the
+  // last notch, and a scrollend.
+  bool binder_moved_ = false;
+  bool scroll_ended_ = false;
+  bool frame_after_notch_ = false;
+  double binder_still_from_ms_ = 0;
+  double first_frame_after_notch_ms_ = 0;
+  // The spin's notches (the first as sent; a pointer drag's as planned) and
+  // their scroll's window.
+  base::TimeTicks first_notch_at_;
+  base::TimeTicks last_notch_at_;
+  base::TimeTicks notch_window_until_;
+  int notches_ = 0;
+
+  // The approach and the verify.
+  PlannerPoint landing_;
+  bool in_band_landing_ = false;
+  std::optional<PlannerPoint> calm_point_;
+  bool darted_ = false;
+  bool retargetable_ = false;
+  DragRect landing_box_;
+  base::flat_map<int, Offsets> landing_offsets_;
+  DragRect letgo_box_;
+  PlannerPoint final_at_;
+  base::TimeTicks replies_until_;
+  // A pointer drag's target slot as its verify read it.
+  DragRect verified_slot_;
+  // Corrections: Blink's band side at the last landing (moved inward past
+  // the belt next time), and hit misses re-aimed elsewhere on the target.
+  int inward_side_ = 0;
+  bool inward_landing_ = false;
+  int hit_retries_ = 0;
+  PlannerPoint last_failed_landing_;
+  // A native drag over a list verified by its order: whether for the last
+  // check, and the grabbed element's slot read for it.
+  bool order_final_ = false;
+  blink::mojom::AgentSlotPtr order_grab_;
+  // Steps taken toward the side asked for; whether the grabbed element
+  // ended on that side, the target's after-read done, and what the
+  // after-read goes on to.
+  int order_steps_ = 0;
+  std::optional<bool> slot_reached_;
+  bool slot_checked_ = false;
+  SlotUse after_next_ = SlotUse::kAfter;
+  // A stepped landing has been corrected once (no more steps). The
+  // landing is at a library zone's inner edge (the verify then takes all
+  // of a slot).
+  bool step_corrected_ = false;
+  bool edge_landing_ = false;
+  int corrections_ = 0;
+  int replans_ = 0;
+  int forced_replans_ = 0;
+  bool ever_accepted_ = false;
+  bool value_corrected_ = false;
+  bool reached_ = false;
+  std::string hit_;
+  // browser: the kind of the open layer a check named as `hit_kind_of_`;
+  // answered only while hit_ is still that name.
+  std::string hit_kind_;
+  std::string hit_kind_of_;
+  // browser: the last check of the target found it inert: what switched
+  // it off and that layer's kind, said when the drag gives up on it -- hit_
+  // keeps the word inert meanwhile, the cause not being what lies there.
+  std::optional<InertCause> inert_cause_;
+  std::string hit_value_before_;
+  std::string hit_value_after_;
+  std::optional<double> value_reached_;
+  std::string letgo_outcome_;
+  std::string letgo_reason_;
+  // A read of the grabbed element once the page has settled (after a
+  // let-go, a put-back, a native drag's end): which, and since when.
+  std::optional<SettleRead> settle_read_;
+  bool put_back_ = false;
+
+  // The watch: the last frame's offsets per box, the first and latest
+  // offsets for `scrolled`, the scrolls nobody asked for, the boxes' names,
+  // and the target's and the grabbed element's boxes in the last frame.
+  bool watching_ = false;
+  uint64_t watch_ask_ = 0;
+  uint32_t watch_version_ = 0;
+  uint32_t layout_version_ = 0;
+  double last_frame_ms_ = 0;
+  base::TimeTicks last_binder_still_at_;
+  base::TimeTicks last_binder_change_at_;
+  std::vector<int32_t> watch_ids_;
+  DragRect frame_target_box_;
+  DragRect frame_target_slot_;
+  DragRect frame_grab_slot_;
+  // The grabbed element has been seen off its layout box: it follows the
+  // pointer (a library translates it), so what lies under a release is
+  // what is beneath it.
+  bool grab_follows_ = false;
+  base::TimeTicks target_moved_at_;
+  base::flat_map<int, Offsets> frame_offsets_;
+  base::flat_map<int, Offsets> first_offsets_;
+  base::flat_map<int, Offsets> latest_offsets_;
+  base::flat_map<int, Offsets> unexpected_;
+  // Per box the wheel turned, what the wheel may be credited with.
+  base::flat_map<int, WheelCredit> wheel_credit_;
+  base::flat_map<int, std::string> names_;
+
+  // Band dwell: the run under way (box, since when).
+  int run_box_ = 0;
+  base::TimeTicks run_start_;
+  // The last dragover sent (native): an in-band rest counts from it.
+  base::TimeTicks last_over_at_;
+  // Dragovers sent since a native drag began, its dragenter included: the
+  // page takes or refuses a drop in a dragover, so a let-go needs one past
+  // the dragenter.
+  int overs_since_start_ = 0;
+  // The hand's last move the page saw, and (native) where the last dragover
+  // went: a calm rest counts from it.
+  base::TimeTicks moved_at_;
+  std::optional<PlannerPoint> last_over_p_;
+
+  base::OneShotTimer deadline_timer_;
+  base::OneShotTimer read_timer_;
+  base::OneShotTimer step_timer_;
+  base::OneShotTimer notch_timer_;
+  base::OneShotTimer settle_timer_;
+  base::OneShotTimer guard_timer_;
+  base::OneShotTimer end_timer_;
+  base::OneShotTimer final_timer_;
+  base::OneShotTimer settle_read_timer_;
+  base::OneShotTimer answer_timer_;
+  base::WeakPtrFactory<DragSession> weak_factory_{this};
+};
