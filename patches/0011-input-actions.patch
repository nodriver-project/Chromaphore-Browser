+MoveSession::MoveSession(
+    InputHandler& handler,
+    uint64_t id,
+    const Params& params,
+    HumanPathPlanner& planner,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    Completion completion,
+    base::OnceCallback<void(uint64_t)> on_done)
+    : handler_(handler),
+      id_(id),
+      params_(params),
+      planner_(planner),
+      collector_(std::move(collector)),
+      completion_(std::move(completion)),
+      on_done_(std::move(on_done)),
+      started_(base::TimeTicks::Now()),
+      hand_(params.hand),
+      landing_(params.hand) {}
+
+MoveSession::~MoveSession() {
+  // The handler may be going too: nothing of it is asked.
+  if (completion_) {
+    // Its outcome watch is not asked either.
+    action_id_ = 0;
+    Send("interrupted", "the DevTools session ended before the move did",
+         std::string(), hand_);
+  }
+}
+
+// static
+void MoveSession::Refuse(Completion completion,
+                         const std::string& outcome,
+                         const std::string& reason,
+                         const PlannerPoint& hand,
+                         double css_scale) {
+  const double scale = css_scale > 0 ? css_scale : 1;
+  MoveResult result;
+  result.outcome = outcome;
+  result.reason = reason;
+  result.x = hand.x / scale;
+  result.y = hand.y / scale;
+  std::move(completion).Run(std::move(result));
+}
+
+base::WeakPtr<MoveSession> MoveSession::Weak() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void MoveSession::Start() {
+  timeout_timer_.Start(FROM_HERE, params_.timeout,
+                       base::BindOnce(&MoveSession::OnTimeout, Weak()));
+  switch (params_.target) {
+    case Target::kNone:
+      // Done where the pointer is.
+      if (params_.end_action != EndAction::kNone &&
+          !Contains(params_.view, hand_)) {
+        Answer("unreachable", "the pointer is outside the page's view");
+        return;
+      }
+      Arrived();
+      return;
+    case Target::kElement:
+      collector_.set_disconnect_handler(
+          base::BindOnce(&MoveSession::OnCollectorGone, Weak()));
+      Aim();
+      return;
+    case Target::kBox: {
+      piece_ = Intersect(params_.box, params_.view);
+      if (IsEmpty(piece_)) {
+        Answer("hidden", "none of the box is in the page's view");
+        return;
+      }
+      landing_ = PointIn(piece_, piece_);
+      Leg(landing_, WidthAlong(piece_, landing_));
+      return;
+    }
+    case Target::kPoint:
+      if (!Contains(params_.view, params_.point)) {
+        Answer("unreachable", "the point is outside the page's view");
+        return;
+      }
+      landing_ = params_.point;
+      Leg(landing_, kPointWidthPx);
+      return;
+  }
+}
+
+void MoveSession::Interrupt() {
+  if (end_queued_) {
+    // The end is on its way and plays out: what it does is the answer.
+    Answer(EndOutcome());
+    return;
+  }
+  Answer("interrupted", "other input came for the pointer first");
+}
+
+void MoveSession::Aim() {
+  if (!collector_.is_connected()) {
+    Answer("gone", "the page's renderer went away");
+    return;
+  }
+  const gfx::PointF hand = HandInLocal();
+  collector_->AimPiece(params_.node_id, hand.x(), hand.y(), /*with_hand=*/true,
+                       base::BindOnce(&MoveSession::OnAimed, Weak()));
+}
+
+void MoveSession::OnAimed(blink::mojom::AgentAimPiecePtr piece) {
+  if (answered()) {
+    return;
+  }
+  if (!piece || !piece->found) {
+    Answer("gone", "the element is no longer in the page");
+    return;
+  }
+  child_frame_ = piece->child_frame_id;
+  // What shows of it in the root view: an out-of-process frame's piece is
+  // already cut to the part of the frame the page shows (VisibleInRoot).
+  piece_ = Intersect(BoxToRoot(piece->piece.get()), params_.view);
+  if (!piece->in_view || IsEmpty(piece_)) {
+    Answer("hidden", NotDisplayed(*piece)
+                         ? "notDisplayed"
+                         : "none of the element shows in the page's view");
+    return;
+  }
+  seen_box_ = BoxToRoot(piece->box.get());
+  aimed_box_ = seen_box_;
+  KeepHoles(*piece);
+  KeepRegion(*piece);
+  landing_ = PointIn(piece_, ShownBox());
+  Leg(landing_, WidthAlong(piece_, landing_));
+}
+
+void MoveSession::ReAim() {
+  if (answered()) {
+    return;
+  }
+  if (!collector_.is_connected()) {
+    Answer("gone", "the page's renderer went away");
+    return;
+  }
+  const gfx::PointF hand = HandInLocal();
+  collector_->AimPiece(params_.node_id, hand.x(), hand.y(), /*with_hand=*/true,
+                       base::BindOnce(&MoveSession::OnReAimed, Weak()));
+}
+
+// Before an element's press: where its piece is now. Still under the hand,
+// and where the last reading had it, the press point is checked; moved from
+// under the hand, the hand follows it (a correction). Moved since the last
+// reading but under the hand still, it is looked at again a moment later: a
+// hand does not press what is still moving, and an element that never
+// stopped was pressed and slid out from under the held button.
+// Seen moving at a look, it is followed too; seen moving at all, it is
+// pressed only once kStillLooks looks in a row find it still -- two readings
+// either side of a turn in its motion can find it in one place.
+void MoveSession::OnReAimed(blink::mojom::AgentAimPiecePtr piece) {
+  if (answered()) {
+    return;
+  }
+  if (!piece || !piece->found) {
+    Answer("gone", "the element is no longer in the page");
+    return;
+  }
+  const PlannerRect now =
+      Intersect(BoxToRoot(piece->piece.get()), params_.view);
+  if (!piece->in_view || IsEmpty(now)) {
+    // Laid out when the hand set out, and not now: it lost its box on the way
+    // -- a menu holding it closed as the pointer moved.
+    const bool vanished = NotDisplayed(*piece);
+    Answer("hidden",
+           vanished ? "vanished" : "the element moved out of the page's view");
+    return;
+  }
+  piece_ = now;
+  KeepHoles(*piece);
+  KeepRegion(*piece);
+  const PlannerRect box = BoxToRoot(piece->box.get());
+  const bool moved = Moved(seen_box_, box);
+  seen_box_ = box;
+  const bool looked = looked_;
+  looked_ = false;
+  if (moved) {
+    seen_moving_ = true;
+    still_looks_ = 0;
+  } else if (looked) {
+    ++still_looks_;
+  }
+  // A part of it with a control of its own come up under the landing (a
+  // chip's close button shown on hover): aimed again, on its own count and
+  // not as the element moving, else pressed there and said. Not at the
+  // call's own fractions, which land where they say.
+  const bool on_hole =
+      !params_.aim_x.has_value() && !params_.aim_y.has_value() &&
+      InAnyHole(holes_, landing_) && hole_corrections_ < kMaxHoleCorrections;
+  const bool off = !OnPiece(piece_, kOnPiecePx, landing_) || (moved && looked);
+  if (off || on_hole) {
+    if (off && corrections_ >= kMaxCorrections) {
+      Answer("unreachable", "the element kept moving from under the hand");
+      return;
+    }
+    if (off) {
+      ++corrections_;
+    } else {
+      ++hole_corrections_;
+    }
+    aimed_box_ = box;
+    landing_ = PointIn(piece_, ShownBox());
+    Leg(landing_, WidthAlong(piece_, landing_));
+    return;
+  }
+  if (moved || (seen_moving_ && still_looks_ < kStillLooks)) {
+    looked_ = true;
+    look_timer_.Start(
+        FROM_HERE,
+        base::Milliseconds(kLookMinMs +
+                           base::RandDouble() * (kLookMaxMs - kLookMinMs)),
+        base::BindOnce(&MoveSession::ReAim, Weak()));
+    return;
+  }
+  // Settled where it moved to: followed by as far as it moved, the hand's
+  // place on it kept, when that place slid a seventh of it across or more --
+  // a button that slid under the hand was pressed 1 px from its edge.
+  // Once, and only for a slide: a lift or a scale on hover moves it
+  // less than twice kStillPx.
+  if (seen_moving_ && !followed_ && !IsEmpty(aimed_box_)) {
+    const double dx = box.x + box.w / 2 - (aimed_box_.x + aimed_box_.w / 2);
+    const double dy = box.y + box.h / 2 - (aimed_box_.y + aimed_box_.h / 2);
+    if (std::abs(dx) >= std::max(2 * kStillPx, piece_.w / 7) ||
+        std::abs(dy) >= std::max(2 * kStillPx, piece_.h / 7)) {
+      followed_ = true;
+      aimed_box_ = box;
+      const double ex = std::min(1.0, piece_.w / 4);
+      const double ey = std::min(1.0, piece_.h / 4);
+      landing_ = PlannerPoint{
+          std::clamp(landing_.x + dx, piece_.x + ex, piece_.x + piece_.w - ex),
+          std::clamp(landing_.y + dy, piece_.y + ey, piece_.y + piece_.h - ey)};
+      Leg(landing_, WidthAlong(piece_, landing_));
+      return;
+    }
+  }
+  if (!params_.check) {
+    End();
+    return;
+  }
+  Route();
+}
+
+void MoveSession::Leg(const PlannerPoint& to, double width) {
+  const std::optional<RegionPath> path = PathInRegion(region_, hand_, to);
+  if (path && path->turn) {
+    // Across into the box the target is in and on to it: a submenu beside its
+    // row. One movement, timed for the target as the hand comes at it
+    // from the turn.
+    const PlannerPoint turn = *path->turn;
+    const bool held =
+        params_.held_button != SyntheticPointerActionParams::Button::NO_BUTTON;
+    std::vector<PlannedPoint> stroke =
+        TurnStroke(*planner_, params_.intent, params_.speed_multiplier, held,
+                   hand_, *path, to, WidthBetween(piece_, turn, to));
+    if (!stroke.empty()) {
+      Play(std::move(stroke), to, /*last=*/true,
+           params_.end_action != EndAction::kNone);
+      return;
+    }
+    // Not to be rounded inside the two boxes: two legs, the hand coming to
+    // rest at the turn.
+    if (!LegOnce(turn, WidthAlong(path->overlap, turn), path->first,
+                 /*last=*/false)) {
+      return;
+    }
+    LegOnce(to, WidthAlong(piece_, to), path->second, /*last=*/true);
+    return;
+  }
+  LegOnce(to, width, path ? path->first : PlannerRect(), /*last=*/true);
+}
+
+bool MoveSession::LegOnce(const PlannerPoint& to,
+                          double width,
+                          const PlannerRect& keep,
+                          bool last) {
+  LegConstraints c;
+  // A press, release or click lands where it was aimed; a hover may end
+  // with the hand's tremor, and so may a turn on the way.
+  c.exact_end = last && params_.end_action != EndAction::kNone;
+  c.button_held =
+      params_.held_button != SyntheticPointerActionParams::Button::NO_BUTTON;
+  // No bow leaves the view, nor what runs past the end: a cursor stops at
+  // the screen's edge.
+  BoundLegToView(
+      hand_, to,
+      DragRect{params_.view.x, params_.view.y, params_.view.w, params_.view.h},
+      &c);
+  // Inside the hover region, where the hand is in it.
+  if (Contains(keep, hand_) && Contains(keep, to)) {
+    BoundLegToRegion(hand_, to, keep, &c);
+  }
+  std::vector<PlannedPoint> leg =
+      planner_->PlanLeg(hand_, to, std::max(width, 1.0), params_.intent,
+                        params_.speed_multiplier, c);
+  return Play(std::move(leg), to, last, c.exact_end);
+}
+
+bool MoveSession::Play(std::vector<PlannedPoint> leg,
+                       const PlannerPoint& to,
+                       bool last,
+                       bool exact_end) {
+  std::vector<PlannerPoint> points;
+  points.reserve(leg.size());
+  for (const PlannedPoint& sample : leg) {
+    points.push_back(sample.p);
+  }
+  if (points.empty()) {
+    points.push_back(to);
+  }
+  InputHandler::MousePathRequest request = Request(std::move(points));
+  // Its last point on the pixel it was aimed at, as a press lands.
+  request.exact_end = exact_end;
+  const bool queued = handler_->QueueMousePath(
+      std::move(request),
+      last ? base::BindOnce(&MoveSession::OnLegDone, Weak())
+           : base::BindOnce(&MoveSession::OnTurnDone, Weak()));
+  if (queued) {
+    // Where it leaves the pointer once it has played: its last point, as
+    // snapped.
+    hand_ = handler_->LastPointer().value_or(to);
+  }
+  return queued;
+}
+
+// A turn on the way: only a refusal is answered; the leg after it
+// answers the move.
+void MoveSession::OnTurnDone(bool ok) {
+  if (!answered() && !ok) {
+    Answer("gone", "the page's view went away during the move");
+  }
+}
+
+void MoveSession::OnLegDone(bool ok) {
+  if (answered()) {
+    return;
+  }
+  if (!ok) {
+    Answer("gone", "the page's view went away during the move");
+    return;
+  }
+  Arrived();
+}
+
+void MoveSession::Arrived() {
+  if (answered()) {
+    return;
+  }
+  if (params_.end_action == EndAction::kNone) {
+    if (params_.check_landing && params_.target == Target::kElement) {
+      // Checked as a press would be, and nothing pressed (End answers).
+      ReAim();
+      return;
+    }
+    Answer("arrived");
+    return;
+  }
+  if (params_.end_action == EndAction::kRelease &&
+      params_.held_button == SyntheticPointerActionParams::Button::NO_BUTTON) {
+    // Nothing to let go of: a lone mouseup is no hand's.
+    Answer("released", "no button was down, so nothing was sent");
+    return;
+  }
+  if (!dwell_ms_) {
+    dwell_ms_ = params_.end_action == EndAction::kRelease
+                    ? planner_->ReleaseDwellMs()
+                    : planner_->PressDwellMs(params_.intent);
+  }
+  if (params_.target == Target::kElement && Presses()) {
+    ReAim();
+    return;
+  }
+  End();
+}
+
+// The landing routed to the widget a real press there would go to, as
+// Page.agentHitCheck routes it: another frame process's content there takes
+// the press.
+void MoveSession::Route() {
+  RenderWidgetHostViewBase* local = LocalView();
+  RenderWidgetHostViewBase* root = local ? local->GetRootView() : nullptr;
+  RenderWidgetHostImpl* root_host = root ? root->host() : nullptr;
+  if (!root || !root_host || !root_host->delegate()) {
+    Answer("gone", "the page's view went away");
+    return;
+  }
+  root_host->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+      root, gfx::PointF(landing_.x, landing_.y),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&MoveSession::OnRouted, Weak()),
+          base::WeakPtr<RenderWidgetHostViewBase>(),
+          std::optional<gfx::PointF>()));
+}
+
+void MoveSession::OnRouted(base::WeakPtr<RenderWidgetHostViewBase> target,
+                           std::optional<gfx::PointF> point) {
+  if (answered()) {
+    return;
+  }
+  RenderWidgetHostViewBase* local = LocalView();
+  if (!local) {
+    Answer("gone", "the element's frame went away");
+    return;
+  }
+  if (!target || !point.has_value()) {
+    Answer("unreachable", "the press point could not be hit-tested");
+    return;
+  }
+  if (target.get() != local) {
+    // A frame element's own frame, or one inside it, takes the press: a press
+    // on a frame is a press on what it holds there.
+    if (RenderWidgetHostViewBase* own = ChildFrameView();
+        (own && (target.get() == own ||
+                 input::RenderWidgetHostViewInput::IsAncestorView(target.get(),
+                                                                  own))) ||
+        InChildFrame(target.get())) {
+      End();
+      return;
+    }
+    // Another frame process's content lies over it: what, asked there.
+    if (RenderFrameHostImpl* over =
+            handler_->BindCollectorFor(target.get(), &cover_collector_)) {
+      cover_collector_->DescribePoint(
+          point->x(), point->y(), std::vector<int32_t>(), /*place=*/true,
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&MoveSession::OnCoverNamed, Weak(),
+                             IsPageDocument(over)),
+              std::string(), 0, std::string()));
+      return;
+    }
+    const bool page = IsPageDocument(handler_->LocalRootFor(target.get()));
+    Answer("covered", page ? "covered" : "otherFrame",
+           CoverName(page, std::string()));
+    return;
+  }
+  if (!collector_.is_connected()) {
+    Answer("gone", "the page's renderer went away");
+    return;
+  }
+  collector_->HitCheck(params_.node_id, point->x(), point->y(),
+                       base::BindOnce(&MoveSession::OnHitChecked, Weak()));
+}
+
+// The verdict a real press would meet (PressVerdict): reached, or through
+// its label, presses; anything else does not, and says why.
+void MoveSession::OnHitChecked(const std::string& verdict,
+                               const std::string& hit,
+                               const std::string& hit_kind) {
+  if (answered()) {
+    return;
+  }
+  if (params_.end_action == EndAction::kNone &&
+      (verdict == "noPointer" || verdict == "disabled")) {
+    // A landing checked for no press: what holds it takes the wheel there.
+    Answer("arrived", verdict, hit);
+    return;
+  }
+  if (verdict == "reached" || verdict == "label") {
+    // A part of it with a control of its own took the press: said.
+    inner_ = verdict == "reached" ? hit : std::string();
+    End();
+  } else if (verdict == "gone") {
+    Answer("gone", "the element is no longer in the page");
+  } else if (verdict == "hidden") {
+    Answer("hidden", verdict, hit);
+  } else if (verdict == "noPointer" || verdict == "inert" ||
+             verdict == "disabled") {
+    // For inert, hit and hit_kind are what switched it off -- a modal dialog
+    // or a full-screen element named as its layer, with its kind -- for the
+    // refusal to say.
+    Answer("unreachable", verdict, hit,
+           verdict == "inert" ? hit_kind : std::string());
+  } else {
+    // covered, nothing, otherFrame: the press would go somewhere else; a
+    // layer over it with its kind.
+    Answer("covered", verdict, hit, hit_kind);
+  }
+}
+
+void MoveSession::End() {
+  if (params_.end_action == EndAction::kNone) {
+    // A landing checked for no press (check_landing): there it is.
+    Answer("arrived");
+    return;
+  }
+  // The wait from the last move the page saw: a path still to play ends
+  // with its own last move, and the wait runs from there.
+  double wait_ms = dwell_ms_.value_or(0);
+  const base::TimeTicks last_move = handler_->LastMoveAt();
+  if (!handler_->PathInFlight() && !last_move.is_null()) {
+    wait_ms -=
+        (base::TimeTicks::Now() - last_move).InMillisecondsF() + kEndLagMs;
+  }
+  InputHandler::MousePathRequest request = Request({landing_});
+  request.end_action = params_.end_action;
+  request.end_button = params_.end_button;
+  request.click_count = params_.click_count;
+  request.end_delay = base::Milliseconds(std::max(0.0, wait_ms));
+  // How long the end takes once it starts.
+  base::TimeDelta takes = request.end_delay;
+  if (params_.end_action == EndAction::kClick) {
+    // Each click its own hold, and each gap its own, as a hand's are.
+    for (int i = 0; i < params_.click_count; ++i) {
+      request.holds.push_back(base::Milliseconds(planner_->ClickHoldMs()));
+      takes += request.holds.back();
+      if (i + 1 < params_.click_count) {
+        request.click_gaps.push_back(
+            base::Milliseconds(planner_->ClickGapMs()));
+        takes += request.click_gaps.back();
+      }
+    }
+    request.hold = request.holds.front();
+  }
+  request.exact_end = true;
+  // Once queued it plays out: an interruption is answered with what it does,
+  // and the timeout gives way to a backstop. Refused, OnEnded hears so.
+  end_queued_ = handler_->QueueMousePath(
+      std::move(request), base::BindOnce(&MoveSession::OnEnded, Weak()));
+  if (end_queued_) {
+    // What the end leads to is watched from here: its events go
+    // out on the gesture's timer, after this. Not an end another command
+    // arms for itself (Params::arm).
+    if (params_.arm) {
+      action_id_ = handler_->OutcomeWatch()->ArmMouse(
+          params_.end_action, params_.click_count, params_.follow_navigation);
+    }
+    timeout_timer_.Start(FROM_HERE, takes + kEndBackstop,
+                         base::BindOnce(&MoveSession::OnEndOverdue, Weak()));
+  }
+  hand_ = handler_->LastPointer().value_or(landing_);
+}
+
+// The end was sent and plays out (the button it pressed is held): what it
+// does is the answer, as for an interruption once it is queued.
+void MoveSession::OnEndOverdue() {
+  Answer(EndOutcome(), "sent, but its gesture did not report done");
+}
+
+void MoveSession::OnEnded(bool ok) {
+  if (answered()) {
+    return;
+  }
+  if (!ok) {
+    Answer("gone", "the page's view went away before the button did");
+    return;
+  }
+  Answer(EndOutcome());
+}
+
+void MoveSession::OnTimeout() {
+  Answer("timeout", "the move took longer than its timeoutMs");
+}
+
+void MoveSession::OnCollectorGone() {
+  Answer("gone", "the page's renderer went away");
+}
+
+void MoveSession::Answer(const std::string& outcome,
+                         const std::string& reason,
+                         const std::string& hit,
+                         const std::string& hit_kind) {
+  if (answered()) {
+    return;
+  }
+  // Where the pointer is, or will be once what is queued has played. A
+  // press that went ahead on a part of the element with a control of its own
+  // says which; a refusal, what is in the way.
+  const bool ended = end_queued_ && outcome == EndOutcome();
+  Send(outcome, reason, hit.empty() && ended ? inner_ : hit,
+       handler_->LastPointer().value_or(hand_), hit_kind);
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void MoveSession::Send(const std::string& outcome,
+                       const std::string& reason,
+                       const std::string& hit,
+                       const PlannerPoint& at,
+                       const std::string& hit_kind) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  look_timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  const double scale = params_.css_scale > 0 ? params_.css_scale : 1;
+  MoveResult result;
+  result.outcome = outcome;
+  result.reason = reason;
+  result.hit = hit;
+  result.hit_kind = hit_kind;
+  result.x = at.x / scale;
+  result.y = at.y / scale;
+  result.corrections = corrections_;
+  result.duration_ms = (base::TimeTicks::Now() - started_).InMillisecondsF();
+  // An end that went out is answered once what it led to is known (see
+  // ActionOutcomeWatch::Settle); any other answer after it went out, at once
+  // with what it led to so far; one before it, with none.
+  ActionOutcomeWatch::Reply(
+      action_id_ ? handler_->outcome_watch() : nullptr, action_id_,
+      base::BindOnce(
+          [](Completion completion, MoveResult result,
+             std::unique_ptr<Page::ActionOutcome> action_outcome) {
+            result.action_outcome = std::move(action_outcome);
+            std::move(completion).Run(std::move(result));
+          },
+          std::move(completion), std::move(result)),
+      /*wait=*/outcome == EndOutcome());
+}
+
+PlannerPoint MoveSession::PointIn(const PlannerRect& box,
+                                  const PlannerRect& sized_by) const {
+  if (params_.aim_x.has_value() || params_.aim_y.has_value()) {
+    // Asked for: kept min(2, a quarter of the box) inside.
+    const double ex = std::min(2.0, box.w / 4);
+    const double ey = std::min(2.0, box.h / 4);
+    const double x = box.x + params_.aim_x.value_or(0.5) * box.w;
+    const double y = box.y + params_.aim_y.value_or(0.5) * box.h;
+    return PlannerPoint{std::clamp(x, box.x + ex, box.x + box.w - ex),
+                        std::clamp(y, box.y + ey, box.y + box.h - ey)};
+  }
+  // Off the parts of it a press would act on instead of it: around its
+  // middle, or -- that middle on one -- in the clear part a hand would take,
+  // large and near it.
+  const PlannerRect part = ClearPart(box);
+  const double distance =
+      std::hypot(part.x + part.w / 2 - hand_.x, part.y + part.h / 2 - hand_.y);
+  return planner_->ClickPoint(part, sized_by, hand_, distance, params_.intent,
+                              holes_);
+}
+
+// The parts of the element a press would act on instead of it, as the
+// renderer read them: 1 px wider each way, as a landing keeps 1 px
+// inside an edge, and cut to the piece. None when no part of the piece clear
+// of them is at least an eighth of it: an element that is mostly its own
+// controls (a combobox's input, a card that is one link) is pressed as a
+// whole, and the reply says what took the press. A card whose image link
+// covers two thirds of it keeps them, and is pressed below the image; a row
+// whose link spans its middle three fifths, beside the link.
+void MoveSession::KeepHoles(const blink::mojom::AgentAimPiece& piece) {
+  holes_.clear();
+  for (const blink::mojom::AgentElementBoxPtr& box : piece.holes) {
+    if (holes_.size() >= kMaxHoles) {
+      break;
+    }
+    const PlannerRect r = BoxToRoot(box.get());
+    if (IsEmpty(r)) {
+      continue;
+    }
+    const PlannerRect hole =
+        Intersect(PlannerRect{r.x - kOnPiecePx, r.y - kOnPiecePx,
+                              r.w + 2 * kOnPiecePx, r.h + 2 * kOnPiecePx},
+                  piece_);
+    if (IsEmpty(hole)) {
+      continue;
+    }
+    holes_.push_back(hole);
+  }
+  if (!holes_.empty()) {
+    const PlannerRect clear = LargestClearPart(piece_, /*near_hand=*/false);
+    if (IsEmpty(clear) || clear.w * clear.h < piece_.w * piece_.h / 8) {
+      holes_.clear();
+    }
+  }
+}
+
+// The box, or -- its middle in one of the holes -- the part of it clear of
+// them all that a hand would take: large, and near it; the box when there is
+// none. A row whose link lies over its middle is pressed beside
+// the link, on the side the hand comes from unless the other is much larger.
+PlannerRect MoveSession::ClearPart(const PlannerRect& box) const {
+  if (holes_.empty() ||
+      !InAnyHole(holes_, PlannerPoint{box.x + box.w / 2, box.y + box.h / 2})) {
+    return box;
+  }
+  const PlannerRect clear = LargestClearPart(box, /*near_hand=*/true);
+  return IsEmpty(clear) ? box : clear;
+}
+
+// Of the box's parts clear of every hole and at least 8 px (or the box's side)
+// each way, the largest -- with `near_hand`, the best by its area over 1 +
+// its middle's distance from the hand in the box's longer side (a part 2 px
+// larger and twice as far loses to the near one), and less for a part
+// thinner than 16 px, by its thickness over 16 (a strip beside a control is
+// no place a hand aims for) -- of equal ones, the one whose middle is nearer
+// the hand; empty for none. Its edges are the box's and the holes'; a part
+// never scores below one it contains.
+PlannerRect MoveSession::LargestClearPart(const PlannerRect& box,
+                                          bool near_hand) const {
+  const double min_w = std::min(8.0, box.w);
+  const double min_h = std::min(8.0, box.h);
+  const double reach = std::max({box.w, box.h, 1.0});
+  const double thick = std::min({16.0, box.w, box.h});
+  std::vector<double> xs = {box.x, box.x + box.w};
+  std::vector<double> ys = {box.y, box.y + box.h};
+  for (const PlannerRect& r : holes_) {
+    xs.push_back(std::clamp(r.x, box.x, box.x + box.w));
+    xs.push_back(std::clamp(r.x + r.w, box.x, box.x + box.w));
+    ys.push_back(std::clamp(r.y, box.y, box.y + box.h));
+    ys.push_back(std::clamp(r.y + r.h, box.y, box.y + box.h));
+  }
+  std::sort(xs.begin(), xs.end());
+  xs.erase(std::unique(xs.begin(), xs.end()), xs.end());
+  std::sort(ys.begin(), ys.end());
+  ys.erase(std::unique(ys.begin(), ys.end()), ys.end());
+  PlannerRect best;
+  double best_score = -1;
+  double best_d = 0;
+  for (size_t i = 0; i < xs.size(); ++i) {
+    for (size_t j = i + 1; j < xs.size(); ++j) {
+      for (size_t k = 0; k < ys.size(); ++k) {
+        for (size_t l = k + 1; l < ys.size(); ++l) {
+          const PlannerRect c{xs[i], ys[k], xs[j] - xs[i], ys[l] - ys[k]};
+          if (c.w + 1e-6 < min_w || c.h + 1e-6 < min_h) {
+            continue;
+          }
+          bool clear = true;
+          for (const PlannerRect& r : holes_) {
+            if (c.x < r.x + r.w && c.x + c.w > r.x && c.y < r.y + r.h &&
+                c.y + c.h > r.y) {
+              clear = false;
+              break;
+            }
+          }
+          if (!clear) {
+            continue;
+          }
+          const double area = c.w * c.h;
+          const double d =
+              std::hypot(c.x + c.w / 2 - hand_.x, c.y + c.h / 2 - hand_.y);
+          const double score =
+              near_hand ? area / (1 + d / reach) *
+                              std::min(1.0, std::min(c.w, c.h) / thick)
+                        : area;
+          if (score > best_score + 1e-6 ||
+              (std::abs(score - best_score) <= 1e-6 && d < best_d)) {
+            best = c;
+            best_score = score;
+            best_d = d;
+          }
+        }
+      }
+    }
+  }
+  return best_score < 0 ? PlannerRect() : best;
+}
+
+// The boxes of the hover region the renderer read: in the root view,
+// cut to the view, at most kMaxRegionBoxes.
+void MoveSession::KeepRegion(const blink::mojom::AgentAimPiece& piece) {
+  region_.clear();
+  for (const blink::mojom::AgentElementBoxPtr& box : piece.hover_boxes) {
+    if (region_.size() >= kMaxRegionBoxes) {
+      break;
+    }
+    const PlannerRect r = Intersect(BoxToRoot(box.get()), params_.view);
+    if (!IsEmpty(r)) {
+      region_.push_back(r);
+    }
+  }
+}
+
+gfx::PointF MoveSession::HandInLocal() const {
+  gfx::PointF local(hand_.x, hand_.y);
+  RenderWidgetHostViewBase* view = LocalView();
+  RenderWidgetHostViewBase* root = view ? view->GetRootView() : nullptr;
+  if (root && root != view) {
+    root->TransformPointToCoordSpaceForView(gfx::PointF(hand_.x, hand_.y), view,
+                                            &local);
+  }
+  return local;
+}
+
+PlannerRect MoveSession::ShownBox() const {
+  const PlannerRect shown = Intersect(seen_box_, params_.view);
+  return IsEmpty(shown) ? piece_ : shown;
+}
+
+double MoveSession::WidthAlong(const PlannerRect& box,
+                               const PlannerPoint& to) const {
+  return WidthBetween(box, hand_, to);
+}
+
+std::string MoveSession::EndOutcome() const {
+  switch (params_.end_action) {
+    case EndAction::kPress:
+      return "pressed";
+    case EndAction::kRelease:
+      return "released";
+    case EndAction::kClick:
+      return "clicked";
+    case EndAction::kNone:
+      return "arrived";
+  }
+  NOTREACHED();
+}
+
+bool MoveSession::Presses() const {
+  return params_.end_action == EndAction::kPress ||
+         params_.end_action == EndAction::kClick;
+}
+
+void MoveSession::OnCoverNamed(bool page,
+                               const std::string& hit,
+                               int32_t hit_node_id,
+                               const std::string& value) {
+  if (answered()) {
+    return;
+  }
+  // The page's own content over a frame's element covers it as any of the
+  // page's content would; another frame's is said as such.
+  Answer("covered", page ? "covered" : "otherFrame", CoverName(page, hit));
+}
+
+RenderWidgetHostViewBase* MoveSession::ChildFrameView() const {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(params_.local_root);
+  if (!child_frame_ || !rfh) {
+    return nullptr;
+  }
+  FrameTreeNode* node = FrameTreeNodeFromDevToolsFrameToken(
+      rfh->frame_tree_node(), *child_frame_);
+  RenderFrameHostImpl* child = node ? node->current_frame_host() : nullptr;
+  return child && child->is_local_root() && child->IsRenderFrameLive()
+             ? child->GetView()
+             : nullptr;
+}
+
+// A frame element's frame in this process holds another process's: a press
+// landing in that one's view, or one inside it, lands in what it holds
+// -- the frame tree, up from the frame the hit landed in.
+bool MoveSession::InChildFrame(RenderWidgetHostViewBase* target) const {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(params_.local_root);
+  if (!child_frame_ || !rfh || !target) {
+    return false;
+  }
+  return LandsInFrame(handler_->LocalRootFor(target),
+                      FrameTreeNodeFromDevToolsFrameToken(
+                          rfh->frame_tree_node(), *child_frame_));
+}
+
+RenderWidgetHostViewBase* MoveSession::LocalView() const {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(params_.local_root);
+  return rfh && rfh->IsRenderFrameLive()
+             ? static_cast<RenderWidgetHostViewBase*>(rfh->GetView())
+             : nullptr;
+}
+
+// A point of the local root's widget, in the root view.
+PlannerPoint MoveSession::ToRoot(double x, double y) const {
+  RenderWidgetHostViewBase* view = LocalView();
+  if (!view) {
+    return PlannerPoint{x, y};
+  }
+  const gfx::PointF p =
+      view->TransformPointToRootCoordSpaceF(gfx::PointF(x, y));
+  return PlannerPoint{p.x(), p.y()};
+}
+
+PlannerRect MoveSession::BoxToRoot(
+    const blink::mojom::AgentElementBox* box) const {
+  if (!Finite(box)) {
+    return PlannerRect();
+  }
+  const PlannerPoint a = ToRoot(box->x, box->y);
+  const PlannerPoint b = ToRoot(box->x + box->width, box->y + box->height);
+  return PlannerRect{std::min(a.x, b.x), std::min(a.y, b.y),
+                     std::abs(b.x - a.x), std::abs(b.y - a.y)};
+}
+
+InputHandler::MousePathRequest MoveSession::Request(
+    std::vector<PlannerPoint> points) const {
+  InputHandler::MousePathRequest request;
+  request.points = std::move(points);
+  request.polling_rate_hz = planner_->polling_rate_hz();
+  request.modifiers = params_.modifiers;
+  request.button = params_.held_button;
+  return request;
+}
