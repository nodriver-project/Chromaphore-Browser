+
+// The hand: a seeded, persona-driven sigma-lognormal stroke planner
+// for the pointer movements the browser makes for an identity -- drags now,
+// clicks, hover and reveal moves with Input.moveTo. A leg is a sum of
+// truncated lognormal strokes in closed form (Plamondon's kinematic theory):
+// an optional onset creep (sometimes a longer, hesitant one); a primary with
+// a brake, aimed with the persona's error (sometimes a sloppy one, or a curvy
+// path); homing as a train of short, near-symmetric sub-movements, each
+// taking a share of what is still missing, the last landing exactly (or, for
+// a crisp move, the primary lands on the target). The primary's aim is never
+// behind kUnderMin of the way. Then a speed jitter (kJitterWaves sines, its
+// depth varying per move) and the band budget as smooth time-warps, the hand's
+// stop once it is within a few pixels of its end, the speed cap, the persona's
+// polling grid, and a tremor that fades in with speed (a mouse at rest does
+// not move).
+//
+// Calibrated against the SapiMouse dataset by a Python reference model,
+// which this file follows draw for draw: the same persona fields,
+// constants, order of draws and arithmetic, so the reference replays any
+// leg and requires every sample to agree within 1e-6 px. Keep them in
+// step: a change here is a change there.
+//
+// The persona comes from browser::MovementPersona::FromSeed with the
+// process's persona seed (browser::PersonaSeed()): one identity, one hand.
+// The per-movement variation is an std::mt19937_64 per planner.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_HUMAN_PATH_PLANNER_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_HUMAN_PATH_PLANNER_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <array>
+#include <optional>
+#include <random>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "components/browser/movement_persona.h"
+
+namespace content {
+
+// An action's intent: how long the move takes, how exact it is, and how long
+// the hand waits before pressing.
+enum class PathIntent { kDefault, kConfirm, kNavigate, kCasual, kPrecise };
+
+// A point of the planner's API, in doubles.
+struct PlannerPoint {
+  double x = 0;
+  double y = 0;
+};
+
+// A rectangle of the planner's API: x <= p.x <= x + w, the same for y.
+struct PlannerRect {
+  double x = 0;
+  double y = 0;
+  double w = 0;
+  double h = 0;
+};
+
+// One sample of a planned leg: where the pointer is at t_ms on the persona's
+// grid (i * 1000 / polling_rate_hz), and the band it is in (band_of(p), or 0
+// when the leg has no band map).
+struct PlannedPoint {
+  PlannerPoint p;
+  double t_ms = 0;
+  int band = 0;
+};
+
+// The hooks a leg is planned under. The defaults are a free move with an
+// exact end.
+struct LegConstraints {
+  LegConstraints();
+  LegConstraints(const LegConstraints&);
+  LegConstraints& operator=(const LegConstraints&);
+  ~LegConstraints();
+
+  // Corridor: free room in px on each side of the chord from -> to, measured
+  // along perp = (dy, -dx) / |d|: free_plus on the +perp side, free_minus on
+  // the -perp side. < 0 = unbounded. The leg's sweeps and lateral misses
+  // shrink, by one factor, until it keeps 5 px (3 of clearance, 2 of tremor)
+  // inside both.
+  double free_plus = -1;
+  double free_minus = -1;
+  // Band membership of a point: 0 = calm, else the id of the scroller whose
+  // autoscroll band holds it. May be null.
+  base::RepeatingCallback<int(const PlannerPoint&)> band_of;
+  // The most time any one run of in-band samples may take, its exit sample
+  // included: a run over it is crossed faster (a smooth time-warp), as far
+  // as max_speed allows.
+  double band_budget_ms = 100;
+  // A dart: one stroke from -> to, no creep, brake or homing; its 1-99 %
+  // span is dart_ms, or for dart_ms <= 0 the hand's own homing sub-movement
+  // (a nudge).
+  bool dart = false;
+  double dart_ms = 80;
+  // px/s: the hand already moves this fast along the chord at `from`, when
+  // entry_velocity is zero.
+  double entry_speed = 0;
+  // px/s: the hand's velocity at `from`; wins over entry_speed. Either one
+  // under 50 px/s starts from rest.
+  PlannerPoint entry_velocity;
+  // The last sample is `to` exactly, untremored.
+  bool exact_end = true;
+  // px/s: no dense step of the leg is faster. The hand's own peaks stay
+  // under it; it binds where the band budget would have the hand dash.
+  double max_speed = 20000;
+  // A button is held: the persona's drag tempo applies (held-button moves
+  // are slower).
+  bool button_held = false;
+  // Once the leg enters this region it does not leave it, and nothing past
+  // `to` along its chord lies outside it: a drag's overshoot stays over its
+  // drop zone (the brake and the forward misses shrink until it does).
+  std::optional<PlannerRect> hold;
+  // false: the leg never passes `to` along its chord (by more than half a
+  // pixel before the tremor).
+  bool overshoot = true;
+  // The leg stays inside this from its start to its end -- a hover region a
+  // pointer leaving would close, a menu: its sweeps, lateral misses,
+  // start, brake and forward misses shrink, as for the corridor and the hold,
+  // until it does, kCorridorMargin in from each edge (less where an end of
+  // the leg lies nearer). Both ends must be inside it.
+  std::optional<PlannerRect> keep;
+};
+
+class HumanPathPlanner {
+ public:
+  HumanPathPlanner(const browser::MovementPersona& persona,
+                   uint64_t variation_seed);
+  HumanPathPlanner(const HumanPathPlanner&) = delete;
+  HumanPathPlanner& operator=(const HumanPathPlanner&) = delete;
+  ~HumanPathPlanner();
+
+  // One leg from `from` to `to`. A leg shorter than 1 px is the single point
+  // `to`. Non-finite input plans nothing a hand could follow: the finite end
+  // alone, or no point at all.
+  std::vector<PlannedPoint> PlanLeg(const PlannerPoint& from,
+                                    const PlannerPoint& to,
+                                    double target_width,
+                                    PathIntent intent,
+                                    double speed_multiplier,
+                                    const LegConstraints& c);
+
+  // The hand's waits, drawn from the same stream as its legs. From the last
+  // move to the press; how long a click's button stays down; from one
+  // click's release to the next press; from a drag's arrival to its release;
+  // from a drag's press to its first move.
+  double PressDwellMs(PathIntent intent);
+  double ClickHoldMs();
+  double ClickGapMs();
+  double ReleaseDwellMs();
+  double PressLatencyMs();
+  // Where in `box` the hand presses, coming from `from`, `distance` away:
+  // around its middle with the persona's bias and drift, scattered on each
+  // screen axis by the extents of `sized_by` (what shows of the whole
+  // element; `box` may be the part of it a press reaches), a little longer
+  // along the approach, as people's presses are; kept
+  // min(1, w/4) inside and off `holes` (the parts of the element a press would
+  // act on instead of it), a draw outside or in one drawn again.
+  PlannerPoint ClickPoint(const PlannerRect& box,
+                          const PlannerRect& sized_by,
+                          const PlannerPoint& from,
+                          double distance,
+                          PathIntent intent,
+                          const std::vector<PlannerRect>& holes);
+
+  int polling_rate_hz() const;
+  const browser::MovementPersona& persona() const;
+
+ private:
+  static constexpr size_t kSubsMax = 6;
+  static constexpr size_t kJitterWaves = 18;
+
+  struct Vec {
+    double x = 0;
+    double y = 0;
+  };
+  // One lognormal stroke: its chord, sweep, onset, log time-scale and log
+  // response. A truncated one runs from F = 0 at its onset to F = 1, so it
+  // starts where it is put and ends exactly one chord on; the carry-in of an
+  // entry velocity is a plain one, already under way at t = 0, counted from
+  // there.
+  struct Stroke {
+    Stroke(double cx,
+           double cy,
+           double dth,
+           double t0,
+           double mu,
+           double sigma,
+           bool trunc);
+    double F(double t) const;
+    Vec Disp(double t) const;
+    double TAt(double f) const;
+
+    double cx = 0;
+    double cy = 0;
+    double dth = 0;
+    double t0 = 0;
+    double mu = 0;
+    double sigma = 0;
+    bool trunc = true;
+    bool straight = true;
+    double ths = 0;
+    double k = 0;
+    Vec at0;
+  };
+  struct SubDraft {
+    double sigma = 0;
+    double span = 0;
+    double along = 0;
+    double lat = 0;
+    double stop_roll = 0;
+    double stop = 0;
+    double overlap = 0;
+    double sweep = 0;
+    double gain = 0;
+  };
+  struct Wave {
+    double freq = 0;
+    double phase = 0;
+  };
+  // Every random draw of a leg, in a fixed order and count.
+  struct Draft {
+    bool start_in_band = false;
+    double entry_fe = 0;
+    double sigma = 0;
+    double span = 0;
+    double along = 0;
+    double lat = 0;
+    double side = 0;
+    double sweep = 0;
+    double creep_roll = 0;
+    double creep_lead = 0;
+    double creep_len_a = 0;
+    double creep_len_b = 0;
+    double creep_sweep = 0;
+    double brake = 0;
+    std::array<SubDraft, kSubsMax> subs;
+    std::array<Wave, kJitterWaves> jitter;
+    double hesitant = 0;
+    double hes_len = 0;
+    double hes_lead = 0;
+    double sloppy = 0;
+    double curvy = 0;
+    double crisp = 0;
+    double jit_depth = 0;  // the jitter's depth this move
+  };
+  // A leg's geometry: its chord, the chord's unit and normal (the corridor's
+  // perp), its heading, tempo and tolerance.
+  struct Geo {
+    Vec from;
+    Vec to;
+    double d = 0;
+    double ux = 0;
+    double uy = 0;
+    double nx = 0;
+    double ny = 0;
+    double theta = 0;
+    double tempo = 1;
+    double tol = 1.5;
+  };
+  // The hand's velocity at `from`: a unit direction and px/ms.
+  struct Entry {
+    double ex = 0;
+    double ey = 0;
+    double v = 0;
+  };
+  // A maximal run of one band id: first and last in-band index; the exit is
+  // the index after `last`, when there is one.
+  struct Run {
+    size_t first = 0;
+    size_t last = 0;
+    bool has_exit = false;
+  };
+  // An intent's tempo factor and its tolerance multiplier.
+  struct IntentTempo {
+    double factor = 1.0;
+    double tol_mult = 1.0;
+  };
+
+  // The variation stream: U in [0, 1) and a polar-method Gaussian with its
+  // cached second value.
+  double U();
+  double G();
+  double NoiseG();
+  static double Uniform(std::mt19937_64* engine);
+  static double Gaussian(std::mt19937_64* engine, std::optional<double>* next);
+
+  IntentTempo Intent(PathIntent intent);
+  Draft MakeDraft(const LegConstraints& c, const Vec& from);
+  static std::optional<Entry> EntryOf(const LegConstraints& c, const Geo& geo);
+  static std::optional<double> Room(const LegConstraints& c, int side);
+  static double SagittaCap(double chord, std::optional<double> room);
+  std::vector<Stroke> Build(const Draft& draft,
+                            const Geo& geo,
+                            const LegConstraints& c,
+                            double f,
+                            double g);
+  static std::vector<Vec> Dense(const std::vector<Stroke>& strokes,
+                                const Geo& geo);
+  static bool FitsCorridor(const std::vector<Vec>& dense,
+                           const Geo& geo,
+                           const LegConstraints& c);
+  static bool FitsHold(const std::vector<Vec>& dense,
+                       const Geo& geo,
+                       const LegConstraints& c);
+  static bool FitsKeep(const std::vector<Vec>& dense,
+                       const Geo& geo,
+                       const LegConstraints& c);
+  std::vector<double> Timing(const std::vector<Vec>& dense,
+                             const Draft& draft,
+                             const Geo& geo,
+                             const LegConstraints& c);
+  static std::vector<Vec> Sample(const std::vector<Vec>& dense,
+                                 const std::vector<double>& times,
+                                 double tick_ms);
+  std::vector<Vec> ApplyTremor(const std::vector<Vec>& samples, bool skip_last);
+  Vec TremorOffset(double time_sec, double velocity);
+  static void TrimRunsOnGrid(std::vector<Vec>* samples,
+                             const LegConstraints& c,
+                             double tick_ms);
+  static std::vector<Run> FindRuns(const std::vector<int>& bands);
+  static std::vector<Run> DenseRuns(const std::vector<int>& bands, size_t gap);
+  static int BandAt(const LegConstraints& c, const Vec& p);
+
+  const browser::MovementPersona persona_;
+  std::mt19937_64 variation_;
+  // The polar method's second value, kept for the stream's next Gaussian.
+  std::optional<double> next_gaussian_;
+  // Seeded by the variation stream's first draw.
+  std::mt19937_64 noise_;
+  std::optional<double> next_noise_;  // as next_gaussian_, for noise_
+};
+
+}  // namespace content
