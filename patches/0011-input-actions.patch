+
+ScrollResult::ScrollResult() = default;
+ScrollResult::ScrollResult(ScrollResult&&) = default;
+ScrollResult& ScrollResult::operator=(ScrollResult&&) = default;
+ScrollResult::~ScrollResult() = default;
+
+ScrollSession::Params::Params() = default;
+ScrollSession::Params::Params(const Params&) = default;
+ScrollSession::Params& ScrollSession::Params::operator=(const Params&) =
+    default;
+ScrollSession::Params::~Params() = default;
+
+ScrollSession::ScrollSession(InputHandler& handler,
+                             uint64_t id,
+                             Params params,
+                             Completion completion,
+                             base::OnceCallback<void(uint64_t)> on_done)
+    : handler_(handler),
+      id_(id),
+      params_(std::move(params)),
+      completion_(std::move(completion)),
+      on_done_(std::move(on_done)),
+      started_(base::TimeTicks::Now()),
+      at_(params_.at),
+      has_element_(params_.move.has_value()),
+      per_notch_(kNotchPx) {}
+
+ScrollSession::~ScrollSession() {
+  // The handler may be going too: nothing of it is asked.
+  if (completion_) {
+    // Its outcome watch is not asked either.
+    action_id_ = 0;
+    Send("interrupted", "the DevTools session ended before the scroll did",
+         std::string(), at_, /*wait=*/false);
+  }
+}
+
+base::WeakPtr<ScrollSession> ScrollSession::Weak() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void ScrollSession::Start() {
+  timeout_timer_.Start(FROM_HERE, params_.timeout,
+                       base::BindOnce(&ScrollSession::OnTimeout, Weak()));
+  if (params_.move) {
+    // Onto what shows of the element, the landing checked as a press there
+    // would be, and nothing pressed. Its answer can come before RunMove
+    // returns, and what follows sends more input: posted.
+    InputHandler::MoveRequest move = std::move(*params_.move);
+    params_.move.reset();
+    move.check_landing = true;
+    moving_ = true;
+    handler_->RunMove(std::move(move),
+                      base::BindPostTaskToCurrentDefault(
+                          base::BindOnce(&ScrollSession::OnMoved, Weak())));
+    return;
+  }
+  Find();
+}
+
+void ScrollSession::Interrupt() {
+  if (moving_) {
+    // The hand stops where it has got to (its answer, posted, finds this one
+    // answered).
+    handler_->InterruptMoveSession();
+  }
+  Answer("interrupted", "other input came for the pointer first");
+}
+
+void ScrollSession::OnMoved(MoveResult result) {
+  moving_ = false;
+  if (answered()) {
+    return;
+  }
+  if (std::optional<PlannerPoint> now = handler_->LastPointer()) {
+    at_ = gfx::PointF(now->x, now->y);
+  } else {
+    at_ =
+        gfx::PointF(result.x * params_.css_scale, result.y * params_.css_scale);
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  const std::string& outcome = result.outcome;
+  if (outcome == "arrived") {
+    // A hand that has just come to rest turns the wheel a moment later.
+    clock_.Start(FROM_HERE, RestPause(),
+                 base::BindOnce(&ScrollSession::Find, Weak()));
+    return;
+  }
+  if (outcome == "hidden" || outcome == "covered" || outcome == "gone" ||
+      outcome == "interrupted" || outcome == "timeout") {
+    // As the move said it: hidden's reason (notDisplayed, hidden, vanished,
+    // out of view), and what lies over the landing, with its verdict and the
+    // kind of an open layer it names.
+    Answer(outcome, result.reason, result.hit, result.hit_kind);
+    return;
+  }
+  // Unreachable: an inert element, under what takes the press there; else
+  // one the hand could not get onto -- it kept moving from under it, or the
+  // landing could not be hit-tested -- said in a sentence.
+  if (result.reason == "inert") {
+    // With what switched it off, and that layer's kind.
+    Answer("covered", result.reason, result.hit, result.hit_kind);
+    return;
+  }
+  Answer("unreachable", result.reason, result.hit);
+}
+
+void ScrollSession::Find() {
+  if (answered()) {
+    return;
+  }
+  RenderWidgetHostViewBase* root = handler_->GetRootView();
+  RenderWidgetHostImpl* root_host = root ? root->host() : nullptr;
+  if (!root || !root_host || !root_host->delegate()) {
+    Answer("gone", "the page's view went away");
+    return;
+  }
+  // The local root a notch there is routed to reads the scroller it latches.
+  root_host->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+      root, at_,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&ScrollSession::OnFindRouted, Weak()),
+          base::WeakPtr<RenderWidgetHostViewBase>(),
+          std::optional<gfx::PointF>()));
+}
+
+void ScrollSession::OnFindRouted(base::WeakPtr<RenderWidgetHostViewBase> target,
+                                 std::optional<gfx::PointF> point) {
+  if (answered()) {
+    return;
+  }
+  RenderWidgetHostViewBase* root = handler_->GetRootView();
+  if (!root) {
+    Answer("gone", "the page's view went away");
+    return;
+  }
+  RenderWidgetHostViewBase* view = root;
+  gfx::PointF local = at_;
+  if (target && point.has_value()) {
+    view = target.get();
+    local = *point;
+  }
+  collector_.reset();
+  RenderFrameHostImpl* rfh = handler_->BindCollectorFor(view, &collector_);
+  if (!rfh && view != root) {
+    view = root;
+    local = at_;
+    collector_.reset();
+    rfh = handler_->BindCollectorFor(root, &collector_);
+  }
+  if (!rfh) {
+    Answer("gone", "the page's renderer went away");
+    return;
+  }
+  local_root_ = rfh->GetGlobalId();
+  RenderFrameHostImpl* main = handler_->LocalRootFor(root);
+  main_root_ = main && main->GetGlobalId() == local_root_;
+  Ask(Read::kFind, /*scroller_id=*/0, /*check_latch=*/false, local,
+      /*settle_ms=*/0);
+}
+
+void ScrollSession::Ask(Read read,
+                        int32_t scroller_id,
+                        bool check_latch,
+                        const gfx::PointF& local,
+                        int settle_ms) {
+  if (!collector_.is_connected()) {
+    Answer("gone", "the page's renderer went away");
+    return;
+  }
+  collector_->WheelScrollerAt(
+      local.x(), local.y(), params_.vertical ? 1 : 2, params_.way > 0,
+      scroller_id, check_latch,
+      /*past_remote_frame=*/read == Read::kFindPast || past_frame_, settle_ms,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&ScrollSession::OnRead, Weak(), read),
+          blink::mojom::AgentWheelScrollerPtr()));
+}
+
+void ScrollSession::OnRead(Read read,
+                           blink::mojom::AgentWheelScrollerPtr scroller) {
+  if (answered()) {
+    return;
+  }
+  if (!scroller) {
+    Answer("gone", "the page's renderer went away");
+    return;
+  }
+  switch (read) {
+    case Read::kFind:
+    case Read::kFindPast:
+      OnFound(read, *scroller);
+      return;
+    case Read::kProgress:
+      OnProgress(*scroller);
+      return;
+    case Read::kLatch:
+      OnLatch(*scroller);
+      return;
+    case Read::kSettled:
+      OnSettled(*scroller);
+      return;
+  }
+}
+
+void ScrollSession::OnFound(Read read,
+                            const blink::mojom::AgentWheelScroller& s) {
+  const bool nothing = !s.found || (!s.can_move && s.is_window && s.max <= 0);
+  if ((!s.found || (!s.can_move && s.is_window)) && read == Read::kFind &&
+      !main_root_) {
+    // A frame of another process whose window has no room that way -- none
+    // at all, or at its end: the wheel chains out of it, to what holds its
+    // frame element in the page.
+    RenderWidgetHostViewBase* root = handler_->GetRootView();
+    collector_.reset();
+    RenderFrameHostImpl* rfh =
+        root ? handler_->BindCollectorFor(root, &collector_) : nullptr;
+    if (!rfh) {
+      Answer("gone", "the page's renderer went away");
+      return;
+    }
+    local_root_ = rfh->GetGlobalId();
+    main_root_ = true;
+    // From here on every reading looks past that frame, as the wheel goes.
+    past_frame_ = true;
+    Ask(Read::kFindPast, /*scroller_id=*/0, /*check_latch=*/false, at_,
+        /*settle_ms=*/0);
+    return;
+  }
+  if (nothing) {
+    // Nothing here scrolls that way, nor does the page: over the box with the
+    // most room that way, once, when asked to find one.
+    if (!has_element_ && params_.find_scroller && s.alt_found &&
+        finds_ < kMaxFinds) {
+      RenderWidgetHostViewBase* view = ScrollerView();
+      if (!view) {
+        Answer("gone", "the page's view went away");
+        return;
+      }
+      ++finds_;
+      moved_over_ = s.alt_name;
+      MoveHand(
+          view->TransformPointToRootCoordSpaceF(gfx::PointF(s.alt_x, s.alt_y)),
+          base::BindOnce(&ScrollSession::Find, Weak()));
+      return;
+    }
+    if (s.found) {
+      Note(s);
+    }
+    Answer("none");
+    return;
+  }
+  scroller_id_ = s.scroller_id;
+  Note(s);
+  if (!s.can_move) {
+    // At its end that way already: no notch is turned.
+    Answer("end");
+    return;
+  }
+  // The plan: the amount, or -- the scroller ends before it -- to its end, a
+  // notch at a time once near.
+  StartSpin(std::max(1, NotchesLeft()));
+}
+
+void ScrollSession::Note(const blink::mojom::AgentWheelScroller& s) {
+  WheelScrollerFigures figures = FiguresOf(s);
+  // A progress reading carries no name: the one read before stands, and a
+  // reading with a name of its own replaces it.
+  if (figures.name.empty() && after_ && !after_->name.empty()) {
+    figures.name = after_->name;
+  }
+  const bool page_figures = main_root_ && !s.is_top_window;
+  if (!before_) {
+    before_ = figures;
+    last_raw_ = figures.raw;
+    if (page_figures) {
+      page_before_ = s.window_position;
+    }
+  }
+  after_ = figures;
+  if (page_figures) {
+    page_now_ = s.window_position;
+  }
+  // Which moved first, the page or the scroller: not known when both did
+  // between two readings.
+  if (!have_moved_) {
+    const bool box_moved = std::abs(figures.raw - before_->raw) >= kMovedPx;
+    const bool page_moved = page_before_ && page_now_ &&
+                            std::abs(*page_now_ - *page_before_) >= kMovedPx;
+    if (box_moved || page_moved) {
+      have_moved_ = true;
+      if (box_moved != page_moved) {
+        page_first_ = page_moved;
+      }
+    }
+  }
+}
+
+double ScrollSession::Moved() const {
+  return before_ && after_ ? std::abs(after_->raw - before_->raw) : 0;
+}
+
+double ScrollSession::Room() const {
+  if (!after_) {
+    return 0;
+  }
+  return params_.way > 0 ? std::max(0.0, after_->max - after_->position)
+                         : std::max(0.0, after_->position);
+}
+
+bool ScrollSession::EndFirst() const {
+  return Room() < params_.amount - Moved();
+}
+
+int ScrollSession::NotchesLeft() const {
+  // Saturated, as the renderer's figures can be of any size; none are left
+  // once the scroll has gone past the amount.
+  const int notches =
+      EndFirst() ? base::ClampCeil(Room() / per_notch_)
+                 : base::ClampRound((params_.amount - Moved()) / per_notch_);
+  return std::max(0, notches);
+}
+
+void ScrollSession::StartSpin(int at_most) {
+  const bool flick = params_.pace == Pace::kFlick;
+  const int spin =
+      flick ? base::RandIntInclusive(5, 12) : base::RandIntInclusive(1, 3);
+  in_spin_ = std::max(1, std::min(spin, at_most));
+  Turn();
+}
+
+void ScrollSession::Turn() {
+  if (answered() || in_spin_ <= 0) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (sent_ == 0) {
+    // A wheel sequence still live where the pointer is, begun on the other
+    // axis or on another scroller (or one not known), keeps what it latched
+    // until it has rested: the notches would go to that, and move nothing
+    // here. A new sequence first, as a hand pauses before it
+    // turns the wheel for something else.
+    const InputHandler::WheelSequence& sequence = handler_->wheel_sequence();
+    const bool same = sequence.vertical == params_.vertical &&
+                      sequence.scroller_id != 0 &&
+                      sequence.scroller_id == scroller_id_ &&
+                      sequence.local_root == local_root_;
+    if (!sequence.last_notch.is_null() &&
+        now - sequence.last_notch < kSequenceRest &&
+        (at_ - sequence.began_at).Length() < kSequenceSlopDips && !same) {
+      clock_.Start(FROM_HERE, sequence.last_notch + NewSequenceGap() - now,
+                   base::BindOnce(&ScrollSession::Turn, Weak()));
+      // The page has had that long to move: read again before the notch.
+      check_latch_ = true;
+      return;
+    }
+  }
+  // Half a second or more since the last notch -- or the first notch after
+  // a wait, a breath or a hand move: it begins a new wheel sequence, which
+  // latches anew at the pointer. Sent once a reading has found the wheel
+  // there still latches this scroller.
+  if (check_latch_ || (sent_ > 0 && now - turned_at_.back() >= kSequenceRest &&
+                       latch_checked_after_ != turned_at_.back())) {
+    RenderWidgetHostViewBase* view = ScrollerView();
+    if (!view) {
+      Answer("gone", "the scroller's frame went away");
+      return;
+    }
+    check_latch_ = false;
+    if (sent_ > 0) {
+      latch_checked_after_ = turned_at_.back();
+    }
+    Ask(Read::kLatch, scroller_id_, /*check_latch=*/true, PointerIn(view),
+        /*settle_ms=*/0);
+    return;
+  }
+  if (sent_ == 0) {
+    // What the scroll leads to is watched from its first notch.
+    action_id_ = handler_->OutcomeWatch()->ArmWheel(local_root_,
+                                                    params_.follow_navigation);
+  }
+  if (!handler_->TurnWheel(at_, params_.vertical, params_.way,
+                           handler_->HeldButton())) {
+    // No notch went out: an action armed for it reached nothing of the page.
+    if (sent_ == 0 && action_id_) {
+      if (ActionOutcomeWatch* watch = handler_->outcome_watch()) {
+        watch->Abandon(action_id_);
+      }
+      action_id_ = 0;
+    }
+    Answer("gone", "the page's view went away");
+    return;
+  }
+  handler_->NoteWheelScroller(local_root_, scroller_id_);
+  ++sent_;
+  ++notches_since_settle_;
+  turned_at_.push_back(base::TimeTicks::Now());
+  --in_spin_;
+  const bool flick = params_.pace == Pace::kFlick;
+  if (in_spin_ > 0) {
+    // A spin's notches at a hand's pace.
+    clock_.Start(FROM_HERE, NotchGap(flick, params_.speed_multiplier),
+                 base::BindOnce(&ScrollSession::Turn, Weak()));
+    return;
+  }
+  // A breath after the spin, then a look at how far it went.
+  const double speed = params_.speed_multiplier;
+  clock_.Start(
+      FROM_HERE,
+      flick ? ScaledDelay(140, 319, speed) : ScaledDelay(280, 699, speed),
+      settling_ ? base::BindOnce(&ScrollSession::Settle, Weak())
+                : base::BindOnce(&ScrollSession::Look, Weak()));
+}
+
+void ScrollSession::Look() {
+  if (answered()) {
+    return;
+  }
+  RenderWidgetHostViewBase* view = ScrollerView();
+  if (!view) {
+    Answer("gone", "the scroller's frame went away");
+    return;
+  }
+  Ask(Read::kProgress, scroller_id_, /*check_latch=*/false, PointerIn(view),
+      /*settle_ms=*/0);
+}
+
+void ScrollSession::OnProgress(const blink::mojom::AgentWheelScroller& s) {
+  if (!s.found) {
+    Answer("gone", "the scroller is no longer in the page");
+    return;
+  }
+  const double last = last_raw_;
+  Note(s);
+  last_raw_ = s.raw;
+  if (!s.can_move) {
+    // At its end: the rest once it has run out.
+    Settle();
+    return;
+  }
+  if (std::abs(s.raw - last) < kMovedPx) {
+    // The spin moved nothing though there is room: one breath -- a new
+    // sequence -- and again; nothing again, as far as it got.
+    if (!breathed_) {
+      breathed_ = true;
+      check_latch_ = true;
+      const base::TimeTicks next = turned_at_.back() + NewSequenceGap();
+      clock_.Start(FROM_HERE,
+                   std::max(next - base::TimeTicks::Now(), base::TimeDelta()),
+                   base::BindOnce(&ScrollSession::Continue, Weak()));
+      return;
+    }
+    Settle();
+    return;
+  }
+  breathed_ = false;
+  Continue();
+}
+
+void ScrollSession::OnLatch(const blink::mojom::AgentWheelScroller& s) {
+  if (!s.found) {
+    Answer("gone", "the scroller is no longer in the page");
+    return;
+  }
+  Note(s);
+  if (!s.can_move) {
+    // At its end since the last reading: no notch more.
+    if (sent_ == 0) {
+      Answer("end");
+      return;
+    }
+    ending_ = true;
+    in_spin_ = 0;
+    Settle();
+    return;
+  }
+  if (s.latched) {
+    Turn();
+    return;
+  }
+  // The page brought another box under the still pointer: back over this
+  // scroller, where the wheel takes it, and read again there. Nowhere, or
+  // moved enough: no notch more, never into another box; it ends as far as
+  // it got.
+  RenderWidgetHostViewBase* view = ScrollerView();
+  if (s.place_found && view && hand_moves_ < kMaxHandMoves) {
+    ++hand_moves_;
+    check_latch_ = true;
+    MoveHand(view->TransformPointToRootCoordSpaceF(
+                 gfx::PointF(s.place_x, s.place_y)),
+             base::BindOnce(&ScrollSession::Turn, Weak()));
+    return;
+  }
+  ending_ = true;
+  in_spin_ = 0;
+  Settle();
+}
+
+void ScrollSession::Continue() {
+  if (answered()) {
+    return;
+  }
+  int in_flight = 0;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  for (const base::TimeTicks turned : turned_at_) {
+    if (now - turned < kInFlight) {
+      ++in_flight;
+    }
+  }
+  const int left = NotchesLeft() - in_flight;
+  if (left <= 1) {
+    Settle();
+    return;
+  }
+  StartSpin(left);
+}
+
+void ScrollSession::Settle() {
+  if (answered()) {
+    return;
+  }
+  settling_ = true;
+  RenderWidgetHostViewBase* view = ScrollerView();
+  if (!view) {
+    Answer("gone", "the scroller's frame went away");
+    return;
+  }
+  Ask(Read::kSettled, scroller_id_, /*check_latch=*/false, PointerIn(view),
+      kSettleMs);
+}
+
+void ScrollSession::OnSettled(const blink::mojom::AgentWheelScroller& s) {
+  if (!s.found) {
+    Answer("gone", "the scroller is no longer in the page");
+    return;
+  }
+  Note(s);
+  last_raw_ = s.raw;
+  // How far a notch moves it, from settled reading to settled reading.
+  const double from = settled_raw_.value_or(before_->raw);
+  const bool stalled = settled_raw_ && notches_since_settle_ >= 1 &&
+                       std::abs(s.raw - *settled_raw_) < kMovedPx;
+  if (notches_since_settle_ >= 1 && std::abs(s.raw - from) >= kMovedPx) {
+    per_notch_ = std::clamp(std::abs(s.raw - from) / notches_since_settle_,
+                            kMinPerNotch, kMaxPerNotch);
+  }
+  settled_raw_ = s.raw;
+  notches_since_settle_ = 0;
+  ++settle_rounds_;
+  if (ending_ || !s.can_move || settle_rounds_ > kMaxSettleRounds) {
+    Finish();
+    return;
+  }
+  if (stalled || (Moved() < kMovedPx && breathed_)) {
+    // A notch that moved nothing: one breath, then one more; nothing again,
+    // as far as it got.
+    if (!breathed_) {
+      breathed_ = true;
+      check_latch_ = true;
+      const base::TimeTicks next = turned_at_.back() + NewSequenceGap();
+      TurnOne(std::max(next - base::TimeTicks::Now(), base::TimeDelta()));
+      return;
+    }
+    Finish();
+    return;
+  }
+  // To its end when that comes first: a notch while it has room. Else the
+  // nearer of a notch more and none.
+  if (EndFirst() ? Room() >= kMovedPx
+                 : params_.amount - Moved() >= per_notch_ / 2) {
+    TurnOne(NotchGap(params_.pace == Pace::kFlick, params_.speed_multiplier));
+    return;
+  }
+  Finish();
+}
+
+void ScrollSession::TurnOne(base::TimeDelta after) {
+  in_spin_ = 1;
+  clock_.Start(FROM_HERE, after, base::BindOnce(&ScrollSession::Turn, Weak()));
+}
+
+void ScrollSession::MoveHand(const gfx::PointF& to, base::OnceClosure next) {
+  RenderWidgetHostViewBase* root = handler_->GetRootView();
+  if (!root) {
+    Answer("gone", "the page's view went away");
+    return;
+  }
+  const PlannerPoint from{at_.x(), at_.y()};
+  const PlannerPoint dest{to.x(), to.y()};
+  const gfx::Rect bounds = root->GetViewBounds();
+  LegConstraints c;
+  // A button held: the drag tempo, as a hand holding one moves.
+  c.button_held =
+      handler_->HeldButton() != SyntheticPointerActionParams::Button::NO_BUTTON;
+  BoundLegToView(from, dest,
+                 DragRect{0, 0, static_cast<double>(bounds.width()),
+                          static_cast<double>(bounds.height())},
+                 &c);
+  HumanPathPlanner& planner = handler_->HandPlanner();
+  InputHandler::MousePathRequest request;
+  for (const PlannedPoint& sample :
+       planner.PlanLeg(from, dest, kMoveWidthPx, PathIntent::kDefault,
+                       params_.speed_multiplier, c)) {
+    request.points.push_back(sample.p);
+  }
+  if (request.points.empty()) {
+    request.points.push_back(dest);
+  }
+  request.polling_rate_hz = planner.polling_rate_hz();
+  request.button = handler_->HeldButton();
+  // On the pixel nearest the place, where the next notch goes.
+  request.exact_end = true;
+  const bool queued = handler_->QueueMousePath(
+      std::move(request),
+      base::BindOnce(&ScrollSession::OnHandMoved, Weak(), std::move(next)));
+  // Refused, nothing moved: OnHandMoved hears so.
+  hand_refused_ = !queued;
+  if (!queued) {
+    return;
+  }
+  if (std::optional<PlannerPoint> now = handler_->LastPointer()) {
+    at_ = gfx::PointF(now->x, now->y);
+  }
+}
+
+void ScrollSession::OnHandMoved(base::OnceClosure next, bool ok) {
+  if (answered()) {
+    return;
+  }
+  if (!ok && hand_refused_) {
+    // The browser would not move the hand there: after notches, the scroll
+    // ends as far as it got; before any, nothing here scrolls that way.
+    if (sent_ > 0) {
+      ending_ = true;
+      in_spin_ = 0;
+      Settle();
+    } else {
+      Answer("none");
+    }
+    return;
+  }
+  if (!ok) {
+    Answer("gone", "the page's view went away during the move");
+    return;
+  }
+  // A hand that has just come to rest turns the wheel a moment later.
+  clock_.Start(FROM_HERE, RestPause(), std::move(next));
+}
+
+void ScrollSession::Finish() {
+  // Scrolled when it moved; still when the wheel turned and the scroller did
+  // not; none when it ended before any notch (the wheel at the pointer no
+  // longer took it).
+  if (Moved() >= kMovedPx) {
+    Answer("scrolled");
+    return;
+  }
+  Answer(sent_ > 0 ? "still" : "none");
+}
+
+void ScrollSession::OnTimeout() {
+  if (moving_) {
+    // The hand stops where it has got to (its answer, posted, finds this one
+    // answered).
+    handler_->InterruptMoveSession();
+  }
+  Answer("timeout", "the scroll took longer than its timeoutMs");
+}
+
+void ScrollSession::Answer(const std::string& outcome,
+                           const std::string& reason,
+                           const std::string& hit,
+                           const std::string& hit_kind) {
+  if (answered()) {
+    return;
+  }
+  gfx::PointF at = at_;
+  if (std::optional<PlannerPoint> now = handler_->LastPointer()) {
+    at = gfx::PointF(now->x, now->y);
+  }
+  // What the scroll led to is answered once settled when it ran its course;
+  // cut short (interrupted, timeout, gone) after a notch went out, at once
+  // with what is known, its later effects still told as they come.
+  Send(outcome, reason, hit, at,
+       /*wait=*/outcome == "scrolled" || outcome == "still", hit_kind);
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void ScrollSession::Fail(Response response) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  ScrollResult result;
+  result.failure = std::move(response);
+  std::move(completion).Run(std::move(result));
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void ScrollSession::Send(const std::string& outcome,
+                         const std::string& reason,
+                         const std::string& hit,
+                         const gfx::PointF& at,
+                         bool wait,
+                         const std::string& hit_kind) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  const double scale = params_.css_scale > 0 ? params_.css_scale : 1;
+  ScrollResult result;
+  result.outcome = outcome;
+  result.notches = sent_;
+  result.before = before_;
+  result.after = after_;
+  if (page_before_ && page_now_) {
+    result.page_before = page_before_;
+    result.page_after = page_now_;
+  }
+  result.page_first = page_first_;
+  result.moved_over = moved_over_;
+  result.hit = hit;
+  result.hit_kind = hit_kind;
+  result.reason = reason;
+  if (before_) {
+    result.scroller_id = scroller_id_;
+    // The scroller as a listing names it, when the document's id space holds
+    // it; looked up, never minted.
+    if (RenderFrameHostImpl* local = RenderFrameHostImpl::FromID(local_root_)) {
+      if (AgentIdSpace* space =
+              AgentIdSpace::Get(local->GetOutermostMainFrame())) {
+        if (const int id =
+                space->IdOfKey(AgentKey(local_root_, scroller_id_))) {
+          result.scroller_agent_node_id = id;
+          if (const AgentIdEntry* entry = space->Find(id)) {
+            result.scroller_label = entry->label;
+          }
+        } else if (!local->IsOutermostMainFrame()) {
+          // A page of another process scrolling its own window,
+          // which its renderer has no name for (the <iframe> holding it is in
+          // another process): named by that <iframe>, as the listing names it;
+          // where the renderer gave no name, by its role, never the page's own
+          // text, which reaches the agent only through the masked listing.
+          const AgentIdEntry* owner =
+              result.before && result.before->name.empty()
+                  ? space->FindChildFrameOwner(
+                        local->GetDevToolsFrameToken().ToString())
+                  : nullptr;
+          if (owner) {
+            result.scroller_agent_node_id = owner->agent_node_id;
+            result.scroller_label = owner->label;
+            for (std::optional<WheelScrollerFigures>* figures :
+                 {&result.before, &result.after}) {
+              if (*figures && (*figures)->name.empty()) {
+                (*figures)->name = owner->role;
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  result.pointer_x = at.x() / scale;
+  result.pointer_y = at.y() / scale;
+  result.duration_ms = (base::TimeTicks::Now() - started_).InMillisecondsF();
+  ActionOutcomeWatch::Reply(
+      action_id_ ? handler_->outcome_watch() : nullptr, action_id_,
+      base::BindOnce(
+          [](Completion completion, ScrollResult result,
+             std::unique_ptr<Page::ActionOutcome> action_outcome) {
+            result.action_outcome = std::move(action_outcome);
+            std::move(completion).Run(std::move(result));
+          },
+          std::move(completion), std::move(result)),
+      wait);
+}
+
+RenderWidgetHostViewBase* ScrollSession::ScrollerView() const {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(local_root_);
+  return rfh && rfh->IsRenderFrameLive()
+             ? static_cast<RenderWidgetHostViewBase*>(rfh->GetView())
+             : nullptr;
+}
+
+gfx::PointF ScrollSession::PointerIn(RenderWidgetHostViewBase* view) const {
+  gfx::PointF local = at_;
+  RenderWidgetHostViewBase* root = handler_->GetRootView();
+  if (root && view && view != root) {
+    root->TransformPointToCoordSpaceForView(at_, view, &local);
+  }
+  return local;
+}
+
+}  // namespace content::protocol
