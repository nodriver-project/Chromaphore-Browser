+// browser: whether the action took the page to another document -- an
+// Enter that submitted -- so no field after it is the one. A navigation under
+// way before the action, or one that failed, left the page where it was.
+bool LeftDocument(Page::ActionOutcome* outcome) {
+  if (!outcome || !outcome->GetEvents()) {
+    return false;
+  }
+  for (const auto& event : *outcome->GetEvents()) {
+    if (event->GetKind() == "navigation" && !event->GetSameDocument(false) &&
+        !event->GetStartedBeforeAction(false) &&
+        event->GetState(std::string()) != "failed") {
+      return true;
+    }
+  }
+  return false;
+}
