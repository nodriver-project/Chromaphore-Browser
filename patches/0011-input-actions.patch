+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// What an input action led to, from the browser's own events: a navigation of
+// this tab (started, committed or failed, same-document or not), a new tab it
+// opened, a popup Chrome refused it, and a print a frame of it asked for. One
+// per DevTools session, owned by its InputHandler; it asks the page nothing.
+//
+// Each command that presses, releases, clicks, types, picks, drops or scrolls
+// arms it at its first effectful event (ArmMouse, ArmKeys, ArmSelect, ArmDrop,
+// ArmWheel): a new action id, and the action before it ends. The command's
+// answer is handed here (Settle) and goes out once the renderer has answered
+// for the action's last event (its ack, at most kHandledCap after the events
+// left), a grace for what travels on other pipes (kGrace), and -- with
+// followNavigation -- a cross-document navigation the action started followed
+// to its end (at most kCommitCap). The answer carries what was seen so far
+// (Page.ActionOutcome); what follows goes out as Input.actionOutcome, one event
+// a transition, until the next action arms the watch.
+//
+// Reported: every navigation the page started (renderer-initiated, or a
+// history navigation the browser starts again for it) in the primary main
+// frame while armed -- not the browser's own, such as an error page's
+// auto-reload -- and one already under way at the arm, whatever started
+// it (startedBeforeAction); a subframe's only
+// when the action was inside that frame -- keys: the focused frame or an
+// ancestor below the main frame; a press, pick, drop or scroll: a frame in the
+// acting local root's subtree, navigated by itself or a frame inside it. Never
+// a prerendered or fenced page's. Every new tab this tab opened
+// (DidOpenRequestedURL), every popup Chrome refused it
+// (devtools_instrumentation::DidBlockPopup), and every print a frame of it
+// asked for, as the print manager took it (DidRequestScriptedPrint): the page
+// waits in print() from then, and an action's ack with it, so it is told
+// before the page can answer.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_ACTION_OUTCOME_WATCH_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_ACTION_OUTCOME_WATCH_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/containers/flat_map.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/browser/devtools/protocol/page.h"
+#include "content/common/input/synthetic_mouse_path_gesture_params.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_observer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace content {
+
+class DevToolsSession;
+class NavigationHandle;
+class WebContents;
+
+namespace protocol {
+
+class SettleArm;
+
+class ActionOutcomeWatch : public WebContentsObserver,
+                           public RenderWidgetHost::InputEventObserver,
+                           public RenderWidgetHostObserver {
+ public:
+  // Runs with what an action led to, as its command's answer carries it;
+  // null when the command armed nothing.
+  using ReplyCallback =
+      base::OnceCallback<void(std::unique_ptr<Page::ActionOutcome>)>;
+  // A late event: something an action led to after its answer.
+  using LateCallback =
+      base::RepeatingCallback<void(int action_id,
+                                   std::unique_ptr<Page::ActionEvent> event)>;
+
+  // The watch of `session`'s InputHandler (the agent's own navigations, through
+  // Page, disarm it): made when `make`; null when the session has no Input
+  // domain, or none was made.
+  static ActionOutcomeWatch* ForSession(DevToolsSession* session, bool make);
+  // The agent's own navigation (Page.navigate, reload, navigateToHistoryEntry)
+  // is not an action's: the session's watch, if any, is disarmed.
+  static void DisarmFor(DevToolsSession* session);
+  // `reply` runs with what action `action_id` led to: once it has settled
+  // (Settle), or at once with what is known (`wait` false). With no watch,
+  // or an action id of 0 (the call armed nothing), at once with none.
+  static void Reply(ActionOutcomeWatch* watch,
+                    int action_id,
+                    ReplyCallback reply,
+                    bool wait = true);
+
+  // `on_late` hears the late events (the client's frontend). It is never
+  // called from the destructor.
+  explicit ActionOutcomeWatch(LateCallback on_late);
+  ActionOutcomeWatch(const ActionOutcomeWatch&) = delete;
+  ActionOutcomeWatch& operator=(const ActionOutcomeWatch&) = delete;
+  // An answer still waiting goes out with what is known.
+  ~ActionOutcomeWatch() override;
+
+  // The tab watched. Another one ends the action under way (its answer goes
+  // out with what is known); the same one, or none, changes nothing.
+  void SetWebContents(WebContents* contents);
+
+  // Arming: each returns the new action's id (0: nothing armed, with no tab
+  // watched), counted up browser-wide, so a watch made again (Input.disable
+  // resets it) never gives one a command still playing out holds. The action
+  // before it ends: an answer it was waiting on goes out now, and its late
+  // events stop.
+  //
+  // A press (its mousedown's ack ends it), a release (its mouseup's) or
+  // clicks (`click_count` mouseups'), on whichever of the tab's widgets the
+  // event is routed to; the acting local root is the one the first press
+  // or release goes to. kNone arms nothing.
+  int ArmMouse(SyntheticMousePathGestureParams::EndAction end,
+               int click_count,
+               bool follow_navigation);
+  // Keys typed on `widget`: the last keyup's ack ends it. The acting frame
+  // is the focused frame now.
+  int ArmKeys(RenderWidgetHost* widget, bool follow_navigation);
+  // The pick in a select in `local_root` (Input.selectOptions), armed right
+  // before it: the command settling it (Settle) ends it.
+  int ArmSelect(GlobalRenderFrameHostId local_root, bool follow_navigation);
+  // A scroll by the wheel in `local_root` (Input.scrollBy), dispatched now, as
+  // its first notch goes out: the command settling it (Settle, once the
+  // scroll has come to rest) ends it.
+  int ArmWheel(GlobalRenderFrameHostId local_root, bool follow_navigation);
+  // A native drop: DropSent dispatches it, and the page's answer ends it.
+  int ArmDrop(bool follow_navigation);
+  // The armed drop goes to `target` now: the closure, given to
+  // DragTargetDrop, runs with the page's answer. Does nothing with no drop
+  // armed.
+  base::OnceClosure DropSent(RenderWidgetHost* target);
+
+  // The command's events have left: `reply` runs once the action is handled
+  // (or kHandledCap has passed), the grace is over, and -- if the action asked
+  // -- a cross-document navigation it started has ended (or kCommitCap has
+  // passed). Not `wait`: at once, with what is known. An action already
+  // answered, ended or unknown is answered at once, with what it had led to
+  // when the next one armed (or none).
+  void Settle(int action_id, ReplyCallback reply, bool wait = true);
+  // The command failed after arming (a typing session aborted, a mouse path
+  // that did not play): the action is dropped, with no answer and no late
+  // events, if it is the one under way.
+  void Abandon(int action_id);
+  // The action under way ends: an answer it was waiting on goes out with what
+  // is known, and its late events stop.
+  void Disarm();
+
+  // Chrome refused a popup a frame of this page asked for.
+  void DidBlockPopup(const GURL& url, WindowOpenDisposition disposition);
+
+  // browser: the settle (settle_join.h). Every arm above arms it
+  // too, with the action's id and its arm time as T. ArmSettle arms it alone
+  // (Page.agentSettleArm, an agentSettle with no armId): a new id, while the
+  // action under way and its late events go on; 0 with no tab watched. The
+  // settle's arm is kept apart from the action: the agent's own navigations
+  // (Disarm) leave it, as a navigate between agentSettleArm and agentSettle
+  // is what it waits for. browser: `look` for an agentSettle with no
+  // armId, a look and not an action: the renderers keep what the regions
+  // said since the last action. The arms above and agentSettleArm's are
+  // actions.
+  int ArmSettle(bool look);
+  SettleArm& settle_arm();
+  // A navigation the settle of action `action_id` waits for, still under way:
+  // the primary main frame's cross-document one, whatever started it (as an
+  // arm finds it), or a subframe's reported for that action. Its URL; none:
+  // nullopt.
+  std::optional<GURL> PendingNavigation(int action_id) const;
+
+  base::WeakPtr<ActionOutcomeWatch> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  enum class Kind { kMouse, kKeys, kSelect, kDrop, kWheel };
+  // Where an answer waiting stands.
+  enum class Step { kNone, kHandled, kGrace, kFollow };
+
+  // One thing the action led to, kept until it is reported.
+  struct Item {
+    enum class Type { kNavigation, kNewTab, kPopupBlocked, kPrint };
+    Item();
+    Item(Item&&);
+    Item& operator=(Item&&);
+    ~Item();
+
+    Type type = Type::kNavigation;
+    // When it reached its last state.
+    base::TimeTicks at;
+    // kNavigation.
+    int64_t navigation_id = 0;
+    std::string state;
+    GURL url;
+    bool same_document = false;
+    bool main_frame = false;
+    bool before_action = false;
+    bool finished = false;
+    // kNavigation: the frame navigated; kPrint: the frame that asked.
+    std::string frame_id;
+    std::string error_text;
+    bool is_download = false;
+    // kNewTab: the tab, checked at answer time; kNewTab and kPopupBlocked:
+    // the disposition asked for.
+    base::WeakPtr<WebContents> tab;
+    std::string target_id;
+    WindowOpenDisposition disposition = WindowOpenDisposition::UNKNOWN;
+  };
+
+  // An awaited event dispatched since the arm, until its ack.
+  struct Sent {
+    raw_ptr<const RenderWidgetHost> widget;
+    blink::WebInputEvent::Type type;
+    base::TimeTicks time;
+  };
+
+  struct Action {
+    Action();
+    ~Action();
+
+    int id = 0;
+    Kind kind = Kind::kMouse;
+    bool follow_navigation = true;
+    // kMouse, kKeys: the event whose ack ends it, and (kMouse) how many.
+    blink::WebInputEvent::Type awaited = blink::WebInputEvent::Type::kUndefined;
+    int count = 1;
+    base::TimeTicks armed_at;
+    // The action's dispatch (atMs 0): its first press or release, its first
+    // key, the pick, the drop, the first notch. Null until then.
+    base::TimeTicks dispatched_at;
+    // The acting frame. kKeys: the focused frame and its ancestors below
+    // the main frame; else the local root the action went to.
+    std::vector<FrameTreeNodeId> focus_chain;
+    GlobalRenderFrameHostId local_root;
+    // The awaited events on their way, the acks heard, and (kSelect, kDrop,
+    // kWheel) the reply.
+    std::vector<Sent> in_flight;
+    int acked = 0;
+    bool replied = false;
+    bool handled = false;
+    // What it led to before its answer, in the order seen.
+    std::vector<Item> items;
+    // The answer waiting, and where it stands.
+    ReplyCallback reply;
+    Step step = Step::kNone;
+    base::OneShotTimer timer;
+    bool answered = false;
+    // After the answer: navigations still to report an end for, the late
+    // events sent, and a same-document one held back.
+    base::flat_map<int64_t, Item> late_navigations;
+    int late_sent = 0;
+    std::unique_ptr<Page::ActionEvent> held_same_document;
+    base::TimeTicks last_same_document_sent;
+    base::OneShotTimer same_document_timer;
+  };
+
+  // WebContentsObserver:
+  void DidStartNavigation(NavigationHandle* navigation_handle) override;
+  void DidRedirectNavigation(NavigationHandle* navigation_handle) override;
+  void DidFinishNavigation(NavigationHandle* navigation_handle) override;
+  void DidOpenRequestedURL(WebContents* new_contents,
+                           RenderFrameHost* source_render_frame_host,
+                           const GURL& url,
+                           const Referrer& referrer,
+                           WindowOpenDisposition disposition,
+                           ui::PageTransition transition,
+                           bool started_from_context_menu,
+                           bool renderer_initiated) override;
+  void DidRequestScriptedPrint(RenderFrameHost* render_frame_host) override;
+  void WebContentsDestroyed() override;
+
+  // RenderWidgetHost::InputEventObserver:
+  void OnInputEvent(const RenderWidgetHost& host,
+                    const blink::WebInputEvent& event,
+                    InputEventSource source) override;
+  void OnInputEventAck(const RenderWidgetHost& host,
+                       blink::mojom::InputEventResultSource source,
+                       blink::mojom::InputEventResultState state,
+                       const blink::WebInputEvent& event) override;
+
+  // RenderWidgetHostObserver:
+  void RenderWidgetHostDestroyed(RenderWidgetHost* widget_host) override;
+
+  // A new action of `kind`; the one before it ends.
+  Action& Begin(Kind kind, bool follow_navigation);
+  // The action under way ends: an answer it waits on goes out (unless
+  // `destroying`, also with what is known); one never settled is kept for
+  // its Settle (superseded_). Its late events stop.
+  void EndCurrent(bool destroying);
+  // The action `action_id`, if it is under way and not yet answered.
+  Action* Unanswered(int action_id);
+  // Its last event answered for, or a cross-document navigation it
+  // started: the page acted on it.
+  bool Handled(const Action& action) const;
+  // An ack or a reply came: the wait for it ends once nothing is awaited.
+  void MaybeHandled(Action& action);
+  void OnHandledCap();
+  void StartGrace(Action& action);
+  void OnGraceOver();
+  void OnCommitCap();
+  // A cross-document navigation the action started is still under way.
+  bool Following(const Action& action) const;
+  void MaybeFollowed(Action& action);
+  // The answer: built, the action marked answered, and what is still under
+  // way carried on as late.
+  std::unique_ptr<Page::ActionOutcome> Answered(Action& action);
+  void SendAnswer(Action& action);
+  std::unique_ptr<Page::ActionOutcome> TakeSuperseded(int action_id);
+  void OnDropAnswered(int action_id);
+
+  // Whether a navigation is the action's to report.
+  bool Reportable(const Action& action, NavigationHandle* handle) const;
+  Item NavigationItem(NavigationHandle* handle) const;
+  void Finish(Item& item, NavigationHandle* handle) const;
+  // Before the answer: kept, at most kMaxItems; a same-document navigation
+  // of a frame replaces that frame's last one.
+  void AddItem(Action& action, Item item);
+  Item* FindItem(Action& action, int64_t navigation_id);
+  std::unique_ptr<Page::ActionEvent> ToEvent(const Action& action,
+                                             const Item& item) const;
+  // After the answer: sent, at most kMaxLateEvents an action; same-document
+  // ones coalesced to the last per kSameDocumentWindow.
+  void SendLate(Action& action, std::unique_ptr<Page::ActionEvent> event);
+  void SendLateSameDocument(Action& action,
+                            std::unique_ptr<Page::ActionEvent> event);
+  void FlushSameDocument();
+
+  // The tab's widgets (frames' and popups'), or one, watched for acks until
+  // the action is handled.
+  void WatchTabWidgets();
+  void WatchWidget(RenderWidgetHost* widget);
+  void StopWatchingWidgets();
+  GlobalRenderFrameHostId LocalRootOf(const RenderWidgetHost& widget) const;
+
+  LateCallback on_late_;
+  // The settle's arm.
+  std::unique_ptr<SettleArm> settle_arm_;
+  std::unique_ptr<Action> action_;
+  // Actions ended before their command settled them: what they had led to,
+  // for that Settle (the newest few).
+  std::vector<std::pair<int, std::unique_ptr<Page::ActionOutcome>>> superseded_;
+  std::vector<raw_ptr<RenderWidgetHost>> watched_;
+  // The primary main frame's cross-document navigations under way, whatever
+  // is armed: one still under way when an action arms is reported with it.
+  struct UnderWay {
+    GURL url;
+    base::TimeTicks started;
+    std::string frame_id;
+  };
+  base::flat_map<int64_t, UnderWay> under_way_;
+  base::WeakPtrFactory<ActionOutcomeWatch> weak_factory_{this};
+};
+
+}  // namespace protocol
+}  // namespace content
