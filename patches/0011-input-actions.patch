+    double* overshoot_probability,
+    double* idle_drift_amplitude,
+    double* peak_velocity_position,
+    double* fitts_a,
+    double* fitts_b,
+    double* fitts_noise,
+    double* click_drift_amplitude,
+    double* click_hold_mean_ms,
+    double* click_hold_sd_ms,
+    double* activity_density_threshold,
+    double* keyboard_to_mouse_delay_ms,
+    double* mouse_to_keyboard_delay_ms,
+    double* post_idle_slowdown_threshold_ms,
+    double* first_interaction_delay_ms,
+    double* drift_interval_ms,
+    double* drift_radius,
+    double* drift_correlation,
+    double* grip_shift_interval_ms,
+    double* grip_shift_size,
+    double* scroll_momentum_decay,
