+// browser: Input.fillDateTime: checked, then carried out by a
+// TemporalSession, which answers once through AnswerFillDateTime.
+void InputHandler::FillDateTime(
+    int backend_node_id,
+    const std::string& frame_id,
+    const std::string& value,
+    std::optional<std::string> intent,
+    std::optional<double> speed_multiplier,
+    std::optional<double> timeout_ms,
+    std::optional<double> pointer_x,
+    std::optional<double> pointer_y,
+    std::optional<bool> follow_navigation,
+    std::unique_ptr<FillDateTimeCallback> callback) {
+  TemporalSession::Completion completion =
+      AnswerFillDateTime(std::move(callback));
+  // Other pointer input: a reveal, a drag, a move, a scroll, a select and a
+  // fill under way end first.
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  InterruptAllSessions();
+  if (std::optional<Response> refusal = CheckActionCall(
+          "Input.fillDateTime", /*refuse_held_drag=*/true,
+          {&speed_multiplier, &timeout_ms, &pointer_x, &pointer_y})) {
+    FailTemporal(std::move(completion), *refusal);
+    return;
+  }
+  if (backend_node_id <= 0 || frame_id.empty()) {
+    FailTemporal(std::move(completion),
+                 Response::InvalidParams(
+                     "'backendNodeId' and 'frameId' must name the field"));
+    return;
+  }
+  if (value.empty()) {
+    FailTemporal(std::move(completion),
+                 Response::InvalidParams("'value' must give the value"));
+    return;
+  }
+  if (!ParsePathIntent(intent.value_or("default"))) {
+    FailTemporal(std::move(completion), BadIntent());
+    return;
+  }
+  if (std::optional<Response> refusal =
+          CheckSpeedMultiplier(speed_multiplier)) {
+    FailTemporal(std::move(completion), *refusal);
+    return;
+  }
+  TemporalSession::Params params;
+  params.node_id = backend_node_id;
+  params.frame_id = frame_id;
+  params.value = value;
+  params.intent = std::move(intent);
+  params.speed_multiplier = speed_multiplier.value_or(1);
+  params.timeout = base::Milliseconds(
+      ClampTimeout(timeout_ms, kActionTimeoutMs, kActionTimeoutMaxMs));
+  params.pointer_x = pointer_x;
+  params.pointer_y = pointer_y;
+  params.css_scale = CssScaleOrOne();
+  params.follow_navigation = follow_navigation.value_or(true);
+  // An answer run on the way here started another fill: it must post.
+  DCHECK(!temporal_session_);
+  temporal_session_ = std::make_unique<TemporalSession>(
+      *this, ++last_temporal_session_id_, std::move(params),
+      std::move(completion),
