+
+// The width a hand aims a move at: the box's shorter side, or `fallback`.
+double MinSide(const DragRect& r, double fallback) {
+  const double side = std::min(r.w, r.h);
+  return side >= 1 ? side : fallback;
+}
+
+// A box 2 px in, or as far in as a box too thin for that allows.
+DragRect LandingInset(const DragRect& box) {
+  return box.Inset(std::clamp((box.w - 1) / 2, 0.0, 2.0),
+                   std::clamp((box.h - 1) / 2, 0.0, 2.0));
+}
+
+// Whether `band` can still scroll along an axis (vertical, else across)
+// the way `way` says (positive: down or right).
+bool HasRoom(const DragBand& band, bool vertical, int way) {
+  if (vertical) {
+    return way > 0 ? band.down : band.up;
+  }
+  return way > 0 ? band.right : band.left;
+}
+
+bool BoxMoved(const DragRect& a, const DragRect& b) {
+  return std::abs(a.x - b.x) >= 1 || std::abs(a.y - b.y) >= 1 ||
+         std::abs(a.w - b.w) >= 1 || std::abs(a.h - b.h) >= 1;
+}
+
+// Whether any part of the segment a-b lies inside r (Liang-Barsky).
+bool SegmentHits(const PlannerPoint& a,
+                 const PlannerPoint& b,
+                 const DragRect& r) {
+  if (r.IsEmpty()) {
+    return false;
+  }
+  const double dx = b.x - a.x;
+  const double dy = b.y - a.y;
+  const std::array<double, 4> p = {-dx, dx, -dy, dy};
+  const std::array<double, 4> q = {a.x - r.x, r.right() - a.x, a.y - r.y,
+                                   r.bottom() - a.y};
+  double t0 = 0;
+  double t1 = 1;
+  for (size_t i = 0; i < p.size(); ++i) {
+    if (p[i] == 0) {
+      if (q[i] < 0) {
+        return false;
+      }
+      continue;
+    }
+    const double t = q[i] / p[i];
+    if (p[i] < 0) {
+      t0 = std::max(t0, t);
+    } else {
+      t1 = std::min(t1, t);
+    }
+    if (t0 > t1) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// How far p lies outside r: 0 inside it or on its edge.
+double DistanceTo(const DragRect& r, const PlannerPoint& p) {
+  const double dx = std::max({0.0, r.x - p.x, p.x - r.right()});
+  const double dy = std::max({0.0, r.y - p.y, p.y - r.bottom()});
+  return std::hypot(dx, dy);
+}
+
+// The corners to go by from `from` to `to` (both outside `box`) when the
+// straight way crosses the box: the shortest way through one of the box's
+// corners, or two adjacent ones, `out` px off it, whose every stretch keeps
+// clear of the box. Empty when the straight way is clear, or no such way
+// is found (the straight way is measured as any other).
+std::vector<PlannerPoint> AroundBox(const DragRect& box,
+                                    double out,
+                                    const PlannerPoint& from,
+                                    const PlannerPoint& to) {
+  const DragRect core = box.Inset(1, 1);
+  if (!SegmentHits(from, to, core)) {
+    return {};
+  }
+  const DragRect ring{box.x - out, box.y - out, box.w + 2 * out,
+                      box.h + 2 * out};
+  const std::array<PlannerPoint, 4> corners = {{{ring.x, ring.y},
+                                                {ring.right(), ring.y},
+                                                {ring.right(), ring.bottom()},
+                                                {ring.x, ring.bottom()}}};
+  std::vector<PlannerPoint> best;
+  double best_length = kNoRoom;
+  const auto consider = [&](std::vector<PlannerPoint> way) {
+    PlannerPoint at = from;
+    double length = 0;
+    for (const PlannerPoint& corner : way) {
+      if (SegmentHits(at, corner, core)) {
+        return;
+      }
+      length += Distance(at, corner);
+      at = corner;
+    }
+    if (SegmentHits(at, to, core)) {
+      return;
+    }
+    length += Distance(at, to);
+    if (length < best_length) {
+      best_length = length;
+      best = std::move(way);
+    }
+  };
+  for (size_t i = 0; i < corners.size(); ++i) {
+    const PlannerPoint& next = corners[(i + 1) % corners.size()];
+    consider({corners[i]});
+    consider({corners[i], next});
+    consider({next, corners[i]});
+  }
+  return best;
+}
+
+// How far a leg strays in the lane's box: the length of its way
+// inside the box -- not on the box's own edge (its border, 3 px), not in
+// the last 4 px into the end (the hand settling) -- over no strip (more
+// than 0.5 px off every one); 0 when it keeps to them. A length, not a
+// depth: a way that grazes a corner of the box strays far less than one
+// that climbs the target's column through the rows under it.
+double LaneStray(const std::vector<PlannedPoint>& leg,
+                 const DragSession::Lane& lane) {
+  const DragRect inside = lane.region.Inset(kLaneEdgePx, kLaneEdgePx);
+  double length = 0;
+  for (size_t i = 1; i < leg.size(); ++i) {
+    const PlannerPoint& p = leg[i].p;
+    if (!inside.Contains(p) || Distance(p, leg.back().p) < kLaneEndPx) {
+      continue;
+    }
+    double off = kNoRoom;
+    for (const DragSession::LaneStrip& strip : lane.strips) {
+      off = std::min(off, DistanceTo(strip.rect, p));
+    }
+    if (off > kLaneSlackPx) {
+      length += Distance(leg[i - 1].p, p);
+    }
+  }
+  return length;
+}
+
+// A leg along a lane: its bow, either side of the chord, held to the room
+// the strip it enters the box on leaves -- within a row's height, a
+// column's width -- measured at the chord's entry into the box and at its
+// end. Nothing when the chord enters the box off every strip.
+void BoundToLane(const PlannerPoint& from,
+                 const PlannerPoint& to,
+                 const DragSession::Lane& lane,
+                 LegConstraints* c) {
+  const double dx = to.x - from.x;
+  const double dy = to.y - from.y;
+  const double length = std::hypot(dx, dy);
+  if (length < 1) {
+    return;
+  }
+  PlannerPoint entry = to;
+  const int steps = static_cast<int>(std::ceil(length));
+  for (int i = 0; i <= steps; ++i) {
+    const double f = static_cast<double>(i) / steps;
+    const PlannerPoint q{from.x + dx * f, from.y + dy * f};
+    if (lane.region.Contains(q)) {
+      entry = q;
+      break;
+    }
+  }
+  const DragSession::LaneStrip* strip = nullptr;
+  for (const DragSession::LaneStrip& s : lane.strips) {
+    if (DistanceTo(s.rect, entry) < 0.5) {
+      strip = &s;
+      break;
+    }
+  }
+  if (!strip) {
+    return;
+  }
+  const bool row = strip->row;
+  const DragRect& t = strip->rect;
+  // The room toward the unit normal (nx, ny) before the strip's edge, from
+  // the entry and from the end.
+  const auto room = [&](double nx, double ny) {
+    const double toward = row ? ny : nx;
+    const double lo = row ? t.y : t.x;
+    const double hi = row ? t.bottom() : t.right();
+    double least = kNoRoom;
+    for (const PlannerPoint& q : {entry, to}) {
+      const double at = row ? q.y : q.x;
+      if (toward < -1e-6) {
+        least = std::min(least, (at - lo) / -toward);
+      } else if (toward > 1e-6) {
+        least = std::min(least, (hi - at) / toward);
+      }
+    }
+    return std::max(0.0, least);
+  };
+  const double plus = room(dy / length, -dx / length);
+  const double minus = room(-dy / length, dx / length);
+  if (plus < kNoRoom) {
+    c->free_plus = c->free_plus < 0 ? plus : std::min(c->free_plus, plus);
+  }
+  if (minus < kNoRoom) {
+    c->free_minus = c->free_minus < 0 ? minus : std::min(c->free_minus, minus);
+  }
+}
+
+std::vector<PlannerPoint> PointsOf(const std::vector<PlannedPoint>& leg) {
+  std::vector<PlannerPoint> points;
+  points.reserve(leg.size());
+  for (const PlannedPoint& point : leg) {
+    points.push_back(point.p);
+  }
+  return points;
+}
+
+// The hand's velocity (px/s) arriving at point i of a planned leg.
+PlannerPoint VelocityAt(const std::vector<PlannedPoint>& leg, size_t i) {
+  if (i == 0 || i >= leg.size()) {
+    return PlannerPoint();
+  }
+  const double dt = leg[i].t_ms - leg[i - 1].t_ms;
+  if (dt <= 0) {
+    return PlannerPoint();
+  }
+  return PlannerPoint{(leg[i].p.x - leg[i - 1].p.x) * 1000 / dt,
+                      (leg[i].p.y - leg[i - 1].p.y) * 1000 / dt};
+}
+
+// The runs of `bands` (a label per point of a leg) as the planner counts
+// them -- one band's points, single points out of it inside the run
+// absorbed -- that have an exit, the point after the run: the band of the
+// first for which `test(first, exit)` holds, else 0.
+template <typename Test>
+int FirstRunThat(const std::vector<int>& bands, const Test& test) {
+  const size_t n = bands.size();
+  size_t i = 0;
+  while (i < n) {
+    const int id = bands[i];
+    if (id == 0) {
+      ++i;
+      continue;
+    }
+    size_t last = i;
+    size_t j = i + 1;
+    while (j < n) {
+      if (bands[j] == id) {
+        last = j;
+        ++j;
+      } else if (bands[j] == 0 && j + 1 < n && bands[j + 1] == id) {
+        ++j;
+      } else {
+        break;
+      }
+    }
+    if (last + 1 < n && test(i, last + 1)) {
+      return id;
+    }
+    i = last + 1;
+  }
+  return 0;
+}
