+std::optional<SyntheticMousePathGestureParams::EndAction> ParseEndAction(
+    std::string_view name) {
+  using EndAction = SyntheticMousePathGestureParams::EndAction;
+  if (name == "press") {
+    return EndAction::kPress;
+  }
+  if (name == "release") {
+    return EndAction::kRelease;
+  }
+  if (name == "click") {
+    return EndAction::kClick;
+  }
+  return std::nullopt;
+}
