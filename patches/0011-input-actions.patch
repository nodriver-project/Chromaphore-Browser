+// browser: Input.scrollBy: checked, its element's move or the pointer's
+// place settled, then carried out by a ScrollSession, which answers once
+// through AnswerScrollBy.
+void InputHandler::ScrollBy(const std::string& direction,
+                            std::optional<int> amount,
+                            std::optional<std::string> pace,
+                            std::optional<int> backend_node_id,
+                            std::optional<std::string> frame_id,
+                            std::optional<bool> find_scroller,
+                            std::optional<double> speed_multiplier,
+                            std::optional<double> timeout_ms,
+                            std::optional<double> pointer_x,
+                            std::optional<double> pointer_y,
+                            std::optional<bool> follow_navigation,
+                            std::unique_ptr<ScrollByCallback> callback) {
+  ScrollSession::Completion completion = AnswerScrollBy(std::move(callback));
+  // Other pointer input: a reveal, a drag, a move and a scroll under way end
+  // first.
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  InterruptAllSessions();
+  if (std::optional<Response> refusal = CheckActionCall(
+          "Input.scrollBy", /*refuse_held_drag=*/true,
+          {&speed_multiplier, &timeout_ms, &pointer_x, &pointer_y})) {
+    FailScroll(std::move(completion), *refusal);
+    return;
+  }
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  ScrollSession::Params params;
+  if (direction == "down" || direction == "up") {
+    params.vertical = true;
+  } else if (direction == "right" || direction == "left") {
+    params.vertical = false;
+  } else {
+    FailScroll(
+        std::move(completion),
+        Response::InvalidParams("'direction' must be up, down, left or right"));
+    return;
+  }
+  params.way = direction == "down" || direction == "right" ? 1 : -1;
+  if (amount.has_value() && (*amount < 1 || *amount > 1000000)) {
+    FailScroll(std::move(completion),
+               Response::InvalidParams("'amount' must be 1 to 1000000"));
+    return;
+  }
+  params.amount = amount.value_or(400);
+  if (pace.has_value()) {
+    if (*pace == "read") {
+      params.pace = ScrollSession::Pace::kRead;
+    } else if (*pace == "flick") {
+      params.pace = ScrollSession::Pace::kFlick;
+    } else {
+      FailScroll(std::move(completion),
+                 Response::InvalidParams("'pace' must be read or flick"));
+      return;
+    }
+  }
+  const bool to_element = backend_node_id.has_value() || frame_id.has_value();
+  if (to_element && (!backend_node_id || !frame_id || *backend_node_id <= 0)) {
+    FailScroll(
+        std::move(completion),
+        Response::InvalidParams("'backendNodeId' and 'frameId' go together"));
+    return;
+  }
+  if (to_element && find_scroller.has_value()) {
+    FailScroll(std::move(completion),
+               Response::InvalidParams("'findScroller' goes with no element"));
+    return;
+  }
+  if (std::optional<Response> refusal =
+          CheckSpeedMultiplier(speed_multiplier)) {
+    FailScroll(std::move(completion), *refusal);
+    return;
+  }
+  params.find_scroller = find_scroller.value_or(true);
+  params.speed_multiplier = speed_multiplier.value_or(1);
+  params.follow_navigation = follow_navigation.value_or(false);
+  const double timeout =
+      ClampTimeout(timeout_ms, kLongActionTimeoutMs, kLongActionTimeoutMaxMs);
+  params.timeout = base::Milliseconds(timeout);
+  params.css_scale = CssScaleOrOne();
+  if (to_element) {
+    // Onto the element first: its move answers where the pointer is.
+    MoveRequest move;
+    move.backend_node_id = backend_node_id;
+    move.frame_id = std::move(frame_id);
+    move.speed_multiplier = speed_multiplier;
+    move.timeout_ms = std::min(timeout, kActionTimeoutMaxMs);
+    move.pointer_x = pointer_x;
+    move.pointer_y = pointer_y;
+    params.move = std::move(move);
+  } else {
+    // Where the pointer is: where the last mouse path left it, or as told.
+    gfx::PointF at;
+    if (std::optional<PlannerPoint> last = LastPointer()) {
+      at = gfx::PointF(last->x, last->y);
+    } else if (pointer_x.has_value() && pointer_y.has_value()) {
+      at = OnWindowPixels(root_view, *pointer_x, *pointer_y);
+    } else {
+      FailScroll(std::move(completion),
+                 Response::InvalidParams("Where the pointer is is not known: "
+                                         "give 'pointerX' and 'pointerY'"));
+      return;
+    }
+    const gfx::Rect bounds = root_view->GetViewBounds();
+    if (at.x() < 0 || at.y() < 0 || at.x() >= bounds.width() ||
+        at.y() >= bounds.height()) {
+      FailScroll(std::move(completion),
+                 Response::InvalidParams(
+                     "The pointer is outside the page's view, where a wheel "
+                     "turn is not delivered"));
+      return;
+    }
+    params.at = at;
+  }
+  // An answer run on the way here started another scroll: it must post.
+  DCHECK(!scroll_session_);
+  scroll_session_ = std::make_unique<ScrollSession>(
+      *this, ++last_scroll_session_id_, std::move(params),
+      std::move(completion),
+      base::BindOnce(&InputHandler::OnScrollSessionDone,
+                     weak_factory_.GetWeakPtr()));
+  scroll_session_->Start();
+}
+
+void InputHandler::InterruptScrollSession() {
+  if (std::unique_ptr<ScrollSession> session = std::move(scroll_session_)) {
+    session->Interrupt();
+  }
+}
+
+void InputHandler::OnScrollSessionDone(uint64_t id) {
+  if (scroll_session_ && scroll_session_->id() == id) {
+    scroll_session_.reset();
+  }
+}
