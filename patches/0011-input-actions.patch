+// browser: the button table of the humanized actions and the mouse paths,
+// and the ends and modifier keys they share.
+// A mouse button by its protocol name: none only with `allow_none`; nullopt
+// for any other name.
+std::optional<SyntheticPointerActionParams::Button> ButtonByName(
+    std::string_view name,
+    bool allow_none) {
+  using Button = SyntheticPointerActionParams::Button;
+  static constexpr std::pair<std::string_view, Button> kNamed[] = {
+      {"none", Button::NO_BUTTON}, {"left", Button::LEFT},
+      {"middle", Button::MIDDLE},  {"right", Button::RIGHT},
+      {"back", Button::BACK},      {"forward", Button::FORWARD},
+  };
+  for (const auto& [named, button] : kNamed) {
+    if (name == named && (allow_none || button != Button::NO_BUTTON)) {
+      return button;
+    }
+  }
+  return std::nullopt;
+}
+
+// A mouse path's end by its protocol name: press, release or click; nullopt
