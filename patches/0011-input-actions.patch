+std::unique_ptr<Input::FieldReading> AfterReadingOf(
+    const blink::mojom::AgentFieldReading* before,
+    GlobalRenderFrameHostId before_root,
+    GlobalRenderFrameHostId root,
+    const blink::mojom::AgentFieldReading* after) {
+  std::unique_ptr<Input::FieldReading> out = FieldReadingOf(after);
+  if (out && before && before->node_id > 0 && before_root && root &&
+      root != before_root) {
+    RenderFrameHostImpl* was = RenderFrameHostImpl::FromID(before_root);
+    if (was && was->IsRenderFrameLive()) {
+      out->SetMoved(true);
