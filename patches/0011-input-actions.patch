+// One answer to Input.performDrag, as the protocol returns it.
+struct DragAnswer {
+  std::string outcome;
+  std::string kind = "none";
+  std::optional<std::string> reason;
+  std::optional<double> x;
+  std::optional<double> y;
+  std::optional<std::string> hit;
+  std::optional<std::string> hit_kind;
+  std::optional<bool> reached;
+  std::optional<int> grab_index_before;
+  std::optional<int> grab_index_after;
+  std::optional<int> sibling_count;
+  std::optional<std::string> list;
+  std::optional<std::string> grab_text;
+  std::optional<double> grab_moved_x;
+  std::optional<double> grab_moved_y;
+  std::optional<bool> slot_reached;
+  std::optional<std::string> value_before;
+  std::optional<std::string> value_after;
+  std::optional<double> value_reached;
+  std::optional<std::string> hit_value_before;
+  std::optional<std::string> hit_value_after;
+  std::optional<double> fraction_x_reached;
+  std::optional<double> fraction_y_reached;
+  std::unique_ptr<Array<Input::DragScroll>> scrolled;
+  std::unique_ptr<Array<Input::DragScroll>> unexpected;
+  std::optional<int> notches;
+  std::optional<bool> put_back;
+  double duration_ms = 0;
+  std::optional<int> replans;
+  std::optional<int> corrections;
+};
+
+void SendAnswer(DragSession::Callback& callback,
+                DragAnswer a,
+                std::unique_ptr<Page::ActionOutcome> action_outcome = nullptr) {
+  callback.sendSuccess(
+      a.outcome, a.kind, std::move(a.reason), a.x, a.y, std::move(a.hit),
+      std::move(a.hit_kind), a.reached, a.grab_index_before, a.grab_index_after,
+      a.sibling_count, std::move(a.list), std::move(a.grab_text),
+      a.grab_moved_x, a.grab_moved_y, a.slot_reached, std::move(a.value_before),
+      std::move(a.value_after), a.value_reached, std::move(a.hit_value_before),
+      std::move(a.hit_value_after), a.fraction_x_reached, a.fraction_y_reached,
+      std::move(a.scrolled), std::move(a.unexpected), a.notches, a.put_back,
+      a.duration_ms, a.replans, a.corrections, std::move(action_outcome));
+}
+
+}  // namespace
+
+// What the page takes of the input sent to the local root's widget: its
+// renderer acks each event once it has handled it (a mouse move is
+// blocking, acked after its main-thread dispatch). Told to the session,
+// which only notes it: nothing is decided inside an observer's call.
+class DragSession::PageTakes : public RenderWidgetHost::InputEventObserver {
+ public:
+  PageTakes(DragSession& session, RenderWidgetHostImpl& host)
+      : session_(session), host_(host.GetWeakPtr()) {
+    host.AddInputEventObserver(this);
+  }
+  PageTakes(const PageTakes&) = delete;
+  PageTakes& operator=(const PageTakes&) = delete;
+  ~PageTakes() override {
+    if (host_) {
+      host_->RemoveInputEventObserver(this);
+    }
+  }
+
+  void OnInputEvent(const RenderWidgetHost& host,
+                    const blink::WebInputEvent& event,
+                    input::InputEventSource source) override {
+    session_->OnPageSent(event);
+  }
+  void OnInputEventAck(const RenderWidgetHost& host,
+                       blink::mojom::InputEventResultSource source,
+                       blink::mojom::InputEventResultState state,
+                       const blink::WebInputEvent& event) override {
+    session_->OnPageTook(event);
+  }
+
+ private:
+  const raw_ref<DragSession> session_;
+  base::WeakPtr<RenderWidgetHostImpl> host_;
+};
+
+DragSession::Params::Params() = default;
+DragSession::Params::Params(const Params&) = default;
+DragSession::Params& DragSession::Params::operator=(const Params&) = default;
+DragSession::Params::~Params() = default;
+
+DragSession::DragSession(
+    InputHandler& handler,
+    uint64_t id,
+    const Params& params,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+    std::unique_ptr<Callback> callback,
+    base::OnceCallback<void(uint64_t)> on_done)
+    : handler_(handler),
+      id_(id),
+      params_(params),
+      collector_(std::move(collector)),
+      callback_(std::move(callback)),
+      on_done_(std::move(on_done)),
+      planner_(browser::MovementPersona::FromSeed(browser::PersonaSeed()),
+               params.variation_seed) {
+  interval_ms_ = 1000.0 / std::max(1, planner_.polling_rate_hz());
+  per_notch_ = kNotchGuess;
+  started_ = Now();
+  hand_ = params_.hand;
+  grab_point_ = params_.grab_point;
+  grab_id_ = params_.grab_node_id;
+}
+
+DragSession::~DragSession() {
+  if (!callback_) {
+    return;
+  }
+  action_id_ = 0;  // no word to the outcome watch either
+  if (pending_answer_) {
+    Send(pending_answer_->outcome, pending_answer_->reason);
+    return;
+  }
+  Send("interrupted", "the DevTools session ended before the drag did");
+}
+
+// static
+void DragSession::Refuse(std::unique_ptr<Callback> callback,
+                         const std::string& outcome,
+                         const std::string& reason) {
+  DragAnswer answer;
+  answer.outcome = outcome;
+  answer.reason = reason;
+  SendAnswer(*callback, std::move(answer));
+}
+
+base::WeakPtr<DragSession> DragSession::Weak() {
+  return weak_factory_.GetWeakPtr();
+}
+
+bool DragSession::Stopped() const {
+  return answered() || ending_ || pending_answer_.has_value();
+}
+
+bool DragSession::PointerDrag() const {
+  return pressed_ && kind_ != Kind::kNative;
+}
+
+DragMode DragSession::Mode() const {
+  return kind_ == Kind::kPointer ? DragMode::kPointer : DragMode::kNative;
+}
+
+void DragSession::Start() {
+  deadline_timer_.Start(FROM_HERE, params_.timeout,
+                        base::BindOnce(&DragSession::OnDeadline, Weak()));
+  collector_.set_disconnect_handler(
+      base::BindOnce(&DragSession::OnCollectorGone, Weak()));
+  if (grab_id_ != 0) {
+    // Where to press depends on its box: read first.
+    ReadSlot(SlotUse::kGrab, grab_id_);
+    return;
+  }
+  Survey(base::BindOnce(&DragSession::CheckSurvey, Weak()));
+}
+
+void DragSession::Interrupt() {
+  if (answered()) {
+    return;
+  }
+  interrupted_ = true;
+  const std::string reason =
+      "other input came for the pointer before the drag was done";
+  if (!pressed_) {
+    Answer("interrupted", reason);
+    return;
+  }
+  if (pending_answer_) {
+    SendPending();  // over already: the answer goes now
+    return;
+  }
+  if (phase_ == Phase::kAfter) {
+    // Let go already: what it left is read now when the read still waits
+    // for the page to settle; the answer is what the let-go did.
+    if (settle_read_) {
+      ReadSettled();
+    }
+    return;
+  }
+  if (settle_read_) {
+    // Ended already, waiting for the page to settle: what it left is read
+    // now, before the new input moves anything.
+    ReadSettled();
+  } else if (!letting_go_) {
+    if (!ending_) {
+      MarkEnding("interrupted", reason);
+    }
+    if (kind_ == Kind::kNative) {
+      // Called off at once, with no dart out of a band first: the new input
+      // is waiting, and a drag that has ended scrolls nothing.
+      EndNative();
+    } else if (!put_back_sent_) {
+      // Put back in one gesture, queued now, ahead of the new input's (a
+      // put-back waiting for the page to settle goes at once).
+      put_back_waiting_ = false;
+      PutBack(/*dart_out=*/true, /*original=*/false);
+    }
+  }
+  // (A drop or release under way answers with what it did.)
+  if (!answered()) {
+    ReleaseHooks(/*call_off_held=*/true);
+  }
+}
+
+// ============================================ phase 0: validate and survey
+
+// The first survey's verdict: every refusal comes here, before anything is
+// pressed. A range input grabbed with no fraction is pressed on its thumb,
+// read again there.
+void DragSession::CheckSurvey() {
+  if (Stopped()) {
+    return;
+  }
+  const blink::mojom::AgentDragSurvey& s = *survey_;
+  if (!s.grab || !s.grab->found) {
+    Fail("gone", "the element to grab is no longer on the page. Observe again");
+    return;
+  }
+  if (!thumb_checked_) {
+    thumb_checked_ = true;
+    const bool on_thumb = params_.grab_node_id != 0 && s.slider &&
+                          s.slider->is_range &&
+                          !params_.grab_fraction_x.has_value() &&
+                          !params_.grab_fraction_y.has_value();
+    const DragRect thumb =
+        on_thumb ? RectToRoot(s.slider->thumb.get()) : DragRect();
+    if (!thumb.IsEmpty()) {
+      grab_point_ = Mid(thumb);
+      Survey(base::BindOnce(&DragSession::CheckSurvey, Weak()));
+      return;
+    }
+  }
+  if (!s.grab_reached) {
+    // browser: a grab in no state to be pressed -- inert, disabled,
+    // invisible -- or not rendered where it would be pressed, refused with the
+    // check's verdict, for the caller to word as a refused click is; for
+    // inert, with what switched it off.
+    if (s.grab_verdict == "inert" || s.grab_verdict == "disabled" ||
+        s.grab_verdict == "hidden" || s.grab_verdict == "nothing") {
+      const bool inert = s.grab_verdict == "inert";
+      SetHit(inert ? s.grab_hit : std::string(),
+             inert ? s.grab_hit_kind : std::string());
+      Fail("unreachable", s.grab_verdict);
+      return;
+    }
+    if (s.grab_verdict == "gone") {
+      Fail("gone", GrabName() + " is no longer on the page. Observe again");
+      return;
+    }
+    SetHit(s.grab_hit.empty() ? std::string("something else") : s.grab_hit,
+           s.grab_hit_kind);
+    Fail("covered",
+         hit_ + " is on top of where " + GrabName() + " would be grabbed");
+    return;
+  }
+  const DragRect& view = terrain_->viewport();
+  if (!view.Contains(grab_point_)) {
+    Fail("unreachable",
+         "where " + GrabName() + " would be grabbed is outside " + ViewName());
+    return;
+  }
+  switch (params_.target_kind) {
+    case TargetKind::kElement: {
+      const blink::mojom::AgentCarryReading* reading = s.target_reading.get();
+      if (!s.target || !s.target->found || !reading || !reading->found) {
+        Fail("gone", TargetName() + " is no longer on the page. Observe again");
+        return;
+      }
+      if (!reading->covering.empty()) {
+        FailCovered(*reading);
+        return;
+      }
+      // In a frame of another process, where the page hides it and its own
+      // frame's scrollers have nothing to bring: no drag gets it into view,
+      // so nothing is pressed. A reveal goes through the frames.
+      if (RenderFrameHostImpl* rfh =
+              RenderFrameHostImpl::FromID(params_.local_root);
+          rfh && rfh->GetParent() && std::abs(reading->need_x) < 0.5 &&
+          std::abs(reading->need_y) < 0.5 &&
+          RectToRoot(reading->box.get()).Intersect(view).IsEmpty()) {
+        Fail("unreachable", TargetName() +
+                                " is in a part of its frame the page does not "
+                                "show: bring it into view first "
+                                "(scroll_to_element), then drag");
+        return;
+      }
+      break;
+    }
+    case TargetKind::kFraction:
+      if (!view.Contains(At(RectToRoot(s.grab->box.get()), params_.fraction_x,
+                            params_.fraction_y))) {
+        Fail("unreachable", "the place to let go, across " + GrabName() +
+                                ", is outside " + ViewName());
+        return;
+      }
+      break;
+    case TargetKind::kPoint:
+      if (!view.Contains(params_.point)) {
+        Fail("unreachable", "the point to let go at is outside " + ViewName());
+        return;
+      }
+      break;
+    case TargetKind::kValue:
+      if (!s.slider || !s.slider->is_range) {
+        Fail("unreachable", GrabName() +
+                                " is not a range input, so it has no value to "
+                                "drag to");
+        return;
+      }
+      break;
+  }
+  const PlannerPoint centre = Mid(RectToRoot(s.grab->box.get()));
+  item_offset_ =
+      PlannerPoint{centre.x - grab_point_.x, centre.y - grab_point_.y};
+  if (s.slider && s.slider->is_range) {
+    // A slider's drag scrolls nothing: no band, no zone, no dart.
+    range_grab_ = true;
+    terrain_ = BuildTerrain(Mode());
+  }
+  RouteGrab();
+}
+
+// browser: the grab point routed as the press there will be: the widget
+// under it must be this drag's local root's. Another frame's content there --
+// an embedded frame over the page, the page over a frame -- takes the press,
+// which this renderer's own hit test cannot see.
+void DragSession::RouteGrab() {
+  RenderWidgetHostViewBase* local = LocalView();
+  RenderWidgetHostViewBase* root = local ? local->GetRootView() : nullptr;
+  RenderWidgetHostImpl* root_host = root ? root->host() : nullptr;
+  if (!root || !root_host || !root_host->delegate()) {
+    PlanFirstWaypoint();
+    return;
+  }
+  root_host->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+      root, gfx::PointF(grab_point_.x, grab_point_.y),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&DragSession::OnGrabRouted, Weak()),
+          base::WeakPtr<RenderWidgetHostViewBase>(),
+          std::optional<gfx::PointF>()));
+}
+
+void DragSession::OnGrabRouted(base::WeakPtr<RenderWidgetHostViewBase> target,
+                               std::optional<gfx::PointF> point) {
+  if (Stopped()) {
+    return;
+  }
+  RenderWidgetHostViewBase* local = LocalView();
+  if (target && point.has_value() && local && target.get() != local) {
+    if (RenderFrameHostImpl* over =
+            handler_->BindCollectorFor(target.get(), &cover_collector_)) {
+      cover_collector_->DescribePoint(
+          point->x(), point->y(), std::vector<int32_t>(), /*place=*/true,
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&DragSession::OnGrabCoverNamed, Weak(),
+                             IsPageDocument(over)),
+              std::string(), 0, std::string()));
+      return;
+    }
+    OnGrabCoverNamed(IsPageDocument(handler_->LocalRootFor(target.get())),
+                     std::string(), 0, std::string());
+    return;
+  }
+  PlanFirstWaypoint();
+}
+
+void DragSession::OnGrabCoverNamed(bool page,
+                                   const std::string& hit,
+                                   int32_t hit_node_id,
+                                   const std::string& value) {
+  if (Stopped()) {
+    return;
+  }
+  // Said with where it is: the page's own content, or another frame's.
+  hit_ = CoverName(page, hit);
+  Fail("covered",
+       hit_ + " is on top of where " + GrabName() + " would be grabbed");
+}
+
+std::string DragSession::ViewName() const {
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(params_.local_root);
+  return rfh && rfh->GetParent() ? "what the page shows of the frame"
+                                 : "the page's view";
+}
+
+// Where the first leg after the press goes, native assumed: the wheel
+// station when the target needs scrolling (asked before the press), else
+// the landing (or the calm point beside it).
+void DragSession::PlanFirstWaypoint() {
+  const blink::mojom::AgentCarryReading* reading =
+      survey_->target_reading.get();
+  if (params_.target_kind == TargetKind::kElement && reading) {
+    need_ = NeedToRoot(*reading);
+    vertical_ = std::abs(need_.y) >= std::abs(need_.x);
+    const double along = vertical_ ? need_.y : need_.x;
+    if (std::abs(along) >= kStageMinNotches * per_notch_) {
+      way_ = along > 0 ? 1 : -1;
+      AskStation(StationUse::kFirst);
+      return;
+    }
+  }
+  SetFirstWaypoint(LandingEstimate(/*after_carry=*/false), LandingWidth());
+  // The first leg goes to the landing: its homing lands there, its
+  // overshoot kept over the drop zone.
+  first_is_landing_ = true;
+  ReachGrab();
+}
+
+// The landing as the last survey has it: where a hand lands on the target
+// now (or, once the wheel has carried it, where it comes to rest), across
+// the grabbed element, the point, or the place on the track that gives the
+// value.
+PlannerPoint DragSession::LandingEstimate(bool after_carry) const {
+  const blink::mojom::AgentDragSurvey& s = *survey_;
+  switch (params_.target_kind) {
+    case TargetKind::kElement: {
+      const blink::mojom::AgentCarryReading* reading = s.target_reading.get();
+      if (!reading) {
+        return grab_point_;
+      }
+      return after_carry ? ToRoot(reading->rest_x, reading->rest_y)
+                         : ToRoot(reading->land_x, reading->land_y);
+    }
+    case TargetKind::kFraction:
+      return At(RectToRoot(s.grab ? s.grab->box.get() : nullptr),
+                params_.fraction_x, params_.fraction_y);
+    case TargetKind::kPoint:
+      return params_.point;
+    case TargetKind::kValue:
+      return s.value_found ? ToRoot(s.value_x, s.value_y) : grab_point_;
+  }
+  NOTREACHED();
+}
+
+// The first leg's end: inside the view and calm (the calm point beside an
+// in-band landing), on the native terrain.
+void DragSession::SetFirstWaypoint(const PlannerPoint& at, double width) {
+  PlannerPoint w = at;
+  const DragRect& view = terrain_->viewport();
+  if (!view.Contains(w)) {
+    const DragRect inside = view.Inset(kViewInset, kViewInset);
+    w.x = std::clamp(w.x, inside.x, inside.right());
+    w.y = std::clamp(w.y, inside.y, inside.bottom());
+  }
+  // Out of a band, or a few px under its edge: not at the clearance under
+  // the edge, within the target where it is one.
+  const DragRect target = TargetBoxNow();
+  if (!terrain_->Calm(w)) {
+    if (const std::optional<PlannerPoint> calm =
+            terrain_->NearestCalm(w, kCalmSearch)) {
+      w = DeeperOutOfBand(w, *calm,
+                          target.IsEmpty() ? terrain_->viewport() : target,
+                          DragRect());
+    }
+  }
+  if (!target.IsEmpty()) {
+    w = OffBandEdge(w, target, DragRect());
+  }
+  first_waypoint_ = w;
+  first_target_ = w;
+  first_width_ = width;
+}
+
+// ===================================== phase 1: reach the grab, and press
+
+void DragSession::ReachGrab() {
+  if (Stopped()) {
+    return;
+  }
+  phase_ = Phase::kReach;
+  // Before the press no band matters: a leg with no constraints.
+  PlayLeg(Plan(Hand(), grab_point_, GrabWidth(), PathIntent::kDefault,
+               LegConstraints()),
+          base::BindOnce(&DragSession::Press, Weak()));
+}
+
+// The press, where the hand has come to: from it on, interception holds a
+// native drag from its dragstart, the call's keys are held, and the handler
+// tells this session what the drag does.
+void DragSession::Press() {
+  if (Stopped()) {
+    return;
+  }
+  grab_chain_ = GrabChain();
+  InputHandler& handler = *handler_;
+  handler.ArmDragInterceptionForCall(id_, true);
+  armed_ = true;
+  handler.SetDragModifiers(params_.modifiers);
+  handler.set_on_drag_started(
+      base::BindOnce(&DragSession::OnDragStarted, Weak()));
+  handler.set_on_drag_lost(base::BindOnce(&DragSession::OnDragLost, Weak()));
+  handler.set_on_dragover_sent(
+      base::BindRepeating(&DragSession::OnDragOverSent, Weak()));
+  WatchPageTakes();
+  pressed_ = true;
+  press_offsets_ = latest_offsets_;
+  InputHandler::MousePathRequest request =
+      MouseRequest({grab_point_}, /*held=*/false);
+  request.end_action = EndAction::kPress;
+  // The hand's own wait before pressing.
+  request.end_delay =
+      base::Milliseconds(planner_.PressDwellMs(PathIntent::kDefault));
+  handler.QueueMousePath(std::move(request),
+                         base::BindOnce(&DragSession::OnPressed, Weak()));
+  StartWatch();
+}
+
+void DragSession::OnPressed(bool ok) {
+  if (Stopped() || phase_ != Phase::kReach) {
+    return;
+  }
+  if (!ok) {
+    // Nothing went out: nothing is held.
+    pressed_ = false;
+    Fail("gone", "the press on " + GrabName() +
+                     " was not delivered: the page's view went away");
+    return;
+  }
+  Activate();
+}
+
+// ===================================================== phase 2: activation
+
+// The rest after the press (a widget that starts a drag on a long press
+// gets pressHoldMs), then the first leg.
+void DragSession::Activate() {
+  phase_ = Phase::kActivate;
+  // The hand's own press-to-move latency, unless the call asked.
+  const double hold_ms = params_.press_hold_ms.has_value()
+                             ? *params_.press_hold_ms
+                             : planner_.PressLatencyMs();
+  if (hold_ms >= kHoldWanderFromMs) {
+    // A long press: the hand is not quite still, but stays within 3 px. No
+    // drag has begun yet, so no band counts.
+    const double angle = RandBetween(0, 2 * std::numbers::pi);
+    const double r = RandBetween(1, kHoldWanderMaxPx);
+    const PlannerPoint to{grab_point_.x + r * std::cos(angle),
+                          grab_point_.y + r * std::sin(angle)};
+    std::vector<PlannedPoint> wander = Plan(
+        MousePlace(), to, kPointWidth, PathIntent::kCasual, LegConstraints());
+    const double wander_ms = wander.back().t_ms;
+    PlayLeg(std::move(wander),
+            base::BindOnce(&DragSession::WaitPressed, Weak(),
+                           std::max(0.0, hold_ms - wander_ms)));
+    return;
+  }
+  WaitPressed(hold_ms);
+}
+
+void DragSession::WaitPressed(double ms) {
+  if (Stopped() || phase_ != Phase::kActivate) {
+    return;
+  }
+  step_timer_.Start(FROM_HERE, base::Milliseconds(ms),
+                    base::BindOnce(&DragSession::BeginFirstLeg, Weak()));
+}
+
+// The activation, folded into the first leg (to the first station, or the
+// landing): its first 8-16 px -- past Blink's drag threshold -- are the
+// window a native drag starts in. The first gesture carries the leg to the
+// window's end + 80 ms + 40 ms on the mouse channel, the button held; a
+// dragstart in it takes the hand onto the native channel from where the
+// drag began, and none makes it a pointer drag whose rest of the leg follows
+// the gesture with no stop.
+void DragSession::BeginFirstLeg() {
+  if (Stopped() || phase_ != Phase::kActivate) {
+    return;
+  }
+  const PlannerPoint from = MousePlace();
+  const double reach = RandBetween(kActivationMinPx, kActivationMaxPx);
+  first_target_ = first_waypoint_;
+  LegConstraints first_c =
+      terrain_->Constraints(from, first_target_, kBandBudgetMs);
+  if (first_is_landing_) {
+    first_c.hold = HoldFor(first_target_);
+  }
+  // Pressed in a band and heading along it: across it first, so the drag
+  // starts out of it. Its time in the band before the dragstart is
+  // Blink's to ignore.
+  std::vector<PlannedPoint> leg =
+      first_is_landing_
+          ? std::vector<PlannedPoint>()
+          : ExitStroke(from, first_target_, first_width_, PlannerPoint(),
+                       /*checked=*/false);
+  if (leg.empty()) {
+    leg =
+        Plan(from, first_target_, first_width_, PathIntent::kDefault, first_c);
+  }
+  size_t window = ThresholdIndex(leg, reach);
+  if (window >= leg.size()) {
+    // The first waypoint is too near to start a drag on the way there: a
+    // move of its own that does, calm where it can be.
+    first_target_ = ActivationPoint(reach);
+    first_width_ = kPointWidth;
+    first_is_landing_ = false;
+    leg = Plan(from, first_target_, first_width_, PathIntent::kDefault,
+               terrain_->Constraints(from, first_target_, kBandBudgetMs));
+    window = std::min(ThresholdIndex(leg, reach), leg.size() - 1);
+  }
+  const double window_ms = leg[window].t_ms + kNativeWindow.InMillisecondsF();
+  size_t cut = window;
+  while (cut + 1 < leg.size() &&
+         leg[cut + 1].t_ms <= window_ms + kWindowMarginMs) {
+    ++cut;
+  }
+  std::vector<PlannedPoint> first;
+  for (size_t i = 0; i <= cut; ++i) {
+    first.push_back(leg[i]);
+  }
+  const base::TimeTicks now = Now();
+  first_cut_ = cut;
+  leg_points_ = leg;
+  leg_started_ = now;
+  first_leg_ = std::move(leg);
+  moved_ = true;
+  survey_fresh_ = false;
+  ClampToView(&first);
+  hand_ = first.back().p;
+  NotePlannedDwell(first, now);
+  first_gesture_done_ = false;
+  auto still = base::MakeRefCounted<base::RefCountedData<double>>(-1.0);
+  handler_->QueueMousePath(MouseRequest(PointsOf(first), /*held=*/true),
+                           base::BindOnce(&DragSession::OnFirstGesture, Weak(),
+                                          ++first_token_, still));
+  still->data = handler_->LastQueuedStillMs();
+  step_timer_.Start(FROM_HERE, base::Milliseconds(window_ms),
+                    base::BindOnce(&DragSession::OnNativeWindowEnd, Weak()));
+}
+
+// The first point of a leg past Blink's drag threshold: at least `reach`
+// DIPs from the press, and at least 5 physical px from it on one axis.
+size_t DragSession::ThresholdIndex(const std::vector<PlannedPoint>& leg,
+                                   double reach) const {
+  const double dsf = Dsf();
+  for (size_t i = 0; i < leg.size(); ++i) {
+    const double dx = leg[i].p.x - grab_point_.x;
+    const double dy = leg[i].p.y - grab_point_.y;
+    if (std::hypot(dx, dy) >= reach &&
+        std::max(std::abs(dx), std::abs(dy)) * dsf >= kThresholdPhysicalPx) {
+      return i;
+    }
+  }
+  return leg.size();
+}
+
+// A point past the drag threshold from the press, toward the first
+// waypoint where it can be: calm on both readings of the terrain (the kind
+// of drag is not known yet), else calm natively, else wherever it lies (its
+// band run is budgeted).
+PlannerPoint DragSession::ActivationPoint(double reach) const {
+  const DragTerrain pointer_terrain = BuildTerrain(DragMode::kPointer);
+  const double dsf = Dsf();
+  double toward = RandBetween(0, 2 * std::numbers::pi);
+  if (Distance(first_waypoint_, grab_point_) >= 1) {
+    toward = std::atan2(first_waypoint_.y - grab_point_.y,
+                        first_waypoint_.x - grab_point_.x);
+  }
+  std::optional<PlannerPoint> native_calm;
+  std::optional<PlannerPoint> any;
+  for (int i = 0; i < kActivationTries; ++i) {
+    // Toward it first, then alternately either side of it.
+    const int step = (i + 1) / 2;
+    const double turn = 2 * std::numbers::pi * step / kActivationTries;
+    const double angle = toward + (i % 2 == 0 ? turn : -turn);
+    const double ux = std::cos(angle);
+    const double uy = std::sin(angle);
+    const double major = std::max(std::abs(ux), std::abs(uy));
+    const double r =
+        std::max(reach, kThresholdPhysicalPx / (dsf * major) + 0.5);
+    const PlannerPoint p{grab_point_.x + ux * r, grab_point_.y + uy * r};
+    if (!terrain_->viewport().Contains(p)) {
+      continue;
+    }
+    if (terrain_->Calm(p)) {
+      if (pointer_terrain.Calm(p, kClearance, item_offset_)) {
+        return p;
+      }
+      if (!native_calm) {
+        native_calm = p;
+      }
+    }
+    if (!any) {
+      any = p;
+    }
+  }
+  return native_calm.value_or(
+      any.value_or(PlannerPoint{grab_point_.x + reach, grab_point_.y}));
+}
+
+void DragSession::OnFirstGesture(
+    uint64_t token,
+    scoped_refptr<base::RefCountedData<double>> still,
+    bool ok) {
+  if (answered()) {
+    return;
+  }
+  // The page's last move, while no native drag has begun.
+  if (ok && !drag_started_ && still->data >= 0) {
+    moved_at_ = Now() - base::Milliseconds(still->data);
+  }
+  if (token != first_token_) {
+    return;
+  }
+  first_gesture_done_ = true;
+  if (!ok && !drag_started_ && !Stopped()) {
+    Fail("gone", "the page's view went away during the drag");
+  }
+}
+
+// The handler began holding a native drag. From here the hand is the held
+// drag's: a leg from where the drag began, at the hand's speed, to the first
+// leg's end, on the native channel -- nothing replayed, no jump (the mouse
+// moves still queued are the renderer's to discard).
+void DragSession::OnDragStarted() {
+  if (answered()) {
+    return;
+  }
+  if (ending_ || hooks_cleared_) {
+    // A hold begun while this call has interception is this call's: called
+    // off, whatever the session has become.
+    CallOffHeld();
+    return;
+  }
+  if (!pressed_ || drag_started_) {
+    return;
+  }
+  drag_started_ = true;
+  kind_ = Kind::kNative;
+  if (phase_ != Phase::kActivate) {
+    // A dragstart once the drag was carried on as a pointer one: that plan
+    // no longer holds, and the native drag is called off.
+    Fail("cancelled",
+         "the page started a native drag after the pointer drag had begun, "
+         "so it was called off");
+    return;
+  }
+  step_timer_.Stop();
+  // Blink times a band only once a drag is under way: the first gesture's
+  // planned time in one before the dragstart does not count.
+  run_box_ = 0;
+  terrain_ = BuildTerrain(DragMode::kNative);
+  const PlannerPoint from = handler_->DragPointer();
+  // The dragenter there went out before this was heard: its band's run
+  // starts now, guarded.
+  TrackDwell(terrain_->BudgetBandAt(from), Now(), /*guard=*/true);
+  const PlannerPoint entry_velocity =
+      first_gesture_done_ && !leg_running_ ? PlannerPoint() : HandVelocity();
+  // Begun in a band, heading along it: across it first, its run within the
+  // budget; else as any leg.
+  std::vector<PlannedPoint> leg =
+      first_is_landing_
+          ? std::vector<PlannedPoint>()
+          : ExitStroke(from, first_target_, first_width_, entry_velocity,
+                       /*checked=*/true);
+  if (leg.empty()) {
+    leg = PlanToCalm(from, first_target_, first_width_, entry_velocity,
+                     first_is_landing_ ? HoldFor(first_target_) : std::nullopt);
+  }
+  PlayLeg(std::move(leg),
+          base::BindOnce(&DragSession::OnActivationWalked, Weak()));
+}
+
+// No dragstart by the window's end + 80 ms: a pointer drag (a library's, or
+// a slider's). Its terrain counts the libraries' zones; the rest of the
+// first leg goes on from where the first gesture leaves the hand, at its
+// speed -- out of a library's zone first when the hand is in one.
+void DragSession::OnNativeWindowEnd() {
+  if (Stopped() || phase_ != Phase::kActivate || drag_started_ ||
+      kind_.has_value()) {
+    return;
+  }
+  // The window is the page's, not the clock's: a page behind with its input
+  // (a busy main thread, a starved machine) begins its drag late, and a
+  // pointer drag carried on before then was called off when it came.
+  // Waited for until it has taken the moves sent it; then a dragstart
+  // from them has a moment to arrive. A page that keeps up waits not at all.
+  if (page_takes_) {
+    const base::TimeTicks now = Now();
+    if (PageBehind()) {
+      if (page_wait_from_.is_null()) {
+        page_wait_from_ = now;
+      }
+      if (now - page_wait_from_ < kPageWaitCap) {
+        step_timer_.Start(
+            FROM_HERE, kPageWaitPoll,
+            base::BindOnce(&DragSession::OnNativeWindowEnd, Weak()));
+        return;
+      }
+    } else if (!page_wait_from_.is_null()) {
+      // Caught up after a wait: a dragstart from what it took has a moment to
+      // arrive, from when the wait first found it no longer behind.
+      if (page_up_at_.is_null()) {
+        page_up_at_ = now;
+      }
+      if (now < page_up_at_ + kCaughtUpMargin) {
+        step_timer_.Start(
+            FROM_HERE, page_up_at_ + kCaughtUpMargin - now,
+            base::BindOnce(&DragSession::OnNativeWindowEnd, Weak()));
+        return;
+      }
+    }
+  }
+  kind_ = Kind::kPointer;
+  terrain_ = BuildTerrain(DragMode::kPointer);
+  // The band runs count from here, on the libraries' zones (as a native
+  // drag's from its dragstart).
+  run_box_ = 0;
+  const PlannerPoint from = hand_;
+  const PlannerPoint velocity =
+      first_gesture_done_ ? PlannerPoint() : VelocityAt(first_leg_, first_cut_);
+  PlannerPoint to = first_target_;
+  if (!terrain_->Calm(to, kClearance, item_offset_)) {
+    to = terrain_->NearestCalm(to, kCalmSearch, item_offset_).value_or(to);
+  }
+  if (terrain_->BandAt(from) != 0) {
+    // In a library's zone: on to the first waypoint when the run out of the
+    // zone on the way fits the budget; else to the calm point on (or
+    // nearest) the rest of the first leg, and on from there later.
+    LegConstraints c =
+        terrain_->Constraints(from, to, kBandBudgetMs, item_offset_);
+    c.entry_velocity = velocity;
+    if (first_is_landing_ && Distance(to, first_target_) < 0.5) {
+      c.hold = HoldFor(to);
+    }
+    std::vector<PlannedPoint> straight =
+        Plan(from, to, first_width_, PathIntent::kDefault, c);
+    size_t out = 0;
+    while (out < straight.size() && straight[out].band != 0) {
+      ++out;
+    }
+    if (out < straight.size() && straight[out].t_ms <= kBandBudgetMs) {
+      PlayLeg(std::move(straight),
+              base::BindOnce(&DragSession::OnActivationWalked, Weak()));
+      return;
+    }
+    std::optional<PlannerPoint> calm;
+    for (size_t i = first_cut_ + 1; i < first_leg_.size() && !calm; ++i) {
+      if (terrain_->Calm(first_leg_[i].p, kClearance, item_offset_)) {
+        calm = first_leg_[i].p;
+      }
+    }
+    if (!calm) {
+      calm = terrain_->NearestCalm(from, kCalmSearch, item_offset_);
+    }
+    to = calm.value_or(to);
+  }
+  LegConstraints c =
+      terrain_->Constraints(from, to, kBandBudgetMs, item_offset_);
+  c.entry_velocity = velocity;
+  if (first_is_landing_ && Distance(to, first_target_) < 0.5) {
+    c.hold = HoldFor(to);
+  }
+  PlayLeg(Plan(from, to, first_width_, PathIntent::kDefault, c),
+          base::BindOnce(&DragSession::OnActivationWalked, Weak()));
+}
+
+void DragSession::WatchPageTakes() {
+  RenderWidgetHostViewBase* view = LocalView();
+  RenderWidgetHostImpl* host = view ? view->host() : nullptr;
+  if (host && !page_takes_) {
+    page_takes_ = std::make_unique<PageTakes>(*this, *host);
+  }
+}
+
+void DragSession::OnPageSent(const blink::WebInputEvent& event) {
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    press_sent_ = true;
+  } else if (press_sent_ &&
+             event.GetType() == blink::WebInputEvent::Type::kMouseMove) {
+    untaken_moves_.push_back(Now());
+  }
+}
+
+// Noted only. Acks come back in the order the events went out (a mouse down
+// and its moves share the main thread's queue): every move before the press
+// -- the reach's, sent earlier but perhaps taken after the press went out --
+// is taken before the press, so each move taken after the press's ack is the
+// oldest held move not yet taken.
+void DragSession::OnPageTook(const blink::WebInputEvent& event) {
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    if (press_sent_ && !press_taken_) {
+      press_taken_ = true;
+    }
+    return;
+  }
+  if (!press_taken_ ||
+      event.GetType() != blink::WebInputEvent::Type::kMouseMove) {
+    return;
+  }
+  if (!untaken_moves_.empty()) {
+    untaken_moves_.pop_front();
+  }
+}
+
+bool DragSession::PageBehind() const {
+  return !untaken_moves_.empty() &&
+         Now() - untaken_moves_.front() > kPageBehind;
+}
+
+void DragSession::OnActivationWalked() {
+  if (Stopped() || phase_ != Phase::kActivate) {
+    return;
+  }
+  BeginCarry();
+}
+
+// ============================================== phase 3: the carry stages
+
+// The page read again once the first leg has arrived (a library may have
+// laid things out anew when the drag began), then the carry.
+void DragSession::BeginCarry() {
+  if (Stopped()) {
+    return;
+  }
+  Survey(base::BindOnce(&DragSession::CarryFromSurvey, Weak()));
+}
+
+// From a fresh survey: a stage for an axis the target is at least half a
+// notch off on, else the approach.
+void DragSession::CarryFromSurvey() {
+  if (Stopped()) {
+    return;
+  }
+  if (params_.target_kind != TargetKind::kElement) {
+    StartApproach();
+    return;
+  }
+  const blink::mojom::AgentCarryReading* reading =
+      survey_->target_reading.get();
+  if (!reading || !reading->found) {
+    FailTargetGone();
+    return;
+  }
+  if (!reading->covering.empty()) {
+    FailCovered(*reading);
+    return;
+  }
+  // A plan made afresh: no zone's stage under way, and no box judged yet
+  // not to carry the target.
+  zone_box_ = 0;
+  stuck_box_ = 0;
+  reading_ = survey_->target_reading.Clone();
+  need_ = NeedToRoot(*reading_);
+  ExtendNeedForZones();
+  NextStage(std::abs(need_.y) >= std::abs(need_.x), /*skip_current=*/false);
+}
+
+// The next stage: none once the landing is calm on the terrain as it is
+// and under no cover; else the preferred axis, then the other, whichever
+// the target is still off on (`skip_current`: not the stage's own axis
+// again). With neither, the approach -- a dart in when the landing is in a
+// band. Switching axes is bounded.
+void DragSession::NextStage(bool prefer_vertical, bool skip_current) {
+  if (LandingGood()) {
+    StartApproach();
+    return;
+  }
+  for (const bool vertical : {prefer_vertical, !prefer_vertical}) {
+    if (skip_current && stage_started_ && vertical == vertical_) {
+      continue;
+    }
+    const double along = std::abs(vertical ? need_.y : need_.x);
+    if (along < 1) {
+      continue;
+    }
+    // A list a library animates, the target showing: a need under half a
+    // notch is its reshuffle, not a scroll.
+    if (PointerDrag() && TargetInList() &&
+        along < kStageMinNotches * per_notch_ && reading_ &&
+        !RectToRoot(reading_->box.get()).Intersect(ShownClip()).IsEmpty()) {
+      continue;
+    }
+    if (stage_started_ && vertical != vertical_) {
+      if (axis_switches_ >= kMaxAxisSwitches) {
+        break;
+      }
+      ++axis_switches_;
+    }
+    StartStage(vertical);
+    return;
+  }
+  StartApproach();
+}
+
+// A stage: the page surveyed as it is now (what the last stage scrolled
+// moved every band), where to turn the wheel from, the leg there, spins
+// until the landing is calm and uncovered, the target is not off on this
+// axis, or what turns changes.
+void DragSession::StartStage(bool vertical) {
+  if (Stopped()) {
+    return;
+  }
+  phase_ = Phase::kCarry;
+  if (++stations_ > kMaxStations) {
+    Fail("blocked", "the wheel did not bring " + TargetName() +
+                        " into view from " +
+                        base::NumberToString(kMaxStations) + " places");
+    return;
+  }
+  stage_started_ = true;
+  vertical_ = vertical;
+  const double along = vertical ? need_.y : need_.x;
+  way_ = along > 0 ? 1 : -1;
+  last_settled_need_ = along;
+  notches_since_settle_ = 0;
+  stalled_spins_ = 0;
+  single_notches_ = 0;
+  breathed_ = false;
+  spinning_ = false;
+  settling_ = false;
+  SurveyFresh(
+      base::BindOnce(&DragSession::AskStation, Weak(), StationUse::kStage));
+}
+
+void DragSession::AskStation(StationUse use) {
+  if (Stopped()) {
+    return;
+  }
+  Ask(base::BindRepeating(&DragSession::IssueWheelStation, Weak(), use,
+                          vertical_));
+}
+
+// The leg to the station, its tail inside the station's region. The first
+// spin may begin as soon as the hand is in the region for good, while the
+// tail still runs: the cursor moves and the wheel turns at once.
+void DragSession::GoToStation() {
+  const PlannerPoint from = Hand();
+  std::vector<PlannedPoint> leg =
+      Plan(from, station_, kStationWidth, PathIntent::kDefault,
+           terrain_->Constraints(from, station_, kBandBudgetMs, item_offset_));
+  size_t entry = leg.size() - 1;
+  while (entry > 0 && region_.Contains(leg[entry - 1].p)) {
+    --entry;
+  }
+  const int notches =
+      std::max(1, NotchesFor(std::abs(vertical_ ? need_.y : need_.x)));
+  std::vector<base::TimeDelta> at;
+  base::TimeDelta t =
+      base::Milliseconds(leg[entry].t_ms) + RandMs(0, kFirstNotchMaxMs);
+  for (int i = 0; i < notches; ++i) {
+    if (i > 0) {
+      t += RandMs(kNotchGapMinMs, kNotchGapMaxMs);
+    }
+    at.push_back(t);
+  }
+  if (kind_ == Kind::kNative) {
+    PlayLeg(std::move(leg),
+            base::BindOnce(&DragSession::OnStationReached, Weak()));
+    StartSpin(std::move(at), leg_started_);
+    return;
+  }
+  PlayHeldStationLeg(std::move(leg), at);
+}
+
+// A pointer drag's leg to the station goes out in pieces, each ending where
+// a notch of the first spin is turned (a gesture's wheel turns after its
+// moves); notches due after the leg's last point are turned there.
+void DragSession::PlayHeldStationLeg(std::vector<PlannedPoint> leg,
+                                     const std::vector<base::TimeDelta>& at) {
+  const uint64_t token = ++leg_;
+  leg_running_ = true;
+  moved_ = true;
+  survey_fresh_ = false;
+  after_leg_ = base::BindOnce(&DragSession::OnStationReached, Weak());
+  leg_started_ = Now();
+  ClampToView(&leg);
+  hand_ = leg.back().p;
+  NotePlannedDwell(leg, leg_started_);
+  CountPlannedSpin(at, leg_started_);
+  const int notch_x = vertical_ ? 0 : way_;
+  const int notch_y = vertical_ ? way_ : 0;
+  std::vector<InputHandler::MousePathRequest> pieces;
+  InputHandler::MousePathRequest piece = MouseRequest({}, /*held=*/true);
+  base::TimeDelta piece_last;  // the time of the piece's last event
+  size_t i = 0;
+  size_t j = 0;
+  while (i < leg.size() || j < at.size()) {
+    const bool move_next =
+        i < leg.size() &&
+        (j >= at.size() || base::Milliseconds(leg[i].t_ms) <= at[j]);
+    if (move_next) {
+      if (!piece.wheel.empty()) {
+        // A move after a turn: a new piece, from where the last one left
+        // the pointer, so its first move goes an interval later.
+        pieces.push_back(std::move(piece));
+        piece = MouseRequest({leg[i > 0 ? i - 1 : 0].p}, /*held=*/true);
+      }
+      piece.points.push_back(leg[i].p);
+      piece_last = base::Milliseconds(leg[i].t_ms);
+      ++i;
+      continue;
+    }
+    piece.wheel.push_back({notch_x, notch_y, at[j] - piece_last});
+    piece_last = at[j];
+    ++j;
+  }
+  pieces.push_back(std::move(piece));
+  for (size_t k = 0; k < pieces.size(); ++k) {
+    // Each piece's last move counts; the last piece ends the leg.
+    auto still = base::MakeRefCounted<base::RefCountedData<double>>(-1.0);
+    if (k + 1 < pieces.size()) {
+      handler_->QueueMousePath(
+          std::move(pieces[k]),
+          base::BindOnce(&DragSession::OnPieceMoved, Weak(), still));
+    } else {
+      handler_->QueueMousePath(
+          std::move(pieces[k]),
+          base::BindOnce(&DragSession::OnLegGesture, Weak(), token, still));
+    }
+    still->data = handler_->LastQueuedStillMs();
+  }
+  leg_points_ = std::move(leg);
+}
+
+// At the station: a pointer drag's first spin went out with the leg; a
+// native drag's hand is checked with Blink's own band walk before it rests
+// there.
+void DragSession::OnStationReached() {
+  if (Stopped() || phase_ != Phase::kCarry) {
+    return;
+  }
+  if (PointerDrag()) {
+    spinning_ = false;
+    BeginSettle();
+    return;
+  }
+  Probe(ProbeUse::kStation);
+}
+
+// A spin of `notches`, the first after the breath since the last notch.
+// Rule (a): only in the carry.
+void DragSession::Spin(int notches) {
+  if (Stopped() || phase_ != Phase::kCarry || notches <= 0) {
+    return;
+  }
+  const base::TimeTicks now = Now();
+  const base::TimeTicks first = std::max(now, last_notch_at_ + breath_);
+  std::vector<base::TimeDelta> at;
+  base::TimeDelta t = first - now;
+  for (int i = 0; i < notches; ++i) {
+    if (i > 0) {
+      t += RandMs(kNotchGapMinMs, kNotchGapMaxMs);
+    }
+    at.push_back(t);
+  }
+  if (kind_ == Kind::kNative) {
+    StartSpin(std::move(at), now);
+    return;
+  }
+  InputHandler::MousePathRequest request =
+      MouseRequest({MousePlace()}, /*held=*/true);
+  base::TimeDelta previous;
+  for (const base::TimeDelta notch : at) {
+    request.wheel.push_back(
+        {vertical_ ? 0 : way_, vertical_ ? way_ : 0, notch - previous});
+    previous = notch;
+  }
+  CountPlannedSpin(at, now);
+  const uint64_t token = ++spin_token_;
+  handler_->QueueMousePath(
+      std::move(request),
+      base::BindOnce(&DragSession::OnHeldSpinDone, Weak(), token));
+}
+
+// A native drag's spin: one notch at a time where the hand is, on a timer.
+void DragSession::StartSpin(std::vector<base::TimeDelta> at,
+                            base::TimeTicks from) {
+  spin_at_ = std::move(at);
+  spin_from_ = from;
+  spin_next_ = 0;
+  BeginSpinAccounting();
+  first_notch_at_ = base::TimeTicks();
+  ScheduleNotch();
+}
+
+// A spin begins: the boxes the wheel turns get one more spin's slack, and
+// the settle's evidence starts again.
+void DragSession::BeginSpinAccounting() {
+  spinning_ = true;
+  AllowWheel(/*notches=*/0, /*spins=*/1);
+  binder_moved_ = false;
+  scroll_ended_ = false;
+  frame_after_notch_ = false;
+}
+
+void DragSession::ScheduleNotch() {
+  if (spin_next_ >= spin_at_.size()) {
+    spinning_ = false;
+    BeginSettle();
+    return;
+  }
+  base::TimeTicks due = spin_from_ + spin_at_[spin_next_];
+  if (spin_next_ > 0) {
+    due = std::max(due, last_notch_at_ + base::Milliseconds(kNotchGapMinMs));
+  }
+  notch_timer_.Start(FROM_HERE, std::max(due - Now(), base::TimeDelta()),
+                     base::BindOnce(&DragSession::SendNotch, Weak()));
+}
+
+void DragSession::SendNotch() {
+  // Rule (a): a notch is turned only in the carry.
+  if (Stopped() || phase_ != Phase::kCarry || kind_ != Kind::kNative) {
+    return;
+  }
+  if (leg_running_ && !region_.Contains(Hand())) {
+    // A walk running late: not before the hand is in the region.
+    notch_timer_.Start(FROM_HERE, base::Milliseconds(interval_ms_),
+                       base::BindOnce(&DragSession::SendNotch, Weak()));
+    return;
+  }
+  handler_->DragNotch(vertical_, way_);
+  const base::TimeTicks now = Now();
+  if (first_notch_at_.is_null()) {
+    first_notch_at_ = now;
+  }
+  CountNotch(now);
+  ++spin_next_;
+  ScheduleNotch();
+}
+
+// A pointer drag's notches are queued with their times: they count when
+// queued, at the times they are due.
+void DragSession::CountPlannedSpin(const std::vector<base::TimeDelta>& at,
+                                   base::TimeTicks from) {
+  BeginSpinAccounting();
+  first_notch_at_ = at.empty() ? base::TimeTicks() : from + at.front();
+  for (const base::TimeDelta t : at) {
+    CountNotch(from + t);
+  }
+}
+
+// A notch: the settle's evidence starts again after it (the first frame
+// after the last notch, a scrollend after it).
+void DragSession::CountNotch(base::TimeTicks at) {
+  ++notches_;
+  ++notches_since_settle_;
+  survey_fresh_ = false;
+  frame_after_notch_ = false;
+  scroll_ended_ = false;
+  easing_ = true;
+  notch_vertical_ = vertical_;
+  notch_way_ = way_;
+  AllowWheel(/*notches=*/1, /*spins=*/0);
+  last_notch_at_ = std::max(last_notch_at_, at);
+  notch_window_until_ = std::max(notch_window_until_, at + kNotchInFlight);
+}
+
+// What the boxes the wheel turns now (the binder, and the latch at the
+// station) may be credited with: `notches` more notches' scroll the way
+// it turns -- each the synthetic notch's 100 DIPs, in CSS px (not the
+// target's measured move, into which a zone's need can fold) -- and 2 px to
+// spare for each of `spins`.
+void DragSession::AllowWheel(int notches, int spins) {
+  const double scale = CssScale();
+  const double allow = kNotchGuess / scale * way_ * notches;
+  const std::array<int, 2> boxes = {
+      binder_id_, notch_latch_id_ != binder_id_ ? notch_latch_id_ : 0};
+  for (const int box : boxes) {
+    if (box == 0) {
+      continue;
+    }
+    WheelCredit& credit = wheel_credit_[box];
+    (vertical_ ? credit.sent.y : credit.sent.x) += allow;
+    credit.spins += spins;
+  }
+}
+
+// The boxes the wheel turns now, and the target's box, as they are: what
+// the next settled reading tells a scroll of theirs, and the target's move,
+// by.
+void DragSession::NoteWheelBoxes() {
+  stage_target_ = reading_ ? RectToRoot(reading_->box.get()) : DragRect();
+  stage_offsets_.clear();
+  for (const int box : {binder_id_, notch_latch_id_}) {
+    const auto at = latest_offsets_.find(box);
+    if (box != 0 && at != latest_offsets_.end()) {
+      stage_offsets_[box] = at->second;
+    }
+  }
+}
+
+// One of the boxes the wheel turns has scrolled since they were noted.
+bool DragSession::WheelBoxesMoved() const {
+  for (const auto& [box, then] : stage_offsets_) {
+    const auto now = latest_offsets_.find(box);
+    if (now != latest_offsets_.end() &&
+        (std::abs(now->second.x - then.x) >= kNetPx ||
+         std::abs(now->second.y - then.y) >= kNetPx)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The target's box moved 1 px or more along the stage's axis since it was
+// noted (not known: as if it had).
+bool DragSession::TargetMovedAlong() const {
+  const DragRect now = reading_ ? RectToRoot(reading_->box.get()) : DragRect();
+  if (now.IsEmpty() || stage_target_.IsEmpty()) {
+    return true;
+  }
+  return std::abs(vertical_ ? now.y - stage_target_.y
+                            : now.x - stage_target_.x) >= 1;
+}
+
+void DragSession::OnHeldSpinDone(uint64_t token, bool ok) {
+  if (Stopped() || token != spin_token_) {
+    return;
+  }
+  if (!ok) {
+    Fail("gone", "the page's view went away during the drag");
+    return;
+  }
+  spinning_ = false;
+  BeginSettle();
+}
+
+// The spin is over: the scroll is waited out (the watch's frames say when)
+// while the hand wanders a little inside the region, or rests. The next
+// spin's breath is drawn here.
+void DragSession::BeginSettle() {
+  if (Stopped() || phase_ != Phase::kCarry) {
+    return;
+  }
+  settling_ = true;
+  breath_ = RandMs(kBreathMinMs, kBreathMaxMs);
+  if (!leg_running_ && base::RandDouble() < kWanderChance) {
+    Wander();
+  }
+  settle_timer_.Start(
+      FROM_HERE,
+      std::max(last_notch_at_ + kNoMoveWait - Now(), base::Milliseconds(1)),
+      base::BindOnce(&DragSession::OnSettleFallback, Weak()));
+  CheckSettle();
+}
+
+void DragSession::Wander() {
+  const PlannerPoint from = Hand();
+  for (int tries = 0; tries < kWanderTries; ++tries) {
+    const double angle = RandBetween(0, 2 * std::numbers::pi);
+    const double r = RandBetween(kWanderMinPx, kWanderMaxPx);
+    const PlannerPoint to{from.x + r * std::cos(angle),
+                          from.y + r * std::sin(angle)};
+    if (!region_.Contains(to) ||
+        !terrain_->Calm(to, kClearance, item_offset_)) {
+      continue;
+    }
+    PlayLeg(Plan(from, to, kPointWidth, PathIntent::kCasual,
+                 terrain_->Constraints(from, to, kBandBudgetMs, item_offset_)),
+            base::BindOnce(&DragSession::MaybeReadAfterSettle, Weak()));
+    return;
+  }
+}
+
+// Settled, by the watch's frames on the renderer's clock: the box the wheel
+// turns moved, and frames since its last change (and since the last notch)
+// span 3 frame intervals, or it ended its scroll; or it never moved and
+// frames since the last notch span 350 ms. Nothing is declared on the
+// browser's clock while frames come.
+void DragSession::CheckSettle() {
+  if (Stopped() || !settling_ || spinning_ || Now() < last_notch_at_ ||
+      !frame_after_notch_) {
+    return;
+  }
+  bool settled = false;
+  if (binder_moved_) {
+    const double still_from =
+        std::max(binder_still_from_ms_, first_frame_after_notch_ms_);
+    settled = scroll_ended_ ||
+              last_frame_ms_ - still_from >= kStillFrames * FrameMs();
+  } else {
+    settled = last_frame_ms_ - first_frame_after_notch_ms_ >=
+              kNoMoveWait.InMillisecondsF();
+  }
+  if (!settled) {
+    return;
+  }
+  settling_ = false;
+  settle_timer_.Stop();
+  MaybeReadAfterSettle();
+}
+
+// No frame at all since the last notch, 350 ms after it: nothing moved.
+void DragSession::OnSettleFallback() {
+  if (Stopped() || !settling_ || spinning_ || frame_after_notch_) {
+    return;
+  }
+  settling_ = false;
+  MaybeReadAfterSettle();
+}
+
+// Once the scroll has settled and the hand has stopped: the page surveyed
+// again (what scrolled moved every band), the hand stepped out of any band
+// that came under it, then how things stand.
+void DragSession::MaybeReadAfterSettle() {
+  if (Stopped() || phase_ != Phase::kCarry || settling_ || spinning_ ||
+      leg_running_ || replanning_ || probing_) {
+    return;
+  }
+  Survey(base::BindOnce(&DragSession::AfterSettleSurvey, Weak()));
+}
+
+void DragSession::AfterSettleSurvey() {
+  if (Stopped() || phase_ != Phase::kCarry) {
+    return;
+  }
+  if (HandInBand(Hand())) {
+    // A box scrolled under the hand (a nested scroller came along).
+    DartOut(base::BindOnce(&DragSession::ReadCarryForSpin, Weak()));
+    return;
+  }
+  ReadCarryForSpin();
+}
+
+void DragSession::ReadCarryForSpin() {
+  if (Stopped() || phase_ != Phase::kCarry) {
+    return;
+  }
+  ReadCarry(ReadUse::kCarry);
+}
+
+// A settled reading: what a notch moves it, then the next spin, a new
+// station when what turns there has changed, the next stage, a stall, or a
+// target that keeps receding.
+void DragSession::AfterSpin() {
+  // Whether the boxes the wheel turns, and the target along the axis, moved
+  // since the last settled reading; noted afresh for the next.
+  const bool boxes_moved = WheelBoxesMoved();
+  const bool target_moved = TargetMovedAlong();
+  NoteWheelBoxes();
+  const double along = vertical_ ? need_.y : need_.x;
+  const double moved = std::abs(along - last_settled_need_);
+  const int turned = notches_since_settle_;
+  const double previous_need = last_settled_need_;
+  // What the spin should have brought it, by the estimate it was turned
+  // with: a receding target gains less than a tenth of that.
+  const double expected = turned * per_notch_;
+  if (turned > 0 && moved >= 1 && (along > 0) == (last_settled_need_ > 0)) {
+    per_notch_ = std::clamp(moved / turned, kNotchMin, kNotchMax);
+  }
+  if (turned > 0 && moved >= 1) {
+    const double before = std::abs(last_settled_need_);
+    const bool progressed =
+        before > 0 &&
+        before - std::abs(along) >= kStallProgress * std::min(before, expected);
+    stalled_spins_ = progressed ? 0 : stalled_spins_ + 1;
+    if (stalled_spins_ >= kMaxStalledSpins) {
+      Fail("moved", TargetName() + " kept moving away as the wheel turned");
+      return;
+    }
+  }
+  last_settled_need_ = along;
+  notches_since_settle_ = 0;
+  if (turned > 0 && moved < 1) {
+    // A need that is a library zone's alone (the renderer has none) left as
+    // it was while the box the wheel turns did scroll: not "did not
+    // scroll", the approach. When the target's own box did not move along
+    // the axis either, it does not move with that box (a sticky one, say):
+    // that box's zone on this axis takes no more returns -- its inner edge
+    // when it gives a place, else the dart. When it did move, the need
+    // could not tell (judged off where the hand lands): the landing is
+    // judged afresh.
+    const PlannerPoint own_need = NeedToRoot(*reading_);
+    if (PointerDrag() && boxes_moved &&
+        std::abs(vertical_ ? own_need.y : own_need.x) < 0.5) {
+      if (!target_moved) {
+        stuck_box_ = binder_id_;
+        stuck_vertical_ = vertical_;
+      }
+      StartApproach();
+      return;
+    }
+    AfterStall();
+    return;
+  }
+  if (moved >= 1) {
+    breathed_ = false;
+  }
+  // The stage ends once the landing is calm and uncovered -- not merely
+  // near -- or when the target is not off on this axis, or single notches
+  // have gone back and forth across a calm stretch too short for one.
+  // A notch that carried the target past where it lands, by less
+  // than a notch, in a box whose calm stretch is shorter than a notch, ends
+  // the stage too: the next would only carry it back past again.
+  const bool overshot = turned > 0 && along * previous_need < 0 &&
+                        std::abs(along) < per_notch_ &&
+                        CalmLength(vertical_) < per_notch_;
+  if (LandingGood() || std::abs(along) < 1 ||
+      single_notches_ >= kMaxSingleNotches || overshot) {
+    NextStage(!vertical_, /*skip_current=*/true);
+    return;
+  }
+  way_ = along > 0 ? 1 : -1;
+  // The renderer judges the wheel at the hand only toward a need of its own,
+  // Blink's belts (wheel_ok is false once that is gone): past it, what is
+  // left is a library's zone, and the box the wheel turns here is the
+  // terrain's latch -- none, a new station; another, as below. A new station
+  // for every such reading would find none and go to the approach, into the
+  // zone.
+  const PlannerPoint own_need = NeedToRoot(*reading_);
+  const bool judged = std::abs(vertical_ ? own_need.y : own_need.x) >= 0.5;
+  if (!reading_->wheel_ok && (judged || LatchAt(Hand()) == 0)) {
+    // What the wheel turns here no longer moves it (the window first for a
+    // box out of view, then the box): a new station.
+    StartStage(vertical_);
+    return;
+  }
+  const int latch = LatchAt(Hand());
+  if (latch != 0 && latch != notch_latch_id_ &&
+      terrain_->Find(notch_latch_id_)) {
+    // The wheel here would latch another box now than at the stage's start
+    // (one the last stage brought under the hand, or the outer box once
+    // the inner reached its end): a new station.
+    StartStage(vertical_);
+    return;
+  }
+  const int notches = NotchesFor(std::abs(along));
+  if (notches <= 1) {
+    ++single_notches_;
+  }
+  Spin(std::max(notches, 1));
+}
+
+// A spin that moved nothing (the survey after the settle says whether the
+// box has room left). A box at its end with the target still short: as
+// near as the wheel brings it when the target shows, else blocked. With
+// room left: one breath of 560-700 ms (a wheel latched on a box keeps it
+// half a second) and one notch more, then blocked.
+void DragSession::AfterStall() {
+  if (!BinderHasRoom()) {
+    if (reading_ && reading_->land_shown) {
+      StartApproach();
+      return;
+    }
+    Fail("blocked", binder_name_ + " is at its end, and " + TargetName() +
+                        " is still out of view");
+    return;
+  }
+  if (breathed_) {
+    Fail("blocked",
+         binder_name_ + " did not scroll when the wheel turned over it");
+    return;
+  }
+  breathed_ = true;
+  breath_ = RandMs(kStallBreathMinMs, kStallBreathMaxMs);
+  Spin(1);
+}
+
+// How many notches to turn now for `distance` (root DIPs): a spin of 2-3
+// while more than 2 are left (the last ones kept for singles), then single
+// notches, one per settled reading, for as long as the landing is not calm
+// (AfterSpin ends the stage, not this count, so it is never 0).
+int DragSession::NotchesFor(double distance) const {
+  const double left = distance / per_notch_;
+  if (left > kSpinWhileMoreThan) {
+    const int most = std::max(1, static_cast<int>(std::floor(left)) - 1);
+    return std::min(base::RandIntInclusive(2, 3), most);
+  }
+  return 1;
+}
+
+// Where the hand would land is calm on the terrain as it is now (for a
+// pointer drag, the dragged item's centre too, the libraries' zones
+// included), the renderer has it in the calm stretch, and no fixed cover
+// the target is not inside lies over it. A pointer drag over a list's
+// item lands on its slot, where ChooseLanding looks: somewhere calm on the
+// part of the slot's region that shows.
+bool DragSession::LandingGood() const {
+  if (!reading_ || !terrain_ || !reading_->land_calm) {
+    return false;
+  }
+  const DragRect box = RectToRoot(reading_->box.get());
+  if (const std::optional<SlotAim> aim = SlotLanding()) {
+    const DragRect within = aim->region.Intersect(ShownClip());
+    if (within.Contains(aim->at) &&
+        terrain_->Calm(aim->at, kClearance, item_offset_) &&
+        !UnderCover(aim->at, box)) {
+      return true;
+    }
+    return CalmIn(within, aim->at, box).has_value();
+  }
+  const PlannerPoint land = ToRoot(reading_->land_x, reading_->land_y);
+  return terrain_->Calm(land, kClearance, item_offset_) &&
+         !UnderCover(land, box);
+}
+
+// A fixed box over p that the target does not lie inside: what a press at p
+// would reach is that cover.
+bool DragSession::UnderCover(const PlannerPoint& p,
+                             const DragRect& target) const {
+  if (!terrain_) {
+    return false;
+  }
+  for (const DragFixedBox& cover : terrain_->fixed_boxes()) {
+    if (!cover.box.Contains(p)) {
+      continue;
+    }
+    const bool holds_target = !target.IsEmpty() && target.x >= cover.box.x &&
+                              target.y >= cover.box.y &&
+                              target.right() <= cover.box.right() &&
+                              target.bottom() <= cover.box.bottom();
+    if (!holds_target) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool DragSession::BinderHasRoom() const {
+  const DragBand* band = terrain_ ? terrain_->Find(binder_id_) : nullptr;
+  if (!band) {
+    return true;
+  }
+  return HasRoom(*band, vertical_, way_);
+}
+
+// The calm stretch the target is to land in along an axis, in root DIPs.
+double DragSession::CalmLength(bool vertical) const {
+  const blink::mojom::AgentCarryReading* r = CurrentReading();
+  if (!r) {
+    return 0;
+  }
+  const PlannerPoint from = ToRoot(r->aim_x, r->aim_y);
+  const PlannerPoint to =
+      vertical ? ToRoot(r->aim_x, r->aim_y + std::max(0.0, r->calm_y))
+               : ToRoot(r->aim_x + std::max(0.0, r->calm_x), r->aim_y);
+  return Distance(from, to);
+}
+
+// A pointer drag's need grown past the library's zone: the renderer's need
+// clears Blink's 20 px belts only, and a library scrolls from far wider
+// zones. Along each axis, where the hand will land -- the aim, or over a
+// list's item its slot's point and the ends of its region, as
+// ChooseLanding lands -- and the dragged item's centre with it are brought
+// 3 px inside the zone of the box the wheel turns (before a stage, the box
+// that shows the target), as far as that box can still scroll that way;
+// fewer of them when the zone is too short for all. Not along an axis the
+// zone has no extent on, where nothing brings them inside it -- only that
+// axis: a row too short for a library's zones still has them across.
+void DragSession::ExtendNeedForZones() {
+  if (!PointerDrag() || range_grab_ || !terrain_ || !reading_) {
+    return;
+  }
+  const PlannerPoint aim = ToRoot(reading_->aim_x, reading_->aim_y);
+  const DragBand* box =
+      terrain_->Find(binder_id_ != 0 ? binder_id_ : terrain_->OwnerAt(aim));
+  if (!box) {
+    return;
+  }
+  const std::optional<SlotAim> on_slot = SlotLanding();
+  const PlannerPoint land = on_slot ? on_slot->at : aim;
+  const DragRect region = on_slot ? on_slot->region : DragRect();
+  const DragRect zone = box->lib_inner.Inset(kClearance, kClearance);
+  for (const bool vertical : {true, false}) {
+    if (!((vertical ? box->lib_inner.h : box->lib_inner.w) > 0)) {
+      continue;
+    }
+    double& need = vertical ? need_.y : need_.x;
+    const double at = vertical ? land.y : land.x;
+    const double item = vertical ? item_offset_.y : item_offset_.x;
+    const double lo = vertical ? zone.y : zone.x;
+    const double hi = vertical ? zone.bottom() : zone.right();
+    // Where each comes to rest with the need as it is: the landing point,
+    // the item's centre with it, the region's ends. More need moves the
+    // content on (up or left).
+    std::vector<double> rests = {at - need, at + item - need};
+    if (on_slot && !region.IsEmpty()) {
+      rests.push_back((vertical ? region.y : region.x) - need);
+      rests.push_back((vertical ? region.bottom() : region.right()) - need);
+    }
+    // The least more need that puts the first `count` of them in [lo, hi].
+    const auto more_for = [&rests, lo, hi](size_t count, double* more) {
+      double least = rests[0] - hi;
+      double most = rests[0] - lo;
+      for (size_t i = 1; i < count; ++i) {
+        least = std::max(least, rests[i] - hi);
+        most = std::min(most, rests[i] - lo);
+      }
+      if (least > most) {
+        return false;
+      }
+      *more = std::clamp(0.0, least, most);
+      return true;
+    };
+    double more = 0;
+    if (!more_for(rests.size(), &more) && !more_for(2, &more)) {
+      more_for(1, &more);
+    }
+    const bool room = HasRoom(*box, vertical, more > 0 ? 1 : -1);
+    if (!room) {
+      more = 0;
+    }
+    need += more;
+  }
+}
+
+// The box a wheel turned at p would latch, as the terrain has it: from the
+// box that shows p, the first up its chain that can still scroll the
+// stage's way. 0 when none is known.
+int DragSession::LatchAt(const PlannerPoint& p) const {
+  if (!terrain_) {
+    return 0;
+  }
+  int box = terrain_->OwnerAt(p);
+  for (size_t steps = 0; box != 0 && steps <= terrain_->bands().size();
+       ++steps) {
+    const DragBand* band = terrain_->Find(box);
+    if (!band) {
+      return 0;
+    }
+    if (HasRoom(*band, vertical_, way_)) {
+      return box;
+    }
+    box = band->parent;
+  }
+  return 0;
+}
+
+// The hand parked during a spin or its settle, the box the wheel turns
+// moving under it: the boxes inside that box moved with it since the map
+// was read. Moved by its change of offsets, they are checked against the
+// hand; a hand now in one of their bands darts out at once (the survey after
+// the settle reads Blink's own map again).
+void DragSession::ParkedHandCheck() {
+  if (Stopped() || phase_ != Phase::kCarry || leg_running_ || replanning_ ||
+      !terrain_ || range_grab_) {
+    return;
+  }
+  // The box the wheel turned there (its latch), else the binder.
+  const int turned = notch_latch_id_ != 0 ? notch_latch_id_ : binder_id_;
+  const auto now = latest_offsets_.find(turned);
+  const auto then = terrain_offsets_.find(turned);
+  if (now == latest_offsets_.end() || then == terrain_offsets_.end()) {
+    return;
+  }
+  const double scale = CssScale();
+  const PlannerPoint shift{-(now->second.x - then->second.x) * scale,
+                           -(now->second.y - then->second.y) * scale};
+  if (std::hypot(shift.x, shift.y) < 0.5) {
+    return;
+  }
+  const DragTerrain moved = ShiftedTerrain(turned, shift);
+  const PlannerPoint hand = Hand();
+  // Native: as the dwell guard counts it, within 1.5 px of a band too.
+  const bool in_band = PointerDrag()
+                           ? !moved.Calm(hand, kClearance, item_offset_)
+                           : moved.BudgetBandAt(hand) != 0;
+  if (!in_band) {
+    return;
+  }
+  const std::optional<PlannerPoint> calm =
+      moved.NearestCalm(hand, kCalmSearch, item_offset_);
+  if (!calm) {
+    return;
+  }
+  PlayLeg(PlanDart(&moved, hand, *calm),
+          base::BindOnce(&DragSession::MaybeReadAfterSettle, Weak()));
+}
+
+// The terrain with every band box inside `box` (by the parent chain) moved
+// by `shift`, its visible part clipped to `box`'s.
+DragTerrain DragSession::ShiftedTerrain(int box,
+                                        const PlannerPoint& shift) const {
+  std::vector<DragBand> bands = terrain_->bands();
+  const DragBand* holder = terrain_->Find(box);
+  const DragRect clip = holder ? holder->visible : DragRect();
+  const auto moved = [&shift](const DragRect& r) {
+    return DragRect{r.x + shift.x, r.y + shift.y, r.w, r.h};
+  };
+  for (DragBand& band : bands) {
+    bool inside = false;
+    int up = band.parent;
+    for (size_t steps = 0; up != 0 && steps <= bands.size(); ++steps) {
+      if (up == box) {
+        inside = true;
+        break;
+      }
+      const DragBand* parent = terrain_->Find(up);
+      up = parent ? parent->parent : 0;
+    }
+    if (!inside) {
+      continue;
+    }
+    band.border = moved(band.border);
+    band.outer = moved(band.outer);
+    band.inner = moved(band.inner);
+    band.lib_inner = moved(band.lib_inner);
+    band.visible = moved(band.visible).Intersect(clip);
+  }
+  DragTerrain shifted(terrain_->mode(), terrain_->viewport(), std::move(bands),
+                      terrain_->fixed_boxes());
+  if (terrain_->mode() == DragMode::kPointer) {
+    shifted.SetGrabChain(grab_chain_);
+    if (binder_id_ != 0) {
+      shifted.SetBinder(binder_id_);
+    }
+  }
+  return shifted;
+}
+
+// A station found here when the renderer finds none -- it looks only
+// toward a need of its own, Blink's belts -- for a pointer drag whose need
+// is a library zone's alone: the last station, while the wheel there still
+// turns the same box; else the calm place nearest the hand over the middle
+// 40-60 % of what shows of the box (the zone's, else the binder, else the
+// one that shows the target) where the wheel turns that box. The box must
+// have room that way. False: none.
+bool DragSession::StationFromTerrain() {
+  if (!terrain_ || !reading_) {
+    return false;
+  }
+  int box = zone_box_ != 0 ? zone_box_ : binder_id_;
+  if (box == 0) {
+    box = terrain_->OwnerAt(ToRoot(reading_->aim_x, reading_->aim_y));
+  }
+  // Only a box that holds the target (its scroll moves it) and that the
+  // page lets the wheel scroll.
+  const std::vector<int> holders = TargetChain(landing_);
+  const DragBand* band = terrain_->Find(box);
+  const bool room = band && HasRoom(*band, vertical_, way_);
+  if (!room || band->wheel_blocked || !std::ranges::contains(holders, box)) {
+    return false;
+  }
+  const std::string name = BoxName(box, "the page");
+  if (has_station_ && box == binder_id_ &&
+      terrain_->Calm(station_, kClearance, item_offset_) &&
+      LatchAt(station_) == box) {
+    TakeStation(station_, region_, box, name);
+    return true;
+  }
+  const DragRect area = band->visible.Intersect(
+      terrain_->viewport().Inset(kViewMargin, kViewMargin));
+  if (area.IsEmpty()) {
+    return false;
+  }
+  const double along_length = vertical_ ? area.h : area.w;
+  const double across_length = vertical_ ? area.w : area.h;
+  const double along_from =
+      (vertical_ ? area.y : area.x) + kStationFrom * along_length;
+  const double inset =
+      std::min(kStationInsetMaxPx, std::max(0.0, across_length / 2 - 1));
+  const double across_from = (vertical_ ? area.x : area.y) + inset;
+  const double across_span = std::max(0.0, across_length - 2 * inset);
+  const PlannerPoint hand = Hand();
+  std::optional<PlannerPoint> best;
+  double best_distance = 0;
+  for (int j = 0; j < kStationAlong; ++j) {
+    for (int i = 0; i < kStationAcross; ++i) {
+      const double along =
+          along_from + kStationSpan * along_length * (j + 0.5) / kStationAlong;
+      const double across =
+          across_from + across_span * (i + 0.5) / kStationAcross;
+      const PlannerPoint p =
+          vertical_ ? PlannerPoint{across, along} : PlannerPoint{along, across};
+      if (!terrain_->Calm(p, kClearance, item_offset_) || LatchAt(p) != box) {
+        continue;
+      }
+      const double distance = Distance(p, hand);
+      if (!best || distance < best_distance) {
+        best = p;
+        best_distance = distance;
+      }
+    }
+  }
+  if (!best) {
+    return false;
+  }
+  TakeStation(*best, DragRect{best->x - 3, best->y - 3, 6, 6}, box, name);
+  return true;
+}
+
+// ================================== phases 4 and 5: approach, and verify
+
+// Rule (a): the carry is over. No notch is turned from here on, and the
+// last spin's scroll has settled and been read (or no notch was turned).
+// The page is surveyed as it is now before the landing is chosen.
+void DragSession::StartApproach() {
+  if (Stopped() || letting_go_) {
+    return;
+  }
+  phase_ = Phase::kApproach;
+  notch_timer_.Stop();
+  settle_timer_.Stop();
+  settling_ = false;
+  spinning_ = false;
+  ++spin_token_;
+  zone_box_ = 0;  // a zone's stage, if one was under way, is over
+  SurveyFresh(base::BindOnce(&DragSession::ReadLanding, Weak()));
+}
+
+// The landing L from a fresh read.
+void DragSession::ReadLanding() {
+  if (Stopped()) {
+    return;
+  }
+  switch (params_.target_kind) {
+    case TargetKind::kElement:
+      ReadCarry(ReadUse::kLanding);
+      return;
+    case TargetKind::kFraction:
+      // Across the grabbed element as it is now.
+      ReadSlot(SlotUse::kLanding, grab_id_);
+      return;
+    case TargetKind::kPoint:
+      Land(params_.point);
+      return;
+    case TargetKind::kValue:
+      // The survey just taken read the track for the value.
+      LandOnValue();
+      return;
+  }
+  NOTREACHED();
+}
+
+// An element's landing: where a hand lands on it now (native), or over its
+// slot as it was before the drag moved anything (a pointer drag over a
+// sortable list).
+void DragSession::LandOnElement() {
+  if (Stopped()) {
+    return;
+  }
+  letgo_box_ = RectToRoot(reading_->box.get());
+  // Its slot, for either kind of drag: a native sortable honours the side
+  // asked for as a library's does.
+  ReadSlot(SlotUse::kLanding, params_.target_node_id);
+}
+
+void DragSession::LandOnValue() {
+  if (Stopped()) {
+    return;
+  }
+  const blink::mojom::AgentDragSurvey& s = *survey_;
+  if (!s.value_found) {
+    Fail("unreachable", "no place along " + GrabName() + " gives the value " +
+                            base::NumberToString(params_.value));
+    return;
+  }
+  value_reached_ = s.value_reached;
+  Land(ToRoot(s.value_x, s.value_y));
+}
+
+// The approach to L: one leg when L is calm (its slow tail at L); else a
+// leg to the calm point nearest L, the verify from there, and a dart in.
+// What has scrolled and where the target was are noted for the let-go.
+void DragSession::Land(const PlannerPoint& asked) {
+  if (Stopped()) {
+    return;
+  }
+  // A pointer drag never darts into a library's live zone -- one of a box
+  // that holds the target and can still scroll toward bringing the landing
+  // out of it, and would at once. The carry goes on along that axis
+  // instead, at most twice a drag; then the zone's inner edge nearest the
+  // landing that is still over the target; else blocked. A dead zone (the
+  // box at its end), a box that does not hold the target, and Blink's bands
+  // keep the dart.
+  PlannerPoint landing = asked;
+  edge_landing_ = false;
+  std::optional<LiveZone> zone;
+  if (PointerDrag() && params_.target_kind == TargetKind::kElement &&
+      !terrain_->Calm(landing, kClearance, item_offset_)) {
+    zone = LiveZoneAt(landing);
+  }
+  if (zone) {
+    // A box found not to carry the target along this axis (AfterSpin).
+    const bool stuck = zone->box == stuck_box_ &&
+                       (zone->side == 1 || zone->side == 2) == stuck_vertical_;
+    if (!stuck && zone_returns_ < kMaxZoneReturns) {
+      ++zone_returns_;
+      CarryOutOfZone(zone->box, zone->side, landing);
+      return;
+    }
+    // The returns spent, or the target found not to move with the zone's
+    // box: the zone's inner edge when it gives a place; else blocked -- or,
+    // for a target that does not move with the box, the dart.
+    if (const std::optional<PlannerPoint> edge =
+            ZoneEdgeLanding(zone->box, landing)) {
+      landing = *edge;
+      edge_landing_ = true;
+    } else if (!stuck) {
+      Fail("blocked", TargetName() + " shows only in the " +
+                          SideWord(zone->side) + " edge zone of " +
+                          BoxName(zone->box, "a box") +
+                          ", which a drag library scrolls on its own, and "
+                          "the wheel did not carry it out of it");
+      return;
+    }
+  }
+  phase_ = Phase::kApproach;
+  landing_ = landing;
+  landing_offsets_ = frame_offsets_;
+  landing_box_ = frame_target_box_;
+  verified_slot_ = DragRect();
+  darted_ = false;
+  if (!terrain_->viewport().Contains(landing)) {
+    Fail("unreachable", "the place to let go is outside " + ViewName());
+    return;
+  }
+  const PlannerPoint from = Hand();
+  // Blink's band walk found the last landing (or the calm point beside it)
+  // in a band: this one is in a band too, and its calm point is
+  // stepped inward past the belt on that side. (An element's landing has
+  // been moved inward already, by ChooseLanding.)
+  PlannerPoint step;
+  const bool flagged = inward_side_ != 0;
+  if (flagged) {
+    step = InwardStep(inward_side_);
+  }
+  const bool landing_flagged = flagged && inward_landing_;
+  inward_side_ = 0;
+  in_band_landing_ =
+      landing_flagged || !terrain_->Calm(landing, kClearance, item_offset_);
+  calm_point_.reset();
+  if (landing_flagged) {
+    calm_point_ = PlannerPoint{landing.x + step.x, landing.y + step.y};
+  } else if (in_band_landing_) {
+    // The nearest calm place when it lies in the box whose band holds the
+    // landing (that box's calm part, as it shows); else the nearest in that
+    // part, near the landing first, within reach; else the nearest
+    // anywhere.
+    const std::optional<PlannerPoint> near =
+        terrain_->NearestCalm(landing, kCalmSearch, item_offset_);
+    const DragBand* holder = terrain_->Find(terrain_->BandAt(landing));
+    const DragRect in_box =
+        holder ? BandInner(*holder).Intersect(ShownClip()) : DragRect();
+    calm_point_ = near;
+    if (!in_box.IsEmpty() && !(near && in_box.Contains(*near))) {
+      const DragRect local =
+          DragRect{landing.x - kCalmLocalPx, landing.y - kCalmLocalPx,
+                   2 * kCalmLocalPx, 2 * kCalmLocalPx}
+              .Intersect(in_box);
+      std::optional<PlannerPoint> in = CalmIn(local, landing, DragRect());
+      if (!in) {
+        in = CalmIn(in_box, landing, DragRect());
+      }
+      if (in && Distance(*in, landing) <= kCalmSearch) {
+        calm_point_ = in;
+      }
+    }
+    if (calm_point_ && flagged) {
+      calm_point_ =
+          PlannerPoint{calm_point_->x + step.x, calm_point_->y + step.y};
+    }
+  }
+  // With no calm point within reach, the leg goes straight to L, its band
+  // runs budgeted.
+  const PlannerPoint first = calm_point_.value_or(landing);
+  // A list moves its items as the drag goes over it: its order is checked,
+  // not its target followed.
+  retargetable_ = !in_band_landing_ && !TargetInList();
+  // The approach is the hand's homing. A landing within kNoMovePx of the
+  // hand, the hand inside its drop zone, needs no move (the leg that brought
+  // it homed there); within kNudgePx, calm at both ends, it is one homing
+  // sub-movement; else a leg.
+  const std::optional<PlannerRect> hold =
+      calm_point_ ? std::nullopt : HoldFor(first);
+  const double reach = Distance(from, first);
+  if (!calm_point_ && !leg_running_ && reach <= kNoMovePx && hold &&
+      hold->x <= from.x && from.x <= hold->x + hold->w && hold->y <= from.y &&
+      from.y <= hold->y + hold->h) {
+    landing_ = from;
+    Post(base::BindOnce(&DragSession::OnApproachArrived, Weak()));
+    return;
+  }
+  if (reach <= kNudgePx && terrain_->Calm(from, kClearance, item_offset_) &&
+      terrain_->Calm(first, kClearance, item_offset_)) {
+    Nudge(first, hold, base::BindOnce(&DragSession::OnApproachArrived, Weak()));
+    return;
+  }
+  PlayLeg(PlanToCalm(from, first, LandingWidth(), PlannerPoint(), hold),
+          base::BindOnce(&DragSession::OnApproachArrived, Weak()));
+}
+
+// The carry taken up again along a live zone's axis, toward bringing the
+// landing -- and the dragged item's centre -- 3 px inside the zone's box:
+// the need that way at least that far (TakeStation keeps it), at the
+// station the renderer finds or, with none, one found here over the zone's
+// box (StationFromTerrain).
+void DragSession::CarryOutOfZone(int zone,
+                                 int side,
+                                 const PlannerPoint& landing) {
+  const DragBand* band = terrain_->Find(zone);
+  const DragRect inner =
+      band ? band->lib_inner.Inset(kClearance, kClearance) : DragRect();
+  const PlannerPoint item{landing.x + item_offset_.x,
+                          landing.y + item_offset_.y};
+  double out = 0;
+  switch (side) {
+    case 1:
+      out = std::min(-1.0, std::min(landing.y, item.y) - inner.y);
+      break;
+    case 2:
+      out = std::max(1.0, std::max(landing.y, item.y) - inner.bottom());
+      break;
+    case 3:
+      out = std::min(-1.0, std::min(landing.x, item.x) - inner.x);
+      break;
+    default:
+      out = std::max(1.0, std::max(landing.x, item.x) - inner.right());
+      break;
+  }
+  const bool vertical = side == 1 || side == 2;
+  double& need = vertical ? need_.y : need_.x;
+  need = out > 0 ? std::max(need, out) : std::min(need, out);
+  zone_box_ = zone;
+  // Its station is not one of the stages' budget: zone_returns_ bounds
+  // these.
+  stations_ = std::max(0, stations_ - 1);
+  StartStage(vertical);
+}
+
+// The box whose library zone p lies in, live: p, or the dragged item's
+// centre with it, beyond the box's lib_inner on a side the box can still
+// scroll toward, so a library scrolls it at once -- not the binder's far
+// end, which the terrain counts as the box moves but which scrolls nothing
+// while the box is at that end. A box listed later (inside) wins. None: no
+// such box.
+std::optional<DragSession::LiveZone> DragSession::LiveZoneAt(
+    const PlannerPoint& p) const {
+  if (!terrain_ || terrain_->mode() != DragMode::kPointer) {
+    return std::nullopt;
+  }
+  const PlannerPoint item{p.x + item_offset_.x, p.y + item_offset_.y};
+  // Only the boxes that hold the target: scrolling another brings nothing
+  // of it out of the zone (a fixed target, one in another container).
+  const std::vector<int> holders = TargetChain(p);
+  std::optional<LiveZone> found;
+  for (const DragBand& band : terrain_->bands()) {
+    if (!std::ranges::contains(holders, band.id)) {
+      continue;
+    }
+    // As DragTerrain::BandAt: a library tests the scroll containers that
+    // hold the dragged item, the page always, past their edges too.
+    const bool holds = (band.is_document && band.parent == 0) ||
+                       std::ranges::contains(grab_chain_, band.id);
+    for (const PlannerPoint& q : {p, item}) {
+      if (!holds && !band.visible.Contains(q)) {
+        continue;
+      }
+      const DragRect& inner = band.lib_inner;
+      int beyond = 0;
+      if (band.down && q.y >= inner.bottom()) {
+        beyond = 2;
+      } else if (band.up && q.y < inner.y) {
+        beyond = 1;
+      } else if (band.right && q.x >= inner.right()) {
+        beyond = 4;
+      } else if (band.left && q.x < inner.x) {
+        beyond = 3;
+      }
+      if (beyond != 0) {
+        found = LiveZone{band.id, beyond};
+        break;
+      }
+    }
+  }
+  return found;
+}
+
+// The band boxes that hold the target, innermost first: the box that shows
+// a place on what of it shows -- `hint` (the landing) when it is there, its
+// middle, then a 3 x 3 grid of it, until one names a box -- and the boxes
+// around that one. A place under a fixed cover the target is not inside is
+// skipped (OwnerAt names the cover there, or nothing). Scrolling one of
+// them moves the target; a fixed target has none.
+std::vector<int> DragSession::TargetChain(const PlannerPoint& hint) const {
+  std::vector<int> chain;
+  if (!terrain_ || !reading_) {
+    return chain;
+  }
+  const DragRect box = RectToRoot(reading_->box.get());
+  const DragRect shown = box.Intersect(ShownClip());
+  const DragRect over = shown.IsEmpty() ? box : shown;
+  std::vector<PlannerPoint> places;
+  if (over.Contains(hint)) {
+    places.push_back(hint);
+  }
+  places.push_back(Mid(over));
+  for (const double fy : {1.0 / 6, 0.5, 5.0 / 6}) {
+    for (const double fx : {1.0 / 6, 0.5, 5.0 / 6}) {
+      places.push_back(At(over, fx, fy));
+    }
+  }
+  for (const PlannerPoint& place : places) {
+    if (UnderCover(place, box)) {
+      continue;
+    }
+    int id = terrain_->OwnerAt(place);
+    while (id != 0 && !std::ranges::contains(chain, id) &&
+           chain.size() <= terrain_->bands().size()) {
+      chain.push_back(id);
+      const DragBand* band = terrain_->Find(id);
+      id = band ? band->parent : 0;
+    }
+    if (!chain.empty()) {
+      break;
+    }
+  }
+  return chain;
+}
+
+// Where to land once the carry's returns are spent: the calm point nearest
+// the landing on what of the target shows -- over a list, its slot (the
+// side asked for, else all of it), else its box 2 px in -- inside the
+// zone's box, so next to the zone's inner edge. None: nothing of it there
+// is calm.
+std::optional<PlannerPoint> DragSession::ZoneEdgeLanding(
+    int zone,
+    const PlannerPoint& landing) const {
+  const DragBand* band = terrain_ ? terrain_->Find(zone) : nullptr;
+  if (!band || !reading_) {
+    return std::nullopt;
+  }
+  const DragRect box = RectToRoot(reading_->box.get());
+  DragRect over = LandingInset(box);
+  if (const std::optional<SlotAim> aim = SlotLanding()) {
+    over = params_.slot_given && params_.slot != Slot::kOn
+               ? aim->region
+               : aim->slot.Inset(std::min(1.0, aim->slot.w / 4),
+                                 std::min(1.0, aim->slot.h / 4));
+  }
+  // Inside the zone's box: along an axis its lib_inner has no extent on (a
+  // row too short for a library's zones), all of the box --
+  // CalmIn's terrain test keeps out of the zones that are live.
+  DragRect inside = band->lib_inner;
+  if (!(inside.w > 0)) {
+    inside.x = band->border.x;
+    inside.w = band->border.w;
+  }
+  if (!(inside.h > 0)) {
+    inside.y = band->border.y;
+    inside.h = band->border.h;
+  }
+  return CalmIn(over.Intersect(ShownClip()).Intersect(inside), landing, box);
+}
+
+// Arrived at L (or the calm point beside it): Blink's own band walk asked
+// about the spot before the hand rests there (native), then the verify.
+void DragSession::OnApproachArrived() {
+  if (Stopped()) {
+    return;
+  }
+  if (in_band_landing_ && !calm_point_) {
+    Verify();  // in a band by design: no rest there
+    return;
+  }
+  if (StepsByOrder()) {
+    order_steps_ = 0;
+    StepByOrder();
+    return;
+  }
+  Probe(in_band_landing_ ? ProbeUse::kCalmPoint : ProbeUse::kLanding);
+}
+
+// A native drop over a list with a side asked for (before or after),
+// at a calm landing: a list that moves the dragged node as the pointer
+// passes its items (SortableJS) is judged by its order, not by geometry.
+// Not again once a stepped landing has been corrected.
+bool DragSession::StepsByOrder() const {
+  return kind_ == Kind::kNative && !in_band_landing_ && params_.slot_given &&
+         params_.slot != Slot::kOn && TargetInList() && grab_id_ != 0 &&
+         !step_corrected_;
+}
+
+// The list has moved the grabbed element since the press: another place in
+// its list, or into another list -- one that moves the dragged node as the
+// pointer passes its items, not one that reorders only on the drop. (Not by
+// its slot's place: a target restyled on dragover moves that too.)
+bool DragSession::ListMovedGrab(const blink::mojom::AgentSlot& now) const {
+  if (!grab_before_ || !grab_before_->found || !now.found || now.count < 2) {
+    return false;
+  }
+  const blink::mojom::AgentSlot& before = *grab_before_;
+  if (SameList(now, before)) {
+    return now.index != before.index;
+  }
+  return before.count < 2 || now.list_name != before.list_name;
+}
+
+// One frame for the list to settle, then its order is read.
+void DragSession::StepByOrder() {
+  if (Stopped()) {
+    return;
+  }
+  step_timer_.Start(FROM_HERE, base::Milliseconds(FrameMs()),
+                    base::BindOnce(&DragSession::ReadOrderForStep, Weak()));
+}
+
+void DragSession::ReadOrderForStep() {
+  if (Stopped()) {
+    return;
+  }
+  ReadSlot(SlotUse::kStepGrab, grab_id_);
+}
+
+// Rule (b), with the hand at L (or at the calm point beside it).
+void DragSession::Verify() {
+  if (Stopped()) {
+    return;
+  }
+  phase_ = Phase::kVerify;
+  retargetable_ = false;
+  switch (params_.target_kind) {
+    case TargetKind::kElement:
+      if (kind_ == Kind::kNative) {
+        // A press at L must reach the target itself: a label does not
+        // count.
+        Ask(base::BindRepeating(&DragSession::IssueHitCheck, Weak(),
+                                HitUse::kVerify));
+      } else {
+        // L inside the target's slot, on the side asked for.
+        ReadSlot(SlotUse::kVerify, params_.target_node_id);
+      }
+      return;
+    case TargetKind::kValue:
+      Ask(base::BindRepeating(&DragSession::IssueValueAt, Weak()));
+      return;
+    case TargetKind::kFraction:
+    case TargetKind::kPoint:
+      Describe(DescribeUse::kBefore);
+      return;
+  }
+  NOTREACHED();
+}
+
+void DragSession::Describe(DescribeUse use) {
+  Ask(base::BindRepeating(&DragSession::IssueDescribe, Weak(), use));
+}
+
+// Verified: a dart in when L is in a band (its 1-99 % span kDartMs, verified
+// from the calm point beside it), then the rest.
+void DragSession::Approached() {
+  if (Stopped()) {
+    return;
+  }
+  if (calm_point_ && !darted_) {
+    darted_ = true;
+    Dart(landing_, base::BindOnce(&DragSession::Rest, Weak()));
+    return;
+  }
+  Rest();
+}
+
+// A landing that did not verify: out of any band at once, a fresh reading,
+// a new landing (re-aimed, not the same one again). After two: missed
+// (named by what was there), refused (the page never took it) or moved.
+void DragSession::Correct(Miss miss) {
+  if (Stopped()) {
+    return;
+  }
+  final_timer_.Stop();
+  if (miss == Miss::kHit) {
+    // Re-aimed next time: the target's middle, then the other half.
+    if (hit_retries_ == 0) {
+      last_failed_landing_ = landing_;
+    }
+    ++hit_retries_;
+  }
+  // A landing the steps along a list took that did not verify is
+  // corrected once, back to the slot point with no steps; a miss there is
+  // the answer.
+  const bool give_up = step_corrected_;
+  if (order_steps_ > 0) {
+    step_corrected_ = true;
+  }
+  if (++corrections_ > kMaxCorrections || give_up) {
+    switch (miss) {
+      case Miss::kRefused:
+        if (!ever_accepted_) {
+          Fail("refused", TargetName() +
+                              " never said it would take the drop, so "
+                              "nothing was dropped");
+        } else {
+          Fail("missed", TargetName() +
+                             " would not take the drop where it was let "
+                             "go");
+        }
+        return;
+      case Miss::kMoved:
+        Fail("moved", TargetName() + " kept moving under the pointer");
+        return;
+      case Miss::kHit:
+        if (inert_cause_ && hit_ == "inert") {
+          // browser: an inert target, which no aim fixes: with what
+          // switched it off, for the caller to word.
+          SetHit(inert_cause_->hit, inert_cause_->kind);
+          Fail("missed", "inert");
+          return;
+        }
+        Fail("missed",
+             "the pointer could not be put over " + TargetName() + ": " +
+                 (hit_.empty() ? std::string("something else") : hit_) +
+                 " was there instead");
+        return;
+      case Miss::kBand:
+        Fail("missed", "the pointer could not be put over " + TargetName() +
+                           " clear of " + hit_);
+        return;
+      case Miss::kCover:
+        Fail("missed",
+             "the pointer could not be put over " + TargetName() + ": " +
+                 (hit_.empty() ? std::string("something else") : hit_) +
+                 " lay over it");
+        return;
+    }
+  }
+  phase_ = Phase::kApproach;
+  darted_ = false;
+  // Under a fixed cover: the carry goes on toward the part no cover
+  // lies over (a fresh reading's need points there, and calls it covered
+  // only when every place is); else a new approach.
+  base::OnceClosure next =
+      miss == Miss::kCover
+          ? base::BindOnce(&DragSession::BeginCarry, Weak())
+          : base::BindOnce(&DragSession::StartApproach, Weak());
+  if (HandInBand(Hand())) {
+    DartOut(std::move(next));
+    return;
+  }
+  std::move(next).Run();
+}
+
+// A target that moved during a calm approach (a native drag) is followed
+// when the leg still to go is at least three times the change: the rest of
+// the leg planned anew from the hand, at the hand's speed. Shorter: the
+// verify corrects it.
+void DragSession::MaybeRetarget(const DragRect& box_now) {
+  if (Stopped() || phase_ != Phase::kApproach || !retargetable_ ||
+      !leg_running_ || kind_ != Kind::kNative || landing_box_.IsEmpty()) {
+    return;
+  }
+  const PlannerPoint was = Mid(landing_box_);
+  const PlannerPoint is = Mid(box_now);
+  const PlannerPoint shift{is.x - was.x, is.y - was.y};
+  const double change = std::hypot(shift.x, shift.y);
+  if (change < kRetargetMinPx) {
+    return;
+  }
+  const PlannerPoint hand = Hand();
+  if (Distance(hand, landing_) < kRetargetFactor * change) {
+    return;
+  }
+  const PlannerPoint landing{landing_.x + shift.x, landing_.y + shift.y};
+  if (!terrain_->Calm(landing, kClearance, item_offset_)) {
+    return;
+  }
+  landing_ = landing;
+  landing_box_ = box_now;
+  LegConstraints c =
+      terrain_->Constraints(hand, landing, kBandBudgetMs, item_offset_);
+  c.entry_velocity = HandVelocity();
+  c.hold = HoldFor(landing, &box_now);
+  ++replans_;
+  base::OnceClosure then = std::move(after_leg_);
+  PlayLeg(Plan(hand, landing, LandingWidth(), PathIntent::kDefault, c),
+          std::move(then));
+}
+
+// Since the landing was read: a watched box scrolled (every kind of
+// target), or (a native drag over an element) L is no longer inside the
+// target, 2 px in. A drop zone that restyles itself on dragenter has not
+// moved; a pointer library moves its items about on purpose, and their
+// slots are checked instead.
+bool DragSession::ChangedSinceLanding() const {
+  for (const auto& [box, was] : landing_offsets_) {
+    const auto is = frame_offsets_.find(box);
+    if (is != frame_offsets_.end() &&
+        (std::abs(is->second.x - was.x) >= kNetPx ||
+         std::abs(is->second.y - was.y) >= kNetPx)) {
+      return true;
+    }
+  }
+  // A native drag over an element not in a list (a list's order is checked
+  // instead): the pixel the last dragover used still inside the target, in
+  // by 2 px or what a thin one allows.
+  if (params_.target_kind == TargetKind::kElement && kind_ == Kind::kNative &&
+      !TargetInList() && !frame_target_box_.IsEmpty()) {
+    const DragRect inside = LandingInset(frame_target_box_);
+    return !inside.Contains(Hand());
+  }
+  return false;
+}
+
+// An element's landing: over its slot on the side asked for
+// when it is one of a list (native drags too), else where a hand lands on
+// it; re-aimed after a hit miss (its middle, then the other half of it);
+// stepped inward past Blink's belt when its band walk found the last
+// landing in a band; and calm on the terrain -- for a pointer drag, its
+// libraries' zones -- and under no fixed cover, where any part of that
+// place is; only ever on what of the target shows: none when nothing of it
+// does.
+std::optional<PlannerPoint> DragSession::ChooseLanding(
+    const blink::mojom::AgentSlot* slot) {
+  const DragRect box = RectToRoot(reading_->box.get());
+  const DragRect layout =
+      slot ? RectToRoot(slot->layout_box.get()) : DragRect();
+  const bool in_list = slot && slot->count >= 2 && !layout.IsEmpty();
+  const bool vertical = in_list ? slot->list_vertical : box.h > box.w;
+  DragRect region;
+  PlannerPoint preferred;
+  if (in_list) {
+    // Its slot: the side asked for, or an explicit fraction of it, the
+    // fraction reached then told across the slot too.
+    const SlotAim aim = SlotTarget(layout, vertical);
+    preferred = aim.at;
+    region = aim.region;
+    if (FractionAsked()) {
+      letgo_box_ = layout;
+    }
+  } else {
+    region = LandingInset(box);
+    preferred = ToRoot(reading_->land_x, reading_->land_y);
+  }
+  const PlannerPoint mid = Mid(region);
+  if (hit_retries_ == 1) {
+    preferred = mid;
+  } else if (hit_retries_ >= 2) {
+    // The other half from the first miss, along the list (or the longer
+    // side); a first miss at the middle goes to three quarters.
+    const PlannerPoint was = last_failed_landing_;
+    const double centre = vertical ? mid.y : mid.x;
+    const double quarter = (vertical ? region.h : region.w) / 4;
+    double along = 2 * centre - (vertical ? was.y : was.x);
+    if (std::abs(along - centre) < 2) {
+      along = centre + quarter;
+    }
+    preferred = mid;
+    if (vertical) {
+      preferred.y = along;
+    } else {
+      preferred.x = along;
+    }
+  }
+  if (inward_side_ != 0 && inward_landing_) {
+    const PlannerPoint step = InwardStep(inward_side_);
+    preferred = PlannerPoint{preferred.x + step.x, preferred.y + step.y};
+    inward_side_ = 0;
+  }
+  // Inside the region, on what of it shows: the view 2 px in and
+  // every scroller holding the target clip it. A slot's side that does not
+  // show: what of the target does (the order check sees to the side);
+  // nothing of it: no landing.
+  const DragRect shown = ShownClip();
+  DragRect within = region.Intersect(shown);
+  if (within.IsEmpty()) {
+    within = box.Intersect(shown);
+  }
+  if (within.IsEmpty()) {
+    return std::nullopt;
+  }
+  preferred.x = std::clamp(preferred.x, within.x,
+                           std::max(within.x, within.right() - 0.01));
+  preferred.y = std::clamp(preferred.y, within.y,
+                           std::max(within.y, within.bottom() - 0.01));
+  if (!terrain_->Calm(preferred, kClearance, item_offset_) ||
+      UnderCover(preferred, box)) {
+    if (const std::optional<PlannerPoint> calm =
+            CalmIn(within, preferred, box)) {
+      // Out of a band: not at the clearance under its edge.
+      preferred = DeeperOutOfBand(preferred, *calm, within, box);
+    }
+  }
+  // Calm, but a few px under a band's edge: taken on too -- unless the call
+  // asked for that place: a calm asked fraction is honoured.
+  if (!FractionAsked()) {
+    preferred = OffBandEdge(preferred, within, box);
+  }
+  // Its pixel at least 0.5 px inside the target itself; a pointer
+  // drag's over a list, held to its slot region instead: a sortable
+  // moves the item out of its slot while the dragged one hovers, and the
+  // slot is where it lands.
+  if (PointerDrag() && in_list) {
+    return PixelInside(within, preferred);
+  }
+  return PixelInside(box, preferred);
+}
+
+// What of the target can show: the view 2 px in, clipped by every
+// scroller that holds it (the reading's belts, the window's included).
+DragRect DragSession::ShownClip() const {
+  if (!terrain_) {
+    return DragRect();
+  }
+  DragRect clip = terrain_->viewport().Inset(kViewMargin, kViewMargin);
+  if (!reading_) {
+    return clip;
+  }
+  for (const blink::mojom::AgentScrollBeltPtr& belt : reading_->belts) {
+    if (!belt || !FiniteBox(belt->outer.get())) {
+      continue;
+    }
+    const DragRect outer = RectToRoot(belt->outer.get());
+    if (!outer.IsEmpty()) {
+      clip = clip.Intersect(outer);
+    }
+  }
+  return clip;
+}
+
+// Where the target lies when none of it shows: beside what the nearest
+// scroller holding it (else the page) shows.
+std::string DragSession::HiddenWhere() const {
+  const DragRect box = reading_ ? RectToRoot(reading_->box.get()) : DragRect();
+  const DragRect clip = ShownClip();
+  const std::string what = reading_ && !reading_->box_name.empty()
+                               ? reading_->box_name
+                               : std::string("the page");
+  std::string side = "outside";
+  if (!box.IsEmpty() && !clip.IsEmpty()) {
+    if (box.y >= clip.bottom()) {
+      side = "below";
+    } else if (box.bottom() <= clip.y) {
+      side = "above";
+    } else if (box.x >= clip.right()) {
+      side = "right of";
+    } else if (box.right() <= clip.x) {
+      side = "left of";
+    }
+  }
+  return side + " what " + what + " shows";
+}
+
+// The calm point of `region` nearest `toward`, from a grid over it; with a
+// `target`, under no fixed cover the target is not inside.
+std::optional<PlannerPoint> DragSession::CalmIn(const DragRect& region,
+                                                const PlannerPoint& toward,
+                                                const DragRect& target) const {
+  std::optional<PlannerPoint> best;
+  if (region.IsEmpty() || !terrain_) {
+    return best;
+  }
+  double best_distance = 0;
+  for (int i = 0; i < kCalmGrid; ++i) {
+    for (int j = 0; j < kCalmGrid; ++j) {
+      const PlannerPoint p{region.x + region.w * (i + 0.5) / kCalmGrid,
+                           region.y + region.h * (j + 0.5) / kCalmGrid};
+      if (!terrain_->Calm(p, kClearance, item_offset_) ||
+          (!target.IsEmpty() && UnderCover(p, target))) {
+        continue;
+      }
+      const double distance = Distance(p, toward);
+      if (!best || distance < best_distance) {
+        best = p;
+        best_distance = distance;
+      }
+    }
+  }
+  return best;
+}
+
+// A list slot's part on the side asked for: along the list its middle half
+// (on), first third (before) or last third (after); across it, all of it.
+DragRect DragSession::SlotRegion(const DragRect& slot, bool vertical) const {
+  double lo = kSlotOnFrom;
+  double hi = kSlotOnTo;
+  if (params_.slot == Slot::kBefore) {
+    lo = 0;
+    hi = kSlotBeforeTo;
+  } else if (params_.slot == Slot::kAfter) {
+    lo = kSlotAfterFrom;
+    hi = 1;
+  }
+  const DragRect part =
+      vertical
+          ? DragRect{slot.x, slot.y + slot.h * lo, slot.w, slot.h * (hi - lo)}
+          : DragRect{slot.x + slot.w * lo, slot.y, slot.w * (hi - lo), slot.h};
+  return part.Inset(std::min(1.0, part.w / 4), std::min(1.0, part.h / 4));
+}
+
+// Where over a list's slot to land, and the region to land in: the side
+// asked for (SlotPoint, SlotRegion); for an explicit fraction with no slot,
+// that fraction of the slot, anywhere on it 2 px in, as a box that is in no
+// list.
+DragSession::SlotAim DragSession::SlotTarget(const DragRect& slot,
+                                             bool vertical) const {
+  if (FractionAsked()) {
+    return SlotAim{slot, At(slot, params_.aim_x, params_.aim_y),
+                   LandingInset(slot)};
+  }
+  return SlotAim{slot, SlotPoint(slot, vertical), SlotRegion(slot, vertical)};
+}
+
+// Where a pointer drag will land over a list's item, as the carry judges
+// it: its slot from the last survey, moved with the target since (the
+// reading's box), and the point and region SlotTarget takes on it. None
+// for a native drag, a target in no list, or no reading.
+std::optional<DragSession::SlotAim> DragSession::SlotLanding() const {
+  const blink::mojom::AgentCarryReading* reading = CurrentReading();
+  if (!PointerDrag() || params_.target_kind != TargetKind::kElement ||
+      !reading || !survey_ || !survey_->target || !survey_->target_reading) {
+    return std::nullopt;
+  }
+  const blink::mojom::AgentSlot& target = *survey_->target;
+  if (!target.found || target.count < 2) {
+    return std::nullopt;
+  }
+  const DragRect layout = RectToRoot(target.layout_box.get());
+  const DragRect was = RectToRoot(survey_->target_reading->box.get());
+  const DragRect now = RectToRoot(reading->box.get());
+  if (layout.IsEmpty() || was.IsEmpty() || now.IsEmpty()) {
+    return std::nullopt;
+  }
+  return SlotTarget(DragRect{layout.x + now.x - was.x, layout.y + now.y - was.y,
+                             layout.w, layout.h},
+                    target.list_vertical);
+}
+
+// An explicit fraction of the target asked for, with no slot: an aim
+// off the middle on either axis. The caller sends 0.5 when none was given,
+// so an explicit 0.5 reads as none -- which lands at the same point.
+bool DragSession::FractionAsked() const {
+  return params_.target_kind == TargetKind::kElement && !params_.slot_given &&
+         (std::abs(params_.aim_x - 0.5) > 1e-9 ||
+          std::abs(params_.aim_y - 0.5) > 1e-9);
+}
+
+// A pointer drag's verify over a list's slot: on the side asked for; with
+// an explicit fraction, or at a library zone's edge with no side asked,
+// anywhere on the slot.
+bool DragSession::OverSlot(const DragRect& slot,
+                           bool vertical,
+                           const PlannerPoint& p) const {
+  if (FractionAsked() || (edge_landing_ && params_.slot == Slot::kOn)) {
+    return slot.Contains(p);
+  }
+  return OnSlotSide(slot, vertical, p);
+}
+
+// The target is one of a list (two or more of its kind together).
+bool DragSession::TargetInList() const {
+  const blink::mojom::AgentSlot* target =
+      survey_ && survey_->target ? survey_->target.get() : nullptr;
+  return params_.target_kind == TargetKind::kElement && target &&
+         target->found && target->count >= 2;
+}
+
+// A native drag over a list that moves the grabbed element as it is
+// dragged (SortableJS's HTML5 mode and the like): the grabbed element
+// already where it was asked to go relative to the target, in the list's
+// order now.
+bool DragSession::OrderPasses(const blink::mojom::AgentSlot& grab,
+                              const blink::mojom::AgentSlot& target) const {
+  if (!SameList(grab, target)) {
+    return false;
+  }
+  switch (params_.slot) {
+    case Slot::kAfter:
+      return grab.index == target.index + 1;
+    case Slot::kBefore:
+      return grab.index == target.index - 1;
+    case Slot::kOn:
+      return std::abs(grab.index - target.index) == 1;
+  }
+  NOTREACHED();
+}
+
+// After the let-go's read of the grabbed element: with slot given and
+// the grabbed element in a list, the target's place is read too
+// (slotReached); then the description (a let-go) or the answer (an end, a
+// put-back).
+void DragSession::FinishAfterRead(SlotUse use) {
+  // Only after a real let-go, a drop or a release: a drag called off or
+  // put back has the order it began with, which is no result.
+  const bool let_go = use == SlotUse::kAfter && (letgo_outcome_ == "dropped" ||
+                                                 letgo_outcome_ == "released");
+  if (let_go && params_.slot_given &&
+      params_.target_kind == TargetKind::kElement && grab_after_ &&
+      grab_after_->found && grab_after_->count >= 2 && !slot_checked_ &&
+      CanAsk()) {
+    slot_checked_ = true;
+    after_next_ = use;
+    ReadSlot(SlotUse::kAfterTarget, params_.target_node_id);
+    return;
+  }
+  if (use == SlotUse::kAfter) {
+    Describe(DescribeUse::kAfter);
+    return;
+  }
+  Answer(end_outcome_, end_reason_);
+}
+
+// A verify passed: on to the description; the last check passed: the drop,
+// unless something scrolled since the landing was read.
+void DragSession::Passed(bool is_final) {
+  final_timer_.Stop();
+  if (!is_final) {
+    Describe(DescribeUse::kBefore);
+    return;
+  }
+  if (ChangedSinceLanding()) {
+    Correct(Miss::kMoved);
+    return;
+  }
+  Drop();
+}
+
+// An in-band landing's last checks ran out of its budget: no drop on a
+// stale answer -- out of the band, and corrected.
+void DragSession::OnFinalTimeout() {
+  if (Stopped() || phase_ != Phase::kLetGo || letting_go_) {
+    return;
+  }
+  DropReads();
+  hit_ = "no answer from the page in time";
+  Correct(Miss::kHit);
+}
+
+// Where over a list's slot to let go: along the list, the middle half
+// (on), the middle of the first third (before) or of the last (after);
+// across it, the aim.
+PlannerPoint DragSession::SlotPoint(const DragRect& slot, bool vertical) const {
+  const double aim_along = vertical ? params_.aim_y : params_.aim_x;
+  const double across = vertical ? params_.aim_x : params_.aim_y;
+  double along = std::clamp(aim_along, kSlotOnFrom, kSlotOnTo);
+  if (params_.slot == Slot::kBefore) {
+    along = kSlotBeforeAt;
+  } else if (params_.slot == Slot::kAfter) {
+    along = kSlotAfterAt;
+  }
+  return vertical ? At(slot, across, along) : At(slot, along, across);
+}
+
+bool DragSession::OnSlotSide(const DragRect& slot,
+                             bool vertical,
+                             const PlannerPoint& p) const {
+  if (!slot.Contains(p)) {
+    return false;
+  }
+  const double f = vertical ? (p.y - slot.y) / slot.h : (p.x - slot.x) / slot.w;
+  switch (params_.slot) {
+    case Slot::kOn:
+      return f >= kSlotOnFrom && f <= kSlotOnTo;
+    case Slot::kBefore:
+      return f <= kSlotBeforeTo;
+    case Slot::kAfter:
+      return f >= kSlotAfterFrom;
+  }
+  NOTREACHED();
+}
+
+// Blink's own band walk at the hand (native drags; a pointer library's
+// zones are not Blink's): where the plan means to rest -- a station, a calm
+// landing, the calm point beside an in-band one -- before it rests there.
+void DragSession::Probe(ProbeUse use) {
+  if (Stopped()) {
+    return;
+  }
+  if (kind_ != Kind::kNative || !CanAsk()) {
+    ProbedCalm(use);
+    return;
+  }
+  probing_ = true;
+  Ask(base::BindRepeating(&DragSession::IssueProbe, Weak(), use));
+}
+
+void DragSession::IssueProbe(ProbeUse use, uint64_t ask) {
+  if (!CanAsk()) {
+    return;
+  }
+  const PlannerPoint at = ToLocal(Hand());
+  collector_->ProbeBands(
+      {at.x, at.y}, base::BindOnce(&DragSession::OnProbe, Weak(), use, ask));
+}
+
+// In a band after all (the map and Blink disagree, or the page moved): the
+// hand steps inward past the belt at once; at a station the plan is made
+// again, at a landing it is corrected.
+void DragSession::OnProbe(ProbeUse use,
+                          uint64_t ask,
+                          std::vector<blink::mojom::AgentBandProbePtr> probes) {
+  if (!Current(ask)) {
+    return;
+  }
+  probing_ = false;
+  const blink::mojom::AgentBandProbe* probe =
+      probes.empty() ? nullptr : probes.front().get();
+  // Blink names the box it would autoscroll there and the side of its band
+  // the point is in: side 0 is that box, outside its band. Only a
+  // named side (1-4) is a band, and only it ever moves a landing inward.
+  if (!probe || probe->box == 0 || probe->side < 1 || probe->side > 4) {
+    ProbedCalm(use);
+    return;
+  }
+  const std::string box = BoxName(probe->box, "a box");
+  if (use == ProbeUse::kStation) {
+    if (!CountForcedReplan("the pointer kept ending up in " + box +
+                           "'s autoscroll band")) {
+      return;
+    }
+    StopPlan();
+    replanning_ = true;
+    InwardDart(probe->side,
+               base::BindOnce(&DragSession::ResumeOutOfBand, Weak()));
+    return;
+  }
+  // The next landing is not this one again: Blink's side is kept, and
+  // the landing (or its calm point) moves inward past the belt there.
+  hit_ = box + "'s autoscroll band";
+  inward_side_ = probe->side;
+  inward_landing_ = use == ProbeUse::kLanding;
+  InwardDart(probe->side,
+             base::BindOnce(&DragSession::Correct, Weak(), Miss::kBand));
+}
+
+void DragSession::ProbedCalm(ProbeUse use) {
+  if (use == ProbeUse::kStation) {
+    MaybeReadAfterSettle();
+    return;
+  }
+  Verify();
+}
+
+// Inward past Blink's belt on the side the walk named (1 top, 2 bottom,
+// 3 left, 4 right): 20 physical px and 4 DIPs more, by a dart. With no side,
+// to the nearest calm point.
+void DragSession::InwardDart(int side, base::OnceClosure then) {
+  const PlannerPoint step = InwardStep(side);
+  if (step.x == 0 && step.y == 0) {
+    DartOut(std::move(then));
+    return;
+  }
+  const PlannerPoint from = Hand();
+  Dart(PlannerPoint{from.x + step.x, from.y + step.y}, std::move(then));
+}
+
+// Inward past Blink's belt on a side (1 top, 2 bottom, 3 left, 4 right):
+// its 20 physical px and 4 DIPs more. 0, 0 for no side.
+PlannerPoint DragSession::InwardStep(int side) const {
+  const double depth = kBeltPhysicalPx / Dsf() + kInwardClearance;
+  switch (side) {
+    case 1:
+      return PlannerPoint{0, depth};
+    case 2:
+      return PlannerPoint{0, -depth};
+    case 3:
+      return PlannerPoint{depth, 0};
+    case 4:
+      return PlannerPoint{-depth, 0};
+    default:
+      return PlannerPoint();
+  }
+}
+
+// ===================== phases 6 and 7: rest, last checks, let go, after
+
+// The rest before the let-go: calm, the hand's release dwell, counted from
+// its last move the page saw and less the let-go's own lag; in a band, what
+// is left of the 110 ms after the last checks' share, at most 30 ms --
+// native, counted from the last dragover sent and less the let-go's own lag.
+void DragSession::Rest() {
+  if (Stopped()) {
+    return;
+  }
+  phase_ = Phase::kLetGo;
+  // The hand's own release dwell; in a band, what is left.
+  const double drawn_ms = planner_.ReleaseDwellMs();
+  double rest_ms = drawn_ms;
+  if (in_band_landing_) {
+    const double checks_ms =
+        kind_ == Kind::kNative && params_.target_kind == TargetKind::kElement
+            ? kFinalCheckMs
+            : 0;
+    // The 30 ms, native, from the last dragover the page saw (the leg's
+    // sub-pixel tail sends none), less the let-go's own lag.
+    double cap = kInBandRestMs;
+    if (kind_ == Kind::kNative && !last_over_at_.is_null()) {
+      cap -= kLetGoLagMs + (Now() - last_over_at_).InMillisecondsF();
+    }
+    rest_ms = std::clamp(std::min(InBandLeftMs() - checks_ms, cap), 0.0,
+                         kInBandRestMs);
+  } else if (!moved_at_.is_null()) {
+    // Calm: from the hand's last move the page saw -- a leg's sub-pixel tail
+    // and the reads since come out of it -- less the let-go's own lag.
+    rest_ms = std::max(
+        0.0, drawn_ms - (Now() - moved_at_).InMillisecondsF() -
+                 (kind_ == Kind::kNative ? kLetGoLagMs : kPointerLetGoLagMs));
+  }
+  step_timer_.Start(FROM_HERE, base::Milliseconds(rest_ms),
+                    base::BindOnce(&DragSession::LetGo, Weak()));
+}
+
+// What is left of an in-band landing's 110 ms, the drop's own 10 ms kept.
+double DragSession::InBandLeftMs() const {
+  const double spent =
+      run_box_ != 0 ? (Now() - run_start_).InMillisecondsF() : 0;
+  return kInBandTotalMs - kLetGoMarginMs - spent;
+}
+
+// Rule (b) at the moment it counts: nothing watched has scrolled since the
+// landing was read (and a native target still holds L). A pointer drag is
+// released; a native one waits for the page's answers to its dragovers
+// first.
+void DragSession::LetGo() {
+  if (Stopped() || phase_ != Phase::kLetGo || letting_go_) {
+    return;
+  }
+  if (ChangedSinceLanding()) {
+    Correct(Miss::kMoved);
+    return;
+  }
+  if (kind_ != Kind::kNative) {
+    // The slot the verify found the landing in has not moved since.
+    if (params_.target_kind == TargetKind::kElement &&
+        !verified_slot_.IsEmpty() && !frame_target_slot_.IsEmpty() &&
+        BoxMoved(verified_slot_, frame_target_slot_)) {
+      Correct(Miss::kMoved);
+      return;
+    }
+    Release();
+    return;
+  }
+  // In a band, the answers are waited for out of what is left of the 110 ms
+  // less the last hit check's share; calm, up to 150 ms. A drag begun with
+  // the hand already at rest on the landing (a page that woke late) has sent
+  // its dragenter and no dragover yet, and the page takes or refuses a drop
+  // only in a dragover: calm, the resting one and its answer are waited for
+  // too.
+  const bool no_over = overs_since_start_ < 2;
+  replies_until_ =
+      Now() +
+      (in_band_landing_
+           ? base::Milliseconds(std::max(0.0, InBandLeftMs() - kFinalCheckMs))
+           : kRepliesWaitCalm + (no_over ? kFirstOverWait : base::TimeDelta()));
+  WaitReplies();
+}
+
+// The page's answers to the dragovers sent, waited for (bounded): with
+// none pending, an element target must have taken the last one; still
+// pending when calm, the drop decides on what the view said last (refused
+// when it would not take it); still pending in a band, no drop on a stale
+// answer -- out of the band, and corrected. Then, for an element, the
+// target hit at the very pixel the last dragover went out at, within what
+// is left of an in-band budget.
+void DragSession::WaitReplies() {
+  if (Stopped() || phase_ != Phase::kLetGo || letting_go_) {
+    return;
+  }
+  // Calm, no dragover past the dragenter yet counts as an answer still to
+  // come (in a band the budget decides).
+  const bool pending =
+      handler_->DragRepliesPending() > 0 ||
+      (kind_ == Kind::kNative && !in_band_landing_ && overs_since_start_ < 2);
+  if (pending && Now() < replies_until_) {
+    step_timer_.Start(FROM_HERE, kRepliesPoll,
+                      base::BindOnce(&DragSession::WaitReplies, Weak()));
+    return;
+  }
+  // The let-go goes to the widget the last dragover went to, which must be
+  // this drag's own: another frame's content over the landing -- an embedded
+  // frame over the page, the page over a frame -- takes the drop, unseen by
+  // this renderer's hit check, and its own answers are not the target's.
+  // Re-aimed: the target's middle, then its other half.
+  if (kind_ == Kind::kNative) {
+    RenderWidgetHostViewBase* over = handler_->DragOverView();
+    if (over && over != LocalView()) {
+      hit_ = CoverName(IsPageDocument(handler_->LocalRootFor(over)),
+                       std::string());
+      Correct(Miss::kHit);
+      return;
+    }
+  }
+  if (pending && in_band_landing_) {
+    Correct(Miss::kRefused);
+    return;
+  }
+  if (!pending) {
+    const bool accepts = handler_->DragAccepts();
+    ever_accepted_ = ever_accepted_ || accepts;
+    if (params_.target_kind == TargetKind::kElement && !accepts) {
+      Correct(Miss::kRefused);
+      return;
+    }
+  }
+  if (params_.target_kind != TargetKind::kElement) {
+    Drop();
+    return;
+  }
+  final_at_ = Hand();
+  if (in_band_landing_) {
+    final_timer_.Start(FROM_HERE,
+                       base::Milliseconds(std::max(0.0, InBandLeftMs())),
+                       base::BindOnce(&DragSession::OnFinalTimeout, Weak()));
+  }
+  Ask(base::BindRepeating(&DragSession::IssueHitCheck, Weak(), HitUse::kFinal));
+}
+
+// The drop: drop, then dragend (EndDragPath's sequence); its wait for
+// answers still on their way held to what is left of an in-band landing's
+// budget.
+void DragSession::Drop() {
+  if (Stopped() || letting_go_) {
+    return;
+  }
+  reached_ = true;
+  letting_go_ = true;
+  hand_ = Hand();
+  drag_released_ = true;
+  end_outcome_ = "timeout";
+  end_reason_ = "the page did not finish the drop";
+  const base::TimeDelta cap =
+      in_band_landing_ ? base::Milliseconds(std::max(0.0, InBandLeftMs()))
+                       : kDropSettleMax;
+  end_timer_.Start(FROM_HERE, cap + kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  // What the drop leads to is watched from here.
+  action_id_ = handler_->OutcomeWatch()->ArmDrop(params_.follow_navigation);
+  handler_->DragFinish(true, cap,
+                       base::BindOnce(&DragSession::OnDropped, Weak()));
+}
+
+// The release: a real mouseup where the pointer is.
+void DragSession::Release() {
+  reached_ = true;
+  letting_go_ = true;
+  hand_ = MousePlace();
+  // The hand's time in a zone ends as the release goes out.
+  TrackDwell(0, Now(), /*guard=*/false);
+  end_outcome_ = "timeout";
+  end_reason_ = "the page did not finish the release";
+  end_timer_.Start(FROM_HERE, kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  InputHandler::MousePathRequest request =
+      MouseRequest({MousePlace()}, /*held=*/true);
+  request.end_action = EndAction::kRelease;
+  // What the release leads to is watched once it is queued: it goes out on
+  // the gesture's timer, after this.
+  if (handler_->QueueMousePath(
+          std::move(request),
+          base::BindOnce(&DragSession::OnReleased, Weak()))) {
+    action_id_ = handler_->OutcomeWatch()->ArmMouse(
+        EndAction::kRelease, /*click_count=*/1, params_.follow_navigation);
+  }
+}
+
+void DragSession::OnDropped(const std::string& outcome) {
+  if (answered()) {
+    return;
+  }
+  end_timer_.Stop();
+  TrackDwell(0, Now(), /*guard=*/false);
+  letgo_outcome_ = outcome;
+  if (outcome == "refused") {
+    letgo_reason_ = TargetName() +
+                    " would not take the drop where it was let go, so it got "
+                    "dragleave and dragend instead";
+  } else if (outcome != "dropped") {
+    letgo_reason_ = "the drag ended before the drop could be made";
+  }
+  After();
+}
+
+void DragSession::OnReleased(bool ok) {
+  if (answered()) {
+    return;
+  }
+  end_timer_.Stop();
+  if (!ok) {
+    Answer("gone",
+           "the release could not be delivered: the page's view "
+           "went away");
+    return;
+  }
+  TrackDwell(0, Now(), /*guard=*/false);
+  letgo_outcome_ = "released";
+  After();
+}
+
+// Let go: interception and the hooks are given back; the page is read once
+// it has been still for 3 frames, or after 800 ms.
+void DragSession::After() {
+  phase_ = Phase::kAfter;
+  letting_go_ = false;
+  ReleaseHooks(/*call_off_held=*/!interrupted_);
+  if (!CanAsk()) {
+    Answer(letgo_outcome_, letgo_reason_);
+    return;
+  }
+  // (Interrupted: read at once, before the new input moves anything.)
+  SettleThenRead(SlotUse::kAfter);
+}
+
+// The grabbed element read once the page has settled -- the watch still for
+// 3 frame intervals begun after the drag ended -- or after 800 ms; at once
+// for a call interrupted, before the new input moves anything.
+void DragSession::SettleThenRead(SlotUse use) {
+  settle_read_ = SettleRead{use, Now()};
+  if (interrupted_) {
+    ReadSettled();
+    return;
+  }
+  settle_read_timer_.Start(FROM_HERE, kAfterMax,
+                           base::BindOnce(&DragSession::ReadSettled, Weak()));
+}
+
+void DragSession::ReadSettled() {
+  if (answered() || !settle_read_) {
+    return;
+  }
+  const SlotUse use = settle_read_->use;
+  settle_read_.reset();
+  settle_read_timer_.Stop();
+  if (!CanAsk() || grab_id_ == 0) {
+    if (use == SlotUse::kAfter) {
+      Answer(letgo_outcome_, letgo_reason_);
+    } else {
+      Answer(end_outcome_, end_reason_);
+    }
+    return;
+  }
+  ReadSlot(use, grab_id_);
+}
+
+// ===================================== the abort path, deadline, answer
+
+// Any failure. Nothing pressed: the answer. Let go already: what the let-go
+// did. Else the abort path: (1) out of any band, (2) the drag ended per its
+// kind, (3) the answer with the figures so far.
+void DragSession::Fail(const std::string& outcome, const std::string& reason) {
+  if (answered() || ending_) {
+    return;
+  }
+  if (phase_ == Phase::kAfter) {
+    Answer(letgo_outcome_, letgo_reason_);
+    return;
+  }
+  if (letting_go_) {
+    return;  // the let-go goes on, bounded by its own wait
+  }
+  if (!pressed_) {
+    Answer(outcome, reason);
+    return;
+  }
+  BeginEnding(outcome, reason);
+}
+
+void DragSession::BadGeometry() {
+  Fail("gone", "the page gave no usable geometry");
+}
+
+// The target is under `reading.covering` wherever it could be brought.
+void DragSession::FailCovered(const blink::mojom::AgentCarryReading& reading) {
+  hit_ = reading.covering;
+  Fail("covered", reading.covering + " lies over every place " + TargetName() +
+                      " could be brought to");
+}
+
+// The target has left the page.
+void DragSession::FailTargetGone() {
+  Fail("gone", TargetName() + " is no longer on the page");
+}
+
+// What a check found at a place, and the kind of the open layer it named
+// (answered only while hit_ is still that name).
+void DragSession::SetHit(const std::string& name, const std::string& kind) {
+  hit_ = name;
+  hit_kind_ = kind;
+  hit_kind_of_ = name;
+}
+
+// The drag ends with this answer: the plan stops and the leg under way is
+// halted; how the drag itself is ended is the caller's.
+void DragSession::MarkEnding(const std::string& outcome,
+                             const std::string& reason) {
+  ending_ = true;
+  end_outcome_ = outcome;
+  end_reason_ = reason;
+  phase_ = Phase::kEnding;
+  StopPlan();
+  Halt();
+}
+
+void DragSession::BeginEnding(const std::string& outcome,
+                              const std::string& reason) {
+  MarkEnding(outcome, reason);
+  if (kind_ == Kind::kNative) {
+    if (handler_->DragHeld() && HandInBand(Hand())) {
+      end_timer_.Start(FROM_HERE, kEndWait,
+                       base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+      DartOut(base::BindOnce(&DragSession::EndDrag, Weak()));
+      return;
+    }
+    EndNative();
+    return;
+  }
+  PreparePutBack();
+}
+
+void DragSession::EndDrag() {
+  if (answered()) {
+    return;
+  }
+  EndNative();
+}
+
+// A native drag is called off: dragleave, dragend; no mouseup. Where the
+// hand let go is kept now, before any newer drag can change what the handler
+// reports.
+void DragSession::EndNative() {
+  if (answered() || end_native_sent_) {
+    return;
+  }
+  if (!handler_->DragHeld()) {
+    drag_released_ = true;
+    OnEnded("cancelled");
+    return;
+  }
+  end_native_sent_ = true;
+  hand_ = Hand();
+  drag_released_ = true;
+  end_timer_.Start(FROM_HERE, kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  handler_->DragFinish(false, base::TimeDelta(),
+                       base::BindOnce(&DragSession::OnEnded, Weak()));
+}
+
+// A pointer drag ended on a failure: out of any band first (a dart
+// queued behind whatever is queued), and once that and everything before
+// it has gone out, the page waited out (the watch still for 3 frame
+// intervals, at most 800 ms); then the put-back, to the element's own
+// place. The button stays down meanwhile, and interception with it.
+void DragSession::PreparePutBack() {
+  put_back_queued_ = true;
+  put_back_waiting_ = true;
+  put_back_drained_ = false;
+  const PlannerPoint from = MousePlace();
+  std::vector<PlannedPoint> path;
+  if (terrain_ && HandInBand(from)) {
+    if (std::optional<PlannerPoint> calm =
+            terrain_->NearestCalm(from, kCalmSearch, item_offset_)) {
+      path = PlanDart(base::OptionalToPtr(terrain_), from, *calm);
+    }
+  }
+  if (path.empty()) {
+    // Where the pointer is: nothing goes out, but it completes after
+    // everything queued before it.
+    PlannedPoint here;
+    here.p = from;
+    path.push_back(here);
+  }
+  ClampToView(&path);
+  NotePlannedDwell(path, Now());
+  hand_ = path.back().p;
+  end_timer_.Start(FROM_HERE,
+                   base::Milliseconds(path.back().t_ms) + kAfterMax + kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  handler_->QueueMousePath(MouseRequest(PointsOf(path), /*held=*/true),
+                           base::BindOnce(&DragSession::OnDrained, Weak()));
+}
+
+void DragSession::OnDrained(bool ok) {
+  if (answered() || !put_back_waiting_) {
+    return;
+  }
+  if (!ok) {
+    // The view went away: nothing more can go out.
+    put_back_waiting_ = false;
+    put_back_queued_ = false;
+    Answer(end_outcome_, end_reason_);
+    return;
+  }
+  put_back_drained_ = true;
+  put_back_settle_from_ = Now();
+  step_timer_.Start(FROM_HERE, kAfterMax,
+                    base::BindOnce(&DragSession::PutBackAfterSettle, Weak()));
+}
+
+void DragSession::PutBackAfterSettle() {
+  if (answered() || !put_back_waiting_ || put_back_sent_) {
+    return;
+  }
+  put_back_waiting_ = false;
+  step_timer_.Stop();
+  PutBack(/*dart_out=*/true, /*original=*/true);
+}
+
+// The put-back, in one gesture queued at once: out of any band first (a
+// dart), then a leg over the grabbed element's own place (bands budgeted),
+// and the release there -- after a short rest only when that place is not
+// calm. `original`: its slot at the press moved by what has scrolled the
+// boxes that hold it since; else (an interrupt, with no time to wait) its
+// slot as the last frame has it.
+void DragSession::PutBack(bool dart_out, bool original) {
+  put_back_queued_ = true;
+  put_back_sent_ = true;
+  put_back_waiting_ = false;
+  PlannerPoint from = MousePlace();
+  std::vector<PlannedPoint> path;
+  if (dart_out && terrain_ && HandInBand(from)) {
+    if (std::optional<PlannerPoint> calm =
+            terrain_->NearestCalm(from, kCalmSearch, item_offset_)) {
+      path = PlanDart(base::OptionalToPtr(terrain_), from, *calm);
+      from = *calm;
+    }
+  }
+  const PutBackPlace place = PutBackPoint(original);
+  const PlannerPoint to = place.at;
+  if (terrain_ &&
+      !terrain_->viewport().Inset(kViewMargin, kViewMargin).Contains(to)) {
+    // Its place is out of view: no release outside the view, and none
+    // over another element's place -- Escape cancels the drag, then it is
+    // let go where the hand is.
+    if (interrupted_) {
+      // An interrupt cannot wait for a key's answer: the release (after the
+      // dart out of a band, if any) goes out now, ahead of the new input,
+      // where the hand is.
+      std::vector<PlannerPoint> here =
+          path.empty() ? std::vector<PlannerPoint>{MousePlace()}
+                       : PointsOf(path);
+      for (PlannerPoint& point : here) {
+        point = InView(point);
+      }
+      hand_ = here.back();
+      InputHandler::MousePathRequest request =
+          MouseRequest(std::move(here), /*held=*/true);
+      request.end_action = EndAction::kRelease;
+      end_timer_.Start(FROM_HERE, kEndWait,
+                       base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+      handler_->QueueMousePath(std::move(request),
+                               base::BindOnce(&DragSession::OnPutBack, Weak()));
+      return;
+    }
+    EscapeAndRelease();
+    return;
+  }
+  const LegConstraints c =
+      terrain_ ? terrain_->Constraints(from, to, kBandBudgetMs, item_offset_)
+               : LegConstraints();
+  const std::vector<PlannedPoint> back =
+      Plan(from, to, GrabWidth(), PathIntent::kDefault, c);
+  // The way back goes on from the dart's last point, a tick later.
+  const bool after_dart = !path.empty();
+  const double offset = after_dart ? path.back().t_ms : 0;
+  for (size_t i = after_dart ? 1 : 0; i < back.size(); ++i) {
+    PlannedPoint point = back[i];
+    point.t_ms += offset;
+    path.push_back(point);
+  }
+  ClampToView(&path);
+  const base::TimeTicks now = Now();
+  NotePlannedDwell(path, now);
+  InputHandler::MousePathRequest request =
+      MouseRequest(PointsOf(path), /*held=*/true);
+  request.end_action = EndAction::kRelease;
+  const base::TimeDelta rest =
+      place.calm ? RandMs(kPutBackRestMinMs, kPutBackRestMaxMs)
+                 : RandMs(kShortRestMinMs, kShortRestMaxMs);
+  request.end_delay = rest;
+  hand_ = path.back().p;
+  moved_ = true;
+  end_timer_.Start(FROM_HERE,
+                   base::Milliseconds(path.back().t_ms) + rest + kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  handler_->QueueMousePath(std::move(request),
+                           base::BindOnce(&DragSession::OnPutBack, Weak()));
+}
+
+// The grabbed element's place is out of view: a release there is
+// impossible, and one anywhere else would drop it there. Escape -- a real
+// key down and up, as Input.dispatchKeyChord sends one -- cancels a pointer
+// library's drag; then it is let go where the hand is.
+void DragSession::EscapeAndRelease() {
+  escaped_ = true;
+  put_back_queued_ = true;
+  put_back_sent_ = true;
+  put_back_waiting_ = false;
+  end_timer_.Start(FROM_HERE, kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  handler_->PressKey("Escape", base::BindOnce(&DragSession::OnEscaped, Weak()));
+}
+
+void DragSession::OnEscaped(bool ok) {
+  if (answered()) {
+    return;
+  }
+  escape_ok_ = ok;
+  InputHandler::MousePathRequest request =
+      MouseRequest({MousePlace()}, /*held=*/true);
+  request.end_action = EndAction::kRelease;
+  request.end_delay = RandMs(40, 90);
+  handler_->QueueMousePath(std::move(request),
+                           base::BindOnce(&DragSession::OnPutBack, Weak()));
+}
+
+// Where the grabbed element is put back, at the place it was grabbed across
+// it: its slot at the press shifted by the scroll of the boxes that hold it
+// (`original`), else its slot as the last watch frame has it; the grab
+// point when no slot is known. In a band there, the calm point of the slot
+// nearest it; with none, the place itself, not calm (a short rest).
+DragSession::PutBackPlace DragSession::PutBackPoint(bool original) const {
+  DragRect slot;
+  if (original && grab_before_) {
+    slot = RectToRoot(grab_before_->layout_box.get());
+    if (slot.IsEmpty()) {
+      slot = RectToRoot(grab_before_->box.get());
+    }
+    const double scale = CssScale();
+    for (const int box : grab_chain_) {
+      const auto now = latest_offsets_.find(box);
+      const auto then = press_offsets_.find(box);
+      if (now == latest_offsets_.end() || then == press_offsets_.end()) {
+        continue;
+      }
+      slot.x -= (now->second.x - then->second.x) * scale;
+      slot.y -= (now->second.y - then->second.y) * scale;
+    }
+  } else {
+    slot = frame_grab_slot_;
+    if (slot.IsEmpty() && grab_before_) {
+      slot = RectToRoot(grab_before_->layout_box.get());
+    }
+  }
+  if (slot.IsEmpty()) {
+    return PutBackPlace{
+        grab_point_,
+        !terrain_ || terrain_->Calm(grab_point_, kClearance, item_offset_)};
+  }
+  double fx = 0.5;
+  double fy = 0.5;
+  const DragRect was =
+      grab_before_ ? RectToRoot(grab_before_->box.get()) : DragRect();
+  if (!was.IsEmpty()) {
+    fx = std::clamp((grab_point_.x - was.x) / was.w, 0.0, 1.0);
+    fy = std::clamp((grab_point_.y - was.y) / was.h, 0.0, 1.0);
+  }
+  PutBackPlace place{At(slot, fx, fy)};
+  if (terrain_ && !terrain_->Calm(place.at, kClearance, item_offset_)) {
+    if (const std::optional<PlannerPoint> inside =
+            CalmIn(slot, place.at, DragRect())) {
+      place.at = *inside;
+    } else {
+      place.calm = false;
+    }
+  }
+  return place;
+}
+
+// A native drag has ended (called off, lost, or let go of by an end that
+// was not a drop): the page read once it has settled, and a list that
+// was reordered anyway said so.
+void DragSession::OnEnded(const std::string& outcome) {
+  if (answered() || ended_) {
+    return;
+  }
+  ended_ = true;
+  end_timer_.Stop();
+  if (!CanAsk() || grab_id_ == 0) {
+    Answer(end_outcome_, end_reason_);
+    return;
+  }
+  end_timer_.Start(FROM_HERE, kAfterMax + kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  SettleThenRead(SlotUse::kEndAfter);
+}
+
+// The put-back's button is up: interception given back (a hold begun
+// during it called off); then, once the page has settled, where the element
+// is says whether it was truly put back.
+void DragSession::OnPutBack(bool ok) {
+  if (answered()) {
+    return;
+  }
+  put_back_queued_ = false;
+  end_timer_.Stop();
+  Disarm(/*call_off_held=*/true);
+  TrackDwell(0, Now(), /*guard=*/false);
+  put_back_ = ok && !escaped_;
+  if (escaped_) {
+    // Where the drag began, not the target's place, which the reason before
+    // it may name.
+    end_reason_ += escape_ok_
+                       ? "; where the drag began was out of view, so Escape "
+                         "was pressed to cancel the drag, then it was let go "
+                         "where the pointer was"
+                       : "; where the drag began was out of view, and Escape "
+                         "could not be pressed, so it was let go where the "
+                         "pointer was";
+  }
+  if (!ok || !CanAsk() || grab_id_ == 0) {
+    Answer(end_outcome_, end_reason_);
+    return;
+  }
+  end_timer_.Start(FROM_HERE, kAfterMax + kEndWait,
+                   base::BindOnce(&DragSession::OnEndWaitOver, Weak()));
+  SettleThenRead(SlotUse::kPutBack);
+}
+
+// An end (or a let-go) that never reported: answered anyway.
+void DragSession::OnEndWaitOver() {
+  if (answered()) {
+    return;
+  }
+  if (phase_ == Phase::kAfter) {
+    Answer(letgo_outcome_, letgo_reason_);
+    return;
+  }
+  Answer(end_outcome_, end_reason_);
+}
+
+void DragSession::OnDeadline() {
+  if (answered()) {
+    return;
+  }
+  if (phase_ == Phase::kAfter) {
+    Answer(letgo_outcome_, letgo_reason_);
+    return;
+  }
+  if (ending_ || letting_go_) {
+    return;  // ending already, bounded by its own wait
+  }
+  Fail("timeout", base::StringPrintf("the drag did not finish within %.0f ms",
+                                     params_.timeout.InMillisecondsF()));
+}
+
+void DragSession::OnCollectorGone() {
+  if (answered()) {
+    return;
+  }
+  if (phase_ == Phase::kAfter) {
+    Answer(letgo_outcome_, letgo_reason_);
+    return;
+  }
+  if (letting_go_) {
+    return;  // the let-go goes on; nothing is read after it
+  }
+  Fail("gone", "the page's renderer went away");
+}
+
+// The held native drag ended without being let go of: the page or the
+// browser ended it.
+void DragSession::OnDragLost() {
+  if (answered() || kind_ != Kind::kNative) {
+    return;
+  }
+  drag_released_ = true;
+  if (!ending_) {
+    MarkEnding("cancelled",
+               "the drag ended before it was let go: the page or the browser "
+               "ended it");
+  }
+  // As after every native end, the page read once it has settled.
+  OnEnded(end_outcome_);
+}
+
+// The plan in progress stops: reads dropped, timers off, no spin.
+void DragSession::StopPlan() {
+  DropReads();
+  survey_then_.Reset();
+  step_timer_.Stop();
+  notch_timer_.Stop();
+  settle_timer_.Stop();
+  guard_timer_.Stop();
+  final_timer_.Stop();
+  settling_ = false;
+  spinning_ = false;
+  probing_ = false;
+  replanning_ = false;
+  ++spin_token_;
+}
+
+// The handler's hooks given back, once; with `call_off_held`, a hold this
+// call began (one the session had not heard of included) called off. Then
+// interception, unless a put-back still has the button down (OnPutBack
+// gives it back once the button is up).
+void DragSession::ReleaseHooks(bool call_off_held) {
+  if (!armed_) {
+    return;
+  }
+  if (!hooks_cleared_) {
+    hooks_cleared_ = true;
+    InputHandler& handler = *handler_;
+    handler.set_on_dragover_sent(
+        base::RepeatingCallback<void(const PlannerPoint&, base::TimeTicks)>());
+    handler.set_on_drag_lost(base::OnceClosure());
+    handler.set_on_drag_started(base::OnceClosure());
+  }
+  if (call_off_held) {
+    CallOffHeld();
+  }
+  if (put_back_queued_) {
+    return;
+  }
+  Disarm(/*call_off_held=*/false);
+}
+
+// Interception given back (this call's arm only: a newer call's keeps it).
+void DragSession::Disarm(bool call_off_held) {
+  if (!armed_ || disarmed_) {
+    return;
+  }
+  disarmed_ = true;
+  if (call_off_held) {
+    CallOffHeld();
+  }
+  handler_->ArmDragInterceptionForCall(id_, false);
+}
+
+// A drag held while this call has interception armed is this call's: it is
+// called off (dragleave, dragend), never left behind.
+void DragSession::CallOffHeld() {
+  if (!handler_->DragHeld()) {
+    return;
+  }
+  drag_released_ = true;
+  handler_->DragFinish(false, base::TimeDelta(), base::DoNothing());
+}
+
+void DragSession::Answer(const std::string& outcome,
+                         const std::string& reason) {
+  if (answered() || pending_answer_) {
+    return;
+  }
+  hand_ = Hand();
+  put_back_queued_ = false;
+  ReleaseHooks(/*call_off_held=*/!interrupted_);
+  if (ShouldWaitForBinder()) {
+    // The last spin's scroll may still be running: `scrolled` waits, at
+    // most 300 ms, for a frame showing the box it turned still.
+    pending_answer_ = PendingAnswer{outcome, reason};
+    StopPlan();
+    deadline_timer_.Stop();
+    end_timer_.Stop();
+    settle_read_timer_.Stop();
+    answer_timer_.Start(FROM_HERE, kAnswerWait,
+                        base::BindOnce(&DragSession::SendPending, Weak()));
+    return;
+  }
+  Send(outcome, reason);
+}
+
+// The box the wheel turned was moving in the last frame that showed it.
+bool DragSession::ShouldWaitForBinder() const {
+  return pressed_ && !interrupted_ && watching_ && CanAsk() &&
+         binder_id_ != 0 && notches_ > 0 && !last_binder_change_at_.is_null() &&
+         last_binder_change_at_ >= last_binder_still_at_;
+}
+
+void DragSession::SendPending() {
+  if (!pending_answer_) {
+    return;
+  }
+  const PendingAnswer pending = std::move(*pending_answer_);
+  pending_answer_.reset();
+  Send(pending.outcome, pending.reason);
+}
+
+// The one answer: everything stopped, the figures sent, the handler told.
+// No call to the handler from the destructor, which sends through here too
+// (with no action id).
+void DragSession::Send(const std::string& outcome, const std::string& reason) {
+  std::unique_ptr<Callback> callback = std::move(callback_);
+  if (!callback) {
+    return;
+  }
+  phase_ = Phase::kDone;
+  watching_ = false;
+  page_takes_.reset();
+  ++ask_;
+  ++leg_;
+  ++spin_token_;
+  ++first_token_;
+  reissue_.Reset();
+  survey_then_.Reset();
+  after_leg_.Reset();
+  deadline_timer_.Stop();
+  read_timer_.Stop();
+  step_timer_.Stop();
+  notch_timer_.Stop();
+  settle_timer_.Stop();
+  guard_timer_.Stop();
+  end_timer_.Stop();
+  final_timer_.Stop();
+  settle_read_timer_.Stop();
+  answer_timer_.Stop();
+  collector_.reset();
+
+  DragAnswer a;
+  a.outcome = outcome;
+  a.kind = kind_ == Kind::kNative ? "native"
+           : PointerDrag()        ? "pointer"
+                                  : "none";
+  if (!reason.empty()) {
+    a.reason = reason;
+  }
+  a.duration_ms = (Now() - started_).InMillisecondsF();
+  const double scale = CssScale();
+  if (moved_) {
+    a.x = hand_.x / scale;
+    a.y = hand_.y / scale;
+  }
+  if (!hit_.empty()) {
+    a.hit = hit_;
+    if (!hit_kind_.empty() && hit_ == hit_kind_of_) {
+      a.hit_kind = hit_kind_;
+    }
+  }
+  if (pressed_) {
+    a.reached = reached_;
+  }
+  if (grab_before_ && grab_before_->found) {
+    const blink::mojom::AgentSlot& before = *grab_before_;
+    if (before.count >= 2 && before.index >= 0) {
+      a.grab_index_before = before.index + 1;
+      a.sibling_count = before.count;
+      if (!before.list_name.empty()) {
+        a.list = before.list_name;
+      }
+    }
+    if (!before.text.empty()) {
+      a.grab_text = before.text;
+    }
+    if (!before.value.empty()) {
+      a.value_before = before.value;
+    }
+  }
+  const bool after_found = grab_after_ && grab_after_->found;
+  if (after_found) {
+    if (grab_after_->count >= 2 && grab_after_->index >= 0) {
+      a.grab_index_after = grab_after_->index + 1;
+    }
+    if (!grab_after_->value.empty()) {
+      a.value_after = grab_after_->value;
+    }
+  }
+  // How far a pointer drag moved the grabbed element in the page, the press
+  // to after the release: whenever it moved 2 px or more, unless
+  // its place in its list changed (that move is the news then). Not by the
+  // list's identity: a list read off a holder named with its text changes
+  // name when that text does (dnd-kit's live region announcing into body).
+  // Its box's move plus what scrolled the boxes that held it at the press
+  // (the window among them when it scrolls with it); a box never read
+  // counts as unscrolled.
+  if (PointerDrag() && after_found && grab_before_ && grab_before_->found) {
+    const blink::mojom::AgentSlot& before = *grab_before_;
+    const bool list_moved =
+        before.count >= 2 && before.index >= 0 && grab_after_->count >= 2 &&
+        grab_after_->index >= 0 && grab_after_->index != before.index;
+    const DragRect pressed_box = RectToRoot(before.box.get());
+    const DragRect after_box = RectToRoot(grab_after_->box.get());
+    if (!list_moved && !pressed_box.IsEmpty() && !after_box.IsEmpty()) {
+      double moved_x = (after_box.x - pressed_box.x) / scale;
+      double moved_y = (after_box.y - pressed_box.y) / scale;
+      for (const int box_id : grab_chain_) {
+        const auto pressed = press_offsets_.find(box_id);
+        const auto first = first_offsets_.find(box_id);
+        const auto last = latest_offsets_.find(box_id);
+        const Offsets* then = pressed != press_offsets_.end() ? &pressed->second
+                              : first != first_offsets_.end() ? &first->second
+                                                              : nullptr;
+        if (then && last != latest_offsets_.end()) {
+          moved_x += last->second.x - then->x;
+          moved_y += last->second.y - then->y;
+        }
+      }
+      if (std::abs(moved_x) >= 2 || std::abs(moved_y) >= 2) {
+        a.grab_moved_x = moved_x;
+        a.grab_moved_y = moved_y;
+      }
+    }
+  }
+  if (params_.slot_given) {
+    a.slot_reached = slot_reached_;
+  }
+  if (params_.target_kind == TargetKind::kValue) {
+    a.value_reached = value_reached_;
+  }
+  if (!hit_value_before_.empty()) {
+    a.hit_value_before = hit_value_before_;
+  }
+  if (!hit_value_after_.empty()) {
+    a.hit_value_after = hit_value_after_;
+  }
+  // Across the box let go over: the target's; for a fraction, the grabbed
+  // element's -- after the release when it moves with the pointer.
+  DragRect box = letgo_box_;
+  if (params_.target_kind == TargetKind::kFraction && PointerDrag() &&
+      after_found) {
+    const DragRect after = RectToRoot(grab_after_->box.get());
+    if (!after.IsEmpty()) {
+      box = after;
+    }
+  }
+  if (reached_ && !box.IsEmpty()) {
+    a.fraction_x_reached = (hand_.x - box.x) / box.w;
+    a.fraction_y_reached = (hand_.y - box.y) / box.h;
+  }
+  if (pressed_) {
+    auto scrolled = std::make_unique<Array<Input::DragScroll>>();
+    for (const auto& [box_id, first] : first_offsets_) {
+      const auto last = latest_offsets_.find(box_id);
+      if (last == latest_offsets_.end()) {
+        continue;
+      }
+      const double dx = last->second.x - first.x;
+      const double dy = last->second.y - first.y;
+      if (std::abs(dx) >= kNetPx || std::abs(dy) >= kNetPx) {
+        scrolled->push_back(Input::DragScroll::Create()
+                                .SetBox(BoxName(box_id, "a box"))
+                                .SetDx(dx)
+                                .SetDy(dy)
+                                .Build());
+      }
+    }
+    a.scrolled = std::move(scrolled);
+    // What the wheel is credited with for a box -- its scroll less what it
+    // did on its own -- is never more than its notches can scroll: the
+    // rest is the box's own.
+    for (const auto& [box_id, credit] : wheel_credit_) {
+      const auto first = first_offsets_.find(box_id);
+      const auto last = latest_offsets_.find(box_id);
+      if (first == first_offsets_.end() || last == latest_offsets_.end()) {
+        continue;
+      }
+      const double slack = kSpinSlackPx * credit.spins;
+      const auto cap = [slack](double sent, double moved, double& own) {
+        const double share = moved - own;
+        own += share - std::clamp(share, std::min(0.0, sent) - slack,
+                                  std::max(0.0, sent) + slack);
+      };
+      Offsets& stray = unexpected_[box_id];
+      cap(credit.sent.x, last->second.x - first->second.x, stray.x);
+      cap(credit.sent.y, last->second.y - first->second.y, stray.y);
+    }
+    auto unexpected = std::make_unique<Array<Input::DragScroll>>();
+    for (const auto& [box_id, total] : unexpected_) {
+      if (std::abs(total.x) >= kNetPx || std::abs(total.y) >= kNetPx) {
+        unexpected->push_back(Input::DragScroll::Create()
+                                  .SetBox(BoxName(box_id, "a box"))
+                                  .SetDx(total.x)
+                                  .SetDy(total.y)
+                                  .Build());
+      }
+    }
+    a.unexpected = std::move(unexpected);
+    a.notches = notches_;
+    a.replans = replans_;
+    a.corrections = corrections_;
+  }
+  if (PointerDrag()) {
+    a.put_back = put_back_;
+  }
+  // A drop or a release that went out is answered once what it led to is
+  // known (ActionOutcomeWatch::Settle); any other answer after it
+  // went out, at once with what it led to so far; one before it, with none.
+  ActionOutcomeWatch::Reply(
+      action_id_ ? handler_->OutcomeWatch() : nullptr, action_id_,
+      base::BindOnce(
+          [](std::unique_ptr<Callback> pending, DragAnswer answer,
+             std::unique_ptr<Page::ActionOutcome> action_outcome) {
+            SendAnswer(*pending, std::move(answer), std::move(action_outcome));
+          },
+          std::move(callback), std::move(a)),
+      /*wait=*/outcome == "dropped" || outcome == "released");
+  if (on_done_) {
+    Post(base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+// =========================================== the watch, and re-planning
+
+// From the press to the answer, one WatchDrag out at a time: every band box
+// of the last survey (at most 64) and the box the wheel turns, the target
+// and the grabbed element. A survey listing other boxes sends a new set at
+// once.
+void DragSession::StartWatch() {
+  if (watching_) {
+    return;
+  }
+  watching_ = true;
+  IssueWatch();
+}
+
+void DragSession::IssueWatch() {
+  if (!watching_ || !CanAsk()) {
+    return;
+  }
+  auto watch = blink::mojom::AgentDragWatch::New();
+  watch->box_node_ids = watch_ids_;
+  if (binder_id_ != 0 &&
+      !std::ranges::contains(watch->box_node_ids, binder_id_)) {
+    watch->box_node_ids.push_back(binder_id_);
+  }
+  std::vector<int32_t> ids = watch->box_node_ids;
+  watch->target_node_id =
+      params_.target_kind == TargetKind::kElement ? params_.target_node_id : 0;
+  watch->grab_node_id = grab_id_;
+  collector_->WatchDrag(std::move(watch), watch_version_, kWatchTimeoutMs,
+                        base::BindOnce(&DragSession::OnWatchFrame, Weak(),
+                                       ++watch_ask_, std::move(ids)));
+}
+
+// A frame: the offsets frame to frame (the settle, `scrolled`, and scrolls
+// no notch of ours explains), the target's box (a moving target), the
+// grabbed element's slot (the put-back), the layout version (a stale
+// terrain), and, after the let-go, a still page.
+void DragSession::OnWatchFrame(uint64_t ask,
+                               std::vector<int32_t> ids,
+                               blink::mojom::AgentDragFramePtr frame) {
+  if (answered() || !watching_ || ask != watch_ask_) {
+    return;
+  }
+  if (!frame) {
+    IssueWatch();
+    return;
+  }
+  if (!FiniteFrame(*frame)) {
+    BadGeometry();
+    IssueWatch();  // (nothing, once answered)
+    return;
+  }
+  const base::TimeTicks now = Now();
+  const bool changed = frame->version != watch_version_;
+  watch_version_ = frame->version;
+  if (frame->layout_version != layout_version_) {
+    layout_version_ = frame->layout_version;
+    survey_fresh_ = false;
+  }
+  last_frame_ms_ = frame->time_ms;
+  if ((spinning_ || settling_ || easing_) && now >= last_notch_at_ &&
+      !frame_after_notch_) {
+    frame_after_notch_ = true;
+    first_frame_after_notch_ms_ = frame->time_ms;
+  }
+  // Only the box the wheel turns is credited to the wheel, and only from
+  // the spin's first notch until its scroll is in or waited out; any other
+  // watched box moving, from the press to the let-go, is a scroll nobody
+  // asked for.
+  const bool spin_window = !first_notch_at_.is_null() &&
+                           now >= first_notch_at_ &&
+                           (now < notch_window_until_ || settling_);
+  // The notches' own window, without the settle after it.
+  const bool notch_window = !first_notch_at_.is_null() &&
+                            now >= first_notch_at_ && now < notch_window_until_;
+  const bool holding = pressed_ && !ending_ && !pending_answer_ &&
+                       (phase_ == Phase::kActivate || phase_ == Phase::kCarry ||
+                        phase_ == Phase::kApproach ||
+                        phase_ == Phase::kVerify || phase_ == Phase::kLetGo);
+  // The boxes the wheel turns: the binder, and the latch at the station.
+  const auto ours_box = [this](int box) {
+    return box != 0 && (box == binder_id_ || box == notch_latch_id_);
+  };
+  bool binder_seen = false;
+  bool binder_changed = false;
+  int unexpected_box = 0;
+  bool any_scrolled = false;
+  for (size_t i = 0; i < ids.size() && 2 * i + 1 < frame->offsets.size(); ++i) {
+    const int box = ids[i];
+    const Offsets at{frame->offsets[2 * i], frame->offsets[2 * i + 1]};
+    latest_offsets_[box] = at;
+    binder_seen = binder_seen || ours_box(box);
+    const auto previous = frame_offsets_.find(box);
+    if (previous == frame_offsets_.end()) {
+      frame_offsets_[box] = at;
+      continue;
+    }
+    const double dx = at.x - previous->second.x;
+    const double dy = at.y - previous->second.y;
+    previous->second = at;
+    if (std::abs(dx) < kOffsetEpsilon && std::abs(dy) < kOffsetEpsilon) {
+      continue;
+    }
+    survey_fresh_ = false;
+    any_scrolled = true;
+    const bool binder = ours_box(box);
+    binder_changed = binder_changed || binder;
+    // Ours: a box the wheel turned, in the spin's window (either way: a
+    // snap after a notch), and after it while its scroll still eases the
+    // way the notch turned it -- within what its notches can scroll: past
+    // that it is the box's own, and the easing is over.
+    const bool along_notch = (notch_vertical_ ? dy : dx) * notch_way_ > 0;
+    Offsets stray{dx, dy};
+    if (binder && (spin_window || (easing_ && along_notch))) {
+      stray = CreditWheel(box, dx, dy);
+      if (std::abs(stray.x) >= kOffsetEpsilon ||
+          std::abs(stray.y) >= kOffsetEpsilon) {
+        easing_ = false;
+      }
+    }
+    if (holding && (std::abs(stray.x) >= kOffsetEpsilon ||
+                    std::abs(stray.y) >= kOffsetEpsilon)) {
+      Offsets& total = unexpected_[box];
+      total.x += stray.x;
+      total.y += stray.y;
+      // Past the notches' allowance inside their own window (a snap, a
+      // zoom): in the figures, but no re-plan. Past it later in the settle
+      // (a library scrolling on): a re-plan.
+      if (unexpected_box == 0 && !(binder && notch_window)) {
+        unexpected_box = box;
+      }
+    }
+  }
+  if (binder_seen) {
+    if (binder_changed) {
+      binder_still_from_ms_ = frame->time_ms;
+      last_binder_change_at_ = now;
+      if (spin_window) {
+        binder_moved_ = true;
+      }
+    } else {
+      last_binder_still_at_ = now;
+    }
+  }
+  // A notch's scroll eases on, with no time cap, until the boxes it
+  // turned have been still for 3 frames after the last notch (or, unseen,
+  // until the notches' window has passed).
+  if (easing_) {
+    if (binder_seen) {
+      const double still_from =
+          std::max(binder_still_from_ms_, first_frame_after_notch_ms_);
+      if (!binder_changed && !spinning_ && now >= last_notch_at_ &&
+          frame_after_notch_ &&
+          last_frame_ms_ - still_from >= kStillFrames * FrameMs()) {
+        easing_ = false;
+      }
+    } else if (now >= notch_window_until_) {
+      easing_ = false;
+    }
+  }
+  if (pending_answer_) {
+    // Over: the answer waits only for the box the wheel turned to be still.
+    if (binder_seen && !binder_changed) {
+      SendPending();
+      return;
+    }
+    IssueWatch();
+    return;
+  }
+  // The frame's scrollend is one flag for every box: the binder's settle
+  // takes it only from a frame in which the binder did not move.
+  if (settling_ && frame->scroll_ended && frame_after_notch_ &&
+      !binder_changed) {
+    scroll_ended_ = true;
+  }
+  DragRect target_box;
+  DragRect target_slot;
+  if (frame->target && frame->target->found) {
+    target_box = RectToRoot(frame->target->box.get());
+    target_slot = RectToRoot(frame->target->layout_box.get());
+  }
+  // A target moving: a native drag's by its box; a pointer drag's by its
+  // layout box (a library translates the items the dragged one passes,
+  // which moves no layout box), and not in a frame that scrolled.
+  if (PointerDrag()) {
+    if (!target_slot.IsEmpty() && !frame_target_slot_.IsEmpty() &&
+        !any_scrolled && BoxMoved(target_slot, frame_target_slot_)) {
+      target_moved_at_ = now;
+    }
+  } else if (!target_box.IsEmpty() && !frame_target_box_.IsEmpty() &&
+             !any_scrolled && BoxMoved(target_box, frame_target_box_)) {
+    // Not in a frame that scrolled: the target moving with a scroll is not
+    // the target moving.
+    target_moved_at_ = now;
+  }
+  if (!target_box.IsEmpty()) {
+    frame_target_box_ = target_box;
+  }
+  if (!target_slot.IsEmpty()) {
+    frame_target_slot_ = target_slot;
+  }
+  if (frame->grab && frame->grab->found) {
+    const DragRect slot = RectToRoot(frame->grab->layout_box.get());
+    if (!slot.IsEmpty()) {
+      frame_grab_slot_ = slot;
+      // Off its layout box: it follows the pointer.
+      const DragRect grab_box = RectToRoot(frame->grab->box.get());
+      if (!grab_box.IsEmpty() && Distance(Mid(grab_box), Mid(slot)) >= 2) {
+        grab_follows_ = true;
+      }
+    }
+  }
+  const base::TimeDelta still = base::Milliseconds(kStillFrames * FrameMs());
+  if (settle_read_ && !changed && now - settle_read_->from >= still) {
+    // Still for a watch's whole wait, begun after the drag ended.
+    ReadSettled();
+  }
+  if (put_back_waiting_ && put_back_drained_ && !changed &&
+      now - put_back_settle_from_ >= still) {
+    PutBackAfterSettle();
+  }
+  CheckSettle();
+  if (binder_changed && (spinning_ || settling_)) {
+    ParkedHandCheck();
+  }
+  if (!target_box.IsEmpty()) {
+    MaybeRetarget(target_box);
+  }
+  if (unexpected_box != 0) {
+    OnUnexpectedScroll(unexpected_box);
+  }
+  IssueWatch();
+}
+
+// A box the wheel turned moved (dx, dy) as its notches would: credited
+// to the wheel while what it has been credited stays within what the
+// notches sent to it can scroll, 2 px a spin to spare. The rest -- the
+// box's own scroll -- is returned.
+DragSession::Offsets DragSession::CreditWheel(int box, double dx, double dy) {
+  WheelCredit& credit = wheel_credit_[box];
+  const double slack = kSpinSlackPx * credit.spins;
+  const auto take = [slack](double sent, double& credited, double moved) {
+    const double hi = std::max(0.0, sent) + slack;
+    const double lo = std::min(0.0, sent) - slack;
+    const double ours = moved > 0
+                            ? std::min(moved, std::max(0.0, hi - credited))
+                            : std::max(moved, std::min(0.0, lo - credited));
+    credited += ours;
+    return moved - ours;
+  };
+  return Offsets{take(credit.sent.x, credit.credited.x, dx),
+                 take(credit.sent.y, credit.credited.y, dy)};
+}
+
+// A watched box scrolled with no notch of ours explaining it: the band
+// model was wrong (a page script, a library's own autoscroll, a cover).
+// Out of any band, the page read again, the plan made again from the hand
+// -- for a pointer drag in the carry, a station chosen again with the
+// libraries' zones. After three: blocked, naming the box, or moved when the
+// target kept moving. During a let-go it is only noted.
+void DragSession::OnUnexpectedScroll(int box) {
+  if (Stopped() || replanning_ || letting_go_) {
+    return;
+  }
+  if (phase_ == Phase::kActivate && !kind_) {
+    return;  // noted; the kind of drag is not known yet
+  }
+  if (phase_ != Phase::kActivate && phase_ != Phase::kCarry &&
+      phase_ != Phase::kApproach && phase_ != Phase::kVerify &&
+      phase_ != Phase::kLetGo) {
+    return;
+  }
+  if (!CountForcedReplan(BoxName(box, "a box") +
+                         " kept scrolling on its own while the drag was "
+                         "held")) {
+    return;
+  }
+  Replan();
+}
+
+// A plan forced again; after three, the drag ends: moved when the target
+// has been moving, else blocked with `blocked_reason`. False when it ended.
+bool DragSession::CountForcedReplan(const std::string& blocked_reason) {
+  ++replans_;
+  if (++forced_replans_ <= kMaxReplans) {
+    return true;
+  }
+  const bool moving = !target_moved_at_.is_null() &&
+                      Now() - target_moved_at_ < kTargetMovingFor;
+  if (moving) {
+    Fail("moved", TargetName() + " kept moving while it was carried to");
+  } else {
+    Fail("blocked", blocked_reason);
+  }
+  return false;
+}
+
+void DragSession::Replan() {
+  StopPlan();
+  replanning_ = true;
+  Halt();
+  if (HandInBand(Hand())) {
+    DartOut(base::BindOnce(&DragSession::ResumePlan, Weak()));
+    return;
+  }
+  ResumePlan();
+}
+
+// Rule (a) through a re-plan: a notch still in flight is waited out, and a
+// frame showing the box it turned still (at most a second longer), before
+// the page is read again.
+void DragSession::ResumePlan() {
+  if (Stopped()) {
+    return;
+  }
+  const base::TimeTicks now = Now();
+  if (notch_window_until_ > now) {
+    step_timer_.Start(FROM_HERE, notch_window_until_ - now,
+                      base::BindOnce(&DragSession::ResumePlan, Weak()));
+    return;
+  }
+  if (notches_ > 0 && binder_id_ != 0 &&
+      last_binder_still_at_ < notch_window_until_ &&
+      now < notch_window_until_ + kStillWaitMax) {
+    step_timer_.Start(FROM_HERE, kStillPoll,
+                      base::BindOnce(&DragSession::ResumePlan, Weak()));
+    return;
+  }
+  Survey(base::BindOnce(&DragSession::Replanned, Weak()));
+}
+
+// After the inward step at a station that Blink's walk found in a band:
+// the re-plan's wait (the notch's window, the box still) runs with
+// the guard off, so the hand first leaves any band the map has it in, as
+// Replan's does.
+void DragSession::ResumeOutOfBand() {
+  if (Stopped()) {
+    return;
+  }
+  if (HandInBand(Hand())) {
+    DartOut(base::BindOnce(&DragSession::ResumePlan, Weak()));
+    return;
+  }
+  ResumePlan();
+}
+
+// The plan made again from where the hand is: through the carry for an
+// element target (it goes straight on to the approach when nothing needs
+// scrolling), else the approach.
+void DragSession::Replanned() {
+  if (Stopped()) {
+    return;
+  }
+  replanning_ = false;
+  CarryFromSurvey();
+}
+
+// The page as it is before the next step: the last survey when it was just
+// taken and nothing has moved, scrolled or been laid out since, else a new
+// one.
+void DragSession::SurveyFresh(base::OnceClosure then) {
+  if (survey_ && survey_fresh_ && Now() - survey_at_ < kFreshFor &&
+      layout_version_ == terrain_layout_version_) {
+    std::move(then).Run();
+    return;
+  }
+  Survey(std::move(then));
+}
+
+// ========================================= band dwell, and the guard
+
+// Each dragover sent (native): the band it went out in, or within the
+// budget's 1.5 px of (a pixel held just outside a band's edge).
+void DragSession::OnDragOverSent(const PlannerPoint& p, base::TimeTicks at) {
+  if (answered()) {
+    return;
+  }
+  // Counted first: the hold's dragenter is often reported before the
+  // session hears the drag began (its hit test answers at once), and
+  // every dragover the hook reports belongs to a held drag.
+  ++overs_since_start_;
+  if (!terrain_) {
+    return;
+  }
+  last_over_at_ = at;
+  if (!last_over_p_ || Distance(p, *last_over_p_) > 0.01) {
+    moved_at_ = at;
+  }
+  last_over_p_ = p;
+  TrackDwell(terrain_->BudgetBandAt(p), at, /*guard=*/true);
+}
+
+// Runs of one box's band, as Blink times them: from the first point in it
+// to the first point out of it (or in another box's), the exit included.
+void DragSession::TrackDwell(int band, base::TimeTicks at, bool guard) {
+  if (band == run_box_) {
+    return;
+  }
+  run_box_ = band;
+  run_start_ = at;
+  guard_timer_.Stop();
+  if (band != 0 && guard && kind_ == Kind::kNative) {
+    guard_timer_.Start(FROM_HERE,
+                       std::max(at + kBandGuard - Now(), base::TimeDelta()),
+                       base::BindOnce(&DragSession::OnBandGuard, Weak()));
+  }
+}
+
+// A pointer drag's legs are timed by their plan.
+void DragSession::NotePlannedDwell(const std::vector<PlannedPoint>& leg,
+                                   base::TimeTicks start) {
+  for (const PlannedPoint& point : leg) {
+    TrackDwell(point.band, start + base::Milliseconds(point.t_ms),
+               /*guard=*/false);
+  }
+}
+
+// 140 ms in one box's band (a planner bug, or a page that moved under the
+// plan): the leg abandoned, a dart to the nearest calm point, the plan made
+// again.
+void DragSession::OnBandGuard() {
+  if (Stopped() || run_box_ == 0 || kind_ != Kind::kNative || letting_go_ ||
+      replanning_) {
+    return;
+  }
+  if (phase_ != Phase::kActivate && phase_ != Phase::kCarry &&
+      phase_ != Phase::kApproach && phase_ != Phase::kVerify &&
+      phase_ != Phase::kLetGo) {
+    return;
+  }
+  if (!CountForcedReplan("the pointer kept ending up in " +
+                         BoxName(run_box_, "a box") + "'s autoscroll band")) {
+    return;
+  }
+  if (phase_ == Phase::kActivate) {
+    Halt();
+    DartOut(base::BindOnce(&DragSession::OnActivationWalked, Weak()));
+    return;
+  }
+  Replan();
+}
+
+// ================================================================ the hand
+
+// Where the hand is: the held drag's place (native, until it is let go
+// of), else where what has been queued leaves it.
+PlannerPoint DragSession::Hand() const {
+  if (pressed_ && kind_ == Kind::kNative && !drag_released_ &&
+      handler_->DragHeld()) {
+    return handler_->DragPointer();
+  }
+  return hand_;
+}
+
+// A spot the hand should not stay on: in Blink's band (native), or short of
+// calm on a library's terrain (pointer: its zones, and the dragged item's
+// centre with the hand).
+bool DragSession::HandInBand(const PlannerPoint& p) const {
+  if (!terrain_) {
+    return false;
+  }
+  if (PointerDrag()) {
+    return !terrain_->Calm(p, kClearance, item_offset_);
+  }
+  return terrain_->BandAt(p) != 0;
+}
+
+// A leg from the planner, never empty.
+std::vector<PlannedPoint> DragSession::Plan(const PlannerPoint& from,
+                                            const PlannerPoint& to,
+                                            double width,
+                                            PathIntent intent,
+                                            const LegConstraints& given) {
+  // From the press on the hand holds the button: the drag tempo, and no leg
+  // passes its end unless it ends over its drop zone (a hold region).
+  LegConstraints c = given;
+  c.button_held = pressed_;
+  if (pressed_ && !c.hold.has_value()) {
+    c.overshoot = false;
+  }
+  // No bow leaves the view, nor what runs past the end: a cursor stops at
+  // the screen's edge.
+  BoundToView(from, to, &c);
+  std::vector<PlannedPoint> leg =
+      planner_.PlanLeg(from, to, width, intent, params_.speed_multiplier, c);
+  if (leg.empty()) {
+    PlannedPoint only;
+    only.p = std::isfinite(to.x) && std::isfinite(to.y) ? to : from;
+    leg.push_back(only);
+  }
+  return leg;
+}
+
+// A leg to a calm end -- a landing, the calm point beside one, the first
+// waypoint, a wheel station -- planned, measured, and planned again when
+// it does not fit: when a run skims a band (OverBudgetBand: 2.9 px wide,
+// wider than the planner budgets), or when, coming from outside the box
+// that holds the target, it goes inside that box off the lane's strips
+// (LaneStray). Tried in turn: for a leg that only skims a
+// band, the band's side entry first; two more draws of the same leg
+// -- the hand's own shapes, those that stray left out; the lane's ways in
+// (a door just outside the box on a strip, round the box by its corners
+// when need be; the two cheapest), each one stroke (RouteStroke),
+// two draws each;
+// the band's other entries. Stray is a length (LaneStray). The first
+// that fits; else the one whose band runs fit (where any do) and that
+// strays least, the first plan on a tie. Each try counts in `replans`.
+std::vector<PlannedPoint> DragSession::PlanToCalm(
+    const PlannerPoint& from,
+    const PlannerPoint& to,
+    double width,
+    const PlannerPoint& entry_velocity,
+    std::optional<PlannerRect> hold) {
+  const std::optional<Lane> lane = LaneFor(from, to);
+  const Lane* on_lane = lane ? &*lane : nullptr;
+  // A drop zone stays within the lane's strip that holds the landing.
+  if (hold && lane) {
+    for (const LaneStrip& strip : lane->strips) {
+      if (!strip.rect.Contains(to)) {
+        continue;
+      }
+      const DragRect held =
+          DragRect{hold->x, hold->y, hold->w, hold->h}.Intersect(strip.rect);
+      hold = !held.IsEmpty() && held.Contains(to)
+                 ? std::optional<PlannerRect>(
+                       PlannerRect{held.x, held.y, held.w, held.h})
+                 : std::nullopt;
+      break;
+    }
+  }
+  std::vector<PlannedPoint> best =
+      PlanEnd(from, to, width, entry_velocity, /*lane=*/nullptr, hold);
+  int best_band = OverBudgetBand(best);
+  double best_stray = lane ? LaneStray(best, *lane) : 0;
+  const auto fits = [](int band, double stray) {
+    return band == 0 && stray <= kLaneStrayPx;
+  };
+  if (fits(best_band, best_stray) || !terrain_ ||
+      !terrain_->Calm(to, kClearance, item_offset_)) {
+    return best;
+  }
+  // The tries: another draw (none), or a way through waypoints.
+  std::vector<std::vector<PlannerPoint>> band_entries;
+  if (best_band != 0) {
+    for (const bool steep : {false, true}) {
+      if (const std::optional<PlannerPoint> via =
+              BandWaypoint(best_band, from, to, steep)) {
+        band_entries.push_back({*via});
+      }
+    }
+  }
+  // Each way's arcs are held off a box: the skimmed band's for its
+  // entries, the lane's for its ways in.
+  const DragBand* skimmed =
+      best_band != 0 ? terrain_->Find(best_band) : nullptr;
+  const DragRect band_box = skimmed ? skimmed->visible : DragRect();
+  const bool strays = best_stray > kLaneStrayPx;
+  std::vector<std::optional<std::vector<PlannerPoint>>> tries;
+  std::vector<DragRect> holds;
+  const auto add_try = [&tries, &holds](
+                           std::optional<std::vector<PlannerPoint>> route,
+                           const DragRect& hold) {
+    tries.push_back(std::move(route));
+    holds.push_back(hold);
+  };
+  if (!strays && !band_entries.empty()) {
+    add_try(band_entries.front(), band_box);
+  }
+  for (size_t i = 0; i < kRedraws; ++i) {
+    add_try(std::nullopt, DragRect());
+  }
+  if (lane) {
+    // Two draws of each: a route's timing is the hand's own, and where it
+    // slows can skim a band one time and not the next.
+    for (std::vector<PlannerPoint>& route : LaneEntries(from, to, *lane)) {
+      add_try(route, lane->region);
+      add_try(std::move(route), lane->region);
+    }
+  }
+  for (size_t i = strays ? 0 : 1; i < band_entries.size(); ++i) {
+    add_try(band_entries[i], band_box);
+  }
+  for (size_t n = 0; n < tries.size(); ++n) {
+    const std::optional<std::vector<PlannerPoint>>& route = tries[n];
+    std::vector<PlannedPoint> tried =
+        route
+            ? RouteStroke(from, *route, to, width, entry_velocity, holds[n],
+                          on_lane)
+            : PlanEnd(from, to, width, entry_velocity, /*lane=*/nullptr, hold);
+    ++replans_;
+    const int band = OverBudgetBand(tried);
+    const double stray = lane ? LaneStray(tried, *lane) : 0;
+    const bool better =
+        (band == 0) != (best_band == 0) ? band == 0 : stray < best_stray;
+    if (better) {
+      best = std::move(tried);
+      best_band = band;
+      best_stray = stray;
+    }
+    if (fits(best_band, best_stray)) {
+      break;
+    }
+  }
+  return best;
+}
+
+// A leg ending at `to` on the terrain's constraints, entered at
+// `entry_speed`, its far side held off what lies past the target when `to`
+// is near a band, and -- on a lane -- its bow held to the lane
+// where its chord runs inside the box.
+std::vector<PlannedPoint> DragSession::PlanEnd(
+    const PlannerPoint& from,
+    const PlannerPoint& to,
+    double width,
+    const PlannerPoint& entry_velocity,
+    const Lane* lane,
+    std::optional<PlannerRect> hold) {
+  LegConstraints c =
+      terrain_->Constraints(from, to, kBandBudgetMs, item_offset_);
+  c.entry_velocity = entry_velocity;
+  c.hold = hold;
+  BoundAwayFromBand(from, to, &c);
+  if (lane) {
+    BoundToLane(from, to, *lane, &c);
+  }
+  return Plan(from, to, width, PathIntent::kDefault, c);
+}
+
+// A route's stroke: the polyline from, vias..., to, its inner
+// corners rounded and held off `hold_off` (the lane's box for its ways in,
+// the skimmed band's box for a band's entries) -- the last waypoint (a
+// door) by 0.9 of its distance off that box, so its arc stays outside it;
+// a corner by up to 1.7 times its distance off it; with no box, 40 px;
+// each 0.75-1 of that, stroke to stroke -- and
+// travelled as one movement: the hand's own timing (a leg planned along a
+// straight chord as long as the route, the way the hand goes, no bow) laid
+// along it, its small sideways wander kept, slowed where the route curves
+// by the two-thirds power law (pace ~ curvature^-1/3, held to 0.55-1,
+// smoothed over 20 px of route either side), then laid back on the polling
+// grid. One slow-in, at `to`; its end exact.
+std::vector<PlannedPoint> DragSession::RouteStroke(
+    const PlannerPoint& from,
+    const std::vector<PlannerPoint>& vias,
+    const PlannerPoint& to,
+    double width,
+    const PlannerPoint& entry_velocity,
+    const DragRect& hold_off,
+    const Lane* lane) {
+  std::vector<PlannerPoint> points{from};
+  points.insert(points.end(), vias.begin(), vias.end());
+  points.push_back(to);
+  std::vector<double> radii(points.size(), 0);
+  for (size_t i = 1; i + 1 < points.size(); ++i) {
+    double radius = kRouteBandRadiusPx;
+    if (!hold_off.IsEmpty()) {
+      const double off = DistanceTo(hold_off, points[i]);
+      radius =
+          (i + 2 == points.size() ? kDoorRadiusShare : kCornerRadiusShare) *
+          off;
+    }
+    radii[i] = radius * RandBetween(0.75, 1.0);
+  }
+  const std::vector<RouteSample> route = RoundedRoute(points, radii);
+  const double length = route.empty() ? 0 : route.back().s;
+  const double chord = Distance(from, to);
+  if (route.size() < 2 || length < 1 || chord < 1) {
+    return PlanEnd(from, to, width, entry_velocity, lane, std::nullopt);
+  }
+  // The hand's timing over the route's length, the way it goes, no bow.
+  const PlannerPoint dir{(to.x - from.x) / chord, (to.y - from.y) / chord};
+  LegConstraints c;
+  c.free_plus = 0;
+  c.free_minus = 0;
+  // The hand's speed along the route's first heading.
+  const double head_x = points[1].x - from.x;
+  const double head_y = points[1].y - from.y;
+  const double head = std::hypot(head_x, head_y);
+  c.entry_speed = head > 0 ? std::max(0.0, (entry_velocity.x * head_x +
+                                            entry_velocity.y * head_y) /
+                                               head)
+                           : 0;
+  // From an origin far down and right (the planner holds coordinates to 0
+  // or more), read relative to it.
+  const PlannerPoint origin{from.x + kVirtualOffsetPx,
+                            from.y + kVirtualOffsetPx};
+  const std::vector<PlannedPoint> plain =
+      Plan(origin,
+           PlannerPoint{origin.x + dir.x * length, origin.y + dir.y * length},
+           width, PathIntent::kDefault, c);
+  // Laid along the route, paced by where it curves, back on the polling
+  // grid (LayAlongRoute); each point's band read here.
+  std::vector<PlannedPoint> stroke =
+      LayAlongRoute(route, plain, origin, dir, to, interval_ms_, kRouteSmoothPx,
+                    kRouteMinPace);
+  for (PlannedPoint& q : stroke) {
+    q.band = PlannedBandAt(q.p, DragTerrain::kBudgetMargin);
+  }
+  return stroke;
+}
+
+// A leg from inside a band box's band to a point that box owns, in its calm
+// part, whose straight way runs along the band (more than twice as far as
+// across it, and 8 px more): the place 1-3 px past the calm part's
+// clearance to leave the band by first -- with `lean`, toward `to` along the
+// edge crossed by up to twice the way across -- from which the way on to
+// `to` crosses no band. None otherwise, or when that place is not
+// calm.
+std::optional<PlannerPoint> DragSession::BandExit(const PlannerPoint& from,
+                                                  const PlannerPoint& to,
+                                                  bool lean) const {
+  const DragBand* box =
+      terrain_ ? terrain_->Find(terrain_->BandAt(from)) : nullptr;
+  if (!box) {
+    return std::nullopt;
+  }
+  const DragRect inner = BandInner(*box);
+  const double depth = kClearance + RandBetween(1, 3);
+  if (inner.w <= 2 * depth || inner.h <= 2 * depth || !inner.Contains(to) ||
+      terrain_->OwnerAt(to) != box->id) {
+    return std::nullopt;
+  }
+  PlannerPoint exit{
+      std::clamp(from.x, inner.x + depth, inner.right() - depth),
+      std::clamp(from.y, inner.y + depth, inner.bottom() - depth)};
+  const double across = Distance(from, exit);
+  const double d = Distance(from, to);
+  if (across < 0.5 || d < 1) {
+    return std::nullopt;
+  }
+  // How far the straight way goes before it is past the band.
+  double along = d;
+  for (double s = 0; s <= d; s += 1) {
+    const PlannerPoint q{from.x + (to.x - from.x) * s / d,
+                         from.y + (to.y - from.y) * s / d};
+    if (inner.Contains(q)) {
+      along = s;
+      break;
+    }
+  }
+  if (along <= 2 * across + 8) {
+    return std::nullopt;
+  }
+  if (lean && exit.x == from.x) {
+    exit.x =
+        std::clamp(from.x + std::clamp(to.x - from.x, -2 * across, 2 * across),
+                   inner.x + depth, inner.right() - depth);
+  } else if (lean && exit.y == from.y) {
+    exit.y =
+        std::clamp(from.y + std::clamp(to.y - from.y, -2 * across, 2 * across),
+                   inner.y + depth, inner.bottom() - depth);
+  }
+  const double on = Distance(exit, to);
+  if (on < 8 || !terrain_->Calm(exit, kClearance, item_offset_)) {
+    return std::nullopt;
+  }
+  // The way on crosses no band (a box inside this one has its own).
+  for (double s = 0; s <= on; s += 2) {
+    const PlannerPoint q{exit.x + (to.x - exit.x) * s / on,
+                         exit.y + (to.y - exit.y) * s / on};
+    if (terrain_->BandAt(q) != 0) {
+      return std::nullopt;
+    }
+  }
+  return exit;
+}
+
+// The leg from `from` across its band first (BandExit), one stroke: leaning
+// toward `to`, else straight across -- with `checked`, the first whose band
+// runs fit the budget. None when neither is to be had.
+std::vector<PlannedPoint> DragSession::ExitStroke(
+    const PlannerPoint& from,
+    const PlannerPoint& to,
+    double width,
+    const PlannerPoint& entry_velocity,
+    bool checked) {
+  for (const bool lean : {true, false}) {
+    const std::optional<PlannerPoint> exit = BandExit(from, to, lean);
+    if (!exit) {
+      continue;
+    }
+    std::vector<PlannedPoint> stroke =
+        RouteStroke(from, {*exit}, to, width, entry_velocity, DragRect(),
+                    /*lane=*/nullptr);
+    if (!checked || OverBudgetBand(stroke) == 0) {
+      return stroke;
+    }
+  }
+  return {};
+}
+
+// A waypoint for a leg that skims `band` on its way to `to`. The side
+// of the band's box nearest `to` is the one skimmed. A side entry waits
+// level with `to`, 2-4 px deeper into calm, 8-14 px outside the box on the
+// side the hand comes from, so the next leg crosses the box's side band
+// straight; a steep one waits over `to`, 8-14 px beyond the skimmed side,
+// so the band is crossed straight. None when `to` is not in the box's calm
+// part, or the place is not calm (or out of view).
+std::optional<PlannerPoint> DragSession::BandWaypoint(int band,
+                                                      const PlannerPoint& from,
+                                                      const PlannerPoint& to,
+                                                      bool steep) const {
+  const DragBand* box = terrain_ ? terrain_->Find(band) : nullptr;
+  if (!box) {
+    return std::nullopt;
+  }
+  const DragRect inner = BandInner(*box);
+  if (!inner.Contains(to)) {
+    return std::nullopt;
+  }
+  const double top = to.y - inner.y;
+  const double bottom = inner.bottom() - to.y;
+  const double left = to.x - inner.x;
+  const double right = inner.right() - to.x;
+  const double out = RandBetween(kWaypointOutMinPx, kWaypointOutMaxPx);
+  const double deeper = RandBetween(2, 4);
+  PlannerPoint at = to;
+  if (std::min(top, bottom) <= std::min(left, right)) {
+    // The top or bottom band.
+    const bool near_top = top <= bottom;
+    if (steep) {
+      at.y = near_top ? box->border.y - out : box->border.bottom() + out;
+    } else {
+      at.y = to.y + (near_top ? deeper : -deeper);
+      at.x = from.x <= to.x ? box->border.x - out : box->border.right() + out;
+    }
+  } else {
+    // The left or right band.
+    const bool near_left = left <= right;
+    if (steep) {
+      at.x = near_left ? box->border.x - out : box->border.right() + out;
+    } else {
+      at.x = to.x + (near_left ? deeper : -deeper);
+      at.y = from.y <= to.y ? box->border.y - out : box->border.bottom() + out;
+    }
+  }
+  if (!terrain_->Calm(at, kClearance, item_offset_)) {
+    return std::nullopt;
+  }
+  return at;
+}
+
+// The band of the first run in `leg` that skims a band, its exit
+// included: one whose points lie in a band or within 2.9 px of one -- wider
+// than the 1.5 px the planner budgets, whose own runs always fit, and short
+// of the calm clearance, so a calm end is never in one -- for longer than
+// the budget. A run that reaches the leg's end is a genuinely in-band end's
+// own approach (a dart into an in-band landing), which no other plan
+// changes: not counted. 0: none.
+int DragSession::OverBudgetBand(const std::vector<PlannedPoint>& leg) const {
+  const size_t n = leg.size();
+  if (n < 2 || !terrain_) {
+    return 0;
+  }
+  std::vector<int> wide(n);
+  for (size_t i = 0; i < n; ++i) {
+    wide[i] = PlannedBandAt(leg[i].p, kMeasureMarginPx);
+  }
+  return FirstRunThat(wide, [&leg](size_t first, size_t exit) {
+    return leg[exit].t_ms - leg[first].t_ms > kBandBudgetMs + 1e-6;
+  });
+}
+
+// The band p is in or within `margin` of, as the planner's band_of reads
+// it with that margin: for a pointer drag clear of every band, the dragged
+// item's centre's.
+int DragSession::PlannedBandAt(const PlannerPoint& p, double margin) const {
+  if (!terrain_) {
+    return 0;
+  }
+  const int band = terrain_->BandWithin(p, margin);
+  if (band != 0 || terrain_->mode() != DragMode::kPointer ||
+      (item_offset_.x == 0 && item_offset_.y == 0)) {
+    return band;
+  }
+  return terrain_->BandWithin(
+      PlannerPoint{p.x + item_offset_.x, p.y + item_offset_.y}, margin);
+}
+
+// A leg ending on the target within 12 px of a band, the band on one side of
+// it: the corridor on the other side ends 6 px past the target's own box,
+// so the leg's bow does not dip past it into what lies there (the
+// body rows under a sticky header). Only when both ends of the chord lie
+// short of that line, and the side's normal is not near the chord's.
+void DragSession::BoundAwayFromBand(const PlannerPoint& from,
+                                    const PlannerPoint& to,
+                                    LegConstraints* c) const {
+  const DragRect target = TargetBoxNow();
+  if (!terrain_ || target.IsEmpty() || !target.Contains(to)) {
+    return;
+  }
+  // The nearest band edge of the boxes whose calm part holds `to`, as the
+  // way away from it into calm.
+  double nearest = kNearBandPx;
+  PlannerPoint away;
+  for (const DragBand& band : terrain_->bands()) {
+    const DragRect inner = BandInner(band);
+    if (!band.visible.Contains(to) || !inner.Contains(to)) {
+      continue;
+    }
+    if (to.y - inner.y <= nearest) {
+      nearest = to.y - inner.y;
+      away = PlannerPoint{0, 1};
+    }
+    if (inner.bottom() - to.y <= nearest) {
+      nearest = inner.bottom() - to.y;
+      away = PlannerPoint{0, -1};
+    }
+    if (to.x - inner.x <= nearest) {
+      nearest = to.x - inner.x;
+      away = PlannerPoint{1, 0};
+    }
+    if (inner.right() - to.x <= nearest) {
+      nearest = inner.right() - to.x;
+      away = PlannerPoint{-1, 0};
+    }
+  }
+  if (away.x == 0 && away.y == 0) {
+    return;
+  }
+  // The line 6 px past the target's far edge that way, as a distance along
+  // `away`; the corridor side that faces it.
+  const double far_edge = away.y > 0   ? target.bottom()
+                          : away.y < 0 ? -target.y
+                          : away.x > 0 ? target.right()
+                                       : -target.x;
+  const double line = far_edge + kPastTargetPx;
+  const double dx = to.x - from.x;
+  const double dy = to.y - from.y;
+  const double length = std::hypot(dx, dy);
+  if (length < 1) {
+    return;
+  }
+  const double facing = (dy * away.x - dx * away.y) / length;
+  if (std::abs(facing) < 0.2) {
+    return;
+  }
+  const double from_room = line - (from.x * away.x + from.y * away.y);
+  const double to_room = line - (to.x * away.x + to.y * away.y);
+  if (from_room <= 0 || to_room <= 0) {
+    return;
+  }
+  const double room = std::min(from_room, to_room) / std::abs(facing);
+  double& side_room = facing > 0 ? c->free_plus : c->free_minus;
+  side_room = side_room < 0 ? room : std::min(side_room, room);
+}
+
+// The lane into the box that holds the target, for a leg
+// from outside that box: the box's visible part, the target's box inset 1
+// px (a target that nearly fills the box across, a list's full-width item,
+// has the box's whole width -- its padding and scrollbar are no one
+// else's -- and likewise down), and the strips the leg keeps to inside the
+// box. A leg to the target: its list's track whole -- its row for a list
+// across, its column for a list down, where its siblings lie -- and the
+// other way only from the target to the box's nearer edge, so a header's
+// cell is not reached up its column through the body rows under it;
+// a target in no list, its whole row and column. A leg to a wheel station
+// in the box: the target's row, or its column, where the station
+// lies on it. None for any other target, a leg that starts in the box, or
+// a box that is the page.
+std::optional<DragSession::Lane> DragSession::LaneFor(
+    const PlannerPoint& from,
+    const PlannerPoint& to) const {
+  if (!terrain_) {
+    return std::nullopt;
+  }
+  const DragRect target = TargetBoxNow();
+  if (target.IsEmpty()) {
+    return std::nullopt;
+  }
+  const DragBand* box = terrain_->Find(terrain_->OwnerAt(to));
+  if (!box || box->is_document || box->visible.IsEmpty() ||
+      box->visible.Contains(from)) {
+    return std::nullopt;
+  }
+  const DragRect& region = box->visible;
+  DragRect t = target.Inset(kLaneInsetPx, kLaneInsetPx);
+  if (t.IsEmpty()) {
+    return std::nullopt;
+  }
+  if (target.w >= kLaneFullShare * region.w) {
+    t.x = region.x;
+    t.w = region.w;
+  }
+  if (target.h >= kLaneFullShare * region.h) {
+    t.y = region.y;
+    t.h = region.h;
+  }
+  const LaneStrip row{DragRect{region.x, t.y, region.w, t.h}, true};
+  const LaneStrip column{DragRect{t.x, region.y, t.w, region.h}, false};
+  Lane lane{region, t, {}};
+  if (!target.Contains(to)) {
+    if (row.rect.Contains(to)) {
+      lane.strips.push_back(row);
+    } else if (column.rect.Contains(to)) {
+      lane.strips.push_back(column);
+    } else {
+      return std::nullopt;
+    }
+    return lane;
+  }
+  const blink::mojom::AgentSlot* slot =
+      survey_ && survey_->target ? survey_->target.get() : nullptr;
+  if (!slot || !slot->found || slot->count < 2) {
+    lane.strips = {row, column};
+    return lane;
+  }
+  if (!slot->list_vertical) {
+    // A list across: its row whole; up or down only to the nearer edge.
+    const bool upper = t.y - region.y <= region.bottom() - t.bottom();
+    const DragRect nearer =
+        upper ? DragRect{t.x, region.y, t.w, t.bottom() - region.y}
+              : DragRect{t.x, t.y, t.w, region.bottom() - t.y};
+    lane.strips = {row, LaneStrip{nearer, false}};
+  } else {
+    // A list down: its column whole; left or right only to the nearer edge.
+    const bool leftward = t.x - region.x <= region.right() - t.right();
+    const DragRect nearer =
+        leftward ? DragRect{region.x, t.y, t.right() - region.x, t.h}
+                 : DragRect{t.x, t.y, region.right() - t.x, t.h};
+    lane.strips = {column, LaneStrip{nearer, true}};
+  }
+  return lane;
+}
+
+// A leg held to the view (BoundLegToView): its bow either side of the chord
+// and what runs past its end; a cursor stops at the screen's edge.
+void DragSession::BoundToView(const PlannerPoint& from,
+                              const PlannerPoint& to,
+                              LegConstraints* c) const {
+  if (terrain_) {
+    BoundLegToView(from, to, terrain_->viewport(), c);
+  }
+}
+
+// The ways into the lane, cheapest first, at most two,
+// none longer than kLaneDetourFactor times the straight way and
+// kLaneDetourPx more: through a door just outside the box where a strip
+// meets its edge -- level with the end across a row (left, right), over it
+// along a column (top, bottom) -- in view, calm and outside the box,
+// reached round the box by its corners when the straight way there would
+// cross it. A way's last waypoint is its door.
+std::vector<std::vector<PlannerPoint>> DragSession::LaneEntries(
+    const PlannerPoint& from,
+    const PlannerPoint& to,
+    const Lane& lane) const {
+  std::vector<std::vector<PlannerPoint>> ways;
+  if (!terrain_) {
+    return ways;
+  }
+  const DragRect& box = lane.region;
+  const double out = RandBetween(kLaneOutMinPx, kLaneOutMaxPx);
+  const DragRect view = terrain_->viewport().Inset(kViewMargin, kViewMargin);
+  const double straight = Distance(from, to);
+  std::vector<std::pair<double, std::vector<PlannerPoint>>> found;
+  for (const LaneStrip& strip : lane.strips) {
+    const DragRect& s = strip.rect;
+    std::vector<PlannerPoint> doors;
+    if (strip.row) {
+      const double y =
+          std::clamp(to.y, s.y + kLaneSlackPx,
+                     std::max(s.y + kLaneSlackPx, s.bottom() - kLaneSlackPx));
+      if (s.x <= box.x + 0.5) {
+        doors.push_back(PlannerPoint{box.x - out, y});
+      }
+      if (s.right() >= box.right() - 0.5) {
+        doors.push_back(PlannerPoint{box.right() + out, y});
+      }
+    } else {
+      const double x =
+          std::clamp(to.x, s.x + kLaneSlackPx,
+                     std::max(s.x + kLaneSlackPx, s.right() - kLaneSlackPx));
+      if (s.y <= box.y + 0.5) {
+        doors.push_back(PlannerPoint{x, box.y - out});
+      }
+      if (s.bottom() >= box.bottom() - 0.5) {
+        doors.push_back(PlannerPoint{x, box.bottom() + out});
+      }
+    }
+    for (const PlannerPoint& door : doors) {
+      if (!view.Contains(door) || box.Contains(door) ||
+          !terrain_->Calm(door, kClearance, item_offset_)) {
+        continue;
+      }
+      std::vector<PlannerPoint> way = AroundBox(box, out, from, door);
+      bool shown = true;
+      double length = 0;
+      PlannerPoint at = from;
+      for (const PlannerPoint& corner : way) {
+        shown = shown && view.Contains(corner);
+        length += Distance(at, corner);
+        at = corner;
+      }
+      length += Distance(at, door) + Distance(door, to);
+      if (!shown || length > kLaneDetourFactor * straight + kLaneDetourPx) {
+        continue;
+      }
+      way.push_back(door);
+      found.emplace_back(length, std::move(way));
+    }
+  }
+  std::sort(found.begin(), found.end(),
+            [](const std::pair<double, std::vector<PlannerPoint>>& a,
+               const std::pair<double, std::vector<PlannerPoint>>& b) {
+              return a.first < b.first;
+            });
+  for (std::pair<double, std::vector<PlannerPoint>>& entry : found) {
+    if (ways.size() >= kLaneEntriesTried) {
+      break;
+    }
+    ways.push_back(std::move(entry.second));
+  }
+  return ways;
+}
+
+// The carry's last reading, or (before the carry has read anything, on the
+// first leg) the survey's; null with neither.
+const blink::mojom::AgentCarryReading* DragSession::CurrentReading() const {
+  return reading_ ? reading_.get()
+                  : (survey_ ? survey_->target_reading.get() : nullptr);
+}
+
+// The target element's box as last read (CurrentReading); empty for any
+// other kind of target.
+DragRect DragSession::TargetBoxNow() const {
+  if (params_.target_kind != TargetKind::kElement) {
+    return DragRect();
+  }
+  const blink::mojom::AgentCarryReading* r = CurrentReading();
+  return r ? RectToRoot(r->box.get()) : DragRect();
+}
+
+// What of a band box lies out of its band, by the drag's kind: inside
+// Blink's belt (native), or a library's zone (pointer).
+DragRect DragSession::BandInner(const DragBand& band) const {
+  return terrain_ && terrain_->mode() == DragMode::kPointer ? band.lib_inner
+                                                            : band.inner;
+}
+
+// A landing or first waypoint moved out of a band to a calm point,
+// taken on along each axis it left the band by: to 6 px past the band's
+// inner edge, or to the middle of what of `within` lies past that edge when
+// that is shorter, so the leg's slow tail does not end a few px under the
+// band's edge. Unchanged when that place is not calm, is off `within`, or
+// lies under a fixed cover `target` is not inside.
+PlannerPoint DragSession::DeeperOutOfBand(const PlannerPoint& in_band,
+                                          const PlannerPoint& calm,
+                                          const DragRect& within,
+                                          const DragRect& target) const {
+  const DragBand* band =
+      terrain_ ? terrain_->Find(terrain_->BandAt(in_band)) : nullptr;
+  if (!band || within.IsEmpty()) {
+    return calm;
+  }
+  return DeeperInside(BandInner(*band), in_band, calm, within, target);
+}
+
+// A calm landing within 6 px of the inner edge of a band it lies inside --
+// native, of the box that owns the point (Blink's walk tests only
+// that one); pointer, of any box that shows it -- taken on, away from the
+// nearest such edge, as DeeperOutOfBand takes a point out of a band.
+// Unchanged otherwise, or when that place fails its guards.
+PlannerPoint DragSession::OffBandEdge(const PlannerPoint& p,
+                                      const DragRect& within,
+                                      const DragRect& target) const {
+  if (!terrain_ || within.IsEmpty()) {
+    return p;
+  }
+  const bool native = terrain_->mode() == DragMode::kNative;
+  const int owner = native ? terrain_->OwnerAt(p) : 0;
+  double nearest = kLandingDepthPx;
+  DragRect edge_of;
+  PlannerPoint beyond = p;
+  for (const DragBand& band : terrain_->bands()) {
+    if (native ? band.id != owner : !band.visible.Contains(p)) {
+      continue;
+    }
+    const DragRect inner = BandInner(band);
+    if (!inner.Contains(p)) {
+      continue;
+    }
+    // A point just past the nearest edge, in the band, stands for where
+    // the landing would have come from.
+    if (p.y - inner.y < nearest) {
+      nearest = p.y - inner.y;
+      edge_of = inner;
+      beyond = PlannerPoint{p.x, inner.y - 1};
+    }
+    if (inner.bottom() - p.y < nearest) {
+      nearest = inner.bottom() - p.y;
+      edge_of = inner;
+      beyond = PlannerPoint{p.x, inner.bottom() + 1};
+    }
+    if (p.x - inner.x < nearest) {
+      nearest = p.x - inner.x;
+      edge_of = inner;
+      beyond = PlannerPoint{inner.x - 1, p.y};
+    }
+    if (inner.right() - p.x < nearest) {
+      nearest = inner.right() - p.x;
+      edge_of = inner;
+      beyond = PlannerPoint{inner.right() + 1, p.y};
+    }
+  }
+  if (edge_of.IsEmpty()) {
+    return p;
+  }
+  return DeeperInside(edge_of, beyond, p, within, target);
+}
+
+// `calm` taken on along each axis on which `outside` lies past an edge of
+// `inner` and `calm` inside it: to 6 px past that edge, or to the middle of
+// what of `within` lies past it when that is shorter. Unchanged when that
+// place is not calm, is off `within`, or lies under a fixed cover `target`
+// is not inside.
+PlannerPoint DragSession::DeeperInside(const DragRect& inner,
+                                       const PlannerPoint& outside,
+                                       const PlannerPoint& calm,
+                                       const DragRect& within,
+                                       const DragRect& target) const {
+  if (!terrain_ || within.IsEmpty()) {
+    return calm;
+  }
+  const PlannerPoint in_band = outside;
+  // Along one axis: `from` in the band, `at` calm, [lo, hi) out of the
+  // band, [room_lo, room_hi) where the point may go.
+  const auto deepen = [](double from, double at, double lo, double hi,
+                         double room_lo, double room_hi) {
+    if (from < lo && at >= lo) {
+      return std::max(
+          at, lo + std::min(kLandingDepthPx, std::max(0.0, room_hi - lo) / 2));
+    }
+    if (from >= hi && at < hi) {
+      return std::min(
+          at, hi - std::min(kLandingDepthPx, std::max(0.0, hi - room_lo) / 2));
+    }
+    return at;
+  };
+  const PlannerPoint deeper{deepen(in_band.x, calm.x, inner.x, inner.right(),
+                                   within.x, within.right()),
+                            deepen(in_band.y, calm.y, inner.y, inner.bottom(),
+                                   within.y, within.bottom())};
+  if (Distance(deeper, calm) < 0.01 || !within.Contains(deeper) ||
+      !terrain_->Calm(deeper, kClearance, item_offset_) ||
+      (!target.IsEmpty() && UnderCover(deeper, target))) {
+    return calm;
+  }
+  return deeper;
+}
+
+// A planned leg on the channel the drag is on: a hover before the press;
+// after it, the held native drag's dragovers (DragWalk, on the planner's
+// grid), or mouse moves with the button held. `then` runs once it has
+// arrived; a leg halted or replaced never runs its `then`.
+void DragSession::PlayLeg(std::vector<PlannedPoint> leg,
+                          base::OnceClosure then) {
+  if (answered()) {
+    return;
+  }
+  if (leg.empty()) {
+    Post(std::move(then));
+    return;
+  }
+  const uint64_t token = ++leg_;
+  leg_running_ = true;
+  moved_ = true;
+  survey_fresh_ = false;
+  after_leg_ = std::move(then);
+  leg_started_ = Now();
+  std::vector<PlannerPoint> points = PointsOf(leg);
+  if (pressed_) {
+    // No leg leaves the view.
+    for (PlannerPoint& point : points) {
+      point = InView(point);
+    }
+  }
+  hand_ = points.back();
+  // A point leaving a band (or crossing into another box's) always goes
+  // out: Blink stops a band's timer only on a dragover out of it.
+  std::vector<bool> keep(points.size(), false);
+  for (size_t i = 1; i < leg.size() && i < keep.size(); ++i) {
+    keep[i] = leg[i - 1].band != 0 && leg[i].band != leg[i - 1].band;
+  }
+  leg_points_ = std::move(leg);
+  if (pressed_ && kind_ == Kind::kNative) {
+    handler_->DragWalk(
+        std::move(points), std::move(keep), interval_ms_,
+        base::BindOnce(&DragSession::OnLegArrived, Weak(), token));
+    return;
+  }
+  if (pressed_) {
+    NotePlannedDwell(leg_points_, leg_started_);
+  }
+  InputHandler::MousePathRequest request =
+      MouseRequest(std::move(points), /*held=*/pressed_);
+  // Its last point on the pixel it was aimed at, as a press lands.
+  request.exact_end = pressed_;
+  auto still = base::MakeRefCounted<base::RefCountedData<double>>(-1.0);
+  handler_->QueueMousePath(
+      std::move(request),
+      base::BindOnce(&DragSession::OnLegGesture, Weak(), token, still));
+  still->data = handler_->LastQueuedStillMs();
+}
+
+void DragSession::OnLegArrived(uint64_t token) {
+  if (answered() || token != leg_ || !leg_running_) {
+    return;
+  }
+  leg_running_ = false;
+  if (after_leg_) {
+    std::move(after_leg_).Run();
+  }
+}
+
+void DragSession::OnLegGesture(
+    uint64_t token,
+    scoped_refptr<base::RefCountedData<double>> still,
+    bool ok) {
+  if (answered()) {
+    return;
+  }
+  // The page's last move: the pointer stood still this long at the path's
+  // end, on the pixels it was sent to -- a halted leg's too: it still
+  // played.
+  if (ok && still->data >= 0) {
+    moved_at_ = Now() - base::Milliseconds(still->data);
+  }
+  if (token != leg_ || !leg_running_) {
+    return;
+  }
+  leg_running_ = false;
+  if (!ok) {
+    Fail("gone", "the page's view went away during the drag");
+    return;
+  }
+  if (after_leg_) {
+    std::move(after_leg_).Run();
+  }
+}
+
+// A station leg's piece before its last one is done: its last move
+// counts.
+void DragSession::OnPieceMoved(
+    scoped_refptr<base::RefCountedData<double>> still,
+    bool ok) {
+  if (answered()) {
+    return;
+  }
+  if (ok && still->data >= 0) {
+    moved_at_ = Now() - base::Milliseconds(still->data);
+  }
+}
+
+// The leg under way is abandoned: a native walk stops where the hand is; a
+// queued pointer leg still runs, but nothing follows it.
+void DragSession::Halt() {
+  ++leg_;
+  leg_running_ = false;
+  after_leg_.Reset();
+  retargetable_ = false;
+  if (pressed_ && kind_ == Kind::kNative && !drag_released_) {
+    handler_->DragRest();
+    hand_ = Hand();
+  }
+}
+
+// Out of a band: a dart (one stroke, kDartMs) to the nearest calm point.
+void DragSession::DartOut(base::OnceClosure then) {
+  std::optional<PlannerPoint> calm;
+  if (terrain_) {
+    calm = terrain_->NearestCalm(Hand(), kCalmSearch, item_offset_);
+  }
+  if (!calm) {
+    Post(std::move(then));
+    return;
+  }
+  Dart(*calm, std::move(then));
+}
+
+// A dart from `from` to `to`: one stroke of the hand's, its 1-99 % span
+// kDartMs, its band runs budgeted on `terrain` (none: no bands known).
+std::vector<PlannedPoint> DragSession::PlanDart(const DragTerrain* terrain,
+                                                const PlannerPoint& from,
+                                                const PlannerPoint& to) {
+  LegConstraints c =
+      terrain ? terrain->Constraints(from, to, kBandBudgetMs, item_offset_)
+              : LegConstraints();
+  c.dart = true;
+  c.dart_ms = kDartMs;
+  return Plan(from, to, kPointWidth, PathIntent::kDefault, c);
+}
+
+// A dart from the hand to `to` (PlanDart).
+void DragSession::Dart(const PlannerPoint& to, base::OnceClosure then) {
+  PlayLeg(PlanDart(base::OptionalToPtr(terrain_), Hand(), to), std::move(then));
+}
+
+// A nudge from the hand to `to`: one homing sub-movement of
+// the hand's, its overshoot over `hold` when it has one, its band runs
+// budgeted.
+void DragSession::Nudge(const PlannerPoint& to,
+                        std::optional<PlannerRect> hold,
+                        base::OnceClosure then) {
+  const PlannerPoint from = Hand();
+  LegConstraints c =
+      terrain_ ? terrain_->Constraints(from, to, kBandBudgetMs, item_offset_)
+               : LegConstraints();
+  c.dart = true;
+  c.dart_ms = 0;
+  c.hold = hold;
+  PlayLeg(Plan(from, to, LandingWidth(), PathIntent::kDefault, c),
+          std::move(then));
+}
+
+// A landing leg's drop zone: the region the hand, once inside
+// it, does not leave -- the target's box now (its slot's side for a pointer
+// drag over a list), the slider's track (a value), kHoldAroundPx round L
+// (a point, a fraction) -- held off every band whose box shows L by the
+// clearance and inset kHoldInsetPx. `box`, when given, is the target's box
+// (a retarget knows it before the reading does). None when that leaves L
+// outside: the leg then never passes its end.
+std::optional<PlannerRect> DragSession::HoldFor(const PlannerPoint& l,
+                                                const DragRect* box) const {
+  DragRect region;
+  switch (params_.target_kind) {
+    case TargetKind::kElement:
+      if (const std::optional<SlotAim> aim = SlotLanding()) {
+        region = aim->region;
+      } else {
+        region = box ? *box : TargetBoxNow();
+      }
+      break;
+    case TargetKind::kValue:
+      region = survey_ && survey_->slider
+                   ? RectToRoot(survey_->slider->track.get())
+                   : DragRect();
+      // A track too thin to hold anything once inset: the input's box.
+      if (region.Inset(kHoldInsetPx, kHoldInsetPx).IsEmpty() && survey_ &&
+          survey_->grab) {
+        region = RectToRoot(survey_->grab->box.get());
+      }
+      break;
+    case TargetKind::kFraction:
+    case TargetKind::kPoint:
+      region = DragRect{l.x - kHoldAroundPx, l.y - kHoldAroundPx,
+                        2 * kHoldAroundPx, 2 * kHoldAroundPx};
+      break;
+  }
+  if (terrain_) {
+    region = region.Intersect(terrain_->viewport());
+    for (const DragBand& band : terrain_->bands()) {
+      if (band.visible.Contains(l)) {
+        region =
+            region.Intersect(BandInner(band).Inset(kClearance, kClearance));
+      }
+    }
+  }
+  region = region.Inset(kHoldInsetPx, kHoldInsetPx);
+  if (region.IsEmpty() || !region.Contains(l)) {
+    return std::nullopt;
+  }
+  return PlannerRect{region.x, region.y, region.w, region.h};
+}
+
+// The hand's velocity now along the leg under way, in px/s.
+PlannerPoint DragSession::HandVelocity() const {
+  if (leg_points_.size() < 2) {
+    return PlannerPoint();
+  }
+  const double elapsed = (Now() - leg_started_).InMillisecondsF();
+  size_t i = 1;
+  while (i + 1 < leg_points_.size() && leg_points_[i].t_ms < elapsed) {
+    ++i;
+  }
+  return VelocityAt(leg_points_, i);
+}
