+// browser: geometry helpers shared by the Input and Page handlers
+// (input-actions).
+gfx::RectF RootBoxOf(RenderWidgetHostViewBase& view, const gfx::RectF& rect) {
+  const gfx::PointF first = view.TransformPointToRootCoordSpaceF(rect.origin());
+  float left = first.x();
+  float top = first.y();
+  float right = first.x();
+  float bottom = first.y();
+  for (const gfx::PointF& corner :
+       {rect.top_right(), rect.bottom_left(), rect.bottom_right()}) {
+    const gfx::PointF at = view.TransformPointToRootCoordSpaceF(corner);
+    left = std::min(left, at.x());
+    top = std::min(top, at.y());
+    right = std::max(right, at.x());
+    bottom = std::max(bottom, at.y());
+  }
+  return gfx::RectF(left, top, right - left, bottom - top);
+}
+
+gfx::RectF ShownPartInRoot(RenderFrameHostImpl& local_root) {
+  RenderWidgetHostViewBase* view =
+      local_root.IsRenderFrameLive() ? local_root.GetView() : nullptr;
+  RenderWidgetHostViewBase* root = view ? view->GetRootView() : nullptr;
+  if (!view || !root) {
+    return gfx::RectF();
+  }
+  const gfx::RectF whole(gfx::SizeF(root->GetViewBounds().size()));
+  if (local_root.is_main_frame()) {
+    return whole;
+  }
+  RenderFrameProxyHost* proxy = local_root.GetProxyToParent();
+  CrossProcessFrameConnector* connector =
+      proxy ? proxy->cross_process_frame_connector() : nullptr;
+  if (!connector) {
+    return whole;
+  }
+  // The frame's own physical px, its viewport's top-left at 0,0.
+  gfx::RectF part(connector->GetIntersectionState().viewport_intersection);
+  const float scale = view->GetDeviceScaleFactor();
+  if (scale > 0) {
+    part.Scale(1 / scale);
+  }
+  if (part.IsEmpty()) {
+    return gfx::RectF();
+  }
+  gfx::RectF shown = RootBoxOf(*view, part);
+  shown.Intersect(whole);
+  return shown;
+}
+
+std::optional<gfx::Vector2dF> OffsetByRects(
+    RenderFrameHostImpl& local_root,
+    const RenderFrameHostImpl* ancestor) {
+  gfx::Vector2dF offset;
+  RenderFrameHostImpl* frame = &local_root;
+  while (frame != ancestor) {
+    RenderFrameHostImpl* parent = frame->GetParent();
+    while (parent && !parent->is_local_root()) {
+      parent = parent->GetParent();
+    }
+    if (!parent) {
+      // The outermost: there when that was asked for.
+      if (ancestor) {
+        return std::nullopt;
+      }
+      break;
+    }
+    RenderFrameProxyHost* proxy = frame->GetProxyToParent();
+    CrossProcessFrameConnector* connector =
+        proxy ? proxy->cross_process_frame_connector() : nullptr;
+    if (!connector) {
+      return std::nullopt;
+    }
+    const gfx::Rect& rect = connector->GetRectInParentViewInDip();
+    offset += gfx::Vector2dF(rect.x(), rect.y());
+    frame = parent;
+  }
+  return offset;
+}
+
+bool IsPageDocument(const RenderFrameHostImpl* local_root) {
+  return local_root && !local_root->GetParentOrOuterDocument();
+}
+
+bool LandsInFrame(RenderFrameHostImpl* hit_root, const FrameTreeNode* holder) {
+  if (!holder) {
+    return false;
+  }
+  for (RenderFrameHostImpl* up = hit_root; up; up = up->GetParent()) {
+    if (up->frame_tree_node() == holder) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string CoverName(bool page, const std::string& hit) {
+  // Already said where it is -- the renderer's for a cover outside the
+  // element's document, or below the local root's own.
+  if (base::StartsWith(hit, "the page's ") ||
+      base::EndsWith(hit, " in another frame")) {
+    return hit;
+  }
+  if (page) {
+    return hit.empty() ? std::string("the page's own content")
+                       : "the page's " + hit;
+  }
+  return hit.empty() ? std::string("content from another frame")
+                     : hit + " in another frame";
+}
+
+// browser: helpers shared by the input sessions (input-actions).
+base::TimeDelta ScaledDelay(int min_ms, int max_ms, double speed_multiplier) {
+  const double speed = speed_multiplier > 0 ? speed_multiplier : 1;
+  return base::Milliseconds(base::RandIntInclusive(min_ms, max_ms) / speed);
+}
+
+double StepTimeoutMs(double remaining_ms) {
+  return std::clamp(remaining_ms, 1000.0, 60000.0);
+}
+
 }  // namespace protocol
