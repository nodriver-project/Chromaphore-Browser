+#include "base/task/single_thread_task_runner.h"
+#include "content/browser/devtools/protocol/action_outcome_watch.h"
+#include "content/browser/devtools/protocol/handler_helpers.h"
+#include "content/browser/devtools/protocol/human_path_planner.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+
+namespace content::protocol {
+
+namespace {
+
+// After keys, a click or an arrow, the field is read every frame, at most
+// this long, for what they did: a renderer takes the keys in order, but the
+// reading travels on a pipe of its own.
+constexpr base::TimeDelta kSettle = base::Milliseconds(500);
+constexpr base::TimeDelta kLookGap = base::Milliseconds(16);
+// An AM/PM part is stepped at most this many times.
+constexpr int kMaxSteps = 2;
+constexpr char kChangedReason[] =
+    "its parts changed while it was being filled: read it again";
+constexpr char kTimeoutReason[] = "the fill took longer than its timeoutMs";
+
+// The value's pieces; -1 for one it does not give.
+struct Wanted {
+  int year = -1;
+  int month = -1;
+  int day = -1;
+  int week = -1;
+  int hour = -1;
+  int minute = -1;
+  int second = -1;
+  int millisecond = -1;
+};
+
+// `count` digits of `text` at `pos` (at least `count`, and at most 9, with
+// `at_least`), `pos` moved past them; -1 when they are not there.
+int TakeDigits(const std::string& text,
+               size_t& pos,
+               size_t count,
+               bool at_least) {
+  size_t end = pos;
+  while (end < text.size() && base::IsAsciiDigit(text[end]) &&
+         (at_least || end - pos < count)) {
+    ++end;
+  }
+  if (end - pos < count || end - pos > 9) {
+    return -1;
+  }
+  int value = 0;
+  for (size_t i = pos; i < end; ++i) {
+    value = value * 10 + (text[i] - '0');
+  }
+  pos = end;
+  return value;
+}
+
+bool Take(const std::string& text, size_t& pos, char c) {
+  if (pos < text.size() && text[pos] == c) {
+    ++pos;
+    return true;
+  }
+  return false;
+}
+
+int DaysIn(int year, int month) {
+  static constexpr int kDays[] = {31, 28, 31, 30, 31, 30,
+                                  31, 31, 30, 31, 30, 31};
+  const bool leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+  return month == 2 && leap ? 29 : kDays[month - 1];
+}
+
+// HTML's valid date, month and week strings: four or more digits of year,
+// as an <input> takes them (1 to 275760).
+bool TakeYear(const std::string& text, size_t& pos, Wanted& wanted) {
+  wanted.year = TakeDigits(text, pos, 4, /*at_least=*/true);
+  return wanted.year >= 1 && wanted.year <= 275760;
+}
+
+bool TakeDate(const std::string& text, size_t& pos, Wanted& wanted) {
+  if (!TakeYear(text, pos, wanted) || !Take(text, pos, '-')) {
+    return false;
+  }
+  wanted.month = TakeDigits(text, pos, 2, false);
+  if (wanted.month < 1 || wanted.month > 12 || !Take(text, pos, '-')) {
+    return false;
+  }
+  wanted.day = TakeDigits(text, pos, 2, false);
+  return wanted.day >= 1 && wanted.day <= DaysIn(wanted.year, wanted.month);
+}
+
+// HTML's valid time string: hh:mm, with :ss and a fraction of 1 to 3 digits.
+bool TakeTime(const std::string& text, size_t& pos, Wanted& wanted) {
+  wanted.hour = TakeDigits(text, pos, 2, false);
+  if (wanted.hour < 0 || wanted.hour > 23 || !Take(text, pos, ':')) {
+    return false;
+  }
+  wanted.minute = TakeDigits(text, pos, 2, false);
+  if (wanted.minute < 0 || wanted.minute > 59) {
+    return false;
+  }
+  if (!Take(text, pos, ':')) {
+    return true;
+  }
+  wanted.second = TakeDigits(text, pos, 2, false);
+  if (wanted.second < 0 || wanted.second > 59) {
+    return false;
+  }
+  if (!Take(text, pos, '.')) {
+    return true;
+  }
+  const size_t from = pos;
+  const int fraction = TakeDigits(text, pos, 1, /*at_least=*/true);
+  const size_t digits = pos - from;
+  if (fraction < 0 || digits > 3) {
+    return false;
+  }
+  wanted.millisecond = fraction * (digits == 1 ? 100 : digits == 2 ? 10 : 1);
+  return true;
+}
+
+// The value's pieces for a field of `kind`, as its value attribute takes
+// them; nullopt when it is not one.
+std::optional<Wanted> ParseValue(const std::string& kind,
+                                 const std::string& value) {
+  Wanted wanted;
+  size_t pos = 0;
+  bool ok = false;
+  if (kind == "date") {
+    ok = TakeDate(value, pos, wanted);
+  } else if (kind == "month") {
+    ok = TakeYear(value, pos, wanted) && Take(value, pos, '-');
+    if (ok) {
+      wanted.month = TakeDigits(value, pos, 2, false);
+      ok = wanted.month >= 1 && wanted.month <= 12;
+    }
+  } else if (kind == "week") {
+    ok = TakeYear(value, pos, wanted) && Take(value, pos, '-') &&
+         Take(value, pos, 'W');
+    if (ok) {
+      wanted.week = TakeDigits(value, pos, 2, false);
+      ok = wanted.week >= 1 && wanted.week <= 53;
+    }
+  } else if (kind == "time") {
+    ok = TakeTime(value, pos, wanted);
+  } else if (kind == "datetime-local") {
+    ok = TakeDate(value, pos, wanted) &&
+         (Take(value, pos, 'T') || Take(value, pos, ' ')) &&
+         TakeTime(value, pos, wanted);
+  }
+  if (!ok || pos != value.size()) {
+    return std::nullopt;
+  }
+  return wanted;
+}
+
+// The form a field of `kind` takes a value in, for a refusal.
+std::string FormOf(const std::string& kind) {
+  if (kind == "date") {
+    return "yyyy-mm-dd";
+  }
+  if (kind == "month") {
+    return "yyyy-mm";
+  }
+  if (kind == "week") {
+    return "yyyy-Www";
+  }
+  if (kind == "time") {
+    return "hh:mm, or hh:mm:ss";
+  }
+  return "yyyy-mm-ddThh:mm";
+}
+
+// The first letter of the LDML `pattern` among `letters`, outside quoted
+// text ('' is a quote), and how many times it runs there; {0, 0} for none.
+std::pair<char, int> PatternLetter(const std::string& pattern,
+                                   std::string_view letters) {
+  bool quoted = false;
+  for (size_t i = 0; i < pattern.size(); ++i) {
+    const char c = pattern[i];
+    if (c == '\'') {
+      if (i + 1 < pattern.size() && pattern[i + 1] == '\'') {
+        ++i;
+        continue;
+      }
+      quoted = !quoted;
+      continue;
+    }
+    if (!quoted && letters.find(c) != std::string_view::npos) {
+      int run = 1;
+      while (i + run < pattern.size() && pattern[i + run] == c) {
+        ++run;
+      }
+      return {c, run};
+    }
+  }
+  return {0, 0};
+}
+
+// `value` in `width` digits at least.
+std::string Padded(int value, int width) {
+  std::string digits = base::NumberToString(value);
+  const size_t want = static_cast<size_t>(width);
+  if (digits.size() < want) {
+    digits.insert(0, want - digits.size(), '0');
+  }
+  return digits;
+}
+
+// The index of the part that has focus in `r`; -1 for none.
+int FocusedPart(const blink::mojom::AgentTemporalReading& r) {
+  for (size_t i = 0; i < r.parts.size(); ++i) {
+    if (r.parts[i]->focused) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+}  // namespace
+
+TemporalResult::TemporalResult() = default;
+TemporalResult::TemporalResult(TemporalResult&&) = default;
+TemporalResult& TemporalResult::operator=(TemporalResult&&) = default;
+TemporalResult::~TemporalResult() = default;
+
+TemporalSession::Params::Params() = default;
+TemporalSession::Params::Params(const Params&) = default;
+TemporalSession::Params& TemporalSession::Params::operator=(const Params&) =
+    default;
+TemporalSession::Params::~Params() = default;
+
+TemporalSession::TemporalSession(InputHandler& handler,
+                                 uint64_t id,
+                                 Params params,
+                                 Completion completion,
+                                 base::OnceCallback<void(uint64_t)> on_done)
+    : handler_(handler),
+      id_(id),
+      params_(std::move(params)),
+      completion_(std::move(completion)),
+      on_done_(std::move(on_done)),
+      started_(base::TimeTicks::Now()) {}
+
+TemporalSession::~TemporalSession() {
+  // The handler is going (its input state reset): nothing of it is asked.
+  if (completion_) {
+    handler_alive_ = false;
+    // Its outcome watch is not asked either.
+    action_id_ = 0;
+    Send("interrupted", InterruptionName(InputHandler::Interruption::kReset),
+         std::string(), std::string(), /*wait=*/false);
+  }
+}
+
+base::WeakPtr<TemporalSession> TemporalSession::Weak() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void TemporalSession::Start() {
+  timeout_timer_.Start(FROM_HERE, params_.timeout,
+                       base::BindOnce(&TemporalSession::OnTimeout, Weak()));
+  RenderFrameHostImpl* rfh =
+      handler_->BindCollectorForFrame(params_.frame_id, &collector_);
+  if (!rfh) {
+    Answer("gone", "the field's frame is gone");
+    return;
+  }
+  local_root_ = rfh->GetGlobalId();
+  Ask(Read::kFirst);
+}
+
+void TemporalSession::Interrupt(InputHandler::Interruption why) {
+  if (answered()) {
+    return;
+  }
+  StopSteps();
+  Answer("interrupted", InterruptionName(why));
+}
+
+void TemporalSession::StopSteps() {
+  if (key_in_flight_ && handler_->active_typing_session_ &&
+      handler_->typing_request_ == typing_mark_) {
+    // Its keys under way -- no later typing call's -- stop where they have got
+    // to: the rest would go to whatever has focus next.
+    handler_->active_typing_session_.reset();
+  }
+  key_in_flight_ = false;
+  if (moving_) {
+    // The hand stops where it has got to (its answer, posted, finds this one
+    // answered).
+    handler_->InterruptMoveSession();
+  }
+  if (revealing_ && handler_->reveal_) {
+    handler_->AnswerReveal("interrupted");
+  }
+}
+
+void TemporalSession::Ask(Read read) {
+  if (!collector_.is_connected()) {
+    OnRead(read, blink::mojom::AgentTemporalReadingPtr());
+    return;
+  }
+  // Only the first reading judges the value asked (on an input of the
+  // document's inert template document); it comes before the action is armed.
+  collector_->ReadTemporal(
+      params_.node_id, read == Read::kFirst ? params_.value : std::string(),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&TemporalSession::OnRead, Weak(), read),
+          blink::mojom::AgentTemporalReadingPtr()));
+}
+
+bool TemporalSession::LookAgain(Read read) {
+  if (base::TimeTicks::Now() >= deadline_) {
+    return false;
+  }
+  clock_.Start(FROM_HERE, kLookGap,
+               base::BindOnce(&TemporalSession::Ask, Weak(), read));
+  return true;
+}
+
+void TemporalSession::OnRead(Read read,
+                             blink::mojom::AgentTemporalReadingPtr reading) {
+  if (answered() || timed_out_) {
+    return;
+  }
+  if (!reading || reading->kind == "gone") {
+    // Gone with part of the fill sent: stopped partway; else nothing reached
+    // the page.
+    if (reached_) {
+      Answer("interrupted", "gone");
+    } else {
+      Answer("gone", reading ? "the field is no longer in the page"
+                             : "the page's renderer went away");
+    }
+    return;
+  }
+  latest_ = std::move(reading);
+  const blink::mojom::AgentTemporalReading& r = *latest_;
+  if (read != Read::kFirst && !SameParts(r)) {
+    Answer(reached_ ? "changed" : "unreachable", kChangedReason);
+    return;
+  }
+  switch (read) {
+    case Read::kFirst:
+      OnFirstRead(r);
+      return;
+    case Read::kAfterClick:
+      if (FocusedPart(r) == current_) {
+        if (clear_first_) {
+          // It had focus already: digits typed there before would run into
+          // the new ones. Emptied, as a person clears what they retype.
+          clear_first_ = false;
+          key_in_flight_ = true;
+          handler_->PressKey(
+              "Backspace", base::BindOnce(&TemporalSession::OnCleared, Weak()));
+          typing_mark_ = handler_->typing_request_;
+          return;
+        }
+        // As a person does after the click: a moment, then the keys.
+        clock_.Start(FROM_HERE, ScaledDelay(120, 320, params_.speed_multiplier),
+                     base::BindOnce(&TemporalSession::TypePart, Weak()));
+        return;
+      }
+      if (!LookAgain(read)) {
+        KeysFailed("noFocus");
+      }
+      return;
+    case Read::kAfterPart:
+      OnPartRead(r);
+      return;
+    case Read::kAfterAdvance:
+      OnAdvanceRead(r);
+      return;
+    case Read::kAfter:
+      OnFinalRead(r);
+      return;
+  }
+}
+
+void TemporalSession::OnFirstRead(const blink::mojom::AgentTemporalReading& r) {
+  if (r.kind == "notTemporal" || r.parts.empty()) {
+    Answer("notTemporal");
+    return;
+  }
+  kind_ = r.kind;
+  if (r.disabled) {
+    Answer("disabled");
+    return;
+  }
+  if (r.readonly) {
+    Answer("readonly");
+    return;
+  }
+  // As the field would take it, by its own type, min, max and step: never typed
+  // in when it would not.
+  if (!r.want_valid) {
+    Answer("badValue", FormOf(r.kind));
+    return;
+  }
+  if (r.want_underflow || r.want_overflow || r.want_step_mismatch) {
+    Answer("outOfRange", r.want_underflow  ? "min"
+                         : r.want_overflow ? "max"
+                                           : "step");
+    return;
+  }
+  want_number_ = r.want_number;
+  if (!Plan(r)) {
+    return;
+  }
+  rtl_ = r.rtl;
+  if (Matches(r)) {
+    // It holds exactly that: nothing is pressed.
+    Answer("already");
+    return;
+  }
+  if (NextEditable(-1) < 0) {
+    Answer("unreachable", "none of its parts takes keys");
+    return;
+  }
+  if (!revealed_) {
+    Reveal();
+    return;
+  }
+  // The part the keys start in has focus already: its earlier digits are
+  // still in it (a part forgets them only when it loses focus).
+  clear_first_ = FocusedPart(r) == NextEditable(-1);
+  Click();
+}
+
+bool TemporalSession::Plan(const blink::mojom::AgentTemporalReading& r) {
+  plan_.clear();
+  const std::optional<Wanted> wanted = ParseValue(r.kind, params_.value);
+  if (!wanted) {
+    Answer("badValue", FormOf(r.kind));
+    return false;
+  }
+  const char hour_letter = PatternLetter(r.format, "hHkK").first;
+  const std::pair<char, int> month_letter = PatternLetter(r.format, "ML");
+  const bool month_named = month_letter.first && month_letter.second >= 3;
+  bool has_ampm = false;
+  bool has_second = false;
+  bool has_millisecond = false;
+  for (const auto& part : r.parts) {
+    has_ampm = has_ampm || part->kind == "ampm";
+    has_second = has_second || part->kind == "second";
+    has_millisecond = has_millisecond || part->kind == "millisecond";
+  }
+  // Seconds or milliseconds the field shows no part for cannot be typed in.
+  if ((wanted->second > 0 && !has_second) ||
+      (wanted->millisecond > 0 && !has_millisecond)) {
+    part_ = wanted->second > 0 && !has_second ? "second" : "millisecond";
+    Answer("outOfRange", "noPart");
+    return false;
+  }
+  for (const auto& part : r.parts) {
+    Piece piece;
+    piece.node_id = part->node_id;
+    piece.kind = part->kind;
+    piece.editable = !part->disabled;
+    piece.range_max = part->max;
+    int width = 2;
+    int target = -1;
+    if (part->kind == "year") {
+      target = wanted->year;
+      piece.hard_max = 275760;
+      width =
+          std::max(4, static_cast<int>(base::NumberToString(target).size()));
+    } else if (part->kind == "month") {
+      target = wanted->month;
+      piece.hard_max = 12;
+      piece.named = month_named;
+    } else if (part->kind == "day") {
+      target = wanted->day;
+      piece.hard_max = 31;
+    } else if (part->kind == "week") {
+      target = wanted->week;
+      piece.hard_max = 53;
+    } else if (part->kind == "hour") {
+      // As the field's clock counts: a 12-hour one beside an AM/PM part, else
+      // a 24-hour one, the pattern's letter saying which of each (the pattern
+      // read can be one the field fell back from).
+      const int hour = wanted->hour;
+      const char cycle = has_ampm ? (hour_letter == 'K' ? 'K' : 'h')
+                                  : (hour_letter == 'k' ? 'k' : 'H');
+      if (hour < 0) {
+        target = -1;
+      } else if (cycle == 'h') {
+        target = hour % 12 == 0 ? 12 : hour % 12;
+        piece.hard_max = 12;
+      } else if (cycle == 'K') {
+        target = hour % 12;
+        piece.hard_max = 11;
+      } else if (cycle == 'k') {
+        target = hour == 0 ? 24 : hour;
+        piece.hard_max = 24;
+      } else {
+        target = hour;
+        piece.hard_max = 23;
+      }
+    } else if (part->kind == "minute") {
+      target = wanted->minute;
+      piece.hard_max = 59;
+    } else if (part->kind == "second") {
+      // Seconds the value leaves out, where the field shows them: 00.
+      target = std::max(wanted->second, 0);
+      piece.hard_max = 59;
+    } else if (part->kind == "millisecond") {
+      target = std::max(wanted->millisecond, 0);
+      piece.hard_max = 999;
+      width = 3;
+    } else if (part->kind == "ampm") {
+      target = wanted->hour < 0 ? -1 : wanted->hour < 12 ? 1 : 2;
+      piece.hard_max = 2;
+      piece.step = true;
+    } else {
+      part_ = part->kind;
+      Answer("unreachable", "it has a part this cannot fill");
+      return false;
+    }
+    if (target < 0) {
+      // A part the value has no piece for (an hour in a value with none).
+      Answer("badValue", FormOf(r.kind));
+      return false;
+    }
+    piece.target = target;
+    piece.keys = piece.step    ? std::string("ArrowUp")
+                 : piece.named ? base::NumberToString(target)
+                               : Padded(target, width);
+    // What the part takes now: its range (narrowed by min and max), and,
+    // when the field pins it, the piece it holds.
+    if (part->min <= part->max && (target < part->min || target > part->max)) {
+      part_ = part->kind;
+      Answer("outOfRange", part->disabled ? "pinned" : "range");
+      return false;
+    }
+    if (part->disabled && part->value >= 0 && part->value != target) {
+      part_ = part->kind;
+      Answer("outOfRange", "pinned");
+      return false;
+    }
+    plan_.push_back(std::move(piece));
+  }
+  return true;
+}
+
+bool TemporalSession::SameParts(
+    const blink::mojom::AgentTemporalReading& r) const {
+  if (r.parts.size() != plan_.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < plan_.size(); ++i) {
+    if (r.parts[i]->node_id != plan_[i].node_id ||
+        r.parts[i]->kind != plan_[i].kind) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool TemporalSession::Holds(const blink::mojom::AgentTemporalReading& r,
+                            size_t index) const {
+  return index < r.parts.size() && index < plan_.size() &&
+         r.parts[index]->value == plan_[index].target;
+}
+
+int TemporalSession::NextEditable(int after) const {
+  for (int i = after + 1; i < static_cast<int>(plan_.size()); ++i) {
+    if (plan_[i].editable) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+bool TemporalSession::Matches(
+    const blink::mojom::AgentTemporalReading& r) const {
+  return r.complete && !r.bad_input && std::isfinite(r.number) &&
+         std::isfinite(want_number_) && r.number == want_number_;
+}
+
+bool TemporalSession::MovesOn(size_t index) const {
+  const Piece& piece = plan_[index];
+  if (piece.step || piece.named) {
+    return false;
+  }
+  // As the part writes its range's maximum out (FormatValue): four digits at
+  // least past 999, three past 99, else two.
+  const size_t width = piece.hard_max > 999 ? 4 : piece.hard_max > 99 ? 3 : 2;
+  const size_t max_length = std::max(
+      width, base::NumberToString(std::max(piece.range_max, 0)).size());
+  return piece.keys.size() >= max_length ||
+         static_cast<int64_t>(piece.target) * 10 > piece.hard_max;
+}
+
+void TemporalSession::Reveal() {
+  if (answered()) {
+    return;
+  }
+  InputHandler::RevealRequest request;
+  request.backend_node_id = params_.node_id;
+  request.frame_id = params_.frame_id;
+  request.x = params_.pointer_x;
+  request.y = params_.pointer_y;
+  request.timeout_ms = StepTimeoutMs(RemainingMs());
+  revealing_ = true;
+  // Its answer can come before RunReveal returns, and what follows sends
+  // more input: posted.
+  handler_->RunReveal(std::move(request),
+                      base::BindPostTaskToCurrentDefault(base::BindOnce(
+                          &TemporalSession::OnRevealed, Weak())));
+}
+
+void TemporalSession::OnRevealed(InputHandler::RevealResult result) {
+  revealing_ = false;
+  if (answered()) {
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  const std::string& outcome = result.outcome;
+  if (outcome == "shown" || outcome == "blocked") {
+    // In view, or as far as the wheel brings it: read again, then the
+    // press's own check says what reaches the part.
+    revealed_ = true;
+    Ask(Read::kFirst);
+    return;
+  }
+  if (outcome == "covered") {
+    Answer("covered", "covered", result.covering.value_or(std::string()),
+           result.covering_kind.value_or(std::string()));
+    return;
+  }
+  if (outcome == "gone") {
+    Answer("gone", "the field is no longer in the page");
+    return;
+  }
+  if (outcome == "interrupted" || outcome == "timeout") {
+    Answer(outcome);
+    return;
+  }
+  Answer("unreachable", "it could not be brought into view (" + outcome + ")");
+}
+
+void TemporalSession::Click() {
+  if (answered()) {
+    return;
+  }
+  current_ = NextEditable(-1);
+  // The fill is the action, armed right before its first input, as a
+  // select's pick is: the command settling it ends it.
+  if (!action_id_) {
+    action_id_ = handler_->OutcomeWatch()->ArmSelect(local_root_,
+                                                     params_.follow_navigation);
+  }
+  InputHandler::MoveRequest move;
+  move.backend_node_id = plan_[current_].node_id;
+  move.frame_id = params_.frame_id;
+  move.intent = params_.intent;
+  move.end_action = "click";
+  move.end_button = "left";
+  move.end_click_count = 1;
+  move.speed_multiplier = params_.speed_multiplier;
+  move.timeout_ms = StepTimeoutMs(RemainingMs());
+  move.pointer_x = params_.pointer_x;
+  move.pointer_y = params_.pointer_y;
+  move.follow_navigation = params_.follow_navigation;
+  move.arm = false;
+  moving_ = true;
+  handler_->RunMove(std::move(move),
+                    base::BindPostTaskToCurrentDefault(
+                        base::BindOnce(&TemporalSession::OnClicked, Weak())));
+}
+
+void TemporalSession::OnClicked(MoveResult result) {
+  moving_ = false;
+  if (answered()) {
+    return;
+  }
+  if (timed_out_) {
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  if (result.outcome != "clicked") {
+    AnswerMove(result);
+    return;
+  }
+  reached_ = true;
+  deadline_ = base::TimeTicks::Now() + kSettle;
+  Ask(Read::kAfterClick);
+}
+
+void TemporalSession::OnCleared(bool ok) {
+  key_in_flight_ = false;
+  if (answered()) {
+    return;
+  }
+  if (timed_out_) {
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (!ok) {
+    KeysFailed("lostFocus");
+    return;
+  }
+  // Read again first: the keys go from what the part holds now (an AM/PM part
+  // emptied steps from none).
+  deadline_ = base::TimeTicks::Now() + kSettle;
+  Ask(Read::kAfterClick);
+}
+
+void TemporalSession::TypePart() {
+  if (answered()) {
+    return;
+  }
+  const Piece& piece = plan_[current_];
+  if (piece.step && latest_ && Holds(*latest_, current_)) {
+    // AM or PM already as wanted: no key.
+    OnPartRead(*latest_);
+    return;
+  }
+  key_in_flight_ = true;
+  if (piece.step) {
+    ++steps_;
+    step_from_ =
+        latest_ && static_cast<size_t>(current_) < latest_->parts.size()
+            ? latest_->parts[current_]->value
+            : -1;
+    handler_->PressKey(piece.keys,
+                       base::BindOnce(&TemporalSession::OnTyped, Weak()));
+    typing_mark_ = handler_->typing_request_;
+    return;
+  }
+  handler_->TypeText(piece.keys, params_.speed_multiplier,
+                     base::BindOnce(&TemporalSession::OnTyped, Weak()));
+  typing_mark_ = handler_->typing_request_;
+}
+
+void TemporalSession::OnTyped(bool ok) {
+  key_in_flight_ = false;
+  if (answered()) {
+    return;
+  }
+  if (timed_out_) {
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (!ok) {
+    KeysFailed("lostFocus");
+    return;
+  }
+  deadline_ = base::TimeTicks::Now() + kSettle;
+  Ask(Read::kAfterPart);
+}
+
+void TemporalSession::OnPartRead(const blink::mojom::AgentTemporalReading& r) {
+  const int focused = FocusedPart(r);
+  if (!Holds(r, current_)) {
+    const bool stepped =
+        plan_[current_].step && r.parts[current_]->value != step_from_;
+    if (stepped && steps_ < kMaxSteps && focused == current_) {
+      // The step was taken, short of the one wanted -- from no value the first
+      // gives AM: once more, for PM.
+      TypePart();
+      return;
+    }
+    if (LookAgain(Read::kAfterPart)) {
+      return;
+    }
+    KeysFailed("notTaken");
+    return;
+  }
+  const int next = NextEditable(current_);
+  if (next < 0) {
+    deadline_ = base::TimeTicks::Now() + kSettle;
+    Ask(Read::kAfter);
+    return;
+  }
+  if (focused == next) {
+    current_ = next;
+    steps_ = 0;
+    clock_.Start(FROM_HERE, ScaledDelay(80, 240, params_.speed_multiplier),
+                 base::BindOnce(&TemporalSession::TypePart, Weak()));
+    return;
+  }
+  if (MovesOn(current_)) {
+    // Its last key moves focus on in the renderer's own handling of it.
+    if (!LookAgain(Read::kAfterPart)) {
+      KeysFailed("noAdvance");
+    }
+    return;
+  }
+  if (focused != current_) {
+    KeysFailed("lostFocus");
+    return;
+  }
+  // A year with no max, a month by name, AM or PM: on to the next part by
+  // hand.
+  clock_.Start(FROM_HERE, ScaledDelay(80, 240, params_.speed_multiplier),
+               base::BindOnce(&TemporalSession::Advance, Weak()));
+}
+
+void TemporalSession::Advance() {
+  if (answered()) {
+    return;
+  }
+  key_in_flight_ = true;
+  // The arrows move between parts only left to right; Tab moves on either
+  // way.
+  handler_->PressKey(rtl_ ? "Tab" : "ArrowRight",
+                     base::BindOnce(&TemporalSession::OnAdvanced, Weak()));
+  typing_mark_ = handler_->typing_request_;
+}
+
+void TemporalSession::OnAdvanced(bool ok) {
+  key_in_flight_ = false;
+  if (answered()) {
+    return;
+  }
+  if (timed_out_) {
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (!ok) {
+    KeysFailed("lostFocus");
+    return;
+  }
+  deadline_ = base::TimeTicks::Now() + kSettle;
+  Ask(Read::kAfterAdvance);
+}
+
+void TemporalSession::OnAdvanceRead(
+    const blink::mojom::AgentTemporalReading& r) {
+  const int next = NextEditable(current_);
+  if (FocusedPart(r) == next) {
+    current_ = next;
+    steps_ = 0;
+    clock_.Start(FROM_HERE, ScaledDelay(80, 240, params_.speed_multiplier),
+                 base::BindOnce(&TemporalSession::TypePart, Weak()));
+    return;
+  }
+  if (!LookAgain(Read::kAfterAdvance)) {
+    KeysFailed("noAdvance");
+  }
+}
+
+void TemporalSession::OnFinalRead(const blink::mojom::AgentTemporalReading& r) {
+  if (Matches(r)) {
+    Answer("filled");
+    return;
+  }
+  if (LookAgain(Read::kAfter)) {
+    return;
+  }
+  Answer("mismatch");
+}
+
+void TemporalSession::KeysFailed(const std::string& why) {
+  if (current_ >= 0 && current_ < static_cast<int>(plan_.size())) {
+    part_ = plan_[current_].kind;
+  }
+  Answer("keysFailed", why);
+}
+
+void TemporalSession::AnswerMove(const MoveResult& result) {
+  const std::string& outcome = result.outcome;
+  if (outcome == "gone") {
+    Answer("gone", result.reason);
+    return;
+  }
+  if (outcome == "covered" || outcome == "hidden" || outcome == "interrupted" ||
+      outcome == "timeout" || outcome == "unreachable") {
+    Answer(outcome, result.reason, result.hit, result.hit_kind);
+    return;
+  }
+  // Pressed, released or arrived: not the click asked for.
+  Answer("unreachable", "the click did not go out (" + outcome + ")",
+         result.hit);
+}
+
+void TemporalSession::OnTimeout() {
+  timed_out_ = true;
+  StopSteps();
+  Answer("timeout", kTimeoutReason);
+}
+
+void TemporalSession::Answer(const std::string& outcome,
+                             const std::string& reason,
+                             const std::string& hit,
+                             const std::string& hit_kind) {
+  if (answered()) {
+    return;
+  }
+  // What the fill led to is answered once settled when it ran its course;
+  // else at once, with what is known.
+  Send(outcome, reason, hit, hit_kind,
+       /*wait=*/(outcome == "filled" || outcome == "mismatch") && !timed_out_);
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void TemporalSession::Fail(Response response) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  if (action_id_ && !reached_ && handler_alive_) {
+    if (ActionOutcomeWatch* watch = handler_->outcome_watch()) {
+      watch->Abandon(action_id_);
+    }
+  }
+  action_id_ = 0;
+  TemporalResult result;
+  result.failure = std::move(response);
+  std::move(completion).Run(std::move(result));
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void TemporalSession::Send(const std::string& outcome,
+                           const std::string& reason,
+                           const std::string& hit,
+                           const std::string& hit_kind,
+                           bool wait) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  const double scale = params_.css_scale > 0 ? params_.css_scale : 1;
+  TemporalResult result;
+  result.outcome = outcome;
+  result.kind = kind_;
+  result.reason = reason;
+  result.hit = hit;
+  result.hit_kind = hit_kind;
+  result.part = part_;
+  // The field's validity as last read; never a part's value.
+  if (latest_ && !kind_.empty()) {
+    result.complete = latest_->complete;
+    result.bad_input = latest_->bad_input;
+    result.range_underflow = latest_->range_underflow;
+    result.range_overflow = latest_->range_overflow;
+    result.step_mismatch = latest_->step_mismatch;
+  }
+  if (handler_alive_) {
+    if (std::optional<PlannerPoint> hand = handler_->LastPointer()) {
+      result.x = hand->x / scale;
+      result.y = hand->y / scale;
+    } else {
+      result.x = params_.pointer_x.value_or(0);
+      result.y = params_.pointer_y.value_or(0);
+    }
+  }
+  result.duration_ms = (base::TimeTicks::Now() - started_).InMillisecondsF();
+  ActionOutcomeWatch* watch =
+      handler_alive_ && action_id_ ? handler_->outcome_watch() : nullptr;
+  if (watch && !reached_) {
+    // Armed, and nothing of the fill reached the page: dropped, with no
+    // answer and no late events.
+    watch->Abandon(action_id_);
+    watch = nullptr;
+  }
+  if (watch) {
+    ActionOutcomeWatch::Reply(
+        watch, action_id_,
+        base::BindOnce(
+            [](Completion completion, TemporalResult result,
+               std::unique_ptr<Page::ActionOutcome> action_outcome) {
+              result.action_outcome = std::move(action_outcome);
+              std::move(completion).Run(std::move(result));
+            },
+            std::move(completion), std::move(result)),
+        wait);
+    return;
+  }
+  std::move(completion).Run(std::move(result));
+}
+
+double TemporalSession::RemainingMs() const {
+  const base::TimeDelta elapsed = base::TimeTicks::Now() - started_;
+  return (params_.timeout - elapsed).InMillisecondsF();
+}
+
+}  // namespace content::protocol
diff --git a/content/browser/devtools/protocol/temporal_session.h b/content/browser/devtools/protocol/temporal_session.h
new file mode 100644
index 0000000000..26ca27f8cf
--- /dev/null
+++ b/content/browser/devtools/protocol/temporal_session.h
@@ -0,0 +1,297 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Input.fillDateTime's executor: a date or time field -- an <input> of
+// type date, time, datetime-local, month or week, drawn with its parts (month,
+// day, year, hour, ...) -- filled the way a person fills one, as one action.
+// The field is read in its renderer (AgentSnapshotCollector::ReadTemporal) and
+// the value checked against it before anything moves: refused when it is not
+// such a field, is disabled or read-only, when the value is not one of its
+// type or one the field would not take (below its min, above its max, off its
+// step -- judged by Blink's own rules, on an input of the same kind never in
+// the document), or when a part cannot take its piece (outside the range the
+// part takes now, or a part the field pins holding another); answered already
+// when the field holds exactly that value. Else the field is brought into view
+// (InputHandler::RunReveal) and read again; the action is armed
+// (ActionOutcomeWatch::ArmSelect), and its first part the keys can reach is
+// clicked by the hand (InputHandler::RunMove, unarmed). Each part is then
+// typed as a person types a date: its digits, zero-padded (a month by name
+// takes its number), no typo, never a separator or a space (a space opens the
+// calendar); AM and PM are stepped with ArrowUp. After a part the field is
+// read until the part holds its piece; where focus does not move on by itself
+// (a year with no max, a month by name) ArrowRight -- Tab when the field reads
+// right to left, where the arrows do not move -- takes it to the next part.
+// A part the keys start in that already had focus is emptied first
+// (Backspace), as digits typed there before would run into its new ones. Once
+// the last part holds its piece the field is read until it holds exactly the
+// value asked: filled, else mismatch, with its validity either way; parts the
+// page made anew while it was filled answer changed. An interruption or the
+// timeout stops the keys under way too. The parts'
+// values stay in the browser: the answer carries none. One at a time per
+// InputHandler: other pointer input, a newer fill, a select, scroll, reveal
+// or move, Input.disable or a renderer change answers it interrupted, with
+// why.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_TEMPORAL_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_TEMPORAL_SESSION_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/devtools/protocol/move_session.h"
+#include "content/browser/devtools/protocol/page.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom.h"
+
+namespace content::protocol {
+
+// What a fill came to, as Input.fillDateTime answers it: a refusal before any
+// session in `failure`; else the outcome, the field's type, why, what lies
+// over a press refused and the kind of an open layer that names, the part the
+// keys stopped at, the field's validity as last read, where the hand is (CSS
+// px of the main frame's viewport), how long it took, and what the fill led to
+// (null when nothing was armed). Empty strings and unset flags are left out of
+// the answer.
+struct TemporalResult {
+  TemporalResult();
+  TemporalResult(TemporalResult&&);
+  TemporalResult& operator=(TemporalResult&&);
+  ~TemporalResult();
+
+  std::optional<Response> failure;
+  std::string outcome;
+  std::string kind;
+  std::string reason;
+  std::string hit;
+  std::string hit_kind;
+  std::string part;
+  std::optional<bool> complete;
+  std::optional<bool> bad_input;
+  std::optional<bool> range_underflow;
+  std::optional<bool> range_overflow;
+  std::optional<bool> step_mismatch;
+  double x = 0;
+  double y = 0;
+  double duration_ms = 0;
+  std::unique_ptr<Page::ActionOutcome> action_outcome;
+};
+
+class TemporalSession {
+ public:
+  // A call to Input.fillDateTime, checked by InputHandler::FillDateTime.
+  struct Params {
+    Params();
+    Params(const Params&);
+    Params& operator=(const Params&);
+    ~Params();
+
+    // The field: its DOMNodeId in the local root of `frame_id`.
+    int32_t node_id = 0;
+    std::string frame_id;
+    // The value, as the field's own value attribute would take it
+    // (2024-05-03, 14:30, 2024-05-03T14:30, 2024-05, 2024-W18).
+    std::string value;
+    // As Input.moveTo takes them, for the hand's click.
+    std::optional<std::string> intent;
+    double speed_multiplier = 1;
+    base::TimeDelta timeout;
+    // Where the pointer is, in CSS px of the main frame's viewport, for when
+    // no mouse path has put it anywhere yet.
+    std::optional<double> pointer_x;
+    std::optional<double> pointer_y;
+    // Root DIPs per CSS px of the main frame's viewport.
+    double css_scale = 1;
+    // Whether the answer waits for a cross-document navigation the fill
+    // started to end.
+    bool follow_navigation = true;
+  };
+
+  using Completion = base::OnceCallback<void(TemporalResult)>;
+
+  // `completion` hears the answer; `on_done` hears this session's id, posted,
+  // once it has answered.
+  TemporalSession(InputHandler& handler,
+                  uint64_t id,
+                  Params params,
+                  Completion completion,
+                  base::OnceCallback<void(uint64_t)> on_done);
+  TemporalSession(const TemporalSession&) = delete;
+  TemporalSession& operator=(const TemporalSession&) = delete;
+  // Unanswered, it answers interrupted, without the handler.
+  ~TemporalSession();
+
+  void Start();
+  // Other input, a renderer change (the frame navigated) or Input.disable:
+  // answered interrupted with `why`, at once; its own move or reveal stops
+  // where it has got to.
+  void Interrupt(InputHandler::Interruption why);
+
+  uint64_t id() const { return id_; }
+  bool answered() const { return !completion_; }
+
+ private:
+  // What a reading of the field is for.
+  enum class Read {
+    // Before anything, and again once it is in view: what it is, and whether
+    // anything is to be done.
+    kFirst,
+    // After the click: which part has focus.
+    kAfterClick,
+    // After a part's keys: until the part holds its piece.
+    kAfterPart,
+    // After ArrowRight or Tab: until focus is on the next part.
+    kAfterAdvance,
+    // After the last part: until the field holds a whole value.
+    kAfter,
+  };
+
+  // One part of the field, as the plan has it: its node, its kind, the piece
+  // of the value it is to hold (in its own terms: a 12-hour clock's hour, AM
+  // 1 and PM 2, a month by name's number), the keys that type it, whether
+  // they are an ArrowUp step (AM/PM) or a name's number (a month by name),
+  // whether it takes keys at all (pinned parts do not), and the maxima its
+  // own rule for moving on reads: its range's now, and its kind's.
+  struct Piece {
+    int32_t node_id = 0;
+    std::string kind;
+    int target = -1;
+    std::string keys;
+    bool step = false;
+    bool named = false;
+    bool editable = false;
+    int range_max = 0;
+    int hard_max = 0;
+  };
+
+  void Ask(Read read);
+  void OnRead(Read read, blink::mojom::AgentTemporalReadingPtr reading);
+  void OnFirstRead(const blink::mojom::AgentTemporalReading& reading);
+  // The value's pieces for each part of `reading`, in plan_; false, answered
+  // (badValue, outOfRange), when the value does not fit the field.
+  bool Plan(const blink::mojom::AgentTemporalReading& reading);
+  // Whether the parts `reading` gives are the ones planned (same nodes, same
+  // kinds); and whether one holds its piece.
+  bool SameParts(const blink::mojom::AgentTemporalReading& reading) const;
+  bool Holds(const blink::mojom::AgentTemporalReading& reading,
+             size_t index) const;
+  // The next part from `after` the keys type; -1 for none left.
+  int NextEditable(int after) const;
+  // Whether `reading`'s field holds exactly the value asked: its number, a
+  // whole value, no part without a whole.
+  bool Matches(const blink::mojom::AgentTemporalReading& reading) const;
+
+  void Reveal();
+  void OnRevealed(InputHandler::RevealResult result);
+  void Click();
+  void OnClicked(MoveResult result);
+  // The part the keys start in emptied, when it had focus before the click.
+  void OnCleared(bool ok);
+
+  // The keys of plan_[current_]: its digits typed, or AM/PM stepped.
+  void TypePart();
+  void OnTyped(bool ok);
+  void OnPartRead(const blink::mojom::AgentTemporalReading& reading);
+  // Focus to the next part: ArrowRight, or Tab right to left.
+  void Advance();
+  void OnAdvanced(bool ok);
+  void OnAdvanceRead(const blink::mojom::AgentTemporalReading& reading);
+  void OnFinalRead(const blink::mojom::AgentTemporalReading& reading);
+  // A reading that did not show what it waits for yet: asked again a frame
+  // later, and true, while `deadline_` is ahead; false once it has passed.
+  bool LookAgain(Read read);
+  // Whether typing plan_[index]'s keys leaves focus on the next part by
+  // itself, by the part's own rule (DateTimeNumericFieldElement): its keys
+  // as long as its range's maximum written out, or a next digit that would
+  // pass its hard maximum. A month by name and AM/PM never move on.
+  bool MovesOn(size_t index) const;
+  // The keys stopped short at the part under way: keysFailed, with why.
+  void KeysFailed(const std::string& why);
+
+  // The hand's click refused: answered as the move said it.
+  void AnswerMove(const MoveResult& result);
+  void OnTimeout();
+  // The one answer: `wait` once what the armed action led to has settled.
+  void Answer(const std::string& outcome,
+              const std::string& reason = std::string(),
+              const std::string& hit = std::string(),
+              const std::string& hit_kind = std::string());
+  void Fail(Response response);
+  void Send(const std::string& outcome,
+            const std::string& reason,
+            const std::string& hit,
+            const std::string& hit_kind,
+            bool wait);
+  // Its own move or reveal under way stops where it has got to.
+  void StopSteps();
+  double RemainingMs() const;
+  base::WeakPtr<TemporalSession> Weak();
+
+  const raw_ref<InputHandler> handler_;
+  const uint64_t id_;
+  Params params_;
+  Completion completion_;
+  base::OnceCallback<void(uint64_t)> on_done_;
+  const base::TimeTicks started_;
+
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector_;
+  GlobalRenderFrameHostId local_root_;
+  // The latest reading of the field.
+  blink::mojom::AgentTemporalReadingPtr latest_;
+  // The field's type, as first read; the part a refusal or the keys stopped
+  // at.
+  std::string kind_;
+  std::string part_;
+  // The value's pieces, one per part, in the field's order; the one being
+  // typed; whether the field reads right to left.
+  std::vector<Piece> plan_;
+  int current_ = -1;
+  bool rtl_ = false;
+  // ArrowUp presses an AM/PM part has had, and the value it held before the
+  // last one.
+  int steps_ = 0;
+  int step_from_ = -1;
+  // The part the keys start in had focus before the click: emptied first.
+  bool clear_first_ = false;
+  // The handler's typing request after this session's last keys went out: its
+  // keys are the ones under way only while it is unchanged.
+  int typing_mark_ = 0;
+  // Until when a look waits for what it reads for.
+  base::TimeTicks deadline_;
+  // The value asked as a number, as the field's own rules read it (the first
+  // reading's want_number): a reading matches when the field's equals it.
+  double want_number_ = 0;
+
+  // The field has been brought into view, and read again after it.
+  bool revealed_ = false;
+  bool revealing_ = false;
+  bool moving_ = false;
+  bool key_in_flight_ = false;
+  bool timed_out_ = false;
+  // The outcome watch's id once the fill armed it (0: none); whether any of
+  // its input has been sent to the page since (the click, a key).
+  int action_id_ = 0;
+  bool reached_ = false;
+  // False once the handler is going (the destructor): nothing of it is
+  // asked.
+  bool handler_alive_ = true;
+
+  base::OneShotTimer timeout_timer_;
+  base::OneShotTimer clock_;
+  base::WeakPtrFactory<TemporalSession> weak_factory_{this};
+};
+
+}  // namespace content::protocol
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_TEMPORAL_SESSION_H_
