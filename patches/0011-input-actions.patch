+
+// The reference model's constants, in its order. Parity rules (its
+// header): sums run left to right in plain loops; a length is
+// sqrt(x * x + y * y); every expression keeps the reference's association.
+
+constexpr double kFieldTempo = 1.3;
+constexpr double kDenseMs = 0.5;
+constexpr double kMaxLegMs = 8000.0;
+constexpr double kEndF = 0.999;
+constexpr double kEndPx = 0.5;
+constexpr double kCorridorMargin = 5.0;
+constexpr double kFlipRoom = 6.0;
+constexpr double kHoldEps = 0.01;
+constexpr double kOvershootPx = 0.5;
+constexpr int kBisect = 10;
+constexpr double kRampMs = 30.0;
+constexpr double kJitterFadeMs = 40.0;
+constexpr double kMinRate = 0.3;
+constexpr double kMaxChordPx = 100000.0;
+constexpr double kSpeedMultiplierMin = 0.05;
+constexpr double kSpeedMultiplierMax = 20.0;
+constexpr double kEntryMin = 0.05;  // px/ms
+constexpr double kStopped = 1000000000.0;
+
+// Per-movement spreads.
+constexpr double kSigmaLog = 0.3;
+constexpr double kSdBrake = 0.08;
+constexpr double kSdSweep = 0.7;
+constexpr double kSdSubSpan = 0.15;
+constexpr double kSdStop = 0.36;
+constexpr double kSdCreep = 0.3;
+constexpr double kSdRelease = 0.7;
+constexpr double kSdLatency = 0.5;
+constexpr double kArcExp = 0.42;
+
+// Homing.
+constexpr double kSubBeta = 0.0;
+constexpr double kSubMinMs = 60.0;
+constexpr double kSubMaxMs = 260.0;
+
+// Tremor.
+constexpr double kTremorReferenceVelocity = 500.0;  // px/s
+constexpr double kTremorMinAmplitudeScale = 0.1;
+constexpr double kTremorOriginRangeSec = 1000.0;
+constexpr double kTremorOn = 380.0;  // px/s
+
+// Styles, per movement.
+constexpr double kPHesitant = 0.15;
+constexpr double kHesLo = 0.04;
+constexpr double kHesHi = 0.12;
+constexpr double kHesMaxPx = 80.0;
+constexpr double kHesLeadLo = 2.0;
+constexpr double kHesLeadHi = 4.5;
+constexpr double kPSloppy = 0.35;
+constexpr double kSloppyMult = 2.9;
+constexpr double kPCurvy = 0.06;
+constexpr double kCurvySweep = 2.2;
+constexpr double kCurvyLat = 2.7;
+constexpr double kPCrisp = 0.05;
+constexpr double kAimExp = 0.51;
+constexpr double kEntryFitMin = 0.15;
+constexpr double kCrispStopPx = 4.0;
+// Calibration: the speed jitter's band, its sum's scale
+// (sqrt(2 / kJitterWaves), its sd kept at 1) and its depth per move, capped;
+// the primary's aim never behind kUnderMin of the way.
+constexpr double kJitterFreqLo = 2.0;
+constexpr double kJitterFreqHi = 22.0;
+constexpr double kJitterNorm = 0.3333333333333333;
+constexpr double kJitterDepthSd = 0.9;
+constexpr double kJitterDepthMax = 0.35;
+constexpr double kUnderMin = 0.2;
+
+constexpr double kZ99 = 2.3263478740408408;
+constexpr double kZ001 = -3.090232306167813;
+constexpr double kInvSqrt2 = 0.7071067811865476;
+constexpr double kSqrt2Pi = 2.5066282746310002;
+constexpr double kTwoPi = 6.283185307179586;
+constexpr double kRadToDeg = 180.0 / std::numbers::pi;
+
+constexpr std::array<double, 8> kDirectionDuration = {1.00, 1.05, 1.10, 1.00,
+                                                      0.90, 1.05, 1.15, 1.10};
+constexpr std::array<double, 8> kDirectionCurvature = {1.00, 0.90, 1.10, 1.00,
+                                                       0.85, 1.00, 1.20, 1.05};
+
+// Acklam's approximation of the normal quantile.
+constexpr std::array<double, 6> kAcklamA = {
+    -3.969683028665376e+01, 2.209460984245205e+02,  -2.759285104469687e+02,
+    1.383577518672690e+02,  -3.066479806614716e+01, 2.506628277459239e+00};
+constexpr std::array<double, 5> kAcklamB = {
+    -5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02,
+    6.680131188771972e+01, -1.328068155288572e+01};
+constexpr std::array<double, 6> kAcklamC = {
+    -7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00,
+    -2.549732539343734e+00, 4.374664141464968e+00,  2.938163982698783e+00};
+constexpr std::array<double, 4> kAcklamD = {
+    7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00,
+    3.754408661907416e+00};
+
+double Hyp(double x, double y) {
+  return std::sqrt(x * x + y * y);
+}
+
+// The reference's clamp: min(hi, max(lo, v)); hi wins when lo > hi.
+double Clamp(double v, double lo, double hi) {
+  return std::min(hi, std::max(lo, v));
+}
+
+double Phi(double z) {
+  return 0.5 * std::erfc(-z * kInvSqrt2);
+}
+
+double SmallPhi(double z) {
+  return std::exp(-0.5 * z * z) / kSqrt2Pi;
+}
+
+// Acklam's approximation, then one Halley step on erfc.
+double PhiInv(double p) {
+  if (p <= 0) {
+    return -38.0;
+  }
+  if (p >= 1) {
+    return 38.0;
+  }
+  const std::array<double, 6>& a = kAcklamA;
+  const std::array<double, 5>& b = kAcklamB;
+  const std::array<double, 6>& c = kAcklamC;
+  const std::array<double, 4>& d = kAcklamD;
+  double x = 0;
+  if (p < 0.02425) {
+    const double q = std::sqrt(-2 * std::log(p));
+    x = (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) /
+        ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1);
+  } else if (p <= 1 - 0.02425) {
+    const double q = p - 0.5;
+    const double r = q * q;
+    x = (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) *
+        q / (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1);
+  } else {
+    const double q = std::sqrt(-2 * std::log(1 - p));
+    x = -(((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) /
+        ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1);
+  }
+  const double e = Phi(x) - p;
+  const double u = e * kSqrt2Pi * std::exp(0.5 * x * x);
+  return x - u / (1 + 0.5 * x * u);
+}
+
+// mu such that a stroke's 1-99 % window lasts `span` ms.
+double MuForSpan(double span, double sigma) {
+  return std::log(span / (2 * std::sinh(kZ99 * sigma)));
+}
+
+// t0 such that the plain lognormal is at F = 0.001 at t_start.
+double OnsetFor(double t_start, double mu, double sigma) {
+  return t_start - std::exp(mu + kZ001 * sigma);
+}
+
+// DirectionDynamics' table at `angle` (radians; +y down): the angle in
+// degrees normalised to [0, 360), its 45-degree sector, a linear blend.
+double DirectionMultiplier(const std::array<double, 8>& table, double angle) {
+  double degrees = angle * kRadToDeg;
+  degrees = std::fmod(std::fmod(degrees, 360.0) + 360.0, 360.0);
+  const size_t sector =
+      std::min(static_cast<size_t>(degrees / 45.0), static_cast<size_t>(7));
+  const double fraction = (degrees - sector * 45.0) / 45.0;
+  const double a = table[sector];
+  const double b = table[(sector + 1) % 8];
+  return a + (b - a) * fraction;
+}
+
+// The largest f in [0, 1] that `fits` (10 halvings), 1 when 1 does.
+template <typename Fits>
+double Bisect(Fits fits) {
+  if (fits(1.0)) {
+    return 1.0;
+  }
+  double lo = 0;
+  double hi = 1;
+  for (int i = 0; i < kBisect; ++i) {
+    const double mid = 0.5 * (lo + hi);
+    if (fits(mid)) {
+      lo = mid;
+    } else {
+      hi = mid;
+    }
+  }
+  return lo;
+}
+
+PlannerPoint ToPoint(double x, double y) {
+  return PlannerPoint{x, y};
+}
+
+}  // namespace
+
+LegConstraints::LegConstraints() = default;
+LegConstraints::LegConstraints(const LegConstraints&) = default;
+LegConstraints& LegConstraints::operator=(const LegConstraints&) = default;
+LegConstraints::~LegConstraints() = default;
+
+// ---------------------------------------------------------------- strokes
+
+HumanPathPlanner::Stroke::Stroke(double cx_in,
+                                 double cy_in,
+                                 double dth_in,
+                                 double t0_in,
+                                 double mu_in,
+                                 double sigma_in,
+                                 bool trunc_in)
+    : cx(cx_in),
+      cy(cy_in),
+      dth(dth_in),
+      t0(t0_in),
+      mu(mu_in),
+      sigma(sigma_in),
+      trunc(trunc_in) {
+  const double chord = Hyp(cx, cy);
+  straight = std::abs(dth) < 1e-6 || chord <= 0;
+  if (!straight) {
+    const double d = chord * (dth / 2) / std::sin(dth / 2);
+    ths = std::atan2(cy, cx) - dth / 2;
+    k = d / dth;
+  }
+  at0 = Disp(0.0);
+}
+
+double HumanPathPlanner::Stroke::F(double t) const {
+  if (t <= t0) {
+    return 0.0;
+  }
+  double f = Phi((std::log(t - t0) - mu) / sigma);
+  if (trunc) {
+    f = std::max(0.0, (f - 0.001) / 0.999);
+  }
+  return f;
+}
+
+HumanPathPlanner::Vec HumanPathPlanner::Stroke::Disp(double t) const {
+  const double f = F(t);
+  if (straight) {
+    return Vec{cx * f, cy * f};
+  }
+  const double a = ths;
+  const double b = a + dth * f;
+  return Vec{k * (std::sin(b) - std::sin(a)), k * (std::cos(a) - std::cos(b))};
+}
+
+double HumanPathPlanner::Stroke::TAt(double f) const {
+  if (trunc) {
+    f = 0.001 + 0.999 * f;
+  }
+  return t0 + std::exp(mu + sigma * PhiInv(f));
+}
+
+// ---------------------------------------------------------------- planner
+
+HumanPathPlanner::HumanPathPlanner(const browser::MovementPersona& persona,
+                                   uint64_t variation_seed)
+    : persona_(persona), variation_(variation_seed), noise_(variation_()) {}
+
+HumanPathPlanner::~HumanPathPlanner() = default;
+
+int HumanPathPlanner::polling_rate_hz() const {
+  return std::max(1, persona_.polling_rate_hz);
+}
+
+const browser::MovementPersona& HumanPathPlanner::persona() const {
+  return persona_;
+}
+
+double HumanPathPlanner::Uniform(std::mt19937_64* engine) {
+  return ((*engine)() >> 11) * 0x1.0p-53;
+}
+
+double HumanPathPlanner::Gaussian(std::mt19937_64* engine,
+                                  std::optional<double>* next) {
+  if (next->has_value()) {
+    const double value = **next;
+    next->reset();
+    return value;
+  }
+  double v1;
+  double v2;
+  double s;
+  do {
+    v1 = 2 * Uniform(engine) - 1;
+    v2 = 2 * Uniform(engine) - 1;
+    s = v1 * v1 + v2 * v2;
+  } while (s >= 1 || s == 0);
+  const double multiplier = std::sqrt(-2 * std::log(s) / s);
+  *next = v2 * multiplier;
+  return v1 * multiplier;
+}
+
+double HumanPathPlanner::U() {
+  return Uniform(&variation_);
+}
+
+double HumanPathPlanner::G() {
+  return Gaussian(&variation_, &next_gaussian_);
+}
+
+double HumanPathPlanner::NoiseG() {
+  return Gaussian(&noise_, &next_noise_);
+}
+
+// ---------------------------------------------------------------- waits
+
+double HumanPathPlanner::PressDwellMs(PathIntent intent) {
+  const browser::HandKinematics& k = persona_.kinematics;
+  double f = 1.0;
+  switch (intent) {
+    case PathIntent::kConfirm:
+      f = 2.0;
+      break;
+    case PathIntent::kPrecise:
+      f = 1.5;
+      break;
+    case PathIntent::kNavigate:
+      f = 0.8;
+      break;
+    case PathIntent::kDefault:
+    case PathIntent::kCasual:
+      break;
+  }
+  return Clamp(k.dwell_median * f * std::exp(G() * k.dwell_logsd), 5.0, 1500.0);
+}
+
+double HumanPathPlanner::ClickHoldMs() {
+  return std::max(
+      30.0, persona_.click_hold_mean_ms + G() * persona_.click_hold_sd_ms);
+}
+
+double HumanPathPlanner::ClickGapMs() {
+  return 80.0 + U() * 90.0;
+}
+
+double HumanPathPlanner::ReleaseDwellMs() {
+  return Clamp(persona_.kinematics.release_ms * std::exp(G() * kSdRelease),
+               20.0, 1500.0);
+}
+
+double HumanPathPlanner::PressLatencyMs() {
+  return Clamp(persona_.kinematics.latency_ms * std::exp(G() * kSdLatency),
+               40.0, 400.0);
+}
+
+namespace {
+
+// A press's scatter: people's spread on each screen axis over every
+// direction of approach (Yamanaka 2023, Exp. 2), at everyday care (0.8 of
+// the speeded fit), a little longer along the approach than across it
+// (Yamanaka & MacKenzie 2026); the draws past the part's 1 px inset drawn
+// again up to this many times.
+constexpr double kClickLevel = 0.8;
+constexpr int kClickRedraws = 8;
+constexpr double kClickFitPx = 120;
+constexpr double kClickStretch = 1.2;
+
+// An extent as the scatter's fit counts it: as it is up to the fit's 120 px
+// (its sizes ran 30 to 120), then growing as its logarithm. Past 120 there is
+// no data: a 400 px field is not pressed only near its middle, nor a
+// page-wide box all over it.
+double FitExtent(double e) {
+  return e <= kClickFitPx ? e : kClickFitPx * (1.0 + std::log(e / kClickFitPx));
+}
+
+// Whether (px, py) is in one of `holes`, its edges counted.
+bool InAnyHole(const std::vector<PlannerRect>& holes, double px, double py) {
+  for (const PlannerRect& r : holes) {
+    if (px >= r.x && px <= r.x + r.w && py >= r.y && py <= r.y + r.h) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+PlannerPoint HumanPathPlanner::ClickPoint(
+    const PlannerRect& box,
+    const PlannerRect& sized_by,
+    const PlannerPoint& from,
+    double distance,
+    PathIntent intent,
+    const std::vector<PlannerRect>& holes) {
+  const double x = box.x;
+  const double y = box.y;
+  const double w = box.w;
+  const double h = box.h;
+  // Measured on the whole of what shows of it, never on less than the part:
+  // a strip of a button under a sticky header keeps the button's scatter
+  // along it. Finite whatever comes.
+  const double sw = std::min(std::max(sized_by.w, w), kMaxChordPx);
+  const double sh = std::min(std::max(sized_by.h, h), kMaxChordPx);
+  // The approach: from the hand to the part's middle.
+  double ux = x + w / 2 - from.x;
+  double uy = y + h / 2 - from.y;
+  const double length = Hyp(ux, uy);
+  if (length < 1) {
+    ux = 1;
+    uy = 0;
+  } else {
+    ux /= length;
+    uy /= length;
+  }
+  // People's spread on each screen axis follows the element's extent on it,
+  // the other extent and its shape adding a little (Yamanaka 2023, Exp. 2,
+  // over every direction of approach): the main term on the extent as the
+  // fit counts it, the small ones on extents within the fit's range. Not
+  // chords along the approach: a steep approach to a flat button cut
+  // its x spread to the button's height.
+  const double cw = Clamp(sw, 1.0, kClickFitPx);
+  const double ch = Clamp(sh, 1.0, kClickFitPx);
+  const double fit_x = 0.87 + 0.161 * FitExtent(sw) + 0.013 * ch +
+                       0.32 * Clamp(cw / ch, 0.25, 4.0);
+  const double fit_y = 0.72 + 0.131 * FitExtent(sh) + 0.023 * cw +
+                       0.43 * Clamp(ch / cw, 0.25, 4.0);
+  // Hardly the distance once there is time to aim. The persona's drift
+  // amplitude says how loose its presses are: its own factor, 0.8 to 1.25.
+  const double persona_factor =
+      0.8 + 0.3 * (persona_.click_drift_amplitude - 0.5);
+  const double m = kClickLevel * persona_factor *
+                   std::pow(Clamp(distance, 50.0, kMaxChordPx) / 600.0, 0.08);
+  const double sx = m * fit_x;
+  const double sy = m * fit_y;
+  // Longer along the approach than across it, the area kept:
+  // o' = (o + (k - 1)(u.o) u) / sqrt(k), o the spread's own draw.
+  const double root_k = std::sqrt(kClickStretch);
+  double xx = (1.0 + (kClickStretch - 1.0) * ux * ux) / root_k * sx;
+  double xy = (kClickStretch - 1.0) * ux * uy / root_k * sy;
+  double yx = (kClickStretch - 1.0) * ux * uy / root_k * sx;
+  double yy = (1.0 + (kClickStretch - 1.0) * uy * uy) / root_k * sy;
+  // Never wider than a quarter of the part a press reaches on each axis: a
+  // thin strip of a button under a cover keeps its presses off its edge
+  // rows. On a whole element it binds where a side is short
+  // (under about 30 px).
+  const double cap_x = std::min(1.0, w / 4 / std::max(Hyp(xx, xy), 1e-9));
+  const double cap_y = std::min(1.0, h / 4 / std::max(Hyp(yx, yy), 1e-9));
+  xx *= cap_x;
+  xy *= cap_x;
+  yx *= cap_y;
+  yy *= cap_y;
+  const double ex = std::min(1.0, w / 4);
+  const double ey = std::min(1.0, h / 4);
+  const double a = U() * kTwoPi;
+  const double r = persona_.click_drift_amplitude * (0.5 + 0.5 * U());
+  // The persona's bias and drift, held within a quarter of the part on each
+  // axis: off a thin strip's middle band, every draw fell outside it and the
+  // press was clamped onto one row.
+  const double mx =
+      x + w / 2 +
+      Clamp(persona_.click_offset_bias_x + r * std::cos(a), -w / 4, w / 4);
+  const double my =
+      y + h / 2 +
+      Clamp(persona_.click_offset_bias_y + r * std::sin(a), -h / 4, h / 4);
+  // A draw outside the part is drawn again, both axes together, not
+  // clamped: clamped, the draws past an edge all pressed one row of pixels
+  // by it. So is a draw in one of `holes`.
+  double px = mx;
+  double py = my;
+  for (int i = 0; i <= kClickRedraws; ++i) {
+    const double g1 = G();
+    const double g2 = G();
+    px = mx + xx * g1 + xy * g2;
+    py = my + yx * g1 + yy * g2;
+    if (px >= x + ex && px <= x + w - ex && py >= y + ey && py <= y + h - ey &&
+        !InAnyHole(holes, px, py)) {
+      break;
+    }
+  }
+  return PlannerPoint{Clamp(px, x + ex, x + w - ex),
+                      Clamp(py, y + ey, y + h - ey)};
+}
+
+// ---------------------------------------------------------------- the leg
+
+std::vector<PlannedPoint> HumanPathPlanner::PlanLeg(const PlannerPoint& from,
+                                                    const PlannerPoint& to_in,
+                                                    double target_width,
+                                                    PathIntent intent,
+                                                    double speed_multiplier,
+                                                    const LegConstraints& c) {
+  const bool from_ok = std::isfinite(from.x) && std::isfinite(from.y);
+  const bool to_ok = std::isfinite(to_in.x) && std::isfinite(to_in.y);
+  if (!from_ok || !to_ok) {
+    if (!from_ok && !to_ok) {
+      return {};
+    }
+    PlannedPoint only;
+    only.p = to_ok ? to_in : from;
+    only.band = BandAt(c, Vec{only.p.x, only.p.y});
+    return {only};
+  }
+  Vec to{to_in.x, to_in.y};
+  double d = Hyp(to.x - from.x, to.y - from.y);
+  if (d < 1.0) {
+    PlannedPoint only;
+    only.p = to_in;
+    only.band = BandAt(c, to);
+    return {only};
+  }
+  const double width = std::max(target_width, 1.0);
+  const double speed =
+      std::isfinite(speed_multiplier)
+          ? Clamp(speed_multiplier, kSpeedMultiplierMin, kSpeedMultiplierMax)
+          : 1.0;
+  if (d > kMaxChordPx) {
+    to = Vec{from.x + (to.x - from.x) * kMaxChordPx / d,
+             from.y + (to.y - from.y) * kMaxChordPx / d};
+    d = kMaxChordPx;
+  }
+  const double tick_ms = 1000.0 / polling_rate_hz();
+
+  Geo geo;
+  geo.from = Vec{from.x, from.y};
+  geo.to = to;
+  geo.d = d;
+  geo.ux = (to.x - from.x) / d;
+  geo.uy = (to.y - from.y) / d;
+  geo.nx = geo.uy;
+  geo.ny = -geo.ux;
+  geo.theta = std::atan2(to.y - from.y, to.x - from.x);
+
+  const IntentTempo intent_tempo = Intent(intent);
+  const browser::HandKinematics& k = persona_.kinematics;
+  geo.tempo = kFieldTempo * DirectionMultiplier(kDirectionDuration, geo.theta) *
+              intent_tempo.factor * (c.button_held ? k.drag_tempo : 1.0) /
+              speed;
+  geo.tol = std::max(1.5, k.tol * intent_tempo.tol_mult * width / 2);
+  const Draft draft = MakeDraft(c, geo.from);
+
+  double f = 1.0;
+  if ((c.free_plus >= 0 && c.free_plus < kCorridorMargin) ||
+      (c.free_minus >= 0 && c.free_minus < kCorridorMargin)) {
+    // No room beyond the margin on a side: the straight leg, which is what
+    // the bisection would find, without its eleven passes.
+    f = 0.0;
+  } else if (c.free_plus >= 0 || c.free_minus >= 0 || c.keep.has_value()) {
+    // Kept inside a region: what f scales -- the sweeps, the lateral
+    // misses, the start's arc -- is fitted with the brake and the forward
+    // misses off, which the second bisection shrinks.
+    f = Bisect([&](double x) {
+      return FitsCorridor(Dense(Build(draft, geo, c, x, 1.0), geo), geo, c) &&
+             (!c.keep.has_value() ||
+              FitsKeep(Dense(Build(draft, geo, c, x, 0.0), geo), geo, c));
+    });
+  }
+  double g = 1.0;
+  if (c.hold.has_value() || !c.overshoot || c.keep.has_value()) {
+    g = Bisect([&](double x) {
+      const std::vector<Vec> dense = Dense(Build(draft, geo, c, f, x), geo);
+      return FitsHold(dense, geo, c) && FitsKeep(dense, geo, c);
+    });
+  }
+  const std::vector<Stroke> strokes = Build(draft, geo, c, f, g);
+  const std::vector<Vec> dense = Dense(strokes, geo);
+
+  const std::vector<double> times = Timing(dense, draft, geo, c);
+  const std::vector<Vec> samples = Sample(dense, times, tick_ms);
+  const bool exact = c.exact_end || c.dart;
+  std::vector<Vec> tremored = ApplyTremor(samples, exact);
+  if (exact && !tremored.empty()) {
+    tremored.back() = to;
+  }
+  TrimRunsOnGrid(&tremored, c, tick_ms);
+
+  std::vector<PlannedPoint> out;
+  out.reserve(tremored.size());
+  for (size_t i = 0; i < tremored.size(); ++i) {
+    PlannedPoint point;
+    point.p = ToPoint(tremored[i].x, tremored[i].y);
+    point.t_ms = i * tick_ms;
+    point.band = BandAt(c, tremored[i]);
+    out.push_back(point);
+  }
+  return out;
+}
+
+// The intent's tempo (one draw, for the intents that vary) and its tolerance
+// multiplier.
+HumanPathPlanner::IntentTempo HumanPathPlanner::Intent(PathIntent intent) {
+  IntentTempo tempo;
+  switch (intent) {
+    case PathIntent::kNavigate:
+      tempo.factor = 0.85 + 0.10 * U();
+      return tempo;
+    case PathIntent::kConfirm:
+      tempo.factor = 1.10 + 0.20 * U();
+      return tempo;
+    case PathIntent::kPrecise:
+      tempo.factor = 1.15 + 0.15 * U();
+      tempo.tol_mult = 0.6;
+      return tempo;
+    case PathIntent::kCasual:
+      tempo.factor = 1.20 + 0.30 * U();
+      tempo.tol_mult = 1.5;
+      return tempo;
+    case PathIntent::kDefault:
+      return tempo;
+  }
+  NOTREACHED();
+}
+
+HumanPathPlanner::Draft HumanPathPlanner::MakeDraft(const LegConstraints& c,
+                                                    const Vec& from) {
+  Draft d;
+  const PlannerPoint from_point = ToPoint(from.x, from.y);
+  d.start_in_band = !c.band_of.is_null() && c.band_of.Run(from_point) != 0;
+  if (c.dart) {
+    d.sweep = G();
+    return d;
+  }
+  d.entry_fe = 0.55 + 0.20 * U();
+  d.sigma = G();
+  d.span = G();
+  d.along = G();
+  d.lat = G();
+  d.side = G();
+  d.sweep = G();
+  d.creep_roll = U();
+  d.creep_lead = G();
+  d.creep_len_a = U();
+  d.creep_len_b = U();
+  d.creep_sweep = G();
+  d.brake = G();
+  for (SubDraft& s : d.subs) {
+    s.sigma = G();
+    s.span = G();
+    s.along = G();
+    s.lat = G();
+    s.stop_roll = U();
+    s.stop = G();
+    s.overlap = U();
+    s.sweep = G();
+    s.gain = U();
+  }
+  for (Wave& wave : d.jitter) {
+    wave.freq = kJitterFreqLo + (kJitterFreqHi - kJitterFreqLo) * U();
+    wave.phase = kTwoPi * U();
+  }
+  d.hesitant = U();
+  d.hes_len = U();
+  d.hes_lead = U();
+  d.sloppy = U();
+  d.curvy = U();
+  d.crisp = U();
+  d.jit_depth = G();
+  return d;
+}
+
+std::optional<HumanPathPlanner::Entry> HumanPathPlanner::EntryOf(
+    const LegConstraints& c,
+    const Geo& geo) {
+  const double vx = c.entry_velocity.x;
+  const double vy = c.entry_velocity.y;
+  if (vx == 0 && vy == 0) {
+    const double v = c.entry_speed / 1000.0;
+    if (v < kEntryMin) {
+      return std::nullopt;
+    }
+    return Entry{geo.ux, geo.uy, v};
+  }
+  const double v = Hyp(vx, vy) / 1000.0;
+  if (v < kEntryMin) {
+    return std::nullopt;
+  }
+  return Entry{vx / 1000.0 / v, vy / 1000.0 / v, v};
+}
+
+std::optional<double> HumanPathPlanner::Room(const LegConstraints& c,
+                                             int side) {
+  const double r = side > 0 ? c.free_plus : c.free_minus;
+  if (r < 0) {
+    return std::nullopt;
+  }
+  return std::max(0.0, r - kCorridorMargin);
+}
+
+double HumanPathPlanner::SagittaCap(double chord, std::optional<double> room) {
+  if (!room.has_value() || chord <= 0) {
+    return 2.0;
+  }
+  return 4.0 * std::atan(2.0 * *room / chord);
+}
+
+// The strokes for the draft, sweeps and lateral misses scaled by f, the
+// brake and the forward misses by g. Deterministic: no draws.
+std::vector<HumanPathPlanner::Stroke> HumanPathPlanner::Build(
+    const Draft& draft,
+    const Geo& geo,
+    const LegConstraints& c,
+    double f,
+    double g) {
+  const browser::HandKinematics& p = persona_.kinematics;
+  const Vec& from = geo.from;
+  const Vec& to = geo.to;
+  const double d = geo.d;
+  const double tempo = geo.tempo;
+  std::vector<Stroke> strokes;
+
+  if (c.dart) {
+    double sigma = 0;
+    double span = 0;
+    if (c.dart_ms > 0) {
+      sigma = p.sigma;
+      span = c.dart_ms;
+    } else {
+      // A nudge: one homing sub-movement.
+      sigma = p.sub_sigma;
+      span = p.sub_ms * tempo;
+    }
+    const double mu = MuForSpan(span, sigma);
+    const int side = draft.sweep >= 0 ? 1 : -1;
+    double dth = draft.sweep * 0.1 * f;
+    dth = std::copysign(std::min(std::abs(dth), SagittaCap(d, Room(c, side))),
+                        dth);
+    strokes.emplace_back(to.x - from.x, to.y - from.y, dth,
+                         OnsetFor(0.0, mu, sigma), mu, sigma, true);
+    return strokes;
+  }
+
+  Vec start = from;
+  double t_primary = 0;
+  const std::optional<Entry> entry = EntryOf(c, geo);
+  const bool hesitant = draft.hesitant < kPHesitant;
+  if (entry.has_value()) {
+    // The carry-in: a stroke already past its peak at t = 0, as fast as the
+    // hand is, its length from the main sequence.
+    const double sigma = p.sigma;
+    const double ze = PhiInv(draft.entry_fe);
+    double tau = p.tau100 * tempo;
+    // A leg that may not pass its end (or leave its drop zone): the bisection
+    // makes the hand brake harder, its speed at t = 0 kept.
+    if (g < 1.0 && (c.hold.has_value() || !c.overshoot || c.keep.has_value())) {
+      tau *= kEntryFitMin + (1.0 - kEntryFitMin) * g;
+    }
+    const double two_sinh = 2 * std::sinh(kZ99 * sigma);
+    const double x = entry->v * sigma * std::exp(sigma * ze) * tau /
+                     (SmallPhi(ze) * two_sinh);
+    const double d0 =
+        std::pow(x / std::pow(100.0, p.beta), 1.0 / (1.0 - p.beta));
+    const double mu0 = std::log(tau * std::pow(d0 / 100.0, p.beta) / two_sinh);
+    const double t0 = -std::exp(mu0 + sigma * ze);
+    strokes.emplace_back(entry->ex * d0, entry->ey * d0, 0.0, t0, mu0, sigma,
+                         false);
+    const double rest = d0 * (1 - draft.entry_fe);
+    start = Vec{from.x + entry->ex * rest, from.y + entry->ey * rest};
+  } else if ((draft.creep_roll < p.creep_p || hesitant) &&
+             !draft.start_in_band) {
+    // The onset creep (a hesitant start's is longer and slower).
+    double lead = p.creep_ms * std::exp(draft.creep_lead * kSdCreep) * tempo;
+    double cd = std::min(
+        25.0, d * (0.01 + 0.02 * draft.creep_len_a) + 2.0 * draft.creep_len_b);
+    if (hesitant) {
+      cd =
+          std::min(kHesMaxPx, d * (kHesLo + (kHesHi - kHesLo) * draft.hes_len));
+      lead *= kHesLeadLo + (kHesLeadHi - kHesLeadLo) * draft.hes_lead;
+    }
+    const double cmu = MuForSpan(2.5 * lead, 0.3);
+    strokes.emplace_back(geo.ux * cd, geo.uy * cd, draft.creep_sweep * 0.4 * f,
+                         OnsetFor(0.0, cmu, 0.3), cmu, 0.3, true);
+    start = Vec{from.x + geo.ux * cd, from.y + geo.uy * cd};
+    t_primary = lead;
+  }
+
+  // The primary.
+  const double sigma1 =
+      Clamp(p.sigma * std::exp(draft.sigma * kSigmaLog), 0.08, 0.40);
+  double span1 = p.tau100 * std::pow(d / 100.0, p.beta) * tempo *
+                 std::exp(draft.span * p.nu);
+  double mu1 = MuForSpan(span1, sigma1);
+  // The miss grows sublinearly with the distance, as people's do; under 100 px
+  // (below the calibrated range) it shrinks with the move.
+  const double r = d / 100.0;
+  double sd = r >= 1.0 ? p.aim_px + p.aim_sd * 100.0 * std::pow(r, kAimExp)
+                       : (p.aim_px + p.aim_sd * 100.0) * r;
+  // A drag (a held button) is careful: no sloppy or curvy style.
+  const bool held = c.button_held;
+  if (draft.sloppy < kPSloppy && !held) {
+    sd *= kSloppyMult;
+  }
+  double e_along = sd * (PhiInv(p.p_over) + draft.along);
+  if (!c.overshoot) {
+    e_along = -std::abs(e_along);
+  } else if (e_along > 0) {
+    e_along *= g;
+  }
+  // Kept inside a region, an undershoot shrinks with f too: one larger
+  // than the move aims behind the hand, and the stroke sets out backward --
+  // out of a menu through its top.
+  if (c.keep.has_value() && e_along < 0) {
+    e_along *= f;
+  }
+  // Never behind kUnderMin of the way, in open space too: small
+  // undershoots nearly as they were, large ones pressed smoothly -- a tanh,
+  // written with std::exp as the reference has it (exp agrees bit for bit).
+  if (e_along < 0) {
+    const double room = (1.0 - kUnderMin) * d;
+    e_along = -room * (1.0 - 2.0 / (std::exp(-2.0 * e_along / room) + 1.0));
+  }
+  const bool curvy = draft.curvy < kPCurvy && !held;
+  double e_lat = sd * p.lat_ratio * draft.lat * f * (curvy ? kCurvyLat : 1.0);
+  if (const std::optional<double> lat_room = Room(c, e_lat > 0 ? 1 : -1)) {
+    e_lat = std::copysign(std::min(std::abs(e_lat), *lat_room), e_lat);
+  }
+  Vec aim{to.x + geo.ux * e_along + geo.nx * e_lat,
+          to.y + geo.uy * e_along + geo.ny * e_lat};
+  bool on_target = Hyp(e_along, e_lat) <= geo.tol || draft.crisp < kPCrisp;
+  if (on_target) {
+    aim = to;
+  }
+  int side = (draft.side * 0.5 + persona_.curvature_bias) >= 0 ? 1 : -1;
+  const double raw_side = side > 0 ? c.free_plus : c.free_minus;
+  const double raw_other = side > 0 ? c.free_minus : c.free_plus;
+  if (raw_side >= 0 && raw_side < kFlipRoom &&
+      (raw_other < 0 || raw_other > raw_side)) {
+    side = -side;
+  }
+  const double c1x = aim.x - start.x;
+  const double c1y = aim.y - start.y;
+  if (entry.has_value()) {
+    // From where the carry-in leaves the hand: a stroke timed for its own
+    // length, not the whole leg's.
+    const double d1 = std::max(Hyp(c1x, c1y), 1.0);
+    span1 = p.tau100 * std::pow(d1 / 100.0, p.beta) * tempo *
+            std::exp(draft.span * p.nu);
+    mu1 = MuForSpan(span1, sigma1);
+  }
+  double mag = std::min(2.0, std::abs(p.arc + draft.sweep * kSdSweep * p.arc) *
+                                 std::pow(d / 500.0, -kArcExp) *
+                                 (curvy ? kCurvySweep : 1.0));
+  mag *= DirectionMultiplier(kDirectionCurvature, geo.theta) * f;
+  mag = std::min(mag, SagittaCap(Hyp(c1x, c1y), Room(c, side)));
+  const double dth1 = side * mag;
+  const double k = std::max(0.0, p.brake + draft.brake * kSdBrake) * g;
+  const double t0 = OnsetFor(t_primary, mu1, sigma1);
+  strokes.emplace_back((1 + k) * c1x, (1 + k) * c1y, dth1, t0, mu1, sigma1,
+                       true);
+  // The homing starts off the primary's agonist, not its brake.
+  size_t prev = strokes.size() - 1;
+  if (k > 0) {
+    strokes.emplace_back(-k * c1x, -k * c1y, -dth1, t0, mu1 + p.brake_dmu,
+                         0.8 * sigma1, true);
+  }
+  Vec land = aim;
+
+  // Homing: sub-movements, each a share of what is still missing.
+  for (size_t i = 0; i < kSubsMax; ++i) {
+    if (on_target) {
+      break;
+    }
+    const SubDraft& s = draft.subs[i];
+    const double mx = to.x - land.x;
+    const double my = to.y - land.y;
+    const double m = Hyp(mx, my);
+    const double gain = p.gain_lo + (p.gain_hi - p.gain_lo) * s.gain;
+    const double csd = p.aim_sd * p.c_gain * m;
+    double ca = m * (gain - 1.0) + csd * s.along;
+    if (!c.overshoot) {
+      ca = -std::abs(ca);
+    } else if (ca > 0) {
+      ca *= g;
+    }
+    const double cl = csd * p.lat_ratio * s.lat * f;
+    Vec next{to.x + (mx * ca - my * cl) / m, to.y + (my * ca + mx * cl) / m};
+    on_target = Hyp(ca, cl) <= geo.tol || i == kSubsMax - 1;
+    if (on_target) {
+      next = to;
+    }
+    const double sk = Clamp(p.sub_sigma + s.sigma * 0.03, 0.08, 0.30);
+    const double size = Hyp(next.x - land.x, next.y - land.y);
+    // At least the primary's law for its size: a big correction is no
+    // dash.
+    const double span =
+        std::max(
+            Clamp(p.sub_ms * std::pow(std::max(size, 1.0) / 30.0, kSubBeta),
+                  kSubMinMs, kSubMaxMs),
+            p.tau100 * std::pow(std::max(size, 1.0) / 100.0, p.beta)) *
+        tempo * std::exp(s.span * kSdSubSpan);
+    const double cmu = MuForSpan(span, sk);
+    double ton = 0;
+    if (s.stop_roll < p.stop_p) {
+      const double stop = p.stop_ms * std::exp(s.stop * kSdStop) * tempo;
+      ton = strokes[prev].TAt(0.98) + stop;
+    } else if (i == 0) {
+      ton = strokes[prev].TAt(p.q_lo + (p.q_hi - p.q_lo) * s.overlap);
+    } else {
+      ton =
+          strokes[prev].TAt(p.sub_q_lo + (p.sub_q_hi - p.sub_q_lo) * s.overlap);
+    }
+    strokes.emplace_back(next.x - land.x, next.y - land.y,
+                         s.sweep * p.arc_c * f, OnsetFor(ton, cmu, sk), cmu, sk,
+                         true);
+    prev = strokes.size() - 1;
+    land = next;
+  }
+  return strokes;
+}
+
+// Positions every kDenseMs from t = 0 to the first sample at which every
+// stroke is done and the pointer is within half a pixel of `to` (8 s at
+// most); the last is `to`.
+std::vector<HumanPathPlanner::Vec> HumanPathPlanner::Dense(
+    const std::vector<Stroke>& strokes,
+    const Geo& geo) {
+  std::vector<Vec> out;
+  for (size_t n = 0;; ++n) {
+    const double t = n * kDenseMs;
+    double x = geo.from.x;
+    double y = geo.from.y;
+    bool done = true;
+    for (const Stroke& s : strokes) {
+      const Vec q = s.Disp(t);
+      x += q.x - s.at0.x;
+      y += q.y - s.at0.y;
+      if (done && s.F(t) < kEndF) {
+        done = false;
+      }
+    }
+    out.push_back(Vec{x, y});
+    if ((done && Hyp(x - geo.to.x, y - geo.to.y) < kEndPx) || t >= kMaxLegMs) {
+      break;
+    }
+  }
+  out.back() = geo.to;
+  return out;
+}
+
+bool HumanPathPlanner::FitsCorridor(const std::vector<Vec>& dense,
+                                    const Geo& geo,
+                                    const LegConstraints& c) {
+  double hi = -std::numeric_limits<double>::infinity();
+  double lo = std::numeric_limits<double>::infinity();
+  for (const Vec& q : dense) {
+    const double s = (q.x - geo.from.x) * geo.nx + (q.y - geo.from.y) * geo.ny;
+    hi = std::max(hi, s);
+    lo = std::min(lo, s);
+  }
+  if (c.free_plus >= 0 && hi > c.free_plus - kCorridorMargin + 1e-9) {
+    return false;
+  }
+  if (c.free_minus >= 0 && -lo > c.free_minus - kCorridorMargin + 1e-9) {
+    return false;
+  }
+  return true;
+}
+
+bool HumanPathPlanner::FitsHold(const std::vector<Vec>& dense,
+                                const Geo& geo,
+                                const LegConstraints& c) {
+  if (!c.overshoot) {
+    for (const Vec& q : dense) {
+      if ((q.x - geo.from.x) * geo.ux + (q.y - geo.from.y) * geo.uy >
+          geo.d + kOvershootPx) {
+        return false;
+      }
+    }
+  }
+  if (c.hold.has_value()) {
+    const PlannerRect& r = *c.hold;
+    bool inside = false;
+    for (const Vec& q : dense) {
+      const bool in = r.x - kHoldEps <= q.x && q.x <= r.x + r.w + kHoldEps &&
+                      r.y - kHoldEps <= q.y && q.y <= r.y + r.h + kHoldEps;
+      // Past the end and not over the drop zone.
+      if (!in && (q.x - geo.from.x) * geo.ux + (q.y - geo.from.y) * geo.uy >
+                     geo.d + kHoldEps) {
+        return false;
+      }
+      if (in) {
+        inside = true;
+      } else if (inside) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// Every sample inside the region the leg is kept in, kCorridorMargin in
+// from each edge -- less on a side where an end of the leg lies nearer, as a
+// hand resting by a menu's edge does: the chord between the ends always fits.
+bool HumanPathPlanner::FitsKeep(const std::vector<Vec>& dense,
+                                const Geo& geo,
+                                const LegConstraints& c) {
+  if (!c.keep.has_value()) {
+    return true;
+  }
+  const PlannerRect& r = *c.keep;
+  const auto margin = [](double from, double to) {
+    return std::clamp(std::min(from, to), 0.0, kCorridorMargin);
+  };
+  const double left = r.x + margin(geo.from.x - r.x, geo.to.x - r.x);
+  const double right =
+      r.x + r.w - margin(r.x + r.w - geo.from.x, r.x + r.w - geo.to.x);
+  const double top = r.y + margin(geo.from.y - r.y, geo.to.y - r.y);
+  const double bottom =
+      r.y + r.h - margin(r.y + r.h - geo.from.y, r.y + r.h - geo.to.y);
+  for (const Vec& q : dense) {
+    if (q.x < left - kHoldEps || q.x > right + kHoldEps ||
+        q.y < top - kHoldEps || q.y > bottom + kHoldEps) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The real time of each dense sample: the speed jitter, the band budget, the
+// stop, the speed cap. s[i] is the speed factor of the step from sample i to
+// sample i + 1; its time is kDenseMs / s[i].
+std::vector<double> HumanPathPlanner::Timing(const std::vector<Vec>& dense,
+                                             const Draft& draft,
+                                             const Geo& geo,
+                                             const LegConstraints& c) {
+  const size_t n = dense.size();
+  if (n < 2) {
+    return std::vector<double>(n, 0.0);
+  }
+  const double u_end = (n - 1) * kDenseMs;
+  std::vector<double> step(n - 1);
+  for (size_t i = 0; i + 1 < n; ++i) {
+    step[i] = Hyp(dense[i + 1].x - dense[i].x, dense[i + 1].y - dense[i].y) /
+              kDenseMs;
+  }
+  std::vector<double> s(n - 1, 1.0);
+
+  // The speed jitter, normalised so the leg keeps its length; none for a
+  // dart.
+  if (!c.dart) {
+    const double a = std::min(
+        persona_.kinematics.jitter * std::exp(draft.jit_depth * kJitterDepthSd),
+        kJitterDepthMax);
+    for (size_t i = 0; i + 1 < n; ++i) {
+      const double um = (i + 0.5) * kDenseMs;
+      double fade = 1.0;
+      if (um < kJitterFadeMs) {
+        fade = 0.5 * (1 - std::cos(std::numbers::pi * um / kJitterFadeMs));
+      } else if (u_end - um < kJitterFadeMs) {
+        fade = 0.5 *
+               (1 - std::cos(std::numbers::pi * (u_end - um) / kJitterFadeMs));
+      }
+      double wave = 0.0;
+      for (const Wave& w : draft.jitter) {
+        wave += std::sin(kTwoPi * w.freq * um / 1000.0 + w.phase);
+      }
+      s[i] = std::max(kMinRate, 1.0 + a * fade * wave * kJitterNorm);
+    }
+    double total = 0.0;
+    for (double x : s) {
+      total += kDenseMs / x;
+    }
+    const double kappa = total / u_end;
+    for (double& x : s) {
+      x *= kappa;
+    }
+  }
+
+  // The band budget: each run over it crossed faster by a smooth warp
+  // (raised-cosine ramps either side), no faster than max_speed.
+  if (!c.band_of.is_null()) {
+    std::vector<int> bands(n);
+    for (size_t i = 0; i < n; ++i) {
+      bands[i] = BandAt(c, dense[i]);
+    }
+    const size_t gap =
+        std::max(static_cast<size_t>(1),
+                 static_cast<size_t>(1000.0 / polling_rate_hz() / kDenseMs));
+    const double vmax = c.max_speed > 0
+                            ? c.max_speed / 1000.0
+                            : std::numeric_limits<double>::infinity();
+    const double budget = std::max(0.0, c.band_budget_ms);
+    std::vector<double> warp(n - 1, 1.0);
+    for (const Run& run : DenseRuns(bands, gap)) {
+      const size_t end = run.has_exit ? run.last + 1 : run.last;
+      if (end <= run.first) {
+        continue;
+      }
+      double run_time = 0.0;
+      for (size_t i = run.first; i < end; ++i) {
+        run_time += kDenseMs / s[i];
+      }
+      if (budget <= 0 || run_time <= budget) {
+        continue;
+      }
+      double cc = run_time / budget;
+      for (size_t i = run.first; i < end; ++i) {
+        if (step[i] > 0) {
+          cc = std::min(cc, vmax / (step[i] * s[i]));
+        }
+      }
+      if (cc <= 1.0) {
+        continue;
+      }
+      const double u0 = run.first * kDenseMs;
+      const double u1 = end * kDenseMs;
+      for (size_t i = 0; i + 1 < n; ++i) {
+        const double um = (i + 0.5) * kDenseMs;
+        double w = 0;
+        if (u0 <= um && um <= u1) {
+          w = 1.0;
+        } else if (u0 - kRampMs < um && um < u0) {
+          w = 0.5 * (1 - std::cos(std::numbers::pi * (um - (u0 - kRampMs)) /
+                                  kRampMs));
+        } else if (u1 < um && um < u1 + kRampMs) {
+          w = 0.5 * (1 - std::cos(std::numbers::pi * ((u1 + kRampMs) - um) /
+                                  kRampMs));
+        } else {
+          continue;
+        }
+        warp[i] = std::max(warp[i], 1.0 + (cc - 1.0) * w);
+      }
+    }
+    for (size_t i = 0; i + 1 < n; ++i) {
+      s[i] *= warp[i];
+    }
+  }
+
+  // The stop: within its radius of the end for good, the hand is there.
+  const double radius = (!c.dart && draft.crisp < kPCrisp)
+                            ? kCrispStopPx
+                            : persona_.kinematics.stop_px;
+  size_t enter = n - 1;
+  while (enter > 0 && Hyp(dense[enter - 1].x - geo.to.x,
+                          dense[enter - 1].y - geo.to.y) <= radius) {
+    --enter;
+  }
+  for (size_t i = enter; i + 1 < n; ++i) {
+    s[i] = kStopped;
+  }
+
+  // The speed cap.
+  if (c.max_speed > 0) {
+    const double vmax = c.max_speed / 1000.0;
+    for (size_t i = 0; i + 1 < n; ++i) {
+      if (step[i] * s[i] > vmax) {
+        s[i] = vmax / step[i];
+      }
+    }
+  }
+
+  std::vector<double> times(n, 0.0);
+  for (size_t i = 0; i + 1 < n; ++i) {
+    times[i + 1] = times[i] + kDenseMs / s[i];
+  }
+  return times;
+}
+
+// The dense curve on the polling grid: the position at each tick, the last
+// tick at the curve's end.
+std::vector<HumanPathPlanner::Vec> HumanPathPlanner::Sample(
+    const std::vector<Vec>& dense,
+    const std::vector<double>& times,
+    double tick_ms) {
+  const double end = times.back();
+  const size_t ticks =
+      std::max(static_cast<size_t>(1),
+               static_cast<size_t>(std::ceil(end / tick_ms - 1e-9)));
+  std::vector<Vec> out;
+  out.reserve(ticks + 1);
+  size_t j = 0;
+  for (size_t k = 0; k <= ticks; ++k) {
+    const double t = k * tick_ms;
+    if (k == ticks || t >= end) {
+      out.push_back(dense.back());
+      continue;
+    }
+    while (j + 2 < times.size() && times[j + 1] <= t) {
+      ++j;
+    }
+    const double span = times[j + 1] - times[j];
+    const double fr = span > 0 ? Clamp((t - times[j]) / span, 0.0, 1.0) : 0.0;
+    const Vec& a = dense[j];
+    const Vec& b = dense[j + 1];
+    out.push_back(Vec{a.x + (b.x - a.x) * fr, a.y + (b.y - a.y) * fr});
+  }
+  return out;
+}
+
+// The tremor: a per-movement origin along the hand's tremor (one draw), then
+// each tick's offset at its time and the planned speed there.
+std::vector<HumanPathPlanner::Vec> HumanPathPlanner::ApplyTremor(
+    const std::vector<Vec>& samples,
+    bool skip_last) {
+  const int rate = polling_rate_hz();
+  const double tick_sec = 1.0 / rate;
+  const double origin_sec = U() * kTremorOriginRangeSec;
+  std::vector<Vec> out;
+  out.reserve(samples.size());
+  for (size_t i = 0; i < samples.size(); ++i) {
+    if (skip_last && i + 1 == samples.size()) {
+      out.push_back(samples[i]);
+      continue;
+    }
+    const double v = i > 0 ? Hyp(samples[i].x - samples[i - 1].x,
+                                 samples[i].y - samples[i - 1].y) *
+                                 rate
+                           : 0.0;
+    const Vec o = TremorOffset(origin_sec + i * tick_sec, v);
+    out.push_back(Vec{samples[i].x + o.x, samples[i].y + o.y});
+  }
+  return out;
+}
+
+// Three harmonics per axis and broadband noise, scaled down with speed as
+// the persona's tremor is, and faded in from rest: a mouse at rest does not
+// move.
+HumanPathPlanner::Vec HumanPathPlanner::TremorOffset(double time_sec,
+                                                     double velocity) {
+  double scale = std::max(kTremorMinAmplitudeScale,
+                          1.0 - (1.0 - kTremorMinAmplitudeScale) * velocity /
+                                    kTremorReferenceVelocity);
+  scale *= std::min(1.0, velocity / kTremorOn);
+  const browser::TremorHarmonics& hx = persona_.tremor_x;
+  const browser::TremorHarmonics& hy = persona_.tremor_y;
+  double x = 0.0;
+  for (size_t i = 0; i < hx.amp.size(); ++i) {
+    x += hx.amp[i] * std::sin(kTwoPi * hx.freq[i] * time_sec + hx.phase[i]);
+  }
+  double y = 0.0;
+  for (size_t i = 0; i < hy.amp.size(); ++i) {
+    y += hy.amp[i] * std::sin(kTwoPi * hy.freq[i] * time_sec + hy.phase[i]);
+  }
+  x = x * scale + NoiseG() * persona_.tremor_broadband_scale * scale;
+  y = y * scale + NoiseG() * persona_.tremor_broadband_scale * scale;
+  return Vec{x, y};
+}
+
+// The band budget on the grid, over the positions the page will see (the
+// tremor applied, the last sample exact): a run whose intervals take longer
+// than the budget loses interior samples, from its start on, while the gap
+// each drop merges stays within a tick at max_speed. Nothing moves a point
+// after this.
+void HumanPathPlanner::TrimRunsOnGrid(std::vector<Vec>* samples,
+                                      const LegConstraints& c,
+                                      double tick_ms) {
+  if (c.band_of.is_null() || samples->size() < 3 || tick_ms <= 0) {
+    return;
+  }
+  const size_t m = samples->size();
+  std::vector<int> bands(m);
+  for (size_t i = 0; i < m; ++i) {
+    bands[i] = BandAt(c, (*samples)[i]);
+  }
+  const std::vector<Run> runs = FindRuns(bands);
+  if (runs.empty()) {
+    return;
+  }
+  const double budget = std::max(0.0, c.band_budget_ms);
+  const size_t max_intervals =
+      static_cast<size_t>(std::floor(budget / tick_ms + 1e-9));
+  const double tick_px = c.max_speed > 0 ? c.max_speed * tick_ms / 1000.0 : 0;
+  std::vector<bool> drop(m, false);
+  for (const Run& run : runs) {
+    const size_t span_end = run.has_exit ? run.last + 1 : m - 1;
+    const size_t intervals = span_end - run.first;
+    if (intervals <= max_intervals) {
+      continue;
+    }
+    const size_t remove = std::min(intervals - max_intervals, intervals - 1);
+    size_t previous_kept = run.first;
+    size_t dropped = 0;
+    for (size_t i = run.first + 1; i < span_end && dropped < remove; ++i) {
+      const Vec& a = (*samples)[previous_kept];
+      const Vec& b = (*samples)[i + 1];
+      if (tick_px <= 0 || Hyp(b.x - a.x, b.y - a.y) <= tick_px + 1e-9) {
+        drop[i] = true;
+        ++dropped;
+      } else {
+        previous_kept = i;
+      }
+    }
+  }
+  std::vector<Vec> kept;
+  kept.reserve(m);
+  for (size_t i = 0; i < m; ++i) {
+    if (!drop[i]) {
+      kept.push_back((*samples)[i]);
+    }
+  }
+  samples->swap(kept);
+}
+
+// Maximal runs of one band id on the grid, single out-of-band samples inside
+// a run absorbed.
+std::vector<HumanPathPlanner::Run> HumanPathPlanner::FindRuns(
+    const std::vector<int>& bands) {
+  std::vector<Run> runs;
+  const size_t n = bands.size();
+  size_t i = 0;
+  while (i < n) {
+    if (bands[i] == 0) {
+      ++i;
+      continue;
+    }
+    const int id = bands[i];
+    Run run;
+    run.first = i;
+    run.last = i;
+    size_t j = i + 1;
+    while (j < n) {
+      if (bands[j] == id) {
+        run.last = j;
+        ++j;
+      } else if (bands[j] == 0 && j + 1 < n && bands[j + 1] == id) {
+        ++j;
+      } else {
+        break;
+      }
+    }
+    run.has_exit = run.last + 1 < n;
+    runs.push_back(run);
+    i = run.last + 1;
+  }
+  return runs;
+}
+
+// Maximal runs of one band id on the dense curve, out-of-band gaps shorter
+// than `gap` samples absorbed.
+std::vector<HumanPathPlanner::Run> HumanPathPlanner::DenseRuns(
+    const std::vector<int>& bands,
+    size_t gap) {
+  std::vector<Run> runs;
+  const size_t n = bands.size();
+  size_t i = 0;
+  while (i < n) {
+    if (bands[i] == 0) {
+      ++i;
+      continue;
+    }
+    const int id = bands[i];
+    Run run;
+    run.first = i;
+    run.last = i;
+    size_t j = i + 1;
+    while (j < n) {
+      if (bands[j] == id) {
+        run.last = j;
+        ++j;
+        continue;
+      }
+      size_t k = j;
+      while (k < n && bands[k] == 0 && k - j < gap) {
+        ++k;
+      }
+      if (k < n && bands[k] == id && k - j < gap) {
+        j = k;
+        continue;
+      }
+      break;
+    }
+    run.has_exit = run.last + 1 < n;
+    runs.push_back(run);
+    i = run.last + 1;
+  }
+  return runs;
+}
+
+int HumanPathPlanner::BandAt(const LegConstraints& c, const Vec& p) {
+  return c.band_of.is_null() ? 0 : c.band_of.Run(ToPoint(p.x, p.y));
+}
