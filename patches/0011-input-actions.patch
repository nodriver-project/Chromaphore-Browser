+    seed_value = browser::PersonaSeed();
+  }
+
+  const browser::MovementPersona persona =
+      browser::MovementPersona::FromSeed(seed_value);
+
+  *seed_used = base::NumberToString(persona.seed);
+  *speed_factor = persona.speed_factor;
+  *curvature_bias = persona.curvature_bias;
+  *tremor_amplitude = persona.tremor_amplitude;
+  *tremor_frequency_center = persona.tremor_frequency_center;
+  *click_offset_bias_x = persona.click_offset_bias_x;
