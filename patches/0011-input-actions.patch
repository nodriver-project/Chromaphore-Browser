+// browser: one tremor axis's harmonics as Input.probeMovementPersona reports
+// them: the three frequencies, then the three amplitudes, then the three
+// phases, each as the persona holds it.
+std::unique_ptr<Array<double>> TremorHarmonicsArray(
+    const browser::TremorHarmonics& axis) {
+  auto values = std::make_unique<Array<double>>();
+  values->reserve(axis.freq.size() + axis.amp.size() + axis.phase.size());
+  for (double frequency : axis.freq) {
+    values->push_back(frequency);
+  }
+  for (double amplitude : axis.amp) {
+    values->push_back(amplitude);
+  }
+  for (double phase : axis.phase) {
+    values->push_back(phase);
+  }
+  return values;
+}
