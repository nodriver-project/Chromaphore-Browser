+// An element's text in quotes, or `fallback` when it has none.
+std::string Quoted(const std::string& text, const std::string& fallback) {
+  return text.empty() ? fallback : "\"" + text + "\"";
+}
+
+// A side of a box, in words (1 top, 2 bottom, 3 left, 4 right).
+std::string SideWord(int side) {
+  switch (side) {
+    case 1:
+      return "top";
+    case 2:
+      return "bottom";
+    case 3:
+      return "left";
+    default:
+      return "right";
+  }
+}
