@@ -0,0 +1,264 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The terrain a drag crosses, as Input.performDrag's survey reads it from the
+// renderer, and the geometry the drag is planned with: which autoscroll band
+// a point is in, as Blink's walk (native drags) or a pointer library
+// (pointer drags) would see it; whether a point is calm; the nearest calm
+// point; the free room beside a chord; a leg's constraints for the planner.
+// Pure: no DevTools, no mojo, no clock. Everything is in the root view's
+// DIPs.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_DRAG_ROUTE_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_DRAG_ROUTE_H_
+
+#include <stddef.h>
+
+#include <cmath>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "content/browser/devtools/protocol/human_path_planner.h"
+
+namespace content {
+
+// An axis-aligned rectangle. Containment is half-open: x <= p.x < x + w.
+struct DragRect {
+  double x = 0;
+  double y = 0;
+  double w = 0;
+  double h = 0;
+
+  bool IsEmpty() const;
+  bool Contains(const PlannerPoint& p) const;
+  double right() const { return x + w; }
+  double bottom() const { return y + h; }
+  // Shrunk by dx on the left and right and dy at the top and bottom; empty
+  // (w or h 0) when nothing is left.
+  DragRect Inset(double dx, double dy) const;
+  DragRect Intersect(const DragRect& other) const;
+};
+
+// How far apart two points are.
+inline double Distance(const PlannerPoint& a, const PlannerPoint& b) {
+  return std::hypot(b.x - a.x, b.y - a.y);
+}
+
+// What kind of drag the terrain is read for: a native drag autoscrolls in
+// Blink's 20 px bands of the box under the pointer; a pointer library
+// scrolls from its own, wider zones of every scrolling ancestor.
+enum class DragMode { kNative, kPointer };
+
+// One box a held drag's autoscroll can pick (AgentBandBox, in root DIPs).
+struct DragBand {
+  int id = 0;      // its DOMNodeId, stable across surveys
+  int parent = 0;  // the nearest band box holding it, 0 none
+  int fixed = 0;   // the fixed-to-view box it lies inside, 0 none
+  std::string name;
+  bool is_document = false;
+  DragRect border;     // scrollbars included
+  DragRect outer;      // less classic scrollbars
+  DragRect inner;      // outer inset Blink's 20 physical px
+  DragRect visible;    // border, clipped by ancestors and the viewport
+  DragRect lib_inner;  // outer inset max(30 px, 25 % of the visible length)
+  bool up = false;
+  bool down = false;
+  bool left = false;
+  bool right = false;
+  bool wheel_blocked = false;
+  double scroll_x = 0;
+  double scroll_y = 0;
+};
+
+// A fixed-to-view box: no band of a box outside it reaches a point under it.
+struct DragFixedBox {
+  int id = 0;
+  std::string name;
+  DragRect box;
+};
+
+class DragTerrain {
+ public:
+  DragTerrain(DragMode mode,
+              DragRect viewport,
+              std::vector<DragBand> bands,
+              std::vector<DragFixedBox> fixed_boxes);
+  DragTerrain(const DragTerrain&);
+  DragTerrain(DragTerrain&&) noexcept;
+  DragTerrain& operator=(const DragTerrain&);
+  DragTerrain& operator=(DragTerrain&&) noexcept;
+  ~DragTerrain();
+
+  DragMode mode() const { return mode_; }
+  const DragRect& viewport() const { return viewport_; }
+  const std::vector<DragBand>& bands() const { return bands_; }
+  const std::vector<DragFixedBox>& fixed_boxes() const { return fixed_; }
+  const DragBand* Find(int id) const;
+
+  // The band boxes that hold the dragged element, innermost first: in
+  // pointer mode their zones reach past their edges (see BandAt). The main
+  // document's box (is_document, no parent) always counts as one of them.
+  // Empty until set.
+  void SetGrabChain(std::vector<int> ids);
+
+  // The box the wheel scrolls in the current carry stage, 0 for none: in
+  // pointer mode its library zones count on both ends of an axis it scrolls
+  // on, as its other end comes alive while it moves.
+  void SetBinder(int id);
+
+  // The box a native drag's autoscroll picks at p, as Blink's walk does from
+  // the element under the pointer: the innermost band box whose `visible`
+  // holds p (innermost: no other such box has it as an ancestor through
+  // `parent`), unless a fixed box holds p and that band box is not inside it
+  // (then none, or the innermost band box inside that fixed box). A fixed
+  // box that is itself a band box (a fixed scroller, say a modal with
+  // overflow:auto) keeps its bands under its own cover. 0: none.
+  int OwnerAt(const PlannerPoint& p) const;
+
+  // The band p is in, 0 for none. Native: OwnerAt(p)'s id when p is in its
+  // border but not its inner. Pointer: the innermost of the band boxes
+  // whose visible holds p, and of the grab chain's boxes (SetGrabChain; the
+  // main document always) whose visible does not, that p lies beyond
+  // lib_inner of on a side the box can scroll toward now: above lib_inner
+  // with `up`, below it with `down`, left of it with `left`, right of it
+  // with `right` (a library scrolls a container only toward a side it can
+  // still scroll to; past a grab chain box its zone runs on as half-planes,
+  // as such a library has no "inside the rect" test). The binder
+  // (SetBinder) counts both ends of an axis it scrolls on. Fixed covers do
+  // not count in pointer mode.
+  int BandAt(const PlannerPoint& p) const;
+
+  // The band p is in, or lies within kBudgetMargin of (along either axis or
+  // diagonally): what a band run's budget and the dwell guard count, so a
+  // hand skimming just outside a band's edge -- its pixel held on the band
+  // side of it -- is timed as in it. 0: none. Calm keeps its own clearance.
+  static constexpr double kBudgetMargin = 1.5;
+  int BudgetBandAt(const PlannerPoint& p) const;
+  // As BudgetBandAt, within `margin` px (none when it is not above 0): a
+  // leg's runs measured wider than the planner budgets them.
+  int BandWithin(const PlannerPoint& p, double margin) const;
+
+  // The clearance a calm point keeps (Calm's default), and how far inside
+  // the viewport every calm point, every leg and every release keeps.
+  static constexpr double kClearance = 3;
+  static constexpr double kViewMargin = 2;
+
+  // In no band, at least `clearance` px from every band edge and every
+  // scrollbar (border less outer), and at least kViewMargin px inside the
+  // viewport. With `item_offset` (pointer drags): the dragged item's centre,
+  // at p + item_offset, must be in no band either. A non-finite item_offset
+  // reads as none, here, in NearestCalm and in Constraints.
+  bool Calm(const PlannerPoint& p,
+            double clearance = kClearance,
+            PlannerPoint item_offset = {}) const;
+
+  // The calm point nearest p, no farther than max_distance, or nullopt:
+  // searched on rings of candidates around p (1 px steps near p, coarser
+  // farther out), deterministic. max_distance is held to [0, 400] (NaN: 0)
+  // so the search stays bounded.
+  std::optional<PlannerPoint> NearestCalm(const PlannerPoint& p,
+                                          double max_distance = 200,
+                                          PlannerPoint item_offset = {}) const;
+
+  // The free room either side of a chord, as LegConstraints has it.
+  struct CorridorRoom {
+    double free_plus = 0;
+    double free_minus = 0;
+  };
+  // The free room on the +perp and -perp sides of the chord from -> to
+  // (perp = (dy, -dx) / |d|, as LegConstraints has it): the least distance,
+  // sampled every 4 px along the chord, from the chord to the nearest band
+  // edge, scrollbar or viewport edge the chord does not itself cross, capped
+  // at 400. Bands count per side: a chord through a box's left band leaves
+  // its top band a wall. A degenerate chord (< 1 px) gets -1, -1
+  // (unbounded); a chord with a sample outside the viewport, or a
+  // non-finite one, gets 0, 0.
+  CorridorRoom Corridor(const PlannerPoint& from, const PlannerPoint& to) const;
+
+  // A leg's constraints over this terrain: band_of bound to a copy of the
+  // terrain (BudgetBandAt, and for pointer drags BudgetBandAt(p +
+  // item_offset) when p itself is clear of every band), the corridor, the
+  // budget.
+  LegConstraints Constraints(const PlannerPoint& from,
+                             const PlannerPoint& to,
+                             double band_budget_ms,
+                             PlannerPoint item_offset = {}) const;
+
+ private:
+  DragMode mode_;
+  DragRect viewport_;
+  std::vector<DragBand> bands_;
+  std::vector<DragFixedBox> fixed_;
+  // Each band box's parent as an index into bands_ (SIZE_MAX: none, or a
+  // box the survey did not list), built once by the constructor.
+  std::vector<size_t> parents_;
+  std::vector<int> grab_chain_;
+  int binder_ = 0;
+};
+
+// A leg held to `view` (2 px in): its bow either side of the chord no
+// farther than the view's edge -- but at least the planner's corridor margin
+// (5 px) a side, with less than which it plans the leg dead straight -- and,
+// with no hold region of its own and its end in the view, the view as its
+// hold region, so what runs past its end stays in it too: a cursor stops at
+// the screen's edge. Room `c` already gives only shrinks. A chord
+// under 1 px, or an empty view, changes nothing. Input.performDrag's legs
+// and Input.moveTo's are held so.
+void BoundLegToView(const PlannerPoint& from,
+                    const PlannerPoint& to,
+                    const DragRect& view,
+                    LegConstraints* c);
+
+// A leg kept inside a hover region: its bow either side of the chord
+// held to the room the region leaves at the chord's ends, as BoundLegToView
+// holds it to the view's, and the region as its hold and its keep: nothing of
+// it, past its end or anywhere else, leaves the region. Both ends must be in
+// the region; a chord under 1 px or an empty region changes nothing.
+void BoundLegToRegion(const PlannerPoint& from,
+                      const PlannerPoint& to,
+                      const PlannerRect& region,
+                      LegConstraints* c);
+
+// A point of a rounded route: where, the route's length up to it, and its
+// curvature there (0 on a straight stretch, 1/r on an arc).
+struct RouteSample {
+  PlannerPoint p;
+  double s = 0;
+  double curvature = 0;
+};
+
+// The polyline `points` with each inner corner rounded by a circular arc of
+// radius radii[i] -- held to what the stretches either side allow, 45 % of
+// each at most -- sampled every px or finer.
+std::vector<RouteSample> RoundedRoute(const std::vector<PlannerPoint>& points,
+                                      const std::vector<double>& radii);
+
+// A drag's route stroke smooths its pace over this much route either
+// side, and is never slower than this share of it.
+inline constexpr double kRouteSmoothPx = 20;
+inline constexpr double kRouteMinPace = 0.55;
+
+// A route travelled as one movement (a turn into a submenu):
+// `plain`, the hand's own leg planned from `origin` along `dir` for the
+// route's length (no bow), laid along `route` -- how far along the chord each
+// point is, as far along the route; an overshoot past either end on along the
+// route's heading there; its sideways wander off the chord, off the route --
+// slowed where the route curves by the two-thirds power law (pace ~
+// curvature^-1/3, held to `min_pace`-1, smoothed over `smooth_px` of route
+// either side: kRouteSmoothPx and kRouteMinPace for a drag), then laid back
+// on the polling grid every `tick_ms`, the last tick at `to`. Bands are left
+// 0, for the caller. Empty for a route of under two samples, or no plain leg.
+std::vector<PlannedPoint> LayAlongRoute(const std::vector<RouteSample>& route,
+                                        const std::vector<PlannedPoint>& plain,
+                                        const PlannerPoint& origin,
+                                        const PlannerPoint& dir,
+                                        const PlannerPoint& to,
+                                        double tick_ms,
+                                        double smooth_px,
+                                        double min_pace);
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_DRAG_ROUTE_H_
