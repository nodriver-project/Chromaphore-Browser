+// browser: Input.chooseFiles: checked, then carried out by a
+// FileSession, which answers once through AnswerChooseFiles.
+void InputHandler::ChooseFiles(int backend_node_id,
+                               const std::string& frame_id,
+                               std::unique_ptr<Array<std::string>> files,
+                               std::optional<std::string> intent,
+                               std::optional<double> speed_multiplier,
+                               std::optional<double> timeout_ms,
+                               std::optional<double> pointer_x,
+                               std::optional<double> pointer_y,
+                               std::optional<bool> follow_navigation,
+                               std::unique_ptr<ChooseFilesCallback> callback) {
+  FileSession::Completion completion = AnswerChooseFiles(std::move(callback));
+  // Other pointer input: a reveal, a drag, a move, a scroll, a select, a
+  // fill, a pick and a choice under way end first.
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  InterruptAllSessions();
+  // As DOM.setFileInputFiles: a client without file access chooses none.
+  if (!allow_file_access_) {
+    FailFile(std::move(completion), Response::ServerError("Not allowed"));
+    return;
+  }
+  if (std::optional<Response> refusal = CheckActionCall(
+          "Input.chooseFiles", /*refuse_held_drag=*/true,
+          {&speed_multiplier, &timeout_ms, &pointer_x, &pointer_y})) {
+    FailFile(std::move(completion), *refusal);
+    return;
+  }
+  if (backend_node_id <= 0 || frame_id.empty()) {
+    FailFile(std::move(completion),
+             Response::InvalidParams("'backendNodeId' and 'frameId' must name "
+                                     "what opens the chooser"));
+    return;
+  }
+  if (!files || files->empty()) {
+    FailFile(std::move(completion),
+             Response::InvalidParams("'files' must give at least one path"));
+    return;
+  }
+  FileSession::Params params;
+  for (const std::string& file : *files) {
+    base::FilePath path = base::FilePath::FromUTF8Unsafe(file);
+    if (file.empty() || !path.IsAbsolute()) {
+      FailFile(std::move(completion),
+               Response::InvalidParams("every path in 'files' must be "
+                                       "absolute"));
+      return;
+    }
+    if (std::ranges::contains(params.given, file)) {
+      // A person's dialog picks each file once.
+      FailFile(std::move(completion),
+               Response::InvalidParams("'files' names a path twice"));
+      return;
+    }
+    params.given.push_back(file);
+    params.paths.push_back(std::move(path));
+  }
+  if (!ParsePathIntent(intent.value_or("default"))) {
+    FailFile(std::move(completion), BadIntent());
+    return;
+  }
+  if (std::optional<Response> refusal =
+          CheckSpeedMultiplier(speed_multiplier)) {
+    FailFile(std::move(completion), *refusal);
+    return;
+  }
+  params.node_id = backend_node_id;
+  params.frame_id = frame_id;
+  params.intent = std::move(intent);
+  params.speed_multiplier = speed_multiplier.value_or(1);
+  params.timeout = base::Milliseconds(
+      ClampTimeout(timeout_ms, kLongActionTimeoutMs, kLongActionTimeoutMaxMs));
+  params.pointer_x = pointer_x;
+  params.pointer_y = pointer_y;
+  params.css_scale = CssScaleOrOne();
+  params.follow_navigation = follow_navigation.value_or(true);
+  // An answer run on the way here started another choice: it must post.
+  DCHECK(!file_session_);
+  file_session_ = std::make_unique<FileSession>(
+      *this, ++last_file_session_id_, std::move(params), std::move(completion),
+      base::BindOnce(&InputHandler::OnFileSessionDone,
+                     weak_factory_.GetWeakPtr()));
+  file_session_->Start();
+}
+
+void InputHandler::InterruptFileSession(Interruption why) {
+  std::unique_ptr<FileSession> session = std::move(file_session_);
+  if (session) {
+    session->Interrupt(why);
+  }
+}
