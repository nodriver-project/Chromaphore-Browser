+// browser: Input.moveTo: its parameters handed
+// to RunMove, answered through AnswerMoveTo.
+void InputHandler::MoveTo(std::optional<int> backend_node_id,
+                          std::optional<std::string> frame_id,
+                          std::optional<double> aim_x,
+                          std::optional<double> aim_y,
+                          std::unique_ptr<Input::PlanRect> box,
+                          std::optional<double> x,
+                          std::optional<double> y,
+                          std::optional<std::string> intent,
+                          std::unique_ptr<Input::MoveEnd> end,
+                          std::optional<int> modifiers,
+                          std::optional<double> speed_multiplier,
+                          std::optional<bool> check,
+                          std::optional<double> timeout_ms,
+                          std::optional<double> pointer_x,
+                          std::optional<double> pointer_y,
+                          std::optional<bool> follow_navigation,
+                          std::unique_ptr<MoveToCallback> callback) {
+  MoveRequest request;
+  request.backend_node_id = backend_node_id;
+  request.frame_id = std::move(frame_id);
+  request.aim_x = aim_x;
+  request.aim_y = aim_y;
+  if (box) {
+    request.box = PlannerRect{box->GetX(), box->GetY(), box->GetWidth(),
+                              box->GetHeight()};
+  }
+  request.x = x;
+  request.y = y;
+  request.intent = std::move(intent);
+  if (end) {
+    request.end_action = end->GetAction();
+    if (end->HasButton()) {
+      request.end_button = end->GetButton("left");
+    }
+    request.end_click_count = end->GetClickCount(1);
+  }
+  request.modifiers = modifiers;
+  request.speed_multiplier = speed_multiplier;
+  request.check = check;
+  request.timeout_ms = timeout_ms;
+  request.pointer_x = pointer_x;
+  request.pointer_y = pointer_y;
+  request.follow_navigation = follow_navigation;
+  // A scroll under way ends first (RunMove leaves it: the scroll's own move
+  // goes through it).
+  InterruptScrollSession();
+  InterruptSelectSession();
+  InterruptTemporalSession();
+  InterruptColorSession();
+  InterruptFileSession();
+  RunMove(std::move(request), AnswerMoveTo(std::move(callback)));
+}
+
+// browser: the move checked, an element's local root resolved -- the main
+// frame's, or a cross-origin frame's own -- and its collector bound, the
+// hand's place settled, then carried out by a MoveSession, which answers it
+// once through `completion`. The request is this call's own: the answers it
+// runs on the way (the reveal, drag and move it interrupts) cannot take it
+// away.
+void InputHandler::RunMove(MoveRequest request, MoveCompletion completion) {
+  const std::optional<int>& backend_node_id = request.backend_node_id;
+  const std::optional<std::string>& frame_id = request.frame_id;
+  const std::optional<double>& aim_x = request.aim_x;
+  const std::optional<double>& aim_y = request.aim_y;
+  const std::optional<PlannerRect>& box = request.box;
+  const std::optional<double>& x = request.x;
+  const std::optional<double>& y = request.y;
+  const std::optional<std::string>& intent = request.intent;
+  const std::optional<int>& modifiers = request.modifiers;
+  const std::optional<double>& speed_multiplier = request.speed_multiplier;
+  const std::optional<bool>& check = request.check;
+  const std::optional<double>& timeout_ms = request.timeout_ms;
+  const std::optional<double>& pointer_x = request.pointer_x;
+  const std::optional<double>& pointer_y = request.pointer_y;
+  const std::optional<bool>& follow_navigation = request.follow_navigation;
+  // Other pointer input ends a reveal under way where it has got to, a drag
+  // under way (answered interrupted once its drag has ended), and the move
+  // before this one.
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  InterruptDragSession();
+  InterruptMoveSession();
+  if (std::optional<Response> refusal =
+          CheckActionCall("Input.moveTo", /*refuse_held_drag=*/false,
+                          {&aim_x, &aim_y, &x, &y, &speed_multiplier,
+                           &timeout_ms, &pointer_x, &pointer_y})) {
+    FailMove(std::move(completion), *refusal);
+    return;
+  }
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  const bool to_element = backend_node_id.has_value() || frame_id.has_value();
+  const bool to_box = !!box;
+  const bool to_point = x.has_value() || y.has_value();
+  const int targets =
+      (to_element ? 1 : 0) + (to_box ? 1 : 0) + (to_point ? 1 : 0);
+  if (targets > 1 ||
+      (to_element &&
+       (!backend_node_id || !frame_id || *backend_node_id <= 0)) ||
+      (to_point && !(x && y))) {
+    FailMove(std::move(completion),
+             Response::InvalidParams(
+                 "Give at most one target: 'backendNodeId' and 'frameId', "
+                 "'box', or 'x' and 'y'"));
+    return;
+  }
+  if (to_box && !(std::isfinite(box->x) && std::isfinite(box->y) &&
+                  std::isfinite(box->w) && std::isfinite(box->h) &&
+                  box->w > 0 && box->h > 0)) {
+    FailMove(std::move(completion),
+             Response::InvalidParams(
+                 "'box' must be finite, with a width and a height above 0"));
+    return;
+  }
+  if ((aim_x || aim_y) && !(to_element || to_box)) {
+    FailMove(std::move(completion),
+             Response::InvalidParams(
+                 "'aimX' and 'aimY' go with an element or a box"));
+    return;
+  }
+  const std::optional<PathIntent> path_intent =
+      ParsePathIntent(intent.value_or("default"));
+  if (!path_intent) {
+    FailMove(std::move(completion), BadIntent());
+    return;
+  }
+  if (modifiers.has_value() && !ValidModifiers(*modifiers)) {
+    FailMove(std::move(completion),
+             Response::InvalidParams(
+                 "'modifiers' must combine Alt=1, Ctrl=2, Meta=4 and Shift=8"));
+    return;
+  }
+  if (std::optional<Response> refusal =
+          CheckSpeedMultiplier(speed_multiplier)) {
+    FailMove(std::move(completion), *refusal);
+    return;
+  }
+
+  MoveSession::Params params;
+  // Why the end cannot be done, when it cannot.
+  std::string refusal;
+  if (request.end_action) {
+    using EndAction = SyntheticMousePathGestureParams::EndAction;
+    const std::optional<EndAction> end_action =
+        ParseEndAction(*request.end_action);
+    if (!end_action) {
+      FailMove(std::move(completion),
+               Response::InvalidParams(
+                   "'end.action' must be one of press, release, click"));
+      return;
+    }
+    params.end_action = *end_action;
+    // The button as given; a release without one lets go of the button
+    // held down.
+    SyntheticPointerActionParams::Button button =
+        SyntheticPointerActionParams::Button::LEFT;
+    if (request.end_button) {
+      const std::optional<SyntheticPointerActionParams::Button> named =
+          ButtonByName(*request.end_button, /*allow_none=*/false);
+      if (!named) {
+        FailMove(std::move(completion),
+                 Response::InvalidParams(
+                     "'end.button' must be one of left, middle, right, back, "
+                     "forward"));
+        return;
+      }
+      button = *named;
+    } else if (params.end_action == EndAction::kRelease &&
+               held_button_ !=
+                   SyntheticPointerActionParams::Button::NO_BUTTON) {
+      button = held_button_;
+    }
+    params.end_button = button;
+    // A button goes down once and comes up once: a press of one while one is
+    // down, or a release of one that is not, is no hand's (refused once the
+    // pointer's place is known, below).
+    if (params.end_action != EndAction::kRelease &&
+        held_button_ != SyntheticPointerActionParams::Button::NO_BUTTON) {
+      refusal = "a button is already down: let go of it first";
+    } else if (params.end_action == EndAction::kRelease &&
+               held_button_ !=
+                   SyntheticPointerActionParams::Button::NO_BUTTON &&
+               button != held_button_) {
+      refusal = "that button is not down";
+    }
+    const int clicks = request.end_click_count.value_or(1);
+    if (!ValidClickCount(clicks)) {
+      FailMove(std::move(completion),
+               Response::InvalidParams("'end.clickCount' must be 1, 2 or 3"));
+      return;
+    }
+    params.click_count = clicks;
+  }
+  // Where the hand is: where the last mouse path left it, or as told.
+  const float scale = ScaleFactor();
+  std::optional<PlannerPoint> hand = LastPointer();
+  if (!hand && pointer_x && pointer_y) {
+    hand = PlannerPoint{*pointer_x * scale, *pointer_y * scale};
+  }
+  if (!hand) {
+    FailMove(std::move(completion),
+             Response::InvalidParams("Where the pointer is is not known: give "
+                                     "'pointerX' and 'pointerY'"));
+    return;
+  }
+  if (!refusal.empty()) {
+    MoveSession::Refuse(std::move(completion), "unreachable", refusal, *hand,
+                        scale > 0 ? scale : 1);
+    return;
+  }
+  const gfx::Rect bounds = root_view->GetViewBounds();
+  params.view = PlannerRect{0, 0, static_cast<double>(bounds.width()),
+                            static_cast<double>(bounds.height())};
+  params.hand = *hand;
+  params.held_button = held_button_;
+  params.css_scale = scale > 0 ? scale : 1;
+  params.intent = *path_intent;
+  params.modifiers = modifiers.value_or(0);
+  params.speed_multiplier = speed_multiplier.value_or(1);
+  params.check = check.value_or(true);
+  params.check_landing = request.check_landing;
+  params.arm = request.arm;
+  params.follow_navigation = follow_navigation.value_or(true);
+  params.timeout = base::Milliseconds(
+      ClampTimeout(timeout_ms, kActionTimeoutMs, kActionTimeoutMaxMs));
+  if (aim_x) {
+    params.aim_x = std::clamp(*aim_x, 0.0, 1.0);
+  }
+  if (aim_y) {
+    params.aim_y = std::clamp(*aim_y, 0.0, 1.0);
+  }
+
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+  if (to_element) {
+    // The element's local root, and its collector.
+    RenderFrameHostImpl* rfh = LiveLocalRootForFrame(*frame_id);
+    service_manager::InterfaceProvider* remotes =
+        rfh ? rfh->GetRemoteInterfaces() : nullptr;
+    if (!remotes) {
+      MoveSession::Refuse(std::move(completion), "gone",
+                          "the element's frame is gone", *hand,
+                          params.css_scale);
+      return;
+    }
+    params.target = MoveSession::Target::kElement;
+    params.local_root = rfh->GetGlobalId();
+    params.node_id = *backend_node_id;
+    remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+  } else if (to_box) {
+    params.target = MoveSession::Target::kBox;
+    params.box = PlannerRect{box->x * scale, box->y * scale, box->w * scale,
+                             box->h * scale};
+  } else if (to_point) {
+    params.target = MoveSession::Target::kPoint;
+    params.point = PlannerPoint{*x * scale, *y * scale};
+  }
+  // An answer run on the way here started another move: it must post.
+  DCHECK(!move_session_);
+  move_session_ = std::make_unique<MoveSession>(
+      *this, ++last_move_session_id_, params, HandPlanner(),
+      std::move(collector), std::move(completion),
+      base::BindOnce(&InputHandler::OnMoveSessionDone,
+                     weak_factory_.GetWeakPtr()));
+  move_session_->Start();
+}
+
+void InputHandler::InterruptMoveSession() {
+  if (std::unique_ptr<MoveSession> session = std::move(move_session_)) {
+    session->Interrupt();
+  }
+}
