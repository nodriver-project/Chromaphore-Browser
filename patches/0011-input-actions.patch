+// A point kept 2 px inside the view: no leg and no release leaves it.
+PlannerPoint DragSession::InView(const PlannerPoint& p) const {
+  if (!terrain_) {
+    return p;
+  }
+  const DragRect view = terrain_->viewport().Inset(kViewMargin, kViewMargin);
+  if (view.IsEmpty()) {
+    return p;
+  }
+  return PlannerPoint{
+      std::clamp(p.x, view.x, std::max(view.x, view.right() - 1)),
+      std::clamp(p.y, view.y, std::max(view.y, view.bottom() - 1))};
+}
+
+// Every point of `leg` kept inside the view (InView): no leg leaves it.
+void DragSession::ClampToView(std::vector<PlannedPoint>* leg) const {
+  for (PlannedPoint& point : *leg) {
+    point.p = InView(point.p);
+  }
+}
+
+// A point whose nearest device pixel lies at least 0.5 px inside `box` on
+// each axis: unchanged when it does; else the middle of the whole
+// pixels the box covers that deep (a thin target) or the nearest of them;
+// a box no pixel lies that deep in is aimed at its centre. The view's
+// origin is taken to be on the device pixel grid.
+PlannerPoint DragSession::PixelInside(const DragRect& box,
+                                      PlannerPoint p) const {
+  if (box.IsEmpty()) {
+    return p;
+  }
+  const double dsf = Dsf();
+  const auto axis = [dsf](double lo, double size, double at) {
+    const double first = std::ceil(lo * dsf + 0.5);
+    const double last = std::floor((lo + size) * dsf - 0.5);
+    if (first > last) {
+      return lo + size / 2;
+    }
+    const double pixel = std::round(at * dsf);
+    if (pixel >= first && pixel <= last) {
+      return at;
+    }
+    const double chosen = last - first < 4 ? std::round((first + last) / 2)
+                                           : std::clamp(pixel, first, last);
+    return chosen / dsf;
+  };
+  p.x = axis(box.x, box.w, p.x);
+  p.y = axis(box.y, box.h, p.y);
+  return p;
+}
+
+double DragSession::LandingWidth() const {
+  if (params_.target_kind != TargetKind::kElement) {
+    return kPointWidth;
