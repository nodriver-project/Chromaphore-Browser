+// time that long is drawn again from this range, in ms.
+constexpr int kAloneLeastMs = 360;
+constexpr int kAloneMostMs = 470;
+
+// A typo's correction is bracketed by a pause to notice it and a pause to
+// find the place again, so the rhythm breaks the way it does for a typist.
+// The backspaces between them are timed as any key pressed again and again.
+constexpr int kRealizePauseMinMs = 200;
+constexpr int kRealizePauseMaxMs = 400;
+constexpr int kPostCorrectionMinMs = 150;
+constexpr int kPostCorrectionMaxMs = 300;
+
+// QWERTY neighbours of the alphanumeric block. Keys outside it never get
+// adjacent-key typos, though they can still get doubled / omission typos.
+struct AdjacencyEntry {
+  char32_t key;
+  std::string_view adjacent;
+};
+constexpr AdjacencyEntry kAdjacency[] = {
+    {U'q', "wa"},     {U'w', "qeasd"},  {U'e', "wrsdf"},  {U'r', "etdfg"},
+    {U't', "ryfgh"},  {U'y', "tughj"},  {U'u', "yihjk"},  {U'i', "uojkl"},
+    {U'o', "ipkl"},   {U'p', "ol"},     {U'a', "qwsz"},   {U's', "awedzx"},
+    {U'd', "serfxc"}, {U'f', "drtgcv"}, {U'g', "ftyhvb"}, {U'h', "gyujbn"},
+    {U'j', "huiknm"}, {U'k', "jiolm"},  {U'l', "kop"},    {U'z', "asx"},
+    {U'x', "zsdc"},   {U'c', "xdfv"},   {U'v', "cfgb"},   {U'b', "vghn"},
+    {U'n', "bhjm"},   {U'm', "njk"},    {U'1', "2q"},     {U'2', "13qw"},
+    {U'3', "24we"},   {U'4', "35er"},   {U'5', "46rt"},   {U'6', "57ty"},
+    {U'7', "68yu"},   {U'8', "79ui"},   {U'9', "80io"},   {U'0', "9op"},
+};
+
+std::string_view LookupAdjacent(char32_t c) {
+  for (const AdjacencyEntry& entry : kAdjacency) {
+    if (entry.key == c) {
+      return entry.adjacent;
+    }
+  }
+  return {};
+}
+
+// The shifted symbols on the digit row, indexed by digit.
+constexpr std::string_view kShiftedDigits = ")!@#$%^&*(";
+
+// Returns the digit under a shifted digit-row symbol, or 0.
+char UnshiftDigitSymbol(char32_t c) {
+  const size_t index = c <= 0x7F ? kShiftedDigits.find(static_cast<char>(c))
+                                 : std::string_view::npos;
+  return index == std::string_view::npos ? 0 : static_cast<char>('0' + index);
+}
+
+struct KeyMapping {
+  std::string key;
+  std::string code;
+  int windows_vkey = 0;
+  bool needs_shift = false;
+  std::u16string text;  // the event's 'text' field
+  // The key's own character, the one it gives without Shift ('a' for "A",
+  // '1' for "!", '\n' for Enter); 0 for a key a chord names.
+  char base = 0;
+};
+
+// Punctuation keys as (unshifted, shifted, code, virtual key).
+struct PunctuationKey {
+  char32_t plain;
+  char32_t shifted;
+  std::string_view code;
+  int windows_vkey;
+};
+constexpr PunctuationKey kPunctuationKeys[] = {
+    {U'-', U'_', "Minus", 189},       {U'=', U'+', "Equal", 187},
+    {U'[', U'{', "BracketLeft", 219}, {U']', U'}', "BracketRight", 221},
+    {U'\\', U'|', "Backslash", 220},  {U';', U':', "Semicolon", 186},
+    {U'\'', U'"', "Quote", 222},      {U',', U'<', "Comma", 188},
+    {U'.', U'>', "Period", 190},      {U'/', U'?', "Slash", 191},
+    {U'`', U'~', "Backquote", 192},
+};
+
+// Maps a single ASCII char to its key event fields. Returns false for chars
+// without a known mapping.
+bool BuildKeyMapping(char32_t c, KeyMapping* out) {
+  if (c == U'\n' || c == U'\r') {
+    *out = {"Enter", "Enter", 13, false, u"\r", '\n'};
+    return true;
+  }
+  if (c == U'\t') {
+    *out = {"Tab", "Tab", 9, false, u"\t", '\t'};
+    return true;
+  }
+  if (c == U' ') {
+    *out = {" ", "Space", 32, false, u" ", ' '};
+    return true;
+  }
+  const std::string key(1, static_cast<char>(c));
+  const std::u16string text(1, static_cast<char16_t>(c));
+  if (c >= U'a' && c <= U'z') {
+    const char upper = static_cast<char>('A' + (c - U'a'));
+    *out = {key,  std::string("Key") + upper, upper, false,
+            text, static_cast<char>(c)};
+    return true;
+  }
+  if (c >= U'A' && c <= U'Z') {
+    *out = {key,
+            std::string("Key") + static_cast<char>(c),
+            static_cast<int>(c),
+            true,
+            text,
+            static_cast<char>('a' + (c - U'A'))};
+    return true;
+  }
+  if (c >= U'0' && c <= U'9') {
+    *out = {key,
+            std::string("Digit") + static_cast<char>(c),
+            static_cast<int>(c),
+            false,
+            text,
+            static_cast<char>(c)};
+    return true;
+  }
+  if (const char digit = UnshiftDigitSymbol(c)) {
+    *out = {key, std::string("Digit") + digit, digit, true, text, digit};
+    return true;
+  }
+  for (const PunctuationKey& punct : kPunctuationKeys) {
+    if (c == punct.plain || c == punct.shifted) {
+      *out = {key,
+              std::string(punct.code),
+              punct.windows_vkey,
+              c == punct.shifted,
+              text,
+              static_cast<char>(punct.plain)};
+      return true;
+    }
+  }
+  return false;
+}
+
+// What a key reports as its `key` with Shift up or down: `base` is the key's
+// own character. Empty for a key whose name does not change (Enter, Tab,
+// the space bar) and for one outside the map.
+std::string KeyUnderShift(char base, bool shift) {
+  if (base >= 'a' && base <= 'z') {
+    return std::string(1, shift ? static_cast<char>(base - 'a' + 'A') : base);
+  }
+  if (base >= '0' && base <= '9') {
+    return std::string(1, shift ? kShiftedDigits[base - '0'] : base);
+  }
+  for (const PunctuationKey& punct : kPunctuationKeys) {
+    if (static_cast<char32_t>(base) == punct.plain) {
+      return std::string(
+          1, static_cast<char>(shift ? punct.shifted : punct.plain));
+    }
+  }
+  return std::string();
+}
+
+// Decodes UTF-8 into UTF-32 codepoints. Invalid sequences become U+FFFD, so
+// the schedule generator never sees them.
+std::vector<char32_t> DecodeUtf8(const std::string& text) {
+  const std::u16string u16 = base::UTF8ToUTF16(text);
+  std::vector<char32_t> out;
+  out.reserve(u16.size());
+  for (size_t i = 0; i < u16.size(); ++i) {
+    const char16_t c = u16[i];
+    if (c >= 0xD800 && c <= 0xDBFF && i + 1 < u16.size()) {
+      const char16_t lo = u16[i + 1];
+      if (lo >= 0xDC00 && lo <= 0xDFFF) {
+        out.push_back(0x10000 + ((c - 0xD800) << 10) + (lo - 0xDC00));
+        ++i;
+        continue;
+      }
+    }
+    out.push_back(c);
+  }
+  return out;
+}
+
+// Newlines, control chars and non-ASCII never get typos.
+bool IsTypoEligible(char32_t c) {
+  return c >= 0x20 && c < 0x7F;
+}
+
+// Keys a chord presses by name. Their `code` is the same as their `key`, and
+// only Enter and Tab produce text. They report location 0 on Windows, the
+// navigation block included.
+struct NamedKey {
+  std::string_view key;
+  int windows_vkey;
+  std::u16string_view text;
+};
+constexpr NamedKey kNamedKeys[] = {
+    {"Enter", 13, u"\r"},    {"Tab", 9, u"\t"},        {"Backspace", 8, u""},
+    {"Escape", 27, u""},     {"Delete", 46, u""},      {"Insert", 45, u""},
+    {"Home", 36, u""},       {"End", 35, u""},         {"PageUp", 33, u""},
+    {"PageDown", 34, u""},   {"ArrowLeft", 37, u""},   {"ArrowUp", 38, u""},
+    {"ArrowRight", 39, u""}, {"ArrowDown", 40, u""},   {"F1", 112, u""},
+    {"F2", 113, u""},        {"F3", 114, u""},         {"F4", 115, u""},
+    {"F5", 116, u""},        {"F6", 117, u""},         {"F7", 118, u""},
+    {"F8", 119, u""},        {"F9", 120, u""},         {"F10", 121, u""},
+    {"F11", 122, u""},       {"F12", 123, u""},        {"CapsLock", 20, u""},
+    {"NumLock", 144, u""},   {"ScrollLock", 145, u""},
+};
+
+// The key a chord presses: a named key, or one character. With Shift held a
+// character is its shifted form -- 'v' reads "V" and '1' reads "!" -- since
+// that is what the key reports when a hand presses it with Shift down. With
+// Ctrl, Alt or Meta and no Shift, a capital is the shortcut's letter: Ctrl+"A"
+// is Ctrl+A, where adding the Shift a capital needs would make it
+// Ctrl+Shift+A, a different shortcut.
+bool BuildChordKeyMapping(const std::string& key,
+                          int modifiers,
+                          KeyMapping* out) {
+  if (key == "Space" || key == "Spacebar") {
+    return BuildKeyMapping(U' ', out);
+  }
+  for (const NamedKey& named : kNamedKeys) {
+    if (key == named.key) {
+      *out = {std::string(named.key), std::string(named.key),
+              named.windows_vkey, false, std::u16string(named.text)};
+      return true;
+    }
+  }
+  const std::vector<char32_t> chars = DecodeUtf8(key);
+  if (chars.size() != 1) {
+    return false;
+  }
+  char32_t c = chars[0];
+  if ((modifiers & kModCommand) && !(modifiers & kModShift) && c >= U'A' &&
+      c <= U'Z') {
+    c = U'a' + (c - U'A');
+  } else if (modifiers & kModShift) {
+    if (c >= U'a' && c <= U'z') {
+      c = U'A' + (c - U'a');
+    } else if (c >= U'0' && c <= U'9') {
+      c = static_cast<char32_t>(kShiftedDigits[c - U'0']);
+    } else {
+      for (const PunctuationKey& punct : kPunctuationKeys) {
+        if (c == punct.plain) {
+          c = punct.shifted;
+          break;
+        }
+      }
+    }
+  }
+  return BuildKeyMapping(c, out);
+}
+
+// browser: typed text is timed as one person types it. The model follows
+// what a study of 136 million keystrokes by 168,000 people copying sentences
+// found (Dhakal, Feit, Kristensson and Oulasvirta, "Observations on Typing
+// from 136 Million Keystrokes", CHI 2018):
+//  - each press is timed from the press before it, by a gap drawn for that
+//    pair of keys (which hands and fingers, and how often the two letters
+//    meet), as a share of the typist's own median gap;
+//  - each key is held for a time drawn on its own, which hardly changes with
+//    speed. A quick typist's gaps are often shorter than the holds, so the
+//    next key goes down while the last is still down: that overlap is not
+//    drawn, it follows;
+//  - a key comes up before the key pressed after it does, nearly always;
+//  - Shift is a key of its own: it goes down a while after the key before
+//    it came up, its key follows by a lead, and it comes up around that
+//    key's release, so a capital costs time.
+//    A Shift held alone for the keyboard's repeat delay repeats its keydown,
+//    as any held key does.
+// A hand's times do not pile up on a limit: where one would cross a limit it
+// is bent or folded back smoothly, or the limit itself is drawn.
+// One identity is one typist: the speed, the hold and how widely both spread
+// come from the persona seed. A pace a caller asks for is a typist of that
+// speed, read from the same tables. And the browser has one keyboard, which
+// reports on its own clock, every kKeyboardReportMs or very nearly: the
+// persona seed says how far its clock runs off the system's.
+
+// The pairs of keys a gap lies between.
+enum KeyPair {
+  kOtherHand,
+  kSameHand,    // another finger of the same hand
+  kSameFinger,  // another key under the same finger
+  kSameKey,
+  kToSpace,    // a key, then the space bar
+  kFromSpace,  // the space bar, then a key
+  kKeyPairCount,
+};
+constexpr int kTypistSpeedCount = 6;
+constexpr int kGapQuantileCount = 9;
+constexpr int kShiftWaitQuantileCount = 7;
+enum ShiftTail { kTailWait, kTailLead, kTailUp, kTailNext, kShiftTailCount };
+// Where the tails begin.
+constexpr double kTailFrom = 0.95;
+
+// The tables, by typing speed: the measured ones, or a plain typist's where
+// the source is published without them. The file says what each holds.
+#include "content/browser/devtools/protocol/keyboard_typing_tables.inc"
+
+static_assert(std::size(kTypistSpeeds) == kTypistSpeedCount);
+static_assert(std::size(kShiftWaitProbabilities) == kShiftWaitQuantileCount);
+static_assert(std::size(kGapProbabilities) == kGapQuantileCount);
+static_assert(std::size(kMedianGapMs) == kTypistSpeedCount);
+static_assert(std::size(kMedianHoldMs) == kTypistSpeedCount);
+
+// How far a hold leans on the gap after it, by pair: this much is taken off
+// the hold's logarithm for each standard deviation the gap is above its
+// middle. Before a key of the same hand a short gap goes with a longer hold
+// (the hand rolls over the keys); before a key of the other hand, with a
+// shorter one. Set so that each pair overlaps as often as measured.
+constexpr double kHoldLean[kKeyPairCount] = {-0.1, 0.25, 0.15,
+                                             0.0,  0.05, -0.05};
+// A hold that would be shorter than this is folded back above it (people's
+// shortest holds are a little under 40 ms).
+constexpr double kMinTypedHoldMs = 28;
+// Under the keyboard's repeat delay: a typed key never repeats. A hold is
+// bent under it from the knee on.
+constexpr double kMaxTypedHoldMs = 450;
+constexpr double kHoldKneeMs = 380;
+// The typist's median hold against the measured one at their speed: a
+// lognormal factor, drawn again past this many standard deviations, so that
+// no typist sits on an end.
+constexpr double kHoldFactorSd = 0.19;
+constexpr double kHoldFactorMost = 2.3;
+// The caller's hold range stretches the holds by no more than this.
+constexpr double kHoldDialLeast = 0.6;
+constexpr double kHoldDialMost = 1.6;
+// The fastest typing a caller's pace can ask for, in words a minute: a little
+// past the tables' fastest column.
+constexpr double kFastestWpm = 110;
+// A key still down when the next one is released comes up first after all,
+// this often, and then this long before it on average (an exponential
+// spread).
+constexpr double kKeepReleaseOrder = 0.84;
+constexpr double kKeepReleaseOrderMs = 14;
+// A very short overlap is lifted a little: left to the holds alone, 16 in
+// 100 overlaps would be shorter than 8 ms, where two recorded runs have 6
+// and 8 and the dataset about 6. This gives 7 to 8.
+constexpr double kOverlapLiftMs = 9;
+// The middles of the default delay and hold ranges, which leave the typist's
+// own pace and holds.
+constexpr double kDefaultDelayMiddleMs = 160;
+constexpr double kDefaultHoldMiddleMs = 97.5;
+// The time between two reports of a keyboard, in ms: most keyboards are
+// polled 125 times a second.
+constexpr double kKeyboardReportMs = 8;
+// The keyboard's clock is not the system's: it runs this many parts in a
+// million fast or slow, by identity (two recorded runs, very likely of one
+// keyboard, were about 1 fast).
+constexpr double kKeyboardDriftLeastPpm = 0.3;
+constexpr double kKeyboardDriftMostPpm = 2.0;
+// A held key's repeat, in ms: the first comes kRepeatDelayMs and up to this
+// much more after the keydown; one interval in twenty is 5 to 15 ms longer.
+constexpr double kRepeatDelaySpanMs = 8;
+constexpr double kRepeatHiccupShare = 0.05;
+constexpr double kRepeatHiccupLeastMs = 5;
+constexpr double kRepeatHiccupMostMs = 15;
+
+// The typing model's draws (splitmix64). The reference model the numbers
+// above were fitted with draws the same stream, so a schedule can be checked
+// against it event by event.
+class TypingDraws {
+ public:
+  explicit TypingDraws(uint64_t seed) : state_(seed) {}
+
+  uint64_t Next() {
+    state_ += 0x9E3779B97F4A7C15ull;
+    uint64_t z = state_;
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+    return z ^ (z >> 31);
+  }
+  // In [0, 1).
+  double Unit() { return static_cast<double>(Next() >> 11) * 0x1.0p-53; }
+  double Between(double lo, double hi) { return lo + Unit() * (hi - lo); }
+  // From the standard normal.
+  double Normal() {
+    const double u1 = Unit();
+    const double u2 = Unit();
+    return std::sqrt(-2.0 * std::log(1.0 - u1)) *
+           std::cos(2.0 * std::numbers::pi * u2);
+  }
+
+ private:
+  uint64_t state_;
+};
+
+// Which hand and finger presses a key, by the key's own character. Fingers
+// count from the little finger, 0, to the index finger, 3.
+struct Finger {
+  bool right = false;
+  int finger = 0;
+};
+
+std::optional<Finger> FingerOf(char base) {
+  struct FingerKeys {
+    Finger finger;
+    std::string_view keys;
+  };
+  static constexpr FingerKeys kFingers[] = {
+      {{false, 0}, "qaz1`\t"}, {{false, 1}, "wsx2"},
+      {{false, 2}, "edc3"},    {{false, 3}, "rfvtgb45"},
+      {{true, 3}, "yhnujm67"}, {{true, 2}, "ik8,"},
+      {{true, 1}, "ol9."},     {{true, 0}, "p0;/'-[]=\\\n\b"},
+  };
+  if (base == 0) {
+    return std::nullopt;
+  }
+  for (const FingerKeys& entry : kFingers) {
+    if (entry.keys.find(base) != std::string_view::npos) {
+      return entry.finger;
+    }
+  }
+  return std::nullopt;
+}
+
+// The pair `first` then `second` make, by their own characters; nothing for
+// a key no finger is known for.
+std::optional<KeyPair> PairOf(char first, char second) {
+  if (second == ' ' && first != ' ') {
+    return kToSpace;
+  }
+  if (first == ' ' && second != ' ') {
+    return kFromSpace;
+  }
+  const std::optional<Finger> a = FingerOf(first);
+  const std::optional<Finger> b = FingerOf(second);
+  if (!a || !b) {
+    return std::nullopt;
+  }
+  if (first == second) {
+    return kSameKey;
+  }
+  if (a->right != b->right) {
+    return kOtherHand;
+  }
+  return a->finger == b->finger ? kSameFinger : kSameHand;
+}
+
+// How long the gap between two letters is against their kind of pair's.
+double LetterPairFactor(char first, char second) {
+  const auto index = [](char c) {
+    return c == ' ' ? 26 : (c >= 'a' && c <= 'z') ? c - 'a' : -1;
+  };
+  const int a = index(first);
+  const int b = index(second);
+  if (a < 0 || b < 0 || first == second) {
+    return 1.0;
+  }
+  return kLetterPairPercent[a][b] / 100.0;
+}
+
+// A measured row's value at a speed: between its two nearest columns.
+double AtSpeed(const double (&row)[kTypistSpeedCount], double wpm) {
+  if (wpm <= kTypistSpeeds[0]) {
+    return row[0];
+  }
+  for (int i = 1; i < kTypistSpeedCount; ++i) {
+    if (wpm <= kTypistSpeeds[i]) {
+      const double share = (wpm - kTypistSpeeds[i - 1]) /
+                           (kTypistSpeeds[i] - kTypistSpeeds[i - 1]);
+      return row[i - 1] + (row[i] - row[i - 1]) * share;
+    }
+  }
+  return row[kTypistSpeedCount - 1];
+}
+
+// The probability of a draw `z` from the standard normal.
+double UnitOf(double z) {
+  return 0.5 * (1.0 + std::erf(z / std::numbers::sqrt2));
+}
+
+// The value at probability `u` of a spread measured at kGapProbabilities:
+// straight lines between the measured values on a logarithmic scale, and a
+// short tail past each end.
+double AtProbability(const std::array<double, kGapQuantileCount>& q, double u) {
+  const double top = kGapProbabilities[kGapQuantileCount - 1];
+  if (u <= kGapProbabilities[0]) {
+    return q[0] * (0.85 + 0.15 * u / kGapProbabilities[0]);
+  }
+  if (u > top) {
+    return q[kGapQuantileCount - 1] * (1.0 + 0.25 * (u - top) / (1.0 - top));
+  }
+  int i = 1;
+  while (u > kGapProbabilities[i]) {
+    ++i;
+  }
+  const double share = (u - kGapProbabilities[i - 1]) /
+                       (kGapProbabilities[i] - kGapProbabilities[i - 1]);
+  return std::exp(std::log(q[i - 1]) +
+                  share * (std::log(q[i]) - std::log(q[i - 1])));
+}
+
+// A value past kTailFrom: `value` is the one at kTailFrom, and beyond it the
+// spread thins out exponentially, by `scale` ms.
+double TailPast(double value, double scale, double u) {
+  return value +
+         scale * std::log((1.0 - kTailFrom) / (1.0 - std::min(u, 1.0 - 1e-6)));
+}
+
+// The same for a spread that crosses zero, measured at
+// kShiftWaitProbabilities: straight lines on the value itself. Below the
+// first value the first line goes on; above the last (kTailFrom) comes an
+// exponential tail of scale `tail`.
+double AtProbabilityLinear(const std::array<double, kShiftWaitQuantileCount>& q,
+                           double u,
+                           double tail) {
+  const int last = kShiftWaitQuantileCount - 1;
+  if (u <= kShiftWaitProbabilities[0]) {
+    return q[0] - (q[1] - q[0]) * (kShiftWaitProbabilities[0] - u) /
+                      (kShiftWaitProbabilities[1] - kShiftWaitProbabilities[0]);
+  }
+  for (int i = 1; i <= last; ++i) {
+    if (u <= kShiftWaitProbabilities[i]) {
+      const double share =
+          (u - kShiftWaitProbabilities[i - 1]) /
+          (kShiftWaitProbabilities[i] - kShiftWaitProbabilities[i - 1]);
+      return q[i - 1] + share * (q[i] - q[i - 1]);
+    }
+  }
+  return TailPast(q[last], tail, u);
+}
+
+// `value`, bent smoothly under `limit` from `knee` on, so that nothing piles
+// up on the limit itself.
+double BentUnder(double limit, double knee, double value) {
+  if (value <= knee) {
+    return value;
+  }
+  return knee +
+         (limit - knee) * (1.0 - std::exp(-(value - knee) / (limit - knee)));
+}
+
+// One identity's hands on a keyboard, at the pace a caller asks for.
+struct Typist {
+  double gap_ms = 0;       // the median gap from one press to the next
+  double hold_ms = 0;      // the median hold
+  double spread = 1;       // the gaps' spread, as a power of the measured one
+  double hold_log_sd = 0;  // the holds' spread
+  // What the pace asked for leaves to the gaps alone, past the speeds the
+  // tables hold: over 1 below their slowest, under 1 above their fastest.
+  double stretch = 1;
+  // The keyboard: the time between two of its reports, in ms on the system's
+  // clock.
+  double report_ms = kKeyboardReportMs;
+  // Each pair's gap as a share of gap_ms, at kGapProbabilities.
+  std::array<std::array<double, kGapQuantileCount>, kKeyPairCount> gap = {};
+  // The hold of the key before each pair, as a share of hold_ms.
+  std::array<double, kKeyPairCount> hold_before = {};
+  // Shift, in ms, as the tables have it at this typist's speed.
+  std::array<double, kShiftWaitQuantileCount> shift_wait = {};
+  std::array<double, kGapQuantileCount> shift_lead = {};
+  std::array<double, kShiftWaitQuantileCount> shift_up = {};
+  std::array<double, kShiftWaitQuantileCount> shift_next = {};
+  std::array<double, kShiftTailCount> shift_tail = {};
+
+  // The gap that ends `pair`, for a draw `z` from the standard normal.
+  double Gap(std::optional<KeyPair> pair, double z) const {
+    const std::array<double, kGapQuantileCount>& q =
+        gap[pair.value_or(kOtherHand)];
+    const double middle = q[kGapQuantileCount / 2];
+    return gap_ms * middle *
+           std::pow(AtProbability(q, UnitOf(z)) / middle, spread);
+  }
+
+  // For a draw `z` from the standard normal, in ms: from the key before
+  // coming up to Shift going down (under zero with that key still down);
+  // from Shift going down to its key going down; from that key coming up to
+  // Shift coming up (under zero with Shift up first); and from Shift coming
+  // up to the next key going down.
+  double ShiftWait(double z) const {
+    return AtProbabilityLinear(shift_wait, UnitOf(z), shift_tail[kTailWait]);
+  }
+  double ShiftLead(double z) const {
+    const double u = UnitOf(z);
+    // Its table's last value is the end of the measurement, not of the
+    // spread: the tail takes over one value before it.
+    static_assert(kGapProbabilities[kGapQuantileCount - 2] == kTailFrom);
+    return u <= kTailFrom ? AtProbability(shift_lead, u)
+                          : TailPast(shift_lead[kGapQuantileCount - 2],
+                                     shift_tail[kTailLead], u);
+  }
+  double ShiftUp(double z) const {
+    return AtProbabilityLinear(shift_up, UnitOf(z), shift_tail[kTailUp]);
+  }
+  double ShiftNext(double z) const {
+    return AtProbabilityLinear(shift_next, UnitOf(z), shift_tail[kTailNext]);
+  }
+
+  // How long the key `base` is held: `next` is the pair it makes with the
+  // key after it, `z` a draw from the standard normal, `lean` what the gap
+  // after it adds (kHoldLean) and `scale` the caller's stretch.
+  double Hold(char base,
+              std::optional<KeyPair> next,
+              double z,
+              double lean,
+              double scale) const {
+    double factor = 1.0;
+    if (const std::optional<Finger> finger = FingerOf(base)) {
+      // The little finger holds longer, the index finger a little shorter.
+      factor = finger->finger == 0 ? 1.12 : finger->finger == 3 ? 0.97 : 1.0;
+    }
+    if (next) {
+      factor *= hold_before[*next];
+    }
+    double hold = hold_ms * scale * factor * std::exp(hold_log_sd * z + lean);
+    if (hold < kMinTypedHoldMs) {
+      // Folded back above the least hold, at half the distance.
+      hold = kMinTypedHoldMs + 0.5 * (kMinTypedHoldMs - hold);
+    }
+    return BentUnder(kMaxTypedHoldMs, kHoldKneeMs, hold);
+  }
+};
+
+// The typist of the identity `persona_seed`, typing at `pace`: 1.0 is their
+// own speed, 2.0 half of it, 0.5 twice.
+Typist MakeTypist(int64_t persona_seed, double pace) {
+  TypingDraws draws(static_cast<uint64_t>(persona_seed) ^
+                    0x545950495354ull);  // "TYPIST"
+  // The typist's own speed, from the middle of the measured typists: 40 to
+  // 75 words a minute.
+  double own_wpm = 54.0 + 11.0 * draws.Normal();
+  while (own_wpm < 40.0 || own_wpm > 75.0) {
+    own_wpm = 54.0 + 11.0 * draws.Normal();
+  }
+  // Their holds against the measured ones at their speed.
+  double hold_z = draws.Normal();
+  while (std::abs(hold_z) > kHoldFactorMost) {
+    hold_z = draws.Normal();
+  }
+  Typist typist;
+  // Under 1 on average: a kind of pair's measured spread holds the
+  // differences between its pairs of letters, which kLetterPairPercent adds
+  // back.
+  typist.spread = draws.Between(0.84, 1.04);
+  typist.hold_log_sd = draws.Between(0.17, 0.27);
+  // The keyboard's clock against the system's.
+  double drift_ppm =
+      draws.Between(kKeyboardDriftLeastPpm, kKeyboardDriftMostPpm);
+  if (draws.Unit() < 0.5) {
+    drift_ppm = -drift_ppm;
+  }
+  typist.report_ms = kKeyboardReportMs * (1.0 + drift_ppm * 1e-6);
+  // The pace asked for is a typist of that speed, as far as the tables go:
+  // people who type faster do not type the same rhythm sooner, they overlap
+  // more and hold a little shorter. What the tables do not hold is left to
+  // the gaps alone.
+  const double target = std::min(own_wpm / std::max(pace, 1e-6), kFastestWpm);
+  const double wpm = std::clamp(target, kTypistSpeeds[0],
+                                kTypistSpeeds[kTypistSpeedCount - 1]);
+  typist.stretch = wpm / target;
+  typist.gap_ms = AtSpeed(kMedianGapMs, wpm);
+  typist.hold_ms =
+      AtSpeed(kMedianHoldMs, wpm) * std::exp(kHoldFactorSd * hold_z);
+  for (int pair = 0; pair < kKeyPairCount; ++pair) {
+    for (int q = 0; q < kGapQuantileCount; ++q) {
+      double column[kTypistSpeedCount];
+      for (int speed = 0; speed < kTypistSpeedCount; ++speed) {
+        column[speed] = kGapOverMedian[pair][speed][q];
+      }
+      typist.gap[pair][q] = AtSpeed(column, wpm);
+    }
+    typist.hold_before[pair] = AtSpeed(kHoldBeforePair[pair], wpm);
+  }
+  // A Shift table's row at the typist's speed.
+  const auto row_at_speed = [wpm](const auto& table, auto& row) {
+    for (size_t q = 0; q < row.size(); ++q) {
+      double column[kTypistSpeedCount];
+      for (int speed = 0; speed < kTypistSpeedCount; ++speed) {
+        column[speed] = table[speed][q];
+      }
+      row[q] = AtSpeed(column, wpm);
+    }
+  };
+  row_at_speed(kShiftWaitMs, typist.shift_wait);
+  row_at_speed(kShiftLeadMs, typist.shift_lead);
+  row_at_speed(kShiftUpMs, typist.shift_up);
+  row_at_speed(kShiftNextMs, typist.shift_next);
+  for (int tail = 0; tail < kShiftTailCount; ++tail) {
+    typist.shift_tail[tail] = AtSpeed(kShiftTailMs[tail], wpm);
+  }
+  return typist;
+}
+
+// How long after its poll a keyboard's report reaches the browser's UI
+// thread, which stamps it, in ms, for a draw `z` from the standard normal:
+// the input stack and the thread's wake. Small, never negative, now and then
+// longer; the same as a mouse's report (synthetic_mouse_path_gesture.cc).
+double ReportLatencyMs(double z) {
+  return std::min(1.5, 0.030 + 0.120 * std::exp(0.8 * z));
+}
+
+// A key going down or coming up under a hand, at `ms`.
+struct HandEvent {
+  double ms = 0;
+  bool is_down = false;
+  bool is_shift = false;
+};
+
+// An event as the browser gets it, at `ms` from the first report: the hand's
+// event `source`, or a held Shift's keydown again (`repeat`).
+struct ReportedEvent {
+  double ms = 0;
+  size_t source = 0;
+  bool repeat = false;
+};
+
+// What the keyboard and the system make of a hand's `events`, which are in
+// the order of their times. A keyboard reports on its own clock, every
+// `report_ms`: each event waits for the next report and reaches the browser
+// a small, uneven moment after it. The events of one report follow each
+// other closely, its releases before its presses: a report says which keys
+// are down, not in what order they got there, and the system hands on the
+// keys let go first. With `repeat_shift`, a Shift that stays the last key
+// pressed for the keyboard's repeat delay repeats its keydown, on the
+// system's own clock, until another key goes down or it comes up. The
+// reports are counted from `origin`, and the times given are from there.
+// Every event takes the same two draws from a stream of its own (`seed`),
+// and every repeat three from its Shift press's own.
+std::vector<ReportedEvent> ReportEvents(const std::vector<HandEvent>& events,
+                                        double origin,
+                                        double report_ms,
+                                        uint64_t seed,
+                                        bool repeat_shift) {
+  std::vector<ReportedEvent> out;
+  if (events.empty()) {
+    return out;
+  }
+  out.reserve(events.size());
+  std::vector<double> grids(events.size());
+  std::vector<size_t> order(events.size());
+  for (size_t k = 0; k < events.size(); ++k) {
+    grids[k] = std::ceil((events[k].ms - origin) / report_ms) * report_ms;
+    order[k] = k;
+  }
+  std::ranges::stable_sort(order, [&](size_t a, size_t b) {
+    return grids[a] < grids[b] ||
+           (grids[a] == grids[b] && !events[a].is_down && events[b].is_down);
+  });
+  TypingDraws draws(seed ^ 0x5245504F5254ull);  // "REPORT"
+  double last = 0;
+  double last_grid = -1;  // no report yet
+  std::optional<double> repeat_at;
+  size_t repeating = 0;
+  TypingDraws repeats(0);
+  for (size_t n = 0; n < order.size(); ++n) {
+    const size_t k = order[n];
+    const HandEvent& event = events[k];
+    const double z_late = draws.Normal();
+    const double u_same = draws.Unit();
+    const double grid = grids[k];
+    double stamp;
+    if (grid == last_grid) {
+      // The same report: the system hands its events on one by one.
+      stamp = last + 0.05 + 0.10 * u_same;
+    } else {
+      stamp = grid + ReportLatencyMs(z_late);
+      if (last_grid >= 0) {
+        stamp = std::max(stamp, last + 0.05 + 0.10 * u_same);
+      }
+    }
+    // The repeats that fall before it.
+    while (repeat_at && *repeat_at < stamp) {
+      out.push_back({*repeat_at, repeating, /*repeat=*/true});
+      const double u_gap = repeats.Unit();
+      const double u_if = repeats.Unit();
+      const double u_more = repeats.Unit();
+      *repeat_at += kRepeatIntervalMinMs +
+                    (kRepeatIntervalMaxMs - kRepeatIntervalMinMs) * u_gap;
+      if (u_if < kRepeatHiccupShare) {
+        *repeat_at += kRepeatHiccupLeastMs +
+                      (kRepeatHiccupMostMs - kRepeatHiccupLeastMs) * u_more;
+      }
+    }
+    if (event.is_down || event.is_shift) {
+      repeat_at.reset();  // another key went down, or Shift came up
+    }
+    if (repeat_shift && event.is_down && event.is_shift) {
+      repeats = TypingDraws(seed ^ 0x524550454154ull ^  // "REPEAT"
+                            ((n + 1) * 0x9E3779B97F4A7C15ull));
+      repeat_at = stamp + kRepeatDelayMs + kRepeatDelaySpanMs * repeats.Unit();
+      repeating = k;
+    }
+    out.push_back({stamp, k, /*repeat=*/false});
+    last = stamp;
+    last_grid = grid;
+  }
+  return out;
+}
+
+// The time between two reports of this browser's identity's keyboard, in ms.
+double IdentityReportMs() {
+  static const double report_ms =
+      MakeTypist(browser::PersonaSeed(), 1.0).report_ms;
+  return report_ms;
+}
+
+// The keyboard's first report at or after `now`. A keyboard reports on one
+// clock for as long as it is plugged in: the reports of every session lie
+// `report_ms` apart, counted from a moment fixed for the browser's run.
+// (Whole microseconds: the clock's drift is under one of them a report.)
+base::TimeTicks NextReport(base::TimeTicks now, double report_ms) {
+  static const base::TimeTicks first = base::TimeTicks::Now();
+  const double reports = std::ceil((now - first).InMillisecondsF() / report_ms);
+  return first + base::Microseconds(
+                     base::ClampRound<int64_t>(reports * report_ms * 1000.0));
+}
+
+// What the sessions' precise wakes have lately come late: the last eight
+// that say something about the timer. One record for the browser: the timer
+// is the system's.
+struct WakeRecord {
+  std::array<base::TimeDelta, 8> late;
+  size_t next = 0;
+  // When a session last finished waiting out an event.
+  base::TimeTicks waited_until;
+};
+
+WakeRecord& Wakes() {
+  static WakeRecord record = [] {
+    WakeRecord fresh;
+    fresh.late.fill(base::Milliseconds(1));
+    return fresh;
+  }();
+  return record;
+}
+
+// A precise wake asked for at `asked` came at `now`.
+void NoteWake(base::TimeTicks asked, base::TimeTicks now) {
+  WakeRecord& wakes = Wakes();
+  const base::TimeDelta late = now - asked;
+  // Not the timer's doing: the thread was waiting out an event when this
+  // wake was due (two tabs typing would feed each other's wait), or was held
+  // up for longer than any timer's tick (a long task, a machine asleep).
+  if (asked < wakes.waited_until || late > kWaitOutMost) {
+    return;
+  }
+  wakes.late[wakes.next] = late;
+  wakes.next = (wakes.next + 1) % wakes.late.size();
+}
+
+// How long before an event the session is woken for it: the latest of those
+// wakes, and a margin.
+base::TimeDelta WaitOutTime() {
+  return std::clamp(
+      std::ranges::max(Wakes().late) * 1.3 + base::Microseconds(300),
+      kWaitOutLeast, kWaitOutMost);
+}
+
+// Waits on the clock itself until `due`.
+void WaitOut(base::TimeTicks due) {
+  for (int looks = 0; looks < kWaitOutLooks && base::TimeTicks::Now() < due;
+       ++looks) {
+  }
+  Wakes().waited_until = base::TimeTicks::Now();
+}
+
+}  // namespace
+
+// static
+bool KeyboardTypingSession::IsChordKey(const std::string& key) {
+  KeyMapping mapping;
+  return BuildChordKeyMapping(key, /*modifiers=*/0, &mapping);
+}
+
+KeyboardTypingSession::KeyboardTypingSession(
+    base::WeakPtr<RenderWidgetHostImpl> widget_host,
+    Params params,
+    CompletionCallback callback)
+    : widget_host_(std::move(widget_host)),
+      params_(std::move(params)),
+      callback_(std::move(callback)),
+      rng_(params_.seed) {
+  // Anything but a positive number types at the baseline speed; the rest is
+  // held to kSpeedMultiplierMin to kSpeedMultiplierMax.
+  if (std::isnan(params_.speed_multiplier) || params_.speed_multiplier <= 0.0) {
+    params_.speed_multiplier = 1.0;
+  }
+  params_.speed_multiplier = std::clamp(
+      params_.speed_multiplier, kSpeedMultiplierMin, kSpeedMultiplierMax);
+  const double inverse = 1.0 / params_.speed_multiplier;
+  auto scale = [inverse](int ms) {
+    return std::max(1, base::saturated_cast<int>(std::round(ms * inverse)));
+  };
+  // browser: typed text keeps the typist's own rhythm. The delay range and
+  // the speed set the pace, by the range's middle against the default's (the
+  // typist is then one of that speed: MakeTypist); the hold range stretches
+  // the holds by its middle against the default's, within limits. The sums
+  // are of doubles: the ranges are any integers a caller sends.
+  const double delay_min = std::max(0, params_.keystroke_delay_min_ms);
+  const double delay_max =
+      std::max<double>(delay_min, params_.keystroke_delay_max_ms);
+  pace_ = std::max(1.0, (delay_min + delay_max) / 2.0) / kDefaultDelayMiddleMs *
+          inverse;
+  const double hold_min = std::max(0, params_.key_hold_min_ms);
+  const double hold_max = std::max<double>(hold_min, params_.key_hold_max_ms);
+  hold_scale_ = std::clamp(
+      std::max(1.0, (hold_min + hold_max) / 2.0) / kDefaultHoldMiddleMs,
+      kHoldDialLeast, kHoldDialMost);
+  scaled_hold_min_ms_ = std::max(kMinHoldMs, scale(params_.key_hold_min_ms));
+  scaled_hold_max_ms_ = std::max({scaled_hold_min_ms_, kMinHoldRangeTopMs,
+                                  scale(params_.key_hold_max_ms)});
+  scaled_thinking_min_ms_ = scale(params_.thinking_pause_min_ms);
+  scaled_thinking_max_ms_ =
+      std::max(scaled_thinking_min_ms_, scale(params_.thinking_pause_max_ms));
+}
+
+KeyboardTypingSession::~KeyboardTypingSession() {
+  if (callback_) {
+    // browser: its keys had gone down (KeysDown).
+    std::move(callback_).Run(KeysDown(), typos_);
+  }
+}
+
+void KeyboardTypingSession::Start() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+  if (params_.chord) {
+    BuildChord();
+    ReportChord();
+  } else {
+    codepoints_ = DecodeUtf8(params_.text);
+    BuildSchedule();
+  }
+
+  if (schedule_.empty()) {
+    Finish(true);
+    return;
+  }
+  // browser: time starts on the keyboard's next report, so that every
+  // session's events lie on the one clock the keyboard reports by.
+  dispatch_start_ = NextReport(base::TimeTicks::Now(), IdentityReportMs());
+  ContinueHeldRepeat();
+  DispatchPending();
+}
+
+void KeyboardTypingSession::BuildSchedule() {
+  intended_index_ = 0;
+  strokes_.clear();
+  strokes_.reserve(codepoints_.size() + codepoints_.size() / 8);
+  pending_thought_ms_ = 0;
+  pending_break_ms_ = 0;
+
+  // First which keys are pressed, typos and their corrections included;
+  // then when (PlaceStrokes).
+  while (intended_index_ < codepoints_.size()) {
+    const char32_t c = codepoints_[intended_index_];
+
+    // A thinking pause lengthens the gap before a key. Before the first key
+    // there is none to lengthen: the caller chose when to start.
+    if (Bernoulli(params_.thinking_pause_probability)) {
+      pending_thought_ms_ +=
+          RandInt(scaled_thinking_min_ms_, scaled_thinking_max_ms_);
+    }
+
+    // An injected typo consumes intended_index_ itself.
+    if (Bernoulli(params_.typo_probability) && MaybeInjectTypo(c)) {
+      typos_++;
+      continue;
+    }
+
+    EmitChar(c);
+    intended_index_++;
+  }
+  PlaceStrokes();
+}
+
+void KeyboardTypingSession::BuildChord() {
+  struct ChordModifier {
+    int bit;
+    const char* key;
+    const char* code;
+    int vkey;
+  };
+  static constexpr ChordModifier kChordModifiers[] = {
+      {2, "Control", "ControlLeft", 17},
+      {8, "Shift", "ShiftLeft", 16},
+      {1, "Alt", "AltLeft", 18},
+      {4, "Meta", "MetaLeft", 91},
+  };
+  const double speed = params_.speed_multiplier;
+  const auto scaled = [speed](int ms) {
+    return std::max(1, base::saturated_cast<int>(std::round(ms / speed)));
+  };
+  // browser: a key that stays the last one pressed for the keyboard's repeat
+  // delay repeats. The full chord sends no repeats, so however slowly it is
+  // pressed, none of its keys is down alone that long.
+  const auto alone = [this](int ms) {
+    return ms < kAloneLeastMs
+               ? ms
+               : std::min(ms, RandInt(kAloneLeastMs, kAloneMostMs));
+  };
+  cursor_time_ = base::TimeDelta();
+  KeyMapping mapping;
+  const bool has_key = !params_.chord_key.empty() &&
+                       BuildChordKeyMapping(params_.chord_key,
+                                            params_.chord_modifiers, &mapping);
+  int wanted = params_.chord_modifiers;
+  // A character only Shift reaches, such as '!' or 'A', is pressed with Shift
+  // down: the flag with no Shift key is something no keyboard produces.
+  if (has_key && mapping.needs_shift) {
+    wanted |= kModShift;
+  }
+  int held = params_.chord_phase == Params::ChordPhase::kUp ? wanted : 0;
+
+  if (params_.chord_phase != Params::ChordPhase::kUp) {
+    for (const ChordModifier& m : kChordModifiers) {
+      if (!(wanted & m.bit)) {
+        continue;
+      }
+      if (held) {
+        AdvanceMs(alone(RandInt(scaled(35), scaled(95))));
+      }
+      // The modifier's own keydown already reports it held, as a real one does.
+      held |= m.bit;
+      schedule_.push_back({cursor_time_, /*is_key_up=*/false, m.key, m.code,
+                           m.vkey, held, std::u16string(), /*location=*/1});
+    }
+  }
+  if (params_.chord_phase == Params::ChordPhase::kDown) {
+    return;
+  }
+
+  if (has_key) {
+    if (held) {
+      AdvanceMs(alone(RandInt(scaled(45), scaled(120))));
+    }
+    schedule_.push_back(
+        {cursor_time_, /*is_key_up=*/false, mapping.key, mapping.code,
+         mapping.windows_vkey, held,
+         (held & kModCommand) ? std::u16string() : mapping.text});
+    AdvanceMs(alone(RandInt(scaled_hold_min_ms_, scaled_hold_max_ms_) +
+                    RandInt(scaled(15), scaled(45))));
+    schedule_.push_back({cursor_time_, /*is_key_up=*/true, mapping.key,
+                         mapping.code, mapping.windows_vkey, held,
+                         std::u16string()});
+  }
+
+  for (auto it = std::rbegin(kChordModifiers); it != std::rend(kChordModifiers);
+       ++it) {
+    if (!(held & it->bit)) {
+      continue;
+    }
+    AdvanceMs(alone(RandInt(scaled(20), scaled(70))));
+    held &= ~it->bit;
+    schedule_.push_back({cursor_time_, /*is_key_up=*/true, it->key, it->code,
+                         it->vkey, held, std::u16string(), /*location=*/1});
+  }
+}
+
+void KeyboardTypingSession::EmitChar(char32_t c) {
+  Stroke stroke;
+  KeyMapping mapping;
+  if (BuildKeyMapping(c, &mapping)) {
+    stroke.key = std::move(mapping.key);
+    stroke.code = std::move(mapping.code);
+    stroke.windows_vkey = mapping.windows_vkey;
+    stroke.text = std::move(mapping.text);
+    stroke.base = mapping.base;
+    // A shifted character is typed with Shift: its own keydown first and its
+    // keyup after, as a hand does it. The flag alone, with no Shift key ever
+    // pressed, is something no keyboard produces.
+    stroke.shifted = mapping.needs_shift;
+  } else {
+    // A char outside the static map is dispatched as a keyDown carrying only
+    // the 'text' field, which the DOM routes through the input method path.
+    if (c < 0x10000) {
+      stroke.text.push_back(static_cast<char16_t>(c));
+    } else {
+      const char32_t v = c - 0x10000;
+      stroke.text.push_back(static_cast<char16_t>(0xD800 + (v >> 10)));
+      stroke.text.push_back(static_cast<char16_t>(0xDC00 + (v & 0x3FF)));
+    }
+    // The key value is the character itself, as UTF-8.
+    stroke.key = base::UTF16ToUTF8(stroke.text);
+  }
+  AppendStroke(std::move(stroke));
+}
+
+void KeyboardTypingSession::EmitBackspace() {
+  Stroke stroke;
+  stroke.key = "Backspace";
+  stroke.code = "Backspace";
+  stroke.windows_vkey = 8;
+  stroke.base = '\b';
+  AppendStroke(std::move(stroke));
+}
+
+void KeyboardTypingSession::AppendStroke(Stroke stroke) {
+  stroke.thought_ms = pending_thought_ms_;
+  stroke.break_ms = pending_break_ms_;
+  pending_thought_ms_ = 0;
+  pending_break_ms_ = 0;
+  strokes_.push_back(std::move(stroke));
+}
+
+void KeyboardTypingSession::AddBreak(int ms) {
+  pending_break_ms_ += std::max(ms, 1);
+}
+
+size_t KeyboardTypingSession::TypeChunk(size_t start, int max_chars) {
+  size_t position = start;
+  for (int typed = 0; typed < max_chars && position < codepoints_.size();
+       ++typed, ++position) {
+    EmitChar(codepoints_[position]);
+  }
+  return position;
+}
+
+void KeyboardTypingSession::EmitBackspaceBurst(int count) {
+  for (int k = 0; k < count; k++) {
+    EmitBackspace();
+  }
+}
+
+void KeyboardTypingSession::RetypeRange(size_t from, size_t to) {
+  for (size_t k = from; k < to; k++) {
+    EmitChar(codepoints_[k]);
+  }
+}
+
+void KeyboardTypingSession::PlaceStrokes() {
+  if (strokes_.empty()) {
+    return;
+  }
+  const Typist typist = MakeTypist(browser::PersonaSeed(), pace_);
+  TypingDraws draws(params_.seed);
+  // The events with their times in ms, which stay movable until the end: a
+  // key's release moves when the next key overlaps it, and a Shift's when
+  // another key is typed under it.
+  struct Timed {
+    double ms = 0;
+    bool is_shift = false;
+    ScheduledEvent event;
+  };
+  std::vector<Timed> events;
+  events.reserve(strokes_.size() * 2 + 16);
+  const auto shift_event = [](bool is_key_up) {
+    ScheduledEvent event;
+    event.is_key_up = is_key_up;
+    event.key = "Shift";
+    event.code = "ShiftLeft";
+    event.windows_vkey = 16;
+    event.location = 1;
+    return event;
+  };
+  // What tells one key from another: its code, or the character itself for
+  // one outside the map.
+  const auto id_of = [](const Stroke& stroke) -> const std::string& {
+    return stroke.code.empty() ? stroke.key : stroke.code;
+  };
+  // When each key last came up: it cannot go down again before.
+  std::map<std::string, double> last_release;
+  const Stroke* prev = nullptr;
+  double prev_press = 0;
+  int prev_up = -1;         // in `events`: the release of the key before
+  int shift_up = -1;        // the release of the Shift now or last held
+  bool shift_open = false;  // the stroke before was typed with it
+  double wait_until = 0;    // a Shift coming up, which a plain key awaits
+  // The draw of the gap to this stroke, made with the stroke before so that
+  // its hold can lean on it.
+  double z_gap = 0;
+
+  for (size_t i = 0; i < strokes_.size(); ++i) {
+    const Stroke& stroke = strokes_[i];
+    // Every stroke takes the same draws in the same order, whatever it needs.
+    const double z_next = draws.Normal();
+    const double z_hold = draws.Normal();
+    const double u_order = draws.Unit();
+    const double u_order_ms = draws.Unit();
+    const double u_overlap = draws.Unit();
+    const double u_again = draws.Unit();
+    const double z_lead = draws.Normal();
+    const double z_shift_up = draws.Normal();
+    const double u_after_shift = draws.Unit();
+    const double u_floor = draws.Unit();
+
+    const bool first = prev == nullptr;
+    const bool is_break = stroke.break_ms > 0 && !first;
+    // Shift is still down from the stroke before.
+    const bool held = stroke.shifted && shift_open && !is_break;
+    // A Shift of this stroke's own goes down this long before its key: the
+    // measured lead.
+    std::optional<double> lead;
+    if (stroke.shifted && !held) {
+      lead = std::max(typist.ShiftLead(z_lead), 20.0 + 10.0 * u_floor);
+    }
+    double press = 0;
+    if (first) {
+      // Time starts here.
+    } else if (is_break) {
+      // A break stands in for the gap, counted from the last key to come up;
+      // a Shift of this stroke's goes down after that key.
+      double latest_release = 0;
+      for (const Timed& timed : events) {
+        if (timed.event.is_key_up) {
+          latest_release = std::max(latest_release, timed.ms);
+        }
+      }
+      // (The pauses are whole milliseconds: a drawn part of one keeps the
+      // times off the whole ones.)
+      press = std::max(latest_release, wait_until) + stroke.break_ms +
+              stroke.thought_ms + u_overlap;
+      if (lead) {
+        press = std::max(press, latest_release + 10.0 + 30.0 * u_floor + *lead);
+      }
+    } else {
+      if (lead) {
+        // The hand goes to Shift once the key before is up (or a little
+        // before), then to the key: timed from that key's release, not from
+        // its press.
+        double down = std::max(events[prev_up].ms + stroke.thought_ms +
+                                   typist.stretch * typist.ShiftWait(z_gap),
+                               prev_press + 8.0 + 30.0 * u_floor);
+        if (shift_up >= 0) {
+          down = std::max(down, events[shift_up].ms + 10.0 + 30.0 * u_floor);
+        }
+        press = down + *lead;
+      } else if (prev->shifted && !stroke.shifted) {
+        // After a key typed with Shift the hand leaves Shift first: timed
+        // from Shift's release, as measured. A key never goes down under a
+        // Shift it is not typed with: what would fall before the moment
+        // after Shift's release is folded back behind it.
+        double after =
+            stroke.thought_ms + typist.stretch * typist.ShiftNext(z_gap);
+        const double soonest = wait_until - events[shift_up].ms;
+        if (after < soonest) {
+          after = soonest + 0.6 * (soonest - after);
+        }
+        press = events[shift_up].ms + after;
+      } else {
+        // Without context every pair is timed as one kind.
+        const std::optional<KeyPair> pair =
+            params_.context_aware ? PairOf(prev->base, stroke.base)
+                                  : std::optional<KeyPair>(kSameHand);
+        const double letters = params_.context_aware
+                                   ? LetterPairFactor(prev->base, stroke.base)
+                                   : 1.0;
+        press = prev_press + stroke.thought_ms +
+                typist.stretch * typist.Gap(pair, z_gap) * letters;
+      }
+      // A key does not go down again within a moment of coming up,
+      // whichever key was pressed in between.
+      const auto again = last_release.find(id_of(stroke));
+      if (again != last_release.end()) {
+        press = std::max(press, again->second + 18.0 + 27.0 * u_again);
+      }
+      if (!lead && !held) {
+        press = std::max(press, wait_until);
+      }
+    }
+
+    std::optional<KeyPair> next_pair;
+    if (i + 1 < strokes_.size() && !(strokes_[i + 1].break_ms > 0) &&
+        params_.context_aware) {
+      next_pair = PairOf(stroke.base, strokes_[i + 1].base);
+    }
+    z_gap = z_next;
+    const double lean = next_pair ? kHoldLean[*next_pair] * -z_gap : 0.0;
+    const double release =
+        press + typist.Hold(stroke.base, next_pair, z_hold, lean, hold_scale_);
+
+    if (prev_up >= 0 && !is_break && events[prev_up].ms > press) {
+      // The key before is still down. A very short overlap is lifted a
+      // little, and the key nearly always comes up before this one does.
+      double& up = events[prev_up].ms;
+      double over = up - press;
+      over += kOverlapLiftMs * std::sqrt(u_overlap) *
+              std::exp(-over / kOverlapLiftMs);
+      up = press + over;
+      if (up > release && u_order < kKeepReleaseOrder) {
+        // (Never later than it was, nor a hold cut very short.)
+        up = std::min(
+            up,
+            std::max(release + kKeepReleaseOrderMs *
+                                   std::log(1.0 - 0.999 * u_order_ms),
+                     prev_press + kMinTypedHoldMs + 12.0 * (1.0 + u_overlap)));
+      }
+      last_release[id_of(*prev)] = up;
+    }
+
+    if (stroke.shifted) {
+      // Up around its key's release, more often just before it, and not
+      // within a moment of the key's press: what would fall earlier is
+      // folded back behind that moment.
+      double up_at = release + typist.ShiftUp(z_shift_up);
+      const double soonest = press + 15.0;
+      if (up_at < soonest) {
+        up_at = soonest + 0.35 * (soonest - up_at);
+      }
+      if (held) {
+        events[shift_up].ms = up_at;
+      } else {
+        events.push_back(
+            {press - *lead, /*is_shift=*/true, shift_event(false)});
+        shift_up = static_cast<int>(events.size());
+        events.push_back({up_at, /*is_shift=*/true, shift_event(true)});
+      }
+      wait_until = up_at + 5.0 + 4.0 * u_after_shift;
+    }
+    shift_open = stroke.shifted;
+
+    ScheduledEvent down_event;
+    down_event.key = stroke.key;
+    down_event.code = stroke.code;
+    down_event.windows_vkey = stroke.windows_vkey;
+    down_event.modifiers = stroke.shifted ? kModShift : 0;
+    down_event.base = stroke.base;
+    // The keyUp carries no text; the keyDown inserted it.
+    ScheduledEvent up_event = down_event;
+    up_event.is_key_up = true;
+    down_event.text = stroke.text;
+    events.push_back({press, /*is_shift=*/false, std::move(down_event)});
+    prev_up = static_cast<int>(events.size());
+    events.push_back({release, /*is_shift=*/false, std::move(up_event)});
+    prev = &stroke;
+    prev_press = press;
+    last_release[id_of(stroke)] = release;
+  }
+
+  // What the keyboard and the system make of the hand's events: each waits
+  // for the keyboard's next report, and a Shift held alone repeats.
+  std::ranges::stable_sort(events, {}, &Timed::ms);
+  std::vector<HandEvent> hand;
+  hand.reserve(events.size());
+  for (const Timed& timed : events) {
+    hand.push_back({timed.ms, !timed.event.is_key_up, timed.is_shift});
+  }
+  bool shift_down = false;
+  schedule_.reserve(events.size());
+  // The first event's report is where time starts.
+  for (const ReportedEvent& reported :
+       ReportEvents(hand, hand.front().ms, typist.report_ms, params_.seed,
+                    /*repeat_shift=*/true)) {
+    const Timed& timed = events[reported.source];
+    ScheduledEvent event = timed.event;
+    event.time_offset =
+        base::Microseconds(base::ClampRound<int64_t>(reported.ms * 1000.0));
+    if (reported.repeat) {
+      // A held Shift's keydown again.
+      event.repeat = true;
+    } else if (timed.is_shift) {
+      shift_down = !event.is_key_up;
+    } else if (event.is_key_up) {
+      // A key reports what it gives under the Shift of that moment: "A"
+      // released after its Shift reads "a", and "a" released under the next
+      // key's Shift reads "A".
+      std::string key = KeyUnderShift(event.base, shift_down);
+      if (!key.empty()) {
+        event.key = std::move(key);
+      }
+    } else {
+      // A key goes down under Shift exactly when its stroke asked for it.
+      DCHECK_EQ(shift_down, (event.modifiers & kModShift) != 0);
+    }
+    event.modifiers = shift_down ? kModShift : 0;
+    schedule_.push_back(std::move(event));
+  }
+  strokes_.clear();
+}
+
+void KeyboardTypingSession::ReportChord() {
+  // browser: a chord's keys reach the browser through the keyboard's reports
+  // as typed ones do, counted from the session's start.
+  std::vector<HandEvent> hand;
+  hand.reserve(schedule_.size());
+  for (const ScheduledEvent& event : schedule_) {
+    hand.push_back({event.time_offset.InMillisecondsF(), !event.is_key_up,
+                    /*is_shift=*/false});
+  }
+  for (const ReportedEvent& reported :
+       ReportEvents(hand, /*origin=*/0.0, IdentityReportMs(), rng_(),
+                    /*repeat_shift=*/false)) {
+    schedule_[reported.source].time_offset =
+        base::Microseconds(base::ClampRound<int64_t>(reported.ms * 1000.0));
+  }
+}
+
+void KeyboardTypingSession::AdvanceMs(int ms) {
+  if (ms <= 0) {
+    return;
+  }
+  cursor_time_ += base::Milliseconds(ms);
+}
+
+bool KeyboardTypingSession::MaybeInjectTypo(char32_t intended_char) {
+  if (!IsTypoEligible(intended_char)) {
+    return false;
+  }
+  // Every correction pattern detects the mistake a few chars later, so the
+  // last char of the input never gets a typo.
+  if (intended_index_ + 1 >= codepoints_.size()) {
+    return false;
+  }
+
+  const double roll = RandDouble();
+  if (roll < 0.70) {
+    // Adjacent typo, falling through to the other kinds when the char has no
+    // neighbour in the QWERTY map.
+    if (const char32_t wrong = PickAdjacent(intended_char)) {
+      InjectAdjacentTypo(wrong);
+      return true;
+    }
+  }
+  if (roll < 0.90) {
+    InjectDoubledTypo(intended_char);
+    return true;
+  }
+  InjectOmissionTypo(intended_char);
+  return true;
+}
+
+char32_t KeyboardTypingSession::PickAdjacent(char32_t c) {
+  // The neighbour keeps the source char's shift state: 'A' typos to 'S' or
+  // 'Q', not 's', and '@' to '!' or '#'. Adjacency is looked up on the
+  // unshifted form and the shift re-applied afterwards.
+  char32_t lookup = c;
+  bool to_upper = false;
+  bool was_shifted_digit = false;
+  if (c >= U'A' && c <= U'Z') {
+    lookup = U'a' + (c - U'A');
+    to_upper = true;
+  } else if (const char digit = UnshiftDigitSymbol(c)) {
+    lookup = digit;
+    was_shifted_digit = true;
+  }
+  const std::string_view adjacent = LookupAdjacent(lookup);
+  if (adjacent.empty()) {
+    return 0;
+  }
+  std::uniform_int_distribution<size_t> dist(0, adjacent.size() - 1);
+  const char picked = adjacent[dist(rng_)];
+
+  if (to_upper && picked >= 'a' && picked <= 'z') {
+    return picked - 'a' + 'A';
+  }
+  // A digit neighbour of a shifted symbol maps back to its shifted form; a
+  // letter neighbour stays lowercase, which is a valid typo of its own.
+  if (was_shifted_digit && picked >= '0' && picked <= '9') {
+    return kShiftedDigits[picked - '0'];
+  }
+  return picked;
+}
+
+void KeyboardTypingSession::InjectAdjacentTypo(char32_t wrong_char) {
+  // The wrong key is typed as any key is: its gap is the one from the key
+  // before to it.
+  EmitChar(wrong_char);
+
+  // Keep typing 1..4 intended chars before noticing, as a typist would.
+  size_t position = intended_index_ + 1;
+  const size_t end = TypeChunk(position, RandInt(1, 4));
+  const int typed_after = static_cast<int>(end - position);
+
+  AddBreak(RandInt(kRealizePauseMinMs, kRealizePauseMaxMs));
+  // Delete the chars typed after the typo, then the typo itself.
+  EmitBackspaceBurst(typed_after + 1);
+
+  // Recover and re-type [intended_index_, end). The recovery pause stands in
+  // for the first gap, and the corrected pass never gets a second typo.
+  AddBreak(RandInt(kPostCorrectionMinMs, kPostCorrectionMaxMs));
+  RetypeRange(intended_index_, end);
+  intended_index_ = end;
+}
+
+void KeyboardTypingSession::InjectDoubledTypo(char32_t intended_char) {
+  // The char is typed correctly, then again by accident: the same key
+  // twice, which has its own timing.
+  EmitChar(intended_char);
+  EmitChar(intended_char);
+
+  const size_t position = intended_index_ + 1;
+  const size_t end = TypeChunk(position, RandInt(1, 4));
+  const int typed_after = static_cast<int>(end - position);
+
+  AddBreak(RandInt(kRealizePauseMinMs, kRealizePauseMaxMs));
+  // Delete the duplicate and everything typed after it.
+  EmitBackspaceBurst(typed_after + 1);
+
+  // The correct char is still in the field; re-type only what followed.
+  AddBreak(RandInt(kPostCorrectionMinMs, kPostCorrectionMaxMs));
+  RetypeRange(position, end);
+  intended_index_ = end;
+}
+
+void KeyboardTypingSession::InjectOmissionTypo(char32_t intended_char) {
+  // The char after the omitted one is typed in its place.
+  size_t position = intended_index_ + 1;
+  if (position >= codepoints_.size()) {
+    EmitChar(intended_char);
+    intended_index_++;
+    return;
+  }
+  EmitChar(codepoints_[position]);
+  position++;
+  int typed_after = 1;
+  const int detect_target = RandInt(1, 4);
+  while (typed_after < detect_target && position < codepoints_.size()) {
+    EmitChar(codepoints_[position]);
+    position++;
+    typed_after++;
+  }
+
+  AddBreak(RandInt(kRealizePauseMinMs, kRealizePauseMaxMs));
+  // Only the chars typed after the omission are deleted; the omitted char
+  // was never typed.
+  EmitBackspaceBurst(typed_after);
+
+  // Re-type the omitted char and everything just deleted.
+  AddBreak(RandInt(kPostCorrectionMinMs, kPostCorrectionMaxMs));
+  RetypeRange(intended_index_, position);
+  intended_index_ = position;
+}
+
+void KeyboardTypingSession::DispatchPending() {
+  if (!widget_host_) {
+    Finish(KeysDown());  // browser: as the destructor
+    return;
+  }
+  if (next_index_ >= schedule_.size()) {
+    Finish(true);
+    return;
+  }
+
+  // browser: how late this wake came, when it was a precise one.
+  const base::TimeTicks task_began = base::TimeTicks::Now();
+  if (!precise_wake_at_.is_null()) {
+    NoteWake(precise_wake_at_, task_began);
+    precise_wake_at_ = base::TimeTicks();
+  }
+  const base::TimeDelta wait_out = WaitOutTime();
+
+  // Focus the widget, as dispatchKeyEvent does on every call. Cheap when
+  // already focused.
+  widget_host_->Focus();
+
+  while (next_index_ < schedule_.size()) {
+    const ScheduledEvent& ev = schedule_[next_index_];
+    // browser: an event goes out at its time, not before and, when the wake
+    // was in time, not after: the last stretch is waited out here (see
+    // kWaitOutLeast). The events of one keyboard report, a tenth of a
+    // millisecond apart, go out in one wake that way. One task waits
+    // kWaitOutMost in all: what is left takes a wake of its own, and the
+    // thread's other work goes in between. A repeat is not waited for.
+    const base::TimeTicks due = dispatch_start_ + ev.time_offset;
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (due > now) {
+      if (ev.repeat || due - now > wait_out ||
+          due - task_began > kWaitOutMost) {
+        break;
+      }
+      WaitOut(due);
+    }
+
+    // kKeyDown is what the dispatchKeyEvent path uses for "keyDown": the
+    // renderer generates both the raw key event and the char event from it.
+    const blink::WebInputEvent::Type type =
+        ev.is_key_up ? blink::WebInputEvent::Type::kKeyUp
+                     : blink::WebInputEvent::Type::kKeyDown;
+    int blink_modifiers =
+        blink::WebInputEvent::kFromDebugger |
+        ui::EventFlagsToWebEventModifiers(LockKeyEventFlags());
+    for (const ModifierBit& bit : kModifierBits) {
+      if (ev.modifiers & bit.cdp_bit) {
+        blink_modifiers |= bit.blink_modifier;
+      }
+    }
+    // Which Ctrl or Shift it was, as a real key reports it: location 1 for
+    // the left one, 2 for the right.
+    if (ev.location == 1) {
+      blink_modifiers |= blink::WebInputEvent::kIsLeft;
+    } else if (ev.location == 2) {
+      blink_modifiers |= blink::WebInputEvent::kIsRight;
+    }
+    if (ev.repeat) {
+      blink_modifiers |= blink::WebInputEvent::kIsAutoRepeat;
+    }
+
+    // browser: stamped as it goes, as Chrome stamps a real key event when its
+    // UI thread handles it, so the page finds it no older than its trip (a
+    // fifth of a millisecond). Each stamp is at least 50 us after the one
+    // before (synthetic_mouse_path_gesture.cc has the same rules for a
+    // press).
+    const base::TimeTicks stamp =
+        std::max(base::TimeTicks::Now(), last_stamp_ + base::Microseconds(50));
+    last_stamp_ = stamp;
+    input::NativeWebKeyboardEvent event(type, blink_modifiers, stamp);
+    event.windows_key_code = ev.windows_vkey;
+    event.native_key_code = ev.windows_vkey;
+    event.skip_if_unhandled = true;
+    if (!ev.code.empty()) {
+      event.dom_code =
+          static_cast<int>(ui::KeycodeConverter::CodeStringToDomCode(ev.code));
+    }
+    if (!ev.key.empty()) {
+      event.dom_key =
+          static_cast<int>(ui::KeycodeConverter::KeyStringToDomKey(ev.key));
+    }
+    if (!ev.text.empty() &&
+        ev.text.size() < blink::WebKeyboardEvent::kTextLengthCap) {
+      // unmodified_text mirrors text, as for any non-modifier key.
+      std::ranges::copy(ev.text, event.text.begin());
+      std::ranges::copy(ev.text, event.unmodified_text.begin());
+    }
+
+    // The InputInjector path is bypassed: no per-event ack is needed, since
+    // the CDP callback fires once at the end of the session.
+    const base::WeakPtr<KeyboardTypingSession> weak_this =
+        weak_factory_.GetWeakPtr();
+    widget_host_->ForwardKeyboardEventWithCommands(
+        event, ui::LatencyInfo(), std::vector<blink::mojom::EditCommandPtr>());
+    // Dispatch may destroy the session (e.g. Ctrl+W).
+    if (!weak_this) {
+      return;
+    }
+    next_index_++;
+    // browser: or take the widget away.
+    if (!widget_host_) {
+      Finish(KeysDown());
+      return;
+    }
+  }
+
+  if (next_index_ >= schedule_.size() && !ScheduleAutoRepeat()) {
+    Finish(true);
+    return;
+  }
+  // browser: the wake for the next event is a precise one, a little before
+  // the event (the rest is waited out above). An ordinary delayed task runs
+  // up to a tick of Windows' timer late (15.6 ms), and every key would go out
+  // that long after its time. Precise wakes are for short waits only (base's
+  // kMaxPreciseDelay, 36 ms): a longer wait first takes an ordinary wake
+  // before that, which finds nothing due and comes here again.
+  const ScheduledEvent& next = schedule_[next_index_];
+  const base::TimeTicks wake = dispatch_start_ + next.time_offset -
+                               (next.repeat ? base::TimeDelta() : wait_out);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const bool soon = wake - now <= kPreciseWakeWithin;
+  // Only a wake that waits on the timer says something about it: not one
+  // asked for at once (the task's waiting was used up).
+  if (soon && wake - now >= base::Milliseconds(1)) {
+    precise_wake_at_ = wake;
+  }
+  timer_.Start(FROM_HERE,
+               soon ? std::max(wake, now) : wake - kPreciseWakeWithin,
+               base::BindOnce(&KeyboardTypingSession::DispatchPending,
+                              weak_factory_.GetWeakPtr()),
+               soon ? base::subtle::DelayPolicy::kPrecise
+                    : base::subtle::DelayPolicy::kFlexibleNoSooner);
+}
+
+std::optional<KeyboardTypingSession::HeldRepeat>
+KeyboardTypingSession::PendingRepeat() const {
+  if (!holding() || !timer_.IsRunning() || next_index_ >= schedule_.size() ||
+      !schedule_.back().repeat) {
+    return std::nullopt;
+  }
+  const ScheduledEvent& ev = schedule_.back();
+  HeldRepeat held;
+  held.key = ev.key;
+  held.code = ev.code;
+  held.windows_vkey = ev.windows_vkey;
+  held.modifiers = ev.modifiers;
+  held.location = ev.location;
+  held.next = dispatch_start_ + ev.time_offset;
+  return held;
+}
+
+void KeyboardTypingSession::ContinueHeldRepeat() {
+  if (!params_.held_repeat) {
+    return;
+  }
+  const HeldRepeat& held = *params_.held_repeat;
+  // It repeats until its keyup, or until a key goes down before that, which
+  // stops a real repeat.
+  std::optional<base::TimeDelta> until;
+  for (const ScheduledEvent& ev : schedule_) {
+    if (!ev.is_key_up || ev.key == held.key) {
+      until = ev.time_offset;
+      break;
+    }
+  }
+  if (!until) {
+    return;
+  }
+  std::vector<ScheduledEvent> repeats;
+  // browser: when it is due, and not before now. (The session's own time
+  // starts on the keyboard's next report, up to 8 ms from now; the held key's
+  // repeats are the system's, which waits for no report.)
+  base::TimeDelta at =
+      std::max(held.next, base::TimeTicks::Now()) - dispatch_start_;
+  while (at < *until) {
+    ScheduledEvent ev;
+    ev.time_offset = at;
+    ev.key = held.key;
+    ev.code = held.code;
+    ev.windows_vkey = held.windows_vkey;
+    ev.modifiers = held.modifiers;
+    ev.location = held.location;
+    ev.repeat = true;
+    repeats.push_back(std::move(ev));
+    int gap_ms = RandInt(kRepeatIntervalMinMs, kRepeatIntervalMaxMs);
+    if (Bernoulli(0.05)) {
+      gap_ms += RandInt(5, 15);
+    }
+    at += base::Milliseconds(gap_ms) + PartOfAMillisecond();
+  }
+  if (repeats.empty()) {
+    return;
+  }
+  schedule_.insert(schedule_.begin(), repeats.begin(), repeats.end());
+  std::stable_sort(schedule_.begin(), schedule_.end(),
+                   [](const ScheduledEvent& a, const ScheduledEvent& b) {
+                     return a.time_offset < b.time_offset;
+                   });
+}
+
+bool KeyboardTypingSession::ScheduleAutoRepeat() {
+  if (!params_.chord || params_.chord_phase != Params::ChordPhase::kDown ||
+      schedule_.empty() || schedule_.back().is_key_up) {
+    return false;
+  }
+  // The keys are down: that is what the call asked for. The session lives on,
+  // repeating, until the next one replaces it.
+  if (callback_) {
+    std::move(callback_).Run(true, typos_);
+  }
+  const base::TimeDelta now = base::TimeTicks::Now() - dispatch_start_;
+  if (now > kMaxHold) {
+    return false;
+  }
+  ScheduledEvent next = schedule_.back();
+  int gap_ms;
+  if (!next.repeat) {
+    next.repeat = true;
+    gap_ms = kRepeatDelayMs + RandInt(0, 8);
+  } else {
+    gap_ms = RandInt(kRepeatIntervalMinMs, kRepeatIntervalMaxMs);
+    if (Bernoulli(0.05)) {
+      gap_ms += RandInt(5, 15);
+    }
+  }
+  next.time_offset = std::max(
+      next.time_offset + base::Milliseconds(gap_ms) + PartOfAMillisecond(),
+      now);
+  schedule_.push_back(std::move(next));
+  return true;
+}
+
+void KeyboardTypingSession::Finish(bool success) {
+  timer_.Stop();
+  if (callback_) {
+    std::move(callback_).Run(success, typos_);
+  }
+}
+
+bool KeyboardTypingSession::KeysDown() const {
+  return params_.chord ? ChordKeySent() : TextKeysDown();
+}
+
+bool KeyboardTypingSession::ChordKeySent() const {
+  if (!params_.chord || params_.chord_key.empty()) {
+    return false;
+  }
+  // Its keydown, among the events sent: a key down that is not a repeat and
+  // not one of the modifiers BuildChord presses around it.
+  for (size_t i = 0; i < next_index_ && i < schedule_.size(); ++i) {
+    const ScheduledEvent& ev = schedule_[i];
+    if (!ev.is_key_up && !ev.repeat && ev.key != "Control" &&
+        ev.key != "Shift" && ev.key != "Alt" && ev.key != "Meta") {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool KeyboardTypingSession::TextKeysDown() const {
+  if (params_.chord || next_index_ == 0) {
+    return false;
+  }
+  // Every keydown has gone out, its corrections' too: only keyups are left.
+  for (size_t i = next_index_; i < schedule_.size(); ++i) {
+    if (!schedule_[i].is_key_up) {
+      return false;
+    }
+  }
+  return true;
+}
+
+int KeyboardTypingSession::RandInt(int min_inclusive, int max_inclusive) {
+  if (max_inclusive <= min_inclusive) {
+    return min_inclusive;
+  }
+  std::uniform_int_distribution<int> dist(min_inclusive, max_inclusive);
+  return dist(rng_);
+}
+
+double KeyboardTypingSession::RandDouble() {
+  std::uniform_real_distribution<double> dist(0.0, 1.0);
+  return dist(rng_);
+}
+
+base::TimeDelta KeyboardTypingSession::PartOfAMillisecond() {
+  return base::Microseconds(RandInt(0, 999));
+}
+
+bool KeyboardTypingSession::Bernoulli(double p) {
+  if (p <= 0.0) {
+    return false;
+  }
+  if (p >= 1.0) {
+    return true;
+  }
+  return RandDouble() < p;
+}
+
+}  // namespace content
