new file mode 100644
index 0000000000..e4e5c07aca
--- /dev/null
+++ b/content/browser/devtools/protocol/keyboard_typing_session.h
@@ -0,0 +1,292 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_KEYBOARD_TYPING_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_KEYBOARD_TYPING_SESSION_H_
+
+#include <cstdint>
+#include <optional>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace content {
+
+class RenderWidgetHostImpl;
+
+// Drives the typing animation behind Input.dispatchKeystrokes. The session
+// precomputes the full event schedule from the input text, including any
+// injected typos and their corrections, then walks it on the UI thread with a
+// base::DeadlineTimer, dispatching keyDown / keyUp events straight to
+// RenderWidgetHostImpl::ForwardKeyboardEventWithCommands.
+//
+// Dispatching from the browser process is the point: with one
+// Input.dispatchKeyEvent per key, every keystroke pays a serialization and
+// ack round trip, which caps the achievable typing rate.
+//
+// browser: typed text has one person's rhythm. Each key is timed from the key
+// before it, by a gap that depends on the two keys, and is held for a time
+// of its own, so a quick hand has the next key down before the last is up,
+// as people do. The typist is the identity's: the same persona seed types
+// with the same speed and holds in every session (the .cc file says what was
+// measured, and by whom). And there is one keyboard: every key event, a
+// chord's too, waits for the keyboard's next report (every 8 ms) and is
+// sent a small, uneven moment after it, to a few microseconds, stamped as it
+// goes.
+//
+// One session serves one CDP call. InputHandler owns it; destroying it
+// mid-stream stops the timer and runs the completion callback with
+// success=false, which fails the CDP call -- unless its keys had gone down
+// already (KeysDown).
+class KeyboardTypingSession {
+ public:
+  // A key held down and repeating, handed from the session holding it to the
+  // one that lets it go, so it repeats until its keyup actually goes out.
+  struct HeldRepeat {
+    std::string key;
+    std::string code;
+    int windows_vkey = 0;
+    int modifiers = 0;
+    int location = 0;
+    base::TimeTicks next;  // when its next repeat is due
+  };
+
+  struct Params {
+    // UTF-8 text to type. '\n' maps to Enter.
+    std::string text;
+    // Sets the pace, with the delay range below, and divides the thinking
+    // pauses. 1.0 is the identity's own typing; larger values type faster,
+    // as a faster typist does (the keys overlap more, the holds hardly
+    // change), up to about 110 words a minute, where it stops: nobody types
+    // a rhythm ten times as fast. The session holds it to 0.05 to 20, and
+    // takes anything but a positive number as 1.0.
+    double speed_multiplier = 1.0;
+    // The pace, as a range in ms: the range's middle over the default's
+    // (160 ms) is how much slower the typist types. The defaults leave the
+    // typist's own pace.
+    int keystroke_delay_min_ms = 60;
+    int keystroke_delay_max_ms = 260;
+    // The same for how long a key is held: the typist's holds are stretched
+    // by the range's middle over the default's (97.5 ms), by 0.6 to 1.6 at
+    // most. A typed key's hold is never as long as the keyboard's repeat
+    // delay.
+    int key_hold_min_ms = 65;
+    int key_hold_max_ms = 130;
+    // Whether a gap depends on the two keys it lies between: which hands and
+    // fingers press them, and how often the two letters meet. Without it
+    // every pair of keys is timed alike.
+    bool context_aware = true;
+    // Per-character probability of a "thinking pause" before the key.
+    double thinking_pause_probability = 0.0;
+    int thinking_pause_min_ms = 300;
+    int thinking_pause_max_ms = 800;
+    // Per-character probability of injecting a typo. 0 disables typos.
+    double typo_probability = 0.0;
+    // RNG seed. The same seed, params and text give the same schedule.
+    uint64_t seed = 0;
+
+    // A key chord instead of text: chord_modifiers (CDP bits) go down as
+    // left-hand keys, Ctrl, Shift, Alt then Meta; then chord_key, if any,
+    // with them; then everything comes up in reverse. chord_phase limits it to
+    // the modifiers going down and staying down, or to held modifiers coming
+    // up -- a modifier held across a mouse click.
+    bool chord = false;
+    int chord_modifiers = 0;
+    // A key name (Escape, Enter, ArrowDown, ...), one character, or empty
+    // for modifiers only. See IsChordKey.
+    std::string chord_key;
+    enum class ChordPhase { kFull, kDown, kUp };
+    ChordPhase chord_phase = ChordPhase::kFull;
+    // For the up phase: the key the replaced session held, repeating.
+    std::optional<HeldRepeat> held_repeat;
+  };
+
+  // Runs once, with success=true when the schedule completed and false when
+  // the session aborted (widget destroyed mid-stream, session cancelled) --
+  // true still when its keys had gone down (KeysDown) -- and how many typos
+  // the schedule made and corrected.
+  using CompletionCallback =
+      base::OnceCallback<void(bool success, int typos_corrected)>;
+
+  KeyboardTypingSession(base::WeakPtr<RenderWidgetHostImpl> widget_host,
+                        Params params,
+                        CompletionCallback callback);
+
+  KeyboardTypingSession(const KeyboardTypingSession&) = delete;
+  KeyboardTypingSession& operator=(const KeyboardTypingSession&) = delete;
+
+  // Runs the completion callback with success=false if it has not fired --
+  // true when its keys had gone down (KeysDown).
+  ~KeyboardTypingSession();
+
+  // Begins dispatching. Must be called exactly once. The session may finish
+  // synchronously inside this call if the schedule is empty.
+  void Start();
+
+  // Whether a chord can press `key`: a named key such as Escape, Enter, Tab,
+  // Backspace, Delete, Insert, Home, End, PageUp, PageDown, the arrows, F1-F12
+  // or Space, or one character on the US keyboard.
+  static bool IsChordKey(const std::string& key);
+
+  // Whether this is a chord's down phase with its keys down: its call has been
+  // answered, and the last key repeats until the session is replaced.
+  bool holding() const {
+    return params_.chord && params_.chord_phase == Params::ChordPhase::kDown &&
+           !callback_;
+  }
+
+  // The repeat a holding session would send next, or nothing.
+  std::optional<HeldRepeat> PendingRepeat() const;
+
+ private:
+  struct ScheduledEvent {
+    base::TimeDelta time_offset;  // from session start
+    bool is_key_up = false;
+    std::string key;   // DOM 'key' string, e.g. "a", "Backspace"
+    std::string code;  // DOM 'code' string, e.g. "KeyA"
+    int windows_vkey = 0;
+    int modifiers = 0;    // CDP modifier bits: alt=1, ctrl=2, meta=4, shift=8
+    std::u16string text;  // only set for the keyDown of printable chars
+    int location = 0;     // KeyboardEvent.location: 1 left, 2 right
+    bool repeat = false;  // an auto-repeat keydown of a held key
+    // For typed text: the key's own character, the one it gives without
+    // Shift; 0 for a key outside the map.
+    char base = 0;
+  };
+
+  // One key of typed text, before it has a time. The schedule is built in
+  // two steps: which keys are pressed, typos and their corrections included
+  // (strokes_), then when each goes down and comes up (PlaceStrokes).
+  struct Stroke {
+    std::string key;
+    std::string code;
+    int windows_vkey = 0;
+    std::u16string text;
+    char base = 0;         // as ScheduledEvent's
+    bool shifted = false;  // typed with Shift held
+    // A pause before the key: a thought is added to its gap, a break stands
+    // in for the gap and counts from the last key to come up (noticing a
+    // typo, finding the place again).
+    double thought_ms = 0;
+    double break_ms = 0;
+  };
+
+  // Schedule generation, run from Start().
+  void BuildSchedule();
+  void BuildChord();
+  void EmitChar(char32_t c);
+  void EmitBackspace();
+  // Appends the stroke, with the pauses that wait for the next key.
+  void AppendStroke(Stroke stroke);
+  // The next stroke comes after a break of `ms`.
+  void AddBreak(int ms);
+  // Times strokes_ as the identity's typist types them, into schedule_.
+  void PlaceStrokes();
+  // For a chord: moves its timeline on.
+  void AdvanceMs(int ms);
+  // For a chord: puts its events on the keyboard's reports, as PlaceStrokes
+  // does for typed text.
+  void ReportChord();
+  // Types up to `max_chars` codepoints from `start`, stopping at the end of
+  // the input. Returns the position after the last typed codepoint.
+  size_t TypeChunk(size_t start, int max_chars);
+  // Emits `count` backspaces.
+  void EmitBackspaceBurst(int count);
+  // Re-types the codepoints in [from, to); the caller's recovery pause
+  // stands in for the gap before the first one.
+  void RetypeRange(size_t from, size_t to);
+
+  // Typo injection. Each moves intended_index_ past the consumed characters.
+  // MaybeInjectTypo returns true when a typo was injected, in which case the
+  // caller skips its own emit.
+  bool MaybeInjectTypo(char32_t intended_char);
+  void InjectAdjacentTypo(char32_t wrong_char);
+  void InjectDoubledTypo(char32_t intended_char);
+  void InjectOmissionTypo(char32_t intended_char);
+  // Picks a QWERTY neighbour of `c`, keeping its shift state. Returns 0 when
+  // no adjacency is known.
+  char32_t PickAdjacent(char32_t c);
+
+  // Dispatch loop, run from the timer.
+  void DispatchPending();
+  // For a chord's down phase whose keys are all down: answers the call and
+  // appends the next auto-repeat of the last key pressed. False when there is
+  // nothing to repeat, or it has been held long enough.
+  bool ScheduleAutoRepeat();
+  // For an up phase: repeats of the key the replaced session held, until this
+  // session's keyup for it (or a key pressed before that).
+  void ContinueHeldRepeat();
+  void Finish(bool success);
+  // browser: whether a session ended before its last events
+  // did what it was asked: an Enter that submits a form swaps the renderer
+  // before its keyup goes out (ClearInputState ends the session). A chord:
+  // its own key's keydown went out, not only the modifiers' (ChordKeySent).
+  // Typed text: it had begun, and only keyups are left (TextKeysDown) -- a
+  // line break is typed as Enter. A session cut short before its last
+  // keydown did not.
+  bool KeysDown() const;
+  bool ChordKeySent() const;
+  bool TextKeysDown() const;
+
+  int RandInt(int min_inclusive, int max_inclusive);
+  double RandDouble();  // [0.0, 1.0)
+  bool Bernoulli(double p);
+  // A drawn part of a millisecond, for a held key's repeats, whose times
+  // are drawn in whole ones.
+  base::TimeDelta PartOfAMillisecond();
+
+  base::WeakPtr<RenderWidgetHostImpl> widget_host_;
+  Params params_;
+  CompletionCallback callback_;
+
+  std::mt19937_64 rng_;
+  std::vector<ScheduledEvent> schedule_;
+  size_t next_index_ = 0;
+
+  // params_.text decoded to UTF-32, one entry per codepoint. Drives schedule
+  // generation only.
+  std::vector<char32_t> codepoints_;
+  // Position in codepoints_ currently being scheduled.
+  size_t intended_index_ = 0;
+  // Typos the schedule injects, each corrected; reported on completion.
+  int typos_ = 0;
+  // The keys of typed text, in the order pressed, until PlaceStrokes has
+  // timed them; and the pauses that wait for the next one.
+  std::vector<Stroke> strokes_;
+  double pending_thought_ms_ = 0;
+  double pending_break_ms_ = 0;
+  // What the caller's delay range and speed ask of the typist's pace (2.0 is
+  // half the typist's own speed), and its hold range of the holds: 1.0
+  // leaves them as they are.
+  double pace_ = 1.0;
+  double hold_scale_ = 1.0;
+  // A chord's cursor in the schedule timeline: its next event fires here.
+  base::TimeDelta cursor_time_;
+  // Speed-scaled versions of the params_ time ranges: a chord's holds and
+  // the thinking pauses.
+  int scaled_hold_min_ms_ = 0;
+  int scaled_hold_max_ms_ = 0;
+  int scaled_thinking_min_ms_ = 0;
+  int scaled_thinking_max_ms_ = 0;
+
+  base::TimeTicks dispatch_start_;
+  // The stamp of the event sent last: the next one's is after it.
+  base::TimeTicks last_stamp_;
+  // Wakes the session a little before its next event (DispatchPending):
+  // precisely, when the event is near.
+  base::DeadlineTimer timer_;
+  // When the precise wake now armed was asked for; null for an ordinary one.
+  base::TimeTicks precise_wake_at_;
+  bool started_ = false;
+  base::WeakPtrFactory<KeyboardTypingSession> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_KEYBOARD_TYPING_SESSION_H_
