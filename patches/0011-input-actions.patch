+// Before an element's press the hand follows it this many times when it has
+// moved from under the landing, or is seen still moving, then gives up.
+constexpr int kMaxCorrections = 2;
+// It aims again off a part of the element with a control of its own come up
+// under the landing at most this many times.
+constexpr int kMaxHoleCorrections = 2;
+// At most this many parts of an element kept off, whatever the renderer sends
+// (8 as they are and the rest as one; ClearPart's search grows fast with
+// them).
+constexpr size_t kMaxHoles = 9;
+// An element whose box's middle is more than this far from where the last
+// reading had it has moved (a hover's lift or scale moves it less, or not).
+constexpr double kStillPx = 3;
+// Moved but still under the hand, it is looked at again this long after; an
+// element seen moving is pressed once this many looks in a row find it still.
+constexpr double kLookMinMs = 60;
+constexpr double kLookMaxMs = 140;
+constexpr int kStillLooks = 2;
+// The landing counts as on the piece this far inside its edge.
+constexpr double kOnPiecePx = 1;
+// A point's width, for its leg's timing: a small target.
+constexpr double kPointWidthPx = 20;
+// The end's own lag, its wait that much shorter: its path's first wake comes
+// at once and the press is stamped as it goes, so what is left is the press's
+// wake lateness and the last move's, which LastMoveAt runs behind its stamp
+// by (each 0-2 ms on Windows' timer).
+constexpr double kEndLagMs = 1.5;
+// Once the end is queued, an answer comes at the latest this long after the
+// end itself would be done (its gesture always reports, but never waited
+// for without a bound).
+constexpr base::TimeDelta kEndBackstop = base::Seconds(5);
+
+bool Finite(const blink::mojom::AgentElementBox* box) {
+  return box && std::isfinite(box->x) && std::isfinite(box->y) &&
+         std::isfinite(box->width) && std::isfinite(box->height);
+}
+
+bool IsEmpty(const PlannerRect& r) {
+  return !(r.w > 0 && r.h > 0);
+}
+
+// Half-open, as DragRect::Contains.
+bool Contains(const PlannerRect& r, const PlannerPoint& p) {
+  return !IsEmpty(r) && r.x <= p.x && p.x < r.x + r.w && r.y <= p.y &&
+         p.y < r.y + r.h;
+}
+
+PlannerRect Intersect(const PlannerRect& a, const PlannerRect& b) {
+  if (IsEmpty(a) || IsEmpty(b)) {
+    return PlannerRect();
+  }
+  const double left = std::max(a.x, b.x);
+  const double top = std::max(a.y, b.y);
+  const double width = std::min(a.x + a.w, b.x + b.w) - left;
+  const double height = std::min(a.y + a.h, b.y + b.h) - top;
+  if (!(width > 0 && height > 0)) {
+    return PlannerRect();
+  }
+  return PlannerRect{left, top, width, height};
+}
+
+// In the page, but nothing of it laid out (display: none): its box has no
+// size at all.
+bool NotDisplayed(const blink::mojom::AgentAimPiece& piece) {
+  return !piece.box || !(piece.box->width > 0 || piece.box->height > 0);
+}
+
+// Whether the box's middle is more than kStillPx from where it was; never
+// when either is unknown.
+bool Moved(const PlannerRect& was, const PlannerRect& now) {
+  return !IsEmpty(was) && !IsEmpty(now) &&
+         std::hypot(now.x + now.w / 2 - (was.x + was.w / 2),
+                    now.y + now.h / 2 - (was.y + was.h / 2)) > kStillPx;
+}
+
+// Whether `p` is in one of `holes`, its edges counted.
+bool InAnyHole(const std::vector<PlannerRect>& holes, const PlannerPoint& p) {
+  for (const PlannerRect& r : holes) {
+    if (p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Whether `p` is on the box at least `inset` in from its edges -- but never
+// more than a quarter of it in, as a landing aimed at its edge is kept --
+// counting the edges themselves.
+bool OnPiece(const PlannerRect& r, double inset, const PlannerPoint& p) {
+  const double dx = std::min(inset, r.w / 4);
+  const double dy = std::min(inset, r.h / 4);
+  return !IsEmpty(r) && p.x >= r.x + dx && p.x <= r.x + r.w - dx &&
+         p.y >= r.y + dy && p.y <= r.y + r.h - dy;
+}
+
+// The most boxes of a hover region kept, as the renderer sends at most.
+constexpr size_t kMaxRegionBoxes = 12;
+// A turn is this far inside the overlap it is in, or less in a thin one.
+constexpr double kTurnInsetPx = 5;
+// A turn is picked from this many points a side of its overlap.
+constexpr int kTurnGrid = 9;
+
+// How a leg from `from` to `to` keeps inside a hover region: `first`,
+// a rectangle the region's boxes cover holding both ends; or, where none
+// does, `first` holding `from` and `second` holding `to`, overlapping in
+// `overlap`, the hand turning at `turn` in it -- a submenu beside its row is
+// reached across the row, then down the submenu.
+struct RegionPath {
+  PlannerRect first;
+  std::optional<PlannerPoint> turn;
+  PlannerRect overlap;
+  PlannerRect second;
+};
+
+// The largest rectangles the boxes cover, by the cells between their edges:
+// one holding both ends, else one for each end that overlap. Nothing when an
+// end is in no box, or no such rectangles exist.
+std::optional<RegionPath> PathInRegion(const std::vector<PlannerRect>& boxes,
+                                       const PlannerPoint& from,
+                                       const PlannerPoint& to) {
+  std::vector<double> xs;
+  std::vector<double> ys;
+  for (const PlannerRect& b : boxes) {
+    if (IsEmpty(b)) {
+      continue;
+    }
+    xs.push_back(b.x);
+    xs.push_back(b.x + b.w);
+    ys.push_back(b.y);
+    ys.push_back(b.y + b.h);
+  }
+  std::sort(xs.begin(), xs.end());
+  xs.erase(std::unique(xs.begin(), xs.end()), xs.end());
+  std::sort(ys.begin(), ys.end());
+  ys.erase(std::unique(ys.begin(), ys.end()), ys.end());
+  if (xs.size() < 2 || ys.size() < 2) {
+    return std::nullopt;
+  }
+  const size_t nx = xs.size() - 1;
+  const size_t ny = ys.size() - 1;
+  // Covered cells, summed from the corner.
+  std::vector<int> sum((nx + 1) * (ny + 1), 0);
+  const auto at = [&sum, ny](size_t i, size_t j) -> int& {
+    return sum[i * (ny + 1) + j];
+  };
+  for (size_t i = 0; i < nx; ++i) {
+    for (size_t j = 0; j < ny; ++j) {
+      const double cx = (xs[i] + xs[i + 1]) / 2;
+      const double cy = (ys[j] + ys[j + 1]) / 2;
+      bool in = false;
+      for (const PlannerRect& b : boxes) {
+        if (!IsEmpty(b) && b.x < cx && cx < b.x + b.w && b.y < cy &&
+            cy < b.y + b.h) {
+          in = true;
+          break;
+        }
+      }
+      at(i + 1, j + 1) = (in ? 1 : 0) + at(i, j + 1) + at(i + 1, j) - at(i, j);
+    }
+  }
+  // Whether cells i0..i1 by j0..j1 (inclusive) are all covered.
+  const auto full = [&at](size_t i0, size_t i1, size_t j0, size_t j1) {
+    const int n =
+        at(i1 + 1, j1 + 1) - at(i0, j1 + 1) - at(i1 + 1, j0) + at(i0, j0);
+    return n == static_cast<int>((i1 - i0 + 1) * (j1 - j0 + 1));
+  };
+  const auto cell =
+      [](double v, const std::vector<double>& edges) -> std::optional<size_t> {
+    if (!(v >= edges.front() && v < edges.back())) {
+      return std::nullopt;
+    }
+    return static_cast<size_t>(std::upper_bound(edges.begin(), edges.end(), v) -
+                               edges.begin() - 1);
+  };
+  const std::optional<size_t> fi = cell(from.x, xs);
+  const std::optional<size_t> fj = cell(from.y, ys);
+  const std::optional<size_t> ti = cell(to.x, xs);
+  const std::optional<size_t> tj = cell(to.y, ys);
+  if (!fi || !fj || !ti || !tj || !full(*fi, *fi, *fj, *fj) ||
+      !full(*ti, *ti, *tj, *tj)) {
+    return std::nullopt;
+  }
+  // The largest covered rectangle holding cells (ai, aj) and (bi, bj).
+  const auto largest = [&](size_t ai, size_t aj, size_t bi, size_t bj) {
+    PlannerRect best;
+    double best_area = 0;
+    for (size_t i0 = 0; i0 <= std::min(ai, bi); ++i0) {
+      for (size_t i1 = std::max(ai, bi); i1 < nx; ++i1) {
+        for (size_t j0 = 0; j0 <= std::min(aj, bj); ++j0) {
+          for (size_t j1 = std::max(aj, bj); j1 < ny; ++j1) {
+            if (!full(i0, i1, j0, j1)) {
+              continue;
+            }
+            const PlannerRect r{xs[i0], ys[j0], xs[i1 + 1] - xs[i0],
+                                ys[j1 + 1] - ys[j0]};
+            if (r.w * r.h > best_area) {
+              best = r;
+              best_area = r.w * r.h;
+            }
+          }
+        }
+      }
+    }
+    return best;
+  };
+  RegionPath path;
+  path.first = largest(*fi, *fj, *ti, *tj);
+  if (!IsEmpty(path.first)) {
+    return path;
+  }
+  path.first = largest(*fi, *fj, *fi, *fj);
+  path.second = largest(*ti, *tj, *ti, *tj);
+  path.overlap = Intersect(path.first, path.second);
+  if (IsEmpty(path.overlap)) {
+    return std::nullopt;
+  }
+  // The turn: of points across the overlap (kept in from its edges), the one
+  // the way through is shortest by.
+  const PlannerRect& o = path.overlap;
+  const double ix = std::min(kTurnInsetPx, o.w / 4);
+  const double iy = std::min(kTurnInsetPx, o.h / 4);
+  double shortest = std::numeric_limits<double>::infinity();
+  for (int a = 0; a < kTurnGrid; ++a) {
+    for (int b = 0; b < kTurnGrid; ++b) {
+      const PlannerPoint p{o.x + ix + (o.w - 2 * ix) * a / (kTurnGrid - 1),
+                           o.y + iy + (o.h - 2 * iy) * b / (kTurnGrid - 1)};
+      const double way = std::hypot(p.x - from.x, p.y - from.y) +
+                         std::hypot(to.x - p.x, to.y - p.y);
+      if (way < shortest) {
+        shortest = way;
+        path.turn = p;
+      }
+    }
+  }
+  return path;
+}
+
+// A flyout's turn is rounded by at most this radius (px), its arc kept inside
+// the overlap the turn is in.
+constexpr double kTurnRadiusPx = 12;
+// A turn stroke's timing leg is planned this far down and right of where it
+// starts: the planner holds every coordinate to 0 or more.
+constexpr double kTurnOffsetPx = 1e4;
+// A turn of more than this (radians: 20 degrees) is taken through a rounded
+// corner, slowing there, or not in one movement at all.
+constexpr double kTurnSharpRad = 0.35;
+
+// The way from `from` across into the box the target is in and on to `to`,
+// one movement, as a drag's route goes through its waypoints
+// (LayAlongRoute): the hand's own leg along a straight chord as long as the
+// way -- no bow, and not past its end, which would leave the box -- laid along
+// the way, the turn rounded no farther from it than the overlap's nearest
+// edge. Empty when a point of it would leave both boxes (1 px in): then two
+// legs.
+std::vector<PlannedPoint> TurnStroke(HumanPathPlanner& planner,
+                                     PathIntent intent,
+                                     double speed,
+                                     bool button_held,
+                                     const PlannerPoint& from,
+                                     const RegionPath& path,
+                                     const PlannerPoint& to,
+                                     double width) {
+  if (!path.turn) {
+    return {};
+  }
+  const PlannerPoint turn = *path.turn;
+  const double in = std::hypot(turn.x - from.x, turn.y - from.y);
+  const double on = std::hypot(to.x - turn.x, to.y - turn.y);
+  const double chord = std::hypot(to.x - from.x, to.y - from.y);
+  if (!(in >= 1 && on >= 1 && chord >= 1)) {
+    return {};
+  }
+  // How far the arc reaches from the turn along each way: no farther than the
+  // overlap's nearest edge, so it stays inside the overlap.
+  const PlannerRect& o = path.overlap;
+  const double room =
+      std::max(0.0, std::min({turn.x - o.x, o.x + o.w - turn.x, turn.y - o.y,
+                              o.y + o.h - turn.y}));
+  const double cosine = std::clamp(((turn.x - from.x) * (to.x - turn.x) +
+                                    (turn.y - from.y) * (to.y - turn.y)) /
+                                       (in * on),
+                                   -1.0, 1.0);
+  const double angle = std::acos(cosine);
+  const double half_tan = std::tan(angle / 2);
+  // RoundedRoute's own cap too (its reach at most 45 % of either way), so the
+  // guard and the smoothing below see the arc it draws.
+  const double radius = half_tan > 1e-3
+                            ? std::min({kTurnRadiusPx, 0.9 * room / half_tan,
+                                        0.45 * std::min(in, on) / half_tan})
+                            : 0;
+  // A turn too tight to round (RoundedRoute keeps it a corner under half a
+  // px) would be taken at full pace: two legs instead.
+  if (angle > kTurnSharpRad && radius < 0.5) {
+    return {};
+  }
+  const std::vector<RouteSample> route =
+      RoundedRoute({from, turn, to}, {0, radius, 0});
+  if (route.size() < 2 || route.back().s < 1) {
+    return {};
+  }
+  // The pace smoothed over half the arc either side, not a drag's 20 px of
+  // route: an arc of a few px averaged over that hardly slowed the hand (0.9
+  // of its pace at a right angle); over its own half it slows to the floor,
+  // as the power law has a hand slow more through a tighter turn.
+  const double smooth = std::max(1.0, 0.5 * radius * angle);
+  const double length = route.back().s;
+  const PlannerPoint dir{(to.x - from.x) / chord, (to.y - from.y) / chord};
+  LegConstraints c;
+  c.free_plus = 0;
+  c.free_minus = 0;
+  c.overshoot = false;
+  c.button_held = button_held;
+  const PlannerPoint origin{from.x + kTurnOffsetPx, from.y + kTurnOffsetPx};
+  const std::vector<PlannedPoint> plain = planner.PlanLeg(
+      origin,
+      PlannerPoint{origin.x + dir.x * length, origin.y + dir.y * length},
+      std::max(width, 1.0), intent, speed, c);
+  std::vector<PlannedPoint> stroke =
+      LayAlongRoute(route, plain, origin, dir, to,
+                    1000.0 / planner.polling_rate_hz(), smooth, kRouteMinPace);
+  const auto in_box = [](const PlannerRect& r, const PlannerPoint& p) {
+    return p.x >= r.x + 1 && p.x <= r.x + r.w - 1 && p.y >= r.y + 1 &&
+           p.y <= r.y + r.h - 1;
+  };
+  for (const PlannedPoint& q : stroke) {
+    if (!in_box(path.first, q.p) && !in_box(path.second, q.p)) {
+      return {};
+    }
+  }
+  return stroke;
+}
+
+// How wide `box` is along the way from `from` to `to`: the chord through it
+// in that direction, for a leg's timing.
+double WidthBetween(const PlannerRect& box,
+                    const PlannerPoint& from,
+                    const PlannerPoint& to) {
+  const double dx = std::abs(to.x - from.x);
+  const double dy = std::abs(to.y - from.y);
+  const double length = std::hypot(dx, dy);
+  if (length < 1) {
+    return std::min(box.w, box.h);
+  }
+  // The box bounds nothing along an axis the way does not move along.
+  const double unbounded = std::numeric_limits<double>::infinity();
+  const double along_x = dx > 1e-9 ? box.w * length / dx : unbounded;
+  const double along_y = dy > 1e-9 ? box.h * length / dy : unbounded;
+  return std::min({along_x, along_y, std::max(box.w, box.h)});
+}
