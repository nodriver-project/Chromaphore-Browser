+// browser: interception on, with the hold from dragstart, for each
+// Input.performDrag that arms it (`owner`, its session's id); the setting
+// found before the first is put back once the last has disarmed.
+void InputHandler::ArmDragInterceptionForCall(uint64_t owner, bool on) {
+  if (on) {
+    // In the grace after the last call the setting put back is still the one
+    // saved before it.
+    if (drag_call_owners_.empty() && !drag_grace_timer_.IsRunning()) {
+      saved_intercept_drags_ = intercept_drags_;
+      saved_carry_intercepted_drags_ = carry_intercepted_drags_;
+    }
+    drag_grace_timer_.Stop();
+    drag_call_owners_.insert(owner);
+    intercept_drags_ = true;
+    carry_intercepted_drags_ = true;
+    return;
+  }
+  if (drag_call_owners_.erase(owner) == 0 || !drag_call_owners_.empty()) {
+    return;  // not armed by it, or another call still has it armed
+  }
+  drag_modifiers_ = 0;
+  // A drag still held, with no hold from dragstart put back, is called off
+  // (dragleave, then dragend), not left held. One being let go of -- a drop
+  // waiting for its last answers, or a cancel -- finishes on its own.
+  if (DragHeld() &&
+      !(saved_intercept_drags_ && saved_carry_intercepted_drags_)) {
+    EndDragPath(false);
+  }
+  if (saved_intercept_drags_) {
+    // The client intercepts drags itself: its setting, at once.
+    intercept_drags_ = saved_intercept_drags_;
+    carry_intercepted_drags_ = saved_carry_intercepted_drags_;
+    return;
+  }
+  // browser: interception stays on a moment before the setting (off) is put
+  // back: a page behind with its input can begin a drag from moves made
+  // before the release, after the call is over.
+  // StartDragging calls one begun then off.
+  intercept_drags_ = true;
+  carry_intercepted_drags_ = true;
+  drag_grace_timer_.Start(
+      FROM_HERE, kLateDragGrace,
+      base::BindOnce(&InputHandler::EndDragGrace, weak_factory_.GetWeakPtr()));
+}
+
+void InputHandler::EndDragGrace() {
+  if (!drag_call_owners_.empty()) {
+    return;
+  }
+  intercept_drags_ = saved_intercept_drags_;
+  carry_intercepted_drags_ = saved_carry_intercepted_drags_;
+  if (DragHeld() && !(intercept_drags_ && carry_intercepted_drags_)) {
+    EndDragPath(false);
