+// browser: a field reading as the protocol gives it; null for none.
+std::unique_ptr<Input::FieldReading> FieldReadingOf(
+    const blink::mojom::AgentFieldReading* reading) {
+  if (!reading) {
+    return nullptr;
+  }
+  std::unique_ptr<Input::FieldReading> out =
+      Input::FieldReading::Create().SetKind(reading->kind).Build();
+  if (reading->node_id > 0) {
+    out->SetBackendNodeId(reading->node_id);
+    out->SetFrameId(reading->frame_id);
+  }
+  if (reading->kind == "value" || reading->kind == "editable") {
+    out->SetLength(reading->length);
+    out->SetSelected(reading->selected);
+  }
+  if (reading->kind == "value") {
+    out->SetReadonly(reading->readonly);
+    out->SetDisabled(reading->disabled);
+    if (reading->max_length >= 0) {
+      out->SetMaxLength(reading->max_length);
+    }
+  }
+  // browser: a date or time field.
+  if (reading->kind == "temporal") {
+    out->SetReadonly(reading->readonly);
+    out->SetDisabled(reading->disabled);
+    out->SetComplete(reading->complete);
+    out->SetBadInput(reading->bad_input);
+    if (!reading->part.empty()) {
+      out->SetPart(reading->part);
+    }
+  }
+  if (!reading->editor.empty()) {
+    out->SetEditor(reading->editor);
+  }
+  if (!reading->what.empty()) {
+    out->SetWhat(reading->what);
+    out->SetTag(reading->tag);
+  }
+  if (!reading->input_type.empty()) {
+    out->SetInputType(reading->input_type);
+  }
+  if (reading->strict) {
+    out->SetStrict(true);
+  }
+  if (reading->contains.has_value()) {
+    out->SetContains(reading->contains.value());
+  }
+  if (reading->moved) {
+    out->SetMoved(true);
+  }
+  return out;
+}
