+// A seed from the protocol's number: the 53 bits a double carries are plenty
+// for an mt19937_64 seed. A negative value seeds as its magnitude and a value
+// past the range saturates; a plain cast is undefined for both.
+uint64_t SeedFromNumber(double value) {
