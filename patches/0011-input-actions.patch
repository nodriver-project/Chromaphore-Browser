+InputHandler::MousePathRequest::MousePathRequest() = default;
+InputHandler::MousePathRequest::MousePathRequest(const MousePathRequest&) =
+    default;
+InputHandler::MousePathRequest::MousePathRequest(MousePathRequest&&) = default;
+InputHandler::MousePathRequest& InputHandler::MousePathRequest::operator=(
+    const MousePathRequest&) = default;
+InputHandler::MousePathRequest& InputHandler::MousePathRequest::operator=(
+    MousePathRequest&&) = default;
+InputHandler::MousePathRequest::~MousePathRequest() = default;
+
+namespace {
+
+// browser: the polling rates a mouse path may go at, in Hz.
+constexpr int kMinPollingRateHz = 1;
+constexpr int kMaxPollingRateHz = 10000;
+
+// browser: `done`, run from a posted task, never inside the call that
+// answers it.
+base::OnceCallback<void(bool)> PostedReply(
+    base::OnceCallback<void(bool)> done) {
+  return base::BindOnce(
+      [](base::OnceCallback<void(bool)> reply, bool ok) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(std::move(reply), ok));
+      },
+      std::move(done));
+}
+
+// browser: a press, a click or a wheel turn at the end of a mouse path outside
+// the view is dropped where it would be dispatched
+// (SyntheticGestureTargetBase::PointIsWithinContents), and the gesture would
+// still report finished with nothing pressed. By the gesture's own test, on
+// the point asked for: a cast to int let a point just outside through.
+bool MousePathEndsOutsideView(const InputHandler::MousePathRequest& request,
+                              const gfx::Rect& view_bounds) {
+  using EndAction = SyntheticMousePathGestureParams::EndAction;
+  if (request.points.empty() ||
+      (request.end_action != EndAction::kPress &&
+       request.end_action != EndAction::kClick && request.wheel.empty())) {
+    return false;
+  }
+  const PlannerPoint& last = request.points.back();
+  const float width = static_cast<float>(view_bounds.width());
+  const float height = static_cast<float>(view_bounds.height());
+  return last.x < 0 || last.y < 0 || last.x >= width || last.y >= height;
+}
+
+}  // namespace
+
+// browser: Input.dispatchMousePath's body, for points already in the root
+// view's DIPs: the CDP command and Input.performDrag's executor both queue
+// their paths here.
+bool InputHandler::QueueMousePath(MousePathRequest request,
+                                  base::OnceCallback<void(bool ok)> done) {
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  if (!host_ || !host_->GetRenderWidgetHost() || !root_view ||
+      request.points.empty() || request.polling_rate_hz < kMinPollingRateHz ||
+      request.polling_rate_hz > kMaxPollingRateHz ||
+      MousePathEndsOutsideView(request, root_view->GetViewBounds())) {
+    // Refused: nothing is sent, and the pointer is where it was.
+    last_queued_still_ms_ = -1;
+    if (done) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(std::move(done), false));
+    }
+    return false;
+  }
+
+  SyntheticMousePathGestureParams params;
+  params.button = request.button;
+  // The driver adds kFromDebugger itself.
+  params.key_modifiers =
+      GetEventModifiers(request.modifiers, /*auto_repeat=*/false,
+                        /*is_keypad=*/false, /*location=*/0, /*buttons=*/0) &
+      ~blink::WebInputEvent::kFromDebugger;
+  params.end_action = request.end_action;
+  params.end_button = request.end_button;
+  params.click_count = request.click_count;
+  params.end_delay = request.end_delay;
+  params.hold = request.hold;
+  params.click_gap = request.click_gap;
+  params.holds = request.holds;
+  params.click_gaps = request.click_gaps;
+  params.wheel = request.wheel;
+  // Like synthesizePinch/Scroll/TapGesture, the gesture is marked as coming
+  // from the debugger so it dispatches straight to the target and skips
+  // SyntheticGestureController's visibility gate. Without that the gesture is
+  // deferred whenever the root widget reads as hidden, which is common for an
+  // automation window behind another one, and the call hangs until the
+  // client times out. The kFromDebugger modifier is browser-side only: the
+  // renderer never reads it, so isTrusted and routing are unaffected.
+  params.from_devtools_debugger = true;
+  params.gesture_source_type = content::mojom::GestureSourceType::kMouseInput;
+  params.polling_interval =
+      base::Milliseconds(1000.0 / request.polling_rate_hz);
+  // browser: on whole device pixels of the window the view sits in, where a
+  // mouse's pointer always is: points between two reached the page as
+  // fractional coordinates at a pixel ratio of 1, which no mouse gives.
+  const double device_scale =
+      std::max(static_cast<double>(root_view->GetDeviceScaleFactor()), 0.25);
+  const gfx::Rect view_bounds = root_view->GetViewBounds();
+  gfx::Vector2d in_window;  // the view's place in its window
+#if defined(USE_AURA)
+  if (aura::Window* native = root_view->GetNativeView()) {
+    in_window = native->GetBoundsInRootWindow().OffsetFromOrigin();
+  }
+#endif
+  // From the pixel the last path left the pointer on.
+  std::optional<double> held_x;
+  std::optional<double> held_y;
+  if (last_path_point_) {
+    held_x = std::round((last_path_point_->x + in_window.x()) * device_scale);
+    held_y = std::round((last_path_point_->y + in_window.y()) * device_scale);
+  }
+  const auto on_pixel = [device_scale](double dip, double origin,
+                                       std::optional<double>& held) {
+    const float out = static_cast<float>(
+        StickyPixel((dip + origin) * device_scale, held) / device_scale -
+        origin);
+    return out == 0.f ? 0.f : out;  // never -0
+  };
+  // The first and last whole pixels inside the view along an axis.
+  const auto first_inside = [device_scale](double origin) {
+    const float out = static_cast<float>(
+        std::ceil(origin * device_scale) / device_scale - origin);
+    return out == 0.f ? 0.f : out;  // never -0
+  };
+  const auto last_inside = [device_scale](double origin, double extent) {
+    double last = (std::ceil((origin + extent) * device_scale - 1e-3) - 1) /
+                      device_scale -
+                  origin;
+    if (static_cast<float>(last) >= extent) {
+      last -= 1 / device_scale;  // a scale float cannot hold exactly
+    }
+    return static_cast<float>(last);
+  };
+  // And on the screens: a cursor pushed past their edge stays on it. The view
+  // of a window as wide as its screen has its sides there, and a pointer
+  // overshooting near one left the view and was heard leaving at a place no
+  // cursor reaches.
+  const gfx::Rect screens = AllScreens(view_bounds);
+  // The point a press, click or wheel lands on: the nearest pixel, as asked.
+  const bool ends_on_point =
+      params.end_action != SyntheticMousePathGestureParams::EndAction::kNone ||
+      !params.wheel.empty();
+  for (size_t i = 0; i < request.points.size(); ++i) {
+    const double asked_x = request.points[i].x;
+    const double asked_y = request.points[i].y;
+    std::optional<double> exact_x;
+    std::optional<double> exact_y;
+    // browser: a path of one point where the pointer already is (within the
+    // sticky margin of its pixel) keeps it on that pixel, whatever lands
+    // there: a wheel turn or a release where the pointer is moves nothing.
+    const bool stays =
+        request.points.size() == 1 && last_path_point_.has_value();
+    const bool lands = (ends_on_point || request.exact_end) &&
+                       i + 1 == request.points.size() && !stays;
+    float x = on_pixel(asked_x, in_window.x(), lands ? exact_x : held_x);
+    float y = on_pixel(asked_y, in_window.y(), lands ? exact_y : held_y);
+    if (!screens.IsEmpty()) {
+      x = OnScreens(x, screens.x() - view_bounds.x(),
+                    screens.right() - view_bounds.x(), in_window.x(),
+                    device_scale);
+      y = OnScreens(y, screens.y() - view_bounds.y(),
+                    screens.bottom() - view_bounds.y(), in_window.y(),
+                    device_scale);
+    }
+    params.positions.push_back({x, y});
+  }
+  params.view_width = view_bounds.width();
+  params.view_height = view_bounds.height();
+  // A press, click or wheel at the end goes to a pixel inside the view:
+  // rounded onto its far edge, it was dropped where it is dispatched, while the
+  // call said it was done.
+  if ((params.end_action ==
+           SyntheticMousePathGestureParams::EndAction::kPress ||
+       params.end_action ==
+           SyntheticMousePathGestureParams::EndAction::kClick ||
+       !params.wheel.empty()) &&
+      !view_bounds.IsEmpty()) {
+    SyntheticMousePathGestureParams::Position& last = params.positions.back();
+    last.x = std::clamp(last.x, first_inside(in_window.x()),
+                        last_inside(in_window.x(), view_bounds.width()));
+    last.y = std::clamp(last.y, first_inside(in_window.y()),
+                        last_inside(in_window.y(), view_bounds.height()));
+  }
+
+  // browser: how long the pointer stands still at this path's end, on the
+  // pixels it is really sent to -- the moves at one place, the wheel turned
+  // there, an end action's wait and a click's holds and gaps
+  // (LastQueuedStillMs).
+  {
+    const auto same = [](const SyntheticMousePathGestureParams::Position& a,
+                         const SyntheticMousePathGestureParams::Position& b) {
+      return a.x == b.x && a.y == b.y;
+    };
+    const std::vector<SyntheticMousePathGestureParams::Position>& pos =
+        params.positions;
+    size_t settled = pos.size() - 1;
+    while (settled > 0 && same(pos[settled - 1], pos.back())) {
+      --settled;
+    }
+    if (settled == 0 && last_path_point_ &&
+        same(pos.front(), *last_path_point_)) {
+      last_queued_still_ms_ = -1;
+    } else {
+      using EndAction = SyntheticMousePathGestureParams::EndAction;
+      base::TimeDelta still = params.polling_interval *
+                              static_cast<int64_t>(pos.size() - 1 - settled);
+      for (const SyntheticMousePathGestureParams::WheelNotch& notch :
+           params.wheel) {
+        still += notch.delay;
+      }
+      if (params.end_action != EndAction::kNone) {
+        still += params.end_delay;
+      }
+      if (params.end_action == EndAction::kClick) {
+        for (int i = 0; i < std::max(1, params.click_count); ++i) {
+          if (i > 0) {
+            still += static_cast<size_t>(i - 1) < params.click_gaps.size()
+                         ? params.click_gaps[i - 1]
+                         : params.click_gap;
+          }
+          still += static_cast<size_t>(i) < params.holds.size()
+                       ? params.holds[i]
+                       : params.hold;
+        }
+      }
+      last_queued_still_ms_ = still.InMillisecondsF();
+    }
+  }
+  // The callback resolves once the gesture's events are dispatched, not
+  // after the WaitForTargetAck round trip the default QueueSyntheticGesture
+  // path adds. That round trip lags by seconds on busy or occluded pages,
+  // stalling every path after its motion has finished. A press, release or
+  // click at the end is part of the gesture, so it is dispatched by then too.
+  // browser: from where the last path left the pointer, and on to where this
+  // one leaves it.
+  if (last_path_point_) {
+    params.has_start = true;
+    params.start = *last_path_point_;
+  }
+  last_path_point_ = params.positions.back();
+  // browser: the button a press at the end leaves down, until a release
+  // brings it up (HeldButton).
+  if (params.end_action == SyntheticMousePathGestureParams::EndAction::kPress) {
+    held_button_ = params.end_button;
+  } else if (params.end_action ==
+             SyntheticMousePathGestureParams::EndAction::kRelease) {
+    held_button_ = SyntheticPointerActionParams::Button::NO_BUTTON;
+  }
+  // browser: once the path has played, the page's last move is its last
+  // whole-pixel change (LastMoveAt), and it is no longer in flight.
+  ++paths_in_flight_;
+  done = base::BindOnce(
+      [](base::WeakPtr<InputHandler> handler, double still_ms,
+         base::OnceCallback<void(bool)> reply, bool ok) {
+        if (handler) {
+          handler->paths_in_flight_ =
+              std::max(0, handler->paths_in_flight_ - 1);
+          if (ok && still_ms >= 0) {
+            handler->last_move_at_ =
+                base::TimeTicks::Now() - base::Milliseconds(still_ms);
+          }
+        }
+        if (reply) {
+          std::move(reply).Run(ok);
+        }
+      },
+      weak_factory_.GetWeakPtr(), last_queued_still_ms_, std::move(done));
+  root_view->host()->QueueSyntheticGestureCompleteImmediately(
+      std::make_unique<SyntheticMousePathGesture>(params),
+      base::BindOnce(
+          [](base::WeakPtr<RenderWidgetHostImpl> widget,
+             base::OnceCallback<void(bool)> finished,
+             SyntheticGesture::Result result) {
+            if (!finished) {
+              return;
+            }
+            // browser: posted, never inside the call that ended it, and
+            // judged there: a controller torn down -- its widget destroyed,
+            // or its view gone (SetView(nullptr) on ViewDestroyed, Destroy,
+            // RendererExited) -- runs its queued gestures' callbacks as
+            // finished, and no gesture finished there.
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, base::BindOnce(
+                               [](base::WeakPtr<RenderWidgetHostImpl> host,
+                                  base::OnceCallback<void(bool)> reply,
+                                  bool gesture_finished) {
+                                 std::move(reply).Run(gesture_finished &&
+                                                      host && host->GetView());
+                               },
+                               std::move(widget), std::move(finished),
+                               result == SyntheticGesture::GESTURE_FINISHED));
+          },
+          root_view->host()->GetWeakPtr(), std::move(done)));
+  return true;
+}
