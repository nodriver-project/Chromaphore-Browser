+// browser: The outermost main frame's sessions: a popup an iframe
+// asked for is the page's.
+void DidBlockPopup(RenderFrameHostImpl* rfh,
+                   const GURL& target_url,
+                   WindowOpenDisposition disposition) {
+  DispatchToAgents(rfh->GetOutermostMainFrame()->frame_tree_node(),
+                   &protocol::InputHandler::DidBlockPopup, target_url,
+                   disposition);
+}
+
+void DidDismissPermissionPrompt(RenderFrameHostImpl* rfh,
+                                const std::vector<std::string>& permissions,
+                                const std::string& origin,
+                                bool cross_origin,
+                                double shown_ms) {
+  const std::string frame_id = rfh->GetDevToolsFrameToken().ToString();
+  DispatchToAgents(rfh->GetOutermostMainFrame()->frame_tree_node(),
+                   &protocol::InputHandler::DidDismissPermissionPrompt,
+                   frame_id, permissions, origin, cross_origin, shown_ms);
+}
+
+// browser: the outermost main frame's sessions, as DidBlockPopup's: a
+// chooser an iframe opens is the page's. Offered to every session's choice
+// under way first; only then may one refuse it as late.
+void WillRunFileChooser(RenderFrameHostImpl* rfh,
+                        FileSelectListener* listener,
+                        const blink::mojom::FileChooserParams& params,
+                        bool* handled) {
+  FrameTreeNode* root = rfh->GetOutermostMainFrame()->frame_tree_node();
+  DispatchToAgents(root, &protocol::InputHandler::WillRunFileChooser, rfh,
+                   listener, params, handled);
+  if (!*handled) {
+    DispatchToAgents(root, &protocol::InputHandler::RefuseLateChooser, rfh,
+                     listener, handled);
+  }
+}
