+// The navigating frame's id, as CDP names frames (PageHandler's
+// frameStartedNavigating).
+std::string FrameIdOf(NavigationHandle* handle) {
+  RenderFrameHostImpl* frame =
+      NavigationRequest::From(handle)->frame_tree_node()->current_frame_host();
+  return frame ? frame->devtools_frame_token().ToString() : std::string();
+}
