+// found in the LICENSE file.
+
+// Input.selectOptions' executor: options of a <select> picked the way a
+// person picks them, as one action. The select is read in its renderer
+// (AgentSnapshotCollector::ReadSelect) and answered at once when nothing is
+// to be done (gone, not a select, disabled, a value naming no usable option,
+// several values for one, the options already shown). Else it is brought
+// into view (InputHandler::RunReveal) and read again, then:
+// - a dropdown is opened with the hand's click (InputHandler::RunMove, its
+//   press not armed); once the browser shows its native list window, the
+//   session waits as a person reading down the list and moving to the option
+//   would, and picks through the list's own commit (PickInList, armed by
+//   ActionOutcomeWatch::ArmSelect), the hand placed over the option without
+//   a move the page could see (it sees none while the list is open); a list
+//   the browser does not open (an inactive window, a hidden tab) is stepped
+//   with the keys on the focused select, armed at the first key;
+// - a dropdown drawn in the page (appearance: base-select) has its option
+//   clicked by identity once its picker shows;
+// - a list box has its options clicked by identity, each brought into view
+//   inside the list first, Ctrl pressed and let go around each click after
+//   the first in a multiple one, only the differences toggled when the
+//   selection already holds some of the values. The first click's own move
+//   arms the action (ArmMouse); the others ride on it.
+// Once all of the pick has gone out (the list's pick answered, the last
+// option clicked, the key route sent whole), a select the page then replaces
+// is answered picked, as the pick made it; with part of it out, interrupted:
+// reason optionsGone, as it shows now, when an option it was to click went and
+// the select is still there (an onchange that makes its options anew); else
+// reason gone, as the last reading showed it. One at a time per InputHandler:
+// other pointer input, a newer select, scroll, reveal or move, Input.disable
+// or a renderer change answers it interrupted, with why -- picked when all of
+// the pick had gone out (reason navigated when its frame went); with an
+// option's click under way it first lets go of Ctrl and waits for that
+// click's answer (what the click led to goes on the select's), and the
+// handler keeps it until then.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_SELECT_SESSION_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_SELECT_SESSION_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/browser/devtools/protocol/human_path_planner.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/devtools/protocol/move_session.h"
+#include "content/browser/devtools/protocol/page.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/agent_snapshot/agent_snapshot_collector.mojom.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace content::protocol {
+
+// One option of the select, as Input.selectOptions' SelectOption says it:
+// its index in the select's list, its text and its value.
+struct SelectOptionFigures {
+  int index = -1;
+  std::string text;
+  std::string value;
+};
+
+// What a pick came to, as Input.selectOptions answers it: a refusal before
+// any session in `failure`; else the outcome, how it was picked, why the keys
+// were used and how, why they stopped, what is selected now and what no
+// longer is, the values that named no option (or only a disabled or a hidden
+// one), the select's first options, what lies over a press refused and why,
+// where the hand is (CSS px of the main frame's viewport), how long it took,
+// and what the pick led to (null when nothing was armed). Empty strings are
+// left out of the answer.
+struct SelectResult {
+  SelectResult();
+  SelectResult(SelectResult&&);
+  SelectResult& operator=(SelectResult&&);
+  ~SelectResult();
+
+  std::optional<Response> failure;
+  std::string outcome;
+  std::string way = "none";
+  std::string why_keys;
+  std::string keys_route;
+  std::string keys_stopped;
+  std::optional<bool> keys_moved;
+  bool multiple = false;
+  std::vector<SelectOptionFigures> selected;
+  std::vector<SelectOptionFigures> deselected;
+  std::vector<std::string> missing;
+  std::vector<std::string> disabled_matches;
+  std::vector<std::string> hidden_matches;
+  std::vector<std::string> options;
+  int option_count = 0;
+  std::string hit;
+  // When `hit` names an open layer the select is not in, its kind, as the
+  // click's move gave it.
+  std::string hit_kind;
+  std::string reason;
+  double x = 0;
+  double y = 0;
+  double duration_ms = 0;
+  std::unique_ptr<Page::ActionOutcome> action_outcome;
+};
+
+class SelectSession {
+ public:
+  // A call to Input.selectOptions, checked by InputHandler::SelectOptions.
+  struct Params {
+    Params();
+    Params(const Params&);
+    Params& operator=(const Params&);
+    ~Params();
+
+    // The select: its DOMNodeId in the local root of `frame_id`.
+    int32_t node_id = 0;
+    std::string frame_id;
+    std::vector<std::string> values;
+    // As Input.moveTo takes them, for the hand's moves; and as the planner
+    // reads it, for the dwell before the pick.
+    std::optional<std::string> intent;
+    PathIntent path_intent = PathIntent::kDefault;
+    double speed_multiplier = 1;
+    base::TimeDelta timeout;
+    // Where the pointer is, in CSS px of the main frame's viewport, for when
+    // no mouse path has put it anywhere yet.
+    std::optional<double> pointer_x;
+    std::optional<double> pointer_y;
+    // Root DIPs per CSS px of the main frame's viewport.
+    double css_scale = 1;
+    // Whether the answer waits for a cross-document navigation the pick
+    // started to end.
+    bool follow_navigation = true;
+  };
+
+  using Completion = base::OnceCallback<void(SelectResult)>;
+
+  // `completion` hears the answer; `on_done` hears this session's id, posted,
+  // once it has answered.
+  SelectSession(InputHandler& handler,
+                uint64_t id,
+                Params params,
+                Completion completion,
+                base::OnceCallback<void(uint64_t)> on_done);
+  SelectSession(const SelectSession&) = delete;
+  SelectSession& operator=(const SelectSession&) = delete;
+  // Unanswered, it answers interrupted, without the handler.
+  ~SelectSession();
+
+  void Start();
+  // Other input, a renderer change (the frame navigated) or Input.disable:
+  // answered interrupted with `why`, at once -- or, with an option's click
+  // under way, once that click has answered (answered() stays false until
+  // then, and the handler keeps the session). Its own move or reveal stops
+  // where it has got to.
+  void Interrupt(InputHandler::Interruption why);
+
+  uint64_t id() const { return id_; }
+  bool answered() const { return !completion_; }
+
+ private:
+  // What a reading of the select is for.
+  enum class Read {
+    // Before anything, and again once it is in view: what it is, and
+    // whether anything is to be done.
+    kFirst,
+    // After the opening click, each frame: whether its list shows.
+    kList,
+    // Before the keys: focus, and the route from where the selection is.
+    kKeyStart,
+    // After a key: where the selection went.
+    kKey,
+    // After the pick: what is selected now.
+    kAfter,
+    // After the list's answer to the pick was lost: whether it took.
+    kRecheck,
+    // Out of time after the opening click: whether its list shows, to close
+    // it (a few looks).
+    kClose,
+    // After a pick refused as changed: whether its list still shows, to close
+    // it, and the options now.
+    kChanged,
+    // After an option the pick was to click went from the page: whether the
+    // select is still there, and what it shows now.
+    kGone,
+  };
+
+  void Ask(Read read);
+  void OnRead(Read read, blink::mojom::AgentSelectReadingPtr reading);
+  void OnFirstRead(const blink::mojom::AgentSelectReading& reading);
+  // The select gone, or its renderer, or an option the pick was to click:
+  // answered picked (replaced) once all of the pick went out; interrupted once
+  // part of it did -- optionsGone, as it shows now, when an option went and
+  // the select stayed, else gone, as the last reading showed it; else gone.
+  void OnGone(const std::string& reason);
+
+  // The select (or, in a list box, an option) brought into view as a hand
+  // brings it (RunReveal), then `next`.
+  void Reveal(int32_t node_id, base::OnceClosure next);
+  void OnRevealed(base::OnceClosure next, InputHandler::RevealResult result);
+
+  // Dropdowns: the opening click, unarmed; then the list watched for.
+  void Open();
+  void OnOpened(MoveResult result);
+  void OnListRead(const blink::mojom::AgentSelectReading& reading);
+  // The native list shows: the dwell, then the pick.
+  void Dwell(const blink::mojom::AgentSelectReading& reading);
+  void Pick();
+  void OnPicked(const std::string& outcome);
+  void OnRecheck(const blink::mojom::AgentSelectReading& reading);
+
+  // The keys on the focused select, when its list did not open.
+  void StartKeys(const blink::mojom::AgentSelectReading& reading);
+  void NextKey();
+  void OnKeySent(bool ok);
+  void OnKeyRead(const blink::mojom::AgentSelectReading& reading);
+  // The keys stopped short: keysFailed, with why.
+  void KeysFailed(const std::string& why);
+
+  // Options clicked by identity: a list box's (Ctrl around each click after
+  // the first in a multiple one), or an open base picker's.
+  void PlanClicks(const blink::mojom::AgentSelectReading& reading);
+  void NextClick();
+  // The option in view: Ctrl down when its click wants it, then the click.
+  void PressFor();
+  void ClickOption();
+  void OnClicked(MoveResult result);
+  void AfterClick();
+  // Ctrl down or up, as a hand presses it for a ctrl+click; then `next`.
+  void Chord(bool down, base::OnceClosure next);
+  void OnChord(bool down, base::OnceClosure next, bool ok);
+
+  // A click of the hand (the opening one, or an option's) refused: answered
+  // as the move said it.
+  void AnswerMove(const MoveResult& result);
+  // Cut short by other input: interrupted with `why`, or picked when all of
+  // the pick had gone out (reason navigated when its frame went).
+  void AnswerInterrupted(InputHandler::Interruption why);
+
+  void OnTimeout();
+  // The one answer: `wait` once what the armed action led to has settled.
+  void Answer(const std::string& outcome,
+              const std::string& reason = std::string(),
+              const std::string& hit = std::string(),
+              const std::string& hit_kind = std::string());
+  void Fail(Response response);
+  void Send(const std::string& outcome,
+            const std::string& reason,
+            const std::string& hit,
+            bool wait,
+            const std::string& hit_kind = std::string());
+  // Ctrl let go of, if this session pressed it: now, or as soon as a press
+  // still on its way has landed; only forgotten once its frame went.
+  void ReleaseCtrl();
+  // Its own move or reveal under way stops where it has got to.
+  void StopSteps();
+
+  // A move of the hand (RunMove) onto `node_id`, clicked; `arm`: whether the
+  // click arms the action (an option's first click).
+  InputHandler::MoveRequest ClickRequest(int32_t node_id,
+                                         int modifiers,
+                                         bool arm) const;
+  // The call's time left, in ms.
+  double RemainingMs() const;
+  base::WeakPtr<SelectSession> Weak();
+
+  const raw_ref<InputHandler> handler_;
+  const uint64_t id_;
+  Params params_;
+  Completion completion_;
+  base::OnceCallback<void(uint64_t)> on_done_;
+  const base::TimeTicks started_;
+
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector_;
+  GlobalRenderFrameHostId local_root_;
+  // The first reading, and the latest one that read the select.
+  blink::mojom::AgentSelectReadingPtr first_;
+  blink::mojom::AgentSelectReadingPtr latest_;
+
+  std::string way_ = "none";
+  std::string why_keys_;
+  std::string keys_route_;
+  std::string keys_stopped_;
+  std::optional<bool> keys_moved_;
+
+  // The select has been brought into view, and read again after it.
+  bool revealed_ = false;
+  // Before the opening click: whether the browser would refuse the list.
+  bool window_inactive_ = false;
+  bool tab_hidden_ = false;
+  // The list's watch: under way (the opening click answered, the list not
+  // seen yet), until when, and whether the second wait was given.
+  bool watching_list_ = false;
+  // Out of time: the looks for a list to close, so far.
+  int close_looks_ = 0;
+  base::TimeTicks list_wait_until_;
+  bool list_wait_extended_ = false;
+  // The native list is open (opened, and the pick not yet sent).
+  bool list_open_ = false;
+  // The list did not show the option's row yet: reads asked for it.
+  int row_reads_ = 0;
+  // Where the hand goes over the list (root DIPs), when known.
+  std::optional<gfx::PointF> list_place_;
+
+  // The keys: the presses left, the target index, the index before the
+  // last key, the keys sent, and the index selected at the first reading.
+  std::vector<std::string> keys_;
+  size_t next_key_ = 0;
+  std::optional<int> key_target_;
+  std::optional<int> key_from_;
+  int keys_sent_ = 0;
+  std::optional<int> initial_index_;
+  // The route planned last was cut at the most keys a pick sends.
+  bool keys_cut_ = false;
+
+  // The options to click, in order, and whether with Ctrl.
+  struct Click {
+    int32_t node_id = 0;
+    bool ctrl = false;
+  };
+  std::vector<Click> clicks_;
+  size_t next_click_ = 0;
+  // An option's click under way (not the opening one).
+  bool option_click_ = false;
+  // The first option's click went out; what it led to, as its move answered.
+  bool clicked_ = false;
+  std::unique_ptr<Page::ActionOutcome> click_outcome_;
+  // Ctrl is down, or its press is on its way: let go of on every exit. A
+  // press still on its way when the session ends is let go of once it lands
+  // (its callback outlives the session).
+  bool ctrl_down_ = false;
+  scoped_refptr<base::RefCountedData<bool>> ctrl_landing_;
+
+  // An embedded reveal or move, the pick or a key is under way.
+  bool revealing_ = false;
+  bool moving_ = false;
+  bool pick_in_flight_ = false;
+  bool key_in_flight_ = false;
+  // The call's time ran out with one of those under way: answered once it
+  // has (or after a short wait), with what it did.
+  bool timed_out_ = false;
+  // Interrupted with an option's click under way: why, until that click has
+  // answered.
+  std::optional<InputHandler::Interruption> interrupted_;
+  // Interrupted by a renderer change: the page that saw this session's keys
+  // go down is gone.
+  bool frame_left_ = false;
+  // The outcome watch's id once the pick or the keys armed it (0: none);
+  // whether anything of the pick has been sent to the page since (the pick,
+  // a key, an option's click); whether all of the pick has gone out with no
+  // reading after it: the answer gives the selection as the pick made it.
+  int action_id_ = 0;
+  bool reached_ = false;
+  bool as_picked_ = false;
+  // The reveal under way is of an option about to be clicked.
+  bool revealing_option_ = false;
+  // An option the pick was to click was found gone, by its reveal or its
+  // click (an onchange that made the options anew, or the select replaced).
+  bool option_went_ = false;
+  // The select is being read once more after that (Read::kGone).
+  bool reading_after_gone_ = false;
+  // False once the handler is going (the destructor): nothing of it is
+  // asked.
+  bool handler_alive_ = true;
+
+  base::OneShotTimer timeout_timer_;
+  base::OneShotTimer clock_;
+  base::WeakPtrFactory<SelectSession> weak_factory_{this};
+};
+
+}  // namespace content::protocol
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_SELECT_SESSION_H_
