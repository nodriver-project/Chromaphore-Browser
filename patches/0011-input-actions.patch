+// browser: Input.pickColor: checked, then carried out by a
+// ColorSession, which answers once through AnswerPickColor.
+void InputHandler::PickColor(int backend_node_id,
+                             const std::string& frame_id,
+                             const std::string& value,
+                             std::optional<std::string> intent,
+                             std::optional<double> speed_multiplier,
+                             std::optional<double> timeout_ms,
+                             std::optional<double> pointer_x,
+                             std::optional<double> pointer_y,
+                             std::optional<bool> follow_navigation,
+                             std::unique_ptr<PickColorCallback> callback) {
+  ColorSession::Completion completion = AnswerPickColor(std::move(callback));
+  // Other pointer input: a reveal, a drag, a move, a scroll, a select, a
+  // fill and a pick under way end first.
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  InterruptAllSessions();
+  if (std::optional<Response> refusal = CheckActionCall(
+          "Input.pickColor", /*refuse_held_drag=*/true,
+          {&speed_multiplier, &timeout_ms, &pointer_x, &pointer_y})) {
+    FailColor(std::move(completion), *refusal);
+    return;
+  }
+  if (backend_node_id <= 0 || frame_id.empty()) {
+    FailColor(std::move(completion),
+              Response::InvalidParams(
+                  "'backendNodeId' and 'frameId' must name the field"));
+    return;
+  }
+  // A simple colour, as the picker's hex field takes one; the field stores it
+  // lower-cased.
+  const std::string colour = base::ToLowerASCII(value);
+  if (colour.size() != 7 || colour[0] != '#' ||
+      !std::all_of(colour.begin() + 1, colour.end(),
+                   [](char c) { return base::IsHexDigit(c); })) {
+    FailColor(std::move(completion),
+              Response::InvalidParams("'value' must be a colour as #rrggbb"));
+    return;
+  }
+  if (!ParsePathIntent(intent.value_or("default"))) {
+    FailColor(std::move(completion), BadIntent());
+    return;
+  }
+  if (std::optional<Response> refusal =
+          CheckSpeedMultiplier(speed_multiplier)) {
+    FailColor(std::move(completion), *refusal);
+    return;
+  }
+  ColorSession::Params params;
+  params.node_id = backend_node_id;
+  params.frame_id = frame_id;
+  params.value = colour;
+  params.intent = std::move(intent);
+  params.speed_multiplier = speed_multiplier.value_or(1);
+  params.timeout = base::Milliseconds(
+      ClampTimeout(timeout_ms, kActionTimeoutMs, kActionTimeoutMaxMs));
+  params.pointer_x = pointer_x;
+  params.pointer_y = pointer_y;
+  params.css_scale = CssScaleOrOne();
+  params.follow_navigation = follow_navigation.value_or(true);
+  // An answer run on the way here started another pick: it must post.
+  DCHECK(!color_session_);
+  color_session_ = std::make_unique<ColorSession>(
+      *this, ++last_color_session_id_, std::move(params), std::move(completion),
+      base::BindOnce(&InputHandler::OnColorSessionDone,
+                     weak_factory_.GetWeakPtr()));
+  color_session_->Start();
+}
