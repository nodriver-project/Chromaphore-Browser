+// browser: other pointer input ends every humanized action under way.
+void InputHandler::InterruptAllSessions() {
+  InterruptDragSession();
+  InterruptMoveSession();
+  InterruptScrollSession();
+  InterruptSelectSession();
+  InterruptTemporalSession();
+  InterruptColorSession();
+  InterruptFileSession();
+}
+
+// browser: the humanized actions work in the root view's DIPs, which are
+// this session's own only on the page's own target: on another frame's, its
+// hit tests, its pixel grid and the cursor would each be in a space of its
+// own.
+std::optional<Response> InputHandler::CheckActionCall(
+    std::string_view command,
+    bool refuse_held_drag,
+    std::initializer_list<const std::optional<double>*> numbers) {
+  if (!host_ || !web_contents_ || !GetRootView()) {
+    return Response::InternalError();
+  }
+  if (!host_->IsOutermostMainFrame()) {
+    return Response::InvalidParams(
+        base::StrCat({command, " runs on the page's own target"}));
+  }
+  if (drag_path_ && drag_path_->end != DragPath::End::kHold) {
+    // A let-go an interrupted drag left under way (a hit test still out)
+    // finishes now.
+    EndDragPath(true);
+  }
+  if (refuse_held_drag && drag_path_) {
+    // A drag is held: it is let go of first, as a press or a wheel turned
+    // now would go under it.
+    return Response::ServerError("A drag is under way");
+  }
+  for (const std::optional<double>* number : numbers) {
+    if (number->has_value() && !std::isfinite(**number)) {
+      return Response::InvalidParams("numbers must be finite");
+    }
+  }
+  return std::nullopt;
+}
+
+// browser: the css_scale the humanized actions' sessions are given.
+float InputHandler::CssScaleOrOne() {
+  const float scale = ScaleFactor();
+  return scale > 0 ? scale : 1;
+}
+
+// browser: Input.revealElement: its parameters handed to RunReveal,
+// answered through AnswerRevealElement.
+void InputHandler::RevealElement(
+    int backend_node_id,
+    const std::string& frame_id,
+    std::optional<double> aim_x,
+    std::optional<double> aim_y,
+    std::optional<double> pointer_x,
+    std::optional<double> pointer_y,
+    std::optional<double> x,
+    std::optional<double> y,
+    std::optional<double> timeout_ms,
+    std::unique_ptr<RevealElementCallback> callback) {
+  RevealRequest request;
+  request.backend_node_id = backend_node_id;
+  request.frame_id = frame_id;
+  request.aim_x = aim_x;
+  request.aim_y = aim_y;
+  // pointerX and pointerY are the names every other action uses; x and y
+  // are this command's older names for the same thing.
+  request.x = pointer_x.has_value() ? pointer_x : x;
+  request.y = pointer_y.has_value() ? pointer_y : y;
+  request.timeout_ms = timeout_ms;
+  // A select under way ends first (RunReveal leaves it: the select's own
+  // reveal goes through it).
+  InterruptSelectSession();
+  InterruptTemporalSession();
+  InterruptColorSession();
+  InterruptFileSession();
+  RunReveal(std::move(request), AnswerRevealElement(std::move(callback)));
+}
+
+// browser: on whole device pixels of the window, where a mouse's pointer
+// always is.
+gfx::PointF InputHandler::OnWindowPixels(RenderWidgetHostViewBase* root_view,
+                                         double x,
+                                         double y) {
+  const float scale = ScaleFactor();
+  const double device_scale =
+      std::max(static_cast<double>(root_view->GetDeviceScaleFactor()), 0.25);
+  gfx::Vector2d in_window;
+#if defined(USE_AURA)
+  if (aura::Window* native = root_view->GetNativeView()) {
+    in_window = native->GetBoundsInRootWindow().OffsetFromOrigin();
+  }
+#endif
+  const auto on_pixel = [device_scale](double dip, double origin) {
+    return static_cast<float>(
+        std::round((dip + origin) * device_scale) / device_scale - origin);
+  };
+  const double asked_x = x * scale;
+  const double asked_y = y * scale;
+  const gfx::PointF at(on_pixel(asked_x, in_window.x()),
+                       on_pixel(asked_y, in_window.y()));
+  // On the view's own pixels when the point asked for is in it: half a pixel
+  // from its edge rounded out of it, and the call was refused.
+  const gfx::Rect view_bounds = root_view->GetViewBounds();
+  const auto inside = [device_scale](float point, double asked, double origin,
+                                     double extent) {
+    if (asked < 0 || asked >= extent) {
+      return point;
+    }
+    const float first = static_cast<float>(
+        std::ceil(origin * device_scale) / device_scale - origin);
+    double last = (std::ceil((origin + extent) * device_scale - 1e-3) - 1) /
+                      device_scale -
+                  origin;
+    if (static_cast<float>(last) >= extent) {
+      last -= 1 / device_scale;  // a scale float cannot hold exactly
+    }
+    return std::clamp(point, std::min(first, static_cast<float>(last)),
+                      static_cast<float>(last));
+  };
+  return gfx::PointF(
+      inside(at.x(), asked_x, in_window.x(), view_bounds.width()),
+      inside(at.y(), asked_y, in_window.y(), view_bounds.height()));
+}
+
+// browser: a reveal checked, its element's local root found and the pointer's
+// place settled, then carried out (RevealAsk on); answered once through
+// `completion`. The request is this call's own: the answers it runs on the way
+// (the move and the drag it interrupts) cannot take it away.
+void InputHandler::RunReveal(RevealRequest request,
+                             RevealCompletion completion) {
+  const int backend_node_id = request.backend_node_id;
+  const std::string& frame_id = request.frame_id;
+  const std::optional<double>& aim_x = request.aim_x;
+  const std::optional<double>& aim_y = request.aim_y;
+  const std::optional<double>& x = request.x;
+  const std::optional<double>& y = request.y;
+  const std::optional<double>& timeout_ms = request.timeout_ms;
+  // browser: other pointer input: a drag Input.performDrag is carrying out
+  // ends first.
+  InterruptDragSession();
+  InterruptMoveSession();
+  InterruptScrollSession();
+  if (std::optional<Response> refusal = CheckActionCall(
+          "Input.revealElement", /*refuse_held_drag=*/true, {})) {
+    FailReveal(std::move(completion), *refusal);
+    return;
+  }
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  RenderFrameHostImpl* rfh = LiveLocalRootForFrame(frame_id);
+  service_manager::InterfaceProvider* remotes =
+      rfh ? rfh->GetRemoteInterfaces() : nullptr;
+  if (!remotes) {
+    FailReveal(std::move(completion),
+               Response::InvalidParams("No frame with the given 'frameId'"));
+    return;
+  }
+  // Where the pointer is: where the last mouse path left it, or as told.
+  gfx::PointF at;
+  if (last_path_point_) {
+    at = gfx::PointF(last_path_point_->x, last_path_point_->y);
+  } else if (x.has_value() && y.has_value()) {
+    at = OnWindowPixels(root_view, *x, *y);
+  } else {
+    FailReveal(std::move(completion),
+               Response::InvalidParams(
+                   "Where the pointer is is not known: give 'x' and 'y'"));
+    return;
+  }
+  const gfx::Rect bounds = root_view->GetViewBounds();
+  if (at.x() < 0 || at.y() < 0 || at.x() >= bounds.width() ||
+      at.y() >= bounds.height()) {
+    FailReveal(std::move(completion),
+               Response::InvalidParams(
+                   "The pointer is outside the page's view, where a wheel "
+                   "turn is not delivered"));
+    return;
+  }
+  if (reveal_) {
+    AnswerReveal("interrupted");  // overtaken where it had got to
+  }
+  auto reveal = std::make_unique<Reveal>();
+  reveal->id = ++last_reveal_id_;
+  reveal->dom_node_id = backend_node_id;
+  reveal->local_root = rfh->GetGlobalId();
+  reveal->aim_x = std::clamp(aim_x.value_or(0.5), 0.0, 1.0);
+  reveal->aim_y = std::clamp(aim_y.value_or(0.5), 0.0, 1.0);
+  // In a frame of another process: the frame elements that hold it, outermost
+  // first, each in its own local root -- brought in after it when the page
+  // around its frame hides where it is. It goes first.
+  {
+    std::vector<Reveal::Chain::Level> levels;
+    RenderFrameHostImpl* child = rfh;
+    while (RenderFrameHostImpl* parent = child->GetParent()) {
+      while (parent && !parent->is_local_root()) {
+        parent = parent->GetParent();
+      }
+      if (!parent) {
+        break;
+      }
+      Reveal::Chain::Level owner;
+      owner.local_root = parent->GetGlobalId();
+      owner.frame_token = child->GetDevToolsFrameToken().ToString();
+      owner.owner = true;
+      levels.insert(levels.begin(), std::move(owner));
+      child = parent;
+    }
+    if (!levels.empty()) {
+      Reveal::Chain::Level element;
+      element.local_root = reveal->local_root;
+      element.dom_node_id = backend_node_id;
+      element.aim_x = reveal->aim_x;
+      element.aim_y = reveal->aim_y;
+      levels.push_back(std::move(element));
+      reveal->chain = std::make_unique<Reveal::Chain>();
+      reveal->chain->levels = std::move(levels);
+      reveal->chain->stage = reveal->chain->levels.size() - 1;
+    }
+  }
+  reveal->deadline = base::TimeTicks::Now() +
+                     base::Milliseconds(ClampTimeout(
+                         timeout_ms, kActionTimeoutMs, kActionTimeoutMaxMs));
+  reveal->at = at;
+  reveal->completion = std::move(completion);
+  remotes->GetInterface(reveal->collector.BindNewPipeAndPassReceiver());
+  reveal->collector.set_disconnect_handler(base::BindOnce(
+      [](base::WeakPtr<InputHandler> handler, uint64_t reveal_id) {
+        if (handler && handler->reveal_ && handler->reveal_->id == reveal_id) {
+          handler->AnswerReveal("gone");
+        }
+      },
+      weak_factory_.GetWeakPtr(), reveal->id));
+  // An answer run on the way here started another reveal: it must post.
+  DCHECK(!reveal_);
+  reveal_ = std::move(reveal);
+  RevealAsk(/*settled=*/false, RevealAxis::kFurther);
+}
+
+// browser: the view of the revealed element's local root, while it is there.
+RenderWidgetHostViewBase* InputHandler::RevealView() {
+  if (!reveal_) {
+    return nullptr;
+  }
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(reveal_->local_root);
+  return rfh && rfh->IsRenderFrameLive()
+             ? static_cast<RenderWidgetHostViewBase*>(rfh->GetView())
+             : nullptr;
+}
+
+// browser: the spin's axis while the quick spins go on, then the one the
+// element is further off on.
+// static
+InputHandler::RevealAxis InputHandler::NextRevealAxis(const Reveal& reveal) {
+  if (reveal.bulk_done) {
+    return RevealAxis::kFurther;
+  }
+  return reveal.vertical ? RevealAxis::kVertical : RevealAxis::kHorizontal;
+}
+
+// browser: asks the element's renderer how things stand, with the wheel judged
+// where the pointer is; once the scroll has run out when `settled`.
+void InputHandler::RevealAsk(bool settled, RevealAxis axis) {
+  Reveal& r = *reveal_;
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  RenderWidgetHostViewBase* view = RevealView();
+  if (!root_view || !view || !r.collector.is_connected()) {
+    AnswerReveal("gone");
+    return;
+  }
+  gfx::PointF local = r.at;
+  root_view->TransformPointToCoordSpaceForView(r.at, view, &local);
+  r.asking = true;
+  r.ask_axis = axis;
+  auto reply = base::BindOnce(&InputHandler::OnRevealRead,
+                              weak_factory_.GetWeakPtr(), r.id, settled);
+  if (settled) {
+    r.collector->CarrySettled(r.dom_node_id, r.aim_x, r.aim_y, local.x(),
+                              local.y(), static_cast<int32_t>(axis),
+                              kRevealSettleTimeoutMs, std::move(reply));
+  } else {
+    r.collector->CarryRead(r.dom_node_id, r.aim_x, r.aim_y, local.x(),
+                           local.y(), static_cast<int32_t>(axis),
+                           std::move(reply));
+  }
+  RevealTick();  // watches the time while the answer is on its way
+}
+
+void InputHandler::OnRevealRead(uint64_t reveal_id,
+                                bool settled,
+                                blink::mojom::AgentCarryReadingPtr reading) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  // browser: a new reading, perhaps a new landing: what a look found at
+  // the last one no longer says what a press there meets.
+  r.land_verdict.clear();
+  r.land_hit.clear();
+  r.land_hit_kind.clear();
+  RenderWidgetHostViewBase* view = RevealView();
+  if (!reading || !reading->found || !view) {
+    AnswerReveal("gone");
+    return;
+  }
+  // A frame element: aimed where the element it holds is in it, so the part
+  // of the frame the page is brought to show is where that element is.
+  if (r.chain && r.chain->levels[r.chain->stage].owner && !r.aimed &&
+      r.chain->point && reading->box) {
+    r.aimed = true;
+    // Where the element is in this local root: its point in its own frame,
+    // moved by the frames' places in their parents -- not by the
+    // compositor's transforms, which a frame inside one scrolled off the page
+    // does not have.
+    RenderFrameHostImpl* inner =
+        RenderFrameHostImpl::FromID(r.chain->levels.back().local_root);
+    RenderFrameHostImpl* here = RenderFrameHostImpl::FromID(r.local_root);
+    const std::optional<gfx::Vector2dF> offset =
+        inner && here ? OffsetByRects(*inner, here) : std::nullopt;
+    if (offset) {
+      const gfx::PointF at = *r.chain->point + *offset;
+      const gfx::RectF box(reading->box->x, reading->box->y,
+                           reading->box->width, reading->box->height);
+      const auto fraction = [](double point, double lo, double length,
+                               double was) {
+        return length >= 1 ? std::clamp((point - lo) / length, 0.02, 0.98)
+                           : was;
+      };
+      const double fx = fraction(at.x(), box.x(), box.width(), r.aim_x);
+      const double fy = fraction(at.y(), box.y(), box.height(), r.aim_y);
+      if (std::abs(fx - r.aim_x) > 0.01 || std::abs(fy - r.aim_y) > 0.01) {
+        r.aim_x = fx;
+        r.aim_y = fy;
+        RevealAsk(settled, RevealAxis::kFurther);
+        return;
+      }
+    }
+  }
+  if (!r.first) {
+    r.first = Reveal::ScrollOffsets{reading->window_x, reading->window_y,
+                                    reading->box_x, reading->box_y};
+  }
+  r.window_x = reading->window_x;
+  r.window_y = reading->window_y;
+  r.box_x = reading->box_x;
+  r.box_y = reading->box_y;
+  if (!reading->box_name.empty()) {
+    r.box_name = reading->box_name;
+  }
+  // Which scrolled first: not known when both did between two
+  // readings.
+  if (!r.first_moved) {
+    const bool window_moved = std::abs(r.window_x - r.first->window_x) >= 0.5 ||
+                              std::abs(r.window_y - r.first->window_y) >= 0.5;
+    const bool box_moved = std::abs(r.box_x - r.first->box_x) >= 0.5 ||
+                           std::abs(r.box_y - r.first->box_y) >= 0.5;
+    if (window_moved || box_moved) {
+      r.first_moved = true;
+      if (window_moved != box_moved) {
+        r.box_first = box_moved;
+      }
+    }
+  }
+  // Into the root view, where the pointer is.
+  const auto root = [view](double x, double y) {
+    return view->TransformPointToRootCoordSpaceF(gfx::PointF(x, y));
+  };
+  const gfx::PointF aim = root(reading->aim_x, reading->aim_y);
+  r.need = aim - root(reading->aim_x - reading->need_x,
+                      reading->aim_y - reading->need_y);
+  const bool covered = !reading->covering.empty();
+  const bool land_shown = reading->land_shown;
+  r.last = std::move(reading);
+  r.last_settled = settled;
+  if (covered) {
+    // Something lies over every place along the box it could be brought to:
+    // no turn of the wheel brings it out from under that -- unless, where it
+    // shows, it is in no state to be pressed whatever lies over it.
+    if (RevealCheckBeforeCovered()) {
+      return;
+    }
+    AnswerReveal("covered");
+    return;
+  }
+  if (r.final_pending) {
+    // The settled reading a last look waited for.
+    r.final_pending = false;
+    RevealAsFarAsItGoes();
+    return;
+  }
+  if (std::abs(r.need.x()) < 0.5 && std::abs(r.need.y()) < 0.5) {
+    if (r.sent > 0 && !settled) {
+      // There, and perhaps still on its way: once the scroll has run out.
+      r.bulk_done = true;
+      r.in_spin = 0;
+      r.next_turn = base::TimeTicks::Now();
+      RevealTick();
+      return;
+    }
+    // Where it should be: a look first, routed as a press is, for another
+    // frame's content over it -- or the page over its frame -- which no turn
+    // of the wheel brings it out from under. Not where the page
+    // hides its frame: that is the frames' stages' to change.
+    if (!r.calm_look && r.last->land_shown &&
+        RevealShows(view->TransformPointToRootCoordSpaceF(
+            gfx::PointF(r.last->land_x, r.last->land_y)))) {
+      r.calm_look = true;
+      r.final_look = true;
+      RevealLook();
+      RevealTick();
+      return;
+    }
+    AnswerReveal("shown");
+    return;
+  }
+  if (!r.looked && r.sent == 0) {
+    r.looked = true;
+    // Not for a frame element, which shows as soon as any edge of it does:
+    // its aim -- where the element is in it -- is brought to the calm part.
+    const bool owner_stage = r.chain && r.chain->levels[r.chain->stage].owner;
+    if (land_shown && !owner_stage &&
+        RevealShows(view->TransformPointToRootCoordSpaceF(
+            gfx::PointF(r.last->land_x, r.last->land_y)))) {
+      // In view already, short of its calm part: left where it is when a
+      // press where a hand would land on it reaches it, as a hand clicks what
+      // it can see.
+      RevealLook();
+      RevealTick();
+      return;
+    }
+  }
+  RevealPlanRouted(settled);
+}
+
+// browser: the plan, after -- at a stage in another process -- where a notch
+// would go is routed as one is, before it turns or moves. The
+// page's own frame: its renderer sees all of it.
+void InputHandler::RevealPlanRouted(bool settled) {
+  Reveal& r = *reveal_;
+  RenderFrameHostImpl* stage_root = RenderFrameHostImpl::FromID(r.local_root);
+  if (stage_root && stage_root->GetParent()) {
+    RevealRouteWheel(settled, /*place=*/false);
+    return;
+  }
+  r.pointer_wheel_routed = true;
+  r.place_wheel_routed = true;
+  r.clear_place.reset();
+  RevealPlan(settled);
+}
+
+// browser: the stage's renderer judged the wheel at the pointer (wheel_ok)
+// and its wheel point without the page's content over its frame, which it
+// cannot see; a notch under that goes to the page, and the page scrolls.
+// The pointer, then the wheel point, hit-tested in the root as a notch is
+// routed; the plan turns only where one goes to the stage's frame, or one
+// inside it.
+void InputHandler::RevealRouteWheel(bool settled, bool place) {
+  Reveal& r = *reveal_;
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  RenderWidgetHostViewBase* view = RevealView();
+  RenderWidgetHostImpl* root_host = root_view ? root_view->host() : nullptr;
+  if (!view || !root_host || !root_host->delegate()) {
+    r.pointer_wheel_routed = true;
+    r.place_wheel_routed = true;
+    r.clear_place.reset();
+    RevealPlan(settled);
+    return;
+  }
+  if (place && r.place_index >= r.places.size()) {
+    // None of the places reaches the frame: nowhere to move to.
+    r.place_wheel_routed = false;
+    r.clear_place.reset();
+    RevealPlan(settled);
+    return;
+  }
+  const gfx::PointF at = place ? r.places[r.place_index] : r.at;
+  r.asking = true;
+  root_host->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+      root_view, at,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnRevealWheelRouted,
+                         weak_factory_.GetWeakPtr(), r.id, settled, place),
+          base::WeakPtr<RenderWidgetHostViewBase>(),
+          std::optional<gfx::PointF>()));
+  RevealTick();  // watches the time meanwhile
+}
+
+void InputHandler::OnRevealWheelRouted(
+    uint64_t reveal_id,
+    bool settled,
+    bool place,
+    base::WeakPtr<RenderWidgetHostViewBase> target,
+    std::optional<gfx::PointF> point) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  RenderWidgetHostViewBase* view = RevealView();
+  // Its own frame, or one inside it, takes the notch. A test that could not
+  // say goes as before.
+  const bool ours =
+      !target || !point.has_value() || !view || target.get() == view ||
+      input::RenderWidgetHostViewInput::IsAncestorView(target.get(), view);
+  if (!place) {
+    r.pointer_wheel_routed = ours;
+    r.clear_place.reset();
+    if (ours && r.last->wheel_ok) {
+      // Turned where the pointer is: no place to move to is needed.
+      r.place_wheel_routed = true;
+      RevealPlan(settled);
+      return;
+    }
+    if (!view) {
+      // The stage's frame went while the test was out: RevealMove ends it.
+      r.place_wheel_routed = true;
+      RevealPlan(settled);
+      return;
+    }
+    // The places to move to, in turn: those the stage's renderer lays over
+    // its frame where the wheel moves what is to scroll, nearest the pointer
+    // first -- asked for now, as only now are they needed, and
+    // along the last reading's axis.
+    r.places.clear();
+    r.place_index = 0;
+    r.cover_view.reset();
+    r.cover_point.reset();
+    RenderWidgetHostViewBase* root_view = GetRootView();
+    if (!root_view || !r.collector.is_connected()) {
+      OnRevealWheelPlaces(reveal_id, settled, {});
+      return;
+    }
+    gfx::PointF local = r.at;
+    root_view->TransformPointToCoordSpaceForView(r.at, view, &local);
+    r.asking = true;
+    r.collector->WheelPlaces(
+        r.dom_node_id, r.aim_x, r.aim_y, local.x(), local.y(),
+        static_cast<int32_t>(r.ask_axis),
+        base::BindOnce(&InputHandler::OnRevealWheelPlaces,
+                       weak_factory_.GetWeakPtr(), reveal_id, settled));
+    RevealTick();  // watches the time while the answer is on its way
+    return;
+  }
+  if (ours) {
+    r.place_wheel_routed = true;
+    r.clear_place = r.places[r.place_index];
+    RevealNudgePlace(settled);
+    return;
+  }
+  // Under the page's content too: the first such is what is named should
+  // none be clear; the next one.
+  if (!r.cover_point && target && point.has_value()) {
+    r.cover_view = target;
+    r.cover_point = point;
+  }
+  r.place_index++;
+  // From a task of its own, not from inside the test's answer: one answered on
+  // the spot would nest a call deeper for every place.
+  r.asking = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&InputHandler::RevealRouteNextPlace,
+                                weak_factory_.GetWeakPtr(), r.id, settled));
+}
+
+void InputHandler::RevealRouteNextPlace(uint64_t reveal_id, bool settled) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  reveal_->asking = false;
+  RevealRouteWheel(settled, /*place=*/true);
+}
+
+// browser: the clear place found is the nearest, on the edge the pointer comes
+// to it across -- the frame's, or that of what the page lays over it. A hand
+// turns the wheel a little inside what it can see: 6-12 px further on, when a
+// notch there reaches the frame too and the page shows the frame there; else
+// the place found.
+void InputHandler::RevealNudgePlace(bool settled) {
+  Reveal& r = *reveal_;
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  RenderWidgetHostImpl* root_host = root_view ? root_view->host() : nullptr;
+  const gfx::Vector2dF way = *r.clear_place - r.at;
+  const float length = way.Length();
+  if (!root_host || !root_host->delegate() || length < 1) {
+    RevealPlan(settled);
+    return;
+  }
+  const float further_by = static_cast<float>(6 + 6 * base::RandDouble());
+  const gfx::PointF further =
+      *r.clear_place + gfx::ScaleVector2d(way, further_by / length);
+  if (!RevealShows(further)) {
+    RevealPlan(settled);
+    return;
+  }
+  r.asking = true;
+  root_host->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+      root_view, further,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnRevealNudgeRouted,
+                         weak_factory_.GetWeakPtr(), r.id, settled, further),
+          base::WeakPtr<RenderWidgetHostViewBase>(),
+          std::optional<gfx::PointF>()));
+  RevealTick();  // watches the time meanwhile
+}
+
+void InputHandler::OnRevealNudgeRouted(
+    uint64_t reveal_id,
+    bool settled,
+    gfx::PointF further,
+    base::WeakPtr<RenderWidgetHostViewBase> target,
+    std::optional<gfx::PointF> point) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  RenderWidgetHostViewBase* view = RevealView();
+  // Only where the test says the stage's own frame takes the notch: not a
+  // frame of another process inside it, where no place is laid (WheelLatch),
+  // nor where it could not say.
+  if (view && target && point.has_value() && target.get() == view) {
+    r.clear_place = further;
+  }
+  RevealPlan(settled);
+}
+
+void InputHandler::OnRevealWheelPlaces(
+    uint64_t reveal_id,
+    bool settled,
+    std::vector<blink::mojom::AgentWheelPlacePtr> places) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  if (!r.last) {
+    AnswerReveal("gone");
+    return;
+  }
+  RenderWidgetHostViewBase* view = RevealView();
+  if (!view) {
+    // The stage's frame went while the places were out: RevealMove ends it.
+    r.place_wheel_routed = true;
+    RevealPlan(settled);
+    return;
+  }
+  for (const auto& place : places) {
+    if (place) {
+      r.places.push_back(view->TransformPointToRootCoordSpaceF(
+          gfx::PointF(place->x, place->y)));
+    }
+  }
+  // None laid: the reading's own wheel point, if it found one.
+  if (r.places.empty() && r.last->wheel_found) {
+    r.places.push_back(view->TransformPointToRootCoordSpaceF(
+        gfx::PointF(r.last->wheel_x, r.last->wheel_y)));
+  }
+  RevealRouteWheel(settled, /*place=*/true);
+}
+
+// browser: no place over the stage's frame that the page leaves clear for the
+// wheel: what lies over the nearest one, named in its own document
+// as a routed look names a cover (OnRevealRouted); then covered.
+void InputHandler::RevealNameCover() {
+  Reveal& r = *reveal_;
+  RenderWidgetHostViewBase* over_view = r.cover_view.get();
+  RenderFrameHostImpl* over =
+      over_view ? BindCollectorFor(over_view, &r.cover_collector) : nullptr;
+  if (!over) {
+    r.covering = CoverName(over_view && IsPageDocument(LocalRootFor(over_view)),
+                           std::string());
+    r.covering_kind.clear();
+    AnswerReveal("covered");
+    return;
+  }
+  r.asking = true;
+  r.cover_collector->DescribePoint(
+      r.cover_point->x(), r.cover_point->y(), std::vector<int32_t>(),
+      /*place=*/true,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnRevealPlaceCoverNamed,
+                         weak_factory_.GetWeakPtr(), r.id,
+                         IsPageDocument(over)),
+          std::string(), 0, std::string()));
+  RevealTick();  // watches the time while the answer is on its way
+}
+
+void InputHandler::OnRevealPlaceCoverNamed(uint64_t reveal_id,
+                                           bool page,
+                                           const std::string& hit,
+                                           int32_t hit_node_id,
+                                           const std::string& value) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  reveal_->asking = false;
+  reveal_->covering = CoverName(page, hit);
+  reveal_->covering_kind.clear();
+  AnswerReveal("covered");
+}
+
+void InputHandler::OnRevealLooked(uint64_t reveal_id,
+                                  const std::string& verdict,
+                                  const std::string& hit,
+                                  const std::string& hit_kind) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  // browser: what a press at the landing meets, for the answer to say.
+  r.land_verdict = verdict;
+  r.land_hit = hit;
+  r.land_hit_kind = hit_kind;
+  if (verdict == "reached" || verdict == "label") {
+    AnswerReveal("shown");
+    return;
+  }
+  if (verdict == "gone") {
+    AnswerReveal("gone");
+    return;
+  }
+  if (r.verdict_look) {
+    // The look at an element where it should be, in its own widget: shown
+    // whatever its own document lays over it there -- the press's to meet
+    // -- or in no state to be pressed there, which no wheel changes;
+    // the answer says which.
+    AnswerReveal("shown");
+    return;
+  }
+  r.miss_verdict = verdict;
+  r.covering = hit;
+  r.covering_kind = hit_kind;
+  if (r.final_look) {
+    RevealMissed();
+    return;
+  }
+  RevealPlanRouted(/*settled=*/false);  // covered where it shows: brought clear
+}
+
+namespace {
+
+// browser: at a frame element's stage, whether that frame element's document
+// is the page's: the parent of the next stage's frame -- the stage's local
+// root only when the frame element sits in it directly.
+bool OwnerDocumentIsPage(GlobalRenderFrameHostId stage_root,
+                         GlobalRenderFrameHostId next_root) {
+  RenderFrameHostImpl* next = RenderFrameHostImpl::FromID(next_root);
+  if (RenderFrameHostImpl* holder = next ? next->GetParent() : nullptr) {
+    return IsPageDocument(holder);
+  }
+  return IsPageDocument(RenderFrameHostImpl::FromID(stage_root));
+}
+
+}  // namespace
+
+// browser: a hit check in the stage's own renderer. At a frame element's
+// stage, what covers the frame element is in its document, which to the
+// element is the page's or another frame's: said so, as a routed look says it.
+// At the element's own stage, as the check names it.
+void InputHandler::OnRevealChecked(uint64_t reveal_id,
+                                   const std::string& verdict,
+                                   const std::string& hit,
+                                   const std::string& hit_kind) {
+  if (reveal_ && reveal_->id == reveal_id && reveal_->chain &&
+      reveal_->chain->stage + 1 < reveal_->chain->levels.size() &&
+      (verdict == "covered" || verdict == "noPointer")) {
+    const bool page = OwnerDocumentIsPage(
+        reveal_->local_root,
+        reveal_->chain->levels[reveal_->chain->stage + 1].local_root);
+    // A name the press check already placed -- a cover in another document
+    // than the stage's frame element (CoverFrom) -- says where it
+    // is, which is where it is for the element too: not placed again.
+    const bool placed = base::StartsWith(hit, "the page's ") ||
+                        base::EndsWith(hit, " in another frame");
+    // The press check's own name for a scrollbar is "a scrollbar".
+    OnRevealLooked(reveal_id, verdict,
+                   placed ? hit
+                   : page && hit == "a scrollbar"
+                       ? std::string("the page's scrollbar")
+                       : CoverName(page, hit),
+                   hit_kind);
+    return;
+  }
+  OnRevealLooked(reveal_id, verdict, hit, hit_kind);
+}
+
+// browser: it shows, but a press where a hand would land does not reach it:
+// covered, with what lies over it; blocked when nothing of it is there; and
+// shown when it is in no state to be pressed (disabled, inert, invisible),
+// which no wheel changes and the caller says.
+void InputHandler::RevealMissed() {
+  Reveal& r = *reveal_;
+  if (r.miss_verdict == "covered" || r.miss_verdict == "noPointer") {
+    if (r.covering.empty()) {
+      r.covering = "something else";
+    }
+    AnswerReveal("covered");
+  } else if (r.miss_verdict == "nothing") {
+    AnswerReveal("blocked");
+  } else {
+    // browser: the look that found it, which a reading since may have
+    // cleared: nothing has turned since it looked.
+    r.land_verdict = r.miss_verdict;
+    r.land_hit = r.covering;
+    r.land_hit_kind = r.covering_kind;
+    AnswerReveal("shown");
+  }
+}
+
+// browser: a reading says something lies over every place the element
+// could be brought to -- an open modal's backdrop lies over everything outside
+// it. At the element's own stage, where it shows, the press check in its own
+// widget first: inert (as everything outside an open modal is), disabled or
+// invisible is what a press meets there whatever lies over it, which no
+// closing of the cover changes either -- shown with that verdict, as
+// RevealMissed answers those states. Only on a reading the page stood still
+// for -- before any notch, or settled -- whose landing a shown answer gives.
+bool InputHandler::RevealCheckBeforeCovered() {
+  Reveal& r = *reveal_;
+  const bool own_stage = !r.chain || !r.chain->levels[r.chain->stage].owner;
+  if (!own_stage || !r.last || (r.sent > 0 && !r.last_settled) ||
+      !r.collector.is_connected() || !RevealLandShows()) {
+    return false;
+  }
+  r.asking = true;
+  r.collector->HitCheck(r.dom_node_id, r.last->land_x, r.last->land_y,
+                        base::BindOnce(&InputHandler::OnRevealCoverChecked,
+                                       weak_factory_.GetWeakPtr(), r.id));
+  RevealTick();  // watches the time while the answer is on its way
+  return true;
+}
+
+void InputHandler::OnRevealCoverChecked(uint64_t reveal_id,
+                                        const std::string& verdict,
+                                        const std::string& hit,
+                                        const std::string& hit_kind) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  if (verdict == "inert" || verdict == "disabled" || verdict == "hidden") {
+    r.land_verdict = verdict;
+    r.land_hit = hit;
+    r.land_hit_kind = hit_kind;
+    AnswerReveal("shown");
+    return;
+  }
+  AnswerReveal(verdict == "gone" ? "gone" : "covered");
+}
+
+// browser: what the last reading asks for: the next spin, the single notches
+// once the scroll has run out, the place to turn the wheel from, or the end.
+void InputHandler::RevealPlan(bool settled) {
+  Reveal& r = *reveal_;
+  const blink::mojom::AgentCarryReading& reading = *r.last;
+  const gfx::Vector2dF need = r.need;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!r.started) {
+    // The axis it is further off on first.
+    r.started = true;
+    r.vertical = std::abs(need.y()) >= std::abs(need.x());
+    r.way = (r.vertical ? need.y() : need.x()) > 0 ? 1 : -1;
+  }
+  if (!settled) {
+    const double remaining = r.way * (r.vertical ? need.y() : need.x());
+    if (r.last_remaining && r.sent > r.sent_at_last &&
+        std::abs(remaining - *r.last_remaining) < 1) {
+      // The wheel turned and nothing moved. A wheel keeps the box its spin
+      // began on until it has rested half a second, and a box that has run
+      // out takes every notch: a breath lets it go, once, as a hand that
+      // finds the wheel doing nothing pauses.
+      if (r.latch_breaks < 1) {
+        r.latch_breaks++;
+        r.last_remaining.reset();
+        r.next_turn = r.turned_at.back() + WheelBreath();
+        RevealTick();
+      } else {
+        RevealAsFarAsItGoes();
+      }
+      return;
+    }
+    if (r.last_remaining && std::abs(remaining - *r.last_remaining) >= 1) {
+      r.latch_breaks = 0;
+    }
+    r.last_remaining = remaining;
+    r.sent_at_last = r.sent;
+    int in_flight = 0;
+    for (const base::TimeTicks at : r.turned_at) {
+      if (now - at < base::Milliseconds(250)) {
+        in_flight++;
+      }
+    }
+    const int left =
+        static_cast<int>(std::lround(remaining / r.per_notch)) - in_flight;
+    if (left <= 1) {
+      // About a notch left: the rest one at a time, once the scroll stops.
+      r.bulk_done = true;
+      r.next_turn = now;
+      RevealTick();
+      return;
+    }
+    if (!reading.wheel_ok || !r.pointer_wheel_routed || !RevealShows(r.at)) {
+      RevealMove();
+      return;
+    }
+    // Far off, longer spins, as a hand flicks a page along.
+    r.in_spin = std::min(left - 1, left > 8 ? base::RandIntInclusive(4, 8)
+                                            : base::RandIntInclusive(2, 3));
+    r.spin_way = r.way;
+    RevealTurn();
+    RevealTick();
+    return;
+  }
+
+  // The scroll has run out.
+  r.settle_rounds++;
+  const bool vertical = std::abs(need.y()) >= std::abs(need.x());
+  const double along = vertical ? need.y() : need.x();
+  if (vertical != r.vertical) {
+    // On to the other axis.
+    r.vertical = vertical;
+    r.way = along > 0 ? 1 : -1;
+    r.last_settled_need.reset();
+    if (std::abs(along) > 2 * r.per_notch && r.axis_resets < 2) {
+      // Far off that way too: spins again, as on the first, with rounds of
+      // their own -- twice at most, so a back-and-forth still ends.
+      r.axis_resets++;
+      r.bulk_done = false;
+      r.last_remaining.reset();
+      r.settle_rounds = 0;
+      r.latch_breaks = 0;
+      r.next_turn = now;
+      RevealTick();
+      return;
+    }
+  }
+  // A spin that moved nothing: a wheel still latched on a box that ran out
+  // gets a breath, once; then the wheel does not scroll it here. One that left
+  // it no nearer -- back and forth across a box smaller than a notch -- is as
+  // near as the wheel brings it.
+  const bool stalled =
+      r.last_settled_need && std::abs(along - *r.last_settled_need) < 1;
+  const bool no_better =
+      r.last_settled_need && !stalled &&
+      std::abs(along) >= std::abs(*r.last_settled_need) - 0.5;
+  if (r.last_settled_need && !stalled) {
+    r.latch_breaks = 0;
+    // What a notch really moves it: between two settled looks, over the
+    // notches turned in between, when it stayed on the same side.
+    if (r.notches_since_settle >= 1 &&
+        (along > 0) == (*r.last_settled_need > 0)) {
+      r.per_notch = std::clamp(
+          std::abs(*r.last_settled_need - along) / r.notches_since_settle, 10.0,
+          400.0);
+    }
+  }
+  r.last_settled_need = along;
+  r.notches_since_settle = 0;
+  // As many notches as bring it into the calm stretch: one more than its
+  // distance only when that does not carry it out the far side, and otherwise
+  // whichever of the two leaves it nearer.
+  const double distance = std::abs(along);
+  const double calm = std::max(0.0, vertical ? reading.calm_y : reading.calm_x);
+  const int more = static_cast<int>(std::ceil(distance / r.per_notch));
+  const int fewer = static_cast<int>(std::floor(distance / r.per_notch));
+  const double past = more * r.per_notch - distance - calm;
+  const double short_by = distance - fewer * r.per_notch;
+  const int notches = past <= 0 ? more : short_by <= past ? fewer : more;
+  if (stalled && r.latch_breaks >= 1) {
+    RevealAsFarAsItGoes();
+    return;
+  }
+  if (!stalled && (notches == 0 || no_better || r.settle_rounds > 8)) {
+    RevealAsFarAsItGoes();
+    return;
+  }
+  if (!reading.wheel_ok || !r.pointer_wheel_routed || !RevealShows(r.at)) {
+    RevealMove();
+    return;
+  }
+  r.in_spin = std::min(std::max(notches, 1), 3);
+  r.spin_way = along > 0 ? 1 : -1;
+  if (stalled) {
+    r.latch_breaks++;
+    r.next_turn =
+        r.turned_at.empty() ? now : r.turned_at.back() + WheelBreath();
+  } else {
+    RevealTurn();
+  }
+  RevealTick();
+}
+
+namespace {
+
+// RevealMove: the hand moves to a wheel point at most this many times in one
+// reveal; the place is a region more than a target, this wide for the
+// leg's timing.
+constexpr int kRevealMovesMax = 3;
+constexpr double kRevealMoveWidthPx = 40;
+
+}  // namespace
+
+// browser: the wheel at the pointer turns something that does not hold the
+// element: the hand moves to where it would -- the renderer's wheel point, on
+// a leg of the hand's own (HandPlanner), held to the view -- as a hand moves
+// before it turns, and the page is read again from there. With no such place,
+// or moved kRevealMovesMax times already, the reveal ends as near as it got.
+void InputHandler::RevealMove() {
+  Reveal& r = *reveal_;
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  RenderWidgetHostViewBase* view = RevealView();
+  // No wheel point -- at a stage in another process, none the page's content
+  // over the frame leaves clear: as near as it got.
+  if (!r.last || (!r.clear_place && !r.last->wheel_found) ||
+      !r.place_wheel_routed || !root_view || !view ||
+      r.moves >= kRevealMovesMax) {
+    RevealAsFarAsItGoes();
+    return;
+  }
+  r.moves++;
+  const gfx::PointF place =
+      r.clear_place ? *r.clear_place
+                    : view->TransformPointToRootCoordSpaceF(
+                          gfx::PointF(r.last->wheel_x, r.last->wheel_y));
+  if (!RevealShows(place)) {
+    // Where the page hides this frame: a turn there would go to the page.
+    RevealAsFarAsItGoes();
+    return;
+  }
+  const PlannerPoint from{r.at.x(), r.at.y()};
+  const PlannerPoint to{place.x(), place.y()};
+  const gfx::Rect bounds = root_view->GetViewBounds();
+  LegConstraints c;
+  // A button held: the drag tempo, as a hand holding one moves.
+  c.button_held =
+      held_button_ != SyntheticPointerActionParams::Button::NO_BUTTON;
+  BoundLegToView(from, to,
+                 DragRect{0, 0, static_cast<double>(bounds.width()),
+                          static_cast<double>(bounds.height())},
+                 &c);
+  HumanPathPlanner& planner = HandPlanner();
+  MousePathRequest request;
+  for (const PlannedPoint& sample :
+       planner.PlanLeg(from, to, kRevealMoveWidthPx, PathIntent::kDefault,
+                       /*speed_multiplier=*/1, c)) {
+    request.points.push_back(sample.p);
+  }
+  if (request.points.empty()) {
+    request.points.push_back(to);
+  }
+  request.polling_rate_hz = planner.polling_rate_hz();
+  request.button = held_button_;
+  // On the pixel nearest the wheel point, where the next turn goes.
+  request.exact_end = true;
+  r.asking = true;
+  QueueMousePath(std::move(request),
+                 base::BindOnce(&InputHandler::OnRevealMoved,
+                                weak_factory_.GetWeakPtr(), r.id));
+  if (std::optional<PlannerPoint> now = LastPointer()) {
+    r.at = gfx::PointF(now->x, now->y);
+  }
+  RevealTick();  // watches the time while the hand moves
+}
+
+void InputHandler::OnRevealMoved(uint64_t reveal_id, bool ok) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  if (!ok) {
+    AnswerReveal("gone");
+    return;
+  }
+  // A new place: what the wheel did, or did not do, from the last one says
+  // nothing of what it does here.
+  r.last_remaining.reset();
+  r.last_settled_need.reset();
+  r.latch_breaks = 0;
+  // A hand that has just come to rest turns the wheel a moment later, not as
+  // it stops: the page is read again after that breath. Nothing else runs
+  // the reveal's timer meanwhile (asking: RevealTick only watches the time).
+  // Never past the reveal's deadline, which this timer stands in for.
+  r.asking = true;
+  r.timer.Start(
+      FROM_HERE,
+      std::clamp(
+          base::Milliseconds(
+              base::RandIntInclusive(kTurnAfterRestMinMs, kTurnAfterRestMaxMs)),
+          base::TimeDelta(),
+          std::max(r.deadline - base::TimeTicks::Now(), base::TimeDelta())),
+      base::BindOnce(
+          [](base::WeakPtr<InputHandler> handler, uint64_t id) {
+            if (!handler || !handler->reveal_ || handler->reveal_->id != id) {
+              return;
+            }
+            Reveal& r = *handler->reveal_;
+            if (base::TimeTicks::Now() >= r.deadline) {
+              handler->AnswerReveal("timeout");
+              return;
+            }
+            r.asking = false;
+            handler->RevealAsk(/*settled=*/r.bulk_done, NextRevealAxis(r));
+          },
+          weak_factory_.GetWeakPtr(), r.id));
+}
+
+// browser: as near as the wheel brings it: shown when it shows and a press
+// where a hand would land on it reaches it -- a last look says -- else as
+// RevealMissed says; blocked when it does not show.
+void InputHandler::RevealAsFarAsItGoes() {
+  Reveal& r = *reveal_;
+  if (r.sent > 0 && !r.last_settled) {
+    // Read while the scroll may still have run: looked at once it has run out,
+    // or the look lands off it.
+    r.final_pending = true;
+    RevealAsk(/*settled=*/true, RevealAxis::kFurther);
+    return;
+  }
+  RenderWidgetHostViewBase* view = RevealView();
+  if (!r.last || !r.last->land_shown || !view ||
+      !RevealShows(view->TransformPointToRootCoordSpaceF(
+          gfx::PointF(r.last->land_x, r.last->land_y)))) {
+    AnswerReveal("blocked");
+    return;
+  }
+  if (r.sent == 0 && !r.miss_verdict.empty()) {
+    RevealMissed();  // looked at before any turn, and nothing has moved
+    return;
+  }
+  r.final_look = true;
+  RevealLook();
+  RevealTick();
+}
+
+// browser: a look at the landing, routed as a press there is: the widget under
+// it first. Another frame's content there -- or the page over this
+// frame -- covers it, named in that frame; a frame element's own frame is it;
+// its own widget, the hit check there.
+void InputHandler::RevealLook() {
+  Reveal& r = *reveal_;
+  r.asking = true;
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  RenderWidgetHostViewBase* view = RevealView();
+  RenderWidgetHostImpl* root_host = root_view ? root_view->host() : nullptr;
+  if (!view || !root_host || !root_host->delegate()) {
+    // browser: the calm look's check at the element's own stage, as the
+    // routed one below makes it.
+    if (r.calm_look && !(r.chain && r.chain->levels[r.chain->stage].owner)) {
+      r.verdict_look = true;
+    }
+    r.collector->HitCheck(r.dom_node_id, r.last->land_x, r.last->land_y,
+                          base::BindOnce(&InputHandler::OnRevealChecked,
+                                         weak_factory_.GetWeakPtr(), r.id));
+    return;
+  }
+  root_host->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+      root_view,
+      view->TransformPointToRootCoordSpaceF(
+          gfx::PointF(r.last->land_x, r.last->land_y)),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnRevealRouted,
+                         weak_factory_.GetWeakPtr(), r.id),
+          base::WeakPtr<RenderWidgetHostViewBase>(),
+          std::optional<gfx::PointF>()));
+}
+
+void InputHandler::OnRevealRouted(
+    uint64_t reveal_id,
+    base::WeakPtr<RenderWidgetHostViewBase> target,
+    std::optional<gfx::PointF> point) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  RenderWidgetHostViewBase* view = RevealView();
+  if (!view || !r.last || !r.collector.is_connected()) {
+    AnswerReveal("gone");
+    return;
+  }
+  if (target && point.has_value() && target.get() != view) {
+    // A frame element: its own frame -- the next level in, or the frame its
+    // reading says it holds -- or one inside it is it.
+    RenderFrameHostImpl* inner = nullptr;
+    if (r.chain && r.chain->stage + 1 < r.chain->levels.size()) {
+      inner = RenderFrameHostImpl::FromID(
+          r.chain->levels[r.chain->stage + 1].local_root);
+    } else if (r.last->child_frame_id) {
+      RenderFrameHostImpl* here = RenderFrameHostImpl::FromID(r.local_root);
+      FrameTreeNode* node =
+          here ? FrameTreeNodeFromDevToolsFrameToken(here->frame_tree_node(),
+                                                     *r.last->child_frame_id)
+               : nullptr;
+      inner = node ? node->current_frame_host() : nullptr;
+    }
+    RenderWidgetHostViewBase* own =
+        inner && inner->is_local_root() && inner->IsRenderFrameLive()
+            ? inner->GetView()
+            : nullptr;
+    if (own &&
+        (target.get() == own ||
+         input::RenderWidgetHostViewInput::IsAncestorView(target.get(), own))) {
+      OnRevealLooked(reveal_id, "reached", std::string());
+      return;
+    }
+    // Its frame in this process, holding another process's.
+    if (inner && !own &&
+        LandsInFrame(LocalRootFor(target.get()), inner->frame_tree_node())) {
+      OnRevealLooked(reveal_id, "reached", std::string());
+      return;
+    }
+    if (RenderFrameHostImpl* over =
+            BindCollectorFor(target.get(), &r.cover_collector)) {
+      r.cover_collector->DescribePoint(
+          point->x(), point->y(), std::vector<int32_t>(), /*place=*/true,
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&InputHandler::OnRevealCoverNamed,
+                             weak_factory_.GetWeakPtr(), reveal_id,
+                             IsPageDocument(over)),
+              std::string(), 0, std::string()));
+      return;
+    }
+    OnRevealLooked(
+        reveal_id, "covered",
+        CoverName(IsPageDocument(LocalRootFor(target.get())), std::string()));
+    return;
+  }
+  // Its own widget, at an element where it should be: shown, as before this
+  // look -- covers in its own document are the press's to meet. At the
+  // element's own stage the check below still runs, for the answer to say
+  // what a press there meets; a frame element's stage goes on.
+  if (r.calm_look) {
+    if (r.chain && r.chain->levels[r.chain->stage].owner) {
+      OnRevealLooked(reveal_id, "reached", std::string());
+      return;
+    }
+    r.verdict_look = true;
+  }
+  // Its own widget: the check there, where a press would get to; at its
+  // landing when the hit test could not say.
+  const gfx::PointF at = target && point.has_value()
+                             ? *point
+                             : gfx::PointF(r.last->land_x, r.last->land_y);
+  r.collector->HitCheck(r.dom_node_id, at.x(), at.y(),
+                        base::BindOnce(&InputHandler::OnRevealChecked,
+                                       weak_factory_.GetWeakPtr(), reveal_id));
+}
+
+void InputHandler::OnRevealCoverNamed(uint64_t reveal_id,
+                                      bool page,
+                                      const std::string& hit,
+                                      int32_t hit_node_id,
+                                      const std::string& value) {
+  OnRevealLooked(reveal_id, "covered", CoverName(page, hit));
+}
+
+// browser: whether the stage's local root shows a root-view point to the
+// page: always for the main frame; for a frame of another process, within
+// the part of it the page shows.
+bool InputHandler::RevealShows(const gfx::PointF& root_point) {
+  RenderFrameHostImpl* rfh =
+      reveal_ ? RenderFrameHostImpl::FromID(reveal_->local_root) : nullptr;
+  if (!rfh || !rfh->GetParent()) {
+    return true;
+  }
+  return ShownPartInRoot(*rfh).Contains(root_point);
+}
+
+// browser: whether the element of a reveal that ends covered shows where it
+// is now -- 24 px of it each way, or all of it, inside every box that holds
+// it in its frame (the reading's land_shown), its landing at a place of that
+// frame the page shows -- so what covers it is on top of it in view.
+// Covered is answered from the first reading, before any notch, wherever the
+// element is. At a frame element's stage the reading is the frame
+// element's, landed wherever the frame shows: the element's own last reading
+// is judged instead -- its place in its frame does not move as the frames
+// around it scroll -- as RevealChainGoesOn judges it.
+bool InputHandler::RevealLandShows() {
+  Reveal& r = *reveal_;
+  const bool outer = r.chain && r.chain->stage + 1 < r.chain->levels.size();
+  const blink::mojom::AgentCarryReading* reading =
+      outer ? r.chain->target_last.get() : r.last.get();
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(
+      outer ? r.chain->levels.back().local_root : r.local_root);
+  RenderWidgetHostViewBase* view =
+      rfh && rfh->IsRenderFrameLive()
+          ? static_cast<RenderWidgetHostViewBase*>(rfh->GetView())
+          : nullptr;
+  if (!reading || !reading->land_shown || !view) {
+    return false;
+  }
+  return !rfh->GetParent() ||
+         ShownPartInRoot(*rfh).Contains(view->TransformPointToRootCoordSpaceF(
+             gfx::PointF(reading->land_x, reading->land_y)));
+}
+
+// browser: the live local root whose widget `view` is.
+RenderFrameHostImpl* InputHandler::LocalRootFor(
+    RenderWidgetHostViewBase* view) {
+  if (!host_ || !view) {
+    return nullptr;
+  }
+  RenderFrameHostImpl* found = nullptr;
+  host_->ForEachRenderFrameHostImpl([&found, view](RenderFrameHostImpl* rfh) {
+    if (!found && rfh->is_local_root() && rfh->IsRenderFrameLive() &&
+        rfh->GetView() == view) {
+      found = rfh;
+    }
+  });
+  return found;
+}
+
+// browser: the collector of the local root whose widget `view` is, bound,
+// and that local root.
+RenderFrameHostImpl* InputHandler::BindCollectorFor(
+    RenderWidgetHostViewBase* view,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector>* collector) {
+  RenderFrameHostImpl* found = LocalRootFor(view);
+  service_manager::InterfaceProvider* remotes =
+      found ? found->GetRemoteInterfaces() : nullptr;
+  if (!remotes) {
+    return nullptr;
+  }
+  collector->reset();
+  remotes->GetInterface(collector->BindNewPipeAndPassReceiver());
+  return found;
+}
+
+// browser: the frame's local root, by the frame's DevTools token, while it is
+// live.
+RenderFrameHostImpl* InputHandler::LiveLocalRootForFrame(
+    const std::string& frame_id) {
+  if (!host_) {
+    return nullptr;
+  }
+  FrameTreeNode* node =
+      FrameTreeNodeFromDevToolsFrameToken(host_->frame_tree_node(), frame_id);
+  RenderFrameHostImpl* rfh = node ? node->current_frame_host() : nullptr;
+  while (rfh && !rfh->is_local_root()) {
+    rfh = rfh->GetParent();
+  }
+  return rfh && rfh->IsRenderFrameLive() ? rfh : nullptr;
+}
+
+// browser: the frame's local root, as RunMove finds an element's.
+RenderFrameHostImpl* InputHandler::BindCollectorForFrame(
+    const std::string& frame_id,
+    mojo::Remote<blink::mojom::AgentSnapshotCollector>* collector) {
+  RenderFrameHostImpl* rfh = LiveLocalRootForFrame(frame_id);
+  service_manager::InterfaceProvider* remotes =
+      rfh ? rfh->GetRemoteInterfaces() : nullptr;
+  if (!remotes) {
+    return nullptr;
+  }
+  collector->reset();
+  remotes->GetInterface(collector->BindNewPipeAndPassReceiver());
+  return rfh;
+}
+
+void InputHandler::ReadFocusedField(int32_t before_node_id,
+                                    GlobalRenderFrameHostId before_root,
+                                    std::optional<std::string> expect,
+                                    int settle_ms,
+                                    int quiet_ms,
+                                    bool settle_for_text,
+                                    blink::mojom::AgentNoTyposPtr no_typos,
+                                    FieldReadCallback done) {
+  // The frame the keys go to, as KeyboardTargetWidget finds its widget: this
+  // session's own frame when it is a child's, else the focused frame, else
+  // the main frame.
+  RenderFrameHostImpl* root = nullptr;
+  if (host_ && host_->GetParent()) {
+    root = host_;
+  } else if (web_contents_) {
+    root = web_contents_->GetFocusedFrame();
+    if (!root) {
+      root = web_contents_->GetPrimaryMainFrame();
+    }
+  }
+  while (root && !root->is_local_root()) {
+    root = root->GetParent();
+  }
+  service_manager::InterfaceProvider* remotes =
+      root && root->IsRenderFrameLive() ? root->GetRemoteInterfaces() : nullptr;
+  if (!remotes) {
+    std::move(done).Run(GlobalRenderFrameHostId(),
+                        blink::mojom::AgentFieldReadingPtr());
+    return;
+  }
+  const GlobalRenderFrameHostId root_id = root->GetGlobalId();
+  // The pasted text goes only to the renderer the reading before found the
+  // field in: focus gone on to another site's frame is not told it.
+  if (expect.has_value() && root_id != before_root) {
+    expect.reset();
+  }
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+  remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+  blink::mojom::AgentSnapshotCollector* proxy = collector.get();
+  auto once = base::MakeRefCounted<FieldReadOnce>(
+      base::BindOnce(std::move(done), root_id));
+  proxy->ReadField(
+      before_root == root_id ? before_node_id : 0, std::move(expect), settle_ms,
+      quiet_ms, settle_for_text, std::move(no_typos),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](mojo::Remote<blink::mojom::AgentSnapshotCollector>,
+                 scoped_refptr<FieldReadOnce> answer,
+                 blink::mojom::AgentFieldReadingPtr reading) {
+                answer->Run(std::move(reading));
+              },
+              std::move(collector), once),
+          blink::mojom::AgentFieldReadingPtr()));
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&FieldReadOnce::Run, once,
+                     blink::mojom::AgentFieldReadingPtr()),
+      base::Milliseconds(settle_ms) + kFieldReadMargin);
+}
+
+void InputHandler::PlacePointer(const gfx::PointF& at) {
+  last_path_point_ = SyntheticMousePathGestureParams::Position{at.x(), at.y()};
+  ShowCursorAt(at, /*is_click=*/false);
+}
+
+// browser: where a stage of a reveal through frames goes on from. A
+// frame element brought in, or as far as the wheel brings it: the next level
+// in. The element itself: answered when the page shows it there; else the
+// frame elements again, twice at most. Anything else (gone, timeout,
+// interrupted, the element covered) is the answer.
+bool InputHandler::RevealChainGoesOn(std::string* outcome) {
+  Reveal& r = *reveal_;
+  Reveal::Chain& c = *r.chain;
+  if (*outcome != "shown" && *outcome != "blocked") {
+    // Covered -- a frame element under page content where the element is, or
+    // the element itself -- is the answer, as is anything else.
+    return false;
+  }
+  if (c.stage + 1 < c.levels.size()) {
+    StartRevealStage(c.stage + 1);
+    return true;
+  }
+  RenderWidgetHostViewBase* view = RevealView();
+  if (!view || !r.last) {
+    return false;
+  }
+  const blink::mojom::AgentCarryReading& reading = *r.last;
+  c.point = reading.land_shown ? gfx::PointF(reading.land_x, reading.land_y)
+                               : gfx::PointF(reading.aim_x, reading.aim_y);
+  if (RevealShows(view->TransformPointToRootCoordSpaceF(*c.point))) {
+    // Where the page shows it: shown, or as far as its frame's own wheel
+    // brings it, which the frames around it cannot change.
+    return false;
+  }
+  if (c.passes >= 2) {
+    // The page around its frame still hides it.
+    *outcome = "blocked";
+    return false;
+  }
+  c.passes++;
+  StartRevealStage(0);
+  return true;
+}
+
+// browser: a stage's notches and scrolls into the chain; the element's own
+// last reading kept for the answer.
+void InputHandler::FoldRevealStage(Reveal& reveal) {
+  Reveal::Chain& c = *reveal.chain;
+  c.notches += reveal.sent;
+  const bool element = c.stage + 1 == c.levels.size();
+  if (reveal.first) {
+    const double window_x = reveal.window_x - reveal.first->window_x;
+    const double window_y = reveal.window_y - reveal.first->window_y;
+    const double box_x = reveal.box_x - reveal.first->box_x;
+    const double box_y = reveal.box_y - reveal.first->box_y;
+    const bool box_moved = std::abs(box_x) >= 0.5 || std::abs(box_y) >= 0.5;
+    const bool window_moved =
+        std::abs(window_x) >= 0.5 || std::abs(window_y) >= 0.5;
+    // What this stage adds to the page's figures, and to the box's.
+    bool to_page = false;
+    bool to_box = false;
+    if (c.stage == 0) {
+      c.page_x += window_x;
+      c.page_y += window_y;
+      to_page = window_moved;
+    }
+    if (element) {
+      if (box_moved) {
+        c.box_x += box_x;
+        c.box_y += box_y;
+        c.box_name = reveal.box_name;
+        to_box = true;
+      } else if (window_moved) {
+        c.box_x += window_x;
+        c.box_y += window_y;
+        c.box_name = "the frame";
+        to_box = true;
+      }
+    } else if (c.stage == 0 && box_moved && c.box_name.empty()) {
+      c.box_x += box_x;
+      c.box_y += box_y;
+      c.box_name = reveal.box_name;
+      to_box = true;
+    }
+    // Which scrolled first: the element's own stage runs first;
+    // a stage that moved both says its own order.
+    if (!c.first_moved && (to_page || to_box)) {
+      c.first_moved = true;
+      c.box_first =
+          to_page && to_box ? reveal.box_first : std::optional<bool>(to_box);
+    }
+  }
+  if (element && reveal.last) {
+    c.target_last = reveal.last.Clone();
+  }
+  if (!reveal.turned_at.empty()) {
+    c.last_turn = std::max(c.last_turn, reveal.turned_at.back());
+  }
+}
+
+// browser: the next stage of a reveal through frames: a Reveal of its own,
+// with the call's completion, deadline and pointer, in the stage's local root.
+// A frame element is first found by its renderer (OwnerOf).
+void InputHandler::StartRevealStage(size_t stage) {
+  std::unique_ptr<Reveal> done = std::move(reveal_);
+  FoldRevealStage(*done);
+  done->timer.Stop();
+  auto next = std::make_unique<Reveal>();
+  next->id = ++last_reveal_id_;
+  next->completion = std::move(done->completion);
+  next->deadline = done->deadline;
+  next->at = done->at;
+  next->chain = std::move(done->chain);
+  next->chain->stage = stage;
+  const Reveal::Chain::Level& level = next->chain->levels[stage];
+  next->local_root = level.local_root;
+  next->dom_node_id = level.dom_node_id;
+  next->aim_x = level.aim_x;
+  next->aim_y = level.aim_y;
+  // A wheel's sequence stays with the widget it began on for half a second
+  // after its last notch, and only a new one passes from a frame to the page
+  // or back: this level's first notch waits for one.
+  if (!next->chain->last_turn.is_null()) {
+    next->fresh_after = next->chain->last_turn + WheelBreath();
+  }
+  reveal_ = std::move(next);
+  Reveal& r = *reveal_;
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(level.local_root);
+  // browser: a frame that has left the page (the back-forward cache) is
+  // frozen and never answers: its reveal goes no further.
+  service_manager::InterfaceProvider* remotes =
+      rfh && rfh->IsActive() && rfh->IsRenderFrameLive()
+          ? rfh->GetRemoteInterfaces()
+          : nullptr;
+  if (!remotes) {
+    AnswerReveal("gone");
+    return;
+  }
+  remotes->GetInterface(r.collector.BindNewPipeAndPassReceiver());
+  r.collector.set_disconnect_handler(base::BindOnce(
+      [](base::WeakPtr<InputHandler> handler, uint64_t reveal_id) {
+        if (handler && handler->reveal_ && handler->reveal_->id == reveal_id) {
+          handler->AnswerReveal("gone");
+        }
+      },
+      weak_factory_.GetWeakPtr(), r.id));
+  if (level.owner) {
+    r.asking = true;
+    r.collector->OwnerOf(level.frame_token,
+                         base::BindOnce(&InputHandler::OnRevealOwner,
+                                        weak_factory_.GetWeakPtr(), r.id));
+    RevealTick();
+    return;
+  }
+  RevealAsk(/*settled=*/false, RevealAxis::kFurther);
+}
+
+void InputHandler::OnRevealOwner(uint64_t reveal_id,
+                                 bool found,
+                                 int32_t node_id) {
+  if (!reveal_ || reveal_->id != reveal_id) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  r.asking = false;
+  if (!found) {
+    // The frame that held it is not where it was.
+    AnswerReveal("gone");
+    return;
+  }
+  r.dom_node_id = node_id;
+  r.chain->levels[r.chain->stage].dom_node_id = node_id;
+  RevealAsk(/*settled=*/false, RevealAxis::kFurther);
+}
+
+// browser: one notch of the wheel where the pointer is, as a hand turns one: a
+// mouse path gesture with no move and one notch, phased and latched by the
+// browser as a real wheel is.
+void InputHandler::RevealTurn() {
+  Reveal& r = *reveal_;
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  if (!root_view || r.in_spin <= 0) {
+    r.in_spin = 0;
+    return;
+  }
+  if (base::TimeTicks::Now() < r.fresh_after) {
+    // A new wheel sequence first (StartRevealStage): the clock turns it then.
+    r.next_turn = r.fresh_after;
+    return;
+  }
+  // The other way from the last notch, near where its sequence began and
+  // under 560 ms after it: a wheel's sequence keeps what it began on until it
+  // has rested half a second or the pointer has gone 10 DIPs from where it
+  // began (MouseWheelPhaseHandler), so a row the page's notches brought under
+  // the pointer takes none of them -- the page does, and moves nothing (4-8
+  // notches lost, then a breath). A new sequence first, as a hand
+  // pauses before it turns the wheel the other way.
+  if (!r.turned_at.empty() && r.turned_vertical != r.vertical &&
+      (r.at - r.seq_from).Length() < kWheelSequenceSpanDips &&
+      base::TimeTicks::Now() <
+          r.turned_at.back() + base::Milliseconds(kWheelBreathMinMs)) {
+    r.next_turn = r.turned_at.back() + WheelBreath();
+    return;
+  }
+  TurnWheel(r.at, r.vertical, r.spin_way,
+            SyntheticPointerActionParams::Button::NO_BUTTON);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // A notch after half a second's rest, or 10 DIPs from where the last
+  // sequence began, begins one of its own.
+  if (r.turned_at.empty() ||
+      BeginsWheelSequence(now - r.turned_at.back(),
+                          (r.at - r.seq_from).Length())) {
+    r.seq_from = r.at;
+  }
+  r.turned_vertical = r.vertical;
+  r.sent++;
+  r.notches_since_settle++;
+  r.turned_at.push_back(now);
+  r.in_spin--;
+  // A spin's notches 40-90 ms apart, and a breath between spins.
+  r.next_turn =
+      now +
+      base::Milliseconds(
+          r.in_spin > 0
+              ? base::RandIntInclusive(kNotchGapMinMs, kNotchGapMaxMs)
+              : base::RandIntInclusive(kSpinBreathMinMs, kSpinBreathMaxMs));
+}
+
+// browser: a mouse-path gesture of the pointer's one point with the notch
+// turned there; the pointer is there for the next mouse path to go on from.
+bool InputHandler::TurnWheel(const gfx::PointF& at,
+                             bool vertical,
+                             int way,
+                             SyntheticPointerActionParams::Button button) {
+  RenderWidgetHostViewBase* root_view = GetRootView();
+  if (!root_view) {
+    return false;
+  }
+  SyntheticMousePathGestureParams params;
+  params.from_devtools_debugger = true;
+  params.gesture_source_type = content::mojom::GestureSourceType::kMouseInput;
+  params.button = button;
+  params.polling_interval = kMousePollingInterval;
+  params.positions.push_back({at.x(), at.y()});
+  params.has_start = true;
+  params.start = params.positions.back();
+  params.wheel.push_back(
+      {vertical ? 0 : way, vertical ? way : 0, base::TimeDelta()});
+  const gfx::Rect bounds = root_view->GetViewBounds();
+  params.view_width = bounds.width();
+  params.view_height = bounds.height();
+  root_view->host()->QueueSyntheticGestureCompleteImmediately(
+      std::make_unique<SyntheticMousePathGesture>(params));
+  // The pointer is there: the next mouse path goes on from it.
+  last_path_point_ = params.positions.back();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (wheel_sequence_.last_notch.is_null() ||
+      BeginsWheelSequence(now - wheel_sequence_.last_notch,
+                          (at - wheel_sequence_.began_at).Length())) {
+    wheel_sequence_.began_at = at;
+    wheel_sequence_.local_root = GlobalRenderFrameHostId();
+    wheel_sequence_.scroller_id = 0;
+  }
+  wheel_sequence_.last_notch = now;
+  wheel_sequence_.vertical = vertical;
+  return true;
+}
+
+void InputHandler::NoteWheelScroller(GlobalRenderFrameHostId local_root,
+                                     int32_t scroller_id) {
+  wheel_sequence_.local_root = local_root;
+  wheel_sequence_.scroller_id = scroller_id;
+}
+
+// browser: the reveal's clock: the next notch when it is due, the next look
+// when a spin is over, and the end when its time is up.
+void InputHandler::RevealTick() {
+  if (!reveal_) {
+    return;
+  }
+  Reveal& r = *reveal_;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (now >= r.deadline) {
+    AnswerReveal("timeout");
+    return;
+  }
+  if (r.asking) {
+    // An answer is on its way, and goes on from there; until then only the
+    // time is watched.
+    r.timer.Start(
+        FROM_HERE, r.deadline - now,
+        base::BindOnce(&InputHandler::RevealTick, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (now < r.next_turn) {
+    r.timer.Start(
+        FROM_HERE, std::min(r.next_turn, r.deadline) - now,
+        base::BindOnce(&InputHandler::RevealTick, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (r.in_spin > 0) {
+    RevealTurn();
+    r.timer.Start(
+        FROM_HERE,
+        std::max(r.next_turn - base::TimeTicks::Now(), base::TimeDelta()),
+        base::BindOnce(&InputHandler::RevealTick, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  RevealAsk(/*settled=*/r.bulk_done, NextRevealAxis(r));
+}
+
+void InputHandler::AnswerReveal(const std::string& asked) {
+  std::string outcome = asked;
+  // A stage of a reveal through frames that the next one goes on from.
+  if (reveal_ && reveal_->chain && reveal_->completion &&
+      RevealChainGoesOn(&outcome)) {
+    return;
+  }
+  // Out of view, and the wheel can be turned nowhere over its frame that the
+  // page leaves clear: covered, by what lies over the nearest place, once the
+  // chain goes no further -- not "nothing of it is rendered". Not
+  // when it shows where it would land: a look's "nothing" there is its own.
+  if (outcome == "blocked" && reveal_ && reveal_->completion &&
+      !reveal_->place_wheel_routed && reveal_->cover_point &&
+      !RevealLandShows()) {
+    RevealNameCover();
+    return;
+  }
+  // With covered: whether it shows where it is now, read while the stage that
+  // answers is still the one under way.
+  std::optional<bool> shows;
+  if (outcome == "covered" && reveal_) {
+    shows = RevealLandShows();
+  }
+  std::unique_ptr<Reveal> reveal = std::move(reveal_);
+  if (!reveal) {
+    return;
+  }
+  reveal->timer.Stop();
+  if (!reveal->completion) {
+    return;
+  }
+  // browser: whether this is the element's own stage, not a frame
+  // element's: only a look there says what a press on the element meets.
+  const bool own_stage =
+      !reveal->chain || !reveal->chain->levels[reveal->chain->stage].owner;
+  // Through frames: every stage's notches and scrolls; the element as it was
+  // last read in its own frame, whatever stage this is.
+  if (reveal->chain) {
+    FoldRevealStage(*reveal);
+    Reveal::Chain& c = *reveal->chain;
+    if (c.stage + 1 < c.levels.size() && c.target_last) {
+      // What covers a frame element where the element is, said for it: in the
+      // frame element's document, which to the element is the page's or
+      // another frame's.
+      if (reveal->last && !reveal->last->covering.empty()) {
+        reveal->covering =
+            CoverName(OwnerDocumentIsPage(reveal->local_root,
+                                          c.levels[c.stage + 1].local_root),
+                      reveal->last->covering);
+        // The reading named it, with no kind: none an earlier look gave.
+        reveal->covering_kind.clear();
+      }
+      reveal->last = std::move(c.target_last);
+      reveal->local_root = c.levels.back().local_root;
+    }
+  }
+  std::optional<double> x;
+  std::optional<double> y;
+  std::optional<bool> calm;
+  std::optional<double> element_x;
+  std::optional<double> element_y;
+  std::optional<double> element_width;
+  std::optional<double> element_height;
+  RenderFrameHostImpl* rfh = RenderFrameHostImpl::FromID(reveal->local_root);
+  RenderWidgetHostViewBase* view =
+      rfh && rfh->IsRenderFrameLive()
+          ? static_cast<RenderWidgetHostViewBase*>(rfh->GetView())
+          : nullptr;
+  if (reveal->last && view && web_contents_) {
+    // In CSS pixels of the main frame's viewport, as mouse paths are given.
+    const float scale = ScaleFactor();
+    const auto css = [view, scale](double px, double py) {
+      return gfx::ScalePoint(
+          view->TransformPointToRootCoordSpaceF(gfx::PointF(px, py)),
+          1 / scale);
+    };
+    const blink::mojom::AgentCarryReading& reading = *reveal->last;
+    if (reading.box) {
+      const gfx::PointF from = css(reading.box->x, reading.box->y);
+      const gfx::PointF to = css(reading.box->x + reading.box->width,
+                                 reading.box->y + reading.box->height);
+      element_x = from.x();
+      element_y = from.y();
+      element_width = to.x() - from.x();
+      element_height = to.y() - from.y();
+    }
+    if (outcome == "shown") {
+      const gfx::PointF land = css(reading.land_x, reading.land_y);
+      x = land.x();
+      y = land.y();
+      calm = reading.land_calm;
+    }
+  }
+  std::optional<double> window_x;
+  std::optional<double> window_y;
+  std::optional<double> box_x;
+  std::optional<double> box_y;
+  if (reveal->first) {
+    window_x = reveal->window_x - reveal->first->window_x;
+    window_y = reveal->window_y - reveal->first->window_y;
+    box_x = reveal->box_x - reveal->first->box_x;
+    box_y = reveal->box_y - reveal->first->box_y;
+  }
+  int notches = reveal->sent;
+  std::string box_name = reveal->box_name;
+  if (reveal->chain) {
+    const Reveal::Chain& c = *reveal->chain;
+    notches = c.notches;
+    window_x = c.page_x;
+    window_y = c.page_y;
+    box_x = c.box_x;
+    box_y = c.box_y;
+    box_name = c.box_name;
+  }
+  // What covers it, with covered only: what lies over the whole stretch when
+  // the reading said so, else what the last look met.
+  std::optional<std::string> covering;
+  std::optional<std::string> covering_kind;
+  if (outcome == "covered") {
+    if (reveal->last && !reveal->last->covering.empty()) {
+      covering = reveal->last->covering;
+    } else if (!reveal->covering.empty()) {
+      covering = reveal->covering;
+      if (!reveal->covering_kind.empty()) {
+        covering_kind = reveal->covering_kind;
+      }
+    }
+  }
+  // Where the pointer is: the hand may have moved for the wheel.
+  std::optional<double> pointer_x;
+  std::optional<double> pointer_y;
+  if (std::optional<PlannerPoint> pointer = LastPointer();
+      pointer && web_contents_) {
+    const float scale = ScaleFactor();
+    if (scale > 0) {
+      pointer_x = pointer->x / scale;
+      pointer_y = pointer->y / scale;
+    }
+  }
+  // Which scrolled first: through frames, as the stages folded in.
+  const std::optional<bool> box_first =
+      reveal->chain ? reveal->chain->box_first : reveal->box_first;
+  RevealResult result;
+  result.outcome = outcome;
+  result.x = x;
+  result.y = y;
+  result.calm = calm;
+  result.element_x = element_x;
+  result.element_y = element_y;
+  result.element_width = element_width;
+  result.element_height = element_height;
+  result.notches = notches;
+  result.window_scrolled_x = window_x;
+  result.window_scrolled_y = window_y;
+  result.box_scrolled_x = box_x;
+  result.box_scrolled_y = box_y;
+  if (!box_name.empty()) {
+    result.box = box_name;
+  }
+  result.covering = covering;
+  result.covering_kind = covering_kind;
+  result.pointer_x = pointer_x;
+  result.pointer_y = pointer_y;
+  result.shows = shows;
+  result.box_first = box_first;
+  // browser: with shown, what a press at the landing meets, as the last
+  // look there found it.
+  if (outcome == "shown" && own_stage && !reveal->land_verdict.empty()) {
+    result.land_verdict = reveal->land_verdict;
+    if (!reveal->land_hit.empty()) {
+      result.land_hit = reveal->land_hit;
+    }
+    if (!reveal->land_hit_kind.empty()) {
+      result.land_hit_kind = reveal->land_hit_kind;
+    }
+  }
+  std::move(reveal->completion).Run(std::move(result));
+}
+
+// browser: Input.performDrag: the call checked, its elements resolved in one
+// local root -- the main frame's, or a cross-origin frame's when the drag is
+// all inside it; across documents it is refused as unreachable before
+// anything is read or pressed -- the pointer's place settled, then carried out
+// whole by a DragSession, which answers it once.
+void InputHandler::PerformDrag(std::optional<int> grab_node_id,
+                               std::optional<std::string> grab_frame_id,
+                               std::optional<double> grab_x,
+                               std::optional<double> grab_y,
+                               std::optional<double> grab_fraction_x,
+                               std::optional<double> grab_fraction_y,
+                               std::optional<int> target_node_id,
+                               std::optional<std::string> target_frame_id,
+                               std::optional<double> aim_x,
+                               std::optional<double> aim_y,
+                               std::optional<std::string> slot,
+                               std::optional<double> fraction_x,
+                               std::optional<double> fraction_y,
+                               std::optional<double> point_x,
+                               std::optional<double> point_y,
+                               std::optional<double> value,
+                               std::optional<int> modifiers,
+                               std::optional<double> press_hold_ms,
+                               std::optional<double> pointer_x,
+                               std::optional<double> pointer_y,
+                               std::optional<double> speed_multiplier,
+                               std::optional<double> timeout_ms,
+                               std::optional<bool> follow_navigation,
+                               std::unique_ptr<PerformDragCallback> callback) {
+  // Other pointer input ends a reveal under way where it has got to, and a
+  // drag under way (answered interrupted once its drag has ended).
+  if (reveal_) {
+    AnswerReveal("interrupted");
+  }
+  InterruptAllSessions();
+  if (std::optional<Response> refusal = CheckActionCall(
+          "Input.performDrag", /*refuse_held_drag=*/true,
+          {&grab_x, &grab_y, &grab_fraction_x, &grab_fraction_y, &aim_x, &aim_y,
+           &fraction_x, &fraction_y, &point_x, &point_y, &value, &press_hold_ms,
+           &pointer_x, &pointer_y, &speed_multiplier, &timeout_ms})) {
+    callback->sendFailure(*refusal);
+    return;
+  }
+  const bool grab_by_node = grab_node_id.has_value();
+  const bool grab_by_point = grab_x.has_value() || grab_y.has_value();
+  if (grab_by_node == grab_by_point ||
+      (grab_by_node && (!grab_frame_id || *grab_node_id <= 0)) ||
+      (grab_by_point && !(grab_x && grab_y))) {
+    callback->sendFailure(Response::InvalidParams(
+        "Give either 'grabNodeId' and 'grabFrameId', or 'grabX' and "
+        "'grabY'"));
+    return;
+  }
+  const bool to_element = target_node_id.has_value();
+  const bool to_fraction = fraction_x.has_value() || fraction_y.has_value();
+  const bool to_point = point_x.has_value() || point_y.has_value();
+  const bool to_value = value.has_value();
+  const int targets = (to_element ? 1 : 0) + (to_fraction ? 1 : 0) +
+                      (to_point ? 1 : 0) + (to_value ? 1 : 0);
+  if (targets != 1 ||
+      (to_element && (!target_frame_id || *target_node_id <= 0)) ||
+      (to_fraction && !(fraction_x && fraction_y)) ||
+      (to_point && !(point_x && point_y))) {
+    callback->sendFailure(Response::InvalidParams(
+        "Give exactly one target: 'targetNodeId' and 'targetFrameId', "
+        "'fractionX' and 'fractionY', 'pointX' and 'pointY', or 'value'"));
+    return;
+  }
+  DragSession::Slot drag_slot = DragSession::Slot::kOn;
+  if (slot.has_value()) {
+    if (*slot == "before") {
+      drag_slot = DragSession::Slot::kBefore;
+    } else if (*slot == "after") {
+      drag_slot = DragSession::Slot::kAfter;
+    } else if (*slot != "on") {
+      callback->sendFailure(
+          Response::InvalidParams("'slot' must be on, before or after"));
+      return;
+    }
+  }
+  if (modifiers.has_value() && !ValidModifiers(*modifiers)) {
+    callback->sendFailure(Response::InvalidParams(
+        "'modifiers' must combine Alt=1, Ctrl=2, Meta=4 and Shift=8"));
+    return;
+  }
+  if (press_hold_ms.has_value() &&
+      (*press_hold_ms < 0 || *press_hold_ms > 5000)) {
+    callback->sendFailure(
+        Response::InvalidParams("'pressHoldMs' must be between 0 and 5000"));
+    return;
+  }
+  if (std::optional<Response> refusal =
+          CheckSpeedMultiplier(speed_multiplier)) {
+    callback->sendFailure(*refusal);
+    return;
+  }
+  // The drag's one local root: the main frame's, or a cross-origin frame's
+  // when the element to grab and the target are both in it. One
+  // document to another's is refused: a pointer drag's moves stay with the
+  // frame that was pressed, and a native one across documents is not carried
+  // yet.
+  RenderFrameHostImpl* main_frame = host_->GetMainFrame();
+  RenderFrameHostImpl* drag_root = nullptr;
+  if (grab_by_node) {
+    RenderFrameHostImpl* rfh = LiveLocalRootForFrame(*grab_frame_id);
+    if (!rfh) {
+      DragSession::Refuse(std::move(callback), "gone",
+                          "the frame of the element to grab is gone");
+      return;
+    }
+    drag_root = rfh;
+  }
+  if (to_element) {
+    RenderFrameHostImpl* rfh = LiveLocalRootForFrame(*target_frame_id);
+    if (!rfh) {
+      DragSession::Refuse(std::move(callback), "gone",
+                          "the frame of the target is gone");
+      return;
+    }
+    // Grabbed at a point outside what the page shows of the target's frame
+    // of another process: across documents, as by element. A point inside
+    // it is the press's routing's to judge (DragSession::RouteGrab).
+    bool point_outside = false;
+    if (!grab_by_node && rfh->is_local_root_subframe()) {
+      const float at_scale = ScaleFactor();
+      const gfx::PointF grab_at(*grab_x * at_scale, *grab_y * at_scale);
+      point_outside = !ShownPartInRoot(*rfh).Contains(grab_at);
+    }
+    if ((drag_root && rfh != drag_root) || point_outside) {
+      DragSession::Refuse(std::move(callback), "unreachable",
+                          "the element to grab and the target are in "
+                          "different documents, one of them in a "
+                          "cross-origin frame: a drag from one into the "
+                          "other is not supported");
+      return;
+    }
+    drag_root = rfh;
+  }
+  if (!drag_root) {
+    drag_root = main_frame;
+  }
+  service_manager::InterfaceProvider* remotes =
+      drag_root && drag_root->IsRenderFrameLive()
+          ? drag_root->GetRemoteInterfaces()
+          : nullptr;
+  if (!remotes) {
+    DragSession::Refuse(std::move(callback), "gone",
+                        "the page's renderer is gone");
+    return;
+  }
+  // Where the hand is: where the last mouse path left it, or as told.
+  const float scale = ScaleFactor();
+  std::optional<PlannerPoint> hand = LastPointer();
+  if (!hand && pointer_x && pointer_y) {
+    hand = PlannerPoint{*pointer_x * scale, *pointer_y * scale};
+  }
+  if (!hand) {
+    DragSession::Refuse(std::move(callback), "unreachable",
+                        "the pointer's place is not known: give 'pointerX' "
+                        "and 'pointerY'");
+    return;
+  }
+
+  DragSession::Params params;
+  params.local_root = drag_root->GetGlobalId();
+  if (grab_by_node) {
+    params.grab_node_id = *grab_node_id;
+  } else {
+    params.grab_point = PlannerPoint{*grab_x * scale, *grab_y * scale};
+  }
+  if (grab_fraction_x) {
+    params.grab_fraction_x = std::clamp(*grab_fraction_x, 0.0, 1.0);
+  }
+  if (grab_fraction_y) {
+    params.grab_fraction_y = std::clamp(*grab_fraction_y, 0.0, 1.0);
+  }
+  if (to_element) {
+    params.target_kind = DragSession::TargetKind::kElement;
+    params.target_node_id = *target_node_id;
+    params.aim_x = std::clamp(aim_x.value_or(0.5), 0.0, 1.0);
+    params.aim_y = std::clamp(aim_y.value_or(0.5), 0.0, 1.0);
+  } else if (to_fraction) {
+    params.target_kind = DragSession::TargetKind::kFraction;
+    params.fraction_x = std::clamp(*fraction_x, 0.0, 1.0);
+    params.fraction_y = std::clamp(*fraction_y, 0.0, 1.0);
+  } else if (to_point) {
+    params.target_kind = DragSession::TargetKind::kPoint;
+    params.point = PlannerPoint{*point_x * scale, *point_y * scale};
+  } else {
+    params.target_kind = DragSession::TargetKind::kValue;
+    params.value = *value;
+  }
+  params.slot = drag_slot;
+  params.slot_given = slot.has_value();
+  params.modifiers = modifiers.value_or(0);
+  params.press_hold_ms = press_hold_ms;
+  params.hand = *hand;
+  params.speed_multiplier = speed_multiplier.value_or(1);
+  params.timeout = base::Milliseconds(
+      ClampTimeout(timeout_ms, kLongActionTimeoutMs, kLongActionTimeoutMaxMs));
+  params.variation_seed = base::RandUint64();
+  params.follow_navigation = follow_navigation.value_or(true);
+  params.css_scale = scale > 0 ? scale : 1;
+
+  mojo::Remote<blink::mojom::AgentSnapshotCollector> collector;
+  remotes->GetInterface(collector.BindNewPipeAndPassReceiver());
+  drag_session_ = std::make_unique<DragSession>(
+      *this, ++last_drag_session_id_, params, std::move(collector),
+      std::move(callback),
+      base::BindOnce(&InputHandler::OnDragSessionDone,
+                     weak_factory_.GetWeakPtr()));
+  drag_session_->Start();
+}
+
+// browser: the session under way is interrupted: its drag ends (a native
+// one at once, a pointer one put back) and its answer follows; it is kept
+// until it has answered.
+void InputHandler::InterruptDragSession() {
+  std::unique_ptr<DragSession> session = std::move(drag_session_);
+  if (!session) {
+    return;
+  }
+  session->Interrupt();
+  if (!session->answered()) {
+    ending_drag_sessions_.push_back(std::move(session));
+  }
+}
+
+void InputHandler::OnDragSessionDone(uint64_t id) {
+  if (drag_session_ && drag_session_->id() == id) {
+    drag_session_.reset();
+    return;
+  }
+  std::erase_if(ending_drag_sessions_,
+                [id](const std::unique_ptr<DragSession>& session) {
+                  return session->id() == id;
+                });
+}
+
+// browser: a drag just intercepted, held where it started as the system's drag
+// loop holds one from the moment it begins: dragenter there, then a dragover
+// every 53-73 ms, until Input.performDrag's executor walks it on or lets go of
+// it, or interception is turned off, which calls it off.
+void InputHandler::HoldInterceptedDrag(const DropData& drop_data,
+                                       blink::DragOperationsMask mask,
+                                       const gfx::PointF& location_in_screen) {
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  if (drag_path_ || !widget_host || !widget_host->GetView()) {
+    return;
+  }
+  const gfx::PointF point =
+      location_in_screen -
+      widget_host->GetView()->GetViewBounds().OffsetFromOrigin();
+  if (!PointIsWithinContents(point)) {
+    return;
+  }
+  auto drag = std::make_unique<DragPath>();
+  drag->id = ++last_drag_path_id_;
+  drag->mask = mask;
+  drag->drop_data = std::make_unique<DropData>(drop_data);
+  drag->source = drag_source_;
+  drag->raw.push_back(point);
+  drag->over_root = point;
+  drag->interval = kMousePollingInterval;
+  // browser: with the keys Input.performDrag holds through it (none else).
+  drag->key_modifiers = GetEventModifiers(drag_modifiers_, false, false,
+                                          /*location=*/0, /*buttons=*/1);
+  drag->drop_modifiers = GetEventModifiers(drag_modifiers_, false, false,
+                                           /*location=*/0, /*buttons=*/0);
+  drag->started = base::TimeTicks::Now();
+  drag_path_ = std::move(drag);
+  // On the pixel grid the walks snap to, so a walk's points that stay on
+  // this pixel equal it and send only the resting cadence.
+  SnapDragPoints();
+  drag_path_->over_root = drag_path_->points.front();
+  DragPathStep();
+}
+
+void InputHandler::DragEnded() {
+  drag_controller_.drag_state_ = nullptr;
+  drag_controller_.initial_state_ = nullptr;
+  // browser: the intercepted drag is over, however it ended. One still held is
+  // no longer; nothing more goes to it, and Input.performDrag hears so.
+  drag_source_.reset();
+  ForgetDragPath();
+}
+
+Response InputHandler::SetInterceptDrags(bool enabled,
+                                         std::optional<bool> carry) {
+  const bool carrying = enabled && carry.value_or(false);  // browser
+  if (!drag_call_owners_.empty()) {
+    // browser: Input.performDrag keeps interception on through its drag: this
+    // is the setting put back when it is over.
+    saved_intercept_drags_ = enabled;
+    saved_carry_intercepted_drags_ = carrying;
+    return Response::Success();
+  }
+  // The client's own setting from now: no grace puts back an older one.
+  drag_grace_timer_.Stop();
+  intercept_drags_ = enabled;
+  carry_intercepted_drags_ = carrying;
+  // browser: a drag held with no Input.performDrag carrying it is not left
+  // held once interception ends: it is called off (dragleave, then dragend).
+  if (!enabled && drag_path_) {
+    EndDragPath(false);
+  }
+  return Response::Success();
+}
