+                          /*field_after=*/nullptr, /*action_outcome=*/nullptr);
+    return;
+  }
+  if (!host_ || !host_->GetRenderWidgetHost()) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+
+  KeyboardTypingSession::Params params;
+  params.text = text;
+  if (speed_multiplier.has_value() && speed_multiplier.value() > 0.0) {
+    params.speed_multiplier = speed_multiplier.value();
+  }
+  if (keystroke_delay_min.has_value()) {
+    params.keystroke_delay_min_ms = std::max(1, keystroke_delay_min.value());
+  }
+  if (keystroke_delay_max.has_value()) {
+    params.keystroke_delay_max_ms = std::max(1, keystroke_delay_max.value());
+  }
+  if (params.keystroke_delay_max_ms < params.keystroke_delay_min_ms) {
+    params.keystroke_delay_max_ms = params.keystroke_delay_min_ms;
+  }
+  if (key_hold_min.has_value()) {
+    params.key_hold_min_ms = std::max(0, key_hold_min.value());
+  }
+  if (key_hold_max.has_value()) {
+    params.key_hold_max_ms = std::max(0, key_hold_max.value());
+  }
+  if (params.key_hold_max_ms < params.key_hold_min_ms) {
+    params.key_hold_max_ms = params.key_hold_min_ms;
+  }
+  if (context_aware.has_value()) {
+    params.context_aware = context_aware.value();
+  }
+  if (thinking_pause_probability.has_value()) {
+    params.thinking_pause_probability =
+        std::clamp(thinking_pause_probability.value(), 0.0, 1.0);
+  }
+  if (thinking_pause_min.has_value()) {
+    params.thinking_pause_min_ms = std::max(0, thinking_pause_min.value());
+  }
+  if (thinking_pause_max.has_value()) {
+    params.thinking_pause_max_ms = std::max(0, thinking_pause_max.value());
+  }
+  if (params.thinking_pause_max_ms < params.thinking_pause_min_ms) {
+    params.thinking_pause_max_ms = params.thinking_pause_min_ms;
+  }
+  if (typo_probability.has_value()) {
+    params.typo_probability = std::clamp(typo_probability.value(), 0.0, 1.0);
+  }
+  // Without a seed, the microsecond clock makes each call's schedule
+  // distinct.
+  params.seed = seed.has_value() ? SeedFromNumber(seed.value()) : ClockSeed();
+
+  // A session already running on this handler is cancelled; its destructor
+  // answers that session's CDP callback: failed, unless its keys had gone
+  // down.
+  active_typing_session_.reset();
+  const int request = ++typing_request_;
+  blink::mojom::AgentNoTyposPtr rule = NoTyposOf(no_typos.get());
+  const bool had_rule = !rule.is_null();
+  const bool read = read_back.value_or(false);
+  if (!read && !had_rule) {
+    StartKeystrokes(std::move(params), follow_navigation.value_or(true),
+                    /*read_back=*/false, std::move(callback),
+                    GlobalRenderFrameHostId(), nullptr);
+    return;
+  }
+  // browser: the field the keys start in, read first: what it holds,
+  // for the answer, and whether the call's no-typos rule holds for it.
+  ReadFocusedField(
+      0, GlobalRenderFrameHostId(), std::nullopt, 0, 0,
+      /*settle_for_text=*/false, std::move(rule),
+      base::BindOnce(&InputHandler::OnKeystrokesFieldRead,
+                     weak_factory_.GetWeakPtr(), request, std::move(params),
+                     follow_navigation.value_or(true), read, had_rule,
+                     std::move(callback)));
+}
+
+void InputHandler::OnKeystrokesFieldRead(
+    int request,
+    KeyboardTypingSession::Params params,
+    bool follow_navigation,
+    bool read_back,
+    bool had_rule,
+    std::unique_ptr<DispatchKeystrokesCallback> callback,
+    GlobalRenderFrameHostId root,
+    blink::mojom::AgentFieldReadingPtr before) {
+  // A later typing call, chord or paste came meanwhile: it took the keys.
+  if (request != typing_request_) {
+    callback->sendFailure(Response::ServerError("Typing session aborted"));
+    return;
+  }
+  // No typo where the call's rule says a wrong character costs something,
+  // nor in a field that could not be read to tell: the rule fails closed.
+  if (had_rule && (!before || before->strict)) {
+    params.typo_probability = 0.0;
+  }
+  if (!read_back) {
+    before.reset();
+  }
+  StartKeystrokes(std::move(params), follow_navigation, read_back,
+                  std::move(callback), root, std::move(before));
+}
+
+void InputHandler::StartKeystrokes(
+    KeyboardTypingSession::Params params,
+    bool follow_navigation,
+    bool read_back,
+    std::unique_ptr<DispatchKeystrokesCallback> callback,
+    GlobalRenderFrameHostId before_root,
+    blink::mojom::AgentFieldReadingPtr before) {
+  RenderWidgetHostImpl* widget_host = KeyboardTargetWidget();
+  if (!widget_host) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  // browser: what the keys lead to is watched from here.
+  const int action_id = OutcomeWatch()->ArmKeys(widget_host, follow_navigation);
+  active_typing_session_ = std::make_unique<KeyboardTypingSession>(
+      widget_host->GetWeakPtr(), std::move(params),
+      base::BindOnce(&InputHandler::OnKeystrokeSessionFinished,
+                     weak_factory_.GetWeakPtr(), std::move(callback), action_id,
+                     read_back, before_root, std::move(before)));
+  active_typing_session_->Start();
+}
+
+void InputHandler::StopHeldKeyRepeat() {
+  if (active_typing_session_ && active_typing_session_->holding()) {
+    active_typing_session_.reset();
+  }
+}
+
+void InputHandler::OnKeystrokeSessionFinished(
+    std::unique_ptr<DispatchKeystrokesCallback> callback,
+    int action_id,
+    bool read_back,
+    GlobalRenderFrameHostId before_root,
+    blink::mojom::AgentFieldReadingPtr before,
+    bool success,
+    int typos_corrected) {
+  // active_typing_session_ is left alone: when a session finishes
+  // synchronously inside Start(), a re-entrant DispatchKeystrokes may already
+  // own a newer session, and resetting here would destroy it.
+  if (success) {
+    // browser: answered once what the keys led to is known; with
+    // a read-back, once the field has been read after them too.
+    ActionOutcomeWatch::Reply(
+        outcome_watch_.get(), action_id,
+        base::BindOnce(&InputHandler::AnswerKeystrokes,
+                       weak_factory_.GetWeakPtr(), std::move(callback),
+                       typos_corrected, read_back, before_root,
+                       std::move(before)));
+  } else {
+    if (outcome_watch_) {
+      outcome_watch_->Abandon(action_id);
+    }
+    callback->sendFailure(Response::ServerError("Typing session aborted"));
+  }
+}
+
+void InputHandler::AnswerKeystrokes(
+    std::unique_ptr<DispatchKeystrokesCallback> callback,
+    int typos_corrected,
+    bool read_back,
+    GlobalRenderFrameHostId before_root,
+    blink::mojom::AgentFieldReadingPtr before,
+    std::unique_ptr<Page::ActionOutcome> outcome) {
+  if (!read_back || LeftDocument(outcome.get())) {
+    callback->sendSuccess(typos_corrected, FieldReadingOf(before.get()),
+                          /*field_after=*/nullptr, std::move(outcome));
+    return;
+  }
+  const int32_t before_node = before ? before->node_id : 0;
+  ReadFocusedField(
+      before_node, before_root, std::nullopt, kTypedSettleMs, kTypedQuietMs,
+      /*settle_for_text=*/false, nullptr,
+      base::BindOnce(&InputHandler::OnKeystrokesFieldAfter,
+                     weak_factory_.GetWeakPtr(), std::move(callback),
+                     typos_corrected, before_root, std::move(before),
+                     std::move(outcome)));
+}
+
+void InputHandler::OnKeystrokesFieldAfter(
+    std::unique_ptr<DispatchKeystrokesCallback> callback,
+    int typos_corrected,
+    GlobalRenderFrameHostId before_root,
+    blink::mojom::AgentFieldReadingPtr before,
+    std::unique_ptr<Page::ActionOutcome> outcome,
+    GlobalRenderFrameHostId root,
+    blink::mojom::AgentFieldReadingPtr after) {
+  callback->sendSuccess(
+      typos_corrected, FieldReadingOf(before.get()),
+      AfterReadingOf(before.get(), before_root, root, after.get()),
+      std::move(outcome));
+}
+
+RenderWidgetHostImpl* InputHandler::KeyboardTargetWidget() {
+  if (!host_ || !host_->GetRenderWidgetHost()) {
+    return nullptr;
+  }
+  RenderWidgetHostImpl* widget_host = host_->GetRenderWidgetHost();
+  if (!host_->GetParent() && widget_host->delegate()) {
+    RenderWidgetHostImpl* target_host =
+        widget_host->delegate()->GetFocusedRenderWidgetHost(widget_host);
+    if (target_host) {
+      widget_host = target_host;
+    }
+  }
+  return widget_host;
+}
+
+void InputHandler::StartChordSession(int modifiers,
+                                     const std::string& key,
+                                     int phase,
+                                     double speed_multiplier,
+                                     base::OnceCallback<void(bool)> done) {
+  RenderWidgetHostImpl* widget_host = KeyboardTargetWidget();
+  if (!widget_host) {
+    std::move(done).Run(false);
+    return;
+  }
+  using ChordPhase = KeyboardTypingSession::Params::ChordPhase;
+  KeyboardTypingSession::Params params;
+  params.chord = true;
+  params.chord_modifiers = modifiers;
+  params.chord_key = key;
+  params.chord_phase = phase == 1   ? ChordPhase::kDown
+                       : phase == 2 ? ChordPhase::kUp
+                                    : ChordPhase::kFull;
+  if (speed_multiplier > 0.0) {
+    params.speed_multiplier = speed_multiplier;
+  }
+  params.seed = ClockSeed();
+  // browser: a key the session being replaced holds repeats on until this
+  // one's keyup for it goes out -- a hand lets go some moments after deciding
+  // to, and the key repeats until it does.
+  if (params.chord_phase == ChordPhase::kUp && active_typing_session_) {
+    params.held_repeat = active_typing_session_->PendingRepeat();
+  }
+  // A session already running on this handler is cancelled, as for
+  // dispatchKeystrokes; so is a typing call or a paste still waiting for its
+  // field reading before.
+  active_typing_session_.reset();
+  ++typing_request_;
+  active_typing_session_ = std::make_unique<KeyboardTypingSession>(
+      widget_host->GetWeakPtr(), std::move(params),
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> done, bool success,
+             int /*typos_corrected*/) { std::move(done).Run(success); },
+          std::move(done)));
+  active_typing_session_->Start();
+}
+
+// browser: Input.dispatchKeyChord.
+void InputHandler::DispatchKeyChord(
+    int modifiers,
+    std::optional<std::string> key,
+    std::optional<std::string> phase,
+    std::optional<double> speed_multiplier,
+    std::optional<bool> follow_navigation,
+    std::unique_ptr<DispatchKeyChordCallback> callback) {
+  if (!ValidModifiers(modifiers)) {
+    callback->sendFailure(Response::InvalidParams(
+        "'modifiers' must combine Alt=1, Ctrl=2, Meta=4 and Shift=8"));
+    return;
+  }
+  const std::string which = phase.value_or("full");
+  int phase_index = 0;
+  if (which == "full") {
+    phase_index = 0;
+  } else if (which == "down") {
+    phase_index = 1;
+  } else if (which == "up") {
+    phase_index = 2;
+  } else {
+    callback->sendFailure(
+        Response::InvalidParams("'phase' must be one of full, down, up"));
+    return;
+  }
+  if (key.has_value()) {
+    if (!KeyboardTypingSession::IsChordKey(*key) || which != "full") {
+      callback->sendFailure(Response::InvalidParams(
+          "'key' must be one character or a key name such as Escape, Enter, "
+          "ArrowDown or F5, and only for phase full"));
+      return;
+    }
+  }
+  if (!KeyboardTargetWidget()) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  // browser: a chord with a key is an action whose outcome is watched; one
+  // of modifiers alone (a ctrl+click's down and up) is not.
+  base::WeakPtr<ActionOutcomeWatch> watch;
+  int action_id = 0;
+  if (key.has_value()) {
+    watch = OutcomeWatch()->GetWeakPtr();
+    action_id = watch->ArmKeys(KeyboardTargetWidget(),
+                               follow_navigation.value_or(true));
+  }
+  StartChordSession(
+      modifiers, key.value_or(std::string()), phase_index,
+      speed_multiplier.value_or(1.0),
+      base::BindOnce(
+          [](base::WeakPtr<ActionOutcomeWatch> weak_watch, int armed,
+             std::unique_ptr<DispatchKeyChordCallback> callback, bool success) {
+            if (success) {
+              ActionOutcomeWatch::Reply(
+                  weak_watch.get(), armed,
+                  base::BindOnce(&DispatchKeyChordCallback::sendSuccess,
+                                 std::move(callback)));
+            } else {
+              if (weak_watch) {
+                weak_watch->Abandon(armed);
+              }
+              callback->sendFailure(Response::ServerError("Key chord aborted"));
+            }
+          },
+          watch, action_id, std::move(callback)));
+}
