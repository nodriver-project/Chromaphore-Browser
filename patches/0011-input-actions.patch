+// After the opening click, the list is watched for this long, then once this
+// much longer, as a hand waits for a list that is slow to come.
+constexpr base::TimeDelta kOpenWait = base::Milliseconds(500);
+constexpr base::TimeDelta kOpenExtra = base::Milliseconds(300);
+// A shown list's row for the option is asked for at most this many times
+// more (a long list builds its rows in batches).
+constexpr int kMaxRowReads = 4;
+// Arrow presses a person steps through before reaching for Home, End or the
+// letters; and the most keys a pick sends.
+constexpr int kArrowsMax = 6;
+constexpr int kMaxKeys = 64;
+// The hand is placed this far inside the view.
+constexpr double kEdgeDips = 2;
+// The option row's width for the hand's timing, at least.
+constexpr double kMinRowDips = 8;
+// Out of time with a click, the pick or a key on its way: its answer is
+// waited for this long (a click's end answers once what it led to settles:
+// the watch's handled cap, its grace and its commit cap).
+constexpr base::TimeDelta kInFlightWait = base::Milliseconds(5000);
+// The most time between typed letters, whatever the speed: a select's own
+// type-ahead forgets them after about a second.
+constexpr base::TimeDelta kTypeAheadGap = base::Milliseconds(600);
+// Out of time after the opening click: the list is looked for this many
+// times, this far apart, and closed if any look finds it shown.
+constexpr int kCloseLooks = 3;
+constexpr base::TimeDelta kCloseLookGap = base::Milliseconds(16);
+constexpr char kChangedReason[] =
+    "its options changed while its list was open: read it again";
+constexpr char kTimeoutReason[] = "the pick took longer than its timeoutMs";
+// Ctrl in the protocol's modifier bits, and the phases of a chord that press
+// and let go of it (InputHandler::StartChordSession).
+constexpr int kCtrlModifier = 2;
+constexpr int kChordDown = 1;
+constexpr int kChordUp = 2;
+
+SelectOptionFigures FiguresOf(const blink::mojom::AgentSelectOption& option) {
+  SelectOptionFigures figures;
+  figures.index = option.index;
+  figures.text = option.text;
+  figures.value = option.value;
+  return figures;
+}
+
+// How many of the keys a route needs are planned: at most one more than a
+// pick sends, so a longer route still shows as cut. The counts are the
+// renderer's, of any size.
+size_t KeyCount(int64_t count) {
+  return static_cast<size_t>(std::clamp<int64_t>(count, 0, kMaxKeys + 1));
+}
+
+}  // namespace
+
+SelectResult::SelectResult() = default;
+SelectResult::SelectResult(SelectResult&&) = default;
+SelectResult& SelectResult::operator=(SelectResult&&) = default;
+SelectResult::~SelectResult() = default;
+
+SelectSession::Params::Params() = default;
+SelectSession::Params::Params(const Params&) = default;
+SelectSession::Params& SelectSession::Params::operator=(const Params&) =
+    default;
+SelectSession::Params::~Params() = default;
+
+SelectSession::SelectSession(InputHandler& handler,
+                             uint64_t id,
+                             Params params,
+                             Completion completion,
+                             base::OnceCallback<void(uint64_t)> on_done)
+    : handler_(handler),
+      id_(id),
+      params_(std::move(params)),
+      completion_(std::move(completion)),
+      on_done_(std::move(on_done)),
+      started_(base::TimeTicks::Now()) {}
+
+SelectSession::~SelectSession() {
+  // The handler is going (its input state reset): nothing of it is asked.
+  if (completion_) {
+    handler_alive_ = false;
+    // Its outcome watch is not asked either.
+    action_id_ = 0;
+    Send("interrupted", InterruptionName(InputHandler::Interruption::kReset),
+         std::string(), /*wait=*/false);
+  }
+}
+
+base::WeakPtr<SelectSession> SelectSession::Weak() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void SelectSession::Start() {
+  timeout_timer_.Start(FROM_HERE, params_.timeout,
+                       base::BindOnce(&SelectSession::OnTimeout, Weak()));
+  RenderFrameHostImpl* rfh =
+      handler_->BindCollectorForFrame(params_.frame_id, &collector_);
+  if (!rfh) {
+    Answer("gone", "the select's frame is gone");
+    return;
+  }
+  local_root_ = rfh->GetGlobalId();
+  Ask(Read::kFirst);
+}
+
+void SelectSession::Interrupt(InputHandler::Interruption why) {
+  if (answered()) {
+    return;
+  }
+  if (why == InputHandler::Interruption::kNavigated) {
+    // The page that saw Ctrl go down is gone: no keyup goes to the next one.
+    frame_left_ = true;
+  }
+  if (option_click_) {
+    // An option's click under way: its answer first, and what it led to
+    // with it (the move answers once that has settled). Ctrl is let go of
+    // now: the input that cut it short goes out without it held.
+    interrupted_ = why;
+    ReleaseCtrl();
+    handler_->InterruptMoveSession();
+    return;
+  }
+  StopSteps();
+  AnswerInterrupted(why);
+}
+
+void SelectSession::AnswerInterrupted(InputHandler::Interruption why) {
+  if (as_picked_) {
+    // All of the pick went out: only the reading after it was cut short, or
+    // its frame went (the navigation it led to is in its outcome).
+    Answer("picked", why == InputHandler::Interruption::kNavigated
+                         ? "navigated"
+                         : std::string());
+    return;
+  }
+  Answer("interrupted", InterruptionName(why));
+}
+
+void SelectSession::StopSteps() {
+  if (moving_) {
+    // The hand stops where it has got to (its answer, posted, finds this one
+    // answered).
+    handler_->InterruptMoveSession();
+  }
+  if (revealing_ && handler_->reveal_) {
+    handler_->AnswerReveal("interrupted");
+  }
+}
+
+void SelectSession::Ask(Read read) {
+  if (!collector_.is_connected()) {
+    OnRead(read, blink::mojom::AgentSelectReadingPtr());
+    return;
+  }
+  // The key route is read where it may be planned; the list's watch, each
+  // frame, and the looks after the pick read only what shows.
+  const bool want_route =
+      read == Read::kFirst || read == Read::kKeyStart || read == Read::kKey;
+  collector_->ReadSelect(
+      params_.node_id, params_.values, want_route,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&SelectSession::OnRead, Weak(), read),
+          blink::mojom::AgentSelectReadingPtr()));
+}
+
+void SelectSession::OnRead(Read read,
+                           blink::mojom::AgentSelectReadingPtr reading) {
+  if (answered()) {
+    return;
+  }
+  const bool list_shows =
+      reading && reading->kind == "menuList" && reading->popup_shown;
+  if (read == Read::kClose) {
+    if (list_shows) {
+      // Opened after the time ran out: closed again (the key goes to the
+      // list, and the page sees none).
+      handler_->PressKey("Escape", base::DoNothing());
+    } else if (reading && ++close_looks_ < kCloseLooks) {
+      // A list the browser is about to show: looked for again.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE, base::BindOnce(&SelectSession::Ask, Weak(), Read::kClose),
+          kCloseLookGap);
+      return;
+    }
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (read == Read::kChanged) {
+    if (list_shows) {
+      // Still open: closed without a pick (the key goes to the list).
+      handler_->PressKey("Escape", base::DoNothing());
+    }
+    if (reading && reading->kind != "gone") {
+      // The options as they are now go in the answer.
+      latest_ = std::move(reading);
+    }
+    Answer("unreachable", kChangedReason);
+    return;
+  }
+  if (timed_out_) {
+    // Out of time: the look that answers it is on its way.
+    return;
+  }
+  if (read == Read::kGone) {
+    if (reading && reading->kind != "gone") {
+      // The select is still there (an onchange made its options anew):
+      // stopped partway, as it shows now.
+      latest_ = std::move(reading);
+      Answer("interrupted", "optionsGone");
+      return;
+    }
+    // The select went too: as the last reading showed it.
+    Answer("interrupted", "gone");
+    return;
+  }
+  if (!reading) {
+    OnGone("the page's renderer went away");
+    return;
+  }
+  if (reading->kind == "gone") {
+    OnGone("the select is no longer in the page");
+    return;
+  }
+  latest_ = std::move(reading);
+  // A reading after the pick says what it made.
+  as_picked_ = false;
+  const blink::mojom::AgentSelectReading& r = *latest_;
+  switch (read) {
+    case Read::kFirst:
+      OnFirstRead(r);
+      return;
+    case Read::kList:
+      OnListRead(r);
+      return;
+    case Read::kKeyStart:
+      StartKeys(r);
+      return;
+    case Read::kKey:
+      OnKeyRead(r);
+      return;
+    case Read::kAfter:
+      // What is selected now goes in the answer (Send reads it): a list box
+      // set that is not the one asked for is said by its caller.
+      Answer("picked");
+      return;
+    case Read::kRecheck:
+      OnRecheck(r);
+      return;
+    case Read::kClose:
+    case Read::kChanged:
+    case Read::kGone:
+      return;
+  }
+}
+
+void SelectSession::OnGone(const std::string& reason) {
+  if (as_picked_) {
+    // All of the pick went out and the page replaced the select after it (an
+    // onchange that renders it anew): picked, as the pick made it.
+    Answer("picked", "replaced");
+    return;
+  }
+  if (keys_cut_ && next_key_ >= keys_.size()) {
+    // A key route cut at the cap, sent whole: it could not reach the option.
+    KeysFailed("noMove");
+    return;
+  }
+  if (reached_) {
+    // Part of the pick went out (an option clicked, keys pressed), then the
+    // select or an option it was to click went: stopped partway, with what
+    // that part led to. When it was an option, the select is read once more,
+    // Ctrl let go of meanwhile, so a select still there answers what it shows
+    // now (OnRead).
+    if (option_went_ && !reading_after_gone_) {
+      reading_after_gone_ = true;
+      ReleaseCtrl();
+      Ask(Read::kGone);
+      return;
+    }
+    Answer("interrupted", "gone");
+    return;
+  }
+  // Nothing reached the page.
+  Answer("gone", reason);
+}
+
+void SelectSession::OnFirstRead(const blink::mojom::AgentSelectReading& r) {
+  if (!first_) {
+    first_ = r.Clone();
+    initial_index_ = r.selected_index;
+  }
+  if (r.kind == "notSelect") {
+    Answer("notSelect");
+    return;
+  }
+  if (r.select_disabled) {
+    Answer("disabled");
+    return;
+  }
+  // An option a page never styled can read undisplayed until the select is
+  // brought into view: hidden values are judged on the reading after it.
+  if (!r.missing.empty() || !r.disabled_matches.empty() ||
+      (revealed_ && !r.hidden_matches.empty())) {
+    Answer("missing");
+    return;
+  }
+  if (params_.values.size() > 1 && !r.multiple) {
+    Answer("single");
+    return;
+  }
+  if (r.hidden_matches.empty()) {
+    std::set<int> wanted;
+    for (const auto& match : r.matches) {
+      wanted.insert(match->index);
+    }
+    std::set<int> now;
+    for (const auto& option : r.selected) {
+      now.insert(option->index);
+    }
+    if (wanted == now) {
+      // It shows exactly that: nothing is pressed.
+      Answer("already");
+      return;
+    }
+  }
+  if (!revealed_) {
+    // Into view as a hand brings it, then read again.
+    Reveal(params_.node_id, base::BindOnce(
+                                [](base::WeakPtr<SelectSession> session) {
+                                  if (session) {
+                                    session->revealed_ = true;
+                                    session->Ask(Read::kFirst);
+                                  }
+                                },
+                                Weak()));
+    return;
+  }
+  if (r.kind == "listBox") {
+    PlanClicks(r);
+    NextClick();
+    return;
+  }
+  // A dropdown, native or drawn in the page: opened with the hand's click.
+  Open();
+}
+
+void SelectSession::Reveal(int32_t node_id, base::OnceClosure next) {
+  if (answered()) {
+    return;
+  }
+  InputHandler::RevealRequest request;
+  request.backend_node_id = node_id;
+  request.frame_id = params_.frame_id;
+  request.x = params_.pointer_x;
+  request.y = params_.pointer_y;
+  request.timeout_ms = StepTimeoutMs(RemainingMs());
+  revealing_ = true;
+  // Its answer can come before RunReveal returns, and what follows sends
+  // more input: posted.
+  handler_->RunReveal(
+      std::move(request),
+      base::BindPostTaskToCurrentDefault(
+          base::BindOnce(&SelectSession::OnRevealed, Weak(), std::move(next))));
+}
+
+void SelectSession::OnRevealed(base::OnceClosure next,
+                               InputHandler::RevealResult result) {
+  revealing_ = false;
+  const bool option_revealed = revealing_option_;
+  revealing_option_ = false;
+  if (answered()) {
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  const std::string& outcome = result.outcome;
+  if (outcome == "shown" || outcome == "blocked") {
+    // In view, or as far as the wheel brings it: the press's own check says
+    // what reaches it.
+    std::move(next).Run();
+    return;
+  }
+  if (outcome == "covered") {
+    Answer("covered", "covered", result.covering.value_or(std::string()),
+           result.covering_kind.value_or(std::string()));
+    return;
+  }
+  if (outcome == "gone") {
+    // When it was an option about to be clicked (an onchange that made the
+    // options anew, or the select replaced), OnGone reads the select once
+    // more.
+    option_went_ = option_revealed;
+    OnGone("the select is no longer in the page");
+    return;
+  }
+  if (outcome == "interrupted" || outcome == "timeout") {
+    Answer(outcome);
+    return;
+  }
+  Answer("unreachable", "it could not be brought into view (" + outcome + ")");
+}
+
+void SelectSession::Open() {
+  if (answered()) {
+    return;
+  }
+  // What the browser checks before it shows a select's list
+  // (WebContentsImpl::ShowCreatedWidget): an inactive window or a hidden tab
+  // gets none.
+  WebContentsImpl* contents = handler_->web_contents_;
+  RenderWidgetHostImpl* main_widget =
+      contents && contents->GetPrimaryMainFrame()
+          ? contents->GetPrimaryMainFrame()->GetRenderWidgetHost()
+          : nullptr;
+  window_inactive_ = main_widget && !main_widget->is_active();
+  tab_hidden_ =
+      contents && contents->GetVisibility() == content::Visibility::HIDDEN;
+  // The opening press is not the action: the pick is.
+  moving_ = true;
+  handler_->RunMove(
+      ClickRequest(params_.node_id, /*modifiers=*/0, /*arm=*/false),
+      base::BindPostTaskToCurrentDefault(
+          base::BindOnce(&SelectSession::OnOpened, Weak())));
+}
+
+void SelectSession::OnOpened(MoveResult result) {
+  moving_ = false;
+  if (answered()) {
+    return;
+  }
+  const bool clicked = !result.failure && result.outcome == "clicked";
+  if (timed_out_) {
+    if (clicked) {
+      // Its list may be open: looked at once, and closed if it shows.
+      Ask(Read::kClose);
+      return;
+    }
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  if (!clicked) {
+    AnswerMove(result);
+    return;
+  }
+  watching_list_ = true;
+  list_wait_until_ = base::TimeTicks::Now() + kOpenWait;
+  Ask(Read::kList);
+}
+
+void SelectSession::OnListRead(const blink::mojom::AgentSelectReading& r) {
+  if (r.popup_shown) {
+    watching_list_ = false;
+    if (r.kind == "basePicker") {
+      // Its list is a popover in the page: the option clicked by identity.
+      way_ = "popover";
+      PlanClicks(r);
+      NextClick();
+      return;
+    }
+    list_open_ = true;
+    way_ = "popup";
+    if (!r.popup_option_found && row_reads_ < kMaxRowReads) {
+      ++row_reads_;
+      clock_.Start(FROM_HERE,
+                   base::Milliseconds(base::RandIntInclusive(30, 45)),
+                   base::BindOnce(&SelectSession::Ask, Weak(), Read::kList));
+      return;
+    }
+    Dwell(r);
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (now >= list_wait_until_ && !list_wait_extended_) {
+    list_wait_extended_ = true;
+    list_wait_until_ = now + kOpenExtra;
+  }
+  if (now < list_wait_until_) {
+    clock_.Start(FROM_HERE, base::Milliseconds(base::RandIntInclusive(30, 45)),
+                 base::BindOnce(&SelectSession::Ask, Weak(), Read::kList));
+    return;
+  }
+  // No list: stepped with the keys on the focused select, the route read
+  // afresh (the list's watch reads none).
+  watching_list_ = false;
+  why_keys_ = tab_hidden_        ? "tabHidden"
+              : window_inactive_ ? "windowInactive"
+                                 : "notOpened";
+  Ask(Read::kKeyStart);
+}
+
+void SelectSession::Dwell(const blink::mojom::AgentSelectReading& r) {
+  HumanPathPlanner& planner = handler_->HandPlanner();
+  const double speed =
+      params_.speed_multiplier > 0 ? params_.speed_multiplier : 1;
+  const int index = r.matches.empty() ? 0 : r.matches[0]->index;
+  const int from_row = r.selected_index >= 0 ? r.selected_index : 0;
+  // Reading down the list to the option.
+  double wait_ms = base::RandIntInclusive(160, 380) / speed;
+  const int rows = std::min(std::abs(index - from_row), 12);
+  for (int i = 0; i < rows; ++i) {
+    wait_ms += base::RandIntInclusive(30, 65) / speed;
+  }
+  RenderWidgetHostViewBase* root = handler_->GetRootView();
+  if (r.popup_option_found && r.popup_option_box && root) {
+    // The hand's way to the row: its time, not played to the page, which
+    // sees no move while its list is open.
+    const gfx::Rect view = root->GetViewBounds();
+    const blink::mojom::AgentElementBox& box = *r.popup_option_box;
+    const PlannerPoint dest{box.x + box.width / 2 - view.x(),
+                            box.y + box.height / 2 - view.y()};
+    std::optional<PlannerPoint> hand = handler_->LastPointer();
+    if (hand) {
+      const std::vector<PlannedPoint> leg = planner.PlanLeg(
+          *hand, dest, std::max(box.height, kMinRowDips), params_.path_intent,
+          params_.speed_multiplier, LegConstraints());
+      if (!leg.empty()) {
+        wait_ms += leg.back().t_ms;
+      }
+    }
+    list_place_ =
+        gfx::PointF(std::clamp(dest.x, kEdgeDips,
+                               std::max(kEdgeDips, view.width() - kEdgeDips)),
+                    std::clamp(dest.y, kEdgeDips,
+                               std::max(kEdgeDips, view.height() - kEdgeDips)));
+    if (!r.popup_option_in_view) {
+      // A turn of the wheel in the list to bring the row in.
+      wait_ms += base::RandIntInclusive(280, 650) / speed;
+    }
+  }
+  wait_ms += planner.PressDwellMs(params_.path_intent) / speed;
+  wait_ms += planner.ClickHoldMs() / speed;
+  clock_.Start(FROM_HERE, base::Milliseconds(wait_ms),
+               base::BindOnce(&SelectSession::Pick, Weak()));
+}
+
+void SelectSession::Pick() {
+  if (answered()) {
+    return;
+  }
+  if (!collector_.is_connected() || !latest_ || latest_->matches.empty()) {
+    OnGone("the page's renderer went away");
+    return;
+  }
+  const blink::mojom::AgentSelectOption& option = *latest_->matches[0];
+  // The pick is the action, watched from here; from its sending it counts as
+  // having reached the page, and the list as closing.
+  action_id_ = handler_->OutcomeWatch()->ArmSelect(local_root_,
+                                                   params_.follow_navigation);
+  reached_ = true;
+  list_open_ = false;
+  pick_in_flight_ = true;
+  // A reply lost on the way (its renderer went) says nothing of the pick:
+  // `dropped`.
+  collector_->PickInList(params_.node_id, option.index, option.node_id,
+                         mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                             base::BindOnce(&SelectSession::OnPicked, Weak()),
+                             std::string("dropped")));
+}
+
+void SelectSession::OnPicked(const std::string& outcome) {
+  pick_in_flight_ = false;
+  if (answered()) {
+    return;
+  }
+  if (outcome == "picked") {
+    as_picked_ = true;
+  } else if (outcome != "dropped") {
+    // Nothing was picked.
+    reached_ = false;
+  }
+  if (timed_out_) {
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (outcome == "dropped") {
+    // Whether the pick took, read from the frame's renderer now, if it has
+    // one.
+    if (!handler_->BindCollectorForFrame(params_.frame_id, &collector_)) {
+      OnGone("the page's renderer went away");
+      return;
+    }
+    Ask(Read::kRecheck);
+    return;
+  }
+  if (outcome == "picked") {
+    // The hand over the option, where it picked it, without a move the page
+    // could see: while the list was open it saw none.
+    if (list_place_) {
+      handler_->PlacePointer(*list_place_);
+    }
+    Ask(Read::kAfter);
+    return;
+  }
+  if (outcome == "closed") {
+    // The list went away during the dwell: the keys, from where the
+    // selection is now.
+    why_keys_ = "notOpened";
+    Ask(Read::kKeyStart);
+    return;
+  }
+  if (outcome == "changed") {
+    // That index no longer holds that option, or it can no longer be picked:
+    // the list changed under the dwell. Nothing picked, the reason said, the
+    // list closed with Escape if it still shows (OnRead).
+    Ask(Read::kChanged);
+    return;
+  }
+  if (outcome == "notSelect") {
+    Answer("notSelect");
+    return;
+  }
+  OnGone("the select is no longer in the page");
+}
+
+void SelectSession::OnRecheck(const blink::mojom::AgentSelectReading& r) {
+  if (!r.matches.empty() && r.matches[0]->index >= 0 &&
+      r.selected_index == r.matches[0]->index) {
+    Answer("picked");
+    return;
+  }
+  Answer("unreachable",
+         "the list's answer to the pick was lost, and the option is not "
+         "selected");
+}
+
+void SelectSession::StartKeys(const blink::mojom::AgentSelectReading& r) {
+  way_ = "keys";
+  if (!r.focused) {
+    // The opening click did not focus it: no key could reach it.
+    KeysFailed("noFocus");
+    return;
+  }
+  if (r.matches.empty()) {
+    KeysFailed("gone");
+    return;
+  }
+  key_target_ = r.matches[0]->index;
+  if (r.selected_index == key_target_) {
+    Answer("picked");
+    return;
+  }
+  const std::string down = "ArrowDown";
+  const std::string up = "ArrowUp";
+  const int steps = r.arrow_steps;
+  // The renderer's counts are compared in 64 bits as they come, and the keys
+  // planned from them are held to KeyCount.
+  const int64_t arrows = std::abs(int64_t{steps});
+  // -1: Home or End reaches no option the arrows can step to it from.
+  const int64_t from_home = r.steps_from_home;
+  const int64_t from_end = r.steps_from_end;
+  const bool home_near = from_home >= 0 && from_home <= kArrowsMax;
+  const bool end_near = from_end >= 0 && from_end <= kArrowsMax;
+  const bool typed =
+      !r.type_ahead.empty() && r.type_ahead.find(' ') == std::string::npos;
+  const auto with_home = [&] {
+    keys_.assign(1, "Home");
+    keys_.insert(keys_.end(), KeyCount(from_home), down);
+    keys_route_ = "homeEnd";
+  };
+  const auto with_end = [&] {
+    keys_.assign(1, "End");
+    keys_.insert(keys_.end(), KeyCount(from_end), up);
+    keys_route_ = "homeEnd";
+  };
+  keys_.clear();
+  keys_cut_ = false;
+  keys_route_ = "arrows";
+  if (steps != 0 && arrows <= kArrowsMax) {
+    keys_.assign(KeyCount(arrows), steps > 0 ? down : up);
+  } else if (home_near || end_near) {
+    // Home or End, and a few arrows after it.
+    if (home_near && (!end_near || from_home <= from_end)) {
+      with_home();
+    } else {
+      with_end();
+    }
+  } else if (typed) {
+    // The first letters of its label, typed: a space would open the list.
+    keys_route_ = "typeAhead";
+    for (char c : r.type_ahead) {
+      keys_.push_back(std::string(1, c));
+    }
+  } else {
+    // The fewest keys: the arrows, or Home or End and the arrows after it.
+    int64_t best = steps != 0 ? arrows : std::numeric_limits<int64_t>::max();
+    if (steps != 0) {
+      keys_.assign(KeyCount(arrows), steps > 0 ? down : up);
+    }
+    if (from_home >= 0 && 1 + from_home < best) {
+      best = 1 + from_home;
+      with_home();
+    }
+    if (from_end >= 0 && 1 + from_end < best) {
+      with_end();
+    }
+    if (keys_.size() > static_cast<size_t>(kMaxKeys)) {
+      keys_.resize(kMaxKeys);
+      keys_cut_ = true;
+    }
+  }
+  if (keys_.empty()) {
+    KeysFailed("noMove");
+    return;
+  }
+  if (!action_id_) {
+    // The keys are the action: watched from the first.
+    action_id_ = handler_->OutcomeWatch()->ArmSelect(local_root_,
+                                                     params_.follow_navigation);
+  }
+  next_key_ = 0;
+  key_from_ = r.selected_index;
+  NextKey();
+}
+
+void SelectSession::NextKey() {
+  if (answered()) {
+    return;
+  }
+  if (next_key_ >= keys_.size() || keys_sent_ >= kMaxKeys) {
+    KeysFailed("noMove");
+    return;
+  }
+  // From its sending a key counts as having reached the page.
+  reached_ = true;
+  key_in_flight_ = true;
+  handler_->PressKey(keys_[next_key_],
+                     base::BindOnce(&SelectSession::OnKeySent, Weak()));
+}
+
+void SelectSession::OnKeySent(bool ok) {
+  key_in_flight_ = false;
+  if (answered()) {
+    return;
+  }
+  if (!ok && keys_sent_ == 0) {
+    // Not even the first key went out.
+    reached_ = false;
+  }
+  if (timed_out_) {
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (!ok) {
+    KeysFailed(keys_sent_ == 0 ? "noFocus" : "lostFocus");
+    return;
+  }
+  ++keys_sent_;
+  ++next_key_;
+  // The route sent whole, not cut at the cap: it lands on the option, until
+  // a reading says.
+  as_picked_ = next_key_ >= keys_.size() && !keys_cut_;
+  Ask(Read::kKey);
+}
+
+void SelectSession::OnKeyRead(const blink::mojom::AgentSelectReading& r) {
+  if (!r.focused) {
+    KeysFailed("lostFocus");
+    return;
+  }
+  if (r.selected_index == key_target_) {
+    Answer("picked");
+    return;
+  }
+  const std::string& last = keys_[next_key_ - 1];
+  const bool typing = keys_route_ == "typeAhead";
+  if (!typing && last != "Home" && last != "End" &&
+      r.selected_index == key_from_) {
+    // An arrow that moved nothing: the page holds the select's keys.
+    KeysFailed("noMove");
+    return;
+  }
+  key_from_ = r.selected_index;
+  if (next_key_ >= keys_.size()) {
+    if (typing || r.arrow_steps == 0 || keys_sent_ >= kMaxKeys) {
+      KeysFailed("noMove");
+      return;
+    }
+    // Not there yet, the arrows planned on a reading the keys changed:
+    // planned again from here.
+    const int64_t arrows = std::abs(int64_t{r.arrow_steps});
+    const int keys_left = kMaxKeys - keys_sent_;
+    keys_cut_ = arrows > keys_left;
+    keys_.assign(static_cast<size_t>(std::min<int64_t>(arrows, keys_left)),
+                 r.arrow_steps > 0 ? "ArrowDown" : "ArrowUp");
+    next_key_ = 0;
+  }
+  // Taps a hand's pace apart; letters close enough for the select's
+  // type-ahead to take them as one word.
+  base::TimeDelta gap = ScaledDelay(90, 220, params_.speed_multiplier);
+  if (typing) {
+    gap = std::min(gap, kTypeAheadGap);
+  }
+  clock_.Start(FROM_HERE, gap, base::BindOnce(&SelectSession::NextKey, Weak()));
+}
+
+void SelectSession::KeysFailed(const std::string& why) {
+  way_ = "keys";
+  keys_stopped_ = why;
+  keys_moved_ = latest_ && latest_->selected_index != initial_index_;
+  Answer("keysFailed");
+}
+
+void SelectSession::PlanClicks(const blink::mojom::AgentSelectReading& r) {
+  clicks_.clear();
+  next_click_ = 0;
+  if (way_ != "popover") {
+    way_ = "listbox";
+  }
+  if (r.matches.empty()) {
+    return;
+  }
+  if (!r.multiple || way_ == "popover") {
+    clicks_.push_back({r.matches[0]->node_id, false});
+    return;
+  }
+  // By list order: the wanted ones, those selected now, and the toggles
+  // between them.
+  std::vector<std::pair<int, int32_t>> wanted;
+  for (const auto& match : r.matches) {
+    wanted.emplace_back(match->index, match->node_id);
+  }
+  std::sort(wanted.begin(), wanted.end());
+  wanted.erase(std::unique(wanted.begin(), wanted.end()), wanted.end());
+  std::vector<std::pair<int, int32_t>> now;
+  for (const auto& option : r.selected) {
+    now.emplace_back(option->index, option->node_id);
+  }
+  std::sort(now.begin(), now.end());
+  std::vector<std::pair<int, int32_t>> toggles;
+  std::set_symmetric_difference(
+      wanted.begin(), wanted.end(), now.begin(), now.end(),
+      std::back_inserter(toggles),
+      [](const auto& a, const auto& b) { return a.first < b.first; });
+  const size_t common = wanted.size() + now.size() - toggles.size();
+  if (common > 0 && toggles.size() < wanted.size()) {
+    // A selection that already holds some of them, corrected as a person
+    // corrects one: only the differences, each with Ctrl.
+    for (const auto& toggle : toggles) {
+      clicks_.push_back({toggle.second, true});
+    }
+    return;
+  }
+  // A plain click on the first, then Ctrl for each after it.
+  for (size_t i = 0; i < wanted.size(); ++i) {
+    clicks_.push_back({wanted[i].second, i > 0});
+  }
+}
+
+void SelectSession::NextClick() {
+  if (answered()) {
+    return;
+  }
+  if (next_click_ >= clicks_.size()) {
+    // All clicked: what is selected now.
+    Ask(Read::kAfter);
+    return;
+  }
+  if (way_ == "listbox") {
+    // Inside the list first, as the wheel over it brings it, before Ctrl
+    // goes down: a wheel turned with Ctrl held would zoom.
+    revealing_option_ = true;
+    Reveal(clicks_[next_click_].node_id,
+           base::BindOnce(&SelectSession::PressFor, Weak()));
+    return;
+  }
+  PressFor();
+}
+
+void SelectSession::PressFor() {
+  if (answered() || next_click_ >= clicks_.size()) {
+    return;
+  }
+  if (clicks_[next_click_].ctrl) {
+    Chord(/*down=*/true, base::BindOnce(&SelectSession::ClickOption, Weak()));
+    return;
+  }
+  ClickOption();
+}
+
+void SelectSession::ClickOption() {
+  if (answered() || next_click_ >= clicks_.size()) {
+    return;
+  }
+  const Click& click = clicks_[next_click_];
+  moving_ = true;
+  option_click_ = true;
+  // The first option's click is the action (its move arms it); the others
+  // ride on it.
+  handler_->RunMove(ClickRequest(click.node_id, click.ctrl ? kCtrlModifier : 0,
+                                 /*arm=*/!clicked_),
+                    base::BindPostTaskToCurrentDefault(
+                        base::BindOnce(&SelectSession::OnClicked, Weak())));
+}
+
+void SelectSession::OnClicked(MoveResult result) {
+  moving_ = false;
+  option_click_ = false;
+  if (answered()) {
+    return;
+  }
+  if (!clicked_ && result.action_outcome) {
+    click_outcome_ = std::move(result.action_outcome);
+  }
+  const bool landed = !result.failure && result.outcome == "clicked";
+  if (landed) {
+    clicked_ = true;
+    reached_ = true;
+    // The last one: the selection is as asked, until a reading says it.
+    as_picked_ = next_click_ + 1 >= clicks_.size();
+  }
+  if (interrupted_) {
+    // Interrupted while the click was on its way: answered from what the
+    // click did, with what it led to.
+    AnswerInterrupted(*interrupted_);
+    return;
+  }
+  if (timed_out_) {
+    Answer("timeout", kTimeoutReason);
+    return;
+  }
+  if (result.failure) {
+    Fail(std::move(*result.failure));
+    return;
+  }
+  if (!landed) {
+    // The option went before its click (an onchange that made the options
+    // anew, or the select replaced): OnGone reads the select once more.
+    option_went_ = result.outcome == "gone";
+    AnswerMove(result);
+    return;
+  }
+  if (ctrl_down_) {
+    Chord(/*down=*/false, base::BindOnce(&SelectSession::AfterClick, Weak()));
+    return;
+  }
+  AfterClick();
+}
+
+void SelectSession::AfterClick() {
+  if (answered()) {
+    return;
+  }
+  ++next_click_;
+  clock_.Start(FROM_HERE, ScaledDelay(120, 320, params_.speed_multiplier),
+               base::BindOnce(&SelectSession::NextClick, Weak()));
+}
+
+void SelectSession::Chord(bool down, base::OnceClosure next) {
+  scoped_refptr<base::RefCountedData<bool>> landing;
+  if (down) {
+    // Counted down from the press's start: every exit lets it go, once it
+    // has landed when it is still on its way.
+    ctrl_down_ = true;
+    ctrl_landing_ = base::MakeRefCounted<base::RefCountedData<bool>>(false);
+    landing = ctrl_landing_;
+  } else {
+    ctrl_down_ = false;
+    ctrl_landing_ = nullptr;
+  }
+  handler_->StartChordSession(
+      kCtrlModifier, std::string(), down ? kChordDown : kChordUp,
+      params_.speed_multiplier,
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          [](base::WeakPtr<SelectSession> session,
+             base::WeakPtr<InputHandler> handler,
+             scoped_refptr<base::RefCountedData<bool>> landing, double speed,
+             bool down, base::OnceClosure next, bool ok) {
+            if (landing && landing->data) {
+              // The session ended while Ctrl's press was on its way: let go
+              // of now that it has landed.
+              if (handler && ok) {
+                handler->StartChordSession(kCtrlModifier, std::string(),
+                                           kChordUp, speed, base::DoNothing());
+              }
+              return;
+            }
+            if (session) {
+              session->OnChord(down, std::move(next), ok);
+            }
+          },
+          Weak(), handler_->weak_factory_.GetWeakPtr(), landing,
+          params_.speed_multiplier, down, std::move(next))));
+}
+
+void SelectSession::OnChord(bool down, base::OnceClosure next, bool ok) {
+  if (down) {
+    ctrl_landing_ = nullptr;
+  }
+  if (answered()) {
+    return;
+  }
+  if (!ok) {
+    if (down) {
+      ctrl_down_ = false;
+    }
+    Answer("unreachable", "the Ctrl key could not be pressed");
+    return;
+  }
+  std::move(next).Run();
+}
+
+void SelectSession::AnswerMove(const MoveResult& result) {
+  const std::string& outcome = result.outcome;
+  if (outcome == "gone") {
+    OnGone(result.reason);
+    return;
+  }
+  if (outcome == "covered" || outcome == "hidden" || outcome == "interrupted" ||
+      outcome == "timeout" || outcome == "unreachable") {
+    Answer(outcome, result.reason, result.hit, result.hit_kind);
+    return;
+  }
+  // Pressed, released or arrived: not the click asked for.
+  Answer("unreachable", "the click did not go out (" + outcome + ")",
+         result.hit);
+}
+
+void SelectSession::OnTimeout() {
+  if (interrupted_) {
+    // Its click's answer is on its way, and answers this.
+    return;
+  }
+  timed_out_ = true;
+  if (revealing_ && handler_->reveal_) {
+    handler_->AnswerReveal("interrupted");
+  }
+  if (list_open_) {
+    // Escape goes to the open list, the pick not sent, and the page sees no
+    // key.
+    list_open_ = false;
+    handler_->PressKey("Escape", base::DoNothing());
+  }
+  const bool in_flight = moving_ || pick_in_flight_ || key_in_flight_;
+  if (in_flight || watching_list_) {
+    // A click, the pick or a key on its way: its answer, and what it did,
+    // waited for a little. A list watched for, after the opening click (or
+    // once that click has answered): looked at once more, and closed if it
+    // shows (OnOpened, OnRead).
+    if (moving_) {
+      handler_->InterruptMoveSession();
+    }
+    clock_.Start(
+        FROM_HERE, kInFlightWait,
+        base::BindOnce(&SelectSession::Answer, Weak(), std::string("timeout"),
+                       std::string(kTimeoutReason), std::string(),
+                       std::string()));
+    if (!in_flight) {
+      Ask(Read::kClose);
+    }
+    return;
+  }
+  Answer("timeout", kTimeoutReason);
+}
+
+void SelectSession::Answer(const std::string& outcome,
+                           const std::string& reason,
+                           const std::string& hit,
+                           const std::string& hit_kind) {
+  if (answered()) {
+    return;
+  }
+  // What the pick led to is answered once settled when it went through in
+  // time; else at once, with what is known.
+  Send(outcome, reason, hit, /*wait=*/outcome == "picked" && !timed_out_,
+       hit_kind);
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void SelectSession::Fail(Response response) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  ReleaseCtrl();
+  if (action_id_ && !reached_ && handler_alive_) {
+    if (ActionOutcomeWatch* watch = handler_->outcome_watch()) {
+      watch->Abandon(action_id_);
+    }
+  }
+  action_id_ = 0;
+  SelectResult result;
+  result.failure = std::move(response);
+  std::move(completion).Run(std::move(result));
+  if (on_done_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(on_done_), id_));
+  }
+}
+
+void SelectSession::Send(const std::string& outcome,
+                         const std::string& reason,
+                         const std::string& hit,
+                         bool wait,
+                         const std::string& hit_kind) {
+  Completion completion = std::move(completion_);
+  if (!completion) {
+    return;
+  }
+  timeout_timer_.Stop();
+  clock_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  collector_.reset();
+  ReleaseCtrl();
+  const double scale = params_.css_scale > 0 ? params_.css_scale : 1;
+  SelectResult result;
+  result.outcome = outcome;
+  result.way = way_;
+  result.why_keys = why_keys_;
+  result.keys_route = keys_route_;
+  result.keys_stopped = keys_stopped_;
+  result.keys_moved = keys_moved_;
+  result.hit = hit;
+  result.hit_kind = hit_kind;
+  result.reason = reason;
+  // The values and the options as one reading had them: the last.
+  const blink::mojom::AgentSelectReading* now =
+      latest_ ? latest_.get() : first_.get();
+  if (now) {
+    result.multiple = now->multiple;
+    result.missing = now->missing;
+    result.disabled_matches = now->disabled_matches;
+    result.hidden_matches = now->hidden_matches;
+    result.options = now->options;
+    result.option_count = now->option_count;
+    std::set<int> selected_now;
+    if (as_picked_) {
+      // All of the pick went out and no reading followed it: selected as the
+      // pick made it.
+      for (const auto& match : now->matches) {
+        if (match->index >= 0 && selected_now.insert(match->index).second) {
+          result.selected.push_back(FiguresOf(*match));
+        }
+        if (!now->multiple) {
+          break;
+        }
+      }
+    } else {
+      for (const auto& option : now->selected) {
+        result.selected.push_back(FiguresOf(*option));
+        selected_now.insert(option->index);
+      }
+    }
+    if (first_ && (as_picked_ || now != first_.get())) {
+      for (const auto& option : first_->selected) {
+        if (!selected_now.contains(option->index)) {
+          result.deselected.push_back(FiguresOf(*option));
+        }
+      }
+    }
+  }
+  if (handler_alive_) {
+    if (std::optional<PlannerPoint> hand = handler_->LastPointer()) {
+      result.x = hand->x / scale;
+      result.y = hand->y / scale;
+    } else {
+      result.x = params_.pointer_x.value_or(0);
+      result.y = params_.pointer_y.value_or(0);
+    }
+  }
+  result.duration_ms = (base::TimeTicks::Now() - started_).InMillisecondsF();
+  ActionOutcomeWatch* watch =
+      handler_alive_ && action_id_ ? handler_->outcome_watch() : nullptr;
+  if (watch && !reached_) {
+    // Armed, and nothing of the pick reached the page: dropped, with no
+    // answer and no late events.
+    watch->Abandon(action_id_);
+    watch = nullptr;
+  }
+  if (watch) {
+    ActionOutcomeWatch::Reply(
+        watch, action_id_,
+        base::BindOnce(
+            [](Completion completion, SelectResult result,
+               std::unique_ptr<Page::ActionOutcome> action_outcome) {
+              result.action_outcome = std::move(action_outcome);
+              std::move(completion).Run(std::move(result));
+            },
+            std::move(completion), std::move(result)),
+        wait);
+    return;
+  }
+  // Options clicked: what the first click led to, as its move answered it.
+  result.action_outcome = std::move(click_outcome_);
+  std::move(completion).Run(std::move(result));
+}
+
+void SelectSession::ReleaseCtrl() {
+  if (!ctrl_down_) {
+    return;
+  }
+  ctrl_down_ = false;
+  if (frame_left_) {
+    // The page that saw it go down is gone: only forgotten (a press still on
+    // its way finds this session answered, and lets go of nothing).
+    ctrl_landing_ = nullptr;
+    return;
+  }
+  if (ctrl_landing_) {
+    // Its press is still on its way: let go of once it has landed.
+    ctrl_landing_->data = true;
+    ctrl_landing_ = nullptr;
+    return;
+  }
+  if (!handler_alive_) {
+    return;
+  }
+  // Posted: this may run inside another command's start.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&InputHandler::StartChordSession,
+                                handler_->weak_factory_.GetWeakPtr(),
+                                kCtrlModifier, std::string(), kChordUp,
+                                params_.speed_multiplier, base::DoNothing()));
+}
+
+InputHandler::MoveRequest SelectSession::ClickRequest(int32_t node_id,
+                                                      int modifiers,
+                                                      bool arm) const {
+  InputHandler::MoveRequest move;
+  move.backend_node_id = node_id;
+  move.frame_id = params_.frame_id;
+  move.intent = params_.intent;
+  move.end_action = "click";
+  move.end_button = "left";
+  move.end_click_count = 1;
+  if (modifiers) {
+    move.modifiers = modifiers;
+  }
+  move.speed_multiplier = params_.speed_multiplier;
+  move.timeout_ms = StepTimeoutMs(RemainingMs());
+  move.pointer_x = params_.pointer_x;
+  move.pointer_y = params_.pointer_y;
+  move.follow_navigation = params_.follow_navigation;
+  move.arm = arm;
+  return move;
+}
+
+double SelectSession::RemainingMs() const {
+  const base::TimeDelta elapsed = base::TimeTicks::Now() - started_;
+  return (params_.timeout - elapsed).InMillisecondsF();
+}
+
+}  // namespace content::protocol
