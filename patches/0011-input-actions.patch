+
+class DragSession {
+ public:
+  // What the drag is taken to.
+  enum class TargetKind { kElement, kFraction, kPoint, kValue };
+  // Where over a sortable list's slot a pointer drag lets go.
+  enum class Slot { kOn, kBefore, kAfter };
+  // A leg from outside the box that holds the target keeps, inside that box,
+  // to strips through the target: the box's visible part, the target's box
+  // inset 1 px, and the strips -- a row (the leg keeps within its height) or
+  // a column (its width).
+  struct LaneStrip {
+    DragRect rect;
+    bool row = true;
+  };
+  struct Lane {
+    DragRect region;
+    DragRect target;
+    std::vector<LaneStrip> strips;
+  };
+
+  // A call to Input.performDrag, checked and resolved by
+  // InputHandler::PerformDrag. Points in the root view's DIPs; node ids are
+  // DOMNodeIds in `local_root`: the main frame's local root, or a
+  // cross-origin frame's when the drag is all inside it.
+  struct Params {
+    Params();
+    Params(const Params&);
+    Params& operator=(const Params&);
+    ~Params();
+
+    GlobalRenderFrameHostId local_root;
+    // The element to grab (0: whatever lies at grab_point), and where on it
+    // to press, as fractions of its box (default its middle; a range
+    // input's thumb).
+    int grab_node_id = 0;
+    PlannerPoint grab_point;
+    std::optional<double> grab_fraction_x;
+    std::optional<double> grab_fraction_y;
+    TargetKind target_kind = TargetKind::kElement;
+    int target_node_id = 0;
+    double aim_x = 0.5;
+    double aim_y = 0.5;
+    Slot slot = Slot::kOn;
+    // `slot` was given (slotReached is read back only then).
+    bool slot_given = false;
+    double fraction_x = 0.5;
+    double fraction_y = 0.5;
+    PlannerPoint point;
+    double value = 0;
+    int modifiers = 0;
+    std::optional<double> press_hold_ms;
+    // Where the hand is when the call comes.
+    PlannerPoint hand;
+    double speed_multiplier = 1;
+    base::TimeDelta timeout;
+    uint64_t variation_seed = 0;
+    // What a drop or a release led to waits for a cross-document navigation
+    // it started to end.
+    bool follow_navigation = true;
+    // CSS px to root DIPs, as the call found it.
+    double css_scale = 1;
+  };
+
+  using Callback = Input::Backend::PerformDragCallback;
+
+  // `on_done` hears this session's id, posted, once it has answered.
+  DragSession(InputHandler& handler,
+              uint64_t id,
+              const Params& params,
+              mojo::Remote<blink::mojom::AgentSnapshotCollector> collector,
+              std::unique_ptr<Callback> callback,
+              base::OnceCallback<void(uint64_t)> on_done);
+  DragSession(const DragSession&) = delete;
+  DragSession& operator=(const DragSession&) = delete;
+  // A session not yet answered (its handler is going away) answers
+  // interrupted, without a word to the handler.
+  ~DragSession();
+
+  // Phase 0 on: reads the page, carries the drag out, answers once.
+  void Start();
+  // Other pointer input, Input.disable, a renderer change or a newer drag:
+  // a native drag is called off at once (dragleave, dragend); a pointer one
+  // is put back where it was grabbed, in one gesture queued before this
+  // returns (ahead of the new input's); the answer, interrupted, follows
+  // once the drag has ended. The handler's hooks are given back, and any
+  // hold this call began called off, before this returns; a pointer drag
+  // keeps interception only until its put-back's button is up.
+  void Interrupt();
+
+  uint64_t id() const { return id_; }
+  // The call has had its answer.
+  bool answered() const { return !callback_; }
+
+  // The answer to a call refused before anything was read or pressed.
+  static void Refuse(std::unique_ptr<Callback> callback,
+                     const std::string& outcome,
+                     const std::string& reason);
+
+ private:
+  // The phases, in order; kEnding is the abort path, kDone follows the
+  // answer.
+  enum class Phase {
+    kSurvey,    // 0: checked and read; nothing pressed
+    kReach,     // 1: the hand to the grab, and the press
+    kActivate,  // 2: the first leg, and the kind of drag it started
+    kCarry,     // 3: the wheel turned under the hand until the target shows
+    kApproach,  // 4: the hand to the landing
+    kVerify,    // 5: the pointer checked over the target (rule b)
+    kLetGo,     // 6: the rest, the last checks, the drop or the release
+    kAfter,     // 7: the page read once it has settled
+    kEnding,    // out of any band, the drag ended, answered
+    kDone,
+  };
+  // What the press turned into: the answer's kind.
+  enum class Kind { kNative, kPointer };
+  // What a read of an element's slot is for: phase 0's grab, the landing,
+  // a pointer drag's verify, the reads after a let-go, a put-back and a
+  // native drag's end, and a list's order (the grabbed element, then the
+  // target) when a native drag over a list is verified by it.
+  enum class SlotUse {
+    kGrab,
+    kLanding,
+    kVerify,
+    kAfter,
+    kPutBack,
+    kEndAfter,
+    kOrderGrab,
+    kOrderTarget,
+    // The list's order while stepping on toward the side asked for; the
+    // target's place after the let-go, for slotReached.
+    kStepGrab,
+    kStepTarget,
+    kAfterTarget
+  };
+  // What a carry reading is for.
+  enum class ReadUse { kCarry, kLanding };
+  // What a description of the landing is for.
+  enum class DescribeUse { kBefore, kAfter };
+  // What a wheel station is asked for: the first leg's end (before the
+  // press, native assumed), a carry stage.
+  enum class StationUse { kFirst, kStage };
+  // What a hit check is for: the verify at the landing, or the last check
+  // at the pixel the last dragover used; each for the target, then (a
+  // native drag over a list, which may move the grabbed element there) for
+  // the grabbed element.
+  enum class HitUse { kVerify, kFinal, kVerifyGrab, kFinalGrab };
+  // Where Blink's own band walk is asked about the hand: at a station, at
+  // the calm point beside an in-band landing, at a calm landing.
+  enum class ProbeUse { kStation, kCalmPoint, kLanding };
+  // Why a landing is corrected: something else under it, the page not
+  // taking it, the target moved, or Blink's band walk finding it in a band.
+  enum class Miss { kHit, kRefused, kMoved, kBand, kCover };
+
+  // Scroll offsets, in CSS px.
+  struct Offsets {
+    double x = 0;
+    double y = 0;
+  };
+  // For a box the wheel turned: what its notches may scroll it (CSS px,
+  // signed: down or right positive), the spins turned at it, and what of its
+  // scroll the wheel has been credited with.
+  struct WheelCredit {
+    Offsets sent;
+    Offsets credited;
+    int spins = 0;
+  };
+  // A list slot a hand lands over (SlotTarget): the slot, the point over it
+  // to land at, and the region to land in.
+  struct SlotAim {
+    DragRect slot;
+    PlannerPoint at;
+    DragRect region;
+  };
+  // A box whose library zone a point lies in, live (LiveZoneAt), and the
+  // side of it the zone is on: 1 top, 2 bottom, 3 left, 4 right.
+  struct LiveZone {
+    int box = 0;
+    int side = 0;
+  };
+  // Where a put-back lets go, and whether that place is calm.
+  struct PutBackPlace {
+    PlannerPoint at;
+    bool calm = true;
+  };
+  // An answer held back: what it says.
+  struct PendingAnswer {
+    std::string outcome;
+    std::string reason;
+  };
+  // A read of the grabbed element waiting for the page to settle: what it
+  // is for, and since when.
+  struct SettleRead {
+    SlotUse use = SlotUse::kAfter;
+    base::TimeTicks from;
+  };
+  // browser: what switched an inert target off, and that layer's kind.
+  struct InertCause {
+    std::string hit;
+    std::string kind;
+  };
