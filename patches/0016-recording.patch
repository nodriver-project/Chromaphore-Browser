+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// browser: a renderer's report of the scripts it compiled, for a traffic
+// recording at the full level (chrome/browser/devtools/protocol/recording.h).
+// Each renderer binds one pipe through its browser interface broker the first
+// time it is told to record (content.mojom.Renderer.SetScriptRecording) and
+// reports each script once per document per recording; the browser keeps one
+// file per distinct text. Nothing comes back on this pipe. Every string is
+// non-nullable, so the sender fills each one.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/time.mojom";
+
+// One script as the engine reported it compiled.
+struct RecordedScript {
+  // The engine's id for it, unique within its isolate.
+  int32 script_id;
+  // The JavaScript text; empty for WebAssembly. Cut at the renderer's cap,
+  // and then `truncated` says so.
+  string source;
+  // The module's bytes, for WebAssembly only; empty otherwise. Cut at the
+  // renderer's cap the same way.
+  array<uint8> wasm_bytes;
+  bool truncated;
+  // Its name or URL as the engine knows it; empty for inline and eval code.
+  string url;
+  // The //# sourceURL and //# sourceMappingURL it declared, or empty.
+  string source_url;
+  string source_mapping_url;
+  // classic | module | eval | wrapped | wasm | nameless. A module is reported
+  // when it is linked, not when it is compiled. nameless is a classic script
+  // compiled with no name in a window: what DevTools or a tool evaluates in
+  // the page, and also a page's own setTimeout("...") string or javascript:
+  // URL; the engine cannot tell those apart.
+  string kind;
+  // The document or worker script it was compiled for.
+  string document_url;
+  // The frame's devtools token and its tab's (the top frame's), the ids the
+  // recording's loads carry; empty for a worker.
+  string frame_token;
+  string tab_token;
+  // worker | service | worklet | shadowrealm for a scope that is not a
+  // window; empty for a document.
+  string worker_kind;
+  mojo_base.mojom.Time compiled_at;
+};
+
+interface ScriptRecorderHost {
+  // One script, after the renderer's own filter: not one it already reported
+  // in this recording on that thread, and not from one of the browser's own
+  // pages.
+  ScriptCompiled(RecordedScript script);
+};
