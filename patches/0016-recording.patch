+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+#include "base/time/time.h"
+#include "chrome/browser/devtools/protocol/recording_har_writer.h"
+#include "content/public/browser/devtools_agent_host_observer.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "services/network/public/mojom/traffic_recorder.mojom.h"
+#include "third_party/blink/public/mojom/script_recorder/script_recorder_host.mojom.h"
+
+namespace content {
+class DevToolsAgentHost;
+class WebContents;
+}  // namespace content
+
+// browser: the browser process's end of one traffic recording. The network
+// service reports every load and websocket it carries here; this builds one
+// HAR entry per load across those reports and hands each finished one to the
+// writer on a blocking file sequence, and writes websocket events as JSON
+// lines. At the full level the renderers' script reports come here too, for
+// scripts/ and scripts.json. It also watches page targets, so the HAR carries
+// a page per tab, and each tab for the title its page reports after that. It
+// reads what the service and the renderers already had and changes nothing
+// about how pages run.
+// Owned by RecordingRegistry, on the UI thread.
+class Recording : public network::mojom::TrafficRecorderClient,
+                  public content::DevToolsAgentHostObserver {
+ public:
+  // The per-entry and whole-recording limits, as the agent may raise them.
+  struct Caps {
+    uint64_t max_text_body_bytes = 4u * 1024 * 1024;
+    uint64_t max_binary_body_bytes = 512u * 1024;
+    uint64_t max_frame_bytes = 64u * 1024;
+    uint64_t max_total_bytes = 1024u * 1024 * 1024;
+  };
+
+  // `request_end` asks the owner to end the recording for a reason this object
+  // cannot act on itself (sizeCap, error). Called at most once.
+  Recording(base::FilePath dir,
+            std::string level,
+            Caps caps,
+            base::OnceCallback<void(std::string reason)> request_end);
+  Recording(const Recording&) = delete;
+  Recording& operator=(const Recording&) = delete;
+  ~Recording() override;
+
+  // Starts the file sequence and opens the directory. The files are opened on
+  // that sequence, so a failure arrives later as `request_end` with "error".
+  void Open();
+
+  // Binds the client the network service reports to. `on_lost` runs when that
+  // pipe closes: after a stop that is every report delivered; without a stop
+  // the network service is gone.
+  mojo::PendingRemote<network::mojom::TrafficRecorderClient> BindClient(
+      base::OnceClosure on_lost);
+  network::mojom::TrafficRecordingOptionsPtr MakeOptions() const;
+
+  void AddMask(const std::string& value, const std::string& label);
+
+  // A script a renderer compiled, from the registry's receiver (full level).
+  void OnScript(int process_id, blink::mojom::RecordedScriptPtr script);
+
+  // Stops taking reports, writes what the loads in flight have, and closes the
+  // files; `done` runs after the writer has finished. Safe more than once.
+  void Finish(std::string reason, base::OnceClosure done);
+
+  const base::FilePath& dir() const { return dir_; }
+  const std::string& level() const { return level_; }
+  uint64_t entry_count() const { return entry_count_; }
+  uint64_t script_count() const { return script_count_; }
+  uint64_t total_bytes() const { return total_bytes_; }
+
+ private:
+  // One load, from its first report to its completion.
+  struct Load {
+    RecordingEntry entry;
+    base::TimeTicks started;
+  };
+
+  // network::mojom::TrafficRecorderClient:
+  void OnRequest(network::mojom::RecordedRequestPtr request) override;
+  void OnRequestHeaders(
+      uint64_t loader_id,
+      const std::string& request_line,
+      std::vector<network::mojom::HttpHeaderPtr> headers) override;
+  void OnRequestBody(uint64_t loader_id,
+                     const std::vector<uint8_t>& chunk) override;
+  void OnRedirect(uint64_t loader_id,
+                  const net::RedirectInfo& redirect_info,
+                  network::mojom::URLResponseHeadPtr head,
+                  std::vector<network::mojom::HttpHeaderPtr> headers) override;
+  void OnResponseHeaders(
+      uint64_t loader_id,
+      network::mojom::URLResponseHeadPtr head,
+      std::vector<network::mojom::HttpHeaderPtr> headers) override;
+  void OnResponseBody(uint64_t loader_id,
+                      const std::vector<uint8_t>& chunk) override;
+  void OnComplete(uint64_t loader_id,
+                  network::mojom::RecordedCompletionPtr completion) override;
+  void OnSocketOpened(network::mojom::RecordedSocketOpenPtr open) override;
+  void OnSocketHandshakeRequest(
+      uint64_t socket_id,
+      network::mojom::WebSocketHandshakeRequestPtr request) override;
+  void OnSocketHandshakeResponse(
+      uint64_t socket_id,
+      network::mojom::WebSocketHandshakeResponsePtr response) override;
+  void OnSocketFrame(uint64_t socket_id,
+                     base::TimeTicks at,
+                     bool sent,
+                     bool fin,
+                     int32_t opcode,
+                     const std::vector<uint8_t>& payload,
+                     uint64_t payload_bytes,
+                     bool truncated) override;
+  void OnSocketClosed(uint64_t socket_id,
+                      base::TimeTicks at,
+                      bool was_clean,
+                      uint16_t code,
+                      const std::string& reason) override;
+  void OnSocketFailed(uint64_t socket_id,
+                      base::TimeTicks at,
+                      const std::string& message,
+                      int32_t net_error,
+                      int32_t response_code) override;
+
+  // content::DevToolsAgentHostObserver: false, so no target is created that
+  // would not have existed.
+  bool ShouldForceDevToolsAgentHostCreation() override;
+  void DevToolsAgentHostNavigated(content::DevToolsAgentHost* host) override;
+
+  // One tab the recording has seen navigate, watched for its titles and, from
+  // its second navigation on, for its pages.
+  class TabWatcher;
+  // A page a tab's watcher saw committed; `has_own_load` is false for one
+  // with no document load of its own (recording_har_writer.h).
+  void OnPage(RecordingPage page, bool has_own_load);
+  // The title a tab's page reports, from its watcher.
+  void OnTitle(const std::string& tab, std::string title);
+
+  Load* Find(uint64_t loader_id);
+  // Hands a finished load to the writer.
+  void Emit(uint64_t loader_id);
+  // Counts bytes against the whole-recording cap, asking to end at it.
+  void CountBytes(size_t bytes);
+  void OnOpened(bool ok);
+  void AskEnd(std::string reason);
+
+  base::FilePath dir_;
+  std::string level_;
+  Caps caps_;
+  base::OnceCallback<void(std::string reason)> request_end_;
+  bool finished_ = false;
+  bool observing_hosts_ = false;
+  // When the recording began, so a websocket event can say how far into it it
+  // happened; the loads carry their own wall-clock start.
+  base::TimeTicks origin_;
+  uint64_t entry_count_ = 0;
+  uint64_t script_count_ = 0;
+  uint64_t total_bytes_ = 0;
+  uint64_t next_number_ = 0;
+  std::map<uint64_t, Load> loads_;
+  // Each socket's message under way, by socket and direction (sent): the
+  // opcode its first frame carried, for the continuation frames after it.
+  std::map<std::pair<uint64_t, bool>, int32_t> socket_messages_;
+  // The tabs seen navigating, by their WebContents, each watched for titles.
+  std::map<content::WebContents*, std::unique_ptr<TabWatcher>> watchers_;
+  base::SequenceBound<RecordingHarWriter> writer_;
+  mojo::Receiver<network::mojom::TrafficRecorderClient> receiver_{this};
+  base::WeakPtrFactory<Recording> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_H_
