+
+// A websocket frame's opcode, as net::WebSocketFrameHeader numbers them.
+constexpr int kOpCodeContinuation = 0;
+constexpr int kOpCodeText = 1;
+
+std::string OriginText(const std::optional<url::Origin>& origin) {
+  return origin ? origin->Serialize() : std::string();
+}
+
+std::string TokenText(const std::optional<base::UnguessableToken>& token) {
+  return token ? token->ToString() : std::string();
+}
+
+// How far into the recording something happened, in ms, or -1 before the
+// recording had a start of its own.
+double SinceStart(base::TimeTicks origin, base::TimeTicks at) {
+  if (origin.is_null() || at.is_null() || at < origin) {
+    return -1;
+  }
+  return (at - origin).InMillisecondsF();
+}
+
+base::ListValue HeaderList(
+    const std::vector<network::mojom::HttpHeaderPtr>& headers) {
+  base::ListValue list;
+  for (const network::mojom::HttpHeaderPtr& header : headers) {
+    base::DictValue dict;
+    dict.Set("name", header->name);
+    dict.Set("value", header->value);
+    list.Append(std::move(dict));
+  }
+  return list;
+}
+
+// Appends a chunk of a body, keeping no more of the body than the larger
+// of the two body caps: the network service cuts each body at its cap
+// before a byte crosses, and this holds the browser to the same bound.
+void AppendBody(std::string& body,
+                const std::vector<uint8_t>& chunk,
+                const Recording::Caps& caps) {
+  const uint64_t cap =
+      std::max(caps.max_text_body_bytes, caps.max_binary_body_bytes);
+  const uint64_t room = cap > body.size() ? cap - body.size() : 0;
+  const size_t take =
+      static_cast<size_t>(std::min<uint64_t>(room, chunk.size()));
+  body.append(reinterpret_cast<const char*>(chunk.data()), take);
+}
