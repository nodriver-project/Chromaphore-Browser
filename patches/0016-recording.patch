@@ -0,0 +1,79 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SERVICES_NETWORK_TRAFFIC_RECORDER_UPLOAD_STREAM_H_
+#define SERVICES_NETWORK_TRAFFIC_RECORDER_UPLOAD_STREAM_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <vector>
+
+#include "base/component_export.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "net/base/upload_data_stream.h"
+
+namespace net {
+class IOBuffer;
+class NetLogWithSource;
+class UploadElementReader;
+}  // namespace net
+
+namespace network {
+
+class TrafficRecorder;
+
+// An upload stream that stands in front of the one the HTTP layer would have
+// read, forwards every call to it, and copies what is read to the traffic
+// recording. The bytes, the size and the chunking the HTTP layer sees are the
+// inner stream's own.
+class COMPONENT_EXPORT(NETWORK_SERVICE) TrafficRecorderUploadStream final
+    : public net::UploadDataStream {
+ public:
+  // Wraps `inner` for load `loader_id` of `recorder`; `text` picks the body
+  // cap.
+  TrafficRecorderUploadStream(std::unique_ptr<net::UploadDataStream> inner,
+                              base::WeakPtr<TrafficRecorder> recorder,
+                              uint64_t loader_id,
+                              bool text);
+  TrafficRecorderUploadStream(const TrafficRecorderUploadStream&) = delete;
+  TrafficRecorderUploadStream& operator=(const TrafficRecorderUploadStream&) =
+      delete;
+  ~TrafficRecorderUploadStream() override;
+
+ private:
+  // net::UploadDataStream:
+  bool IsInMemory() const override;
+  const std::vector<std::unique_ptr<net::UploadElementReader>>*
+  GetElementReaders() const override;
+  bool AllowHTTP1() const override;
+  int InitInternal(const net::NetLogWithSource& net_log) override;
+  int ReadInternal(net::IOBuffer* buf, int buf_len) override;
+  void ResetInternal() override;
+
+  void OnInnerInit(int result);
+  void OnInnerRead(int result);
+  // A finished read: its bytes go to the recording; `result` is returned as
+  // the inner stream gave it.
+  int Recorded(int result);
+
+  std::unique_ptr<net::UploadDataStream> inner_;
+  base::WeakPtr<TrafficRecorder> recorder_;
+  const uint64_t loader_id_;
+  const bool text_;
+  // The buffer of the read under way, held until the read finishes.
+  scoped_refptr<net::IOBuffer> pending_buffer_;
+  // The HTTP layer reads the body again whenever the stream rewinds (a
+  // retry, a 307/308). `reported_` is the high-water mark of body bytes
+  // already sent to the recording across passes; `pass_offset_` is the
+  // offset within the current pass. Only bytes past the mark are reported,
+  // so each byte crosses once.
+  uint64_t pass_offset_ = 0;
+  uint64_t reported_ = 0;
+};
+
+}  // namespace network
+
+#endif  // SERVICES_NETWORK_TRAFFIC_RECORDER_UPLOAD_STREAM_H_
