+++ b/chrome/browser/devtools/protocol/recording_har_writer.cc
@@ -0,0 +1,830 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/recording_har_writer.h"
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/i18n/time_formatting.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/values.h"
+#include "net/base/mime_util.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/cookies/cookie_util.h"
+#include "net/cookies/parsed_cookie.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The media type alone: lowercased, without its parameters or the space
+// around it.
+std::string BareMediaType(std::string_view mime_type) {
+  std::string type = base::ToLowerASCII(mime_type);
+  const size_t semi = type.find(';');
+  if (semi != std::string::npos) {
+    type.erase(semi);
+  }
+  return std::string(base::TrimWhitespaceASCII(type, base::TRIM_ALL));
+}
+
+// Whether a body of this media type is scanned for secrets and inlined as
+// text: text/*, JSON, XML, scripts, form data. Everything else is binary.
+bool IsTextMime(std::string_view mime_type) {
+  const std::string bare = BareMediaType(mime_type);
+  if (bare.starts_with("text/") || bare.ends_with("+json") ||
+      bare.ends_with("+xml")) {
+    return true;
+  }
+  static constexpr std::string_view kText[] = {
+      "application/json",
+      "application/ld+json",
+      "application/manifest+json",
+      "application/x-ndjson",
+      "application/graphql",
+      "application/xml",
+      "application/xhtml+xml",
+      "application/javascript",
+      "application/x-javascript",
+      "application/ecmascript",
+      "application/x-www-form-urlencoded",
+      "multipart/form-data",
+      "image/svg+xml",
+  };
+  return std::ranges::contains(kText, std::string_view(bare));
+}
+
+// `text` reduced to lowercase letters and digits when that leaves one to
+// eight of them, else empty: an extension any file system takes.
+std::string SafeExtension(std::string_view text) {
+  std::string safe;
+  for (char c : text) {
+    if (base::IsAsciiLower(c) || base::IsAsciiDigit(c)) {
+      safe.push_back(c);
+    }
+  }
+  return safe.size() <= 8 ? safe : std::string();
+}
+
+// A short, filesystem-safe extension for a body file.
+std::string ExtensionFor(std::string_view mime_type, bool is_text) {
+  const std::string type = BareMediaType(mime_type);
+  if (type == "application/json" || type.ends_with("+json")) {
+    return "json";
+  }
+  if (type == "text/html" || type == "application/xhtml+xml") {
+    return "html";
+  }
+  if (type == "text/css") {
+    return "css";
+  }
+  if (type.find("javascript") != std::string::npos ||
+      type == "application/ecmascript") {
+    return "js";
+  }
+  if (type == "application/xml" || type == "text/xml" ||
+      type.ends_with("+xml")) {
+    return "xml";
+  }
+  // The extension the platform knows for the type (txt, ico, woff2, ...).
+  base::FilePath::StringType preferred;
+  if (net::GetPreferredExtensionForMimeType(type, &preferred)) {
+    const std::string known =
+        SafeExtension(base::FilePath(preferred).AsUTF8Unsafe());
+    if (!known.empty()) {
+      return known;
+    }
+  }
+  const size_t slash = type.find('/');
+  if (slash != std::string::npos) {
+    const std::string safe =
+        SafeExtension(std::string_view(type).substr(slash + 1));
+    if (!safe.empty()) {
+      return safe;
+    }
+  }
+  return is_text ? "txt" : "bin";
+}
+
+base::ListValue HeaderList(const std::vector<RecordingHeader>& headers) {
+  base::ListValue list;
+  for (const RecordingHeader& header : headers) {
+    base::DictValue dict;
+    dict.Set("name", header.name);
+    dict.Set("value", header.value);
+    list.Append(std::move(dict));
+  }
+  return list;
+}
+
+// The cookies a request sent, as HAR lists them: one {name, value} per pair
+// of its Cookie lines, which are already masked.
+base::ListValue RequestCookies(const std::vector<RecordingHeader>& headers) {
+  base::ListValue cookies;
+  for (const RecordingHeader& header : headers) {
+    if (!base::EqualsCaseInsensitiveASCII(header.name, "cookie")) {
+      continue;
+    }
+    net::cookie_util::ParsedRequestCookies pairs;
+    net::cookie_util::ParseRequestCookieLine(header.value, &pairs);
+    for (const auto& [name, value] : pairs) {
+      base::DictValue cookie;
+      cookie.Set("name", name);
+      cookie.Set("value", value);
+      cookies.Append(std::move(cookie));
+    }
+  }
+  return cookies;
+}
+
+// The cookies a response set, as HAR lists them: one per Set-Cookie line
+// (already masked), with the attributes it carried. Max-Age and SameSite,
+// which HAR has no field for, go in _maxAge and _sameSite. A line that does
+// not parse as a cookie stays in the headers only.
+base::ListValue ResponseCookies(const std::vector<RecordingHeader>& headers) {
+  base::ListValue cookies;
+  for (const RecordingHeader& header : headers) {
+    if (!base::EqualsCaseInsensitiveASCII(header.name, "set-cookie")) {
+      continue;
+    }
+    const net::ParsedCookie parsed(header.value);
+    if (!parsed.IsValid()) {
+      continue;
+    }
+    base::DictValue cookie;
+    cookie.Set("name", parsed.Name());
+    cookie.Set("value", parsed.Value());
+    if (const std::optional<std::string_view> path = parsed.Path()) {
+      cookie.Set("path", *path);
+    }
+    if (const std::optional<std::string_view> domain = parsed.Domain()) {
+      cookie.Set("domain", *domain);
+    }
+    if (const std::optional<std::string_view> expires = parsed.Expires()) {
+      const base::Time time =
+          net::cookie_util::ParseCookieExpirationTime(*expires);
+      if (!time.is_null() && !time.is_max()) {
+        cookie.Set("expires", base::TimeFormatAsIso8601(time));
+      }
+    }
+    if (const std::optional<std::string_view> max_age = parsed.MaxAge()) {
+      cookie.Set("_maxAge", *max_age);
+    }
+    cookie.Set("httpOnly", parsed.IsHttpOnly());
+    cookie.Set("secure", parsed.IsSecure());
+    const net::CookieSameSite same_site = parsed.SameSite().first;
+    if (same_site == net::CookieSameSite::NO_RESTRICTION) {
+      cookie.Set("_sameSite", "None");
+    } else if (same_site == net::CookieSameSite::LAX_MODE) {
+      cookie.Set("_sameSite", "Lax");
+    } else if (same_site == net::CookieSameSite::STRICT_MODE) {
+      cookie.Set("_sameSite", "Strict");
+    }
+    cookies.Append(std::move(cookie));
+  }
+  return cookies;
+}
+
+// Byte counts, entry numbers and statuses are whole numbers. Without this
+// option the writer prints a double as 1.0, which a strict HAR reader, whose
+// schema types those fields as integers, rejects.
+constexpr int kWholeNumbers =
+    base::JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION;
+
+std::string PrettyJson(const base::DictValue& dict) {
+  std::string out;
+  base::JSONWriter::WriteWithOptions(
+      dict, base::JSONWriter::OPTIONS_PRETTY_PRINT | kWholeNumbers, &out);
+  return out;
+}
+
+// One line, for pages.json and sockets.ndjson.
+std::optional<std::string> CompactJson(const base::DictValue& dict) {
+  return base::WriteJsonWithOptions(dict, kWholeNumbers);
+}
+
+void MaskStrings(base::DictValue& dict, RecordingMasker& masker);
+
+// Masks `value` when it is a string, and every string inside it when it
+// is a dictionary or a list.
+void MaskStrings(base::Value& value, RecordingMasker& masker) {
+  if (value.is_string()) {
+    value.GetString() = masker.Apply(value.GetString(), nullptr);
+  } else if (value.is_dict()) {
+    MaskStrings(value.GetDict(), masker);
+  } else if (value.is_list()) {
+    for (base::Value& item : value.GetList()) {
+      MaskStrings(item, masker);
+    }
+  }
+}
+
+// Masks every string value in `dict`, nested ones included; its keys and
+// numbers are left as they are.
+void MaskStrings(base::DictValue& dict, RecordingMasker& masker) {
+  for (auto entry : dict) {
+    MaskStrings(entry.second, masker);
+  }
+}
+
+// A URL's host with its port when it has one: two servers on one host are
+// two hosts to a reader. An IPv6 host keeps its brackets, so the port reads.
+std::string HostWithPort(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  std::string host(url.host());
+  if (url.has_port()) {
+    host.push_back(':');
+    host.append(url.port());
+  }
+  return host;
+}
+
+// Whether a document load is a page's: the same URL but for the fragment.
+bool SameDocument(const std::string& page_url, const std::string& load_url) {
+  const GURL page(page_url);
+  const GURL load(load_url);
+  if (page.is_valid() && load.is_valid()) {
+    return page.GetWithoutRef() == load.GetWithoutRef();
+  }
+  return page_url == load_url;
+}
+
+// The query of `url` as HAR lists it: one {name, value} per pair, as written
+// in the (already masked) URL, so nothing is decoded back into the clear.
+base::ListValue QueryPairs(std::string_view url) {
+  base::ListValue pairs;
+  const size_t question = url.find('?');
+  if (question == std::string_view::npos) {
+    return pairs;
+  }
+  std::string_view query = url.substr(question + 1);
+  const size_t hash = query.find('#');
+  if (hash != std::string_view::npos) {
+    query = query.substr(0, hash);
+  }
+  for (std::string_view pair : base::SplitStringPiece(
+           query, "&", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    base::DictValue one;
+    const size_t equals = pair.find('=');
+    one.Set("name", std::string(pair.substr(0, equals)));
+    one.Set("value", equals == std::string_view::npos
+                         ? std::string()
+                         : std::string(pair.substr(equals + 1)));
+    pairs.Append(std::move(one));
+  }
+  return pairs;
+}
+
+}  // namespace
+
+RecordingHarWriter::RecordingHarWriter(base::FilePath dir, std::string level)
+    : dir_(std::move(dir)),
+      level_(std::move(level)),
+      started_(base::Time::Now()),
+      scripts_(dir_) {
+  summary_.SetLevel(level_);
+}
+
+RecordingHarWriter::~RecordingHarWriter() = default;
+
+bool RecordingHarWriter::Open() {
+  if (!base::CreateDirectory(dir_) ||
+      !base::CreateDirectory(dir_.AppendASCII("bodies"))) {
+    return false;
+  }
+  const uint32_t flags =
+      base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE;
+  har_.Initialize(dir_.AppendASCII("recording.har"), flags);
+  index_.Initialize(dir_.AppendASCII("requests.txt"), flags);
+  pages_.Initialize(dir_.AppendASCII("pages.json"), flags);
+  if (!har_.IsValid() || !index_.IsValid() || !pages_.IsValid()) {
+    return false;
+  }
+  open_ = true;
+  Append(har_,
+         "{\n \"log\": {\n  \"version\": \"1.2\",\n"
+         "  \"creator\": {\"name\": \"Chromeleon\", "
+         "\"version\": \"1\"},\n  \"entries\": [");
+  Append(index_, "# number  time  method  status  size  type  frame  url\n");
+  return true;
+}
+
+void RecordingHarWriter::AddMask(std::string value, std::string label) {
+  masker_.AddValue(value, label);
+}
+
+void RecordingHarWriter::AddPage(RecordingPage page, bool has_own_load) {
+  if (!open_ || finished_) {
+    return;
+  }
+  // The URL as the tab reported it, kept in memory only, to match the page's
+  // own document load (SameDocument). Everything written is masked below.
+  const std::string raw_url = page.url;
+  // A page carries a value to hide as readily as a load does: its URL has a
+  // query string, and its title is whatever the tab reported, which during a
+  // navigation is often the URL itself. Masked here, before pages.json and
+  // the HAR's own page list are built from them. The summary lists the pages
+  // at Finish, with the titles they ended up with.
+  page.url = masker_.Apply(page.url, nullptr);
+  page.title = masker_.Apply(page.title, nullptr);
+
+  // One page per navigation, under an id of its own; the tab it belongs to is
+  // kept beside it so an entry can find the page its tab was on.
+  const std::string tab = page.id;
+  page.id = tab + "#" + base::NumberToString(++page_seq_);
+
+  // A page with a load of its own takes the document waiting for its tab if
+  // the URLs agree, written under it below; one that does not agree never
+  // committed (a download, a 204, a cancelled one, a prefetch not used) and is
+  // written now under the page the tab was on. A page without a load of its
+  // own (a same-document navigation, a page back from the cache, a prerender
+  // activated) is complete as it is; it still takes a waiting document of its
+  // URL (a prerender's own load, keyed as the activated page is) and leaves
+  // any other to the next page that has a load.
+  RecordingEntry document;
+  bool has_document = !has_own_load;
+  bool write_document = false;
+  const auto waiting = pending_documents_.find(tab);
+  if (waiting != pending_documents_.end()) {
+    const bool matches = SameDocument(raw_url, waiting->second.url);
+    if (matches || has_own_load) {
+      document = std::move(waiting->second);
+      pending_documents_.erase(waiting);
+      if (matches) {
+        has_document = true;
+        write_document = true;
+      } else {
+        WriteEntry(std::move(document));
+      }
+    }
+  }
+  current_page_by_tab_[tab] = TabPage{page.id, raw_url, has_document};
+
+  base::DictValue dict;
+  dict.Set("id", page.id);
+  dict.Set("tab", tab);
+  dict.Set("url", page.url);
+  dict.Set("title", page.title);
+  dict.Set("startedDateTime", base::TimeFormatAsIso8601(page.started));
+  std::optional<std::string> line = CompactJson(dict);
+  if (line) {
+    Append(pages_, *line);
+    Append(pages_, "\n");
+  }
+  page_list_.push_back(std::move(page));
+  if (write_document) {
+    WriteEntry(std::move(document));
+  }
+}
+
+void RecordingHarWriter::SetPageTitle(const std::string& tab,
+                                      const std::string& title) {
+  if (!open_ || finished_) {
+    return;
+  }
+  const auto current = current_page_by_tab_.find(tab);
+  if (current == current_page_by_tab_.end()) {
+    return;
+  }
+  // Masked as the page's own fields are: a title is whatever the page says.
+  const std::string masked = masker_.Apply(title, nullptr);
+  bool changed = false;
+  for (RecordingPage& page : page_list_) {
+    if (page.id == current->second.id) {
+      changed = page.title != masked;
+      page.title = masked;
+      break;
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  // pages.json is appended to as things happen: a later line with an id and a
+  // title alone is that page's title, the last such line final.
+  base::DictValue dict;
+  dict.Set("id", current->second.id);
+  dict.Set("title", masked);
+  std::optional<std::string> line = CompactJson(dict);
+  if (line) {
+    Append(pages_, *line);
+    Append(pages_, "\n");
+  }
+}
+
+void RecordingHarWriter::AddSocketEvent(base::DictValue event) {
+  if (!open_ || finished_) {
+    return;
+  }
+  if (!sockets_.IsValid()) {
+    sockets_.Initialize(
+        dir_.AppendASCII("sockets.ndjson"),
+        base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+    if (!sockets_.IsValid()) {
+      return;
+    }
+  }
+  // Every string in the event is masked before the line is serialized, as an
+  // entry's fields are: a secret is found as it was sent, not as JSON
+  // escapes it, and no key or number of the line is touched.
+  MaskStrings(event, masker_);
+  // The host as the summary may show it: from the masked URL, as a load's is.
+  const std::string* kind = event.FindString("event");
+  const std::string* url = event.FindString("url");
+  summary_.NoteSocket(kind ? *kind : std::string(),
+                      url ? HostWithPort(GURL(*url)) : std::string(),
+                      event.FindBool("sent").value_or(false));
+  std::optional<std::string> line = CompactJson(event);
+  if (!line) {
+    return;
+  }
+  Append(sockets_, *line);
+  Append(sockets_, "\n");
+}
+
+void RecordingHarWriter::AddEntry(RecordingEntry entry) {
+  if (!open_ || finished_) {
+    return;
+  }
+  // A top-level document's own load and its page come in either order: the
+  // page is registered when the navigation commits, and a small document's
+  // load completes before that, a large or streamed one after it. If the tab
+  // is already on the page this load brought (same URL, no document yet), it
+  // is written now under that page; otherwise it waits, and AddPage files it
+  // when the page comes. One waiting already for the same tab goes out first,
+  // under the page the tab is on now, so nothing is lost.
+  if (entry.destination == "document" && !entry.tab_token.empty()) {
+    const std::string tab = entry.tab_token;
+    const auto current = current_page_by_tab_.find(tab);
+    if (current != current_page_by_tab_.end() &&
+        !current->second.has_document &&
+        SameDocument(current->second.url, entry.url)) {
+      current->second.has_document = true;
+      WriteEntry(std::move(entry));
+      return;
+    }
+    const auto waiting = pending_documents_.find(tab);
+    if (waiting != pending_documents_.end()) {
+      RecordingEntry earlier = std::move(waiting->second);
+      pending_documents_.erase(waiting);
+      WriteEntry(std::move(earlier));
+    }
+    pending_documents_.emplace(tab, std::move(entry));
+    return;
+  }
+  WriteEntry(std::move(entry));
+}
+
+void RecordingHarWriter::WriteEntry(RecordingEntry entry) {
+  const std::string json = EntryJson(entry);
+  Append(har_, first_entry_ ? "\n" : ",\n");
+  first_entry_ = false;
+  Append(har_, json);
+
+  const GURL url(entry.url);
+  const std::string host = HostWithPort(url);
+  std::string type = entry.mime_type;
+  const size_t semi = type.find(';');
+  if (semi != std::string::npos) {
+    type.erase(semi);
+  }
+  // A load's frame; a worker's its kind; a top-level document's its tab's
+  // token, which is its own frame's. Only a load the browser itself made has
+  // none, and shows "-".
+  const std::string frame = !entry.frame_token.empty()   ? entry.frame_token
+                            : !entry.worker_kind.empty() ? entry.worker_kind
+                                                         : entry.tab_token;
+  Append(index_, base::StringPrintf(
+                     "%llu  %.0f  %s  %d  %llu  %s  %s  %s\n",
+                     static_cast<unsigned long long>(entry.number),
+                     entry.duration_ms, entry.method.c_str(), entry.status,
+                     static_cast<unsigned long long>(entry.response_body_bytes),
+                     type.empty() ? "-" : type.c_str(),
+                     frame.empty() ? "-" : frame.c_str(), entry.url.c_str()));
+
+  RecordingSummary::EntryLine line;
+  line.number = entry.number;
+  line.method = entry.method;
+  line.status = entry.status;
+  line.url = entry.url;
+  line.host = host;
+  line.net_error = entry.net_error;
+  line.body_bytes = entry.response_body_bytes;
+  summary_.AddEntry(line);
+  if (entry.request_body_truncated || entry.response_body_truncated) {
+    summary_.NoteCapHit(base::StringPrintf(
+        "body on #%llu", static_cast<unsigned long long>(entry.number)));
+  }
+}
+
+std::string RecordingHarWriter::EntryJson(RecordingEntry& entry) {
+  bool masked = false;
+  bool changed = false;
+  entry.url = masker_.Apply(entry.url, &changed);
+  masked |= changed;
+  for (RecordingHeader& header : entry.request_headers) {
+    header.value = masker_.Apply(header.value, &changed);
+    masked |= changed;
+  }
+  for (RecordingHeader& header : entry.response_headers) {
+    header.value = masker_.Apply(header.value, &changed);
+    masked |= changed;
+  }
+  for (RecordingEntry::Redirect& hop : entry.redirects) {
+    for (RecordingHeader& header : hop.headers) {
+      header.value = masker_.Apply(header.value, &changed);
+      masked |= changed;
+    }
+  }
+  // The origins are URLs and the status text is the server's own words:
+  // either can carry a value as readily as the URL itself.
+  for (std::string* field : {&entry.initiator, &entry.top_origin,
+                             &entry.frame_origin, &entry.status_text}) {
+    *field = masker_.Apply(*field, &changed);
+    masked |= changed;
+  }
+
+  // Request.
+  base::DictValue request;
+  request.Set("method", entry.method);
+  request.Set("url", entry.url);
+  request.Set("httpVersion", entry.http_version);
+  request.Set("headers", HeaderList(entry.request_headers));
+  request.Set("queryString", QueryPairs(entry.url));
+  request.Set("cookies", RequestCookies(entry.request_headers));
+  request.Set("headersSize", -1);
+  request.Set("bodySize", static_cast<double>(entry.request_body_bytes));
+  if (entry.has_request_body) {
+    std::string content_type;
+    for (const RecordingHeader& header : entry.request_headers) {
+      if (base::EqualsCaseInsensitiveASCII(header.name, "content-type")) {
+        content_type = header.value;
+        break;
+      }
+    }
+    base::DictValue post;
+    post.Set("mimeType", content_type);
+    masked |= SetBody(post, entry, /*response=*/false, content_type,
+                      entry.request_body, "_encoding");
+    if (entry.request_body_truncated) {
+      post.Set("_truncated", true);
+    }
+    request.Set("postData", std::move(post));
+  }
+
+  // Response.
+  base::DictValue content;
+  content.Set("size", static_cast<double>(entry.response_body_bytes));
+  content.Set("mimeType", entry.mime_type);
+  if (entry.has_response_body) {
+    masked |= SetBody(content, entry, /*response=*/true, entry.mime_type,
+                      entry.response_body, "encoding");
+  }
+  if (entry.response_body_truncated) {
+    content.Set("_truncated", true);
+  }
+
+  base::DictValue response;
+  response.Set("status", entry.status);
+  response.Set("statusText", entry.status_text);
+  response.Set("httpVersion", entry.http_version);
+  response.Set("headers", HeaderList(entry.response_headers));
+  response.Set("cookies", ResponseCookies(entry.response_headers));
+  response.Set("content", std::move(content));
+  response.Set("redirectURL", "");
+  response.Set("headersSize", -1);
+  response.Set("bodySize", static_cast<double>(entry.response_body_bytes));
+
+  base::DictValue timings;
+  timings.Set("send", -1);
+  timings.Set("wait", -1);
+  timings.Set("receive", -1);
+
+  base::DictValue dict;
+  dict.Set("_number", static_cast<double>(entry.number));
+  dict.Set("startedDateTime", base::TimeFormatAsIso8601(entry.wall_started));
+  dict.Set("time", std::isfinite(entry.duration_ms) ? entry.duration_ms : -1);
+  // The HAR page this load belongs to: the page its tab was on.
+  const auto page = current_page_by_tab_.find(entry.tab_token);
+  if (!entry.tab_token.empty() && page != current_page_by_tab_.end()) {
+    dict.Set("pageref", page->second.id);
+  }
+  dict.Set("request", std::move(request));
+  dict.Set("response", std::move(response));
+  dict.Set("cache", base::DictValue());
+  dict.Set("timings", std::move(timings));
+
+  base::DictValue process;
+  process.Set("id", entry.process_id);
+  dict.Set("_process", std::move(process));
+  if (!entry.frame_token.empty() || !entry.tab_token.empty()) {
+    base::DictValue frame;
+    frame.Set("token", entry.frame_token);
+    frame.Set("tab", entry.tab_token);
+    frame.Set("origin", entry.frame_origin);
+    dict.Set("_frame", std::move(frame));
+  }
+  if (!entry.worker_kind.empty()) {
+    base::DictValue worker;
+    worker.Set("kind", entry.worker_kind);
+    worker.Set("url", masker_.Apply(entry.worker_url, nullptr));
+    dict.Set("_worker", std::move(worker));
+  }
+  if (!entry.top_origin.empty()) {
+    dict.Set("_top", entry.top_origin);
+  }
+  if (!entry.initiator.empty()) {
+    dict.Set("_initiator", entry.initiator);
+  }
+  if (!entry.destination.empty()) {
+    dict.Set("_destination", entry.destination);
+  }
+  if (!entry.protocol.empty()) {
+    dict.Set("_protocol", entry.protocol);
+  }
+  if (!entry.remote_ip.empty()) {
+    dict.Set("_remote", entry.remote_ip);
+  }
+  if (entry.from_cache) {
+    dict.Set("_cached", true);
+  }
+  if (!entry.tls.empty()) {
+    dict.Set("_tls", entry.tls);
+  }
+  if (entry.net_error != 0) {
+    dict.Set("_netError", entry.net_error);
+  }
+  if (entry.synthesized) {
+    dict.Set("_synthesized", true);
+  }
+  if (masked) {
+    dict.Set("_masked", true);
+  }
+  if (!entry.redirects.empty()) {
+    base::ListValue redirects;
+    for (const RecordingEntry::Redirect& hop : entry.redirects) {
+      base::DictValue dict_hop;
+      dict_hop.Set("url", masker_.Apply(hop.url, nullptr));
+      dict_hop.Set("status", hop.status);
+      dict_hop.Set("headers", HeaderList(hop.headers));
+      dict_hop.Set("cookies", ResponseCookies(hop.headers));
+      redirects.Append(std::move(dict_hop));
+    }
+    dict.Set("_redirects", std::move(redirects));
+  }
+  return PrettyJson(dict);
+}
+
+bool RecordingHarWriter::SetBody(base::DictValue& dict,
+                                 const RecordingEntry& entry,
+                                 bool response,
+                                 std::string_view mime_type,
+                                 const std::string& raw,
+                                 std::string_view encoding_key) {
+  bool changed = false;
+  const bool text = IsTextMime(mime_type);
+  std::string masked_text;
+  if (text) {
+    masked_text = masker_.Apply(raw, &changed);
+  }
+  const std::string& body = text ? masked_text : raw;
+  if (body.size() > kInlineBodyBytes) {
+    const std::string name = WriteBodyFile(entry, response, mime_type, body);
+    if (name.empty()) {
+      dict.Set("_bodyWriteFailed", true);
+    } else {
+      dict.Set("_file", "bodies/" + name);
+    }
+  } else if (text) {
+    dict.Set("text", std::move(masked_text));
+  } else {
+    dict.Set("text", base::Base64Encode(raw));
+    dict.Set(encoding_key, "base64");
+  }
+  return changed;
+}
+
+std::string RecordingHarWriter::WriteBodyFile(const RecordingEntry& entry,
+                                              bool response,
+                                              std::string_view mime_type,
+                                              std::string_view bytes) {
+  const GURL url(entry.url);
+  // Only the characters a file name can carry everywhere.
+  std::string host;
+  if (url.is_valid()) {
+    for (char c : url.HostNoBrackets()) {
+      if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' ||
+          c == '-') {
+        host.push_back(c);
+      }
+    }
+  }
+  if (host.empty()) {
+    host = "body";
+  }
+  const std::string name = base::StringPrintf(
+      "%llu-%s-%s.%s", static_cast<unsigned long long>(entry.number),
+      host.c_str(), response ? "response" : "request",
+      ExtensionFor(mime_type, IsTextMime(mime_type)).c_str());
+  const base::FilePath path = dir_.AppendASCII("bodies").AppendASCII(name);
+  if (!base::WriteFile(path, bytes)) {
+    write_failed_ = true;
+    return std::string();
+  }
+  return name;
+}
+
+void RecordingHarWriter::AddScript(int process_id,
+                                   blink::mojom::RecordedScriptPtr script) {
+  if (!open_ || finished_ || !script || level_ != "full") {
+    return;
+  }
+  scripts_.Add(process_id, *script, masker_, summary_);
+}
+
+void RecordingHarWriter::Finish(std::string reason,
+                                base::Time ended,
+                                uint64_t total_bytes) {
+  if (!open_ || finished_) {
+    return;
+  }
+  // Documents whose page never came: under the page their tab is on.
+  for (auto& [tab, document] : pending_documents_) {
+    WriteEntry(std::move(document));
+  }
+  pending_documents_.clear();
+  finished_ = true;
+
+  base::ListValue pages;
+  for (const RecordingPage& page : page_list_) {
+    // Listed here, not when the page began: its title arrives later.
+    summary_.AddPage(page.url, page.title);
+    base::DictValue dict;
+    dict.Set("id", page.id);
+    dict.Set("title", page.title);
+    dict.Set("startedDateTime", base::TimeFormatAsIso8601(page.started));
+    base::DictValue timings;
+    timings.Set("onContentLoad", -1);
+    timings.Set("onLoad", -1);
+    dict.Set("pageTimings", std::move(timings));
+    pages.Append(std::move(dict));
+  }
+  std::string pages_json = "[]";
+  if (std::optional<std::string> rendered =
+          base::WriteJsonWithOptions(pages, kWholeNumbers)) {
+    pages_json = std::move(*rendered);
+  }
+
+  Append(har_, "\n  ],\n  \"pages\": ");
+  Append(har_, pages_json);
+  Append(har_, "\n }\n}\n");
+
+  scripts_.Close();
+  if (scripts_.write_failed()) {
+    summary_.NoteGap(
+        "a script write did not go through: scripts/ or scripts.json is "
+        "short of what arrived");
+  }
+  if (write_failed_) {
+    summary_.NoteGap(
+        "a write did not go through: recording.har is short of what arrived, "
+        "and may have no closing trailer");
+  }
+  const std::string summary =
+      summary_.Render(reason, started_, ended, total_bytes, masker_.counts(),
+                      masker_.skipped());
+  base::WriteFile(dir_.AppendASCII("summary.md"), summary);
+
+  har_.Close();
+  index_.Close();
+  pages_.Close();
+  if (sockets_.IsValid()) {
+    sockets_.Close();
+  }
+}
+
+void RecordingHarWriter::Append(base::File& file, std::string_view text) {
+  if (!file.IsValid() || text.empty()) {
+    return;
+  }
+  base::span<const uint8_t> remaining = base::as_byte_span(text);
+  while (!remaining.empty()) {
+    std::optional<size_t> written = file.WriteAtCurrentPos(remaining);
+    if (!written || *written == 0) {
+      write_failed_ = true;
+      return;
+    }
+    remaining = remaining.subspan(*written);
+  }
+}
diff --git a/chrome/browser/devtools/protocol/recording_har_writer.h b/chrome/browser/devtools/protocol/recording_har_writer.h
new file mode 100644
index 0000000000..ccbcf83cf2
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_har_writer.h
@@ -0,0 +1,209 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_HAR_WRITER_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_HAR_WRITER_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/devtools/protocol/recording_masker.h"
+#include "chrome/browser/devtools/protocol/recording_script_store.h"
+#include "chrome/browser/devtools/protocol/recording_summary.h"
+#include "third_party/blink/public/mojom/script_recorder/script_recorder_host.mojom.h"
+
+// browser: a header line as sent or received.
+struct RecordingHeader {
+  std::string name;
+  std::string value;
+};
+
+// browser: a load as the recording holds it before it is written. The file
+// sequence masks the header values and the text body, decides inline vs a
+// bodies/ file, serializes the entry and appends it. Recording (recording.h)
+// fills one from the network service's reports.
+struct RecordingEntry {
+  // browser: one redirect hop before the final response.
+  struct Redirect {
+    std::string url;
+    int status = 0;
+    // The hop's response header lines as received, Set-Cookie included.
+    std::vector<RecordingHeader> headers;
+  };
+
+  uint64_t number = 0;
+
+  // Request.
+  std::string method;
+  std::string url;
+  std::string http_version;  // "http/1.1", "h2", "h3", or empty
+  std::vector<RecordingHeader> request_headers;
+  bool has_request_body = false;
+  std::string request_body;  // raw bytes, up to the cap
+  bool request_body_truncated = false;
+  uint64_t request_body_bytes = 0;
+
+  // Response.
+  int status = 0;
+  std::string status_text;
+  std::vector<RecordingHeader> response_headers;
+  bool has_response_body = false;
+  std::string response_body;  // raw bytes, up to the cap
+  bool response_body_truncated = false;
+  uint64_t response_body_bytes = 0;
+  std::string mime_type;
+
+  // Meta.
+  std::string remote_ip;
+  std::string protocol;
+  std::string tls;
+  bool from_cache = false;
+  int net_error = 0;
+  bool synthesized = false;
+
+  // Attribution.
+  int process_id = 0;
+  std::string frame_token;
+  std::string tab_token;
+  std::string worker_kind;
+  std::string worker_url;
+  std::string top_origin;
+  std::string frame_origin;
+  std::string initiator;
+  std::string destination;
+
+  // Timing.
+  base::Time wall_started;
+  double duration_ms = -1;
+
+  std::vector<Redirect> redirects;
+};
+
+// browser: a HAR page: one tab, one outermost navigation. `id` comes in as the
+// tab's target id (its main frame's devtools token) and the writer turns it
+// into an id of this one navigation.
+struct RecordingPage {
+  std::string id;
+  std::string url;
+  std::string title;
+  base::Time started;
+};
+
+// browser: writes a recording to its directory as it arrives. recording.har is
+// streamed (the entries, then the pages and the closing trailer at Finish), so
+// a crash leaves a HAR without its trailer that is rebuilt from pages.json.
+// requests.txt is one grep line per entry; bodies over the inline cap go to
+// bodies/; at the full level scripts/ and scripts.json; summary.md is written
+// at the end. Masks header values, URLs, pages, text bodies and scripts before
+// a byte reaches disk. One instance per recording, living on a blocking file
+// sequence (base::SequenceBound).
+class RecordingHarWriter {
+ public:
+  // Bodies up to this are inline in the HAR; larger ones go to bodies/.
+  static constexpr size_t kInlineBodyBytes = 16 * 1024;
+
+  RecordingHarWriter(base::FilePath dir, std::string level);
+  RecordingHarWriter(const RecordingHarWriter&) = delete;
+  RecordingHarWriter& operator=(const RecordingHarWriter&) = delete;
+  ~RecordingHarWriter();
+
+  // Creates the directory and opens the files. False if it could not; then
+  // every other call is a no-op.
+  bool Open();
+
+  // A secret to mask in every entry written after this (see RecordingMasker).
+  void AddMask(std::string value, std::string label);
+
+  // `has_own_load` is false for a page with no document load of its own: a
+  // same-document navigation, a page back from the cache, a prerender
+  // activated. Such a page is complete as it is and takes no waiting load.
+  void AddPage(RecordingPage page, bool has_own_load);
+  // The title a tab's page reports, which comes after the navigation that
+  // began the page: updates the page in the HAR's list and the summary, and
+  // appends a title line (the id and the title alone) to pages.json.
+  void SetPageTitle(const std::string& tab, const std::string& title);
+  // A top-level document's own load is filed under the page it brought: at
+  // once when the tab is already on that page, else when that page comes.
+  void AddEntry(RecordingEntry entry);
+  // One websocket event (open, handshake, frame, close, failure) as a JSON
+  // line in sockets.ndjson, which is created on the first one. The line is
+  // masked as an entry is, so a secret in a frame does not reach disk.
+  void AddSocketEvent(base::DictValue event);
+  // A script a renderer compiled (full level only): masked, hashed and written
+  // under scripts/ once per distinct text, and one line in scripts.json for
+  // every report (recording_script_store.h).
+  void AddScript(int process_id, blink::mojom::RecordedScriptPtr script);
+
+  // Writes the pages, the HAR's closing trailer and summary.md. `reason` is
+  // stopped | timeLimit | sizeCap | shutdown, or whatever else ended it. Does
+  // nothing after the first call.
+  void Finish(std::string reason, base::Time ended, uint64_t total_bytes);
+
+ private:
+  // Masks, serializes and appends one entry, and tells the index and the
+  // summary.
+  void WriteEntry(RecordingEntry entry);
+  std::string EntryJson(RecordingEntry& entry);
+  // Sets one body on `dict` as the HAR carries it: text masked, then inline
+  // or past kInlineBodyBytes in bodies/; anything else as it came, inline
+  // as base64 (marked so under `encoding_key`) or in bodies/. Returns
+  // whether masking changed the text.
+  bool SetBody(base::DictValue& dict,
+               const RecordingEntry& entry,
+               bool response,
+               std::string_view mime_type,
+               const std::string& raw,
+               std::string_view encoding_key);
+  // Writes `bytes` to bodies/ and returns the file's name within bodies/, or
+  // empty on failure. `mime_type` is the body's own media type: a request's
+  // Content-Type, not the response's.
+  std::string WriteBodyFile(const RecordingEntry& entry,
+                            bool response,
+                            std::string_view mime_type,
+                            std::string_view bytes);
+  void Append(base::File& file, std::string_view text);
+
+  base::FilePath dir_;
+  std::string level_;
+  base::Time started_;
+  base::File har_;
+  base::File index_;    // requests.txt
+  base::File pages_;    // pages.json, one page object per line
+  base::File sockets_;  // sockets.ndjson, opened on the first socket event
+  bool open_ = false;
+  bool finished_ = false;
+  bool first_entry_ = true;
+  // A write that did not go through, so the files are short of what arrived;
+  // the summary says so.
+  bool write_failed_ = false;
+  // Each tab's current page, by the tab's target id, so an entry can point at
+  // the page it belongs to. A tab that navigates again gets a new page, since
+  // a HAR page id must name exactly one page. The URL is the page's as the
+  // tab reported it, unmasked and kept in memory only, to match its document
+  // load; `has_document` says whether that load has been written.
+  struct TabPage {
+    std::string id;
+    std::string url;
+    bool has_document = false;
+  };
+  std::map<std::string, TabPage> current_page_by_tab_;
+  uint64_t page_seq_ = 0;
+  RecordingMasker masker_;
+  RecordingSummary summary_;
+  RecordingScriptStore scripts_;
+  std::vector<RecordingPage> page_list_;  // for the HAR trailer
+  // A tab's document load waiting for the page its navigation commits.
+  std::map<std::string, RecordingEntry> pending_documents_;
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_HAR_WRITER_H_
diff --git a/chrome/browser/devtools/protocol/recording_masker.cc b/chrome/browser/devtools/protocol/recording_masker.cc
new file mode 100644
index 0000000000..090dd3f51e
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_masker.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/recording_masker.h"
+
+#include <algorithm>
+
+#include "base/base64.h"
+#include "base/base64url.h"
+#include "base/strings/escape.h"
+
+namespace {
+
+// A label stands in the files for the value it hides, so it keeps only
+// characters that read the same in every file and need no escaping in
+// JSON. A label of nothing else becomes "secret".
+std::string SafeLabel(const std::string& label) {
+  std::string safe;
+  for (char c : label) {
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+        (c >= '0' && c <= '9') || c == '_' || c == '.' || c == ':' ||
+        c == '-' || c == ' ') {
+      safe.push_back(c);
+    }
+  }
+  if (safe.empty()) {
+    safe = "secret";
+  }
+  return safe;
+}
+
+// The value as it reads inside a JSON string, escaped as JSON.stringify
+// escapes it. A page that posts a secret in a JSON body sends this form, not
+// the value as given, whenever the value holds a quote, a backslash or a
+// control character.
+std::string JsonStringForm(const std::string& value) {
+  static constexpr char kHex[] = "0123456789abcdef";
+  std::string form;
+  for (char c : value) {
+    switch (c) {
+      case '"':
+        form.append("\\\"");
+        break;
+      case '\\':
+        form.append("\\\\");
+        break;
+      case '\b':
+        form.append("\\b");
+        break;
+      case '\f':
+        form.append("\\f");
+        break;
+      case '\n':
+        form.append("\\n");
+        break;
+      case '\r':
+        form.append("\\r");
+        break;
+      case '\t':
+        form.append("\\t");
+        break;
+      default:
+        if (static_cast<unsigned char>(c) < 0x20) {
+          form.append("\\u00");
+          form.push_back(kHex[c >> 4]);
+          form.push_back(kHex[c & 0xf]);
+        } else {
+          form.push_back(c);
+        }
+    }
+  }
+  return form;
+}
+
+}  // namespace
+
+RecordingMasker::RecordingMasker() = default;
+RecordingMasker::~RecordingMasker() = default;
+
+void RecordingMasker::AddValue(const std::string& value,
+                               const std::string& given_label) {
+  if (std::ranges::contains(seen_, value)) {
+    return;
+  }
+  seen_.push_back(value);
+  const std::string label = SafeLabel(given_label);
+  if (value.size() < kMinValueLength) {
+    if (!std::ranges::contains(skipped_, label)) {
+      skipped_.push_back(label);
+    }
+    return;
+  }
+
+  // The forms a value can take on the wire. Percent-encoding comes in two:
+  // a URL writes a space as %20, a form body as +. A JSON body escapes
+  // quotes, backslashes and control characters.
+  std::vector<std::string> forms = {
+      value,
+      base::EscapeUrlEncodedData(value, /*use_plus=*/false),
+      base::EscapeUrlEncodedData(value, /*use_plus=*/true),
+      JsonStringForm(value),
+      base::Base64Encode(value),
+  };
+  std::string b64url;
+  base::Base64UrlEncode(value, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &b64url);
+  forms.push_back(b64url);
+
+  for (const std::string& form : forms) {
+    if (form.empty()) {
+      continue;
+    }
+    if (!std::ranges::contains(needles_, form, &Needle::form)) {
+      needles_.push_back({form, label});
+    }
+  }
+  std::sort(needles_.begin(), needles_.end(),
+            [](const Needle& a, const Needle& b) {
+              return a.form.size() > b.form.size();
+            });
+}
+
+std::string RecordingMasker::Apply(std::string_view text, bool* changed) {
+  if (needles_.empty()) {
+    if (changed) {
+      *changed = false;
+    }
+    return std::string(text);
+  }
+  // One pass, left to right: at each position the longest value that starts
+  // there becomes its label and the scan jumps past it, so a replacement is
+  // never itself searched again.
+  std::string out;
+  out.reserve(text.size());
+  bool any = false;
+  size_t at = 0;
+  while (at < text.size()) {
+    const Needle* hit = nullptr;
+    for (const Needle& needle : needles_) {
+      if (text[at] != needle.form[0] ||
+          text.compare(at, needle.form.size(), needle.form) != 0) {
+        continue;
+      }
+      hit = &needle;
+      break;
+    }
+    if (!hit) {
+      out.push_back(text[at]);
+      ++at;
+      continue;
+    }
+    out.append("<masked:");
+    out.append(hit->label);
+    out.push_back('>');
+    counts_[hit->label] += 1;
+    any = true;
+    at += hit->form.size();
+  }
+  if (changed) {
+    *changed = any;
+  }
+  return out;
+}
diff --git a/chrome/browser/devtools/protocol/recording_masker.h b/chrome/browser/devtools/protocol/recording_masker.h
new file mode 100644
index 0000000000..47dce32bb1
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_masker.h
@@ -0,0 +1,64 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_MASKER_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_MASKER_H_
+
+#include <stddef.h>
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// browser: keeps secret values out of a traffic recording. The app hands it
+// exact values (card numbers, Authorization credentials) each with a label;
+// it replaces every known form of each, wherever it appears in a header, a
+// URL or a text body, with <masked:LABEL>, so the value never reaches a
+// reader. Exact match only: no pattern decides what a secret is, so nothing
+// unrelated is redacted. A value shorter than the floor is not searched for
+// (it would match everywhere) and is named in the summary instead. It runs on
+// the recording's file sequence.
+class RecordingMasker {
+ public:
+  // A value this short is not masked: too likely to occur by chance.
+  static constexpr size_t kMinValueLength = 6;
+
+  RecordingMasker();
+  RecordingMasker(const RecordingMasker&) = delete;
+  RecordingMasker& operator=(const RecordingMasker&) = delete;
+  ~RecordingMasker();
+
+  // Adds a value to hide under `given_label`, which is reduced to characters
+  // that are safe in a file and in a JSON string. A value at least
+  // kMinValueLength long is searched for in several forms: as given,
+  // percent-encoded, escaped as in a JSON string, and base64 (standard and
+  // URL-safe). A shorter one is recorded as skipped. The same value added
+  // again is ignored, so it keeps the label it came with first.
+  void AddValue(const std::string& value, const std::string& given_label);
+
+  // Returns `text` with every known form of every value replaced by its
+  // <masked:LABEL>, counting the replacements per label. Sets `*changed` (when
+  // not null) to whether anything was replaced.
+  std::string Apply(std::string_view text, bool* changed);
+
+  // Label -> replacements made so far.
+  const std::map<std::string, int>& counts() const { return counts_; }
+  // Labels of values that were too short to mask.
+  const std::vector<std::string>& skipped() const { return skipped_; }
+
+ private:
+  struct Needle {
+    std::string form;   // the bytes to find
+    std::string label;  // the label to report it under
+  };
+
+  // Longest form first, so a value that contains a shorter one masks whole.
+  std::vector<Needle> needles_;
+  std::map<std::string, int> counts_;
+  std::vector<std::string> skipped_;
+  std::vector<std::string> seen_;  // values already added, to drop duplicates
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_MASKER_H_
diff --git a/chrome/browser/devtools/protocol/recording_registry.cc b/chrome/browser/devtools/protocol/recording_registry.cc
new file mode 100644
index 0000000000..9caa5dc6d8
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_registry.cc
@@ -0,0 +1,251 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/recording_registry.h"
+
+#include <stddef.h>
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/strings/stringprintf.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/lifetime/termination_notification.h"
+#include "content/public/browser/network_service_instance.h"
+#include "content/public/browser/render_process_host.h"
+#include "services/network/public/mojom/network_service.mojom.h"
+
+namespace {
+
+// How long the files wait for the network service's last reports after a stop
+// before they are finished anyway.
+constexpr base::TimeDelta kFlushGuard = base::Seconds(10);
+
+// The most of one script a renderer sends (script_recorder.cc): 8M UTF-16
+// units of text, each at most three bytes of UTF-8, and 32 MiB of a
+// WebAssembly module. A report past either is dropped unread.
+constexpr size_t kMaxScriptSourceBytes = 3u * 8 * 1024 * 1024;
+constexpr size_t kMaxScriptWasmBytes = 32u * 1024 * 1024;
+
+}  // namespace
+
+// static
+RecordingRegistry& RecordingRegistry::GetInstance() {
+  static base::NoDestructor<RecordingRegistry> instance;
+  return *instance;
+}
+
+RecordingRegistry::RecordingRegistry() = default;
+RecordingRegistry::~RecordingRegistry() = default;
+
+std::string RecordingRegistry::Start(Request request, std::string* error) {
+  if (recording_) {
+    *error = "this browser is already recording";
+    return std::string();
+  }
+  if (request.dir.empty() || !request.dir.IsAbsolute()) {
+    *error = "the recording needs an absolute directory";
+    return std::string();
+  }
+
+  recording_ = std::make_unique<Recording>(
+      request.dir, request.level, request.caps,
+      base::BindOnce(&RecordingRegistry::OnEndRequested,
+                     base::Unretained(this)));
+  recording_->Open();
+  for (const auto& [value, label] : request.masks) {
+    recording_->AddMask(value, label);
+  }
+
+  content::GetNetworkService()->StartTrafficRecording(
+      recording_->BindClient(base::BindOnce(&RecordingRegistry::OnClientLost,
+                                            base::Unretained(this))),
+      recording_->MakeOptions());
+  // The renderers report their scripts only at the full level; one started
+  // during the recording is told at its start.
+  started_at_ = base::Time::Now();
+  SetScriptsOn(recording_->level() == "full");
+
+  id_ = base::UnguessableToken::Create().ToString();
+  ending_ = false;
+  pending_reason_.clear();
+  if (request.limit.is_positive()) {
+    ends_at_ = base::Time::Now() + request.limit;
+    limit_.Start(
+        FROM_HERE, request.limit,
+        base::BindOnce(&RecordingRegistry::OnLimit, base::Unretained(this)));
+  } else {
+    ends_at_ = base::Time();
+  }
+  // Dropped with the recording, so no callback outlives it.
+  terminating_ = browser_shutdown::AddAppTerminatingCallback(base::BindOnce(
+      &RecordingRegistry::OnTerminating, base::Unretained(this)));
+  return id_;
+}
+
+bool RecordingRegistry::Stop(const std::string& recording_id,
+                             base::OnceClosure done) {
+  if (!recording_ || recording_id != id_ || stop_done_) {
+    return false;
+  }
+  stop_done_ = std::move(done);
+  End("stopped");
+  return true;
+}
+
+bool RecordingRegistry::AddMasks(
+    const std::string& recording_id,
+    const std::vector<std::pair<std::string, std::string>>& masks) {
+  if (!recording_ || recording_id != id_) {
+    return false;
+  }
+  for (const auto& [value, label] : masks) {
+    recording_->AddMask(value, label);
+  }
+  return true;
+}
+
+void RecordingRegistry::AddListener(Listener* listener) {
+  listeners_.insert(listener);
+}
+
+void RecordingRegistry::RemoveListener(Listener* listener) {
+  listeners_.erase(listener);
+}
+
+void RecordingRegistry::OnEndRequested(std::string reason) {
+  End(std::move(reason));
+}
+
+void RecordingRegistry::OnLimit() {
+  End("timeLimit");
+}
+
+void RecordingRegistry::End(std::string reason) {
+  if (!recording_ || ending_) {
+    return;
+  }
+  ending_ = true;
+  pending_reason_ = std::move(reason);
+  limit_.Stop();
+  SetScriptsOn(false);
+  // The tap goes off; the client pipe closing is every report delivered, so
+  // the files are finished from OnClientLost, not from this reply.
+  content::GetNetworkService()->StopTrafficRecording(base::DoNothing());
+  flush_guard_.Start(
+      FROM_HERE, kFlushGuard,
+      base::BindOnce(&RecordingRegistry::OnClientLost, base::Unretained(this)));
+}
+
+void RecordingRegistry::OnClientLost() {
+  if (!recording_) {
+    return;
+  }
+  if (!ending_) {
+    // Nobody asked: the network service is gone, and with it whatever it had
+    // not reported.
+    ending_ = true;
+    pending_reason_ = "networkServiceGone";
+    limit_.Stop();
+    SetScriptsOn(false);
+  }
+  flush_guard_.Stop();
+  const std::string reason = pending_reason_;
+  recording_->Finish(reason, base::BindOnce(&RecordingRegistry::OnFinished,
+                                            base::Unretained(this), reason));
+}
+
+void RecordingRegistry::OnFinished(std::string reason) {
+  // Read now, not when the stop began: Finish writes the loads that were
+  // still in flight, and those are entries too.
+  bool full = false;
+  if (recording_) {
+    last_path_ = recording_->dir();
+    last_entries_ = recording_->entry_count();
+    last_scripts_ = recording_->script_count();
+    last_bytes_ = recording_->total_bytes();
+    full = recording_->level() == "full";
+  }
+  last_summary_ =
+      full ? base::StringPrintf(
+                 "%llu entries, %llu scripts, %llu bytes, ended %s",
+                 static_cast<unsigned long long>(last_entries_),
+                 static_cast<unsigned long long>(last_scripts_),
+                 static_cast<unsigned long long>(last_bytes_), reason.c_str())
+           : base::StringPrintf("%llu entries, %llu bytes, ended %s",
+                                static_cast<unsigned long long>(last_entries_),
+                                static_cast<unsigned long long>(last_bytes_),
+                                reason.c_str());
+  const std::string ended_id = id_;
+  const std::string path = last_path_.AsUTF8Unsafe();
+
+  recording_.reset();
+  id_.clear();
+  ending_ = false;
+  pending_reason_.clear();
+  ends_at_ = base::Time();
+  terminating_ = base::CallbackListSubscription();
+
+  if (stop_done_) {
+    std::move(stop_done_).Run();
+  }
+  // A copy: a listener may leave the set while it is told.
+  const std::set<Listener*> listeners = listeners_;
+  for (Listener* listener : listeners) {
+    if (listeners_.contains(listener)) {
+      listener->OnRecordingEnded(ended_id, reason, path, last_summary_);
+    }
+  }
+}
+
+void RecordingRegistry::BindScriptRecorderHost(
+    int process_id,
+    mojo::PendingReceiver<blink::mojom::ScriptRecorderHost> receiver) {
+  // Kept until the renderer's pipe closes, which the set notices itself.
+  script_hosts_.Add(this, std::move(receiver), process_id);
+}
+
+void RecordingRegistry::ScriptCompiled(blink::mojom::RecordedScriptPtr script) {
+  // A renderer told to stop may still have reports in flight, and one of
+  // them can arrive after the next recording has begun: the renderers' pipe
+  // keeps no order with the one that tells them to stop, so a report is
+  // taken only for the recording it was compiled during, with a second's
+  // give for the processes' clocks. A renderer is never told to report at
+  // the network level, but that check costs nothing.
+  if (!recording_ || ending_ || recording_->level() != "full" || !script ||
+      script->compiled_at + base::Seconds(1) < started_at_) {
+    return;
+  }
+  if (script->source.size() > kMaxScriptSourceBytes ||
+      script->wasm_bytes.size() > kMaxScriptWasmBytes) {
+    return;
+  }
+  recording_->OnScript(script_hosts_.current_context(), std::move(script));
+}
+
+void RecordingRegistry::SetScriptsOn(bool on) {
+  if (on == scripts_on_) {
+    return;
+  }
+  scripts_on_ = on;
+  content::RenderProcessHost::SetScriptRecording(on);
+}
+
+void RecordingRegistry::OnTerminating() {
+  if (!recording_) {
+    return;
+  }
+  // The browser is going. No reply posted back to the UI thread would run, so
+  // the files are finished without waiting for the service's last reports; the
+  // writer's sequence blocks the thread pool's shutdown until they are on
+  // disk. No listener is told: the sessions are going too.
+  ending_ = true;
+  limit_.Stop();
+  flush_guard_.Stop();
+  SetScriptsOn(false);
+  content::GetNetworkService()->StopTrafficRecording(base::DoNothing());
+  recording_->Finish("shutdown", base::DoNothing());
+}
diff --git a/chrome/browser/devtools/protocol/recording_registry.h b/chrome/browser/devtools/protocol/recording_registry.h
new file mode 100644
index 0000000000..cec64cac9c
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_registry.h
@@ -0,0 +1,152 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_REGISTRY_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_REGISTRY_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/files/file_path.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/devtools/protocol/recording.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "third_party/blink/public/mojom/script_recorder/script_recorder_host.mojom.h"
+
+// browser: the one traffic recording in this browser process. It turns the
+// network service's tap on and off, holds the time limit, ends the recording
+// on a stop, the limit, the total-size cap, a lost network service or browser
+// shutdown, and tells its listeners which recording ended and why. A session's
+// handler registers as a listener for the Browser.recordingEnded event; there
+// can be more than one browser-target session. It is also the browser's end
+// of every renderer's script reports (blink.mojom.ScriptRecorderHost): a full
+// recording turns the renderers on, and whatever ends it turns them off.
+class RecordingRegistry : public blink::mojom::ScriptRecorderHost {
+ public:
+  // A browser-target session that wants the end of a recording.
+  class Listener {
+   public:
+    virtual void OnRecordingEnded(const std::string& recording_id,
+                                  const std::string& reason,
+                                  const std::string& path,
+                                  const std::string& summary) = 0;
+
+   protected:
+    virtual ~Listener() = default;
+  };
+
+  // What a start asks for. `dir` is already decided by the caller.
+  struct Request {
+    base::FilePath dir;
+    std::string level;  // "network" or "full"
+    base::TimeDelta limit;
+    Recording::Caps caps;
+    // (value, label) pairs, as AddMasks takes them.
+    std::vector<std::pair<std::string, std::string>> masks;
+  };
+
+  static RecordingRegistry& GetInstance();
+
+  RecordingRegistry(const RecordingRegistry&) = delete;
+  RecordingRegistry& operator=(const RecordingRegistry&) = delete;
+
+  // Starts the one recording and returns its id, or empty with `error` set.
+  std::string Start(Request request, std::string* error);
+  // Ends it. `done` runs once the files are closed. False when `recording_id`
+  // is not the recording under way, or when it is already ending and someone
+  // is waiting for its files.
+  bool Stop(const std::string& recording_id, base::OnceClosure done);
+  // Whether a stop is waiting for the files of the recording under way. One
+  // ending on its own (its time limit, the size cap) has none until a stop
+  // comes, and that stop waits for the same files.
+  bool stop_waiting() const { return !stop_done_.is_null(); }
+  // More values to hide, as (value, label) pairs. False when
+  // `recording_id` is not the recording under way.
+  bool AddMasks(const std::string& recording_id,
+                const std::vector<std::pair<std::string, std::string>>& masks);
+
+  // A renderer's pipe for its script reports, bound for the renderer's life
+  // (chrome_content_browser_client_receiver_bindings.cc). A report that
+  // arrives outside a full recording is dropped.
+  void BindScriptRecorderHost(
+      int process_id,
+      mojo::PendingReceiver<blink::mojom::ScriptRecorderHost> receiver);
+
+  // The recording under way, or null.
+  Recording* current() { return recording_.get(); }
+  const std::string& current_id() const { return id_; }
+  base::Time ends_at() const { return ends_at_; }
+
+  // What the last recording to end left behind, for a stop's reply.
+  const base::FilePath& last_path() const { return last_path_; }
+  uint64_t last_entries() const { return last_entries_; }
+  uint64_t last_scripts() const { return last_scripts_; }
+  uint64_t last_bytes() const { return last_bytes_; }
+  const std::string& last_summary() const { return last_summary_; }
+
+  void AddListener(Listener* listener);
+  void RemoveListener(Listener* listener);
+
+ private:
+  friend class base::NoDestructor<RecordingRegistry>;
+
+  RecordingRegistry();
+  ~RecordingRegistry() override;
+
+  // blink::mojom::ScriptRecorderHost:
+  void ScriptCompiled(blink::mojom::RecordedScriptPtr script) override;
+
+  // Tells every renderer, live and to come, whether to report its scripts.
+  void SetScriptsOn(bool on);
+
+  // Begins ending the recording: stops the tap and waits for the client pipe
+  // to close, which is every report delivered.
+  void End(std::string reason);
+  // The network service closed the client pipe.
+  void OnClientLost();
+  // The writer has closed the files.
+  void OnFinished(std::string reason);
+  void OnLimit();
+  void OnTerminating();
+  // Asked for by the recording itself (sizeCap, error).
+  void OnEndRequested(std::string reason);
+
+  std::unique_ptr<Recording> recording_;
+  std::string id_;
+  base::Time ends_at_;
+  bool ending_ = false;
+  std::string pending_reason_;
+  base::OnceClosure stop_done_;
+  base::OneShotTimer limit_;
+  // If the client pipe never closes (a network service that is gone without a
+  // disconnect), the files are finished anyway.
+  base::OneShotTimer flush_guard_;
+  std::set<Listener*> listeners_;
+  base::CallbackListSubscription terminating_;
+  // Whether the renderers are reporting: on only during a full recording.
+  bool scripts_on_ = false;
+  // When the recording under way began. A report compiled before that was
+  // meant for the recording before it: the renderers' pipe keeps no order
+  // with the one that tells them to stop.
+  base::Time started_at_;
+  // One receiver per renderer, with its process id as the context.
+  mojo::ReceiverSet<blink::mojom::ScriptRecorderHost, int> script_hosts_;
+
+  base::FilePath last_path_;
+  uint64_t last_entries_ = 0;
+  uint64_t last_scripts_ = 0;
+  uint64_t last_bytes_ = 0;
+  std::string last_summary_;
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_REGISTRY_H_
diff --git a/chrome/browser/devtools/protocol/recording_script_store.cc b/chrome/browser/devtools/protocol/recording_script_store.cc
new file mode 100644
index 0000000000..0ef70b3152
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_script_store.cc
@@ -0,0 +1,165 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/recording_script_store.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/hash/sha1.h"
+#include "base/i18n/time_formatting.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/devtools/protocol/recording_masker.h"
+#include "chrome/browser/devtools/protocol/recording_summary.h"
+
+namespace {
+
+// Counts and byte sizes as whole numbers, not 12.0.
+constexpr int kWholeNumbers =
+    base::JSONWriter::OPTIONS_OMIT_DOUBLE_TYPE_PRESERVATION;
+
+// The whole digest, forty hex digits: a prefix a page could make two scripts
+// share would leave the second unwritten.
+std::string HashName(std::string_view text) {
+  const base::SHA1Digest digest = base::SHA1Hash(base::as_byte_span(text));
+  return base::ToLowerASCII(base::HexEncode(digest));
+}
+
+const char* ExtensionFor(const std::string& kind) {
+  if (kind == "wasm") {
+    return ".wasm";
+  }
+  if (kind == "module") {
+    return ".mjs";
+  }
+  return ".js";
+}
+
+}  // namespace
+
+RecordingScriptStore::RecordingScriptStore(base::FilePath dir)
+    : dir_(std::move(dir)) {}
+
+RecordingScriptStore::~RecordingScriptStore() = default;
+
+bool RecordingScriptStore::Open() {
+  if (opened_) {
+    return true;
+  }
+  if (open_failed_) {
+    return false;
+  }
+  if (!base::CreateDirectory(dir_.AppendASCII("scripts"))) {
+    open_failed_ = true;
+    write_failed_ = true;
+    return false;
+  }
+  index_.Initialize(dir_.AppendASCII("scripts.json"),
+                    base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+  if (!index_.IsValid()) {
+    open_failed_ = true;
+    write_failed_ = true;
+    return false;
+  }
+  opened_ = true;
+  return true;
+}
+
+void RecordingScriptStore::Add(int process_id,
+                               const blink::mojom::RecordedScript& script,
+                               RecordingMasker& masker,
+                               RecordingSummary& summary) {
+  if (closed_ || !Open()) {
+    return;
+  }
+  ++count_;
+  const bool wasm = script.kind == "wasm";
+  // What goes on disk: the module's bytes as they came, or the text with the
+  // recording's secrets hidden. The hash names what is written, so two
+  // reports of one text share a file, and a secret never names one.
+  std::string text;
+  if (wasm) {
+    text.assign(script.wasm_bytes.begin(), script.wasm_bytes.end());
+  } else {
+    text = masker.Apply(script.source, nullptr);
+  }
+  const std::string hash = HashName(text);
+  // Keyed by the file's name, not the hash alone: the same text compiled as
+  // a classic script and as a module is two files.
+  const std::string file = hash + ExtensionFor(script.kind);
+  const bool new_text = written_.insert(file).second;
+  if (new_text &&
+      !base::WriteFile(dir_.AppendASCII("scripts").AppendASCII(file), text)) {
+    write_failed_ = true;
+  }
+
+  // The line: the URLs a page chose can carry a value to hide, as a load's
+  // can; the tokens and the kind are the browser's own.
+  const std::string document = masker.Apply(script.document_url, nullptr);
+  base::DictValue line;
+  line.Set("number", static_cast<double>(count_));
+  line.Set("time", base::TimeFormatAsIso8601(script.compiled_at));
+  line.Set("file", "scripts/" + file);
+  line.Set("hash", hash);
+  line.Set("kind", script.kind);
+  line.Set("url", masker.Apply(script.url, nullptr));
+  if (!script.source_url.empty()) {
+    line.Set("sourceUrl", masker.Apply(script.source_url, nullptr));
+  }
+  if (!script.source_mapping_url.empty()) {
+    line.Set("sourceMappingUrl",
+             masker.Apply(script.source_mapping_url, nullptr));
+  }
+  line.Set("document", document);
+  if (!script.frame_token.empty()) {
+    line.Set("frame", script.frame_token);
+    line.Set("tab", script.tab_token);
+  }
+  if (!script.worker_kind.empty()) {
+    line.Set("worker", script.worker_kind);
+  }
+  line.Set("process", process_id);
+  line.Set("bytes", static_cast<double>(text.size()));
+  line.Set("truncated", script.truncated);
+  std::optional<std::string> json =
+      base::WriteJsonWithOptions(line, kWholeNumbers);
+  if (json) {
+    Append(*json);
+    Append("\n");
+  } else {
+    write_failed_ = true;
+  }
+  summary.AddScript(script.kind, document, new_text,
+                    new_text ? text.size() : 0);
+}
+
+void RecordingScriptStore::Append(std::string_view text) {
+  if (!index_.IsValid() || text.empty()) {
+    return;
+  }
+  base::span<const uint8_t> remaining = base::as_byte_span(text);
+  while (!remaining.empty()) {
+    std::optional<size_t> written = index_.WriteAtCurrentPos(remaining);
+    if (!written || *written == 0) {
+      write_failed_ = true;
+      return;
+    }
+    remaining = remaining.subspan(*written);
+  }
+}
+
+void RecordingScriptStore::Close() {
+  if (closed_) {
+    return;
+  }
+  closed_ = true;
+  if (index_.IsValid()) {
+    index_.Close();
+  }
+}
diff --git a/chrome/browser/devtools/protocol/recording_script_store.h b/chrome/browser/devtools/protocol/recording_script_store.h
new file mode 100644
index 0000000000..e9b71d751d
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_script_store.h
@@ -0,0 +1,65 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_SCRIPT_STORE_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_SCRIPT_STORE_H_
+
+#include <stdint.h>
+
+#include <set>
+#include <string>
+#include <string_view>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "third_party/blink/public/mojom/script_recorder/script_recorder_host.mojom.h"
+
+class RecordingMasker;
+class RecordingSummary;
+
+// browser: the scripts a full recording keeps. One file per distinct text
+// under scripts/, named by a hash of that text, and scripts.json, one line per
+// report saying which document in which frame, tab and process compiled which
+// file. JavaScript is masked before it is hashed or written, so a secret a
+// page echoed into its own code never reaches disk; WebAssembly is written as
+// it came, as binary bodies are. Lives in the HAR writer on the recording's
+// file sequence and opens its files on the first script, so a recording at
+// the network level has neither.
+class RecordingScriptStore {
+ public:
+  explicit RecordingScriptStore(base::FilePath dir);
+  RecordingScriptStore(const RecordingScriptStore&) = delete;
+  RecordingScriptStore& operator=(const RecordingScriptStore&) = delete;
+  ~RecordingScriptStore();
+
+  // One report from a renderer. `masker` hides the recording's secrets and
+  // `summary` is told what was kept.
+  void Add(int process_id,
+           const blink::mojom::RecordedScript& script,
+           RecordingMasker& masker,
+           RecordingSummary& summary);
+
+  // Closes scripts.json. Nothing is written after it.
+  void Close();
+
+  // Reports taken in, and whether a write did not go through, so the files
+  // are short of what arrived.
+  uint64_t count() const { return count_; }
+  bool write_failed() const { return write_failed_; }
+
+ private:
+  bool Open();
+  void Append(std::string_view text);
+
+  base::FilePath dir_;
+  base::File index_;  // scripts.json, one object per line
+  bool opened_ = false;
+  bool open_failed_ = false;
+  bool closed_ = false;
+  bool write_failed_ = false;
+  uint64_t count_ = 0;
+  std::set<std::string> written_;  // file names already on disk
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_SCRIPT_STORE_H_
diff --git a/chrome/browser/devtools/protocol/recording_summary.cc b/chrome/browser/devtools/protocol/recording_summary.cc
new file mode 100644
index 0000000000..f3547a163a
--- /dev/null
+++ b/chrome/browser/devtools/protocol/recording_summary.cc
@@ -0,0 +1,267 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/recording_summary.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/i18n/time_formatting.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "net/base/net_errors.h"
+
+namespace {
+
+// How many of the biggest bodies summary.md lists.
+constexpr size_t kLargestKept = 10;
+
+// How many documents the Scripts section lists, most scripts first.
+constexpr size_t kDocumentsListed = 10;
+
+std::string HumanBytes(uint64_t bytes) {
+  if (bytes < 1024) {
+    return base::StringPrintf("%llu B", static_cast<unsigned long long>(bytes));
+  }
+  double value = static_cast<double>(bytes);
+  static constexpr const char* kUnits[] = {"KB", "MB", "GB", "TB"};
+  int unit = -1;
+  do {
+    value /= 1024.0;
+    ++unit;
+  } while (value >= 1024.0 && unit < 3);
+  return base::StringPrintf("%.1f %s", value, kUnits[unit]);
+}
+
+bool Failed(const RecordingSummary::EntryLine& line) {
+  return line.net_error != 0 || line.status == 0 || line.status >= 400;
+}
+
+std::string LineText(const RecordingSummary::EntryLine& line) {
+  std::string status;
+  if (line.net_error != 0) {
+    status = base::StringPrintf(
+        "%s (%d)", net::ErrorToString(line.net_error).c_str(), line.net_error);
+  } else if (line.status == 0) {
+    status = "no response";
+  } else {
+    status = base::NumberToString(line.status);
+  }
+  return base::StringPrintf(
+      "- #%llu %s %s %s (%s)", static_cast<unsigned long long>(line.number),
+      status.c_str(), line.method.c_str(), line.url.c_str(), line.host.c_str());
+}
+
+}  // namespace
+
+RecordingSummary::RecordingSummary() = default;
+RecordingSummary::~RecordingSummary() = default;
+
+void RecordingSummary::SetLevel(std::string level) {
+  level_ = std::move(level);
+}
+
+void RecordingSummary::AddPage(std::string url, std::string title) {
+  pages_.push_back({std::move(url), std::move(title)});
+}
+
+void RecordingSummary::AddEntry(const EntryLine& line) {
+  ++entry_count_;
+  if (!line.host.empty()) {
+    host_counts_[line.host] += 1;
+  }
+  if (Failed(line)) {
+    failures_.push_back(line);
+  }
+  if (line.body_bytes > 0) {
+    largest_.push_back(line);
+    std::sort(largest_.begin(), largest_.end(),
+              [](const EntryLine& a, const EntryLine& b) {
+                return a.body_bytes > b.body_bytes;
+              });
+    if (largest_.size() > kLargestKept) {
+      largest_.resize(kLargestKept);
+    }
+  }
+}
+
+void RecordingSummary::AddScript(const std::string& kind,
+                                 const std::string& document,
+                                 bool new_text,
+                                 uint64_t bytes) {
+  ++script_count_;
+  if (new_text) {
+    ++script_unique_;
+    script_bytes_ += bytes;
+  }
+  script_kinds_[kind] += 1;
+  if (!document.empty()) {
+    script_documents_[document] += 1;
+  }
+}
+
+void RecordingSummary::NoteSocket(const std::string& event,
+                                  const std::string& host,
+                                  bool sent) {
+  if (event == "open") {
+    ++sockets_;
+    if (!host.empty()) {
+      socket_hosts_[host] += 1;
+    }
+  } else if (event == "frame") {
+    if (sent) {
+      ++frames_sent_;
+    } else {
+      ++frames_received_;
+    }
+  } else if (event == "closed") {
+    ++socket_closes_;
+  } else if (event == "failed") {
+    ++socket_failures_;
+  }
+}
+
+void RecordingSummary::NoteCapHit(std::string what) {
+  caps_hit_.push_back(std::move(what));
+}
+
+void RecordingSummary::NoteGap(std::string why) {
+  gaps_.push_back(std::move(why));
+}
+
+std::string RecordingSummary::Render(
+    const std::string& ended_reason,
+    base::Time started,
+    base::Time ended,
+    uint64_t total_bytes,
+    const std::map<std::string, int>& mask_counts,
+    const std::vector<std::string>& mask_skipped) const {
+  std::string out = "# Recording\n\n";
+  base::StrAppend(
+      &out, {"Level: ", level_.empty() ? "network" : level_,
+             ". Ended: ", ended_reason, ".\n", "Started ",
+             base::TimeFormatAsIso8601(started), ", ended ",
+             base::TimeFormatAsIso8601(ended), ", ", HumanBytes(total_bytes),
+             " in all, ", base::NumberToString(entry_count_), " entries.\n"});
+
+  if (!pages_.empty()) {
+    out += "\n## Pages\n";
+    for (const Page& page : pages_) {
+      const std::string title =
+          page.title.empty() ? std::string("(untitled)") : page.title;
+      base::StrAppend(&out, {"- ", title, " - ", page.url, "\n"});
+    }
+  }
+
+  if (!host_counts_.empty()) {
+    // Hosts, most requests first.
+    std::vector<std::pair<std::string, int>> hosts(host_counts_.begin(),
+                                                   host_counts_.end());
+    std::sort(hosts.begin(), hosts.end(),
+              [](const auto& a, const auto& b) { return a.second > b.second; });
+    out += "\n## Hosts\n";
+    for (const auto& [host, count] : hosts) {
+      base::StrAppend(&out,
+                      {"- ", host, ": ", base::NumberToString(count), "\n"});
+    }
+  }
+
+  out += "\n## Failures and blocks\n";
+  if (failures_.empty()) {
+    out += "None.\n";
+  } else {
+    for (const EntryLine& line : failures_) {
+      base::StrAppend(&out, {LineText(line), "\n"});
+    }
+  }
+
+  if (!largest_.empty()) {
+    out += "\n## Largest bodies\n";
+    for (const EntryLine& line : largest_) {
+      base::StrAppend(&out, {"- #", base::NumberToString(line.number), " ",
+                             HumanBytes(line.body_bytes), " ", line.method, " ",
+                             line.url, "\n"});
+    }
+  }
+
+  if (level_ == "full") {
+    out += "\n## Scripts\n";
+    if (script_count_ == 0) {
+      out += "None compiled while recording.\n";
+    } else {
+      base::StrAppend(
+          &out,
+          {base::NumberToString(script_count_), " compiled, ",
+           base::NumberToString(script_unique_), " distinct, ",
+           HumanBytes(script_bytes_),
+           " under scripts/. scripts.json says which document compiled "
+           "which; a script compiled before the recording began is not in "
+           "it.\n"});
+      out += "By kind:\n";
+      for (const auto& [kind, count] : script_kinds_) {
+        base::StrAppend(&out,
+                        {"- ", kind, ": ", base::NumberToString(count), "\n"});
+      }
+      std::vector<std::pair<std::string, int>> documents(
+          script_documents_.begin(), script_documents_.end());
+      std::stable_sort(
+          documents.begin(), documents.end(),
+          [](const auto& a, const auto& b) { return a.second > b.second; });
+      if (documents.size() > kDocumentsListed) {
+        documents.resize(kDocumentsListed);
+      }
+      out += "By document, most first:\n";
+      for (const auto& [document, count] : documents) {
+        base::StrAppend(
+            &out, {"- ", document, ": ", base::NumberToString(count), "\n"});
+      }
+    }
+  }
+
+  if (sockets_ > 0) {
+    out += "\n## Sockets\n";
+    base::StrAppend(
+        &out, {base::NumberToString(sockets_),
+               sockets_ == 1 ? " websocket opened, " : " websockets opened, ",
+               base::NumberToString(frames_sent_), " frames sent, ",
+               base::NumberToString(frames_received_), " received, ",
+               base::NumberToString(socket_closes_), " closed, ",
+               base::NumberToString(socket_failures_),
+               " failed. Every event is a line in sockets.ndjson.\n"});
+    for (const auto& [host, count] : socket_hosts_) {
+      base::StrAppend(&out,
+                      {"- ", host, ": ", base::NumberToString(count), "\n"});
+    }
+  }
+
+  out += "\n## Masked\n";
+  if (mask_counts.empty()) {
+    out += "Nothing matched.\n";
+  } else {
+    for (const auto& [label, count] : mask_counts) {
+      base::StrAppend(&out,
+                      {"- ", label, ": ", base::NumberToString(count), "\n"});
+    }
+  }
+  if (!mask_skipped.empty()) {
+    // Named whether or not they were typed: a value this short is not looked
+    // for at all, and a reader should know what the files would not hide.
+    base::StrAppend(&out, {"Not searched for, too short to mask safely: ",
+                           base::JoinString(mask_skipped, ", "), ".\n"});
+  }
+
+  if (!caps_hit_.empty() || !gaps_.empty()) {
+    out += "\n## Notes\n";
+    for (const std::string& what : caps_hit_) {
+      base::StrAppend(&out, {"- cap hit: ", what, "\n"});
+    }
+    for (const std::string& why : gaps_) {
+      base::StrAppend(&out, {"- gap: ", why, "\n"});
+    }
+  }
+
+  return out;
+}
