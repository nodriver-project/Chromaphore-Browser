@@ -0,0 +1,92 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_SUMMARY_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_SUMMARY_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+
+// browser: accumulates the facts summary.md needs as entries complete, and
+// renders the markdown a reader opens first: the pages, the hosts and their
+// counts, every failing or >=400 response, the largest bodies, the scripts at
+// the full level, what was masked (labels and counts, never values) and how
+// the recording ended. It holds no bodies, no header values and no script
+// text. On the recording's file sequence.
+class RecordingSummary {
+ public:
+  RecordingSummary();
+  RecordingSummary(const RecordingSummary&) = delete;
+  RecordingSummary& operator=(const RecordingSummary&) = delete;
+  ~RecordingSummary();
+
+  // One line's worth of an entry: what the summary ranks and lists by.
+  struct EntryLine {
+    uint64_t number = 0;
+    std::string method;
+    int status = 0;
+    std::string url;
+    std::string host;
+    int net_error = 0;
+    uint64_t body_bytes = 0;  // response body, decoded
+  };
+
+  void SetLevel(std::string level);
+  void AddPage(std::string url, std::string title);
+  void AddEntry(const EntryLine& line);
+  // One script report (full level): its kind, the document that compiled it
+  // (masked already), whether its text was new to the recording, and the
+  // bytes written for it then.
+  void AddScript(const std::string& kind,
+                 const std::string& document,
+                 bool new_text,
+                 uint64_t bytes);
+  // One websocket event, as sockets.ndjson lines them: `event` is open,
+  // handshakeRequest, handshakeResponse, frame, closed or failed; `host` is
+  // the socket's for an open event; `sent` is the frame's direction.
+  void NoteSocket(const std::string& event, const std::string& host, bool sent);
+  void NoteCapHit(std::string what);
+  void NoteGap(std::string why);
+
+  // Renders the markdown, given the masking facts and the ending.
+  std::string Render(const std::string& ended_reason,
+                     base::Time started,
+                     base::Time ended,
+                     uint64_t total_bytes,
+                     const std::map<std::string, int>& mask_counts,
+                     const std::vector<std::string>& mask_skipped) const;
+
+ private:
+  struct Page {
+    std::string url;
+    std::string title;
+  };
+
+  std::string level_;
+  std::vector<Page> pages_;
+  std::map<std::string, int> host_counts_;
+  std::vector<EntryLine> failures_;  // status >= 400, cancelled or net error
+  std::vector<EntryLine> largest_;   // top bodies, kept sorted, trimmed
+  uint64_t entry_count_ = 0;
+  uint64_t script_count_ = 0;
+  uint64_t script_unique_ = 0;
+  uint64_t script_bytes_ = 0;
+  std::map<std::string, int> script_kinds_;
+  std::map<std::string, int> script_documents_;
+  uint64_t sockets_ = 0;
+  uint64_t frames_sent_ = 0;
+  uint64_t frames_received_ = 0;
+  uint64_t socket_closes_ = 0;
+  uint64_t socket_failures_ = 0;
+  std::map<std::string, int> socket_hosts_;
+  std::vector<std::string> caps_hit_;
+  std::vector<std::string> gaps_;
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_RECORDING_SUMMARY_H_
