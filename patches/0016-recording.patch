+
+#ifndef THIRD_PARTY_BLINK_RENDERER_BINDINGS_CORE_V8_SCRIPT_RECORDER_H_
+#define THIRD_PARTY_BLINK_RENDERER_BINDINGS_CORE_V8_SCRIPT_RECORDER_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "v8/include/v8-callbacks.h"
+#include "v8/include/v8-forward.h"
+
+namespace blink {
+
+// browser: reports every script this renderer compiles to the browser, for a
+// traffic recording at the full level. V8Initializer installs it on every
+// isolate, the main thread's and each worker's; the browser turns it on and
+// off for the whole process (content.mojom.Renderer.SetScriptRecording). Off,
+// a compile costs one atomic read. On, each thread reports a script once per
+// document per recording, from the page's own worlds only, over the one pipe
+// to blink.mojom.ScriptRecorderHost, and nothing about how the script runs
+// changes: the engine's compilation caches stay on and no debugger is
+// involved.
+class CORE_EXPORT ScriptRecorder {
+  STATIC_ONLY(ScriptRecorder);
+
+ public:
+  // v8::CompiledScriptCallback: on the isolate's own thread, inside the
+  // engine's compile notification, so it only copies what it is given.
+  static void OnScriptCompiled(v8::Isolate* isolate,
+                               const v8::CompiledScriptInfo& info);
+
+  // The process-wide switch, set on the main thread. Turning it on begins a
+  // new recording: what each thread reported to the last one does not count.
+  static void SetEnabled(bool enabled);
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_BINDINGS_CORE_V8_SCRIPT_RECORDER_H_
