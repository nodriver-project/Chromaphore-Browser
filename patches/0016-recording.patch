+// browser: recording support (recording).
+// The handshake request as a traffic recording wants it: every header as
+// sent (the renderer's copy may drop Cookie and Authorization), the URL
+// copied, since the renderer's copy moves it out.
+mojom::WebSocketHandshakeRequestPtr RecordedHandshakeRequest(
+    const net::WebSocketHandshakeRequestInfo& request) {
+  auto recorded = mojom::WebSocketHandshakeRequest::New();
+  recorded->url = request.url;
+  std::string headers_text =
+      base::StringPrintf("GET %s HTTP/1.1\r\n", request.url.spec().c_str());
+  net::HttpRequestHeaders::Iterator it(request.headers);
+  while (it.GetNext()) {
+    recorded->headers.push_back(mojom::HttpHeader::New(it.name(), it.value()));
+    headers_text.append(base::StringPrintf("%s: %s\r\n", it.name().c_str(),
+                                           it.value().c_str()));
+  }
+  headers_text.append("\r\n");
+  recorded->headers_text = std::move(headers_text);
+  return recorded;
+}
+
+// The handshake response the same way (the renderer's copy may drop the
+// cookie headers; ToMojo moves the URL out).
+mojom::WebSocketHandshakeResponsePtr RecordedHandshakeResponse(
+    const net::WebSocketHandshakeResponseInfo& response,
+    const std::string& selected_protocol,
+    const std::string& extensions) {
+  auto recorded = mojom::WebSocketHandshakeResponse::New();
+  recorded->url = response.url;
+  recorded->status_code = response.headers->response_code();
+  recorded->status_text = response.headers->GetStatusText();
+  recorded->http_version = response.headers->GetHttpVersion();
+  recorded->remote_endpoint = response.remote_endpoint;
+  size_t iter = 0;
+  std::string name, value;
+  std::string headers_text =
+      base::StrCat({response.headers->GetStatusLine(), "\r\n"});
+  while (response.headers->EnumerateHeaderLines(&iter, &name, &value)) {
+    recorded->headers.push_back(mojom::HttpHeader::New(name, value));
+    base::StrAppend(&headers_text, {name, ": ", value, "\r\n"});
+  }
+  headers_text.append("\r\n");
+  recorded->headers_text = std::move(headers_text);
+  recorded->selected_protocol = selected_protocol;
+  recorded->extensions = extensions;
+  return recorded;
+}
+
