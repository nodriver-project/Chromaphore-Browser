+// found in the LICENSE file.
+
+#ifndef SERVICES_NETWORK_TRAFFIC_RECORDER_H_
+#define SERVICES_NETWORK_TRAFFIC_RECORDER_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <string>
+#include <string_view>
+
+#include "base/component_export.h"
+#include "base/containers/span.h"
+#include "base/memory/weak_ptr.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "net/base/load_timing_info.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/mojom/traffic_recorder.mojom.h"
+
+namespace network {
+
+// The network service's end of a traffic recording. It holds the browser
+// process's TrafficRecorderClient and the caps, and hands out the ids that
+// tie one load's or one socket's reports together. NetworkService owns the
+// one instance, from StartTrafficRecording to StopTrafficRecording; loaders
+// and sockets hold it by weak pointer and report through client(). It copies
+// what the service already has and changes nothing about a load.
+class COMPONENT_EXPORT(NETWORK_SERVICE) TrafficRecorder final {
+ public:
+  TrafficRecorder(mojo::PendingRemote<mojom::TrafficRecorderClient> client,
+                  mojom::TrafficRecordingOptionsPtr options);
+  TrafficRecorder(const TrafficRecorder&) = delete;
+  TrafficRecorder& operator=(const TrafficRecorder&) = delete;
+  ~TrafficRecorder();
+
+  // True while reports can still reach the browser process: not finished,
+  // and the browser has not dropped its end.
+  bool recording() const;
+  const mojom::TrafficRecordingOptions& options() const { return *options_; }
+  // The browser's end; meaningful only while recording().
+  mojom::TrafficRecorderClient* client() { return client_.get(); }
+
+  // A load begins: its id, which every later report on it carries. Never 0.
+  uint64_t BeginLoad();
+  // A chunk of a load's request or response body, as the service read or
+  // sent it. `text` picks the cap; past it nothing more of that body crosses,
+  // while its byte count goes on.
+  void RequestBodyChunk(uint64_t id,
+                        base::span<const uint8_t> bytes,
+                        bool text);
+  void ResponseBodyChunk(uint64_t id,
+                         base::span<const uint8_t> bytes,
+                         bool text);
+  // The load ended with the status its client got.
+  void CompleteLoad(uint64_t id,
+                    const URLLoaderCompletionStatus& status,
+                    const net::LoadTimingInfo& load_timing);
+  // The loader went away without a completion: one is synthesized, once.
+  void AbandonLoad(uint64_t id, int net_error);
+
+  // A websocket opens: `open` gets its id, which every later report on it
+  // carries, and is reported. Returns that id; 0 when nothing is recording.
+  uint64_t BeginSocket(mojom::RecordedSocketOpenPtr open);
+  // The handshake as sent, and the server's answer to it.
+  void SocketHandshakeRequest(uint64_t id,
+                              mojom::WebSocketHandshakeRequestPtr request);
+  void SocketHandshakeResponse(uint64_t id,
+                               mojom::WebSocketHandshakeResponsePtr response);
+  // One frame, sent or received: the payload is cut at the frame cap, its
+  // real length kept.
+  void SocketFrame(uint64_t id,
+                   bool sent,
+                   bool fin,
+                   int opcode,
+                   base::span<const uint8_t> payload);
+  // The socket's end: a close, or a failure (response_code 0 when no response
+  // came).
+  void SocketClosed(uint64_t id,
+                    bool was_clean,
+                    uint16_t code,
+                    const std::string& reason);
+  void SocketFailed(uint64_t id,
+                    const std::string& message,
+                    int net_error,
+                    int response_code);
+
+  // The browser asked to stop: the loads in flight get synthesized
+  // completions, then the client pipe closes; nothing is reported after this.
+  void Finish();
+
+  base::WeakPtr<TrafficRecorder> GetWeakPtr();
+
