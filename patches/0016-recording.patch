+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/network/traffic_recorder_upload_stream.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "net/base/io_buffer.h"
+#include "net/base/net_errors.h"
+#include "net/log/net_log_with_source.h"
+#include "services/network/traffic_recorder.h"
+
+namespace network {
+
+TrafficRecorderUploadStream::TrafficRecorderUploadStream(
+    std::unique_ptr<net::UploadDataStream> inner,
+    base::WeakPtr<TrafficRecorder> recorder,
+    uint64_t loader_id,
+    bool text)
+    : net::UploadDataStream(inner->is_chunked(),
+                            inner->has_null_source(),
+                            inner->identifier()),
+      inner_(std::move(inner)),
+      recorder_(std::move(recorder)),
+      loader_id_(loader_id),
+      text_(text) {}
+
+TrafficRecorderUploadStream::~TrafficRecorderUploadStream() = default;
+
+bool TrafficRecorderUploadStream::IsInMemory() const {
+  return inner_->IsInMemory();
+}
+
+const std::vector<std::unique_ptr<net::UploadElementReader>>*
+TrafficRecorderUploadStream::GetElementReaders() const {
+  return inner_->GetElementReaders();
+}
+
+bool TrafficRecorderUploadStream::AllowHTTP1() const {
+  return inner_->AllowHTTP1();
+}
+
+int TrafficRecorderUploadStream::InitInternal(
+    const net::NetLogWithSource& net_log) {
+  pending_buffer_.reset();
+  pass_offset_ = 0;
+  const int result =
+      inner_->Init(base::BindOnce(&TrafficRecorderUploadStream::OnInnerInit,
+                                  base::Unretained(this)),
+                   net_log);
+  if (result == net::OK && !is_chunked()) {
+    SetSize(inner_->size());
+  }
+  return result;
+}
+
+void TrafficRecorderUploadStream::OnInnerInit(int result) {
+  if (result == net::OK && !is_chunked()) {
+    SetSize(inner_->size());
+  }
+  OnInitCompleted(result);
+}
+
+int TrafficRecorderUploadStream::ReadInternal(net::IOBuffer* buf, int buf_len) {
+  pending_buffer_ = buf;
+  const int result =
+      inner_->Read(buf, buf_len,
+                   base::BindOnce(&TrafficRecorderUploadStream::OnInnerRead,
+                                  base::Unretained(this)));
+  if (result == net::ERR_IO_PENDING) {
+    return result;
+  }
+  return Recorded(result);
+}
+
+void TrafficRecorderUploadStream::OnInnerRead(int result) {
+  OnReadCompleted(Recorded(result));
+}
+
+int TrafficRecorderUploadStream::Recorded(int result) {
+  scoped_refptr<net::IOBuffer> buffer = std::move(pending_buffer_);
+  if (is_chunked() && inner_->IsEOF()) {
+    SetIsFinalChunk();
+  }
+  if (result > 0 && buffer) {
+    const uint64_t begin = pass_offset_;
+    pass_offset_ += static_cast<uint64_t>(result);
+    if (recorder_ && pass_offset_ > reported_) {
+      // On a replay pass the leading bytes are already reported; send only
+      // the part past the high-water mark (all of it on the first pass).
+      const size_t skip =
+          begin < reported_ ? static_cast<size_t>(reported_ - begin) : 0;
+      recorder_->RequestBodyChunk(
+          loader_id_, buffer->first(static_cast<size_t>(result)).subspan(skip),
+          text_);
+      reported_ = pass_offset_;
+    }
+  }
+  return result;
+}
+
+void TrafficRecorderUploadStream::ResetInternal() {
+  pending_buffer_.reset();
+  pass_offset_ = 0;
+  inner_->Reset();
+}
+
+}  // namespace network
