+}  // namespace
+
+// One tab the recording has seen navigate. The title a page reports comes
+// after the navigation that began the page, so each is sent on as it arrives,
+// for the page the tab's primary main frame is on at that moment: a prerender
+// in the same tab has a page host of its own and must not take the tab's
+// titles, and the id a page host carries is this very token.
+class Recording::TabWatcher : public content::WebContentsObserver {
+ public:
+  TabWatcher(content::WebContents* web_contents, Recording* recording)
+      : content::WebContentsObserver(web_contents), recording_(recording) {}
+
+  // Whether the tab is gone; the owner drops a watcher that says so.
+  bool gone() const { return gone_; }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    content::WebContents* contents = web_contents();
+    if (!contents || !handle || !handle->IsInPrimaryMainFrame() ||
+        !handle->HasCommitted()) {
+      return;
+    }
+    content::RenderFrameHost* main_frame = contents->GetPrimaryMainFrame();
+    if (!main_frame) {
+      return;
+    }
+    RecordingPage page;
+    page.id = main_frame->GetDevToolsFrameToken().ToString();
+    page.url = handle->GetURL().spec();
+    page.title = base::UTF16ToUTF8(contents->GetTitle());
+    page.started = base::Time::Now();
+    // A same-document navigation, a page back from the cache or a prerender
+    // activated have no document load of their own to wait for.
+    const bool has_own_load = !handle->IsSameDocument() &&
+                              !handle->IsServedFromBackForwardCache() &&
+                              !handle->IsPrerenderedPageActivation();
+    recording_->OnPage(std::move(page), has_own_load);
+  }
+  void TitleWasSet(content::NavigationEntry* entry) override {
+    content::WebContents* contents = web_contents();
+    // Only the committed entry's title is the page's: a pending entry shows
+    // its URL, and an entry of a prerender is not this tab's.
+    if (!contents || !entry ||
+        entry != contents->GetController().GetLastCommittedEntry()) {
+      return;
+    }
+    content::RenderFrameHost* main_frame = contents->GetPrimaryMainFrame();
+    if (!main_frame) {
+      return;
+    }
+    recording_->OnTitle(main_frame->GetDevToolsFrameToken().ToString(),
+                        base::UTF16ToUTF8(entry->GetTitle()));
+  }
+  void WebContentsDestroyed() override {
+    gone_ = true;
+    Observe(nullptr);
+  }
+
+ private:
+  const raw_ptr<Recording> recording_;
+  bool gone_ = false;
+};
+
+Recording::Recording(base::FilePath dir,
+                     std::string level,
+                     Caps caps,
+                     base::OnceCallback<void(std::string reason)> request_end)
+    : dir_(std::move(dir)),
+      level_(std::move(level)),
+      caps_(caps),
+      request_end_(std::move(request_end)) {}
+
+Recording::~Recording() {
+  if (observing_hosts_) {
+    content::DevToolsAgentHost::RemoveObserver(this);
+  }
+}
+
+void Recording::Open() {
+  origin_ = base::TimeTicks::Now();
+  writer_ = base::SequenceBound<RecordingHarWriter>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN}),
+      dir_, level_);
+  writer_.AsyncCall(&RecordingHarWriter::Open)
+      .Then(base::BindOnce(&Recording::OnOpened, weak_factory_.GetWeakPtr()));
+  content::DevToolsAgentHost::AddObserver(this);
+  observing_hosts_ = true;
+}
+
+void Recording::OnOpened(bool ok) {
+  if (!ok) {
+    AskEnd("error");
+  }
+}
+
+mojo::PendingRemote<network::mojom::TrafficRecorderClient>
+Recording::BindClient(base::OnceClosure on_lost) {
+  mojo::PendingRemote<network::mojom::TrafficRecorderClient> remote =
+      receiver_.BindNewPipeAndPassRemote();
+  receiver_.set_disconnect_handler(std::move(on_lost));
+  return remote;
+}
+
+network::mojom::TrafficRecordingOptionsPtr Recording::MakeOptions() const {
+  auto options = network::mojom::TrafficRecordingOptions::New();
+  options->max_text_body_bytes = caps_.max_text_body_bytes;
+  options->max_binary_body_bytes = caps_.max_binary_body_bytes;
+  options->max_frame_bytes = caps_.max_frame_bytes;
+  return options;
+}
+
+void Recording::AddMask(const std::string& value, const std::string& label) {
+  writer_.AsyncCall(&RecordingHarWriter::AddMask).WithArgs(value, label);
+}
+
+void Recording::AskEnd(std::string reason) {
+  if (!request_end_) {
+    return;
+  }
+  // Never from inside a report's own dispatch, and never once this recording
+  // is gone: by then the owner may hold the next one.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<Recording> recording,
+             base::OnceCallback<void(std::string reason)> request_end,
+             std::string reason) {
+            if (recording) {
+              std::move(request_end).Run(std::move(reason));
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(request_end_),
+          std::move(reason)));
+}
+
+void Recording::CountBytes(size_t bytes) {
+  const uint64_t before = total_bytes_;
+  total_bytes_ += bytes;
+  if (before <= caps_.max_total_bytes && total_bytes_ > caps_.max_total_bytes) {
+    AskEnd("sizeCap");
+  }
+}
+
+Recording::Load* Recording::Find(uint64_t loader_id) {
+  auto it = loads_.find(loader_id);
+  return it == loads_.end() ? nullptr : &it->second;
+}
+
+void Recording::Emit(uint64_t loader_id) {
+  auto it = loads_.find(loader_id);
+  if (it == loads_.end()) {
+    return;
+  }
+  ++entry_count_;
+  writer_.AsyncCall(&RecordingHarWriter::AddEntry)
+      .WithArgs(std::move(it->second.entry));
+  loads_.erase(it);
+}
+
+void Recording::OnScript(int process_id,
+                         blink::mojom::RecordedScriptPtr script) {
+  if (finished_ || !script) {
+    return;
+  }
+  ++script_count_;
+  // Counted as it arrived, as bodies are. What reaches disk is one file per
+  // distinct text, so the total errs towards ending sooner.
+  CountBytes(script->source.size() + script->wasm_bytes.size());
+  writer_.AsyncCall(&RecordingHarWriter::AddScript)
+      .WithArgs(process_id, std::move(script));
+}
+
+void Recording::Finish(std::string reason, base::OnceClosure done) {
+  if (finished_) {
+    std::move(done).Run();
+    return;
+  }
+  finished_ = true;
+  receiver_.reset();
+  if (observing_hosts_) {
+    content::DevToolsAgentHost::RemoveObserver(this);
+    observing_hosts_ = false;
+  }
+  watchers_.clear();
+  // The loads still in flight: what they have, marked as not their own
+  // completion.
+  while (!loads_.empty()) {
+    const auto first = loads_.begin();
+    RecordingEntry& entry = first->second.entry;
+    entry.synthesized = true;
+    entry.has_request_body = !entry.request_body.empty();
+    entry.has_response_body = !entry.response_body.empty();
+    Emit(first->first);
+  }
+  writer_.AsyncCall(&RecordingHarWriter::Finish)
+      .WithArgs(std::move(reason), base::Time::Now(), total_bytes_)
+      .Then(std::move(done));
+}
+
+// --------------------------------------------------------------- loads
+
+void Recording::OnRequest(network::mojom::RecordedRequestPtr request) {
+  if (finished_ || !request) {
+    return;
+  }
+  Load& load = loads_[request->loader_id];
+  load.started = request->started;
+  RecordingEntry& entry = load.entry;
+  entry.number = ++next_number_;
+  entry.method = request->method;
+  entry.url = request->url.spec();
+  entry.initiator = OriginText(request->initiator);
+  entry.top_origin = OriginText(request->top_frame_origin);
+  entry.frame_origin = OriginText(request->frame_origin);
+  entry.destination = network::RequestDestinationToString(request->destination);
+  entry.process_id = request->process_id;
+  entry.wall_started = request->wall_started;
+  entry.has_request_body = request->has_body;
+  if (request->frame) {
+    entry.frame_token = TokenText(request->frame->frame_token);
+    entry.tab_token = TokenText(request->frame->tab_token);
+    entry.worker_kind = request->frame->worker_kind;
+    if (request->frame->worker_url) {
+      entry.worker_url = request->frame->worker_url->spec();
+    }
+  }
+  // A navigation carries its local root's devtools token instead of a tag.
+  if (entry.tab_token.empty()) {
+    entry.tab_token = TokenText(request->throttling_profile_id);
+  }
+}
+
+void Recording::OnRequestHeaders(
+    uint64_t loader_id,
+    const std::string& request_line,
+    std::vector<network::mojom::HttpHeaderPtr> headers) {
+  Load* load = Find(loader_id);
+  if (finished_ || !load) {
+    return;
+  }
+  // The headers of this hop replace the last hop's.
+  load->entry.request_headers.clear();
+  for (const network::mojom::HttpHeaderPtr& header : headers) {
+    load->entry.request_headers.push_back({header->name, header->value});
+  }
+  const std::string_view line =
+      base::TrimWhitespaceASCII(request_line, base::TRIM_ALL);
+  const size_t space = line.rfind(' ');
+  if (space != std::string_view::npos) {
+    load->entry.http_version = std::string(line.substr(space + 1));
+  }
+}
+
+void Recording::OnRequestBody(uint64_t loader_id,
+                              const std::vector<uint8_t>& chunk) {
+  Load* load = Find(loader_id);
+  if (finished_ || !load) {
+    return;
+  }
+  AppendBody(load->entry.request_body, chunk, caps_);
+  CountBytes(chunk.size());
+}
+
+void Recording::OnRedirect(uint64_t loader_id,
+                           const net::RedirectInfo& redirect_info,
+                           network::mojom::URLResponseHeadPtr head,
+                           std::vector<network::mojom::HttpHeaderPtr> headers) {
+  Load* load = Find(loader_id);
+  if (finished_ || !load) {
+    return;
+  }
+  RecordingEntry::Redirect hop;
+  hop.url = load->entry.url;
+  if (head && head->headers) {
+    hop.status = head->headers->response_code();
+  }
+  // The hop's header lines as received, Set-Cookie included.
+  for (const network::mojom::HttpHeaderPtr& header : headers) {
+    hop.headers.push_back({header->name, header->value});
+  }
+  load->entry.redirects.push_back(std::move(hop));
+  // The load goes on under the same id, to the new URL.
+  load->entry.url = redirect_info.new_url.spec();
+}
+
+void Recording::OnResponseHeaders(
+    uint64_t loader_id,
+    network::mojom::URLResponseHeadPtr head,
+    std::vector<network::mojom::HttpHeaderPtr> headers) {
+  Load* load = Find(loader_id);
+  if (finished_ || !load || !head) {
+    return;
+  }
+  RecordingEntry& entry = load->entry;
+  if (head->headers) {
+    entry.status = head->headers->response_code();
+    entry.status_text = head->headers->GetStatusText();
+  }
+  // The header lines as received, Set-Cookie included: the head's own copy
+  // lost its cookie lines on the way here.
+  entry.response_headers.clear();
+  for (const network::mojom::HttpHeaderPtr& header : headers) {
+    entry.response_headers.push_back({header->name, header->value});
+  }
+  entry.mime_type = head->mime_type;
+  entry.remote_ip = head->remote_endpoint.ToString();
+  entry.protocol =
+      head->alpn_negotiated_protocol.empty()
+          ? std::string(net::HttpConnectionInfoToString(head->connection_info))
+          : head->alpn_negotiated_protocol;
+  entry.from_cache = head->was_fetched_via_cache;
+  if (head->cert_status != 0) {
+    entry.tls = base::StringPrintf("cert status 0x%08x", head->cert_status);
+  }
+  if (entry.http_version.empty()) {
+    entry.http_version = entry.protocol;
+  }
+}
+
+void Recording::OnResponseBody(uint64_t loader_id,
+                               const std::vector<uint8_t>& chunk) {
+  Load* load = Find(loader_id);
+  if (finished_ || !load) {
+    return;
+  }
+  AppendBody(load->entry.response_body, chunk, caps_);
+  CountBytes(chunk.size());
+}
+
+void Recording::OnComplete(uint64_t loader_id,
+                           network::mojom::RecordedCompletionPtr completion) {
+  Load* load = Find(loader_id);
+  if (finished_ || !load || !completion) {
+    return;
+  }
+  RecordingEntry& entry = load->entry;
+  entry.request_body_bytes = completion->request_body_bytes;
+  entry.request_body_truncated = completion->request_body_truncated;
+  entry.response_body_bytes = completion->response_body_bytes;
+  entry.response_body_truncated = completion->response_body_truncated;
+  entry.synthesized = completion->synthesized;
+  entry.net_error = completion->status.error_code;
+  entry.has_request_body = !entry.request_body.empty();
+  entry.has_response_body = !entry.response_body.empty();
+  const base::TimeTicks end = completion->status.completion_time;
+  if (!load->started.is_null() && !end.is_null() && end >= load->started) {
+    entry.duration_ms = (end - load->started).InMillisecondsF();
+  }
+  Emit(loader_id);
+}
+
+// ------------------------------------------------------------- websockets
+
+void Recording::OnSocketOpened(network::mojom::RecordedSocketOpenPtr open) {
+  if (finished_ || !open) {
+    return;
+  }
+  base::DictValue event;
+  event.Set("event", "open");
+  event.Set("socket", static_cast<double>(open->socket_id));
+  event.Set("atMs", SinceStart(origin_, open->started));
+  event.Set("url", open->url.spec());
+  event.Set("initiator", OriginText(open->initiator));
+  event.Set("top", OriginText(open->top_frame_origin));
+  event.Set("frame", OriginText(open->frame_origin));
+  event.Set("process", open->process_id);
+  event.Set("tab", TokenText(open->throttling_profile_id));
+  writer_.AsyncCall(&RecordingHarWriter::AddSocketEvent)
+      .WithArgs(std::move(event));
+}
+
+void Recording::OnSocketHandshakeRequest(
+    uint64_t socket_id,
+    network::mojom::WebSocketHandshakeRequestPtr request) {
+  if (finished_ || !request) {
+    return;
+  }
+  base::DictValue event;
+  event.Set("event", "handshakeRequest");
+  event.Set("socket", static_cast<double>(socket_id));
+  event.Set("url", request->url.spec());
+  event.Set("headers", HeaderList(request->headers));
+  writer_.AsyncCall(&RecordingHarWriter::AddSocketEvent)
+      .WithArgs(std::move(event));
+}
+
+void Recording::OnSocketHandshakeResponse(
+    uint64_t socket_id,
+    network::mojom::WebSocketHandshakeResponsePtr response) {
+  if (finished_ || !response) {
+    return;
+  }
+  base::DictValue event;
+  event.Set("event", "handshakeResponse");
+  event.Set("socket", static_cast<double>(socket_id));
+  event.Set("url", response->url.spec());
+  event.Set("status", response->status_code);
+  event.Set("statusText", response->status_text);
+  event.Set("headers", HeaderList(response->headers));
+  event.Set("protocol", response->selected_protocol);
+  event.Set("extensions", response->extensions);
+  writer_.AsyncCall(&RecordingHarWriter::AddSocketEvent)
+      .WithArgs(std::move(event));
+}
+
+void Recording::OnSocketFrame(uint64_t socket_id,
+                              base::TimeTicks at,
+                              bool sent,
+                              bool fin,
+                              int32_t opcode,
+                              const std::vector<uint8_t>& payload,
+                              uint64_t payload_bytes,
+                              bool truncated) {
+  if (finished_) {
+    return;
+  }
+  // A continuation frame (opcode 0) is text or binary as the message it
+  // continues is; one with no message before it counts as text.
+  const std::pair<uint64_t, bool> message(socket_id, sent);
+  int32_t message_opcode = opcode;
+  if (opcode == kOpCodeContinuation) {
+    const auto begun = socket_messages_.find(message);
+    message_opcode =
+        begun == socket_messages_.end() ? kOpCodeText : begun->second;
+  }
+  if (fin) {
+    socket_messages_.erase(message);
+  } else {
+    socket_messages_[message] = message_opcode;
+  }
+  // The service cuts a payload at the frame cap before it crosses; one past
+  // it is held to the cap here as well.
+  const size_t kept = static_cast<size_t>(
+      std::min<uint64_t>(payload.size(), caps_.max_frame_bytes));
+  base::DictValue event;
+  event.Set("event", "frame");
+  event.Set("socket", static_cast<double>(socket_id));
+  event.Set("atMs", SinceStart(origin_, at));
+  event.Set("sent", sent);
+  event.Set("fin", fin);
+  event.Set("opcode", opcode);
+  event.Set("bytes", static_cast<double>(payload_bytes));
+  const bool cut = truncated || kept < payload.size();
+  if (cut) {
+    event.Set("truncated", true);
+  }
+  std::string_view bytes(reinterpret_cast<const char*>(payload.data()), kept);
+  if (message_opcode == kOpCodeText) {
+    if (cut) {
+      // A text frame cut at the cap ends at its last whole character: at the
+      // frame's own length, TruncateUTF8ToByteSize drops a partial last one.
+      bytes = base::TruncateUTF8ToByteSize(bytes, bytes.size());
+    }
+    event.Set("text", std::string(bytes));
+  } else {
+    event.Set("base64", base::Base64Encode(bytes));
+  }
+  writer_.AsyncCall(&RecordingHarWriter::AddSocketEvent)
+      .WithArgs(std::move(event));
+  CountBytes(payload.size());
+}
+
+void Recording::OnSocketClosed(uint64_t socket_id,
+                               base::TimeTicks at,
+                               bool was_clean,
+                               uint16_t code,
+                               const std::string& reason) {
+  if (finished_) {
+    return;
+  }
+  socket_messages_.erase(std::make_pair(socket_id, false));
+  socket_messages_.erase(std::make_pair(socket_id, true));
+  base::DictValue event;
+  event.Set("event", "closed");
+  event.Set("socket", static_cast<double>(socket_id));
+  event.Set("atMs", SinceStart(origin_, at));
+  event.Set("clean", was_clean);
+  event.Set("code", static_cast<int>(code));
+  event.Set("reason", reason);
+  writer_.AsyncCall(&RecordingHarWriter::AddSocketEvent)
+      .WithArgs(std::move(event));
+}
+
+void Recording::OnSocketFailed(uint64_t socket_id,
+                               base::TimeTicks at,
+                               const std::string& message,
+                               int32_t net_error,
+                               int32_t response_code) {
+  if (finished_) {
+    return;
+  }
+  socket_messages_.erase(std::make_pair(socket_id, false));
+  socket_messages_.erase(std::make_pair(socket_id, true));
+  base::DictValue event;
+  event.Set("event", "failed");
+  event.Set("socket", static_cast<double>(socket_id));
+  event.Set("atMs", SinceStart(origin_, at));
+  event.Set("message", message);
+  event.Set("netError", net_error);
+  event.Set("status", response_code);
+  writer_.AsyncCall(&RecordingHarWriter::AddSocketEvent)
+      .WithArgs(std::move(event));
+}
+
+// ------------------------------------------------------------------ pages
+
+bool Recording::ShouldForceDevToolsAgentHostCreation() {
+  return false;
+}
+
+void Recording::DevToolsAgentHostNavigated(content::DevToolsAgentHost* host) {
+  if (finished_ || !host ||
+      host->GetType() != content::DevToolsAgentHost::kTypePage) {
+    return;
+  }
+  // The tab's watcher reports its pages, this navigation included: this
+  // notification comes from inside the tab's own navigation dispatch, and an
+  // observer added during that dispatch is notified by it too, so a watcher
+  // made here hears of the very navigation that made it. The watcher knows a
+  // same-document navigation or a restored page from one with a load of its
+  // own, and keys the page by the frame's token, which this host's id is not
+  // after a prerender was activated.
+  content::WebContents* web_contents = host->GetWebContents();
+  std::erase_if(watchers_,
+                [](const auto& entry) { return entry.second->gone(); });
+  if (web_contents) {
+    if (!watchers_.contains(web_contents)) {
+      watchers_[web_contents] =
+          std::make_unique<TabWatcher>(web_contents, this);
+    }
+    return;
+  }
+  // A page host with no tab to watch: registered from what it says, as a
+  // page with a load of its own. The title at this point is usually the URL.
+  RecordingPage page;
+  page.id = host->GetId();
+  page.url = host->GetURL().spec();
+  page.title = host->GetTitle();
+  page.started = base::Time::Now();
+  writer_.AsyncCall(&RecordingHarWriter::AddPage)
+      .WithArgs(std::move(page), /*has_own_load=*/true);
+}
+
+void Recording::OnPage(RecordingPage page, bool has_own_load) {
+  if (finished_) {
+    return;
+  }
+  writer_.AsyncCall(&RecordingHarWriter::AddPage)
+      .WithArgs(std::move(page), has_own_load);
+}
+
+void Recording::OnTitle(const std::string& tab, std::string title) {
+  if (finished_) {
+    return;
+  }
+  writer_.AsyncCall(&RecordingHarWriter::SetPageTitle)
+      .WithArgs(tab, std::move(title));
+}
