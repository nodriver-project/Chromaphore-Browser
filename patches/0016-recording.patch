+// browser: the traffic recording (recording).
+void NetworkService::StartTrafficRecording(
+    mojo::PendingRemote<mojom::TrafficRecorderClient> client,
+    mojom::TrafficRecordingOptionsPtr options) {
+  // One at a time: a recording still on is dropped, and its client sees the
+  // pipe close.
+  traffic_recorder_ =
+      std::make_unique<TrafficRecorder>(std::move(client), std::move(options));
+}
+
+void NetworkService::StopTrafficRecording(
+    StopTrafficRecordingCallback callback) {
+  // Taken out of the member first, so a loader that starts while the last
+  // reports go out finds no recorder. Finish() reports the loads in flight
+  // and closes the client's pipe: the recording's end, for the browser.
+  std::unique_ptr<TrafficRecorder> recorder = std::move(traffic_recorder_);
+  if (recorder) {
+    recorder->Finish();
+  }
+  std::move(callback).Run();
+}
