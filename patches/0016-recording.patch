+// browser: the recording hooks (recording).
+void WebSocket::RecordFrame(bool sent,
+                            bool fin,
+                            int opcode,
+                            base::span<const uint8_t> payload) {
+  if (recording_id_ && traffic_recorder_) {
+    traffic_recorder_->SocketFrame(recording_id_, sent, fin, opcode, payload);
+  }
+}
+
+void WebSocket::RecordClosed(bool was_clean,
+                             uint16_t code,
+                             const std::string& reason) {
+  if (!recording_id_ || recording_ended_) {
+    return;
+  }
+  recording_ended_ = true;
+  if (traffic_recorder_) {
+    traffic_recorder_->SocketClosed(recording_id_, was_clean, code, reason);
+  }
+}
+
+void WebSocket::RecordFailed(const std::string& message,
+                             int net_error,
+                             int response_code) {
+  if (!recording_id_ || recording_ended_) {
+    return;
+  }
+  recording_ended_ = true;
+  if (traffic_recorder_) {
+    traffic_recorder_->SocketFailed(recording_id_, message, net_error,
+                                    response_code);
+  }
+}
