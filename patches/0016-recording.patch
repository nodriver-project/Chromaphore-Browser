new file mode 100644
index 0000000000..f83f4903ce
--- /dev/null
+++ b/services/network/public/mojom/traffic_recorder.mojom
@@ -0,0 +1,178 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module network.mojom;
+
+import "mojo/public/mojom/base/time.mojom";
+import "mojo/public/mojom/base/unguessable_token.mojom";
+import "services/network/public/mojom/fetch_api.mojom";
+import "services/network/public/mojom/load_timing_info.mojom";
+import "services/network/public/mojom/url_loader.mojom";
+import "services/network/public/mojom/url_loader_completion_status.mojom";
+import "services/network/public/mojom/url_response_head.mojom";
+import "services/network/public/mojom/websocket.mojom";
+import "url/mojom/origin.mojom";
+import "url/mojom/url.mojom";
+
+// A traffic recording. While one is on, the network service reports every
+// load and every websocket it carries, for every process, to the browser
+// process, which writes the recording. Each report is a copy taken where the
+// service already holds the bytes; nothing about a load changes while it
+// records.
+//
+// NetworkService.StartTrafficRecording hands the service a
+// TrafficRecorderClient and the caps; StopTrafficRecording ends it. One
+// recording at a time.
+
+// Caps the service applies before a byte crosses to the browser process. Past
+// a cap the rest of that body or message is not reported, the report says so
+// (truncated), and the sizes reported stay the real ones.
+struct TrafficRecordingOptions {
+  // A body with a text media type: text/*, JSON, XML, JavaScript, form data.
+  uint64 max_text_body_bytes = 4194304;
+  // Every other body.
+  uint64 max_binary_body_bytes = 524288;
+  // One websocket message, sent or received.
+  uint64 max_frame_bytes = 65536;
+};
+
+// Where a load came from, as the browser process tagged the loader factory
+// it was made through. Null for a load whose factory carries no tag, such as
+// a navigation (the browser attributes those by throttling_profile_id).
+struct RecordingFrame {
+  // The requesting frame's devtools frame token; null for a worker.
+  mojo_base.mojom.UnguessableToken? frame_token;
+  // The tab's target id: the outermost main frame's devtools frame token,
+  // which survives navigations.
+  mojo_base.mojom.UnguessableToken? tab_token;
+  // For a worker: "service" for a service worker, "worker" for a dedicated
+  // or shared one; empty for a frame.
+  string worker_kind;
+  // For a worker: its script's URL, when known.
+  url.mojom.Url? worker_url;
+};
+
+// A load as it starts: what is known before the request goes out. loader_id
+// ties every later report on the load to this one.
+struct RecordedRequest {
+  uint64 loader_id;
+  mojo_base.mojom.TimeTicks started;
+  mojo_base.mojom.Time wall_started;
+  string method;
+  url.mojom.Url url;
+  url.mojom.Origin? initiator;
+  url.mojom.Origin? top_frame_origin;
+  url.mojom.Origin? frame_origin;
+  RequestDestination destination;
+  RequestMode mode;
+  CredentialsMode credentials_mode;
+  // The process the loader factory was made for; 0 for the browser.
+  int32 process_id;
+  int32 request_id;
+  bool is_outermost_main_frame;
+  bool originated_from_service_worker;
+  // On a navigation's loader factory, the main frame's devtools token.
+  mojo_base.mojom.UnguessableToken? throttling_profile_id;
+  string? devtools_request_id;
+  RecordingFrame? frame;
+  // The load has a request body; OnRequestBody reports it as it is read.
+  bool has_body;
+};
+
+// How a load ended: the sizes and the timing marks a HAR entry needs.
+struct RecordedCompletion {
+  URLLoaderCompletionStatus status;
+  LoadTimingInfo load_timing;
+  // Request body bytes the HTTP layer read, and whether the reports stopped
+  // at the cap.
+  uint64 request_body_bytes;
+  bool request_body_truncated;
+  // Decoded response body bytes that passed through, and the same.
+  uint64 response_body_bytes;
+  bool response_body_truncated;
+  // True when the loader ended without a completion of its own (a response
+  // the service blocked, a load cancelled before it): status holds what the
+  // service could tell.
+  bool synthesized;
+};
+
+// A websocket as it opens. socket_id ties its later reports to this one.
+struct RecordedSocketOpen {
+  uint64 socket_id;
+  mojo_base.mojom.TimeTicks started;
+  mojo_base.mojom.Time wall_started;
+  url.mojom.Url url;
+  url.mojom.Origin? initiator;
+  url.mojom.Origin? top_frame_origin;
+  url.mojom.Origin? frame_origin;
+  // The process that opened it; 0 for the browser.
+  int32 process_id;
+  // The opening frame's devtools frame token (a worker's devtools token for
+  // a worker), as the browser set it on the connector.
+  mojo_base.mojom.UnguessableToken? throttling_profile_id;
+};
+
+// Implemented by the browser process. The network service calls it as the
+// events happen, in order within one loader_id or socket_id.
+interface TrafficRecorderClient {
+  // A load starts.
+  OnRequest(RecordedRequest request);
+  // The headers actually sent for a hop, Cookie included, and its request
+  // line. Sent once per hop, so again after each OnRedirect.
+  OnRequestHeaders(uint64 loader_id,
+                   string request_line,
+                   array<HttpHeader> headers);
+  // A chunk of the request body as the HTTP layer reads it, up to the cap.
+  OnRequestBody(uint64 loader_id, array<uint8> chunk);
+  // A redirect: the response that caused it and where the load goes next.
+  // The loader_id stays for the next hop. `headers` as for OnResponseHeaders.
+  OnRedirect(uint64 loader_id,
+             URLRequestRedirectInfo redirect_info,
+             URLResponseHead head,
+             array<HttpHeader> headers);
+  // The final response's head: status, media type, remote endpoint, protocol,
+  // cache and TLS facts. `headers` is every header line as received,
+  // Set-Cookie included: the head's own copy loses its cookie lines on the way
+  // to the browser process (net::HttpResponseHeaders::SerializeForMojoIpc).
+  OnResponseHeaders(uint64 loader_id,
+                    URLResponseHead head,
+                    array<HttpHeader> headers);
+  // A chunk of the decoded response body as it is read, up to the cap.
+  OnResponseBody(uint64 loader_id, array<uint8> chunk);
+  // The load ended: the last report for its loader_id.
+  OnComplete(uint64 loader_id, RecordedCompletion completion);
+
+  // A websocket opens.
+  OnSocketOpened(RecordedSocketOpen open);
+  // The opening handshake as sent.
+  OnSocketHandshakeRequest(uint64 socket_id, WebSocketHandshakeRequest request);
+  // The server's answer to the handshake, when it was accepted.
+  OnSocketHandshakeResponse(uint64 socket_id,
+                            WebSocketHandshakeResponse response);
+  // One frame, sent (sent true) or received: whether it ends its message
+  // (fin), the opcode (net::WebSocketFrameHeader::OpCode; 0 continues the
+  // message before it), the payload up to the cap, and the payload's real
+  // length.
+  OnSocketFrame(uint64 socket_id,
+                mojo_base.mojom.TimeTicks at,
+                bool sent,
+                bool fin,
+                int32 opcode,
+                array<uint8> payload,
+                uint64 payload_bytes,
+                bool truncated);
+  // The socket closed: the last report for its socket_id.
+  OnSocketClosed(uint64 socket_id,
+                 mojo_base.mojom.TimeTicks at,
+                 bool was_clean,
+                 uint16 code,
+                 string reason);
+  // The socket failed (a refused handshake, a protocol error): the last
+  // report for its socket_id. response_code is 0 when no response came.
+  OnSocketFailed(uint64 socket_id,
+                 mojo_base.mojom.TimeTicks at,
+                 string message,
+                 int32 net_error,
+                 int32 response_code);
+};
diff --git a/services/network/traffic_recorder.cc b/services/network/traffic_recorder.cc
new file mode 100644
index 0000000000..6074f29ef9
--- /dev/null
+++ b/services/network/traffic_recorder.cc
@@ -0,0 +1,252 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/network/traffic_recorder.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "net/base/net_errors.h"
+#include "services/network/public/mojom/websocket.mojom.h"
+
+namespace network {
+
+namespace {
+
+// Media types whose bodies are text though not text/*, +json or +xml.
+constexpr std::string_view kTextMediaTypes[] = {
+    "application/json",
+    "application/ld+json",
+    "application/manifest+json",
+    "application/x-ndjson",
+    "application/graphql",
+    "application/xml",
+    "application/xhtml+xml",
+    "application/javascript",
+    "application/x-javascript",
+    "application/ecmascript",
+    "application/x-www-form-urlencoded",
+    "multipart/form-data",
+    "image/svg+xml",
+};
+
+}  // namespace
+
+TrafficRecorder::TrafficRecorder(
+    mojo::PendingRemote<mojom::TrafficRecorderClient> client,
+    mojom::TrafficRecordingOptionsPtr options)
+    : client_(std::move(client)), options_(std::move(options)) {
+  if (!options_) {
+    options_ = mojom::TrafficRecordingOptions::New();
+  }
+}
+
+TrafficRecorder::~TrafficRecorder() = default;
+
+bool TrafficRecorder::recording() const {
+  return !finished_ && client_.is_bound() && client_.is_connected();
+}
+
+uint64_t TrafficRecorder::NextId() {
+  return ++last_id_;
+}
+
+uint64_t TrafficRecorder::BeginLoad() {
+  const uint64_t id = NextId();
+  loads_.try_emplace(id);
+  return id;
+}
+
+// static
+base::span<const uint8_t> TrafficRecorder::UnderCap(
+    BodyCount& count,
+    base::span<const uint8_t> bytes,
+    uint64_t cap) {
+  count.bytes += bytes.size();
+  if (count.truncated) {
+    return {};
+  }
+  const uint64_t room = cap > count.reported ? cap - count.reported : 0;
+  if (bytes.size() > room) {
+    count.truncated = true;
+    bytes = bytes.first(static_cast<size_t>(room));
+  }
+  count.reported += bytes.size();
+  return bytes;
+}
+
+void TrafficRecorder::RequestBodyChunk(uint64_t id,
+                                       base::span<const uint8_t> bytes,
+                                       bool text) {
+  auto it = loads_.find(id);
+  if (it == loads_.end()) {
+    return;
+  }
+  const uint64_t cap =
+      text ? options_->max_text_body_bytes : options_->max_binary_body_bytes;
+  const base::span<const uint8_t> part =
+      UnderCap(it->second.request, bytes, cap);
+  if (!part.empty() && recording()) {
+    client_->OnRequestBody(id, std::vector<uint8_t>(part.begin(), part.end()));
+  }
+}
+
+void TrafficRecorder::ResponseBodyChunk(uint64_t id,
+                                        base::span<const uint8_t> bytes,
+                                        bool text) {
+  auto it = loads_.find(id);
+  if (it == loads_.end()) {
+    return;
+  }
+  const uint64_t cap =
+      text ? options_->max_text_body_bytes : options_->max_binary_body_bytes;
+  const base::span<const uint8_t> part =
+      UnderCap(it->second.response, bytes, cap);
+  if (!part.empty() && recording()) {
+    client_->OnResponseBody(id, std::vector<uint8_t>(part.begin(), part.end()));
+  }
+}
+
+void TrafficRecorder::CompleteLoad(uint64_t id,
+                                   const URLLoaderCompletionStatus& status,
+                                   const net::LoadTimingInfo& load_timing) {
+  auto it = loads_.find(id);
+  if (it == loads_.end()) {
+    return;
+  }
+  const LoadState state = it->second;
+  loads_.erase(it);
+  SendCompletion(id, state, status, load_timing, /*synthesized=*/false);
+}
+
+void TrafficRecorder::AbandonLoad(uint64_t id, int net_error) {
+  auto it = loads_.find(id);
+  if (it == loads_.end()) {
+    return;
+  }
+  const LoadState state = it->second;
+  loads_.erase(it);
+  SendCompletion(id, state, URLLoaderCompletionStatus(net_error),
+                 net::LoadTimingInfo(), /*synthesized=*/true);
+}
+
+uint64_t TrafficRecorder::BeginSocket(mojom::RecordedSocketOpenPtr open) {
+  if (!recording()) {
+    return 0;
+  }
+  const uint64_t id = NextId();
+  open->socket_id = id;
+  client_->OnSocketOpened(std::move(open));
+  return id;
+}
+
+void TrafficRecorder::SocketHandshakeRequest(
+    uint64_t id,
+    mojom::WebSocketHandshakeRequestPtr request) {
+  if (recording()) {
+    client_->OnSocketHandshakeRequest(id, std::move(request));
+  }
+}
+
+void TrafficRecorder::SocketHandshakeResponse(
+    uint64_t id,
+    mojom::WebSocketHandshakeResponsePtr response) {
+  if (recording()) {
+    client_->OnSocketHandshakeResponse(id, std::move(response));
+  }
+}
+
+void TrafficRecorder::SocketFrame(uint64_t id,
+                                  bool sent,
+                                  bool fin,
+                                  int opcode,
+                                  base::span<const uint8_t> payload) {
+  if (!recording()) {
+    return;
+  }
+  const uint64_t cap = options_->max_frame_bytes;
+  const bool truncated = payload.size() > cap;
+  const base::span<const uint8_t> part =
+      truncated ? payload.first(static_cast<size_t>(cap)) : payload;
+  client_->OnSocketFrame(id, base::TimeTicks::Now(), sent, fin, opcode,
+                         std::vector<uint8_t>(part.begin(), part.end()),
+                         payload.size(), truncated);
+}
+
+void TrafficRecorder::SocketClosed(uint64_t id,
+                                   bool was_clean,
+                                   uint16_t code,
+                                   const std::string& reason) {
+  if (recording()) {
+    client_->OnSocketClosed(id, base::TimeTicks::Now(), was_clean, code,
+                            reason);
+  }
+}
+
+void TrafficRecorder::SocketFailed(uint64_t id,
+                                   const std::string& message,
+                                   int net_error,
+                                   int response_code) {
+  if (recording()) {
+    client_->OnSocketFailed(id, base::TimeTicks::Now(), message, net_error,
+                            response_code);
+  }
+}
+
+void TrafficRecorder::Finish() {
+  // The loads in flight: what they have, as synthesized completions, before
+  // the pipe closes behind them.
+  const std::map<uint64_t, LoadState> in_flight = std::move(loads_);
+  loads_.clear();
+  for (const auto& [id, state] : in_flight) {
+    SendCompletion(id, state, URLLoaderCompletionStatus(net::ERR_ABORTED),
+                   net::LoadTimingInfo(), /*synthesized=*/true);
+  }
+  finished_ = true;
+  client_.reset();
+}
+
+void TrafficRecorder::SendCompletion(uint64_t id,
+                                     const LoadState& state,
+                                     const URLLoaderCompletionStatus& status,
+                                     const net::LoadTimingInfo& load_timing,
+                                     bool synthesized) {
+  if (!recording()) {
+    return;
+  }
+  auto completion = mojom::RecordedCompletion::New();
+  completion->status = status;
+  completion->load_timing = load_timing;
+  completion->request_body_bytes = state.request.bytes;
+  completion->request_body_truncated = state.request.truncated;
+  completion->response_body_bytes = state.response.bytes;
+  completion->response_body_truncated = state.response.truncated;
+  completion->synthesized = synthesized;
+  client_->OnComplete(id, std::move(completion));
+}
+
+// static
+bool TrafficRecorder::IsTextMedia(std::string_view mime_type) {
+  std::string type = base::ToLowerASCII(mime_type);
+  const size_t parameters = type.find(';');
+  if (parameters != std::string::npos) {
+    type.erase(parameters);
+  }
+  const std::string_view bare = base::TrimWhitespaceASCII(type, base::TRIM_ALL);
+  if (bare.starts_with("text/") || bare.ends_with("+json") ||
+      bare.ends_with("+xml")) {
+    return true;
+  }
+  return std::ranges::contains(kTextMediaTypes, bare);
+}
+
+base::WeakPtr<TrafficRecorder> TrafficRecorder::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+}  // namespace network
