+std::atomic<uint32_t> g_generation{0};
+
+// The one pipe to the browser, bound the first time recording is turned on
+// and shared by every thread after that. A SharedRemote serializes a call on
+// the calling thread and hands the message to the thread it was bound on,
+// here the renderer's IO thread, so a worker's report does not wait behind
+// the main thread's work.
+struct SharedHost {
+  base::Lock lock;
+  mojo::SharedRemote<mojom::blink::ScriptRecorderHost> host;
+};
+
+SharedHost& GetSharedHost() {
+  DEFINE_THREAD_SAFE_STATIC_LOCAL(SharedHost, shared, ());
+  return shared;
+}
+
+// What one thread keeps: its copy of the pipe, and for each script id it has
+// reported in the current recording, the document it last reported it for
+// (DocumentKey). The map's traits take zero as a key and keep the two
+// largest ints for the table, which the engine's script ids, counted up
+// from one, stay below. (Named so as not to meet blink::ThreadState, the
+// heap's.)
+struct RecorderThreadState {
+  mojo::SharedRemote<mojom::blink::ScriptRecorderHost> host;
+  HashMap<int32_t, base::UnguessableToken, IntWithZeroKeyHashTraits<int32_t>>
+      reported;
+  uint32_t generation = 0;
+};
+
+RecorderThreadState& GetThreadState() {
+  DEFINE_THREAD_SAFE_STATIC_LOCAL(ThreadSpecific<RecorderThreadState>, state,
+                                  ());
+  return *state;
+}
+
+// A string the mojom can carry: its string fields are not nullable, and a
+// null WTF::String would fail validation in the browser, which ends the
+// renderer. (Not named Text: that is the DOM node.)
+const String& NonNullText(const String& text) {
+  return text.IsNull() ? g_empty_string : text;
+}
+
+String ValueText(v8::Isolate* isolate, v8::Local<v8::Value> value) {
+  if (value.IsEmpty() || !value->IsString()) {
+    return g_empty_string;
+  }
+  return NonNullText(ToBlinkString<String>(isolate, value.As<v8::String>(),
+                                           kDoNotExternalize));
+}
+
+// A copy of the text, cut at the cap. The engine hands its strings over
+// flat, so reading one allocates nothing on the engine's heap; a string
+// Blink handed the engine as an external one comes back without a copy.
+String SourceText(v8::Isolate* isolate,
+                  v8::Local<v8::String> source,
+                  bool* truncated) {
+  const uint32_t length = static_cast<uint32_t>(source->Length());
+  if (length <= kMaxSourceLength) {
+    *truncated = false;
+    return NonNullText(
+        ToBlinkString<String>(isolate, source, kDoNotExternalize));
+  }
+  *truncated = true;
+  if (source->IsOneByte()) {
+    base::span<LChar> data;
+    String text = String::CreateUninitialized(kMaxSourceLength, data);
+    source->WriteOneByte(isolate, 0, kMaxSourceLength, data.data());
+    return text;
+  }
+  base::span<UChar> data;
+  String text = String::CreateUninitialized(kMaxSourceLength, data);
+  source->Write(isolate, 0, kMaxSourceLength,
+                reinterpret_cast<uint16_t*>(data.data()));
+  return text;
+}
+
+// Whether a document's code is a site's. The browser's own pages, its
+// extensions and DevTools are not what a recording is for.
+bool IsSitePage(const KURL& url) {
+  return !(url.ProtocolIs("chrome") || url.ProtocolIs("chrome-extension") ||
+           url.ProtocolIs("chrome-untrusted") ||
+           url.ProtocolIs("chrome-error") || url.ProtocolIs("chrome-search") ||
+           url.ProtocolIs("devtools"));
+}
+
+// As the recording's loads write a token.
+String TokenText(const base::UnguessableToken& token) {
+  return String(token.ToString().c_str());
+}
+
+// The document a report is for, by a token no other document or global
+// scope takes, even once this one is collected: a window's document's own
+// (the window's is its frame's, the same for every document the frame
+// shows), or a worker's, worklet's or realm's.
+base::UnguessableToken DocumentKey(const ExecutionContext& execution_context) {
+  if (const auto* window = DynamicTo<LocalDOMWindow>(execution_context)) {
+    if (const Document* document = window->document()) {
+      return document->Token().value();
+    }
+  }
+  return execution_context.GetExecutionContextToken().value();
+}
+
+}  // namespace
+
+// static
+void ScriptRecorder::OnScriptCompiled(v8::Isolate* isolate,
+                                      const v8::CompiledScriptInfo& info) {
+  if (!g_enabled.load(std::memory_order_acquire)) {
+    return;
+  }
+  if (!info.is_wasm && info.source.IsEmpty()) {
+    return;
+  }
+  // The engine enters the script's context before it reports; a context that
+  // is not a Blink one (a snapshot template, a context under construction)
+  // has no document and is skipped.
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  if (context.IsEmpty()) {
+    return;
+  }
+  ScriptState* script_state = ScriptState::MaybeFrom(isolate, context);
+  if (!script_state) {
+    return;
+  }
+  // The page's own worlds only. An isolated world holds extension content
+  // scripts and the browser's own helpers, which are not the site's code
+  // and may carry values of their own.
+  const DOMWrapperWorld& world = script_state->World();
+  if (!world.IsMainWorld() && !world.IsWorkerOrWorkletWorld() &&
+      !world.IsShadowRealmWorld()) {
+    return;
+  }
+  ExecutionContext* execution_context = ToExecutionContext(script_state);
+  if (!execution_context) {
+    return;
+  }
+  const KURL& document_url = execution_context->Url();
+  if (!IsSitePage(document_url)) {
+    return;
+  }
+
+  RecorderThreadState& state = GetThreadState();
+  const uint32_t generation = g_generation.load(std::memory_order_acquire);
+  if (state.generation != generation) {
+    // A new recording: what went to the last one does not count, and the
+    // pipe may be newer than this thread's copy.
+    state.generation = generation;
+    state.reported.clear();
+    SharedHost& shared = GetSharedHost();
+    base::AutoLock hold(shared.lock);
+    state.host = shared.host;
+  }
+  if (!state.host.is_bound()) {
+    return;
+  }
+  // The engine reports a script again whenever a cached one is bound to
+  // another context: once per document is a fact worth a line, once per
+  // context on the same document is not. The browser keeps one file per
+  // distinct text either way.
+  const base::UnguessableToken document_key = DocumentKey(*execution_context);
+  auto seen = state.reported.find(info.script_id);
+  if (seen != state.reported.end() && seen->value == document_key) {
+    return;
+  }
+  state.reported.Set(info.script_id, document_key);
+
+  auto script = mojom::blink::RecordedScript::New();
+  script->script_id = info.script_id;
+  script->truncated = false;
+  script->source = g_empty_string;
+  script->frame_token = g_empty_string;
+  script->tab_token = g_empty_string;
+  script->worker_kind = g_empty_string;
+  if (info.is_wasm) {
+    script->kind = "wasm";
+    const size_t length = std::min(info.wasm_wire_bytes_length, kMaxWasmBytes);
+    script->truncated = length < info.wasm_wire_bytes_length;
+    // SAFETY: the engine hands the module's bytes and their length together
+    // and keeps the module alive for the length of this call; `length` is
+    // never more than that length.
+    script->wasm_bytes = Vector<uint8_t>(
+        UNSAFE_BUFFERS(base::span(info.wasm_wire_bytes, length)));
+  } else {
+    script->source = SourceText(isolate, info.source, &script->truncated);
+    script->kind = info.is_eval      ? "eval"
+                   : info.is_module  ? "module"
+                   : info.is_wrapped ? "wrapped"
+                                     : "classic";
+  }
+  script->url = ValueText(isolate, info.name);
+  // A classic script compiled with no name in a window: what DevTools or a
+  // tool evaluates in the page (Runtime.evaluate), and also a page's own
+  // setTimeout("...") string or javascript: URL, which compile the same way.
+  // A page's scripts otherwise carry their URL, inline ones the document's,
+  // so the kind lets a reader set these apart from the page's code.
+  if (script->kind == "classic" && script->url.empty() &&
+      execution_context->IsWindow()) {
+    script->kind = "nameless";
+  }
+  script->source_url = ValueText(isolate, info.source_url);
+  script->source_mapping_url = ValueText(isolate, info.source_mapping_url);
+  script->document_url = NonNullText(document_url.GetString());
+  if (auto* window = DynamicTo<LocalDOMWindow>(execution_context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      script->frame_token = TokenText(frame->GetDevToolsFrameToken());
+      script->tab_token = TokenText(frame->Top()->GetDevToolsFrameToken());
+    }
+  } else if (execution_context->IsServiceWorkerGlobalScope()) {
+    script->worker_kind = "service";
+  } else if (execution_context->IsWorkerGlobalScope()) {
+    script->worker_kind = "worker";
+  } else if (execution_context->IsWorkletGlobalScope()) {
+    script->worker_kind = "worklet";
+  } else if (execution_context->IsShadowRealmGlobalScope()) {
+    script->worker_kind = "shadowrealm";
+  }
+  script->compiled_at = base::Time::Now();
+  state.host->ScriptCompiled(std::move(script));
+}
+
+// static
+void ScriptRecorder::SetEnabled(bool enabled) {
+  if (!enabled) {
+    g_enabled.store(false, std::memory_order_release);
+    return;
+  }
+  {
+    // Bound once, from this (the main) thread, and kept across recordings; a
+    // renderer that was never told to record never asks the browser for it.
+    // It lives on the IO thread so no report waits behind the main thread.
+    SharedHost& shared = GetSharedHost();
+    base::AutoLock hold(shared.lock);
+    if (!shared.host.is_bound()) {
+      mojo::PendingRemote<mojom::blink::ScriptRecorderHost> pending;
+      Platform::Current()->GetBrowserInterfaceBroker()->GetInterface(
+          pending.InitWithNewPipeAndPassReceiver());
+      shared.host.Bind(std::move(pending),
+                       Platform::Current()->GetIOTaskRunner());
+    }
+  }
+  // The pipe is bound before the count moves, and the count before the
+  // switch, so a thread that sees the switch on sees the rest.
+  g_generation.fetch_add(1, std::memory_order_acq_rel);
+  g_enabled.store(true, std::memory_order_release);
+}
+
+}  // namespace blink
