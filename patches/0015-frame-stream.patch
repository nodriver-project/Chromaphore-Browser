+#include "base/win/scoped_handle.h"
+#endif
+
+namespace media {
+class VideoFrame;
+}
+
+namespace content {
+
+class CdpCursorOverlay;
+class DevToolsVideoConsumer;
+
+// browser: Page.startFrameStream. Copies a page's captured frames,
+// uncompressed, into a named shared-memory section that a viewer in another
+// process maps directly, and signals a named event after each one.
+//
+// Page.startScreencast JPEG-encodes every frame and sends it base64 inside a
+// protocol event: about 230 KB of JSON per 1280x720 frame, on the connection
+// the automation itself uses. And however slowly its frames are acknowledged,
+// the capture underneath keeps running at 100 Hz, which on an animated page
+// costs most of a core. Here the capture itself runs at the viewer's rate, and
+// a frame costs one copy.
+//
+// Lives on the UI thread, owned by the PageHandler of the session that started
+// it, so it ends when that session detaches.
+class CONTENT_EXPORT DevToolsFrameStream {
+ public:
+  // The section layout, shared with its reader. Plain
+  // little-endian fields at fixed offsets, described in Page.pdl. A slot's
+  // sequence is odd while the slot is being written, and |latest| names the
+  // newest finished slot as sequence << 2 | slot.
+  struct SlotHeader {
+    uint64_t sequence;
+    uint32_t width;
+    uint32_t height;
+    uint32_t stride;
+    uint32_t reserved;
+    int64_t timestamp_us;
+  };
+  static constexpr int kSlotCount = 3;
+  struct SectionHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t slot_count;
+    uint32_t header_size;
+    uint64_t slot_bytes;
+    uint64_t latest;
+    std::array<SlotHeader, kSlotCount> slots;
+  };
+  static constexpr uint32_t kMagic = 0x4D52464E;  // "NFRM"
+  static constexpr uint32_t kVersion = 1;
+  static constexpr size_t kHeaderSize = 4096;
+  static constexpr int kMaxFps = 60;
+
+  // The page's size in physical pixels; empty while it has none.
+  using SurfaceSizeCallback = base::RepeatingCallback<gfx::Size()>;
+  // The cursor overlay to draw onto frames, or null when none is showing.
+  using CursorCallback = base::RepeatingCallback<CdpCursorOverlay*()>;
+
+  DevToolsFrameStream(SurfaceSizeCallback surface_size, CursorCallback cursor);
+  DevToolsFrameStream(const DevToolsFrameStream&) = delete;
+  DevToolsFrameStream& operator=(const DevToolsFrameStream&) = delete;
+  ~DevToolsFrameStream();
+
+  // Allocates the section and starts capturing |frame_sink_id|. Returns why it
+  // could not, or an empty string once it has started.
+  std::string Start(const viz::FrameSinkId& frame_sink_id,
+                    const gfx::Size& max_size,
+                    int max_fps);
+
+  // New limits for a running stream: a resized viewer, a new frame rate.
+  void Update(const gfx::Size& max_size, int max_fps);
+
+  // Follows the page to a new renderer, as a cross-process navigation does.
+  void SetFrameSinkId(const viz::FrameSinkId& frame_sink_id);
+
+  const std::string& section_name() const { return section_name_; }
+  const std::string& event_name() const { return event_name_; }
+  size_t section_size() const { return view_size_; }
+  const gfx::Size& slot_size() const { return slot_size_; }
+
+ private:
+  void OnFrame(scoped_refptr<media::VideoFrame> frame);
+
+  // Sizes the capture to fit the page within both the viewer's limit and the
+  // slots, never larger than the page.
+  void ApplyLimits();
+
+  void Release();
+
+  const SurfaceSizeCallback surface_size_;
+  const CursorCallback cursor_;
+  std::unique_ptr<DevToolsVideoConsumer> consumer_;
+  // Asks |consumer_| for a frame when the cursor drawn onto them changes.
+  // After it, so that it goes first.
+  base::CallbackListSubscription cursor_changed_;
+
+  gfx::Size max_size_;
+  gfx::Size slot_size_;
+  gfx::Size last_surface_size_;
+  uint64_t frames_ = 0;
+  int last_slot_ = kSlotCount - 1;
+
+  std::string section_name_;
+  std::string event_name_;
+#if BUILDFLAG(IS_WIN)
+  base::win::ScopedHandle mapping_;
+  base::win::ScopedHandle event_;
+#endif
+  // The mapped section. Not heap memory: it is mapped from the file mapping
+  // above and unmapped in Release().
+  raw_ptr<uint8_t> view_ = nullptr;
+  size_t view_size_ = 0;
+  // One slot's bytes, set with |view_size_|. The layout is never read back
+  // from the section: the viewer that maps it can write to it.
+  size_t slot_bytes_ = 0;
+
+  base::WeakPtrFactory<DevToolsFrameStream> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_DEVTOOLS_FRAME_STREAM_H_
