diff --git a/src/ports/fontations/src/hinting.rs b/src/ports/fontations/src/hinting.rs
index 1158e04..4e6c7e3 100644
--- a/src/ports/fontations/src/hinting.rs
+++ b/src/ports/fontations/src/hinting.rs
@@ -111,6 +111,33 @@ pub unsafe fn make_hinting_instance<'a>(
     Box::new(BridgeHintingInstance(hinting_instance))
 }
 
+// browser: as make_hinting_instance in the smooth normal mode, with the
+// symmetric-rendering bit of GETINFO off and the outline left alone across
+// the line, which is how DirectWrite's NATURAL mode runs the instructions.
+pub unsafe fn make_natural_hinting_instance<'a>(
+    outlines: &BridgeOutlineCollection,
+    size: f32,
+    coords: &BridgeNormalizedCoords,
+) -> Box<BridgeHintingInstance> {
+    let hinting_instance = outlines.0.as_ref().and_then(|outlines| {
+        HintingInstance::new(
+            outlines,
+            Size::new(size),
+            &coords.normalized_coords,
+            HintingOptions {
+                engine: Engine::AutoFallback,
+                target: Target::Smooth {
+                    mode: SmoothMode::Normal,
+                    symmetric_rendering: false,
+                    preserve_linear_metrics: true,
+                },
+            },
+        )
+        .ok()
+    });
+    Box::new(BridgeHintingInstance(hinting_instance))
+}
+
 pub unsafe fn make_mono_hinting_instance<'a>(
     outlines: &BridgeOutlineCollection,
     size: f32,
