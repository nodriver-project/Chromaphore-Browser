+    }
+  }
+  void Close() {
+    if (!path_.empty()) {
+      ListedFileSizes::Get().Remove(path_, Owner());
+      path_.clear();
+    }
+  }
+
+ private:
+  uintptr_t Owner() const { return reinterpret_cast<uintptr_t>(this); }
+
+  FilePath path_;
+};
