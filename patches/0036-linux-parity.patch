index 0000000000..59f044521c
--- /dev/null
+++ b/ui/gfx/geometry/platform_math.cc
@@ -0,0 +1,130 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/gfx/geometry/platform_math.h"
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "build/build_config.h"
+#include "third_party/ucrt_math/ucrt_math.h"
+
+#if defined(ARCH_CPU_X86_FAMILY)
+#include <xmmintrin.h>
+#endif
+
+namespace gfx {
+
+bool UsesWindowsMath() {
+  static const bool uses = [] {
+    // The switch blink::PresentsWindowsPlatform() reads; this layer cannot
+    // depend on Blink. Every process type receives it.
+    if (!base::CommandLine::InitializedForCurrentProcess() ||
+        base::CommandLine::ForCurrentProcess()->HasSwitch(
+            "use-chromium-defaults")) {
+      return false;
+    }
+    // A build that contracted the library's multiply-adds would answer
+    // wrongly; the C library's then, and said so. The first caller may be
+    // an audio thread, which runs with denormals flushed to zero
+    // (DenormalDisabler), where the test's subnormal vectors would fail and
+    // switch the whole process over: the test runs in the default
+    // floating-point environment. x86 only, as the build is: on ARM the
+    // audio thread sets FPCR's FZ bit, which nothing here undoes. The call
+    // goes through a volatile pointer so that the test is not inlined (the
+    // build is ThinLTO) and its arithmetic moved across the two
+    // control-word writes, which the compiler does not tie it to.
+#if defined(ARCH_CPU_X86_FAMILY)
+    const unsigned int caller_csr = _mm_getcsr();
+    _mm_setcsr(0x1F80);
+#endif
+    int (*volatile selftest)() = &ucrt_math_selftest;
+    const int failures = selftest();
+#if defined(ARCH_CPU_X86_FAMILY)
+    _mm_setcsr(caller_csr);
+#endif
+    LOG_IF(ERROR, failures != 0)
+        << "third_party/ucrt_math failed its self-test (" << failures
+        << " vectors): math falls back to the C library's";
+    return failures == 0;
+  }();
+  return uses;
+}
+
+double PlatformSin(double x) {
+  return UsesWindowsMath() ? ucrt_sin(x) : std::sin(x);
+}
+
+double PlatformCos(double x) {
+  return UsesWindowsMath() ? ucrt_cos(x) : std::cos(x);
+}
+
+double PlatformTan(double x) {
+  return UsesWindowsMath() ? ucrt_tan(x) : std::tan(x);
+}
+
+double PlatformAsin(double x) {
+  return UsesWindowsMath() ? ucrt_asin(x) : std::asin(x);
+}
+
+double PlatformAcos(double x) {
+  return UsesWindowsMath() ? ucrt_acos(x) : std::acos(x);
+}
+
+double PlatformAtan(double x) {
+  return UsesWindowsMath() ? ucrt_atan(x) : std::atan(x);
+}
+
+double PlatformExp(double x) {
+  return UsesWindowsMath() ? ucrt_exp(x) : std::exp(x);
+}
+
+double PlatformLog(double x) {
+  return UsesWindowsMath() ? ucrt_log(x) : std::log(x);
+}
+
+double PlatformAtan2(double y, double x) {
+  return UsesWindowsMath() ? ucrt_atan2(y, x) : std::atan2(y, x);
+}
+
+float PlatformSin(float x) {
+  return UsesWindowsMath() ? ucrt_sinf(x) : std::sin(x);
+}
+
+float PlatformCos(float x) {
+  return UsesWindowsMath() ? ucrt_cosf(x) : std::cos(x);
+}
+
+float PlatformTan(float x) {
+  return UsesWindowsMath() ? ucrt_tanf(x) : std::tan(x);
+}
+
+float PlatformAsin(float x) {
+  return UsesWindowsMath() ? ucrt_asinf(x) : std::asin(x);
+}
+
+float PlatformAcos(float x) {
+  return UsesWindowsMath() ? ucrt_acosf(x) : std::acos(x);
+}
+
+float PlatformAtan(float x) {
+  return UsesWindowsMath() ? ucrt_atanf(x) : std::atan(x);
+}
+
+float PlatformExp(float x) {
+  return UsesWindowsMath() ? ucrt_expf(x) : std::exp(x);
+}
+
+float PlatformLog(float x) {
+  return UsesWindowsMath() ? ucrt_logf(x) : std::log(x);
+}
+
+float PlatformAtan2(float y, float x) {
+  return UsesWindowsMath() ? ucrt_atan2f(y, x) : std::atan2(y, x);
+}
+
+double PlatformHypot(double x, double y) {
+  return UsesWindowsMath() ? ucrt_hypot(x, y) : std::hypot(x, y);
+}
+
+}  // namespace gfx
