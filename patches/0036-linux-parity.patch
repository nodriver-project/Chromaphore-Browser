+#ifndef URL_WINDOWS_DRIVE_LETTER_URLS_H_
+#define URL_WINDOWS_DRIVE_LETTER_URLS_H_
+
+#include "base/component_export.h"
+#include "build/build_config.h"
+
+// browser: whether this process, or the current thread for a while, reads
+// drive letters and UNC paths in URLs as Chrome on Windows does. There
+// "c:/foo", "C:\foo" and "\\server\share" are file: URLs, where other
+// platforms read "c:" as a scheme; a file: URL with no drive letter and other
+// than three slashes has a UNC host; and a path resolved against a file: base
+// keeps the base's drive.
+//
+// A Linux build presenting Windows turns it on for the whole process in its
+// renderers (content/renderer/render_thread_impl.cc) and in its network
+// service when that has a process of its own (content/utility/services.cc).
+// Its browser process keeps Linux's reading, which the address bar and local
+// files depend on, and turns Windows' on only around the resolution of a
+// string a site supplied (ScopedWindowsDriveLetterUrls). The parser asks
+// through url_file.h.
+
+namespace url {
+
+#if BUILDFLAG(IS_LINUX)
+
+// True when the process-wide switch is on or a scope is open on this thread.
+COMPONENT_EXPORT(URL) bool WindowsDriveLetterUrls();
+
+// The process-wide switch. Set once, before the process parses a site's URLs.
+COMPONENT_EXPORT(URL) void SetWindowsDriveLetterUrls(bool enabled);
+
+// Turns Windows' reading on for the current thread while in scope, if
+// `enabled`. Scopes nest. Meant for the one statement that resolves a string
+// a site supplied, in a process whose switch is off.
+class COMPONENT_EXPORT(URL) ScopedWindowsDriveLetterUrls {
+ public:
+  explicit ScopedWindowsDriveLetterUrls(bool enabled);
+  ScopedWindowsDriveLetterUrls(const ScopedWindowsDriveLetterUrls&) = delete;
+  ScopedWindowsDriveLetterUrls& operator=(const ScopedWindowsDriveLetterUrls&) =
+      delete;
+  ~ScopedWindowsDriveLetterUrls();
+
+ private:
+  const bool enabled_;
+};
+
+#endif  // BUILDFLAG(IS_LINUX)
+
+}  // namespace url
+
+#endif  // URL_WINDOWS_DRIVE_LETTER_URLS_H_
-- 
