+
+# Math functions that return what the Windows Universal C Runtime returns, bit
+# for bit (README.chromium). A Linux build presenting Windows uses them through
+# ui/gfx/geometry/platform_math.h.
+static_library("ucrt_math") {
+  sources = [
+    "ucrt_math.c",
+    "ucrt_math.h",
+  ]
+  configs -= [ "//build/config/compiler:chromium_code" ]
+  configs += [ "//build/config/compiler:no_chromium_code" ]
