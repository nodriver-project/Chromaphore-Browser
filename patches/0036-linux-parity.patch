+/* ------------------------------------------------------------------------------------------------------------
+ * hypot: src/ref/hypot.c (scaling by 2^+-600, the insignificant-operand shortcut, the special values of its WINDOWS
+ * branch); the sum of squares is the plain x*x + y*y that UCRT computes, without AOCL's extra-precision tail
+ * (see PORT.md)
+ * ------------------------------------------------------------------------------------------------------------ */
+double ucrt_hypot(double x, double y)
+{
+    uint64_t ux = asu64(x) & ABS_MASK, uy = asu64(y) & ABS_MASK;
+    int xexp = (int)(ux >> 52), yexp = (int)(uy >> 52), dexp = xexp - yexp, expadjust = 0;
+    if (ux >= EXP_MASK || uy >= EXP_MASK) {
+        if (ux == EXP_MASK || uy == EXP_MASK) return asdbl(EXP_MASK);  /* an infinity wins, even over a NaN */
+        return quiet(ux > EXP_MASK ? asu64(x) : asu64(y));            /* x's NaN first, quieted, sign kept */
+    }
+    x = asdbl(ux);
+    y = asdbl(uy);
+    if (ux == 0) return y;
+    if (uy == 0) return x;
+    if (dexp > 54 || dexp < -54) return x + y;                         /* one operand is insignificant */
+    if (xexp > 1023 + 500 || yexp > 1023 + 500) {                      /* danger of overflow: scale by 2^-600 */
+        expadjust = 600;
+        x = asdbl(ux - 0x2580000000000000ULL);
+        y = asdbl(uy - 0x2580000000000000ULL);
+    } else if (xexp < 1023 - 500 || yexp < 1023 - 500) {               /* danger of underflow: scale by 2^600 */
+        expadjust = -600;
+        /* a denormal gets 601 added to its exponent field, then the implicit bit (2^-422) taken off: exact */
+        if (xexp == 0) x = asdbl(ux + 0x2590000000000000ULL) - asdbl(0x2590000000000000ULL);
+        else x = asdbl(ux + 0x2580000000000000ULL);
+        if (yexp == 0) y = asdbl(uy + 0x2590000000000000ULL) - asdbl(0x2590000000000000ULL);
+        else y = asdbl(uy + 0x2580000000000000ULL);
+    }
+    double r = sqrt(x * x + y * y);                                    /* unfused, as UCRT */
+    return expadjust ? scale_double_1(r, expadjust) : r;               /* one rounding, also into denormals */
+}
+
+/* ============================================================================================================
+ * Float functions. UCRT computes sinf, cosf, tanf and expf in double and rounds once at the end (cvtsd2ss); logf
+ * works in float throughout. NaN inputs and outputs are built from bits, as for the double functions.
+ * ============================================================================================================ */
+static inline uint32_t asu32(float f) { uint32_t u; memcpy(&u, &f, sizeof u); return u; }
+static inline float asflt(uint32_t u) { float f; memcpy(&f, &u, sizeof f); return f; }
+#define F_EXP_MASK 0x7f800000U
+#define F_QNAN_BIT 0x00400000U
+
+/* ------------------------------------------------------------------------------------------------------------
+ * sinf, cosf, tanf: src/isa/avx2/gas/{sinf,cosf,tanf}_fma3.S with the macros sin_piby4_sf_fma3, cos_piby4_sf_fma3,
+ * tan_piby4_sf_zeor_fma3, tan_piby4_sf_fma3 and range_e_5_sf_fma3 of src/isa/avx2/include/trig_func.h, translated
+ * instruction by instruction. Three differences, each measured over all 2^32 inputs (PORT.md):
+ *   - the sin and cos kernels use the Taylor coefficients of src/isa/avx/gas/sinf.S (.Lsinfarray, .Lcosfarray);
+ *   - Cody-Waite reduction (range_e_5_sf_fma3) is used up to 2^30, not 5e6;
+ *   - at and above 2^30 the remainder is r of the double routine call_remainder_piby2_fma3 (reduce_big above),
+ *     not call_remainder_piby2_f; and tanf uses its kernel down to 2^-13.
+ * ------------------------------------------------------------------------------------------------------------ */
+#define SF1 asdbl(0xbfc5555555555555ULL)   /* .Lsinfarray s1..s4 */
+#define SF2 asdbl(0x3f81111111111111ULL)
+#define SF3 asdbl(0xbf2a01a01a01a01aULL)
+#define SF4 asdbl(0x3ec71de3a556c734ULL)
+#define CF1 asdbl(0x3fa5555555555555ULL)   /* .Lcosfarray c1..c4 */
+#define CF2 asdbl(0xbf56c16c16c16c16ULL)
+#define CF3 asdbl(0x3efa01a01a01a019ULL)
+#define CF4 asdbl(0xbe927e4fb7789f5cULL)
+#define TWO_30_BITS 0x41d0000000000000ULL  /* 2^30: Cody-Waite below, Payne-Hanek at and above */
+static const uint64_t TANF_C[5] = {0x3fd8a8b0da56cb17ULL, 0x3f919dba6efd6aadULL, 0x3ff27e84a3e73a2eULL,
+                                   0xbfe07266d7b3511bULL, 0x3f92e29003c692d9ULL};  /* .L_tanf */
+
+static double sin_piby4_sf(double x)                                  /* sin_piby4_sf_fma3 */
+{
+    double x2 = x * x;
+    double p = fma(x2, SF4, SF3);
+    p = fma(x2, p, SF2);
+    p = fma(x2, p, SF1);
+    return fma(p, x2 * x, x);
+}
+static double cos_piby4_sf(double x)                                  /* cos_piby4_sf_fma3 */
+{
+    double x2 = x * x;
+    double t = 1.0 - 0.5 * x2;
+    double p = fma(x2, CF4, CF3);
+    p = fma(x2, p, CF2);
+    p = fma(x2, p, CF1);
+    return fma(x2 * x2, p, t);
+}
+static double tan_piby4_sf(double x)                                  /* tan_piby4_sf_zeor_fma3 */
+{
+    double r = x * x;
+    double a = fma(-r, asdbl(TANF_C[1]), asdbl(TANF_C[0]));
+    double b = fma(r, asdbl(TANF_C[4]), asdbl(TANF_C[3]));
+    b = fma(r, b, asdbl(TANF_C[2]));
+    return fma(a / b, x * r, x);
+}
+
+/* range_e_5_sf_fma3: ax = |x| in (pi/4, 2^30). Returns r = ax - n*pi/2 (no tail is kept), region = n & 3. */
+static double reduce_small_f(double ax, int *region)
+{
+    int32_t n = (int32_t)fma(ax, asdbl(0x3fe45f306dc9c883ULL), 0.5);  /* cvttpd2dq of ax*2/pi + 0.5 */
+    double dn = (double)n;
+    *region = n & 3;
+    double rhead = fma(-dn, asdbl(0x3ff921fb54400000ULL), ax);         /* .L_piby2_1 */
+    double rtail = dn * asdbl(0x3dd0b4611a626331ULL);                   /* .L_piby2_1tail */
+    return rhead - rtail;
+}
+
+static double reduce_f(double ax, int *region)
+{
+    if (asu64(ax) < TWO_30_BITS) return reduce_small_f(ax, region);
+    double r, rr;
+    *region = reduce_big(ax, &r, &rr);                                  /* the float kernels take r only */
+    return r;
+}
+
+/* sinf, cosf, tanf of +-inf or NaN */
+static float trigf_naninf(uint32_t ux)
+{
+    if ((ux & 0x7fffffffU) == F_EXP_MASK) return asflt(0xffc00000U);  /* +-inf: the indefinite NaN */
+    return asflt(ux | F_QNAN_BIT);                                     /* NaN: quieted, sign and payload kept */
+}
+
+float ucrt_sinf(float xf)
+{
+    uint32_t uxf = asu32(xf);
+    if ((uxf & F_EXP_MASK) == F_EXP_MASK) return trigf_naninf(uxf);
+    double x = (double)xf, ax = fabs(x);
+    uint64_t aux = asu64(ax);
+    if (aux > PIBY4_BITS) {
+        int region;
+        double r = reduce_f(ax, &region);
+        double s = (region & 1) ? cos_piby4_sf(r) : sin_piby4_sf(r);
+        if (region >= 2) s = -s;
+        return (float)(xf < 0 ? -s : s);
+    }
+    if (aux >= 0x3f80000000000000ULL) return (float)sin_piby4_sf(x);   /* |x| >= 2^-7 */
+    if (aux >= TWO_M13) return (float)fma(-(x * x * x), POINT_166, x); /* x - x^3/6 */
+    return xf;                                                          /* |x| < 2^-13: x */
+}
+
+float ucrt_cosf(float xf)
+{
+    uint32_t uxf = asu32(xf);
+    if ((uxf & F_EXP_MASK) == F_EXP_MASK) return trigf_naninf(uxf);
+    double x = (double)xf, ax = fabs(x);
+    uint64_t aux = asu64(ax);
+    if (aux > PIBY4_BITS) {
+        int region;
+        double r = reduce_f(ax, &region);
+        double c = (region & 1) ? sin_piby4_sf(r) : cos_piby4_sf(r);
+        if (region == 1 || region == 2) c = -c;
+        return (float)c;
+    }
+    if (aux >= 0x3f80000000000000ULL) return (float)cos_piby4_sf(x);
+    if (aux >= TWO_M13) return (float)fma(-x, x * 0.5, 1.0);         /* 1 - x*x/2 */
+    return 1.0f;
+}
+
+float ucrt_tanf(float xf)
+{
+    uint32_t uxf = asu32(xf);
+    if ((uxf & F_EXP_MASK) == F_EXP_MASK) return trigf_naninf(uxf);
+    double x = (double)xf, ax = fabs(x);
+    uint64_t aux = asu64(ax);
+    if (aux > PIBY4_BITS) {
+        int region;
+        double r = reduce_f(ax, &region);
+        double t = tan_piby4_sf(r);
+        if (region & 1) t = -1.0 / t;                                   /* tan_piby4_sf_fma3's reciprocal */
+        return (float)(xf < 0 ? -t : t);
+    }
+    /* UCRT uses the kernel down to 2^-13; tanf_fma3.S has x + x^3/3 on [2^-13, 2^-7) (see PORT.md) */
+    if (aux >= TWO_M13) return (float)tan_piby4_sf(x);
+    return xf;
+}
+
+/* ------------------------------------------------------------------------------------------------------------
+ * expf: src/isa/avx2/gas/expf_fma3.S, table .L__two_to_jby64_table of src/isa/include/exp_tables.h; the zero
+ * threshold is UCRT's (measured), not AOCL's
+ * ------------------------------------------------------------------------------------------------------------ */
+float ucrt_expf(float xf)
+{
+    uint32_t uxf = asu32(xf);
+    if ((uxf & 0x7fffffffU) > F_EXP_MASK) return asflt(uxf | F_QNAN_BIT);   /* NaN */
+    if (xf > asflt(0x42b17218U)) return asflt(F_EXP_MASK);                  /* x > .L__max_expf_arg: +inf */
+    if (xf < asflt(0xc2cff1b5U)) return 0.0f;                               /* UCRT: first float giving +0 */
+    double x = (double)xf;
+    double t = x * asdbl(0x40571547652b82feULL);                            /* x * 64/ln(2) */
+    double dn = (t + 0x1.8p52) - 0x1.8p52;                                  /* cvtpd2dq: nearest, ties to even */
+    int32_t n = (int32_t)dn;
+    double r = fma(dn, asdbl(0xbf862e42fefa39efULL), x);                    /* x - n*ln(2)/64, fused */
+    double q = fma(r * r, fma(r, asdbl(0x3fc5555555555555ULL), 0.5), r);    /* r + r^2*(1/2 + r/6) */
+    int32_t j = n & 0x3f, m = (n - j) / 64;                                  /* m = n >> 6 (psrad), portably */
+    double f = asdbl(TWO_TO_JBY64[j]);
+    double res = fma(f, q, f);
+    res = asdbl(asu64(res) + ((uint64_t)(int64_t)m << 52));                 /* integer add to the exponent */
+    return (float)res;                                                       /* cvtpd2ps: the one rounding */
+}
+
+/* ------------------------------------------------------------------------------------------------------------
+ * asinf, acosf: src/ref/asinf.c and the original amdlibm src/ref/acosf.c (commit 2a9b9dc6: its y*u and x*u are
+ * float products, as UCRT computes them; see PORT.md). Single precision with the multiply-adds fused as UCRT does.
+ * ------------------------------------------------------------------------------------------------------------ */
+/* u = r * R(r): the rational minimax approximation to (arcsin(y) - y)/y^3 at r = y^2, shared by asinf and acosf */
+static float asinf_poly(float r)
+{
+    float p = fmaf(-0.00396137437848476485201154797087F, r, -0.0133819288943925804214011424456F);
+    p = fmaf(p, r, -0.0565298683201845211985026327361F);
+    p = fmaf(p, r, 0.184161606965100694821398249421F);
+    float q = fmaf(-0.836411276854206731913362287293F, r, 1.10496961524520294485512696706F);
+    return r * p / q;
+}
+
+float ucrt_asinf(float x)
+{
+    const float piby2_tail = 7.5497894159e-08F,                         /* 0x33a22168 */
+                hpiby2_head = 7.8539812565e-01F,                        /* 0x3f490fda */
+                piby2 = 1.5707963705e+00F;                              /* 0x3fc90fdb */
+    uint32_t ux = asu32(x), aux = ux & 0x7fffffffU;
+    int xexp = (int)((ux & F_EXP_MASK) >> 23) - 127;
+    if (aux > F_EXP_MASK) return asflt(ux | F_QNAN_BIT);                /* NaN: quieted */
+    if (xexp < -14) return x;                                           /* tiny: x */
+    if (xexp >= 0) {                                                    /* |x| >= 1 */
+        if (x == 1.0F) return piby2;
+        if (x == -1.0F) return -piby2;
+        return asflt(0xffc00000U);                                      /* the indefinite NaN */
+    }
+    float y = fabsf(x), s = 0.0F, r, v;
+    int transform = xexp >= -1;                                         /* |x| >= 0.5 */
+    if (transform) {
+        r = 0.5F * (1.0F - y);
+        s = sqrtf(r);
+        y = s;
+    } else {
+        r = y * y;
+    }
+    float u = asinf_poly(r);
+    if (transform) {                                                    /* pi/2 - 2*asin(s), reconstructed */
+        float s1 = asflt(asu32(s) & 0xffff0000U);
+        float c = (r - s1 * s1) / (s + s1);
+        float p = fmaf(2.0F * s, u, -(piby2_tail - 2.0F * c));
+        float q = hpiby2_head - 2.0F * s1;
+        v = hpiby2_head - (p - q);
+    } else {
+        v = fmaf(y, u, y);
+    }
+    return (ux & 0x80000000U) ? -v : v;
+}
+
+float ucrt_acosf(float x)
+{
+    const float piby2 = 1.5707963705e+00F;                              /* 0x3fc90fdb */
+    const double pi = 3.1415926535897933e+00,                           /* 0x400921fb54442d18 */
+                 piby2_head = 1.5707963267948965580e+00,                /* 0x3ff921fb54442d18 */
+                 piby2_tail = 6.12323399573676603587e-17;               /* 0x3c91a62633145c07 */
+    uint32_t ux = asu32(x), aux = ux & 0x7fffffffU;
+    int xexp = (int)((ux & F_EXP_MASK) >> 23) - 127;
+    if (aux > F_EXP_MASK) return asflt(ux | F_QNAN_BIT);
+    if (xexp < -26) return piby2;
+    if (xexp >= 0) {
+        if (x == 1.0F) return 0.0F;
+        if (x == -1.0F) return (float)pi;
+        return asflt(0xffc00000U);
+    }
+    float y = fabsf(x), s = 0.0F, r;
+    int transform = xexp >= -1;
+    if (transform) {
