+float ucrt_logf(float x)
+{
+    uint32_t ux = asu32(x);
+    if ((ux & F_EXP_MASK) == F_EXP_MASK) {
+        if (ux == F_EXP_MASK) return x;                                     /* +inf */
+        if (ux == 0xff800000U) return asflt(0xffc00000U);                   /* -inf: negative, indefinite NaN */
+        return asflt(ux | F_QNAN_BIT);                                      /* NaN: quieted */
+    }
+    if (x == 0.0f) return asflt(0xff800000U);                               /* +-0: -inf */
+    if (x < 0.0f) return asflt(0xffc00000U);
+    float xexp = (float)((int32_t)(ux >> 23) - 127);
+    uint32_t mant = ux & 0x007fffffU;
+    float xm1 = x - 1.0f;
+    uint32_t ui = ux;                                                       /* the bits the index comes from */
+    if (xexp == -127.0f) {                                                  /* denormal: 1.mant - 1 normalises */
+        uint32_t ut = asu32(asflt(mant | 0x3f800000U) - 1.0f);
+        xexp = (float)((int32_t)(ut >> 23) - 253);
+        mant = ut & 0x007fffffU;
+        ui = mant;
+    }
+    uint32_t idx = (ui & 0x007f0000U) + ((ui & 0x00008000U) << 1);
+    if (fabsf(xm1) < asflt(0x3d800000U)) {                                  /* |x - 1| < 1/16 */
+        float r = x - 1.0f;
+        float u = r / (2.0f + r);
+        float corr = r * u;
+        u = u + u;
+        float v = u * u;
+        float u3 = u * v;
+        float a = fmaf(asflt(0x3c4ccccdU), v, asflt(0x3daaaaabU));         /* ca2 * v + ca1 */
+        a = fmaf(u3, a, -corr);
+        return r + a;
+    }
+    idx >>= 16;
+    float Y = asflt(mant | 0x3f000000U), F = asflt((idx << 16) | 0x3f000000U);
+    float r = (F - Y) * asflt(LOGF_F_INV[idx]);
+    float a = fmaf(r, asflt(0x3eaaaaabU), 0.5f);                            /* r/3 + 1/2 */
+    float poly = fmaf(a, r * r, r);
+    float z2 = fmaf(xexp, asflt(0x3805fdf4U), -poly);                       /* xexp * log2_tail - poly */
+    float z1 = fmaf(xexp, asflt(0x3f317000U), asflt(LOGF_128_LEAD[idx]));   /* xexp * log2_lead + lead */
+    z2 = z2 + asflt(LOGF_128_TAIL[idx]);
+    return z1 + z2;
+}
