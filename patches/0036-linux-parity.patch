+static double scale_double_1(double x, int n) { return x * asdbl(((uint64_t)n + 1023) << 52); }
+static double scale_double_2(double x, int n)
+{
+    int n1 = n / 2, n2 = n - n1;
+    return (x * asdbl(((uint64_t)n1 + 1023) << 52)) * asdbl(((uint64_t)n2 + 1023) << 52);
+}
+static uint64_t scale_down_double(uint64_t ux, int k)
+{
+    uint64_t uy, xsign = ux & SIGN_MASK, ax = ux & ABS_MASK;
+    int n = (int)((ax & EXP_MASK) >> 52) - k;
+    if (n > 0) {
+        uy = (ax & ~EXP_MASK) | ((uint64_t)n << 52);
+    } else {
+        uy = (ax & ~EXP_MASK) | 0x0010000000000000ULL;
+        int shift = 1 - n;
+        if (shift > 53) uy = 0;
+        else { uy >>= shift - 1; uy = (uy >> 1) + (uy & 1); }
+    }
+    return uy | xsign;
+}
