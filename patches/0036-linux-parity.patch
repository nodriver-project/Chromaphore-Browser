+  ~ListedFile() { Close(); }
+
+  void Open(const FilePath& path, int64_t size) {
+    path_ = path;
+    ListedFileSizes::Get().Set(path_, Owner(), size);
+  }
+  void Synced(int64_t size) {
+    if (!path_.empty()) {
