+double ucrt_log(double x)
+{
+    const double log2_lead = asdbl(0x3fe62e42e0000000ULL), log2_tail = asdbl(0x3e6efa39ef35793cULL);
+    uint64_t ux = asu64(x);
+    uint64_t top = ux >> 52;                                       /* exponent field and sign */
+    double xexp = (double)(int32_t)(uint32_t)(top - 1023);         /* vcvtdq2pd of the low dword */
+    uint64_t mant = ux & 0x000fffffffffffffULL;
+    uint64_t ix = ux;                                              /* bits that give the table index */
+    double xm1 = x - 1.0;
+    if (top >= 0x7ff || top == 0) {
+        if ((ux & EXP_MASK) == EXP_MASK) {                         /* +-inf or NaN */
+            if (ux == EXP_MASK) return x;                          /* log(+inf) = +inf */
+            if (ux == 0xfff0000000000000ULL) return asdbl(INDEF_BITS);
+            return quiet(ux);
+        }
+        if (x == 0.0) return asdbl(0xfff0000000000000ULL);         /* log(+-0) = -inf */
+        if (x < 0.0) return asdbl(INDEF_BITS);                     /* negative: UCRT's indefinite NaN */
+        /* denormal: normalise through 1.mant - 1 */
+        uint64_t uv = asu64(asdbl(mant | 0x3ff0000000000000ULL) - 1.0);
+        xexp = (double)(int32_t)((uint32_t)(uv >> 52) - 2045u);
+        mant = uv & 0x000fffffffffffffULL;
+        ix = mant;
+    }
+    uint64_t idxbits = (ix & 0x000ff00000000000ULL) + ((ix & 0x0000080000000000ULL) << 1);
+    if (fabs(xm1) < 0.0625) {                                      /* near one */
+        double r = xm1;
+        double h = r / (2.0 + r);
+        double corr = r * h;
+        double u = h + h;
+        double v = u * u;
+        double a = fma(v, asdbl(0x3f89999999bac6d4ULL), asdbl(0x3fb55555555554e6ULL));
+        double b = fma(v, asdbl(0x3f3c8034c85dfff0ULL), asdbl(0x3f62492307f1519fULL));
+        double u3 = v * u;
+        a = a * u3;
+        double u7 = (u3 * u3) * u;
+        a = fma(u7, b, a);
+        a = a - corr;
+        return r + a;
+    }
+    int idx = (int)(idxbits >> 44);
+    double Y = asdbl(mant | 0x3fe0000000000000ULL);
+    double F = asdbl(idxbits | 0x3fe0000000000000ULL);
+    double r = (F - Y) * asdbl(LOG_F_INV[idx]);
+    double r2 = r * r;
+    double a = fma(r, asdbl(0x3fc5555555555555ULL), asdbl(0x3fc999999999999aULL));
+    double b = fma(r, asdbl(0x3fd5555555555555ULL), 0.5);
+    a = fma(r, a, 0.25);
+    double r4 = r2 * r2;
+    double poly = fma(r2, b, r);
+    poly = fma(r4, a, poly);
+    double w = fma(xexp, log2_tail, -poly);
+    double lo = asdbl(LOG256_TAIL[idx]) + w;
+    double hi = fma(xexp, log2_lead, asdbl(LOG256_LEAD[idx]));
+    return hi + lo;
+}
