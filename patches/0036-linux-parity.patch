diff --git a/content/browser/bluetooth/windows_bluetooth_adapter.cc b/content/browser/bluetooth/windows_bluetooth_adapter.cc
new file mode 100644
index 0000000000..46f798b73d
--- /dev/null
+++ b/content/browser/bluetooth/windows_bluetooth_adapter.cc
@@ -0,0 +1,87 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/bluetooth/windows_bluetooth_adapter.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/location.h"
+#include "base/no_destructor.h"
+#include "base/rand_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/content_browser_client.h"
+#include "content/public/common/content_client.h"
+
+namespace content {
+
+namespace {
+
+// Where the adapter is: nothing has asked yet; it is coming up (start-up is
+// completing, or completed less than 110 to 150 ms ago); or it is up.
+enum class AdapterState { kNotAsked, kComingUp, kUp };
+
+AdapterState& State() {
+  static AdapterState state = AdapterState::kNotAsked;
+  return state;
+}
+
+// Calls made while it comes up, in order.
+std::vector<base::OnceClosure>& WaitingTasks() {
+  static base::NoDestructor<std::vector<base::OnceClosure>> tasks;
+  return *tasks;
+}
+
+// The adapter is up: the calls made while it came up run, in order.
+void OnAdapterUp() {
+  State() = AdapterState::kUp;
+  std::vector<base::OnceClosure> tasks;
+  tasks.swap(WaitingTasks());
+  for (base::OnceClosure& task : tasks) {
+    std::move(task).Run();
+  }
+}
+
+// Start-up is complete: the adapter is up 110 to 150 ms later, as
+// measured on Windows 11.
+void OnStartupComplete() {
+  GetUIThreadTaskRunner({})->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&OnAdapterUp),
+      base::Milliseconds(110 + base::RandGenerator(41)));
+}
+
+}  // namespace
+
+void RunWhenWindowsBluetoothAdapterReady(base::OnceClosure task) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  switch (State()) {
+    case AdapterState::kUp:
+      std::move(task).Run();
+      return;
+    case AdapterState::kComingUp:
+      WaitingTasks().push_back(std::move(task));
+      return;
+    case AdapterState::kNotAsked:
+      if (GetContentClient()->browser()->IsBrowserStartupComplete()) {
+        // Start-up ended before anything asked: the adapter is up.
+        State() = AdapterState::kUp;
+        std::move(task).Run();
+        return;
+      }
+      // Content holds best-effort tasks until start-up is complete
+      // (BrowserTaskExecutor::OnStartupComplete()).
+      State() = AdapterState::kComingUp;
+      WaitingTasks().push_back(std::move(task));
+      GetUIThreadTaskRunner({base::TaskPriority::BEST_EFFORT})
+          ->PostTask(FROM_HERE, base::BindOnce(&OnStartupComplete));
+      return;
+  }
+}
+
+}  // namespace content
