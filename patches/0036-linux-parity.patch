+static uint64_t scale_up_double_1024(uint64_t ux)
+{
+    if ((ux & EXP_MASK) == 0) {                                /* denormal */
+        double y = asdbl(ux | 0x4010000000000000ULL);
+        if (ux & SIGN_MASK) y += 4.0; else y -= 4.0;
+        return asu64(y);
+    }
+    return ux + 0x4000000000000000ULL;
