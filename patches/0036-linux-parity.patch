+ * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED
+ * WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.
+ * IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT,
+ * INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING,
+ * BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,
+ * OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
+ * WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+#include "ucrt_math.h"
+
+#include <float.h>
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+#if defined(__FAST_MATH__)
+#error "ucrt_math.c must not be compiled with -ffast-math: results would no longer match UCRT"
+#endif
+#if !defined(FLT_EVAL_METHOD) || FLT_EVAL_METHOD != 0
+#error "ucrt_math.c needs FLT_EVAL_METHOD == 0 (no excess precision, e.g. x86-64 SSE2 or arm64, not x87)"
+#endif
+
+/* Never let the compiler fuse a multiply and an add on its own: the fused steps are the explicit fma() calls. */
+#if defined(__clang__)
+#pragma STDC FP_CONTRACT OFF
+#elif defined(__GNUC__)
+#pragma GCC optimize("fp-contract=off")
+#else
+#pragma STDC FP_CONTRACT OFF
+#endif
+
+static inline uint64_t asu64(double d) { uint64_t u; memcpy(&u, &d, sizeof u); return u; }
+static inline double asdbl(uint64_t u) { double d; memcpy(&d, &u, sizeof d); return d; }
+
+#define SIGN_MASK  0x8000000000000000ULL
+#define ABS_MASK   0x7fffffffffffffffULL
+#define EXP_MASK   0x7ff0000000000000ULL
+#define QNAN_BIT   0x0008000000000000ULL
+#define INDEF_BITS 0xfff8000000000000ULL   /* the "indefinite" NaN UCRT returns for invalid operations */
+
+/* NaN input: UCRT returns the input NaN with the quiet bit set (payload and sign kept). Built from bits so no
+ * CPU-specific NaN propagation rule is involved. */
+static inline double quiet(uint64_t ux) { return asdbl(ux | QNAN_BIT); }
+/* sin/cos/tan of +-inf or NaN (AOCL _sin_cos_special, Windows variant; matches UCRT). */
+static double trig_naninf(uint64_t ux)
+{
+    if ((ux & 0x000fffffffffffffULL) == 0) return asdbl(INDEF_BITS);
+    return quiet(ux);
+}
+
+/* ------------------------------------------------------------------------------------------------------------
+ * sin, cos, tan: data from src/isa/avx2/include/trig_func.h
+ * ------------------------------------------------------------------------------------------------------------ */
+#define PIBY4_BITS 0x3fe921fb54442d18ULL   /* .L_mask_3fe */
+#define TWO_M13    0x3f20000000000000ULL   /* .L_mask_3f2 */
+#define TWO_M27    0x3e40000000000000ULL   /* .L_mask_3e4 */
+#define E5_BITS    0x415312d000000000ULL   /* .L_e_5 = 5e6 */
+
+#define S1 asdbl(0xbfc5555555555555ULL)    /* .L_Sin */
+#define S2 asdbl(0x3f81111111110bb3ULL)
+#define S3 asdbl(0xbf2a01a019e83e5cULL)
+#define S4 asdbl(0x3ec71de3796cde01ULL)
+#define S5 asdbl(0xbe5ae600b42fdfa7ULL)
+#define S6 asdbl(0x3de5e0b2f9a43bb8ULL)
+#define C1 asdbl(0x3fa5555555555555ULL)    /* .L_Cos */
+#define C2 asdbl(0xbf56c16c16c16967ULL)
+#define C3 asdbl(0x3efa01a019f4ec91ULL)
+#define C4 asdbl(0xbe927e4fa17f667bULL)
+#define C5 asdbl(0x3e21eeb690382eecULL)
+#define C6 asdbl(0xbda907db47258aa7ULL)
+#define TC1 asdbl(0x3fd7d50f6638564aULL)   /* .L_tan_c1 .. c7 */
+#define TC2 asdbl(0xbf977c24c7569abbULL)
+#define TC3 asdbl(0x3f2d5daf289c385aULL)
+#define TC4 asdbl(0x3ff1dfcb8caa40b8ULL)
+#define TC5 asdbl(0xbfe08046499eb90fULL)
+#define TC6 asdbl(0x3f9ab0f4f80a0acfULL)
+#define TC7 asdbl(0x3f2e7517ef6d98f8ULL)
+#define POINT_166     asdbl(0x3fc5555555555555ULL)
+#define POINT_333     asdbl(0x3fd5555555555555ULL)
+#define POINT_68      asdbl(0x3fe5c28f5c28f5c3ULL)
+#define PIBY4_LEAD    asdbl(0x3fe921fb54442d18ULL)
+#define PIBY4_TAIL    asdbl(0x3c81a62633145c06ULL)
+#define TWOBYPI       asdbl(0x3fe45f306dc9c883ULL)
+#define PIBY2_1       asdbl(0x3ff921fb54400000ULL)
+#define PIBY2_1TAIL   asdbl(0x3dd0b4611a626331ULL)
+#define PIBY2_2       asdbl(0x3dd0b4611a600000ULL)
+#define PIBY2_2TAIL   asdbl(0x3ba3198a2e037073ULL)
+#define PIBY2_3       asdbl(0x3ba3198a2e000000ULL)
+#define PIBY2_3TAIL   asdbl(0x397b839a252049c1ULL)
+#define PIBY2_LEAD    asdbl(0x3ff921fb54442d18ULL)
+#define PIBY2_PART1   asdbl(0x3ff921fb50000000ULL)
+#define PIBY2_PART2   asdbl(0x3e5110b460000000ULL)
+#define PIBY2_PART3   asdbl(0x3c91a62633145c06ULL)
+#define HALF_MASK     0xffffffff00000000ULL
+#define FFF800_MASK   0xfffffffff8000000ULL
+
+/* .L__Pibits: bits of 2/pi, least significant byte first (158 bytes, the last 7 are padding). */
+static const unsigned char PIBITS[158] = {
+    224,241,27,193,12,88,33,116,53,126,196,126,237,175,169,75,74,41,222,231,28,244,236,197,151,175,31,235,158,212,
+    181,168,127,121,154,253,24,61,221,38,44,159,60,251,217,180,125,180,41,104,45,70,188,188,63,96,22,120,255,95,
+    226,127,236,160,228,247,46,126,17,114,210,231,76,13,230,88,71,230,4,249,125,209,154,192,113,166,19,18,237,186,
+    212,215,8,162,251,156,166,196,114,172,119,248,115,72,70,39,168,187,36,25,128,75,55,9,233,184,145,220,134,21,
+    239,122,175,142,69,249,7,65,14,241,100,86,138,109,3,119,211,212,71,95,157,240,167,84,16,57,185,13,230,139,2,
+    0,0,0,0,0,0,0};
+
+/* sin_piby4_s_xx_zero_fma3: sin(x) for |x| <= pi/4, no tail. */
+static double sin_piby4_xx0(double x)
+{
+    double x2 = x * x;
+    double r = fma(x2, fma(x2, fma(x2, fma(x2, S6, S5), S4), S3), S2);
+    double x3 = x * x2;
+    return fma(x3, fma(x2, r, S1), x);
+}
+
+/* sin_piby4_s_fma3: sin(x + xx) for a reduced argument with tail xx. */
+static double sin_piby4(double x, double xx)
+{
+    double x2 = x * x;
+    double r = fma(x2, fma(x2, fma(x2, fma(x2, S6, S5), S4), S3), S2);
+    double x3 = x * x2;
+    double t = 0.5 * xx - x3 * r;
+    t = x2 * t - xx;
+    t = fma(-x3, S1, t);
+    return x - t;
+}
+
+/* cos_piby4_s_fma3: cos(x + xx). */
+static double cos_piby4(double x, double xx)
+{
+    double x2 = x * x;
+    double r = 0.5 * x2;
+    double t = 1.0 - r;
+    double w = (1.0 - t) - r;
+    w = fma(-x, xx, w);
+    double x4 = x2 * x2;
+    double p = fma(x2, fma(x2, fma(x2, fma(x2, fma(x2, C6, C5), C4), C3), C2), C1);
+    return fma(x4, p, w) + t;
+}
+
+/* tan_piby4_s_fma3: tan(x + xx), or -1/tan(x + xx) when recip is set; |x + xx| <= pi/4. */
+static double tan_piby4(double x, double xx, int recip)
+{
+    int gt = x > POINT_68, lt = x < -POINT_68, transform = gt || lt;
+    if (transform) {
+        double xs = gt ? asdbl(asu64(x) ^ SIGN_MASK) : x;
+        double xxs = gt ? asdbl(asu64(xx) ^ SIGN_MASK) : xx;
+        x = (xs + PIBY4_LEAD) + (xxs + PIBY4_TAIL);
+        xx = 0.0;
+    }
+    double x2 = x * x;
+    double r = fma(x * xx, 2.0, x2);
+    double num = fma(r, fma(r, TC3, TC2), TC1);
+    double den = fma(r, fma(r, fma(-r, TC7, TC6), TC5), TC4);
+    double q = (num / den) * r;
+    double t2 = fma(x, q, xx);
+    double t = x + t2;
+    if (transform) {
+        double w = (t * 2.0) / (recip ? t - 1.0 : t + 1.0);
+        double res = recip ? w - 1.0 : 1.0 - w;
+        return lt ? asdbl(asu64(res) ^ SIGN_MASK) : res;
+    }
+    if (recip) {
+        double z1 = asdbl(asu64(t) & HALF_MASK);
+        double z2 = t2 - (z1 - x);
+        double trec = -1.0 / t;
+        double trec_top = asdbl(asu64(trec) & HALF_MASK);
+        double w = fma(trec_top, z1, 1.0);
+        w = fma(z2, trec_top, w);
+        return fma(trec, w, trec_top);
+    }
+    return t;
+}
+
+/* tan_piby4_s_zero_fma3: tan(x) for |x| <= pi/4, no tail (used here only for |x| == pi/4). */
+static double tan_piby4_zero(double x)
+{
+    int gt = x > POINT_68, lt = x < -POINT_68, transform = gt || lt;
+    if (transform) x = ((gt ? asdbl(asu64(x) ^ SIGN_MASK) : x) + PIBY4_LEAD) + PIBY4_TAIL;
+    double r = x * x;
+    double num = fma(r, fma(r, TC3, TC2), TC1);
+    double den = fma(r, fma(r, fma(-r, TC7, TC6), TC5), TC4);
+    double t = x + ((num / den) * r) * x;
+    if (!transform) return t;
+    double res = 1.0 - (t * 2.0) / (t + 1.0);
+    return lt ? asdbl(asu64(res) ^ SIGN_MASK) : res;
+}
+
+/* range_e_5_s_fma3: ax = |x| in (pi/4, 5e6). Cody-Waite reduction by pi/2 in up to three steps. */
+static int reduce_small(double ax, double *pr, double *prr)
+{
+    int32_t npi2 = (int32_t)fma(ax, TWOBYPI, 0.5);        /* vcvttpd2dq truncates */
+    int region = (int)(npi2 & 3);
+    double dn = (double)npi2;
+    double rhead = fma(-dn, PIBY2_1, ax);
+    double rtail = dn * PIBY2_1TAIL;
+    uint32_t expdiff = (uint32_t)((asu64(ax) >> 52) - ((asu64(rhead) & EXP_MASK) >> 52));
+    if (expdiff >= 15) {
+        double t = rhead;
+        rtail = dn * PIBY2_2;
+        rhead = t - rtail;
+        rtail = fma(dn, PIBY2_2TAIL, -((t - rhead) - rtail));
+        if (expdiff >= 48) {
+            t = rhead;
+            rtail = dn * PIBY2_3;
+            rhead = t - rtail;
+            rtail = fma(dn, PIBY2_3TAIL, -((t - rhead) - rtail));
+        }
+    }
+    double r = rhead - rtail;
+    *pr = r;
+    *prr = (rhead - r) - rtail;
+    return region;
+}
+
+static uint64_t load64le(const unsigned char *p)
+{
+    uint64_t v = 0;
+    for (int i = 7; i >= 0; i--) v = (v << 8) | p[i];
+    return v;
+}
+
+/* 64 x 64 -> 128-bit unsigned product (the x86 'mul' instruction), in portable C. */
+static void umul128(uint64_t a, uint64_t b, uint64_t *hi, uint64_t *lo)
+{
+    uint64_t a0 = a & 0xffffffffULL, a1 = a >> 32, b0 = b & 0xffffffffULL, b1 = b >> 32;
+    uint64_t p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0, p11 = a1 * b1;
+    uint64_t mid = (p00 >> 32) + (p01 & 0xffffffffULL) + (p10 & 0xffffffffULL);
+    *lo = (mid << 32) | (p00 & 0xffffffffULL);
+    *hi = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
+}
+
+/* x86 'bsr': index of the highest set bit; for a zero source the destination is left as it was. */
+static uint64_t bsr64(uint64_t v, uint64_t unchanged)
+{
+    if (v == 0) return unchanged;
+    uint64_t n = 0;
+    while (v >>= 1) n++;
+    return n;
+}
+
+/* call_remainder_piby2_fma3: ax = |x| >= 5e6, finite. Payne-Hanek reduction with the 2/pi bit table, register
+ * by register as in the assembly (r8, r9, r10, r11, rcx, rdx keep their names). Shift counts are masked to 6 bits
+ * as the x86 shift instructions do. */
+static int reduce_big(double ax, double *pr, double *prr)
+{
+    uint64_t ux = asu64(ax);
+    uint64_t r11 = (ux >> 52) - 1023;                         /* xexp */
+    uint64_t last = 134 - (r11 >> 3);
+    uint64_t mant = ((ux << 12) >> 12) | (1ULL << 52);
+    uint64_t hi, lo, r8, r9, r10, rax, rcx, rdx;
+    umul128(load64le(PIBITS + last), mant, &hi, &lo);
+    r8 = lo;
+    r10 = hi;
+    umul128(load64le(PIBITS + last + 8), mant, &hi, &lo);
+    r11 &= 7;                                                 /* resexp */
+    lo += r10;
+    hi += (lo < r10);
+    r9 = lo;
+    r10 = hi;
+    umul128(load64le(PIBITS + last + 16), mant, &hi, &lo);
+    r10 += lo;
+    /* region and the half-way bit */
+    rcx = 54 - r11;
+    rdx = 0;
+    uint64_t cf = (r10 >> ((rcx - 1) & 63)) & 1;
+    rax = r10 >> (rcx & 63);
+    if (cf) {
+        r10 = ~r10;
+        r9 = ~r9;
+        r8 = ~r8;
+        rdx = SIGN_MASK;
+    }
+    rax += cf;
+    int region = (int)(rax & 3);
+    /* drop the integer bits */
+    rcx = r11 + 10;
+    r10 = (r10 << (rcx & 63)) >> (rcx & 63);
+    rcx -= 64;
+    r11 = rcx;
+    if (r10 != 0) {
+        rcx = bsr64(r10, rcx);
+    } else {
+        r10 = r9;
+        r9 = r8;
+        r8 = 0;
+        rcx = bsr64(r10, rcx);
+        r11 -= 64;
+    }
+    /* form the mantissa with its leading bit at 52 */
+    r11 += rcx;
+    rcx -= 52;
+    if ((int64_t)rcx > 0) {
+        r8 = r10;
+        r10 >>= (rcx & 63);
+        r9 >>= (rcx & 63);
+        rcx = 64 - rcx;
+        r8 <<= (rcx & 63);
+        r9 |= r8;
+    } else if ((int64_t)rcx < 0) {
+        rcx = -rcx;
+        rax = r9;
+        r10 <<= (rcx & 63);
+        r9 <<= (rcx & 63);
+        rcx = 64 - rcx;
+        rax >>= (rcx & 63);
+        r10 |= rax;
+        r8 >>= (rcx & 63);
+        r9 |= r8;
+    }
+    r11 += 1023;
+    r10 &= ~(1ULL << 52);
+    r10 |= rdx;
+    r10 |= r11 << 52;
+    double x = asdbl(r10);
+    rcx = bsr64(r9, 0);
+    rcx = 64 - rcx;
+    r9 <<= (rcx & 63);
+    r9 >>= 12;
+    rcx += 52;
+    r11 -= rcx;
+    r9 |= rdx;
+    r9 |= r11 << 52;
+    double xx = asdbl(r9);
+    /* (x + xx) * pi/2 */
+    double hx = asdbl(r10 & FFF800_MASK);
+    double tx = x - hx;
+    double c = x * PIBY2_LEAD;
+    double cc = hx * PIBY2_PART1 - c;
+    cc = fma(tx, PIBY2_PART1, cc);
+    cc = fma(hx, PIBY2_PART2, cc);
+    cc = fma(tx, PIBY2_PART2, cc);
+    cc = cc + fma(x, PIBY2_PART3, xx * PIBY2_LEAD);
+    double r = c + cc;
+    *pr = r;
+    *prr = (c - r) + cc;
+    return region;
+}
+
+static int reduce(double ax, uint64_t aux, double *r, double *rr)
+{
+    return aux >= E5_BITS ? reduce_big(ax, r, rr) : reduce_small(ax, r, rr);
+}
+
+double ucrt_sin(double x)
+{
+    uint64_t ux = asu64(x), aux = ux & ABS_MASK;
+    if (aux <= PIBY4_BITS) {
+        /* UCRT: sin(+-pi/4) = +-0x1.6a09e667f3bcdp-1; AOCL's kernel gives ...bccp-1 there. */
+        if (aux == PIBY4_BITS) return asdbl((ux & SIGN_MASK) | 0x3fe6a09e667f3bcdULL);
+        if (aux >= TWO_M13) return sin_piby4_xx0(x);
+        if (aux >= TWO_M27) return fma(-((x * x) * x), POINT_166, x);
+        return x;
+    }
+    if ((ux & EXP_MASK) == EXP_MASK) return trig_naninf(ux);
+    double r, rr;
+    int region = reduce(asdbl(aux), aux, &r, &rr);
+    double res = (region & 1) ? cos_piby4(r, rr) : sin_piby4(r, rr);
+    uint64_t flip = ((region == 2 || region == 3) ? SIGN_MASK : 0) ^ (ux & SIGN_MASK);
+    return asdbl(asu64(res) ^ flip);
+}
+
+double ucrt_cos(double x)
+{
+    uint64_t ux = asu64(x), aux = ux & ABS_MASK;
+    if (aux <= PIBY4_BITS) {
+        if (aux == PIBY4_BITS) return cos_piby4(x, 0.0);
+        if (aux >= TWO_M13) {
+            /* UCRT's direct path on [2^-13, pi/4): AOCL's coefficients, evaluated as below (fitted, PORT.md). */
+            double x2 = x * x;
+            double p = fma(fma(fma(fma(fma(C6, x2, C5), x2, C4), x2, C3), x2, C2), x2, C1);
+            return fma(x2, fma(x2, p, -0.5), 1.0);
+        }
+        if (aux >= TWO_M27) return fma(-(0.5 * x), x, 1.0);
+        return 1.0;
+    }
+    if ((ux & EXP_MASK) == EXP_MASK) return trig_naninf(ux);
+    double r, rr;
+    int region = reduce(asdbl(aux), aux, &r, &rr);
+    double res = (region & 1) ? sin_piby4(r, rr) : cos_piby4(r, rr);
+    return (region == 1 || region == 2) ? asdbl(asu64(res) ^ SIGN_MASK) : res;
+}
+
+double ucrt_tan(double x)
+{
+    uint64_t ux = asu64(x), aux = ux & ABS_MASK;
+    if (aux <= PIBY4_BITS) {
+        if (aux == PIBY4_BITS) return tan_piby4_zero(x);
+        if (aux >= TWO_M27) {
+            /* UCRT's direct path on [2^-27, pi/4): AOCL's rational kernel, final step fused, no x + x^3/3
+             * shortcut below 2^-13 (fitted, PORT.md). */
+            double a = asdbl(aux), res;
+            if (a > 0.68) {
+                double y = (PIBY4_LEAD - a) + PIBY4_TAIL, r = y * y;
+                double q = (fma(fma(TC3, r, TC2), r, TC1) / fma(fma(fma(-TC7, r, TC6), r, TC5), r, TC4)) * r;
+                double t = fma(q, y, y);
+                res = 1.0 - 2 * t / (1 + t);
+            } else {
+                double r = a * a;
+                double q = (fma(fma(TC3, r, TC2), r, TC1) / fma(fma(fma(-TC7, r, TC6), r, TC5), r, TC4)) * r;
+                res = fma(q, a, a);
+            }
+            return (ux & SIGN_MASK) ? -res : res;
+        }
+        return x;
+    }
+    if ((ux & EXP_MASK) == EXP_MASK) return trig_naninf(ux);
+    double r, rr;
+    int region = reduce(asdbl(aux), aux, &r, &rr);
+    double res = tan_piby4(r, rr, region & 1);
+    return asdbl(asu64(res) ^ (ux & SIGN_MASK));
+}
+
+/* ------------------------------------------------------------------------------------------------------------
+ * asin, acos: src/ref/asin.c, src/ref/acos.c with the fused sites UCRT uses
+ * ------------------------------------------------------------------------------------------------------------ */
+/* Rational approximation u = r * P(r) / Q(r) shared by asin and acos, Horner steps fused. */
+static double asin_acos_u(double r)
+{
+    double num = fma(fma(fma(fma(fma(0.0000482901920344786991880522822991, r, 0.00109242697235074662306043804220), r,
+                 -0.0549989809235685841612020091328), r, 0.275558175256937652532686256258), r,
+                 -0.445017216867635649900123110649), r, 0.227485835556935010735943483075);
+    double den = fma(fma(fma(fma(0.105869422087204370341222318533, r, -0.943639137032492685763471240072), r,
+                 2.76568859157270989520376345954), r, -3.28431505720958658909889444194), r,
+                 1.36491501334161032038194214209);
+    return r * num / den;
+}
+
+double ucrt_asin(double x)
+{
+    static const double piby2_tail = 6.1232339957367660e-17,   /* 0x3c91a62633145c07 */
+                        hpiby2_head = 7.8539816339744831e-01,  /* 0x3fe921fb54442d18 */
+                        piby2 = 1.5707963267948965e+00;        /* 0x3ff921fb54442d18 */
+    uint64_t ux = asu64(x), aux = ux & ABS_MASK;
+    int xneg = (int)(ux >> 63);
+    int xexp = (int)((ux >> 52) & 0x7ff) - 1023;
+    if (aux > EXP_MASK) return quiet(ux);
+    if (xexp < -28) return x;
+    if (xexp >= 0) {
+        if (x == 1.0) return piby2;
+        if (x == -1.0) return -piby2;
+        return asdbl(INDEF_BITS);
+    }
+    double y = xneg ? -x : x, r, s = 0.0, v;
+    int transform = xexp >= -1;
+    if (transform) {
+        r = 0.5 * (1.0 - y);
+        s = sqrt(r);
+        y = s;
+    } else {
+        r = y * y;
+    }
+    double u = asin_acos_u(r);
+    if (transform) {
+        double s1 = asdbl(asu64(s) & HALF_MASK);
+        double c = (r - s1 * s1) / (s + s1);
+        double p = fma(2.0 * s, u, -(piby2_tail - 2.0 * c));
+        double q = hpiby2_head - 2.0 * s1;
+        v = hpiby2_head - (p - q);
+    } else {
+        v = fma(y, u, y);
+    }
+    return xneg ? -v : v;
+}
+
+double ucrt_acos(double x)
+{
+    static const double pi = 3.1415926535897933e+00,           /* 0x400921fb54442d18 */
+                        piby2 = 1.5707963267948965580e+00,     /* 0x3ff921fb54442d18 */
+                        piby2_head = 1.5707963267948965580e+00,
+                        piby2_tail = 6.12323399573676603587e-17; /* 0x3c91a62633145c07 */
+    uint64_t ux = asu64(x), aux = ux & ABS_MASK;
+    int xneg = (int)(ux >> 63);
