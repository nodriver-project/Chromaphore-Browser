+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_BLUETOOTH_WINDOWS_BLUETOOTH_ADAPTER_H_
+#define CONTENT_BROWSER_BLUETOOTH_WINDOWS_BLUETOOTH_ADAPTER_H_
+
+#include "base/functional/callback_forward.h"
+
+namespace content {
+
+// browser: a Windows desktop's Bluetooth adapter comes up shortly after
+// Chrome's start-up is complete (the first visible page loaded and idle;
+// about 2.4 s after launch on a warm start); Web Bluetooth's availability
+// and WebAuthn's hybrid check wait for it, and later calls answer at once.
+// A Linux build presenting Windows reports such an adapter and runs |task|
+// at that moment, so both checks complete together, as on Windows; at once
+// when the moment has passed. On the UI thread.
+void RunWhenWindowsBluetoothAdapterReady(base::OnceClosure task);
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_BLUETOOTH_WINDOWS_BLUETOOTH_ADAPTER_H_
