diff --git a/third_party/ucrt_math/ucrt_math.h b/third_party/ucrt_math/ucrt_math.h
new file mode 100644
index 0000000000..3d8fdfdcc8
--- /dev/null
+++ b/third_party/ucrt_math/ucrt_math.h
@@ -0,0 +1,54 @@
+/*
+ * ucrt_math.h: double and float math functions that return, bit for bit, what the Windows Universal C Runtime
+ * (ucrtbase.dll, x64) returns in its default FMA3 mode. Plain C99; no assembly, no CPU-specific instructions.
+ *
+ * Derived from AMD AOCL-LibM (BSD-3-Clause). See ucrt_math.c, LICENSE and PORT.md.
+ *
+ * Build requirements:
+ *   - IEEE-754 binary64 double and binary32 float, round-to-nearest, no flush-to-zero, FLT_EVAL_METHOD == 0
+ *     (x86-64 SSE2, arm64); an x87 build or -ffast-math stops the compile with #error.
+ *   - Compile ucrt_math.c with -ffp-contract=off. clang's default (on) also works: it honours the file's
+ *     #pragma STDC FP_CONTRACT OFF. clang -ffp-contract=fast ignores that pragma and gives wrong results; gcc is
+ *     safe with any setting (the file sets fp-contract=off for itself). The compiler cannot report the mode, so
+ *     run ucrt_math_selftest() in a unit test of the build that uses this file.
+ *   - fma(), fmaf(), sqrt() and sqrtf() from the C library must be correctly rounded (glibc's are, with or without
+ *     hardware FMA).
+ * The functions do not set errno and make no promise about floating-point exception flags.
+ */
+#ifndef UCRT_MATH_H
+#define UCRT_MATH_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+double ucrt_sin(double x);
+double ucrt_cos(double x);
+double ucrt_tan(double x);
+double ucrt_asin(double x);
+double ucrt_acos(double x);
+double ucrt_atan(double x);
+double ucrt_atan2(double y, double x);
+double ucrt_exp(double x);
+double ucrt_log(double x);
+double ucrt_hypot(double x, double y);
+
+float ucrt_sinf(float x);
+float ucrt_cosf(float x);
+float ucrt_tanf(float x);
+float ucrt_asinf(float x);
+float ucrt_acosf(float x);
+float ucrt_atanf(float x);
+float ucrt_atan2f(float y, float x);
+float ucrt_expf(float x);
+float ucrt_logf(float x);
+
+/* Returns 0 when this build reproduces a set of known UCRT outputs (including vectors that a build with automatic
+ * multiply-add contraction gets wrong), otherwise the number of failing vectors. */
+int ucrt_math_selftest(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* UCRT_MATH_H */
