+    /* UCRT compares strictly at the thresholds below (exp.S uses <=): measured at the exact threshold values. */
+    if (x < asdbl(0xc0874046dfefd9d0ULL))                          /* x < denormal_tiny_threshold */
+        return x < asdbl(0xc0874910d52d3051ULL) ? 0.0 : asdbl(1);  /* x < min_exp_arg (-inf included): +0 */
+    if (x >= -0x1p-26 && x < 0x1p-26) return 1.0 + x;              /* -2^-26 <= x < 2^-26: UCRT returns 1 + x */
+    double t = x * asdbl(0x40571547652b82feULL);                   /* x * 64/ln(2) */
+    int32_t n = (int32_t)t;                                        /* cvttpd2dq: truncation */
+    double dn = (double)n;
+    double r = (x + dn * asdbl(0xbf862e42fefa0000ULL)) + dn * asdbl(0xbd1cf79abc9e3b39ULL);
+    int32_t j = n & 0x3f, m = (n - j) / 64;                        /* m = n >> 6 (sar), written portably */
+    /* q = r + r^2/2 + ... + r^6/720, Horner with every step fused (UCRT; exp.S uses unfused Estrin-like order) */
+    double p = fma(r, asdbl(0x3f56c16c16c16c17ULL), asdbl(0x3f81111111111111ULL));
+    p = fma(r, p, asdbl(0x3fa5555555555555ULL));
+    p = fma(r, p, asdbl(0x3fc5555555555555ULL));
+    p = fma(r, p, 0.5);
+    double q = fma(r * r, p, r);
+    double res = (asdbl(TWO_TO_JBY64[j]) * q + asdbl(TWO_TO_JBY64_TAIL[j])) + asdbl(TWO_TO_JBY64_HEAD[j]);
+    if (m < -1022 || (m == -1022 && res < 1.0))                    /* denormal result: one rounding by 2^m */
+        return res * asdbl(1ULL << (m + 1074));
+    return asdbl(asu64(res) + ((uint64_t)(int64_t)m << 52));       /* integer add to the exponent field */
