diff --git a/net/socket/windows_ip_ttl.cc b/net/socket/windows_ip_ttl.cc
new file mode 100644
index 0000000000..bee23c8c6b
--- /dev/null
+++ b/net/socket/windows_ip_ttl.cc
@@ -0,0 +1,44 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/socket/windows_ip_ttl.h"
+
+#include <netinet/in.h>
+#include <sys/socket.h>
+
+#include "base/command_line.h"
+#include "components/browser/browser_switches.h"
+
+namespace net {
+
+namespace {
+
+// Windows' default starting TTL and IPv6 hop limit.
+constexpr int kWindowsIpTtl = 128;
+
+bool PresentsWindows() {
+  static const bool presents = !base::CommandLine::ForCurrentProcess()->HasSwitch(
+      ::switches::kUseChromiumDefaults);
+  return presents;
+}
+
+}  // namespace
+
+void ApplyWindowsIpTtl(SocketDescriptor fd, int address_family) {
+  if (!PresentsWindows()) {
+    return;
+  }
+  // Best effort: a socket that refuses keeps the kernel's value.
+  if (address_family == AF_INET6) {
+    setsockopt(fd, IPPROTO_IPV6, IPV6_UNICAST_HOPS, &kWindowsIpTtl,
+               sizeof(kWindowsIpTtl));
+  } else if (address_family != AF_INET) {
+    return;
+  }
+  // An IPv6 socket reaching an IPv4 address sends IPv4 packets, which take
+  // this one.
+  setsockopt(fd, IPPROTO_IP, IP_TTL, &kWindowsIpTtl, sizeof(kWindowsIpTtl));
+}
+
+}  // namespace net
