+// found in the LICENSE file.
+
+#ifndef NET_SOCKET_WINDOWS_IP_TTL_H_
+#define NET_SOCKET_WINDOWS_IP_TTL_H_
+
+#include "net/base/net_export.h"
+#include "net/socket/socket_descriptor.h"
+
+namespace net {
+
+// browser: a Linux build presenting Windows (as
+// blink::PresentsWindowsPlatform(), which net cannot reach) sends its packets
+// with Windows' starting TTL and IPv6 hop limit, 128, instead of Linux's 64.
+// Called on each TCP and UDP socket as it is opened; |address_family| is the
+// socket's (AF_INET or AF_INET6; any other is left alone). Nothing changes with
+// --use-chromium-defaults.
+NET_EXPORT_PRIVATE void ApplyWindowsIpTtl(SocketDescriptor fd,
+                                          int address_family);
+
+}  // namespace net
+
+#endif  // NET_SOCKET_WINDOWS_IP_TTL_H_
