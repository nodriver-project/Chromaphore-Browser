+// that is not held open is not here, and lists at its size.
+class ListedFileSizes {
+ public:
+  static ListedFileSizes& Get() {
+    static base::NoDestructor<ListedFileSizes> sizes;
+    return *sizes;
+  }
+
+  void Set(const FilePath& path, uintptr_t owner, int64_t size) {
+    base::AutoLock lock(lock_);
+    sizes_[path] = {owner, std::max<int64_t>(size, 0)};
+  }
+  void Remove(const FilePath& path, uintptr_t owner) {
+    base::AutoLock lock(lock_);
+    auto it = sizes_.find(path);
+    if (it != sizes_.end() && it->second.owner == owner) {
+      sizes_.erase(it);
+    }
+  }
+  std::optional<int64_t> Find(const FilePath& path) {
+    base::AutoLock lock(lock_);
+    auto it = sizes_.find(path);
+    if (it == sizes_.end()) {
+      return std::nullopt;
+    }
+    return it->second.size;
+  }
+  void Refresh(const FilePath& dir) {
+    base::AutoLock lock(lock_);
+    for (auto& [path, entry] : sizes_) {
+      if (path.DirName() == dir) {
+        entry.size = base::GetFileSize(path).value_or(entry.size);
+      }
+    }
+  }
+
+ private:
+  struct Entry {
+    uintptr_t owner;
+    int64_t size;
+  };
+  base::Lock lock_;
+  std::map<FilePath, Entry> sizes_ GUARDED_BY(lock_);
+};
+
