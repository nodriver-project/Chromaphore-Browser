From 3c590895d8f9a995e170a6a62f7873486bc0e916 Mon Sep 17 00:00:00 2001
From: The browser Authors <noreply@browser.invalid>
Date: Mon, 2 Nov 2026 17:12:08 -0500
Subject: [PATCH 09/55] translate-parity

Force TranslateService for hrefTranslate IDL parity.
---
 .../blink/renderer/core/exported/web_view_impl.cc        | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/third_party/blink/renderer/core/exported/web_view_impl.cc b/third_party/blink/renderer/core/exported/web_view_impl.cc
index 210e182a80..387ba3f37d 100644
--- a/third_party/blink/renderer/core/exported/web_view_impl.cc
+++ b/third_party/blink/renderer/core/exported/web_view_impl.cc
@@ -1945,8 +1945,13 @@ void WebView::ApplyWebPreferences(const web_pref::WebPreferences& prefs,
   RuntimeEnabledFeatures::SetMiddleClickAutoscrollEnabled(true);
 #endif
 
-  RuntimeEnabledFeatures::SetTranslateServiceEnabled(
-      prefs.translate_service_available);
+  // browser: always on. TranslateService gates the HrefTranslate runtime
+  // feature and with it the hrefTranslate attribute of HTMLAnchorElement.
+  // Chrome ships with Google API keys, so TranslateManager::IsAvailable() is
+  // true there and the attribute is always present; this build has no keys,
+  // and the missing attribute would be a fingerprint. The translate service
+  // itself is still gated by --translate-script-url.
+  RuntimeEnabledFeatures::SetTranslateServiceEnabled(true);
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_ANDROID)
   if (web_view_impl->GetPage()) {
-- 
2.45.1.windows.1

