diff --git a/components/permissions/permission_request_manager.cc b/components/permissions/permission_request_manager.cc
index f331f4df78..8a5e9f6a49 100644
--- a/components/permissions/permission_request_manager.cc
+++ b/components/permissions/permission_request_manager.cc
@@ -187,6 +187,46 @@ tabs::TabInterface* GetTabInterface(content::WebContents* web_contents) {
 #endif  // BUILDFLAG(IS_ANDROID)
 }
 
+// browser: --dismiss-permission-prompts closes every prompt unanswered after
+// the time a person takes to read one and close it.
+constexpr base::TimeDelta kUnseenPromptMinDelay = base::Seconds(1);
+constexpr base::TimeDelta kUnseenPromptMaxDelay = base::Seconds(5);
+
+bool ShouldDismissPrompts() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kDismissPermissionPrompts);
+}
+
+// The prompt a person would see, never drawn. It answers the manager as an
+// anchored bubble does, so the request runs the usual course up to the
+// dismissal.
+class UnseenPermissionPrompt : public PermissionPrompt {
+ public:
+  UnseenPermissionPrompt() = default;
+  UnseenPermissionPrompt(const UnseenPermissionPrompt&) = delete;
+  UnseenPermissionPrompt& operator=(const UnseenPermissionPrompt&) = delete;
+  ~UnseenPermissionPrompt() override = default;
+
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override {
+    return TabSwitchingBehavior::kDestroyPromptButKeepRequestPending;
+  }
+  PermissionPromptDisposition GetPromptDisposition() const override {
+    return PermissionPromptDisposition::ANCHORED_BUBBLE;
+  }
+  bool IsAskPrompt() const override { return true; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return std::nullopt;
+  }
+  std::vector<ElementAnchoredBubbleVariant> GetPromptVariants() const override {
+    return {};
+  }
+  std::optional<feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override {
+    return std::nullopt;
+  }
+};
+
 }  // namespace
 
 // PermissionRequestManager ----------------------------------------------------
@@ -227,7 +267,10 @@ void PermissionRequestManager::AddRequest(
     return;
   }
 
-  if (display::Screen::Get()->IsHeadless()) {
+  // browser: a headless browser asked to close prompts unanswered closes them
+  // as a headed one does, after a moment. Headless denies at once and stores
+  // the refusal, both of which a page can tell from a headed browser.
+  if (display::Screen::Get()->IsHeadless() && !ShouldDismissPrompts()) {
     request->PermissionDenied();
     return;
   }
@@ -930,7 +973,12 @@ bool PermissionRequestManager::RecreateView() {
     }
     CalculateCurrentVariantForEmbeddedPrompt();
   }
-  view_ = view_factory_.Run(web_contents(), this);
+  // browser: --dismiss-permission-prompts builds a prompt nobody sees.
+  if (ShouldDismissPrompts()) {
+    view_ = std::make_unique<UnseenPermissionPrompt>();
+  } else {
+    view_ = view_factory_.Run(web_contents(), this);
+  }
   if (!view_) {
     current_request_prompt_disposition_ =
         PermissionPromptDisposition::NONE_VISIBLE;
@@ -1330,12 +1378,50 @@ void PermissionRequestManager::ShowPrompt() {
   // `NotifyPromptAdded` if failure is reached before the prompt is rendered.
   NotifyPromptAdded();
 
+  // browser: and dismisses it after a short random delay.
+  if (ShouldDismissPrompts()) {
+    unseen_prompt_timer_.Start(
+        FROM_HERE,
+        base::RandTimeDelta(kUnseenPromptMinDelay, kUnseenPromptMaxDelay),
+        base::BindOnce(&PermissionRequestManager::DismissUnseenPrompt,
+                       base::Unretained(this)));
+  }
+
   // If in testing mode, automatically respond to the bubble that was shown.
   if (auto_response_for_test_ != NONE) {
     DoAutoResponseForTesting();
   }
 }
 
+// browser: --dismiss-permission-prompts.
+void PermissionRequestManager::DismissUnseenPrompt() {
+  // Gone already (answered, navigated away, or put away with its hidden tab,
+  // which shows it again, and restarts this, when the tab returns).
+  if (!IsRequestInProgress() || !view_) {
+    return;
+  }
+  // browser: the page's DevTools clients hear what was asked, by whom and how
+  // long the prompt stood, as it is closed.
+  std::vector<std::string> asked;
+  for (const auto& request : requests_) {
+    asked.emplace_back(PermissionKeyForRequestType(request->request_type()));
+  }
+  const PermissionRequest& first = *requests_.front();
+  content::RenderFrameHost* asker =
+      content::RenderFrameHost::FromID(first.get_requesting_frame_id());
+  // The asking frame's own origin: the requesting origin is the top page's
+  // for a delegated permission (location, camera, ...); for top-level
+  // storage access, the site asked about.
+  const url::Origin origin =
+      asker && first.request_type() != RequestType::kTopLevelStorageAccess
+          ? asker->GetLastCommittedOrigin()
+          : url::Origin::Create(first.requesting_origin());
+  // How long it stood: the delay this timer ran, set as it was shown.
+  web_contents()->DidDismissUnseenPermissionPrompt(
+      asker, asked, origin, unseen_prompt_timer_.GetCurrentDelay());
+  Dismiss(/*prompt_options=*/std::monostate());
+}
+
 void PermissionRequestManager::SetHatsShownCallback(
     base::OnceCallback<void()> callback) {
   hats_shown_callback_ = std::move(callback);
@@ -1354,6 +1440,7 @@ void PermissionRequestManager::ResetViewStateForCurrentRequest() {
   for (const auto& selector : permission_ui_selectors_) {
