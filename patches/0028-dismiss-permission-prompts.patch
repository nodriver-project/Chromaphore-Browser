 .../permissions/permission_request_manager.cc | 92 ++++++++++++++++++-
 .../permissions/permission_request_manager.h  |  7 ++
 components/permissions/switches.cc            | 11 +++
 components/permissions/switches.h             |  1 +
 5 files changed, 146 insertions(+), 2 deletions(-)

