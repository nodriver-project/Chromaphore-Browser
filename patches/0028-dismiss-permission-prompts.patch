diff --git a/components/permissions/switches.cc b/components/permissions/switches.cc
index 3cc801e827..e5fedcb525 100644
--- a/components/permissions/switches.cc
+++ b/components/permissions/switches.cc
@@ -11,5 +11,16 @@ namespace switches {
 // prompts.
 const char kDenyPermissionPrompts[] = "deny-permission-prompts";
 
+// browser: --dismiss-permission-prompts.
+// Presence-only. Permission requests are queued and shown as usual, except
+// that the prompt is never drawn: after a random 1-5 s, the time a person takes
+// to read a prompt and close it, it is dismissed. No decision is stored for the
+// site; as after a person's dismissals, three of them put it under the 7-day
+// embargo. A request from a background tab waits for the tab to be shown, as
+// the prompt itself would. Also covers File System Access prompts.
+// deny-permission-prompts denies in the same call and persists the block,
+// exactly as headless mode does.
+const char kDismissPermissionPrompts[] = "dismiss-permission-prompts";
+
 }  // namespace switches
 }  // namespace permissions
