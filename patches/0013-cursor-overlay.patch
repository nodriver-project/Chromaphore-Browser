+#ifndef CONTENT_BROWSER_DEVTOOLS_CDP_CURSOR_OVERLAY_H_
+#define CONTENT_BROWSER_DEVTOOLS_CDP_CURSOR_OVERLAY_H_
+
+#include <stdint.h>
+
+#include <memory>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "components/input/render_widget_host_input_event_router.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/aura/window_observer.h"
+#include "ui/compositor/layer_delegate.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace aura {
+class Window;
+}
+
+namespace ui {
+class Layer;
+}
+
+namespace content {
+
+class Page;
+class RenderFrameHost;
+class RenderWidgetHostImpl;
+
+// Draws a visible cursor on a ui::Layer above a tab's page while
+// --show-cdp-cursor is set, so an observer can follow synthetic input. The
+// layer is the browser's own, over the page rather than in it: the page never
+// sees it, and nor does a screenshot, which copies only the page's surface.
+// Page.startScreencast and Page.startFrameStream draw it onto their frames
+// while the switch is set.
+//
+// A video recording draws it into its frames with or without the switch.
+// Without it, the recording makes the tab's overlay itself (ForRecording):
+// one that tracks the pointer and draws nothing on the window, and that
+// screencast and frame-stream frames leave out as before.
+//
+// One per tab, shared by every DevTools session attached to it: a viewer's
+// session and an iframe's move the one cursor rather than adding their own.
+// Mouse positions come from the RenderWidgetHostInputEventRouter
+// (dispatchMousePath, including events routed into OOPIFs) and from
+// InputHandler directly for the input that bypasses it: dispatchMouseEvent,
+// and a drag's dragovers.
+class CdpCursorOverlay
+    : public WebContentsObserver,
+      public WebContentsUserData<CdpCursorOverlay>,
+      public aura::WindowObserver,
+      public input::RenderWidgetHostInputEventRouter::MouseEventRouteObserver {
+ public:
+  // The tab's overlay, made on first use; null without --show-cdp-cursor.
+  static CdpCursorOverlay* ForWebContents(WebContents* web_contents);
+
+  // The tab's overlay for a video recording, made on first use with or
+  // without --show-cdp-cursor, and following the tab's primary page; null
+  // only for a null `web_contents`.
+  static CdpCursorOverlay* ForRecording(WebContents* web_contents);
+
+  ~CdpCursorOverlay() override;
+
+  CdpCursorOverlay(const CdpCursorOverlay&) = delete;
+  CdpCursorOverlay& operator=(const CdpCursorOverlay&) = delete;
+
+  // Draws over the top-level view of the tab's primary page, whichever frame
+  // the asking session is on: an iframe draws inside its page's window, and a
+  // speculative or prerendered page is not on screen.
+  void Follow();
+
+  // For input that bypasses the router; a point in the tab's root view.
+  void UpdatePosition(float dip_x, float dip_y, bool is_click);
+
+  // Draws the cursor onto a screencast frame. The scale factors convert the
+  // DIP cursor position to bitmap pixels.
+  void CompositeCursorOnto(SkBitmap& bitmap, float scale_x, float scale_y);
+
+  // Whether the cursor shows on the tab's window (--show-cdp-cursor), and so
+  // on screencast and frame-stream frames.
+  bool draws_on_window() const { return draws_on_window_; }
+
+  // Whether input has placed the pointer yet; until then it is nowhere.
+  bool has_position() const { return has_position_; }
+  // The hotspot's place, in the tab's root view's DIPs.
+  const gfx::PointF& position() const { return current_pos_; }
+  // Changes whenever what is drawn changes other than by a move: the click
+  // mark going on, and going off.
+  uint64_t look_version() const { return look_version_; }
+  // Counts the mouse presses.
+  uint64_t click_count() const { return click_count_; }
+
+  // Draws the cursor as it looks now (the arrow, and the click mark while
+  // clicking) at `scale` pixels per DIP into a new N32 premultiplied bitmap,
+  // transparent elsewhere, of even width and height and just large enough
+  // for the ink. `*hotspot` gets the hotspot's place in it, in pixels. Empty
+  // for a scale that is not finite and positive, above 16, or that the
+  // bitmap could not be allocated for.
+  SkBitmap RenderSprite(float scale, gfx::PointF* hotspot) const;
+
+  // Runs |callback| whenever the cursor moves or its click ripple starts or
+  // ends. A capture that draws the cursor asks for a frame then: a cursor
+  // moving over a still page damages nothing, so nothing new is captured.
+  base::CallbackListSubscription AddChangedCallback(
+      base::RepeatingClosure callback);
+
+  // WebContentsObserver: the primary page's view can change under it.
+  void RenderFrameHostChanged(RenderFrameHost* old_host,
+                              RenderFrameHost* new_host) override;
+  void PrimaryPageChanged(Page& page) override;
+  void RenderViewReady() override;
+
+  // input::RenderWidgetHostInputEventRouter::MouseEventRouteObserver:
+  void OnMouseEventRouted(const blink::WebMouseEvent& event) override;
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override;
+
+ private:
+  friend class WebContentsUserData<CdpCursorOverlay>;
+  class CursorLayerDelegate;
+  class ClickLayerDelegate;
+
+  explicit CdpCursorOverlay(WebContents* web_contents);
+
+  void AttachTo(RenderWidgetHostImpl* widget_host, aura::Window* window);
+  void Detach();
+
+  void MoveCursorTo(float dip_x, float dip_y);
+  void PaintCursor(const ui::PaintContext& context);
+  void PaintClickRipple(const ui::PaintContext& context);
+  void StartClickAnimation();
+  void OnClickAnimationEnd();
+
+  std::unique_ptr<CursorLayerDelegate> cursor_delegate_;
+  std::unique_ptr<ClickLayerDelegate> click_delegate_;
+  std::unique_ptr<ui::Layer> cursor_layer_;
+  std::unique_ptr<ui::Layer> click_layer_;
+  base::OneShotTimer click_timer_;
+
+  // Weak, not raw: the router belongs to the tab's WebContents, which can be
+  // destroyed before this overlay is detached.
