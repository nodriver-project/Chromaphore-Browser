+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/devtools/cdp_cursor_overlay.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/numerics/safe_conversions.h"
+#include "components/browser/browser_switches.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_base.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkPaint.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+#include "third_party/skia/include/core/SkRect.h"
+#include "ui/aura/window.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_textured.h"
+#include "ui/compositor/paint_context.h"
+#include "ui/compositor/paint_recorder.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/point.h"
+
+namespace content {
+
+namespace {
+
+constexpr int kCursorSize = 32;
+constexpr int kRippleRadius = 16;
+constexpr base::TimeDelta kClickAnimationDuration = base::Milliseconds(400);
+
+constexpr SkColor kCursorColor = SK_ColorWHITE;
+constexpr SkColor kClickColor = SkColorSetRGB(255, 165, 0);
+constexpr SkColor kRippleColor = SkColorSetARGB(100, 255, 165, 0);
+
+// How far the arrow's outline can reach past its path, in DIPs: half the
+// outline's width times Skia's default miter limit, 4, at a sharp join.
+constexpr float kOutlineReach = 0.5f * 4;
+// RenderSprite's largest scale: no page is drawn at more pixels per DIP, and
+// it keeps the sprite's size a small int.
+constexpr float kMaxSpriteScale = 16;
+
+// The arrow, in a 32 x 32 box with the hotspot at the origin.
+SkPath CursorPath() {
+  return SkPathBuilder()
+      .moveTo(0, 0)
+      .lineTo(0, 24)
+      .lineTo(6, 18)
+      .lineTo(10, 26)
+      .lineTo(14, 24)
+      .lineTo(9, 16)
+      .lineTo(16, 16)
+      .close()
+      .detach();
+}
+
+// The origin of a layer drawn at `pos`: truncated toward zero, as a cast
+// would, and held within the int range, so a point far off the page cannot
+// overflow.
+gfx::Point LayerOrigin(const gfx::PointF& pos) {
+  return gfx::Point(base::saturated_cast<int>(pos.x()),
+                    base::saturated_cast<int>(pos.y()));
+}
+
+// Draws the cursor with its hotspot at (x, y) of `canvas`, `scale` pixels
+// per DIP: the arrow's fill, its outline, then the click mark while
+// clicking. Screencast frames and recordings both draw with it.
+void DrawCursor(SkCanvas& canvas,
+                float x,
+                float y,
+                float scale,
+                bool clicking) {
+  canvas.save();
+  canvas.translate(x, y);
+  canvas.scale(scale, scale);
+  const SkPath path = CursorPath();
+
+  SkPaint fill;
+  fill.setColor(clicking ? kClickColor : kCursorColor);
+  fill.setAntiAlias(true);
+  canvas.drawPath(path, fill);
+
+  SkPaint stroke;
+  stroke.setColor(SK_ColorBLACK);
+  stroke.setAntiAlias(true);
+  stroke.setStyle(SkPaint::kStroke_Style);
+  stroke.setStrokeWidth(1.0f);
+  canvas.drawPath(path, stroke);
+  canvas.restore();
+
+  if (clicking) {
+    SkPaint ripple;
+    ripple.setColor(kRippleColor);
+    ripple.setAntiAlias(true);
+    canvas.drawCircle(x, y, kRippleRadius * scale, ripple);
+  }
+}
+
+}  // namespace
+
+class CdpCursorOverlay::CursorLayerDelegate : public ui::LayerDelegate {
+ public:
+  explicit CursorLayerDelegate(CdpCursorOverlay* owner) : owner_(owner) {}
+  void OnPaintLayer(const ui::PaintContext& context) override {
+    owner_->PaintCursor(context);
+  }
+  void OnDeviceScaleFactorChanged(float, float) override {
+    if (owner_->cursor_layer_) {
+      owner_->cursor_layer_->SchedulePaint(
+          gfx::Rect(owner_->cursor_layer_->size()));
+    }
+  }
+
+ private:
+  raw_ptr<CdpCursorOverlay> owner_;
+};
+
+class CdpCursorOverlay::ClickLayerDelegate : public ui::LayerDelegate {
+ public:
+  explicit ClickLayerDelegate(CdpCursorOverlay* owner) : owner_(owner) {}
+  void OnPaintLayer(const ui::PaintContext& context) override {
+    owner_->PaintClickRipple(context);
+  }
+  void OnDeviceScaleFactorChanged(float, float) override {}
+
+ private:
+  raw_ptr<CdpCursorOverlay> owner_;
+};
+
+// static
+CdpCursorOverlay* CdpCursorOverlay::ForWebContents(WebContents* web_contents) {
+  if (!web_contents || !base::CommandLine::ForCurrentProcess()->HasSwitch(
+                           switches::kShowCdpCursor)) {
+    return nullptr;
+  }
+  return GetOrCreateForWebContents(web_contents);
+}
+
+// static
+CdpCursorOverlay* CdpCursorOverlay::ForRecording(WebContents* web_contents) {
+  if (!web_contents) {
+    return nullptr;
+  }
+  CdpCursorOverlay* overlay = GetOrCreateForWebContents(web_contents);
+  // The router's events reach it only once it follows the page.
+  overlay->Follow();
+  return overlay;
+}
+
+CdpCursorOverlay::CdpCursorOverlay(WebContents* web_contents)
+    : WebContentsObserver(web_contents),
+      WebContentsUserData<CdpCursorOverlay>(*web_contents),
+      draws_on_window_(base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kShowCdpCursor)) {}
+
+CdpCursorOverlay::~CdpCursorOverlay() {
+  Detach();
+}
+
+void CdpCursorOverlay::Follow() {
+  auto* contents = static_cast<WebContentsImpl*>(web_contents());
+  RenderFrameHostImpl* main_frame =
+      contents ? contents->GetPrimaryMainFrame() : nullptr;
+  RenderWidgetHostImpl* widget_host =
+      main_frame ? main_frame->GetRenderWidgetHost() : nullptr;
+  RenderWidgetHostViewBase* view =
+      widget_host ? widget_host->GetView() : nullptr;
+  if (!view || view->IsRenderWidgetHostViewChildFrame()) {
+    return;
+  }
+  aura::Window* window = view->GetNativeView();
+  if (!window || window == attached_window_) {
+    return;  // nowhere to draw yet, or drawing there already
+  }
+  AttachTo(widget_host, window);
+}
+
+void CdpCursorOverlay::RenderFrameHostChanged(RenderFrameHost* old_host,
+                                              RenderFrameHost* new_host) {
+  // A cross-process navigation gives the tab a new top-level view; the cursor
+  // goes with it, where it was.
+  if (new_host && new_host->IsInPrimaryMainFrame()) {
+    Follow();
+  }
+}
+
+void CdpCursorOverlay::PrimaryPageChanged(Page& page) {
+  Follow();
+}
+
+void CdpCursorOverlay::RenderViewReady() {
+  Follow();  // a view that had no window when last asked
+}
+
+base::CallbackListSubscription CdpCursorOverlay::AddChangedCallback(
+    base::RepeatingClosure callback) {
+  return changed_callbacks_.Add(std::move(callback));
+}
+
+void CdpCursorOverlay::AttachTo(RenderWidgetHostImpl* widget_host,
+                                aura::Window* window) {
+  Detach();
+
+  // The router sees every mouse event, including ones routed into OOPIFs.
+  if (widget_host->delegate()) {
+    if (auto* router = widget_host->delegate()->GetInputEventRouter()) {
+      router_ = router->GetWeakPtr();
+      router->AddMouseEventRouteObserver(this);
+    }
+  }
+
+  attached_window_ = window;
+  window->AddObserver(this);
+
+  // Without --show-cdp-cursor the overlay only tracks the pointer, for a
+  // recording; nothing shows on the window.
+  if (!draws_on_window_) {
+    return;
+  }
+
+  cursor_delegate_ = std::make_unique<CursorLayerDelegate>(this);
+  click_delegate_ = std::make_unique<ClickLayerDelegate>(this);
+
+  cursor_layer_ = std::make_unique<ui::LayerTextured>();
+  // Where the pointer was: a new view after a navigation keeps it in place.
+  cursor_layer_->SetBounds(gfx::Rect(LayerOrigin(current_pos_),
+                                     gfx::Size(kCursorSize, kCursorSize)));
+  cursor_layer_->set_delegate(cursor_delegate_.get());
+  cursor_layer_->SetFillsBoundsOpaquely(false);
+  cursor_layer_->SetVisible(true);
+  cursor_layer_->SetName("CdpCursorOverlay");
+
+  click_layer_ = std::make_unique<ui::LayerTextured>();
+  click_layer_->set_delegate(click_delegate_.get());
+  click_layer_->SetFillsBoundsOpaquely(false);
+  click_layer_->SetVisible(false);
+  click_layer_->SetName("CdpCursorClickRipple");
+
+  // Above the page content.
+  window->layer()->Add(cursor_layer_.get());
+  window->layer()->StackAtTop(cursor_layer_.get());
+  window->layer()->Add(click_layer_.get());
+  window->layer()->StackAtTop(click_layer_.get());
+}
+
+void CdpCursorOverlay::Detach() {
+  // The click ripple's timer runs on: a click that navigates re-attaches
+  // within its 400 ms, and only the timer's end gives the cursor back its
+  // resting color.
+  if (router_) {
+    router_->RemoveMouseEventRouteObserver(this);
+  }
+  router_.reset();
+
+  if (attached_window_) {
+    attached_window_->RemoveObserver(this);
+    if (cursor_layer_ && cursor_layer_->parent()) {
+      cursor_layer_->parent()->Remove(cursor_layer_.get());
+    }
+    if (click_layer_ && click_layer_->parent()) {
+      click_layer_->parent()->Remove(click_layer_.get());
+    }
+    attached_window_ = nullptr;
+  }
+
+  cursor_layer_.reset();
+  click_layer_.reset();
+  cursor_delegate_.reset();
+  click_delegate_.reset();
+}
+
+void CdpCursorOverlay::UpdatePosition(float dip_x, float dip_y, bool is_click) {
+  MoveCursorTo(dip_x, dip_y);
+  if (is_click) {
+    StartClickAnimation();
+  }
+}
+
+void CdpCursorOverlay::OnMouseEventRouted(const blink::WebMouseEvent& event) {
+  MoveCursorTo(event.PositionInWidget().x(), event.PositionInWidget().y());
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    StartClickAnimation();
+  }
+}
+
+void CdpCursorOverlay::OnWindowDestroying(aura::Window* window) {
+  Detach();
+}
+
+void CdpCursorOverlay::MoveCursorTo(float dip_x, float dip_y) {
+  // A point that is not finite is nowhere on the page: the cursor stays where
+  // it was.
+  if (!std::isfinite(dip_x) || !std::isfinite(dip_y)) {
+    return;
+  }
+  const gfx::PointF pos(dip_x, dip_y);
+  if (has_position_ && pos == current_pos_) {
+    return;  // a press, a release, or a still drag's dragover
+  }
+  // The first point places the pointer, even at the 0,0 it starts at.
+  has_position_ = true;
+  current_pos_ = pos;
+  if (cursor_layer_) {
+    cursor_layer_->SetBounds(gfx::Rect(LayerOrigin(current_pos_),
+                                       gfx::Size(kCursorSize, kCursorSize)));
+  }
+  changed_callbacks_.Notify();
+}
+
+void CdpCursorOverlay::PaintCursor(const ui::PaintContext& context) {
+  ui::PaintRecorder recorder(context, cursor_layer_->size());
+  gfx::Canvas* canvas = recorder.canvas();
+  const SkPath path = CursorPath();
+
+  cc::PaintFlags fill;
+  fill.setColor(is_clicking_ ? kClickColor : kCursorColor);
+  fill.setAntiAlias(true);
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  canvas->DrawPath(path, fill);
+
+  cc::PaintFlags stroke;
+  stroke.setColor(SK_ColorBLACK);
+  stroke.setAntiAlias(true);
+  stroke.setStyle(cc::PaintFlags::kStroke_Style);
+  stroke.setStrokeWidth(1.0f);
+  canvas->DrawPath(path, stroke);
+}
+
+void CdpCursorOverlay::PaintClickRipple(const ui::PaintContext& context) {
+  const gfx::Size ripple_size(kRippleRadius * 2, kRippleRadius * 2);
+  ui::PaintRecorder recorder(context, ripple_size);
+
+  cc::PaintFlags flags;
+  flags.setColor(kRippleColor);
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  recorder.canvas()->DrawCircle(gfx::PointF(kRippleRadius, kRippleRadius),
+                                static_cast<float>(kRippleRadius), flags);
+}
+
+void CdpCursorOverlay::StartClickAnimation() {
+  // A press while the mark of the one before still shows changes nothing
+  // drawn.
+  if (!is_clicking_) {
+    ++look_version_;
+  }
+  is_clicking_ = true;
+  ++click_count_;
+  if (cursor_layer_) {
+    cursor_layer_->SchedulePaint(gfx::Rect(cursor_layer_->size()));
+  }
+  if (click_layer_) {
+    gfx::Point ripple_origin = LayerOrigin(current_pos_);
+    ripple_origin.Offset(-kRippleRadius, -kRippleRadius);
+    click_layer_->SetBounds(gfx::Rect(
+        ripple_origin, gfx::Size(kRippleRadius * 2, kRippleRadius * 2)));
+    click_layer_->SetVisible(true);
+    click_layer_->SchedulePaint(gfx::Rect(click_layer_->size()));
+  }
+  click_timer_.Start(FROM_HERE, kClickAnimationDuration,
+                     base::BindOnce(&CdpCursorOverlay::OnClickAnimationEnd,
+                                    base::Unretained(this)));
+  changed_callbacks_.Notify();
+}
+
+void CdpCursorOverlay::OnClickAnimationEnd() {
+  is_clicking_ = false;
+  ++look_version_;
+  if (cursor_layer_) {
+    cursor_layer_->SchedulePaint(gfx::Rect(cursor_layer_->size()));
+  }
+  if (click_layer_) {
+    click_layer_->SetVisible(false);
+  }
+  changed_callbacks_.Notify();
+}
+
+void CdpCursorOverlay::CompositeCursorOnto(SkBitmap& bitmap,
+                                           float scale_x,
+                                           float scale_y) {
+  SkCanvas canvas(bitmap);
+  const float x = current_pos_.x() * scale_x;
+  const float y = current_pos_.y() * scale_y;
+  DrawCursor(canvas, x, y, std::min(scale_x, scale_y), is_clicking_);
+}
+
+SkBitmap CdpCursorOverlay::RenderSprite(float scale,
+                                        gfx::PointF* hotspot) const {
+  if (!std::isfinite(scale) || scale <= 0 || scale > kMaxSpriteScale) {
+    return SkBitmap();
+  }
+  // The ink around the hotspot, in DIPs: the arrow with its outline, and the
+  // click mark's disc while clicking.
+  SkRect ink = CursorPath().getBounds().makeOutset(kOutlineReach,
+                                                   kOutlineReach);
+  if (is_clicking_) {
+    ink.join(SkRect::MakeLTRB(-kRippleRadius, -kRippleRadius, kRippleRadius,
+                              kRippleRadius));
+  }
+  // In pixels, with one more on each side for the anti-aliased edge, and
+  // even sides.
+  const int left = base::ClampFloor(ink.left() * scale) - 1;
+  const int top = base::ClampFloor(ink.top() * scale) - 1;
+  int width = base::ClampCeil(ink.right() * scale) + 1 - left;
+  int height = base::ClampCeil(ink.bottom() * scale) + 1 - top;
+  width += width & 1;
+  height += height & 1;
+
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocN32Pixels(width, height)) {
+    return SkBitmap();
+  }
+  bitmap.eraseColor(SK_ColorTRANSPARENT);
+  const gfx::PointF at(static_cast<float>(-left), static_cast<float>(-top));
+  SkCanvas canvas(bitmap);
+  DrawCursor(canvas, at.x(), at.y(), scale, is_clicking_);
+  *hotspot = at;
+  return bitmap;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(CdpCursorOverlay);
+
+}  // namespace content
