+// browser: a cursor moving over a still page is a request per mouse event;
+// the capturer would refuse most of them as too soon and retry on its own.
+void DevToolsVideoConsumer::RequestRefreshFrame() {
+  if (!capturer_ || refresh_timer_.IsRunning()) {
+    return;
+  }
+  const base::TimeDelta wait =
+      last_refresh_request_ + min_capture_period_ - base::TimeTicks::Now();
+  if (wait.is_positive()) {
+    refresh_timer_.Start(
+        FROM_HERE, wait,
+        base::BindOnce(&DevToolsVideoConsumer::SendRefreshFrameRequest,
+                       base::Unretained(this)));
+    return;
+  }
+  SendRefreshFrameRequest();
+}
+
+void DevToolsVideoConsumer::SendRefreshFrameRequest() {
+  if (!capturer_) {
+    return;
+  }
+  last_refresh_request_ = base::TimeTicks::Now();
+  capturer_->RequestRefreshFrame();
+}
