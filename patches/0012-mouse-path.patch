diff --git a/content/common/input/synthetic_mouse_path_gesture.cc b/content/common/input/synthetic_mouse_path_gesture.cc
new file mode 100644
index 0000000000..61b5dd3e54
--- /dev/null
+++ b/content/common/input/synthetic_mouse_path_gesture.cc
@@ -0,0 +1,286 @@
+// Copyright 2026 The browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/common/input/synthetic_mouse_path_gesture.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <numbers>
+#include <optional>
+
+#include "base/check_op.h"
+#include "base/rand_util.h"
+#include "content/common/input/input_injector.mojom-shared.h"
+#include "third_party/blink/public/common/input/synthetic_web_input_event_builders.h"
+#include "third_party/blink/public/common/input/web_mouse_wheel_event.h"
+#include "ui/events/types/scroll_types.h"
+
+namespace content {
+
+namespace {
+
+// browser: whether a position is over the view the path is in (or no view was
+// given).
+bool InsideView(const SyntheticMousePathGestureParams& p,
+                const SyntheticMousePathGestureParams::Position& position) {
+  return p.view_width <= 0 || p.view_height <= 0 ||
+         (position.x >= 0 && position.y >= 0 && position.x < p.view_width &&
+          position.y < p.view_height);
+}
+
+// browser: how long after its poll a mouse's report reaches the browser's UI
+// thread, which stamps it (EventTimeFromMSG: TimeTicks::Now() when handled):
+// the input stack and the thread's wake. Small, never negative, now and then
+// longer; absolute, whatever the polling rate. Most of it is under the
+// page's 100 us clock.
+base::TimeDelta ReportLatency() {
+  const double u1 = std::max(base::RandDouble(), 1e-12);
+  const double u2 = base::RandDouble();
+  const double z =
+      std::sqrt(-2.0 * std::log(u1)) * std::cos(2.0 * std::numbers::pi * u2);
+  return base::Microseconds(std::min(1500.0, 30.0 + 120.0 * std::exp(0.8 * z)));
+}
+
+}  // namespace
+
+SyntheticMousePathGesture::SyntheticMousePathGesture(
+    const SyntheticMousePathGestureParams& gesture_params)
+    : SyntheticGestureBase(gesture_params) {
+  CHECK_EQ(SyntheticGestureParams::MOUSE_PATH_GESTURE,
+           gesture_params.GetGestureType());
+  CHECK(!gesture_params.positions.empty());
+  BuildSteps();
+  // browser: a path that begins where the last one left the pointer sends
+  // nothing there.
+  if (gesture_params.has_start) {
+    last_move_ = gesture_params.start;
+    inside_ = InsideView(gesture_params, gesture_params.start);
+  }
+}
+
+SyntheticMousePathGesture::~SyntheticMousePathGesture() = default;
+
+void SyntheticMousePathGesture::BuildSteps() {
+  using EndAction = SyntheticMousePathGestureParams::EndAction;
+  const SyntheticMousePathGestureParams& p = params();
+  const size_t last = p.positions.size() - 1;
+  for (size_t i = 0; i <= last; ++i) {
+    steps_.push_back({Step::Kind::kMove, i, p.polling_interval * i});
+  }
+  base::TimeDelta at = p.polling_interval * last;
+  for (size_t w = 0; w < p.wheel.size(); ++w) {
+    at += p.wheel[w].delay;
+    steps_.push_back({Step::Kind::kWheel, last, at, w});
+  }
+  at += p.end_delay;
+  switch (p.end_action) {
+    case EndAction::kNone:
+      break;
+    case EndAction::kPress:
+      steps_.push_back({Step::Kind::kPress, last, at});
+      break;
+    case EndAction::kRelease:
+      steps_.push_back({Step::Kind::kRelease, last, at});
+      break;
+    case EndAction::kClick:
+      for (int i = 0; i < std::max(1, p.click_count); ++i) {
+        if (i > 0) {
+          // browser: each gap and each hold its own when given.
+          at += static_cast<size_t>(i - 1) < p.click_gaps.size()
+                    ? p.click_gaps[i - 1]
+                    : p.click_gap;
+        }
+        steps_.push_back({Step::Kind::kPress, last, at});
+        at += static_cast<size_t>(i) < p.holds.size() ? p.holds[i] : p.hold;
+        steps_.push_back({Step::Kind::kRelease, last, at});
+      }
+      break;
+  }
+}
+
+SyntheticGesture::Result SyntheticMousePathGesture::ForwardInputEvents(
+    const base::TimeTicks& timestamp,
+    SyntheticGestureTarget* target) {
+  CHECK(dispatching_controller_);
+  const base::WeakPtr<SyntheticGestureController> weak_controller =
+      dispatching_controller_;
+
+  if (!pointer_driver_) {
+    pointer_driver_ = SyntheticPointerDriver::Create(
+        content::mojom::GestureSourceType::kMouseInput,
+        params().from_devtools_debugger);
+  }
+  if (!started_) {
+    // The first event goes out immediately.
+    started_ = true;
+    gesture_start_time_ = timestamp;
+    last_stamp_ = timestamp - params().polling_interval;
+  }
+
+  // Every event whose time has come is dispatched now: one per wake when the
+  // timer keeps time (NextDispatchTime), several when it woke late.
+  const base::TimeDelta elapsed = timestamp - gesture_start_time_;
+  while (current_index_ < steps_.size() &&
+         steps_[current_index_].at <= elapsed) {
+    DispatchStep(steps_[current_index_], timestamp, target);
+    if (!weak_controller) {
+      return SyntheticGesture::GESTURE_ABORT;
+    }
+    current_index_++;
+  }
+  return current_index_ >= steps_.size() ? SyntheticGesture::GESTURE_FINISHED
+                                         : SyntheticGesture::GESTURE_RUNNING;
+}
+
+void SyntheticMousePathGesture::DispatchStep(const Step& step,
+                                             base::TimeTicks now,
+                                             SyntheticGestureTarget* target) {
+  const SyntheticMousePathGestureParams& p = params();
+  const SyntheticMousePathGestureParams::Position& position =
+      p.positions[step.position];
+  // A mouse has no pressure sensor, and a real mouse event says so with NaN,
+  // which the page sees as the 0.5 the spec gives a pressed button. Every
+  // move, press and release here says so too: any other pressure is one no
+  // mouse reports.
+  const float no_pressure = std::numeric_limits<float>::quiet_NaN();
+  switch (step.kind) {
+    case Step::Kind::kMove: {
+      // browser: a mouse that has not moved reports nothing. A pointer that
+      // leaves the view with no button held is the page's to hear once, as it
+      // goes -- mouseleave, as the system tells a window its pointer has left
+      // -- and not again until it comes back; a held button's capture carries
+      // every move on. The driver still learns where the pointer is: a release
+      // is made where its last move was.
+      const bool unmoved = last_move_ && position.x == last_move_->x &&
+                           position.y == last_move_->y;
+      const bool outside =
+          p.button == SyntheticPointerActionParams::Button::NO_BUTTON &&
+          !InsideView(p, position);
+      // A held button rides on every move: SyntheticMouseDriverBase::Move
+      // turns it into the event's button modifiers, which the renderer
+      // reports as `buttons`.
+      pointer_driver_->Move(position.x, position.y, /*index=*/0,
+                            p.key_modifiers, /*width=*/1.f, /*height=*/1.f,
+                            /*rotation_angle=*/0.f, no_pressure,
+                            /*tangential_pressure=*/0.f, /*tilt_x=*/0,
+                            /*tilt_y=*/0, p.button);
+      last_move_ = position;
+      if (outside) {
+        if (inside_) {
+          inside_ = false;
+          blink::WebMouseEvent leave =
+              blink::SyntheticWebMouseEventBuilder::Build(
+                  blink::WebInputEvent::Type::kMouseLeave, position.x,
+                  position.y,
+                  p.key_modifiers | blink::WebInputEvent::kFromDebugger);
+          leave.SetTimeStamp(StampFor(step, now));
+          target->DispatchInputEventToPlatform(leave);
+        }
+        return;
+      }
+      if (!inside_) {
+        // browser: coming back in, as the system tells a window its pointer has
+        // come in -- which Chrome takes as a move there -- before the move.
+        blink::WebMouseEvent enter =
+            blink::SyntheticWebMouseEventBuilder::Build(
+                blink::WebInputEvent::Type::kMouseEnter, position.x, position.y,
+                p.key_modifiers | blink::WebInputEvent::kFromDebugger);
+        // With the move's own timestamp, as Chrome copies it into the entry.
+        const base::TimeTicks stamp = StampFor(step, now);
+        enter.SetTimeStamp(stamp);
+        target->DispatchInputEventToPlatform(enter);
+        inside_ = true;
+        pointer_driver_->DispatchEvent(target, stamp);
+        return;
+      }
+      inside_ = true;
+      if (unmoved) {
+        return;
+      }
+      break;
+    }
+    case Step::Kind::kPress:
+      // Presses in one gesture count up as a person's do: a second within
+      // the double-click time and distance is click 2.
+      pointer_driver_->Press(position.x, position.y, /*index=*/0, p.end_button,
+                             p.key_modifiers, /*width=*/1.f,
+                             /*height=*/1.f, /*rotation_angle=*/0.f,
+                             no_pressure, /*tangential_pressure=*/0.f,
+                             /*tilt_x=*/0, /*tilt_y=*/0,
+                             gesture_start_time_ + step.at);
+      break;
+    case Step::Kind::kRelease:
+      pointer_driver_->Release(/*index=*/0, p.end_button, p.key_modifiers);
+      break;
+    case Step::Kind::kWheel: {
+      // A notch as Windows builds one: pixel units, so the compositor
+      // animates it; wheel_ticks set; and no phase, so the browser's phase
+      // handler begins, continues and ends the spin and latches its target,
+      // as it does for a real wheel. A held button rides along.
+      const SyntheticMousePathGestureParams::WheelNotch& notch =
+          p.wheel[step.wheel_index];
+      const int modifiers =
+          p.key_modifiers | blink::WebInputEvent::kFromDebugger |
+          static_cast<int>(
+              SyntheticPointerActionParams::GetWebMouseEventModifier(p.button));
+      blink::WebMouseWheelEvent wheel =
+          blink::SyntheticWebMouseWheelEventBuilder::Build(
+              position.x, position.y, -notch.notches_x * p.pixels_per_notch,
+              -notch.notches_y * p.pixels_per_notch, modifiers,
+              ui::ScrollGranularity::kScrollByPixel);
+      wheel.wheel_ticks_x = -notch.notches_x;
+      wheel.wheel_ticks_y = -notch.notches_y;
+      wheel.phase = blink::WebMouseWheelEvent::kPhaseNone;
+      wheel.SetTimeStamp(StampFor(step, now));
+      target->DispatchInputEventToPlatform(wheel);
+      return;
+    }
+  }
+  pointer_driver_->DispatchEvent(target, StampFor(step, now));
+}
+
+base::TimeTicks SyntheticMousePathGesture::StampFor(const Step& step,
+                                                    base::TimeTicks now) {
+  // A move, when its report would have reached the browser: its poll on the
+  // grid, plus the report's latency. A real move is stamped when the UI
+  // thread handles it, so its gaps are the polling interval give or take that
+  // latency, never a share of the interval. Not the wake's own time: a wake
+  // comes up to a ms or two late on Windows' timer, as much as the interval
+  // at 500 or 1000 Hz. A press, release or notch keeps no cadence: stamped as
+  // it goes, as Chrome stamps one it handles, so the page finds it no older
+  // than its trip. Each stamp is at least 50 us after the one before and,
+  // but for that, no later than now: a burst sent in one wake may run ahead
+  // of now by 50 us per event.
+  base::TimeTicks stamp = step.kind == Step::Kind::kMove
+                              ? gesture_start_time_ + step.at + ReportLatency()
+                              : now;
+  stamp = std::min(stamp, now);
+  stamp = std::max(stamp, last_stamp_ + base::Microseconds(50));
+  last_stamp_ = stamp;
+  return stamp;
+}
+
+void SyntheticMousePathGesture::WaitForTargetAck(
+    base::OnceClosure callback,
+    SyntheticGestureTarget* target) const {
+  target->WaitForTargetAck(params().GetGestureType(),
+                           content::mojom::GestureSourceType::kMouseInput,
+                           std::move(callback));
+}
+
+std::optional<base::TimeTicks> SyntheticMousePathGesture::NextDispatchTime()
+    const {
+  // browser: the first event at once, then each when it is due; none once all
+  // are sent (the controller then waits for the target as for any gesture).
+  if (!started_) {
+    return base::TimeTicks::Now();
+  }
+  if (current_index_ >= steps_.size()) {
+    return std::nullopt;
+  }
+  return gesture_start_time_ + steps_[current_index_].at;
+}
+
+}  // namespace content
