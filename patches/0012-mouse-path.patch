+
+#ifndef CONTENT_COMMON_INPUT_SYNTHETIC_MOUSE_PATH_GESTURE_H_
+#define CONTENT_COMMON_INPUT_SYNTHETIC_MOUSE_PATH_GESTURE_H_
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/time/time.h"
+#include "content/common/content_export.h"
+#include "content/common/input/synthetic_gesture.h"
+#include "content/common/input/synthetic_gesture_target.h"
+#include "content/common/input/synthetic_mouse_path_gesture_params.h"
+#include "content/common/input/synthetic_pointer_driver.h"
+
+namespace content {
+
+// Moves the mouse through a list of positions at a polling rate, then
+// optionally presses, releases or clicks at the last one, for
+// Input.dispatchMousePath.
+class CONTENT_EXPORT SyntheticMousePathGesture
+    : public SyntheticGestureBase<SyntheticMousePathGestureParams> {
+ public:
+  explicit SyntheticMousePathGesture(
+      const SyntheticMousePathGestureParams& params);
+
+  SyntheticMousePathGesture(const SyntheticMousePathGesture&) = delete;
+  SyntheticMousePathGesture& operator=(const SyntheticMousePathGesture&) =
+      delete;
+
+  ~SyntheticMousePathGesture() override;
+
+  SyntheticGesture::Result ForwardInputEvents(
+      const base::TimeTicks& timestamp,
+      SyntheticGestureTarget* target) override;
+  void WaitForTargetAck(base::OnceClosure callback,
+                        SyntheticGestureTarget* target) const override;
+  std::optional<base::TimeTicks> NextDispatchTime() const override;
+
+ private:
+  // One event of the gesture, due `at` after it starts.
+  struct Step {
+    enum class Kind { kMove, kPress, kRelease, kWheel };
+    Kind kind;
+    size_t position;
+    base::TimeDelta at;
+    size_t wheel_index = 0;
+  };
+
+  void BuildSteps();
+  void DispatchStep(const Step& step,
+                    base::TimeTicks now,
+                    SyntheticGestureTarget* target);
+  base::TimeTicks StampFor(const Step& step, base::TimeTicks now);
+
+  std::unique_ptr<SyntheticPointerDriver> pointer_driver_;
+  std::vector<Step> steps_;
+  base::TimeTicks gesture_start_time_;
+  base::TimeTicks last_stamp_;
+  size_t current_index_ = 0;
+  bool started_ = false;
+  // browser: where the last move went, so a point the pointer has not moved
+  // from sends nothing.
+  std::optional<SyntheticMousePathGestureParams::Position> last_move_;
+  // browser: whether the pointer is over the view, for a path with no button
+  // held: leaving it is heard once, as mouseleave.
+  bool inside_ = true;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_COMMON_INPUT_SYNTHETIC_MOUSE_PATH_GESTURE_H_
