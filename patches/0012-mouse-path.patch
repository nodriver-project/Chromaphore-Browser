+#define CONTENT_COMMON_INPUT_SYNTHETIC_MOUSE_PATH_GESTURE_PARAMS_H_
+
+#include <vector>
+
+#include "base/time/time.h"
+#include "content/common/content_export.h"
+#include "content/common/input/synthetic_gesture_params.h"
+#include "content/common/input/synthetic_pointer_action_params.h"
+
+namespace content {
+
+struct CONTENT_EXPORT SyntheticMousePathGestureParams
+    : public SyntheticGestureParams {
+  struct Position {
+    float x;
+    float y;
+  };
+
+  SyntheticMousePathGestureParams();
+  SyntheticMousePathGestureParams(const SyntheticMousePathGestureParams& other);
+  ~SyntheticMousePathGestureParams() override;
+
+  GestureType GetGestureType() const override;
+
+  std::vector<Position> positions;
+  base::TimeDelta polling_interval;
+
+  // Held for every move along the path. NO_BUTTON makes the path a hover;
+  // anything else makes it a drag.
+  SyntheticPointerActionParams::Button button =
+      SyntheticPointerActionParams::Button::NO_BUTTON;
+
+  // Keys held for the whole gesture, as blink::WebInputEvent modifier bits.
+  int key_modifiers = 0;
+
+  // What happens once the pointer reaches the last position, in the same
+  // gesture as the moves -- so a press takes the route real input takes, and
+  // follows the moves with nothing in between.
+  enum class EndAction { kNone, kPress, kRelease, kClick };
+  EndAction end_action = EndAction::kNone;
+  SyntheticPointerActionParams::Button end_button =
+      SyntheticPointerActionParams::Button::LEFT;
+  // Clicks in a row for kClick: 2 is a double click.
+  int click_count = 1;
+  // From the last move to the first press or release.
+  base::TimeDelta end_delay;
+  // How long each click's button stays down.
+  base::TimeDelta hold;
+  // From one click's release to the next click's press.
+  base::TimeDelta click_gap;
+  // browser: per click when given -- click i's own hold, and the gap before
+  // click i + 1 -- in place of `hold` and `click_gap`: a hand's double click
+  // holds and pauses differently each time.
+  std::vector<base::TimeDelta> holds;
+  std::vector<base::TimeDelta> click_gaps;
+
+  // Wheel turns at the last position, after the moves and before any end
+  // action. Positive notches scroll right and down.
+  struct WheelNotch {
+    int notches_x = 0;
+    int notches_y = 0;
+    // The pause before this turn.
+    base::TimeDelta delay;
+  };
+  std::vector<WheelNotch> wheel;
+  // Pixels one notch scrolls: Windows' default of three lines at 100/3 px.
+  float pixels_per_notch = 100.f;
+
+  // browser: the size of the view the positions are in. A move with no button
+  // held that falls outside it is not delivered, as the system sends a window
+  // no mouse move while the pointer is not over it. 0: every move goes out.
+  float view_width = 0.f;
+  float view_height = 0.f;
+
+  // browser: where the pointer already is when this path begins -- where the
+  // last one left it -- so a first point there sends nothing, as a mouse that
+  // has not moved reports nothing.
+  bool has_start = false;
+  Position start{0.f, 0.f};
+};
